@page "/vendas"
@using System.Globalization
@using EvolutVendas.Services
@inject NavigationManager NavManager
@inject BuscaVendasService buscaVendaService
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<div class="page-container">

    <!-- 🔹 Top Bar -->
    <div class="top-bar">
        <button class="btn-voltar" @onclick="Voltar">⬅️</button>
        <h3>📑 Vendas</h3>
    </div>

    <!-- 🔹 Filtro de data -->
    <div class="filtro-container">
        <div class="campo">
            <label>De:</label>
            <input type="date" @bind="dataInicio" class="date-input" />
        </div>
        <div class="campo">
            <label>Até:</label>
            <input type="date" @bind="dataFim" class="date-input" />
        </div>
        <button class="btn-filtrar" @onclick="BuscarVendas">🔎 Buscar</button>
    </div>

    <!-- 🔹 Lista de Vendas -->
    @if (vendas?.Any() != true)
    {
            <p class="sem-vendas">Nenhuma venda encontrada no período.</p>
    }
    else
    {
            <div class="lista-vendas">
            @foreach (var v in vendas)
            {
                        <div class="card-venda" @onclick="() => ToggleVenda(v.Codigo)">
                            <div class="card-header">
                                <span class="codigo">🧾 <b>@v.Codigo</b></span>
                                <span class="data">@v.DataHoraVenda.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="card-body">
                                👤 <b>@v.NomeCliente</b>
                            </div>
                            <div class="card-body valor">
                                💰 @v.TotalVenda.ToString("C", new CultureInfo("pt-BR"))
                            </div>

                    @if (vendaSelecionada == v.Codigo)
                    {
                                    <div class="produtos-lista">
                            @if (produtosVenda?.Any() != true)
                            {
                                                <p>Nenhum produto encontrado.</p>
                            }
                            else
                            {
                                @foreach (var p in produtosVenda)
                                {
                                                        <div class="produto-item">
                                                            <div class="produto-nome">@p.NomeProduto</div>
                                                            <div class="produto-info">
                                                                <span>Qtd: <b>@p.Quantidade</b></span>
                                                                <span>Unit: <b>@p.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))</b></span>
                                                                <span>Total: <b>@p.PrecoTotal.ToString("C", new CultureInfo("pt-BR"))</b></span>
                                                            </div>
                                                        </div>
                                }
                            }
                                    </div>
                    }
                        </div>
            }

                <!-- 🔹 Total -->
                <div class="card-total">
                    <span>Total do Período:</span>
                    <span class="valor-total">@vendas.Sum(x => x.TotalVenda).ToString("C", new CultureInfo("pt-BR"))</span>
                </div>
            </div>
    }

    <!-- 🔹 Bottom bar -->
    <div class="bottom-bar">
        <a href="/menu" class="nav-item">
            <i>🏠</i>
            <span>Menu</span>
        </a>
        <a href="/novavenda" class="nav-item">
            <i>🛒</i>
            <span>Nova</span>
        </a>
        <a href="/produtos" class="nav-item">
            <i>📦</i>
            <span>Produtos</span>
        </a>
    </div>
</div>

<style>
    :root {
        --primary: #0078D7;
        --primary-dark: #005a9e;
        --bg: #f0f4fa;
        --radius: 12px;
        --shadow: 0 4px 10px rgba(0,0,0,0.08);
        --transition: all 0.25s ease;
    }

    .page-container {
        background: var(--bg);
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
        padding-bottom: 80px;
    }

    /* 🔹 Top Bar */
    .top-bar {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary);
        color: white;
        padding: 12px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.1);
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
        z-index: 50;
    }

    .top-bar h3 {
        flex: 1;
        text-align: center;
        font-weight: 600;
        font-size: 1.1rem;
        margin: 0;
    }

    .btn-voltar {
        background: white;
        color: var(--primary);
        border: none;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        font-weight: bold;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: var(--shadow);
        transition: var(--transition);
        position: absolute;
        left: 12px;
    }

        .btn-voltar:hover {
            transform: scale(1.08);
            background: #f0f0f0;
        }

    /* 🔹 Filtros */
    .filtro-container {
        margin: 15px auto;
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        width: 90%;
        max-width: 600px;
        background: white;
        padding: 10px;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .filtro-container .campo {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 0.85rem;
    }

    .date-input {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 6px;
        font-size: 0.9rem;
    }

    .btn-filtrar {
        background: var(--primary);
        color: white;
        border: none;
        border-radius: var(--radius);
        padding: 10px 16px;
        font-weight: 600;
        transition: var(--transition);
    }

        .btn-filtrar:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

    /* 🔹 Cards de Vendas */
    .lista-vendas {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 0 12px;
    }

    .card-venda {
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 12px 14px;
        cursor: pointer;
        transition: var(--transition);
    }

        .card-venda:hover {
            transform: scale(1.01);
            box-shadow: 0 6px 12px rgba(0,0,0,0.12);
        }

    .card-header {
        display: flex;
        justify-content: space-between;
        color: #333;
        font-weight: 500;
    }

    .data {
        font-size: 0.8rem;
        color: #777;
    }

    .card-body {
        font-size: 0.95rem;
        color: #444;
        margin-top: 5px;
    }

    .valor {
        color: var(--primary-dark);
        font-weight: bold;
    }

    /* 🔹 Lista de produtos */
    .produtos-lista {
        background: #eef6ff;
        border-radius: 8px;
        padding: 8px 10px;
        margin-top: 8px;
        font-size: 0.85rem;
        box-shadow: inset 0 0 4px rgba(0,0,0,0.05);
    }

    .produto-item {
        border-bottom: 1px solid #ddd;
        padding: 6px 0;
    }

        .produto-item:last-child {
            border: none;
        }

    .produto-nome {
        font-weight: 600;
        margin-bottom: 3px;
        color: #333;
    }

    .produto-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #555;
    }

    /* 🔹 Total */
    .card-total {
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin: 12px;
        padding: 14px;
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        color: var(--primary-dark);
        font-size: 1rem;
    }

    .sem-vendas {
        text-align: center;
        color: #777;
        margin-top: 30px;
    }

    /* 🔹 Bottom Navigation estilo app */
    .bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        display: flex;
        justify-content: space-around;
        align-items: center;
        padding: 8px 0;
        box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.1);
        border-top-left-radius: 18px;
        border-top-right-radius: 18px;
        z-index: 50;
    }

    .nav-item {
        text-align: center;
        color: var(--primary-dark);
        font-size: 0.75rem;
        text-decoration: none;
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .nav-item i {
            font-size: 1.4rem;
            margin-bottom: 3px;
        }

        .nav-item:hover {
            color: var(--primary);
            transform: scale(1.08);
        }

    @@media (max-width: 480px) {
        .btn-filtrar { width: 100%; }
    }
</style>

@code {
    private DateTime dataInicio = DateTime.Today;
    private DateTime dataFim = DateTime.Today;
    private List<Models.VendaBuscaC> vendas = new();
    private List<Models.VendaDBusca> produtosVenda = new();
    private int vendaSelecionada = 0;

    string usuario = "";
    string cnpj = "";
    int codVendedor = 0;

    protected override async Task OnInitializedAsync()
    {
        usuario = await localStorage.GetItemAsync<string>("Usuario");
        cnpj = await localStorage.GetItemAsync<string>("CNPJ");
        codVendedor = await localStorage.GetItemAsync<int>("CodVendedor");
        await BuscarVendas();
    }

    private async Task BuscarVendas()
    {
        vendas = await buscaVendaService.BuscarVendas(cnpj, dataInicio, dataFim);
    }

    private async Task ToggleVenda(int codVenda)
    {
        if (vendaSelecionada == codVenda)
        {
            vendaSelecionada = 0;
            produtosVenda.Clear();
        }
        else
        {
            vendaSelecionada = codVenda;
            produtosVenda = await buscaVendaService.BuscarProdutosVenda(codVenda, cnpj);
        }
    }

    private void Voltar() => NavManager.NavigateTo("/menu");
}
