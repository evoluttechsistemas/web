    }</style>

@code {
    private const string DownloadsRoot = "C:/FTP/Downloads";

    [SupplyParameterFromQuery(Name = "p")]
    public string? Pasta { get; set; }

    private readonly List<ItemPasta> pastas = new();
    private readonly List<ItemArquivo> arquivos = new();
    private readonly List<ItemPasta> breadcrumb = new();
    private string? erro;

    protected override void OnParametersSet()
    {
        pastas.Clear();
        arquivos.Clear();
        breadcrumb.Clear();
        erro = null;

        var root = Path.GetFullPath(DownloadsRoot);
        var pastaRelativa = NormalizeRelativePath(Pasta);
        var pastaAtual = Path.GetFullPath(Path.Combine(root, pastaRelativa));

        if (!IsInsideRoot(root, pastaAtual))
        {
            erro = "O caminho solicitado não é permitido.";
            return;
        }

        if (!Directory.Exists(pastaAtual))
        {
            erro = "A pasta solicitada não existe.";
            return;
        }

        BuildBreadcrumb(pastaRelativa);

        pastas.AddRange(
            Directory.GetDirectories(pastaAtual)
                .Select(dir => new DirectoryInfo(dir))
                .OrderBy(dir => dir.Name)
                .Select(dir => new ItemPasta
                {
                    Nome = dir.Name,
                    CaminhoRelativo = ToRelativePath(root, dir.FullName)
                }));

        arquivos.AddRange(
            Directory.GetFiles(pastaAtual)
                .Select(file => new FileInfo(file))
                .OrderByDescending(file => file.LastWriteTime)
                .Select(file => new ItemArquivo
                {
                    Nome = file.Name,
                    CaminhoRelativo = ToRelativePath(root, file.FullName),
                    DataModificacao = file.LastWriteTime,
                    Tamanho = file.Length
                }));
    }

    private void BuildBreadcrumb(string pastaRelativa)
    {
        if (string.IsNullOrWhiteSpace(pastaRelativa))
        {
            return;
        }

        var acumulado = "";
        foreach (var parte in pastaRelativa.Split(Path.DirectorySeparatorChar, StringSplitOptions.RemoveEmptyEntries))
        {
            acumulado = string.IsNullOrWhiteSpace(acumulado)
                ? parte
                : Path.Combine(acumulado, parte);

            breadcrumb.Add(new ItemPasta
            {
                Nome = parte,
                Caminho = acumulado,
                CaminhoRelativo = acumulado
            });
        }
    }

    private static string NormalizeRelativePath(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        return Uri.UnescapeDataString(value)
            .Replace('/', Path.DirectorySeparatorChar)
            .TrimStart(Path.DirectorySeparatorChar);
    }

    private static bool IsInsideRoot(string root, string path)
    {
        var normalizedRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
        var normalizedPath = Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;

        return normalizedPath.StartsWith(normalizedRoot, StringComparison.OrdinalIgnoreCase);
    }

    private static string ToRelativePath(string root, string fullPath)
    {
        return Path.GetRelativePath(root, fullPath).Replace('\\', '/');
    }

    private static string GetParentPath(string? path)
    {
        var normalized = NormalizeRelativePath(path);
        var parent = Path.GetDirectoryName(normalized);
        return parent?.Replace('\\', '/') ?? "";
    }

    private string GetFolderUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        return $"/?p={Uri.EscapeDataString(path.Replace('\\', '/'))}";
    }

    private static string GetDownloadUrl(string path)
    {
        return $"/api/downloads?path={Uri.EscapeDataString(path.Replace('\\', '/'))}";
    }

    private static string GetExtension(string fileName)
    {
        var extension = Path.GetExtension(fileName).Trim('.').ToUpperInvariant();
        return string.IsNullOrWhiteSpace(extension) ? "FILE" : extension[..Math.Min(extension.Length, 4)];
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double size = bytes;
        var unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }

    private sealed class ItemPasta
    {
        public string Nome { get; set; } = "";
        public string Caminho { get; set; } = "";
        public string CaminhoRelativo { get; set; } = "";
    }

    private sealed class ItemArquivo
    {
        public string Nome { get; set; } = "";
        public string CaminhoRelativo { get; set; } = "";
        public DateTime DataModificacao { get; set; }
        public long Tamanho { get; set; }
    }
}
