@page "/"
@using System.IO
@using Microsoft.AspNetCore.Components

<PageTitle>Central de Downloads</PageTitle>

<main class="downloads-shell">
    <section class="downloads-hero">
        <div>
            <span class="eyebrow">Arquivos corporativos</span>
            <h1>Central de Downloads</h1>
            <p>Encontre pastas, consulte detalhes dos arquivos e baixe documentos com mais estabilidade.</p>
        </div>

        <div class="hero-stat">
            <strong>@arquivos.Count</strong>
            <span>@(arquivos.Count == 1 ? "arquivo" : "arquivos") nesta pasta</span>
        </div>
    </section>

    <section class="downloads-toolbar">
        <div class="breadcrumb">
            <a href="/">Downloads</a>
            @foreach (var item in breadcrumb)
            {
                <span>/</span>
                <a href="@GetFolderUrl(item.Caminho)">@item.Nome</a>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Pasta))
        {
            <a class="ghost-button" href="@GetFolderUrl(GetParentPath(Pasta))">Voltar</a>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(erro))
    {
        <section class="empty-state error-state">
            <h2>Não foi possível abrir esta pasta</h2>
            <p>@erro</p>
        </section>
    }
    else if (!pastas.Any() && !arquivos.Any())
    {
        <section class="empty-state">
            <h2>Nenhum item encontrado</h2>
            <p>Esta pasta ainda não possui arquivos ou subpastas disponíveis para download.</p>
        </section>
    }
    else
    {
        @if (pastas.Any())
        {
            <section class="folder-grid" aria-label="Pastas">
                @foreach (var pasta in pastas)
                {
                    <a class="folder-card" href="@GetFolderUrl(pasta.CaminhoRelativo)">
                        <span class="folder-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h4.2l2 2H18.5A2.5 2.5 0 0 1 21 9.5v7A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-9Z" />
                            </svg>
                        </span>
                        <span>
                            <strong>@pasta.Nome</strong>
                            <small>Pasta</small>
                        </span>
                    </a>
                }
            </section>
        }

        @if (arquivos.Any())
        {
            <section class="downloads-panel">
                <div class="panel-header">
                    <h2>Arquivos disponíveis</h2>
                    <span>@arquivos.Count item(ns)</span>
                </div>

                <div class="downloads-list">
                    @foreach (var arq in arquivos)
                    {
                        <article class="download-row">
                            <div class="file-mark" aria-hidden="true">@GetExtension(arq.Nome)</div>

                            <div class="file-main">
                                <strong title="@arq.Nome">@arq.Nome</strong>
                                <span>Modificado em @arq.DataModificacao.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="file-size">@FormatSize(arq.Tamanho)</div>

                            <a class="download-button" href="@GetDownloadUrl(arq.CaminhoRelativo)" download>
                                Baixar
                            </a>
                        </article>
                    }
                </div>
            </section>
        }
    }
</main>

<style>
