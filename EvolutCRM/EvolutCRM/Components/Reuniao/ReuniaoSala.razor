    // Chamadas vindas do JavaScript
    // ------------------------------------------------------------------
    [JSInvokable]
    public Task AtualizarEstadoConexao(string estado) => InvokeAsync(() =>
    {
        Conexao = estado;
        StateHasChanged();
    });

    [JSInvokable]
    public Task AtualizarMidiaLocal(bool mic, bool cam, bool tela, bool mao) => InvokeAsync(() =>
    {
        Mic = mic; Cam = cam; Tela = tela; Mao = mao;
        StateHasChanged();
    });

    [JSInvokable]
    public Task AtualizarParticipantes() => InvokeAsync(RecarregarPessoasAsync);

    [JSInvokable]
    public Task Aviso(string texto, string tipo) => InvokeAsync(() =>
    {
        MostrarToast(texto, tipo);
        StateHasChanged();
    });

    [JSInvokable]
    public Task ReceberMensagemRealtime(JsonElement mensagem) => InvokeAsync(() =>
    {
        var usuario = mensagem.TryGetProperty("usuario", out var u) ? u.GetString() ?? "" : "";
        var texto = mensagem.TryGetProperty("mensagem", out var t) ? t.GetString() ?? "" : "";
        Mensagens.Add(new ReuniaoMensagemModel { CodReuniao = CodReuniao, Usuario = usuario, Mensagem = texto, DataHora = DateTime.Now });

        if (Painel == "chat") _rolarChat = true;
        else
        {
            NaoLidas++;
            MostrarToast($"{ReuniaoVisual.Nome(usuario)}: {(texto.Length > 60 ? texto[..60] + "…" : texto)}", "info");
        }
        StateHasChanged();
    });

    [JSInvokable]
    public Task ReuniaoEncerradaPeloOrganizador() => InvokeAsync(() =>
    {
        EmChamada = false;
        MotivoFim = "encerrada";
        Etapa = EtapaSala.Fim;
        StateHasChanged();
    });

    [JSInvokable]
    public Task ReuniaoEncerradaPorOutraAba() => InvokeAsync(() =>
    {
        EmChamada = false;
        MotivoFim = "outra-aba";
        Etapa = EtapaSala.Fim;
        StateHasChanged();
    });

    // ------------------------------------------------------------------
    // Auxiliares de tela
    // ------------------------------------------------------------------
    private void MostrarToast(string texto, string tipo)
    {
        var item = new ToastItem(Guid.NewGuid(), texto, tipo);
        Toasts.Add(item);
        if (Toasts.Count > 4) Toasts.RemoveAt(0);
        _ = RemoverToastDepoisAsync(item.Id);
    }

    private async Task RemoverToastDepoisAsync(Guid id)
    {
        await Task.Delay(4000);
        if (_descartado) return;
        try
        {
            await InvokeAsync(() =>
            {
                Toasts.RemoveAll(t => t.Id == id);
                StateHasChanged();
            });
        }
        catch { }
    }

    private static string IconeToast(string tipo) => tipo switch
    {
        "entrou" => "fa-right-to-bracket",
        "saiu" => "fa-right-from-bracket",
        "mao" => "fa-hand",
        "erro" => "fa-circle-exclamation",
        _ => "fa-circle-info"
    };

    private string NomesNaSala()
    {
        var nomes = NaSala.Select(p => EhEu(p.Usuario) ? "Você" : ReuniaoVisual.Nome(p.Usuario).Split(' ')[0]).ToList();
        return nomes.Count switch
        {
            1 => nomes[0],
            2 => $"{nomes[0]} e {nomes[1]}",
            _ => $"{string.Join(", ", nomes.Take(nomes.Count - 1))} e {nomes[^1]}"
        };
    }

    private string TextoConexao() => Conexao.StartsWith("falhou:") ? Conexao[7..] : "Sem conexão com o servidor";

    private string TituloFim() => MotivoFim switch
    {
        "encerrada" => "O organizador encerrou a reunião",
        "encerrei" => "Reunião encerrada para todos",
        "outra-aba" => "Você entrou em outra reunião",
        "erro" => "Não foi possível entrar na chamada",
        _ => "Você saiu da reunião"
    };

    private string TextoFim() => MotivoFim switch
    {
        "encerrada" or "encerrei" => "A conversa do chat fica salva em Reuniões > Recentes.",
        "outra-aba" => "Só dá para participar de uma reunião por vez. Esta chamada foi fechada.",
        "erro" => string.IsNullOrWhiteSpace(Erro) ? "Verifique a conexão e tente de novo." : Erro,
        _ => "A reunião continua para quem ficou. Você pode voltar enquanto ela estiver aberta."
    };

    private RenderFragment DispositivosSelects() => __builder =>
    {
        if (Dispositivos.Microfones.Count > 0)
        {
            <div class="rn-campo">
                <label for="rn-sel-mic">Microfone</label>
                <select id="rn-sel-mic" @onchange="@(e => TrocarDispositivoAsync("mic", e.Value?.ToString()))">
                    @foreach (var d in Dispositivos.Microfones)
                    {
                        <option value="@d.Id" selected="@(d.Id == Dispositivos.MicAtual)">@d.Nome</option>
                    }
                </select>
            </div>
        }
        if (Dispositivos.Cameras.Count > 0)
        {
            <div class="rn-campo">
                <label for="rn-sel-cam">Câmera</label>
                <select id="rn-sel-cam" @onchange="@(e => TrocarDispositivoAsync("cam", e.Value?.ToString()))">
                    @if (string.IsNullOrEmpty(Dispositivos.CamAtual))
                    {
                        <option value="" selected>Escolha para ligar a câmera</option>
                    }
                    @foreach (var d in Dispositivos.Cameras)
                    {
                        <option value="@d.Id" selected="@(d.Id == Dispositivos.CamAtual)">@d.Nome</option>
                    }
                </select>
            </div>
        }
    };

    private static string LimparErro(Exception ex)
    {
        var msg = ex.Message;
        var idx = msg.IndexOf("HubException: ", StringComparison.Ordinal);
        if (idx >= 0) msg = msg[(idx + 14)..];
        if (msg.Contains("NotAllowedError")) return "Permissão de câmera, microfone ou tela negada no navegador";
        if (msg.Contains("NotFoundError")) return "Nenhuma câmera ou microfone encontrado";
        if (msg.Contains("NotReadableError")) return "A câmera ou o microfone está em uso por outro programa";
        return msg.Split('\n')[0].Trim();
    }

    public async ValueTask DisposeAsync()
    {
        _descartado = true;
        Notifier.OnEvento -= AoEvento;
        await EncerrarMidiaAsync();
        if (js is not null)
        {
            try { await js.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        dotNetRef?.Dispose();
    }

