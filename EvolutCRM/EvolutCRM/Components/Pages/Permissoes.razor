@page "/admin/permissoes"

@using EvolutCRM.Models
@using EvolutCRM.Services

@inject AdminService AdminService
@inject UserState UserState

<style>
    .pm {
        --pm-bg: #f4f7fb; --pm-card: #ffffff; --pm-line: #e3e9f2; --pm-line2: #cfd9e6;
        --pm-text: #0f172a; --pm-muted: #64748b; --pm-soft: #94a3b8;
        --pm-pri: #2563eb; --pm-pri2: #1d4ed8; --pm-pri-bg: #eff5ff;
        --pm-ok: #16a34a; --pm-ok-bg: #ecfdf3; --pm-warn: #b45309; --pm-warn-bg: #fff7ed;
        --pm-err: #b91c1c; --pm-err-bg: #fff1f2;
        --pm-shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px rgba(15,23,42,.06);
        min-height: calc(100vh - 24px); padding: 18px; background: var(--pm-bg); color: var(--pm-text);
        font-size: 13px; display: flex; flex-direction: column; gap: 14px;
    }
    .pm * { box-sizing: border-box; }

    /* ── topo ── */
    .pm-hero { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
        padding:18px 20px; border-radius:16px; color:#fff;
        background: radial-gradient(1200px 200px at 0% 0%, rgba(255,255,255,.18), transparent 60%),
                    linear-gradient(120deg, #1e3a8a 0%, #2563eb 55%, #0ea5e9 100%);
        box-shadow: 0 10px 30px rgba(37,99,235,.25); }
    .pm-hero h1 { margin:0; font-size:20px; font-weight:800; letter-spacing:-.01em; display:flex; align-items:center; gap:10px; }
    .pm-hero p { margin:4px 0 0; font-size:12.5px; opacity:.85; }
    .pm-hero-stats { display:flex; gap:10px; flex-wrap:wrap; }
    .pm-stat { min-width:110px; padding:9px 14px; border-radius:12px; background:rgba(255,255,255,.14);
        border:1px solid rgba(255,255,255,.22); backdrop-filter: blur(6px); }
    .pm-stat b { display:block; font-size:18px; font-weight:800; line-height:1.1; }
    .pm-stat span { font-size:11px; opacity:.85; }

    /* ── avisos ── */
    .pm-alert { display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:12px; font-weight:600;
        border:1px solid var(--pm-line); background:#fff; animation: pmIn .18s ease-out; }
    .pm-alert.ok { color:var(--pm-ok); background:var(--pm-ok-bg); border-color:#bbf7d0; }
    .pm-alert.err { color:var(--pm-err); background:var(--pm-err-bg); border-color:#fecdd3; }
    .pm-alert.warn { color:var(--pm-warn); background:var(--pm-warn-bg); border-color:#fed7aa; }
    .pm-empty { padding:42px 20px; text-align:center; color:var(--pm-muted); }
    .pm-empty .ic { font-size:34px; display:block; margin-bottom:8px; }
    @@keyframes pmIn { from { opacity:0; transform: translateY(4px);} to { opacity:1; transform:none; } }

    /* ── layout ── */
    .pm-grid { display:grid; grid-template-columns: 290px minmax(0,1fr); gap:14px; align-items:start; }
    .pm-card { background:var(--pm-card); border:1px solid var(--pm-line); border-radius:16px; box-shadow:var(--pm-shadow); }

    /* ── usuários ── */
    .pm-users { position:sticky; top:12px; display:flex; flex-direction:column; max-height: calc(100vh - 40px); }
    .pm-users-head { padding:14px 14px 10px; border-bottom:1px solid var(--pm-line); }
    .pm-users-head .t { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; font-weight:800; }
    .pm-pill { padding:2px 9px; border-radius:999px; background:var(--pm-pri-bg); color:var(--pm-pri2); font-size:11px; font-weight:800; }
    .pm-search { position:relative; }
    .pm-search input { width:100%; height:36px; padding:0 12px 0 32px; border:1px solid var(--pm-line2); border-radius:10px;
        background:#fbfcfe; font-size:13px; outline:none; transition: border-color .15s, box-shadow .15s; }
    .pm-search input:focus { border-color:var(--pm-pri); box-shadow:0 0 0 3px rgba(37,99,235,.12); background:#fff; }
    .pm-search::before { content:"⌕"; position:absolute; left:11px; top:50%; transform:translateY(-52%); color:var(--pm-soft); font-size:15px; }
    .pm-user-list { overflow:auto; padding:8px; display:flex; flex-direction:column; gap:4px; }
    .pm-user { display:flex; align-items:center; gap:10px; width:100%; padding:8px 10px; border:1px solid transparent; border-radius:12px;
        background:transparent; text-align:left; cursor:pointer; transition: background .12s, border-color .12s, transform .12s; font: inherit; color: inherit; }
    .pm-user:hover { background:#f6f9ff; }
    .pm-user.on { background:var(--pm-pri-bg); border-color:#c7dafe; }
    .pm-user .nm { flex:1; min-width:0; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .pm-user .cd { font-size:11px; color:var(--pm-soft); font-family: ui-monospace, Consolas, monospace; }
    .pm-av { flex:0 0 auto; width:32px; height:32px; border-radius:10px; display:grid; place-items:center;
        font-weight:800; font-size:12px; color:#fff; letter-spacing:.02em; }
    .pm-av.lg { width:46px; height:46px; border-radius:14px; font-size:16px; }

    /* ── painel ── */
    .pm-panel { display:flex; flex-direction:column; min-width:0; }
    .pm-sel { display:flex; align-items:center; gap:14px; padding:16px 18px; border-bottom:1px solid var(--pm-line); flex-wrap:wrap; }
    .pm-sel .info { flex:1; min-width:200px; }
    .pm-sel h2 { margin:0; font-size:17px; font-weight:800; }
    .pm-progress { margin-top:7px; display:flex; align-items:center; gap:10px; color:var(--pm-muted); font-size:12px; }
    .pm-bar { flex:1; max-width:260px; height:7px; border-radius:99px; background:#e8eef7; overflow:hidden; }
    .pm-bar i { display:block; height:100%; border-radius:99px; background:linear-gradient(90deg,#2563eb,#0ea5e9); transition: width .3s ease; }
    .pm-tools { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
    .pm-btn { height:34px; padding:0 13px; border-radius:10px; border:1px solid var(--pm-line2); background:#fff; color:var(--pm-text);
        font: inherit; font-weight:700; font-size:12.5px; cursor:pointer; display:inline-flex; align-items:center; gap:6px;
        transition: background .12s, border-color .12s, box-shadow .12s, transform .05s; white-space:nowrap; }
    .pm-btn:hover:not(:disabled) { border-color:#b8c7dc; background:#f8fafc; }
    .pm-btn:active:not(:disabled) { transform: translateY(1px); }
    .pm-btn:disabled { opacity:.55; cursor:not-allowed; }
    .pm-btn.pri { background:var(--pm-pri); border-color:var(--pm-pri); color:#fff; box-shadow:0 4px 12px rgba(37,99,235,.25); }
    .pm-btn.pri:hover:not(:disabled) { background:var(--pm-pri2); border-color:var(--pm-pri2); }
    .pm-btn.ghost { border-color:transparent; background:transparent; color:var(--pm-muted); }
    .pm-select { height:34px; padding:0 10px; border-radius:10px; border:1px solid var(--pm-line2); background:#fff; font: inherit; font-size:12.5px; }

    .pm-filters { display:flex; gap:10px; align-items:center; padding:12px 18px 4px; flex-wrap:wrap; }
    .pm-filters .pm-search { flex:1; min-width:220px; }
    .pm-chips { display:flex; gap:6px; flex-wrap:wrap; padding:8px 18px 14px; border-bottom:1px solid var(--pm-line); }
    .pm-chip { position:relative; overflow:hidden; display:inline-flex; align-items:center; gap:7px; height:30px; padding:0 11px;
        border-radius:999px; border:1px solid var(--pm-line2); background:#fff; font: inherit; font-size:12px; font-weight:700;
        color:#334155; cursor:pointer; transition: all .12s; }
    .pm-chip small { font-size:10.5px; color:var(--pm-soft); font-weight:800; }
    .pm-chip:hover { border-color:#b8c7dc; }
    .pm-chip.on { background:#0f172a; border-color:#0f172a; color:#fff; }
    .pm-chip.on small { color:#cbd5e1; }

    .pm-body { padding:14px 18px 18px; display:grid; grid-template-columns: repeat(auto-fill, minmax(340px,1fr)); gap:12px; }
    .pm-group { border:1px solid var(--pm-line); border-radius:14px; background:#fff; overflow:hidden; animation: pmIn .2s ease-out; }
    .pm-group-head { display:flex; align-items:center; gap:10px; padding:11px 13px; background:linear-gradient(180deg,#fbfcfe,#f5f8fc); border-bottom:1px solid var(--pm-line); }
    .pm-group-head .ic { width:28px; height:28px; border-radius:9px; display:grid; place-items:center; background:var(--pm-pri-bg); font-size:14px; }
    .pm-group-head .nm { flex:1; font-weight:800; }
    .pm-group-head .ct { font-size:11px; font-weight:800; color:var(--pm-muted); }
    .pm-items { display:flex; flex-direction:column; }
    .pm-item { display:flex; align-items:flex-start; gap:12px; padding:11px 13px; border-top:1px solid #f1f4f9; cursor:pointer; transition: background .12s; }
    .pm-item:first-child { border-top:0; }
    .pm-item:hover { background:#fafcff; }
    .pm-item.on { background:#f7fbff; }
    .pm-item .tx { flex:1; min-width:0; }
    .pm-item .tt { font-weight:700; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .pm-item .ds { margin-top:2px; color:var(--pm-muted); font-size:12px; line-height:1.35; }
    .pm-code { font-family: ui-monospace, Consolas, monospace; font-size:10px; color:var(--pm-soft); background:#f1f5f9; padding:1px 6px; border-radius:6px; font-weight:600; }
    .pm-dep { font-size:10.5px; font-weight:700; color:var(--pm-warn); background:var(--pm-warn-bg); border:1px solid #fed7aa; padding:1px 7px; border-radius:999px; }
    .pm-mod { font-size:10.5px; font-weight:800; color:var(--pm-pri2); }

    /* chave liga/desliga */
    .pm-sw { position:relative; flex:0 0 auto; width:38px; height:22px; margin-top:1px; }
    .pm-sw input { position:absolute; inset:0; opacity:0; margin:0; cursor:pointer; }
    .pm-sw span { position:absolute; inset:0; border-radius:99px; background:#cbd5e1; transition: background .18s; pointer-events:none; }
    .pm-sw span::after { content:""; position:absolute; top:3px; left:3px; width:16px; height:16px; border-radius:50%; background:#fff;
        box-shadow:0 1px 3px rgba(0,0,0,.25); transition: transform .18s cubic-bezier(.4,1.4,.6,1); }
    .pm-sw input:checked + span { background:var(--pm-pri); }
    .pm-sw input:checked + span::after { transform: translateX(16px); }
    .pm-sw input:focus-visible + span { box-shadow:0 0 0 3px rgba(37,99,235,.25); }
    .pm-sw.sm { width:32px; height:18px; }
    .pm-sw.sm span::after { width:12px; height:12px; }
    .pm-sw.sm input:checked + span::after { transform: translateX(14px); }

    /* barra de alterações pendentes */
    .pm-dirty { position:sticky; bottom:12px; z-index:5; display:flex; align-items:center; gap:12px; justify-content:space-between; flex-wrap:wrap;
        margin:0 18px 16px; padding:10px 12px 10px 16px; border-radius:14px; background:#0f172a; color:#e2e8f0;
        box-shadow:0 14px 34px rgba(15,23,42,.35); animation: pmUp .2s ease-out; }
    .pm-dirty b { color:#fff; }
    .pm-dirty .pm-btn { border-color:#334155; background:#1e293b; color:#e2e8f0; }
    .pm-dirty .pm-btn.pri { background:var(--pm-pri); border-color:var(--pm-pri); color:#fff; }
    @@keyframes pmUp { from { opacity:0; transform: translateY(10px);} to { opacity:1; transform:none; } }

    /* metas */
    .pm-metas summary { list-style:none; cursor:pointer; display:flex; align-items:center; gap:10px; padding:12px 16px; font-weight:800; }
    .pm-metas summary::-webkit-details-marker { display:none; }
    .pm-metas summary .hint { font-weight:500; color:var(--pm-muted); font-size:12px; }
    .pm-metas summary .chev { margin-left:auto; color:var(--pm-soft); transition: transform .15s; }
    .pm-metas[open] summary .chev { transform: rotate(180deg); }
    .pm-metas-body { display:flex; align-items:flex-end; gap:12px; flex-wrap:wrap; padding:0 16px 14px; }
    .pm-field label { display:block; font-size:11px; font-weight:800; color:var(--pm-muted); margin-bottom:4px; text-transform:uppercase; letter-spacing:.04em; }
    .pm-field input { width:130px; height:34px; padding:0 10px; border:1px solid var(--pm-line2); border-radius:10px; font: inherit; }

    @@media (max-width: 900px) {
        .pm-grid { grid-template-columns: 1fr; }
        .pm-users { position:static; max-height:320px; }
        .pm-body { grid-template-columns: 1fr; }
    }
</style>

<div class="pm">
    <header class="pm-hero">
        <div>
            <h1>🔐 Permissões</h1>
            <p>Defina o que cada pessoa da equipe pode ver e fazer no HELP · @UserState.CurrentCompany</p>
        </div>
        @if (!Carregando && PodeAcessarAdmin && PodeGerenciarPermissoes)
        {
            <div class="pm-hero-stats">
                <div class="pm-stat"><b>@Usuarios.Count</b><span>usuários ativos</span></div>
                <div class="pm-stat"><b>@PermissoesTela.Count</b><span>permissões</span></div>
                <div class="pm-stat"><b>@ModulosPermissao.Count()</b><span>módulos</span></div>
            </div>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(MensagemPermissao) && !TemAlteracoes)
    {
        <div class="pm-alert @TipoMensagem(MensagemPermissao)">@MensagemPermissao</div>
    }

    @if (Carregando)
    {
        <div class="pm-card pm-empty"><span class="ic">⏳</span>Carregando permissões...</div>
    }
    else if (!PodeAcessarAdmin || !PodeGerenciarPermissoes)
    {
        <div class="pm-card pm-empty"><span class="ic">🔒</span>Você não tem permissão para acessar esta tela.</div>
    }
    else
    {
        <details class="pm-card pm-metas">
            <summary>🎯 Metas do Dashboard <span class="hint">Mensal @MetaMensalInput.ToString("0.#")% · Anual @MetaAnualInput.ToString("0.#")%</span><span class="chev">▾</span></summary>
            <div class="pm-metas-body">
                <div class="pm-field">
                    <label>Mensal (%)</label>
                    <input type="number" step="0.1"
                           value="@MetaMensalInput.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @onchange="AlterarMetaMensal" />
                </div>
                <div class="pm-field">
                    <label>Anual (%)</label>
                    <input type="number" step="0.1"
                           value="@MetaAnualInput.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           @onchange="AlterarMetaAnual" />
                </div>
                <button type="button" class="pm-btn pri" @onclick="SalvarMetasPainel" disabled="@SalvandoMetas">
                    @(SalvandoMetas ? "Salvando..." : "Salvar metas")
                </button>
                @if (!string.IsNullOrWhiteSpace(MensagemMeta))
                {
                    <span style="color:var(--pm-muted); font-weight:600;">@MensagemMeta</span>
                }
            </div>
        </details>

        <div class="pm-grid">
            <aside class="pm-card pm-users">
                <div class="pm-users-head">
                    <div class="t">Equipe <span class="pm-pill">@UsuariosFiltrados.Count()</span></div>
                    <div class="pm-search">
                        <input placeholder="Buscar pessoa..." @bind="FiltroUsuarios" @bind:event="oninput" />
                    </div>
                </div>
                <div class="pm-user-list">
                    @foreach (var user in UsuariosFiltrados)
                    {
                        <button type="button" class="pm-user @(UsuarioSelecionado?.Codigo == user.Codigo ? "on" : "")"
                                @onclick="() => PedirTrocaUsuario(user)">
                            <span class="pm-av" style="background:@CorAvatar(user.Usuario)">@Iniciais(user.Usuario)</span>
                            <span class="nm">@user.Usuario</span>
                            <span class="cd">#@user.Codigo</span>
                        </button>
                    }
                    @if (!UsuariosFiltrados.Any())
                    {
                        <div class="pm-empty" style="padding:20px;">Ninguém com esse nome.</div>
                    }
                </div>
            </aside>

            <section class="pm-card pm-panel">
                @if (_trocaPendente != null)
                {
                    <div class="pm-alert warn" style="margin:14px 18px 0;">
                        <span style="flex:1;">Há alterações não salvas para <b>@UsuarioSelecionado?.Usuario</b>. Trocar para <b>@_trocaPendente.Usuario</b> descarta essas alterações.</span>
                        <button type="button" class="pm-btn" @onclick="() => _trocaPendente = null">Continuar editando</button>
                        <button type="button" class="pm-btn pri" @onclick="ConfirmarTroca">Descartar e trocar</button>
                    </div>
                }

                @if (UsuarioSelecionado == null)
                {
                    <div class="pm-empty" style="padding:80px 20px;">
                        <span class="ic">👈</span>
                        <b style="color:var(--pm-text); font-size:14px;">Escolha uma pessoa da equipe</b><br />
                        As permissões dela aparecem aqui, separadas por módulo.
                    </div>
                }
                else
                {
                    <div class="pm-sel">
                        <span class="pm-av lg" style="background:@CorAvatar(UsuarioSelecionado.Usuario)">@Iniciais(UsuarioSelecionado.Usuario)</span>
                        <div class="info">
                            <h2>@UsuarioSelecionado.Usuario</h2>
                            <div class="pm-progress">
                                <div class="pm-bar"><i style="width:@(PercentualAtivas)%"></i></div>
                                <span><b style="color:var(--pm-text);">@PermissoesAtivas</b> de @PermissoesTela.Count ativas</span>
                            </div>
                        </div>
                        <div class="pm-tools">
                            <select class="pm-select" @bind="_copiarDe" title="Copia as permissões de outra pessoa (só salva quando você clicar em Salvar)">
                                <option value="0">Copiar de...</option>
                                @foreach (var u in Usuarios.Where(x => x.Codigo != UsuarioSelecionado.Codigo))
                                {
                                    <option value="@u.Codigo">@u.Usuario</option>
                                }
                            </select>
                            <button type="button" class="pm-btn" disabled="@(_copiarDe == 0 || _copiando)" @onclick="CopiarPermissoes">
                                @(_copiando ? "Copiando..." : "Aplicar")
                            </button>
                        </div>
                    </div>

                    <div class="pm-filters">
                        <div class="pm-search">
                            <input placeholder="Filtrar por nome, código ou descrição..." @bind="FiltroPermissoes" @bind:event="oninput" />
                        </div>
                        <select class="pm-select" @bind="_mostrar">
                            <option value="todas">Todas</option>
                            <option value="ativas">Só ativas</option>
                            <option value="inativas">Só desligadas</option>
                        </select>
                        <button type="button" class="pm-btn ghost" @onclick="MarcarTodas" title="Liga todas as permissões exibidas">Ligar exibidas</button>
                        <button type="button" class="pm-btn ghost" @onclick="DesmarcarTodas" title="Desliga todas as permissões exibidas">Desligar exibidas</button>
                    </div>

                    <div class="pm-chips">
                        <button type="button" class="pm-chip @(ModuloSelecionado == null ? "on" : "")" @onclick="() => SelecionarModulo(null)">
                            Todos <small>@PermissoesAtivas/@PermissoesTela.Count</small>
                        </button>
                        @foreach (var modulo in ModulosPermissao)
                        {
                            var ativos = PermissoesTela.Count(p => p.Modulo == modulo && p.Ativo);
                            <button type="button" class="pm-chip @(string.Equals(ModuloSelecionado, modulo, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                    @onclick="() => SelecionarModulo(modulo)">
                                @IconeModulo(modulo) @modulo <small>@ativos/@QuantidadeModulo(modulo)</small>
                            </button>
                        }
                    </div>

                    @if (!PermissoesExibidas.Any())
                    {
                        <div class="pm-empty"><span class="ic">🔎</span>Nenhuma permissão com esse filtro.</div>
                    }
                    else
                    {
                        <div class="pm-body">
                            @foreach (var grupo in PermissoesExibidas.GroupBy(p => p.Modulo).OrderBy(g => g.Key))
                            {
                                var todasLigadas = grupo.All(p => p.Ativo);
                                <div class="pm-group">
                                    <div class="pm-group-head">
                                        <span class="ic">@IconeModulo(grupo.Key)</span>
                                        <span class="nm">@grupo.Key</span>
                                        <span class="ct">@grupo.Count(p => p.Ativo)/@grupo.Count()</span>
                                        <label class="pm-sw sm" title="@(todasLigadas ? "Desligar todas deste módulo" : "Ligar todas deste módulo")">
                                            <input type="checkbox" checked="@todasLigadas" @onchange="e => AlternarGrupo(grupo.ToList(), e)" />
                                            <span></span>
                                        </label>
                                    </div>
                                    <div class="pm-items">
                                        @foreach (var item in grupo.OrderBy(p => p.Titulo))
                                        {
                                            var falta = DependenciaFaltando(item);
                                            <label class="pm-item @(item.Ativo ? "on" : "")">
                                                <span class="pm-sw">
                                                    <input type="checkbox" checked="@item.Ativo" @onchange="e => MarcarPermissao(item, e)" />
                                                    <span></span>
                                                </span>
                                                <span class="tx">
                                                    <span class="tt">
                                                        @item.Titulo
                                                        @if (Alterada(item))
                                                        {
                                                            <span class="pm-mod">● alterada</span>
                                                        }
                                                        @if (falta != null)
                                                        {
                                                            <span class="pm-dep" title="Sem ela, esta permissão não aparece no menu">precisa de: @falta</span>
                                                        }
                                                    </span>
                                                    <span class="ds">@item.Descricao</span>
                                                    <span class="pm-code">@item.Permissao</span>
                                                </span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (TemAlteracoes)
                    {
                        <div class="pm-dirty">
                            <span><b>@QuantidadeAlteradas alteração(ões)</b> não salva(s) para @UsuarioSelecionado.Usuario</span>
                            <span style="display:flex; gap:8px;">
                                <button type="button" class="pm-btn" @onclick="RecarregarUsuarioSelecionado" disabled="@SalvandoPermissoes">Descartar</button>
                                <button type="button" class="pm-btn pri" @onclick="SalvarPermissoesUsuario" disabled="@SalvandoPermissoes">
                                    @(SalvandoPermissoes ? "Salvando..." : "💾 Salvar permissões")
                                </button>
                            </span>
                        </div>
                    }
                }
            </section>
        </div>
