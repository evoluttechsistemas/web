    private static string CorAvatar(string? nome)
    {
        var h = 0;
        foreach (var c in (nome ?? "").ToUpperInvariant()) h = (h * 31 + c) & 0x7fffffff;
        return CoresAvatar[h % CoresAvatar.Length];
    }

