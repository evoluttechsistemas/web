    private IEnumerable<AdminUsuarioCrmDto> UsuariosFiltrados =>
        string.IsNullOrWhiteSpace(FiltroUsuarios)
            ? Usuarios
            : Usuarios.Where(u =>
                (u.Usuario ?? "").Contains(FiltroUsuarios, StringComparison.OrdinalIgnoreCase) ||
                u.Codigo.ToString().Contains(FiltroUsuarios.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<string> ModulosPermissao =>
        PermissoesTela
            .Select(p => p.Modulo)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(p => p);

    private IEnumerable<PermissaoTelaDto> PermissoesFiltradas
    {
        get
        {
            var q = PermissoesTela.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(ModuloSelecionado))
                q = q.Where(p => string.Equals(p.Modulo, ModuloSelecionado, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(FiltroPermissoes))
            {
                var termo = FiltroPermissoes.Trim();
                q = q.Where(p =>
                    p.Modulo.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    p.Permissao.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    p.Titulo.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    p.Descricao.Contains(termo, StringComparison.OrdinalIgnoreCase));
            }

            return q;
        }
    }

    private int PermissoesAtivas => PermissoesTela.Count(p => p.Ativo);

    protected override async Task OnInitializedAsync()
    {
        Carregando = true;
        MensagemPermissao = "";

        try
        {
            int tentativas = 0;

            while (!UserState.IsReady && tentativas < 100)
            {
                await Task.Delay(50);
                tentativas++;
            }

            if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser))
            {
                MensagemPermissao = "Usuário ainda não foi carregado. Atualize a página.";
                PodeAcessarAdmin = false;
                return;
            }

            var usuarioLogado = UserState.CurrentUser.Trim().ToUpperInvariant();

            PodeAcessarAdmin = await AdminService.UsuarioTemPermissaoAsync(
                usuarioLogado,
                "ADMIN_ACESSAR"
            );

            PodeGerenciarPermissoes = await AdminService.UsuarioTemPermissaoAsync(
                usuarioLogado,
                "ADMIN_PERMISSOES"
            );

            if (!PodeAcessarAdmin || !PodeGerenciarPermissoes)
            {
                MensagemPermissao = "Você não tem permissão para acessar a tela de permissões.";
                return;
            }

            Usuarios = await AdminService.ListarUsuariosCrmAsync();
            MontarPermissoesPadrao();

            var metas = await AdminService.ObterMetasPainelAsync();
            MetaMensalInput = metas.mensal;
            MetaAnualInput = metas.anual;
        }
        catch (Exception ex)
        {
            MensagemPermissao = "Erro ao carregar permissões: " + ex.Message;
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task SelecionarUsuario(AdminUsuarioCrmDto user)
    {
        UsuarioSelecionado = user;
        MensagemPermissao = "";
        FiltroPermissoes = "";
        ModuloSelecionado = null;

        MontarPermissoesPadrao();

        var permissoesBanco = await AdminService.ListarPermissoesUsuarioAsync(user.Codigo);

        foreach (var item in PermissoesTela)
        {
            var encontrada = permissoesBanco.FirstOrDefault(p =>
                string.Equals(p.Modulo?.Trim(), item.Modulo?.Trim(), StringComparison.OrdinalIgnoreCase)
                && string.Equals(p.Permissao?.Trim(), item.Permissao?.Trim(), StringComparison.OrdinalIgnoreCase));

            item.Ativo = encontrada?.Ativo == true;
        }

        PermissaoGeral = PermissoesTela.Any() && PermissoesTela.All(p => p.Ativo);
        _original = PermissoesTela.ToDictionary(p => p.Permissao, p => p.Ativo, StringComparer.OrdinalIgnoreCase);
        _copiarDe = 0;
        _trocaPendente = null;
    }

    // ── Layout novo: alterações pendentes, cópia de permissões, dependências ──
    private Dictionary<string, bool> _original = new(StringComparer.OrdinalIgnoreCase);
    private AdminUsuarioCrmDto? _trocaPendente;
    private int _copiarDe;
    private bool _copiando;
    private string _mostrar = "todas";

    private bool Alterada(PermissaoTelaDto p) => _original.TryGetValue(p.Permissao, out var era) ? era != p.Ativo : p.Ativo;
    private int QuantidadeAlteradas => PermissoesTela.Count(Alterada);
    private bool TemAlteracoes => UsuarioSelecionado != null && QuantidadeAlteradas > 0;
    private int PercentualAtivas => PermissoesTela.Count == 0 ? 0 : (int)Math.Round(PermissoesAtivas * 100.0 / PermissoesTela.Count);

    private IEnumerable<PermissaoTelaDto> PermissoesExibidas => _mostrar switch
    {
        "ativas" => PermissoesFiltradas.Where(p => p.Ativo),
        "inativas" => PermissoesFiltradas.Where(p => !p.Ativo),
        _ => PermissoesFiltradas
    };

    private async Task PedirTrocaUsuario(AdminUsuarioCrmDto user)
    {
        if (UsuarioSelecionado?.Codigo == user.Codigo) return;
        if (TemAlteracoes) { _trocaPendente = user; return; }
        await SelecionarUsuario(user);
    }

    private async Task ConfirmarTroca()
    {
        var destino = _trocaPendente;
        _trocaPendente = null;
        if (destino != null) await SelecionarUsuario(destino);
    }

    private void AlternarGrupo(List<PermissaoTelaDto> itens, ChangeEventArgs e)
    {
        var ligar = ValorBool(e);
        foreach (var i in itens) i.Ativo = ligar;
        MensagemPermissao = "";
    }

    private async Task CopiarPermissoes()
    {
        if (UsuarioSelecionado == null || _copiarDe == 0) return;
        _copiando = true;
        try
        {
            var origem = await AdminService.ListarPermissoesUsuarioAsync(_copiarDe);
            var ativas = origem.Where(p => p.Ativo).Select(p => (p.Permissao ?? "").Trim())
                               .ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var item in PermissoesTela)
                item.Ativo = ativas.Contains(item.Permissao);
            var nome = Usuarios.FirstOrDefault(u => u.Codigo == _copiarDe)?.Usuario ?? "";
            MensagemPermissao = $"Permissões de {nome} aplicadas. Confira e salve.";
        }
        catch (Exception ex)
        {
            MensagemPermissao = "Erro ao copiar permissões: " + ex.Message;
        }
        finally
        {
            _copiando = false;
        }
    }

