@page "/admin/backups-clientes"
@using EvolutCRM.Services
@inject BackupFtpService BackupFtp
@inject UserState UserState

<ExigePermissao Permissoes="ADMIN_ACESSAR">
<div class="bk-wrap">
    <div class="bk-hero">
        <div>
            <div class="bk-kicker">Sistema</div>
            <h1>Backups dos Clientes</h1>
            <p>Arquivos enviados pelos clientes para o servidor de backup. Clique em um arquivo para baixar.</p>
        </div>
        <button class="bk-btn bk-btn-light" disabled="@_carregando" @onclick="CarregarAsync">
            @(_carregando ? "Atualizando..." : "↻ Atualizar")
        </button>
    </div>

    <div class="bk-card bk-bar">
        <div class="bk-crumbs">
            <button class="bk-crumb" @onclick="@(() => AbrirPastaAsync(""))">📁 BackupClientes</button>
            @foreach (var (nome, caminho) in Migalhas())
            {
                <span class="bk-sep">›</span>
                <button class="bk-crumb" @onclick="@(() => AbrirPastaAsync(caminho))">@nome</button>
            }
        </div>
        <input class="bk-busca" placeholder="Buscar por cliente, CNPJ ou nome do arquivo"
               @bind="_busca" @bind:event="oninput" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_erro))
    {
        <div class="bk-alerta">@_erro</div>
    }

    <div class="bk-card bk-lista">
        @if (_carregando && _itens.Count == 0)
        {
            <div class="bk-vazio">Conectando ao servidor de backup...</div>
        }
        else if (Filtrados.Count == 0)
        {
            <div class="bk-vazio">@(string.IsNullOrWhiteSpace(_busca) ? "Nenhum arquivo nesta pasta." : "Nada encontrado para essa busca.")</div>
        }
        else
        {
            <div class="bk-resumo">
                @Filtrados.Count(i => i.Pasta) pasta(s) · @Filtrados.Count(i => !i.Pasta) arquivo(s)
                · @Tamanho(Filtrados.Sum(i => i.Tamanho))
            </div>
            <table class="bk-tabela">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Cliente</th>
                        <th class="bk-dir">Tamanho</th>
                        <th class="bk-dir">Modificado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Filtrados)
                    {
                        <tr @key="i.Caminho">
                            <td data-label="Nome">
                                @if (i.Pasta)
                                {
                                    <button class="bk-nome bk-link" @onclick="@(() => AbrirPastaAsync(i.Caminho))">📁 @i.Nome</button>
                                }
                                else
                                {
                                    <span class="bk-nome">@Icone(i.Nome) @i.Nome</span>
                                }
                            </td>
                            <td data-label="Cliente">@(string.IsNullOrEmpty(i.Cliente) ? "—" : i.Cliente)</td>
                            <td data-label="Tamanho" class="bk-dir">@(i.Pasta ? "—" : Tamanho(i.Tamanho))</td>
                            <td data-label="Modificado" class="bk-dir">
                                @(i.Modificado?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                @if (!i.Pasta && i.Modificado is DateTime m)
                                {
                                    <small class="@ClasseIdade(m)">@Idade(m)</small>
                                }
                            </td>
                            <td class="bk-acao">
                                @if (i.Pasta)
                                {
                                    <button class="bk-btn bk-btn-sec" @onclick="@(() => AbrirPastaAsync(i.Caminho))">Abrir</button>
                                }
                                else
                                {
                                    <a class="bk-btn" href="@BackupFtpService.LinkDownload(i.Caminho, _usuario)" download="@i.Nome">⬇ Baixar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</ExigePermissao>

<style>
    .bk-wrap { --bk-ink:#0f172a; --bk-muted:#64748b; --bk-line:#e2e8f0; --bk-blue:#2563eb; --bk-blue-d:#1e3a8a;
        height:100%; overflow-y:auto; background:#f0f4fd; padding:20px 22px 40px; color:var(--bk-ink);
        font-family:'IBM Plex Sans', sans-serif; }
    .bk-hero { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;
        padding:22px 24px; border-radius:16px; color:#fff; margin-bottom:16px;
        background:linear-gradient(120deg, #1e3a8a 0%, #2563eb 60%, #38bdf8 100%); box-shadow:0 12px 30px rgba(37,99,235,.25); }
    .bk-hero h1 { margin:2px 0 4px; font-size:22px; font-weight:800; }
    .bk-hero p { margin:0; font-size:13px; opacity:.9; }
    .bk-kicker { font-size:11px; letter-spacing:.08em; text-transform:uppercase; opacity:.8; font-weight:700; }
    .bk-card { background:#fff; border:1px solid var(--bk-line); border-radius:14px; box-shadow:0 6px 18px rgba(15,23,42,.05); }
    .bk-bar { display:flex; gap:12px; align-items:center; justify-content:space-between; flex-wrap:wrap; padding:12px 14px; margin-bottom:14px; }
    .bk-crumbs { display:flex; align-items:center; flex-wrap:wrap; gap:4px; min-width:0; }
    .bk-crumb { border:none; background:#eff6ff; color:var(--bk-blue-d); font-weight:700; font-size:12.5px;
        padding:6px 10px; border-radius:8px; cursor:pointer; }
    .bk-crumb:hover { background:#dbeafe; }
    .bk-sep { color:var(--bk-muted); }
    .bk-busca { flex:1 1 280px; max-width:420px; border:1px solid var(--bk-line); border-radius:10px; padding:9px 12px;
        font-size:13px; outline:none; }
    .bk-busca:focus { border-color:var(--bk-blue); box-shadow:0 0 0 3px rgba(37,99,235,.15); }
    .bk-alerta { background:#fef2f2; border:1px solid #fca5a5; color:#b91c1c; border-radius:12px; padding:10px 14px;
        font-size:13px; font-weight:600; margin-bottom:14px; }
    .bk-lista { overflow:hidden; }
    .bk-resumo { padding:10px 16px; font-size:12px; color:var(--bk-muted); border-bottom:1px solid var(--bk-line); }
    .bk-vazio { padding:40px; text-align:center; color:var(--bk-muted); font-size:13px; }
    .bk-tabela { width:100%; border-collapse:collapse; font-size:13px; }
    .bk-tabela th { text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--bk-muted);
        padding:10px 16px; background:#f8fafc; border-bottom:1px solid var(--bk-line); position:sticky; top:0; }
    .bk-tabela td { padding:10px 16px; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
    .bk-tabela tr:hover td { background:#f8fbff; }
    .bk-dir { text-align:right; white-space:nowrap; }
    .bk-dir small { display:block; font-size:11px; }
    .bk-nome { font-weight:700; word-break:break-all; }
    .bk-link { border:none; background:none; padding:0; color:var(--bk-blue-d); cursor:pointer; font-size:13px; text-align:left; }
    .bk-link:hover { text-decoration:underline; }
    .bk-acao { text-align:right; white-space:nowrap; }
    .bk-btn { display:inline-flex; align-items:center; gap:6px; border:none; border-radius:9px; padding:7px 13px;
        font-weight:700; font-size:12.5px; cursor:pointer; text-decoration:none;
        background:linear-gradient(135deg, #2563eb, #1d4ed8); color:#fff; }
    .bk-btn:hover { filter:brightness(1.08); color:#fff; }
    .bk-btn-sec { background:#eff6ff; color:var(--bk-blue-d); }
    .bk-btn-sec:hover { background:#dbeafe; color:var(--bk-blue-d); }
    .bk-btn-light { background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.35); }
    .bk-btn:disabled { opacity:.6; cursor:default; }
    .bk-novo { color:#16a34a; } .bk-medio { color:#d97706; } .bk-velho { color:#dc2626; }
    @@media (max-width: 760px) {
        .bk-wrap { padding:12px 12px 32px; }
        .bk-tabela thead { display:none; }
        .bk-tabela, .bk-tabela tbody, .bk-tabela tr, .bk-tabela td { display:block; width:100%; }
        .bk-tabela tr { padding:10px 14px; border-bottom:1px solid var(--bk-line); }
        .bk-tabela td { border:none; padding:3px 0; text-align:left; }
        .bk-tabela td[data-label]::before { content:attr(data-label) ": "; color:var(--bk-muted); font-size:11px; font-weight:700; }
        .bk-dir small { display:inline; margin-left:6px; }
        .bk-acao { padding-top:8px !important; }
    }
</style>

@code {
    private List<BackupFtpItem> _itens = new();
    private Dictionary<string, string> _clientes = new();
    private string _pasta = "";
    private string _busca = "";
    private string _erro = "";
    private string _usuario = "";
    private bool _carregando;

    protected override async Task OnInitializedAsync()
    {
        var tentativas = 0;
        while (!UserState.IsReady && tentativas < 100) { await Task.Delay(50); tentativas++; }
        _usuario = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();
        try { _clientes = await BackupFtp.ClientesPorDocumentoAsync(UserState.CurrentCompanyId); } catch { }
        await CarregarAsync();
    }

    private async Task AbrirPastaAsync(string caminho)
    {
        _pasta = caminho;
        _busca = "";
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = "";
        StateHasChanged();
        try
        {
            var itens = await BackupFtp.ListarAsync(_pasta);
            foreach (var i in itens) i.Cliente = ClienteDoNome(i.Nome);
            _itens = itens
                .OrderByDescending(i => i.Pasta)
                .ThenByDescending(i => i.Modificado ?? DateTime.MinValue)
                .ThenBy(i => i.Nome)
                .ToList();
        }
        catch (Exception ex)
        {
            _itens = new();
            _erro = "Não consegui ler o servidor de backup: " + ex.Message;
        }
        finally { _carregando = false; }
    }

    private List<BackupFtpItem> Filtrados
    {
        get
        {
            var b = (_busca ?? "").Trim();
            if (b.Length == 0) return _itens;
            var digitos = new string(b.Where(char.IsAsciiDigit).ToArray());
            return _itens.Where(i =>
                i.Nome.Contains(b, StringComparison.OrdinalIgnoreCase)
                || i.Cliente.Contains(b, StringComparison.OrdinalIgnoreCase)
                || (digitos.Length >= 4 && new string(i.Nome.Where(char.IsAsciiDigit).ToArray()).Contains(digitos)))
                .ToList();
        }
    }

    // Procura um CPF/CNPJ dentro do nome do arquivo/pasta (com ou sem pontuação)
    private string ClienteDoNome(string nome)
    {
        if (_clientes.Count == 0) return "";
        var digitos = new string(nome.Select(c => char.IsAsciiDigit(c) ? c : ' ').ToArray());
        foreach (var bloco in digitos.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            if (bloco.Length is 11 or 14 && _clientes.TryGetValue(bloco, out var cli)) return cli;
        var junto = new string(nome.Where(char.IsAsciiDigit).ToArray());
        for (int i = 0; i + 14 <= junto.Length; i++)
            if (_clientes.TryGetValue(junto.Substring(i, 14), out var cli)) return cli;
        return "";
    }

    private IEnumerable<(string Nome, string Caminho)> Migalhas()
    {
        var acumulado = "";
        foreach (var parte in _pasta.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            acumulado = acumulado.Length == 0 ? parte : acumulado + "/" + parte;
            yield return (parte, acumulado);
        }
    }

    private static string Tamanho(long bytes) => bytes switch
    {
        <= 0 => "—",
        < 1024 => $"{bytes} B",
        < 1024L * 1024 => $"{bytes / 1024d:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / 1024d / 1024:0.#} MB",
        _ => $"{bytes / 1024d / 1024 / 1024:0.##} GB"
    };

    private static string Icone(string nome) => Path.GetExtension(nome).ToLowerInvariant() switch
    {
        ".zip" or ".rar" or ".7z" or ".gz" => "🗜️",
        ".bak" or ".fdb" or ".gdb" or ".mdf" or ".sql" => "🗄️",
        _ => "📄"
    };

    private static string Idade(DateTime m)
    {
        var d = (DateTime.Now - m).TotalDays;
        return d < 1 ? "hoje" : d < 2 ? "ontem" : $"há {(int)d} dias";
    }

    private static string ClasseIdade(DateTime m)
    {
        var d = (DateTime.Now - m).TotalDays;
        return d <= 2 ? "bk-novo" : d <= 7 ? "bk-medio" : "bk-velho";
    }
}
