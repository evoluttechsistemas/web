    private async Task<string> SalvarArquivoImagem(IBrowserFile arquivo, string extensao, string subpasta = "imagens")
    {
        var pastaFisica = Path.Combine(@"C:\FTP\Site\Help\wwwroot\uploads\documentacoes", subpasta);
        var pastaRelativa = $"uploads/documentacoes/{subpasta}";
        Directory.CreateDirectory(pastaFisica);

        var nomeArquivo = $"{Guid.NewGuid():N}{extensao}";
