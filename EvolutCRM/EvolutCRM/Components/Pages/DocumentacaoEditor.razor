    private CancellationTokenSource? _ctsMensagem;

    /// <summary>Mostra a mensagem no topo; some sozinha (sucesso em 4 s, erro em 10 s).</summary>
    private void MostrarMensagem(string texto, string tipo)
    {
        mensagem = texto;
        tipoMensagem = tipo;
        StateHasChanged();

        _ctsMensagem?.Cancel();
        var cts = _ctsMensagem = new CancellationTokenSource();
        var espera = tipo == "success" ? 4000 : 10000;
        _ = Task.Delay(espera, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _ = InvokeAsync(() =>
            {
                if (mensagem == texto) { mensagem = ""; StateHasChanged(); }
            });
        }, TaskScheduler.Default);
    }

