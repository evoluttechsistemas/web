    private static string[] ChunkarHtml(string html, int tamanhoChunk)
    {
        var chunks = new List<string>();
        for (int i = 0; i < html.Length; i += tamanhoChunk)
            chunks.Add(html.Substring(i, Math.Min(tamanhoChunk, html.Length - i)));
        return chunks.ToArray();
    }

