    /// <summary>
    /// Converte o HTML do editor em blocos para salvar no banco.
    /// Mantém compatibilidade total com a estrutura existente.
    /// </summary>
    private static List<DocumentacaoTutorialBlocoModel> HtmlParaBlocos(string html)
    {
        // Armazena o HTML inteiro em UM único bloco de tipo TEXTO.
        // Isso preserva todo o conteúdo rico (imagens inline, vídeos, tabelas,
        // formatação) sem precisar alterar o schema do banco.
        return new List<DocumentacaoTutorialBlocoModel>
        {
            new DocumentacaoTutorialBlocoModel
            {
                Tipo = "TEXTO",
                Titulo = "Conteúdo",
                Conteudo = html ?? "",
                Ordem = 1
            }
        };
    }

    /// <summary>
    /// Reconstrói o HTML do editor a partir dos blocos salvos no banco.
    /// Suporta o formato legado (múltiplos blocos) e o novo (bloco único de HTML).
    /// </summary>
    private static string BlocosParaHtml(List<DocumentacaoTutorialBlocoModel> blocos)
    {
        if (blocos == null || blocos.Count == 0) return "";

        // Novo formato: bloco único com HTML completo
        if (blocos.Count == 1 && blocos[0].Tipo == "TEXTO" && blocos[0].Titulo == "Conteúdo")
            return blocos[0].Conteudo;

        // Formato legado: converte cada bloco para HTML equivalente
        var sb = new System.Text.StringBuilder();
        foreach (var bloco in blocos.OrderBy(x => x.Ordem))
        {
            if (!string.IsNullOrWhiteSpace(bloco.Titulo))
                sb.AppendLine($"<h2>{System.Net.WebUtility.HtmlEncode(bloco.Titulo)}</h2>");

            switch (bloco.Tipo)
            {
                case "TEXTO":
                    if (!string.IsNullOrWhiteSpace(bloco.Conteudo))
                        sb.AppendLine($"<p>{bloco.Conteudo}</p>");
                    break;

                case "VIDEO":
                    if (!string.IsNullOrWhiteSpace(bloco.UrlMidia))
                    {
                        var ytMatch = System.Text.RegularExpressions.Regex.Match(
                            bloco.UrlMidia, @"(?:youtube\.com/watch\?v=|youtu\.be/)([^&\s]+)");
                        var viMatch = System.Text.RegularExpressions.Regex.Match(
                            bloco.UrlMidia, @"vimeo\.com/(\d+)");

                        if (ytMatch.Success)
                            sb.AppendLine($@"<div class=""de-video-wrap"" contenteditable=""false""><div class=""de-video-controls""><button class=""de-video-ctrl-btn"" onclick=""this.closest('.de-video-wrap').remove()"">✕ Remover</button></div><iframe src=""https://www.youtube.com/embed/{ytMatch.Groups[1].Value}"" allowfullscreen loading=""lazy""></iframe></div><p><br></p>");
                        else if (viMatch.Success)
                            sb.AppendLine($@"<div class=""de-video-wrap"" contenteditable=""false""><div class=""de-video-controls""><button class=""de-video-ctrl-btn"" onclick=""this.closest('.de-video-wrap').remove()"">✕ Remover</button></div><iframe src=""https://player.vimeo.com/video/{viMatch.Groups[1].Value}"" allowfullscreen loading=""lazy""></iframe></div><p><br></p>");
                        else
                            sb.AppendLine($@"<div class=""de-video-wrap"" contenteditable=""false""><video controls src=""{bloco.UrlMidia}""></video></div><p><br></p>");
                    }
                    break;

                case "IMAGEM":
                    if (!string.IsNullOrWhiteSpace(bloco.UrlMidia))
                        sb.AppendLine($@"<div class=""de-img-wrap"" contenteditable=""false""><img src=""{bloco.UrlMidia}"" alt=""{System.Net.WebUtility.HtmlEncode(bloco.Titulo)}"" style=""width:100%""><div class=""de-resize-handle""></div></div><p><br></p>");
                    if (!string.IsNullOrWhiteSpace(bloco.Conteudo))
                        sb.AppendLine($"<p><em>{System.Net.WebUtility.HtmlEncode(bloco.Conteudo)}</em></p>");
                    break;

                case "LINK":
                    if (!string.IsNullOrWhiteSpace(bloco.UrlLink))
                        sb.AppendLine($@"<p><a href=""{bloco.UrlLink}"" target=""_blank"">{System.Net.WebUtility.HtmlEncode(!string.IsNullOrWhiteSpace(bloco.Conteudo) ? bloco.Conteudo : bloco.UrlLink)}</a></p>");
                    break;
            }
        }

        return sb.ToString();
    }

