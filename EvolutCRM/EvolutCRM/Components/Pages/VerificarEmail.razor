@page "/verificar-email"
@inject EvolutCRM.Services.CadastroUsuarioService CadastroUsuarioService
@inject NavigationManager Nav
@using EvolutCRM.Components.Layout
@layout LoginLayout

<style>
    :root {
        --login-primary: #0d47a1;
        --login-primary-2: #1976d2;
        --login-accent: #0f766e;
        --login-card: #ffffff;
        --login-text: #172033;
        --login-muted: #64748b;
        --login-border: #d7e6f7;
        --login-danger-bg: #fee2e2;
        --login-danger-text: #991b1b;
        --login-success-bg: #dcfce7;
        --login-success-text: #166534;
        --login-shadow: 0 24px 60px rgba(13, 71, 161, .22);
    }

    body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, sans-serif;
    }

    .login-page {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: linear-gradient(135deg, rgba(15, 118, 110, .18), transparent 34%), linear-gradient(160deg, #0b2f6b 0%, #0d47a1 48%, #1976d2 100%);
    }

    .login-card {
        width: min(980px, 100%);
        min-height: 520px;
        display: grid;
        grid-template-columns: minmax(300px, .92fr) minmax(360px, 1.08fr);
        background: var(--login-card);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: var(--login-shadow);
        border: 1px solid rgba(255,255,255,.28);
        animation: loginEnter .45s ease both;
    }

    .login-brand {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 34px;
        color: #fff;
        background: linear-gradient(145deg, rgba(13, 71, 161, .96), rgba(15, 118, 110, .92)), url("images/logo-evoluttech.png");
        background-size: cover;
        background-position: center;
        isolation: isolate;
    }

        .login-brand::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(3, 20, 48, .54);
            z-index: -1;
        }

    .login-brand-logo-box {
        width: 210px;
        max-width: 82%;
        padding: 18px;
        border-radius: 18px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 14px 34px rgba(0,0,0,.24);
    }

    .login-logo {
        width: 100%;
        display: block;
        object-fit: contain;
    }

    .login-brand-copy {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .login-brand-copy strong {
            font-size: 1.28rem;
            line-height: 1.15;
            font-weight: 950;
        }

        .login-brand-copy span {
            max-width: 300px;
            font-size: .88rem;
            line-height: 1.45;
            color: rgba(255,255,255,.86);
            font-weight: 650;
        }

    .login-panel {
        padding: 46px 52px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .login-panel-header {
        margin-bottom: 24px;
    }

    .login-kicker {
        margin: 0 0 7px;
        color: var(--login-accent);
        font-size: .74rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .login-title {
        margin: 0;
        color: var(--login-text);
        font-size: 1.82rem;
        line-height: 1.1;
        font-weight: 950;
    }

    .login-subtitle {
        margin: 8px 0 0;
        color: var(--login-muted);
        font-size: .92rem;
        line-height: 1.45;
        font-weight: 650;
    }

    .status-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        text-align: center;
        padding: 12px 0;
    }

    .status-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 950;
    }

        .status-icon.loading {
            background: #e0edff;
            color: var(--login-primary);
            animation: spin 1s linear infinite;
        }

        .status-icon.success {
            background: var(--login-success-bg);
            color: #16a34a;
        }

        .status-icon.error {
            background: var(--login-danger-bg);
            color: #dc2626;
        }

    .status-title {
        margin: 0;
        color: var(--login-text);
        font-size: 1.18rem;
        font-weight: 900;
    }

    .status-desc {
        margin: 0;
        color: var(--login-muted);
        font-size: .9rem;
        line-height: 1.5;
        font-weight: 650;
        max-width: 320px;
    }

    .login-submit {
        height: 48px;
        width: 100%;
        margin-top: 4px;
        border: none;
        border-radius: 13px;
        background: linear-gradient(135deg, var(--login-accent), var(--login-primary));
        color: #fff;
        font-size: .96rem;
        font-weight: 950;
        cursor: pointer;
        box-shadow: 0 14px 28px rgba(13, 71, 161, .24);
    }

        .login-submit:hover {
            filter: brightness(1.04);
        }

    .login-footnote {
        margin-top: 18px;
        color: var(--login-muted);
        font-size: .76rem;
        font-weight: 650;
        text-align: center;
    }

    @@keyframes loginEnter {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 820px) {
        .login-card {
            grid-template-columns: 1fr;
            min-height: unset;
        }

        .login-brand {
            min-height: 200px;
            padding: 26px;
        }

        .login-panel {
            padding: 30px 24px;
        }
    }
</style>

<div class="login-page">
    <section class="login-card">
        <aside class="login-brand">
            <div class="login-brand-logo-box">
                <img src="images/logo-evoluttech.png" alt="EvolutTech" class="login-logo" />
            </div>

            <div class="login-brand-copy">
                <strong>EvolutTech HELP</strong>
                <span>Confirmação de identidade para acesso seguro ao sistema.</span>
            </div>
        </aside>

        <main class="login-panel">
            <div class="login-panel-header">
                <p class="login-kicker">Segurança da conta</p>
                <h1 class="login-title">Verificação de e-mail</h1>
                <p class="login-subtitle">Aguarde enquanto validamos seu link de acesso.</p>
            </div>

            <div class="status-box">
                @if (Verificando)
                {
                    <div class="status-icon loading">↻</div>
                    <p class="status-title">Verificando...</p>
                    <p class="status-desc">Estamos validando seu link. Isso leva apenas um instante.</p>
                }
                else if (Sucesso)
                {
                    <div class="status-icon success">✓</div>
                    <p class="status-title">E-mail verificado!</p>
                    <p class="status-desc">@Mensagem</p>

                    <button type="button" class="login-submit" @onclick="IrParaLogin">
                        Ir para o login
                    </button>
                }
                else
                {
                    <div class="status-icon error">×</div>
                    <p class="status-title">Verificação falhou</p>
                    <p class="status-desc">@Mensagem</p>

                    <button type="button" class="login-submit" @onclick="IrParaLogin">
                        Voltar ao login
                    </button>
                }
            </div>

            <div class="login-footnote">EvolutTech</div>
        </main>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool Verificando = true;
    private bool Sucesso = false;
    private string Mensagem = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Token))
            {
                Sucesso = false;
                Mensagem = "Link inválido ou incompleto. Solicite um novo e-mail de verificação.";
                return;
            }

            var resultado = await CadastroUsuarioService.VerificarEmailAsync(Token);

            Sucesso = resultado.Sucesso;
            Mensagem = resultado.Mensagem;
        }
        catch (Exception ex)
        {
            Sucesso = false;
            Mensagem = $"Erro ao verificar o e-mail: {ex.Message}";
        }
        finally
        {
            Verificando = false;
        }
    }

    private void IrParaLogin()
    {
        Nav.NavigateTo("/");
    }
}