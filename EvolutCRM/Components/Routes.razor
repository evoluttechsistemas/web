@using EvolutCRM.Components.Layout
@using EvolutCRM.Abas
@inject IJSRuntime JS

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (routeData.PageType == typeof(EvolutCRM.Components.Pages.Login))
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(LoginLayout)" />
        }
        else
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Avisa o App.razor que a conexão do Blazor ligou (vale para todas as telas: login, sistema, tutoriais)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("helpMarcarConectado"); }
            catch { }
        }
    }
}