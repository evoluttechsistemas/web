@code {
    private HealthSnapshot snap = new(0, 0, 0, 0, "—", TimeSpan.Zero);
    private string ultimaAtualizacao = "";
    private System.Threading.Timer? _timer;
    private HealthLogEntry? logExpandido;

    private Dictionary<LogCategory, string> filtros = Enum
        .GetValues<LogCategory>()
        .ToDictionary(c => c, _ => "all");

    protected override void OnInitialized()
    {
        Monitor.OnNewLog += OnNovoLog;
        _timer = new System.Threading.Timer(_ => InvokeAsync(Refresh), null,
            TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    private void OnNovoLog() => InvokeAsync(Refresh);

    private async Task Refresh()
    {
        snap = Monitor.GetSnapshot();
        ultimaAtualizacao = "atualizado " + DateTime.Now.ToString("HH:mm:ss");
        await InvokeAsync(StateHasChanged);
    }

    private void SetFiltro(LogCategory cat, string valor)
    {
        filtros[cat] = valor;
    }

    private void LimparLogs()
    {
        Monitor.ClearAll();
    }

    private string GetCatLabel(LogCategory cat) => cat switch
    {
        LogCategory.Tickets => "Tickets / WhatsApp",
        LogCategory.CRM => "CRM / Cards",
        LogCategory.SQL => "SQL Server",
        LogCategory.Baileys => "Baileys / Gateway",
        LogCategory.Sistema => "Sistema",
        _ => cat.ToString()
    };

    private string GetCatIcon(LogCategory cat) => cat switch
    {
        LogCategory.Tickets => "fas fa-headset",
        LogCategory.CRM => "fas fa-briefcase",
        LogCategory.SQL => "fas fa-database",
        LogCategory.Baileys => "fab fa-whatsapp",
        LogCategory.Sistema => "fas fa-server",
        _ => "fas fa-circle"
    };

    private string GetSevIcon(LogSeverity sev) => sev switch
    {
        LogSeverity.Success => "fas fa-circle-check",
        LogSeverity.Warning => "fas fa-triangle-exclamation",
        LogSeverity.Error => "fas fa-circle-xmark",
        LogSeverity.Critical => "fas fa-skull-crossbones",
        _ => "fas fa-circle-info"
    };

    private string GetSevClass(LogSeverity sev) => sev switch
    {
        LogSeverity.Success => "sev-success",
        LogSeverity.Warning => "sev-warning",
        LogSeverity.Error => "sev-error",
        LogSeverity.Critical => "sev-critical",
        _ => "sev-info"
    };

    public void Dispose()
    {
        Monitor.OnNewLog -= OnNovoLog;
        _timer?.Dispose();
    }

    private void ToggleErro(HealthLogEntry log)
    {
        if (logExpandido == log)
            logExpandido = null;
        else
            logExpandido = log;
    }

    private bool PossuiContextoErro(HealthLogEntry log)
    {
        return
            log.CodTicketChamadoC.HasValue ||
            log.CodTicketChamadoD.HasValue ||
            log.CodCliente.HasValue ||
            !string.IsNullOrWhiteSpace(log.Cliente) ||
            !string.IsNullOrWhiteSpace(log.TelefoneWhatsApp);
    }

    private bool PossuiDadosAtendimento(HealthLogEntry log)
    {
        return
            log.CodTicketChamadoC.HasValue ||
            log.CodTicketChamadoD.HasValue ||
            log.CodCliente.HasValue ||
            !string.IsNullOrWhiteSpace(log.Cliente) ||
            !string.IsNullOrWhiteSpace(log.TelefoneWhatsApp) ||
            !string.IsNullOrWhiteSpace(log.MessageIdWhatsApp) ||
            !string.IsNullOrWhiteSpace(log.InstanciaWhatsApp);
    }

    private bool PossuiOrigemLog(HealthLogEntry log)
    {
        return
            !string.IsNullOrWhiteSpace(log.SourceFile) ||
            !string.IsNullOrWhiteSpace(log.SourceMember) ||
            log.SourceLine.HasValue;
    }

    private bool PossuiOrigemException(HealthLogEntry log)
    {
        return
            !string.IsNullOrWhiteSpace(log.ExceptionFile) ||
            !string.IsNullOrWhiteSpace(log.ExceptionMethod) ||
            log.ExceptionLine.HasValue;
    }
