    /* SLA */
    TimeSpan SlaPrazo(int cod) => cod switch { 2 => TimeSpan.FromDays(2), 1 => TimeSpan.FromDays(30), _ => TimeSpan.Zero };

    TimeSpan SlaDecorrido(TicketChamadoCModel t)
    {
        if (t.CodSituacao == 4) return TimeSpan.Zero;
        if (t.CodTipo == 2) return DiasUteis(t.DataHoraAbertura, DateTime.Now);
        return DateTime.Now - t.DataHoraAbertura;
    }

    TimeSpan DiasUteis(DateTime ini, DateTime fim)
    {
        double h = 0; var cur = ini;
        while (cur < fim)
        {
            var next = cur.Date.AddDays(1); var end = fim < next ? fim : next;
            if (cur.DayOfWeek != DayOfWeek.Saturday && cur.DayOfWeek != DayOfWeek.Sunday)
                h += (end - cur).TotalHours;
            cur = next;
        }
        return TimeSpan.FromHours(h);
    }

    int SlaPerc(TicketChamadoCModel t)
    {
        var prazo = SlaPrazo(t.CodTipo);
        if (prazo.TotalMinutes == 0 || t.CodSituacao == 4) return 0;
        return (int)Math.Min((SlaDecorrido(t).TotalMinutes / prazo.TotalMinutes) * 100, 100);
    }

    string SlaTagCss(TicketChamadoCModel t)
    {
        if (t.CodTipo == 3 || t.CodSituacao == 4) return "none";
        var p = SlaPerc(t);
        return p < 60 ? "ok" : p < 90 ? "warn" : "danger";
    }

    string SlaTexto(TicketChamadoCModel t)
    {
        if (t.CodTipo == 3) return "Sem prazo";
        if (t.CodSituacao == 4) return "Pausado";
        return $"SLA {SlaPerc(t)}%";
    }

    string RowSlaCss(TicketChamadoCModel t)
    {
        if (t.CodTipo == 3 || t.CodSituacao == 4) return "";
        var p = SlaPerc(t);
        return p < 60 ? "sla-ok" : p < 90 ? "sla-warning" : "sla-danger";
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬ RENDER Ã¢â€â‚¬Ã¢â€â‚¬ */
    void EscreverLinha(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder b, ref int s, TicketChamadoCModel t)
    {
        bool novo = IsTicketNovo(t);
        var cls = $"tk-grid tk-row {RowSlaCss(t)} {ClasseAprovacao(t)} {(novo ? "novo" : "")}";

        b.OpenElement(s++, "div"); b.AddAttribute(s++, "class", cls);
        b.AddAttribute(s++, "draggable", "true");
        b.AddAttribute(s++, "ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => IniciarArrasteTicket(t.Codigo)));
        b.AddAttribute(s++, "onclick", EventCallback.Factory.Create(this, () => AbrirTicket(t.Codigo)));

        // 1 CÃƒÂ³digo
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", "cc-code");
        b.AddContent(s++, $"#{t.Codigo:D5}"); b.CloseElement();
        b.CloseElement();

        // 2 Assunto
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "div"); b.AddAttribute(s++, "class", "cc-title");
        b.AddContent(s++, t.Assunto);
        if (novo) { b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", "bx-novo"); b.AddContent(s++, "NOVO"); b.CloseElement(); }
        b.CloseElement();
        b.OpenElement(s++, "div"); b.AddAttribute(s++, "class", "cc-sub");
        b.AddContent(s++, $"{t.DataHoraAbertura:dd/MM/yy HH:mm}");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", $"sla-t {SlaTagCss(t)}");
        b.AddContent(s++, SlaTexto(t)); b.CloseElement();
        b.CloseElement();
        b.CloseElement();
        b.CloseElement();

        // 3 Cliente
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", "cc-client");
        b.AddContent(s++, !string.IsNullOrWhiteSpace(t.ApelidoCliente) ? t.ApelidoCliente : t.NomeCliente);
        b.CloseElement(); b.CloseElement();

        // 4 ResponsÃƒÂ¡vel
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", "cc-user");
        if (IsUsuarioNovo(t.Usuario))
        {
            b.AddAttribute(s++, "style", "background:#7f1d1d;color:#fca5a5;");
            b.AddContent(s++, "NOVO");
        }
        else
        {
            b.AddContent(s++, t.Usuario.Trim().ToUpper());
        }
        b.CloseElement(); b.CloseElement();

        // 5 Visualizando
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", "cc-viewers");
        var viewers = ObterVisualizadores(t.Codigo, t.Usuario);
        if (viewers.Any())
        {
            foreach (var v in viewers)
            {
                b.OpenElement(s++, "span");
                b.AddAttribute(s++, "class", "cc-viewer-badge");
                b.AddAttribute(s++, "title", v);
                b.AddAttribute(s++, "style", $"background:{GerarCorUsuario(v)}");
                b.AddContent(s++, v.Length >= 2 ? v.Substring(0, 2).ToUpper() : v.ToUpper());
                b.CloseElement();
            }
        }
        else
        {
            b.AddContent(s++, "—");
        }
        b.CloseElement(); b.CloseElement();

        // 6 Prioridade
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", $"bx {PrioCss(t.Prioridade)}");
        b.AddContent(s++, TextoPrio(t.Prioridade)); b.CloseElement(); b.CloseElement();

        // 7 Tipo
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", $"bx {TipoCss(t.CodTipo)}");
        b.AddContent(s++, TextoTipo(t.CodTipo)); b.CloseElement(); b.CloseElement();

        // 8 Status
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "span"); b.AddAttribute(s++, "class", $"bx {StatusCss(t.CodSituacao)}");
        b.AddContent(s++, StatusTexto(t.CodSituacao)); b.CloseElement(); b.CloseElement();

        // 9 AÃƒÂ§ÃƒÂµes
        b.OpenElement(s++, "div");
        b.OpenElement(s++, "button"); b.AddAttribute(s++, "type", "button"); b.AddAttribute(s++, "class", "tk-open");
        b.AddAttribute(s++, "onclick:stopPropagation", true);
        b.AddAttribute(s++, "onclick", EventCallback.Factory.Create(this, () => AbrirTicket(t.Codigo)));
        b.AddContent(s++, "Abrir"); b.CloseElement();
        b.CloseElement();

        b.CloseElement();
    }

    RenderFragment RenderListaTickets(int situacao) => b =>
    {
        var s = 0;
        var items = FiltrarPorStatus(situacao).ToList();
        b.OpenElement(s++, "div"); b.AddAttribute(s++, "class", "tk-card");
        b.OpenElement(s++, "div"); b.AddAttribute(s++, "class", "tk-grid tk-thead");
        b.AddMarkupContent(s++, "<span>Código</span><span>Assunto</span><span>Cliente</span><span>Responsável</span><span>Visualizando</span><span>Prioridade</span><span>Tipo</span><span>Status</span><span></span>");
        b.CloseElement();
        if (!items.Any()) { b.OpenElement(s++, "div"); b.AddAttribute(s++, "class", "tk-empty"); b.AddContent(s++, "Nenhum ticket encontrado"); b.CloseElement(); }
        else { foreach (var t in items) EscreverLinha(b, ref s, t); }
        b.CloseElement();
    };

    RenderFragment RenderListaBusca(string titulo) => RenderListaTickets(1);
    RenderFragment RenderColuna(string titulo, int situacao) => RenderListaTickets(situacao);
    RenderFragment RenderColunaBusca(string titulo) => RenderListaBusca(titulo);

    /* Ã¢â€â‚¬Ã¢â€â‚¬ DRAG Ã¢â€â‚¬Ã¢â€â‚¬ */
    private int? _ticketArrastando;
    private void IniciarArrasteTicket(int id) => _ticketArrastando = id;
    private void PermitirSoltarTicket(DragEventArgs e) { }

    private async Task SoltarTicketNaAba(int novaSituacao)
    {
        if (!_ticketArrastando.HasValue) return;
        var id = _ticketArrastando.Value; _ticketArrastando = null;
        await HandleTicketDropped(id, novaSituacao);
        StatusSelecionado = novaSituacao;
    }

    private async Task SoltarTicketNaAbaSetor(int codSetor)
    {
        if (!_ticketArrastando.HasValue) return;
        var id = _ticketArrastando.Value; _ticketArrastando = null;
        await TicketService.AlterarSituacaoAsync(id, 1, UserState.CurrentUser);
        await TicketService.AlterarSetorAsync(id, codSetor, UserState.CurrentUser);
        StatusSelecionado = 1; AbaSetorSelecionada = codSetor;
        await CarregarTickets(); await CarregarNotificacoes(); StateHasChanged();
    }

    private async Task SoltarTicketNaAbaSetorSituacao(int codSetor, int codSituacao)
    {
        if (!_ticketArrastando.HasValue) return;
        var id = _ticketArrastando.Value; _ticketArrastando = null;
        await TicketService.AlterarSituacaoAsync(id, codSituacao, UserState.CurrentUser);
        await TicketService.AlterarSetorAsync(id, codSetor, UserState.CurrentUser);
        StatusSelecionado = 1; AbaSetorSelecionada = codSetor;
        if (codSetor == 2) StatusDesenvolvimentoSelecionado = codSituacao;
        await CarregarTickets(); await CarregarNotificacoes(); StateHasChanged();
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬ STATE Ã¢â€â‚¬Ã¢â€â‚¬ */
    private int StatusSelecionado = 1;
    private int? AbaSetorSelecionada = 1;
    private int StatusDesenvolvimentoSelecionado = 1;

    private void LerStatusDaUrl()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("status", out var sv) && int.TryParse(sv, out var s) && s > 0)
            StatusSelecionado = s;

        if (q.TryGetValue("setor", out var setV) && int.TryParse(setV, out var set) && set > 0)
        {
            StatusSelecionado = 1;
            AbaSetorSelecionada = set;
        }

        if (q.TryGetValue("devStatus", out var dsV) && int.TryParse(dsV, out var ds) && ds > 0)
        {
            StatusSelecionado = 1;
            AbaSetorSelecionada = 2;
            StatusDesenvolvimentoSelecionado = ds;
        }
    }

    private async Task SelecionarAbaStatus(int status)
    {
        StatusSelecionado = status; AbaSetorSelecionada = null;
        if (status == 3) await CarregarTicketsFinalizados(); else await CarregarTickets();
        AtualizarUrl(); StateHasChanged();
    }

    private async Task SelecionarAbaSetor(int codSetor)
    {
        StatusSelecionado = 1; AbaSetorSelecionada = codSetor;
        if (codSetor == 2) StatusDesenvolvimentoSelecionado = 1;
        await CarregarTickets(); AtualizarUrl(); StateHasChanged();
    }

    private void SelecionarStatusDesenvolvimento(int situacao)
    {
        StatusDesenvolvimentoSelecionado = situacao; StatusSelecionado = 1; AbaSetorSelecionada = 2;
        AtualizarUrl(); StateHasChanged();
    }

    private void AtualizarUrl()
    {
        var url = $"/tickets?status={StatusSelecionado}";
        if (AbaSetorSelecionada.HasValue) url += $"&setor={AbaSetorSelecionada.Value}";
        if (AbaSetorSelecionada == 2) url += $"&devStatus={StatusDesenvolvimentoSelecionado}";
        Nav.NavigateTo(url, replace: true);
    }

    async Task CarregarTicketsFinalizados()
    {
        var fin = await TicketService.ListarChamadosFinalizadosAsync();
        _tickets.RemoveAll(t => t.CodSituacao == 3);
        _tickets.AddRange(fin);
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬ FILTRO Ã¢â€â‚¬Ã¢â€â‚¬ */
    private bool FiltroAplicado = false;
    private bool MostrarModalFiltro = false;
    private FiltroTicketModel Filtros = new();
    private string ClienteFiltroBusca = "";
    private List<ClienteModel> SugestoesFiltroCliente = new();
    private List<UsuarioClienteDto> UsuariosClienteFiltro = new();

    public class FiltroTicketModel
    {
        public int? CodCliente { get; set; }
        public string? NomeCliente { get; set; }
        public string? UsuarioCliente { get; set; }
        public string? UsuarioResponsavel { get; set; }
        public string? DescricaoTitulo { get; set; }
        public int? CodSituacao { get; set; }
        public int? CodTipo { get; set; }
        public DateTime? DataInicial { get; set; }
        public DateTime? DataFinal { get; set; }
        public bool SomenteNovos { get; set; }
        public int? Prioridade { get; set; }
    }

    void AbrirFiltro() => MostrarModalFiltro = true;
    void FecharFiltro() => MostrarModalFiltro = false;

    async Task BuscarClientesFiltro()
    {
        if (string.IsNullOrWhiteSpace(ClienteFiltroBusca) || ClienteFiltroBusca.Trim().Length < 2) { SugestoesFiltroCliente.Clear(); return; }
        SugestoesFiltroCliente = await TicketService.BuscarClientesAsync(ClienteFiltroBusca.Trim());
    }

    async Task SelecionarClienteFiltro(ClienteModel cli)
    {
        Filtros.CodCliente = cli.Codigo; Filtros.NomeCliente = cli.Nome;
        ClienteFiltroBusca = $"{cli.Codigo} - {cli.Nome}"; SugestoesFiltroCliente.Clear();
        UsuariosClienteFiltro = await TicketService.ObterUsuariosClienteAsync(cli.Codigo);
        Filtros.UsuarioCliente = null;
    }

    void LimparFiltros()
    {
        Filtros = new();
        ClienteFiltroBusca = "";
        SugestoesFiltroCliente.Clear();
        UsuariosClienteFiltro.Clear();
        FiltroAplicado = false;
    }
    async Task AplicarFiltros()
    {
        MostrarModalFiltro = false;
        FiltroAplicado = true;
        await Recarregar();
        StateHasChanged();
    }

    bool TemFiltroAvancado() =>
        Filtros.CodCliente.HasValue || !string.IsNullOrWhiteSpace(Filtros.UsuarioCliente) ||
        !string.IsNullOrWhiteSpace(Filtros.UsuarioResponsavel) || !string.IsNullOrWhiteSpace(Filtros.DescricaoTitulo) ||
        Filtros.CodSituacao.HasValue || Filtros.CodTipo.HasValue || Filtros.Prioridade.HasValue ||
        Filtros.DataInicial.HasValue || Filtros.DataFinal.HasValue || Filtros.SomenteNovos;
}
