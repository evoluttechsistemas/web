        string.IsNullOrWhiteSpace(usuario) ||
        usuario.Trim().Equals("NOVO", StringComparison.OrdinalIgnoreCase);

    string ClasseAprovacao(TicketChamadoCModel t) => t.StatusAprovacao?.ToUpper() switch
