    async Task CarregarTickets()
    {
        var novos = await TicketService.ListarChamadosAsync();
        var usuarioLogado = UserState.CurrentUser?.Trim();
        var agora = DateTime.Now;

        var ticketsNovos = novos.Where(t =>
            t.Novo?.Trim().Equals("S", StringComparison.OrdinalIgnoreCase) == true &&
            !_ticketsNotificados.Contains(t.Codigo) &&
            !string.IsNullOrWhiteSpace(t.Usuario) &&
            (t.Usuario.Trim().Equals(usuarioLogado, StringComparison.OrdinalIgnoreCase) ||
             t.Usuario.Trim().Equals("NOVO", StringComparison.OrdinalIgnoreCase))).ToList();

        if (ticketsNovos.Any() && agora - _ultimaNotificacaoNovo >= TimeSpan.FromSeconds(3))
        {
            _ultimaNotificacaoNovo = agora;
            foreach (var t in ticketsNovos) _ticketsNotificados.Add(t.Codigo);
        }

        _tickets = novos;

        if (VisaoCards && SituacoesTicket.Any(s => s.Codigo == 3))
        {
            var finalizados = await TicketService.ListarChamadosFinalizadosAsync();
            _tickets.RemoveAll(t => t.CodSituacao == 3);
            _tickets.AddRange(finalizados);
        }

        // Carrega usuários só uma vez (não muda a cada refresh de 5s)
        if (UsuariosDisponiveis.Count == 0)
        {
            UsuariosDisponiveis = (await TicketService.ListarUsuariosAsync())
                .Where(u => !string.IsNullOrWhiteSpace(u))
                .Select(u => u.Trim().ToUpper()).Distinct().OrderBy(u => u).ToList();
        }
        _ticketsNotificados.RemoveWhere(id => !_tickets.Any(t => t.Codigo == id && t.Novo == "S"));
        await InvokeAsync(StateHasChanged);
    }

    async Task Recarregar()
