<div class="tk">
    <div class="tk-shell">

        <!-- TOPBAR -->
        <header class="tk-bar">
            <div class="tk-search">
                <span class="tk-search-ico">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                </span>
                <input placeholder="Buscar ticket, cliente, assunto..." @bind="_searchTerm" />
            </div>

            <button class="tk-btn tk-btn-ghost" @onclick="AbrirFiltro" type="button">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" /></svg>
                Filtrar
            </button>

            <button class="tk-btn tk-btn-ghost" @onclick="Recarregar" type="button">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                Atualizar
            </button>

            <button class="tk-btn tk-btn-solid" @onclick="NovoTicket" type="button">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Novo Ticket
            </button>
        </header>

        <!-- TABS -->
        <nav class="tk-tabs">
            @foreach (var setor in SetoresTicket)
            {
                <button type="button" class="@ClasseAbaSetor(setor.Codigo)"
                        @onclick="@(() => SelecionarAbaSetor(setor.Codigo))"
                        @ondragenter="PermitirSoltarTicket" @ondragenter:preventDefault="true"
                        @ondragover="PermitirSoltarTicket" @ondragover:preventDefault="true"
                        @ondrop="@(() => SoltarTicketNaAbaSetor(setor.Codigo))" @ondrop:preventDefault="true">
                    @setor.Descricao <span class="tk-tab-n">@CountPorStatusSetor(setor.Codigo)</span>
                </button>
            }

            @foreach (var situacao in SituacoesAbasPrincipais)
            {
                <button type="button" class="@ClasseAbaStatus(situacao.Codigo)"
                        @onclick="@(() => SelecionarAbaStatus(situacao.Codigo))"
                        @ondragenter="PermitirSoltarTicket" @ondragenter:preventDefault="true"
                        @ondragover="PermitirSoltarTicket" @ondragover:preventDefault="true"
                        @ondrop="@(() => SoltarTicketNaAba(situacao.Codigo))" @ondrop:preventDefault="true">
                    @situacao.Descricao <span class="tk-tab-n">@CountPorStatus(situacao.Codigo)</span>
                </button>
            }

            @if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                <span class="tk-chip-search">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                    "@_searchTerm"
                </span>
            }
            <button type="button"
                    class="tk-tab @(VisaoCards ? "active" : "")"
                    @onclick="AlternarVisaoCards">
                Cards
            </button>

            @if (VisaoCards)
            {
                <div class="tk-card-cols">
                    <button type="button" class="tk-tab" @onclick="AlternarSeletorColunasCards">
                        Colunas
                    </button>

                    @if (MostrarSeletorColunasCards)
                    {
                        <div class="tk-card-cols-panel">
                            <div class="tk-card-cols-title">Setores</div>
                            @foreach (var setor in SetoresTicket)
                            {
                                var chave = ChaveColunaSetor(setor.Codigo);
                                <label class="tk-card-cols-item">
                                    <input type="checkbox"
                                           checked="@ColunaCardVisivel(chave)"
                                           @onchange="@((ChangeEventArgs e) => AlternarColunaCardAsync(chave, e))" />
                                    <span>@setor.Descricao</span>
                                </label>
                            }

                            <div class="tk-card-cols-title">Situações</div>
                            @foreach (var situacao in SituacoesCardsStatus)
                            {
                                var chave = ChaveColunaSituacao(situacao.Codigo);
                                <label class="tk-card-cols-item">
                                    <input type="checkbox"
                                           checked="@ColunaCardVisivel(chave)"
                                           @onchange="@((ChangeEventArgs e) => AlternarColunaCardAsync(chave, e))" />
                                    <span>@situacao.Descricao</span>
                                </label>
                            }

                            <div class="tk-card-cols-foot">
                                <button type="button" class="tk-btn tk-btn-ghost" @onclick="MostrarTodasColunasCardsAsync">
                                    Mostrar todas
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

        </nav>

        <!-- CONTEÃƒÅ¡DO -->
        @if (!string.IsNullOrWhiteSpace(_searchTerm) || TemFiltroAvancado() || FiltroAplicado)
        {
            @RenderListaBusca("Resultados")
        }
        else if (VisaoCards)
        {
            @RenderVisaoCards()
        }
        else if (StatusSelecionado == 1 && AbaSetorSelecionada == 2)
        {
            <div class="tk-subtabs">
                <button type="button" class="tk-subtab @(StatusDesenvolvimentoSelecionado == 1 ? "active" : "")"
                        @onclick="@(() => SelecionarStatusDesenvolvimento(1))"
                        @ondragenter="PermitirSoltarTicket" @ondragenter:preventDefault="true"
                        @ondragover="PermitirSoltarTicket" @ondragover:preventDefault="true"
                        @ondrop="@(() => SoltarTicketNaAbaSetorSituacao(2, 1))" @ondrop:preventDefault="true">
                    @StatusTexto(1) <span class="tk-subtab-n">@CountDesenvolvimentoPorSituacao(1)</span>
                </button>
                <button type="button" class="tk-subtab @(StatusDesenvolvimentoSelecionado == 2 ? "active" : "")"
                        @onclick="@(() => SelecionarStatusDesenvolvimento(2))"
                        @ondragenter="PermitirSoltarTicket" @ondragenter:preventDefault="true"
                        @ondragover="PermitirSoltarTicket" @ondragover:preventDefault="true"
                        @ondrop="@(() => SoltarTicketNaAbaSetorSituacao(2, 2))" @ondrop:preventDefault="true">
                    @StatusTexto(2) <span class="tk-subtab-n">@CountDesenvolvimentoPorSituacao(2)</span>
                </button>
            </div>
            @RenderListaTickets(StatusDesenvolvimentoSelecionado)
        }
        else
        {
            @RenderListaTickets(StatusSelecionado)
        }

    </div>
</div>

<script>
    window.crmNotify=async function(title,body){
        if(!("Notification"in window))return;
        if(Notification.permission==="granted"){new Notification(title,{body,icon:"/images/logo-evoluttech.png"});}
        else if(Notification.permission!=="denied"){
            const p=await Notification.requestPermission();
            if(p==="granted")new Notification(title,{body,icon:"/images/logo-evoluttech.png"});
        }
    };
</script>

@if (MostrarModalFiltro)
{
