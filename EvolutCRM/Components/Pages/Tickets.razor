@page "/tickets"
@implements IDisposable
@using EvolutCRM.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.WebUtilities

@inject EvolutCRM.Services.TicketService TicketService
@inject EvolutCRM.Services.TicketClassificacaoService TicketClassificacaoService
@inject EvolutCRM.Services.UserState UserState
@inject NavigationManager Nav
@inject TicketNotificationState TicketNotify
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');

    :root {
        --b50: #eff6ff;
        --b100: #dbeafe;
        --b200: #bfdbfe;
        --b300: #93c5fd;
        --b400: #60a5fa;
        --b500: #3b82f6;
        --b600: #2563eb;
        --b700: #1d4ed8;
        --b800: #1e40af;
        --b900: #1e3a8a;
        --b950: #172554;
        --surface: #ffffff;
        --bg: #eef7ff;
        --bg2: #e0f2fe;
        --ink: #0f172a;
        --ink2: #1e293b;
        --ink3: #334155;
        --muted: #64748b;
        --soft: #94a3b8;
        --line: #cbd5e1;
        --g50: #f0fdf4;
        --g600: #16a34a;
        --g700: #15803d;
        --g100: #dcfce7;
        --g800: #166534;
        --r50: #fff1f2;
        --r100: #ffe4e6;
        --r600: #dc2626;
        --r700: #b91c1c;
        --r800: #7f1d1d;
        --a50: #fffbeb;
        --a100: #fef3c7;
        --a600: #d97706;
        --a700: #b45309;
        --a800: #78350f;
        --v50: #eff6ff;
        --v100: #dbeafe;
        --v600: #2563eb;
        --v700: #1d4ed8;
        --v800: #1e40af;
        --p50: #fdf4ff;
        --p100: #fae8ff;
        --p600: #c026d3;
        --p800: #701a75;
        --rad: 4px;
        --rad2: 6px;
        --rad3: 10px;
        --sh: 0 1px 2px rgba(15,23,42,.06),0 2px 8px rgba(15,23,42,.05);
        --sh2: 0 4px 16px rgba(37,99,235,.18),0 1px 4px rgba(37,99,235,.1);
        --tr: .13s ease;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .tk {
        font-family: 'IBM Plex Sans',sans-serif;
        font-size: 11px;
        color: var(--ink);
        background: var(--bg);
        min-height: 100vh;
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ SHELL Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-shell {
        max-width: 1680px;
        margin: 0 auto;
        padding: 10px 14px 28px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ TOPBAR Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .tk-search {
        position: relative;
        flex: 1;
        min-width: 180px;
    }

    .tk-search-ico {
        position: absolute;
        left: 8px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--soft);
        pointer-events: none;
        display: flex;
    }

    .tk-search input {
        width: 100%;
        height: 28px;
        padding: 0 8px 0 28px;
        border: 1.5px solid var(--b300);
        border-radius: 999px;
        font-family: 'IBM Plex Sans',sans-serif;
        font-size: 10.5px;
        color: var(--ink);
        background: #fff;
        outline: none;
        transition: var(--tr);
    }

        .tk-search input:focus {
            border-color: var(--b500);
            box-shadow: 0 0 0 3px rgba(59,130,246,.2);
        }

        .tk-search input::placeholder {
            color: var(--soft);
        }

    .tk-btn {
        height: 28px;
        padding: 0 12px;
        border-radius: 999px;
        border: none;
        font-family: 'IBM Plex Sans',sans-serif;
        font-size: 10.5px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--tr);
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .tk-btn:hover {
            transform: translateY(-1px);
        }

        .tk-btn:active {
            transform: none;
        }

    .tk-btn-ghost {
        background: #fff;
        border: 1.5px solid var(--b300);
        color: var(--b700);
    }

        .tk-btn-ghost:hover {
            background: var(--b50);
            border-color: var(--b500);
        }

    .tk-btn-solid {
        background: linear-gradient(135deg,var(--b600),var(--b900));
        color: #fff;
        box-shadow: var(--sh2);
    }

        .tk-btn-solid:hover {
            box-shadow: 0 6px 20px rgba(37,99,235,.4);
        }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ TABS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-tabs {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        align-items: center;
    }

    .tk-tab {
        height: 26px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1.5px solid var(--line);
        font-family: 'IBM Plex Sans',sans-serif;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--tr);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #fff;
        color: var(--muted);
    }

        .tk-tab:hover {
            background: var(--b50);
            color: var(--b700);
            border-color: var(--b300);
        }

        .tk-tab.active {
            background: linear-gradient(135deg,var(--b600),var(--b900));
            color: #fff;
            border-color: transparent;
            box-shadow: var(--sh2);
        }

    .tk-tab-n {
        font-size: 9px;
        font-weight: 800;
        border-radius: 999px;
        padding: 1px 5px;
        min-width: 16px;
        text-align: center;
        line-height: 1.6;
        background: rgba(255,255,255,.22);
        color: inherit;
    }

    .tk-tab:not(.active) .tk-tab-n {
        background: var(--b100);
        color: var(--b800);
    }

    .tk-card-cols {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .tk-card-cols-panel {
        position: absolute;
        right: 0;
        top: 31px;
        z-index: 15;
        width: 250px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: var(--rad3);
        background: #fff;
        box-shadow: var(--sh2);
    }

    .tk-card-cols-title {
        margin: 4px 0 6px;
        color: var(--muted);
        font-family: 'IBM Plex Mono',monospace;
        font-size: 8px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .tk-card-cols-item {
        min-height: 26px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--ink2);
        font-size: 10px;
        font-weight: 750;
        cursor: pointer;
    }

        .tk-card-cols-item input {
            width: 14px;
            height: 14px;
            accent-color: var(--b600);
        }

    .tk-card-cols-foot {
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid var(--line);
    }

    .tk-subtabs {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .tk-subtab {
        height: 23px;
        padding: 0 10px;
        border-radius: 999px;
        border: 1.5px solid var(--b200);
        background: #fff;
        color: var(--b700);
        font-family: 'IBM Plex Sans',sans-serif;
        font-size: 9.5px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--tr);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .tk-subtab.active {
            background: var(--b100);
            border-color: var(--b500);
            color: var(--b900);
        }

    .tk-subtab-n {
        background: var(--b200);
        color: var(--b900);
        font-size: 9px;
        font-weight: 800;
        border-radius: 999px;
        padding: 1px 5px;
        min-width: 14px;
        text-align: center;
    }

    .tk-chip-search {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 23px;
        padding: 0 9px;
        background: #fffbeb;
        border: 1.5px solid #fcd34d;
        border-radius: 999px;
        font-size: 9.5px;
        font-weight: 700;
        color: #92400e;
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ CARD + GRID Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-card {
        background: var(--surface);
        border-radius: var(--rad3);
        overflow: hidden;
        border: 1.5px solid var(--b200);
        box-shadow: var(--sh);
    }

    /*
                  Colunas fixas - dimensionadas pelo conteÃƒÂºdo real:
                  #00000 | Assunto (flex) | Cliente(120) | ResponsÃƒÂ¡vel(80) | Prio(64) | Tipo(72) | Status(80) | Abrir(46)
                */
    .tk-grid {
        display: grid;
        grid-template-columns: 58px 1fr 120px 80px 70px 64px 72px 80px 46px;
        align-items: stretch;
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ THEAD Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-thead {
        border-bottom: 2px solid var(--b900);
    }

        .tk-thead > span {
            font-family: 'IBM Plex Mono',monospace;
            font-size: 8.5px;
            font-weight: 700;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: .07em;
            padding: 7px 6px;
            display: flex;
            align-items: center;
            background: linear-gradient(180deg,var(--b700) 0%,var(--b900) 100%);
            border-right: 1px solid rgba(255,255,255,.1);
        }

            .tk-thead > span:last-child {
                border-right: none;
            }

            .tk-thead > span:nth-child(n+4) {
                justify-content: center;
            }

            /* Destaque colorido por coluna no header */
            .tk-thead > span:nth-child(1) {
                background: linear-gradient(180deg,#1e40af,#172554);
            }

            .tk-thead > span:nth-child(2) {
                background: linear-gradient(180deg,var(--b700),var(--b900));
            }

            .tk-thead > span:nth-child(3) {
                background: linear-gradient(180deg,#1d4ed8,#1e3a8a);
            }

            .tk-thead > span:nth-child(4) {
                background: linear-gradient(180deg,#1e3a8a,#172554);
            }

            .tk-thead > span:nth-child(5) {
                background: linear-gradient(180deg,#1d4ed8,#1e40af);
            }

            .tk-thead > span:nth-child(6) {
                background: linear-gradient(180deg,#1e40af,#1e3a8a);
            }

            .tk-thead > span:nth-child(7) {
                background: linear-gradient(180deg,var(--b700),var(--b900));
            }

            .tk-thead > span:nth-child(8) {
                background: linear-gradient(180deg,#172554,#0f172a);
            }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ROWS Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-row {
        cursor: pointer;
        border-bottom: 1px solid var(--line);
        transition: background var(--tr);
        position: relative;
    }

        .tk-row:last-child {
            border-bottom: none;
        }

        .tk-row:hover {
            background: var(--b50);
        }

        .tk-row::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            border-radius: 0 2px 2px 0;
            background: transparent;
            transition: var(--tr);
        }

        .tk-row:hover::before {
            background: var(--b400);
        }

        .tk-row.novo::before {
            background: #7f1d1d;
            width: 4px;
            box-shadow: 0 0 10px rgba(127,29,29,.9);
        }

        .tk-row.sla-danger::before {
            background: var(--r600);
        }

        .tk-row.sla-warning::before {
            background: var(--a600);
        }

        .tk-row.sla-ok::before {
            background: var(--g600);
        }

        .tk-row.aprovacao-aprovado::before {
            background: var(--g600);
        }

        .tk-row.aprovacao-recusado::before {
            background: var(--r600);
        }

        .tk-row.novo {
            animation: tkNovoPulse 1s ease-in-out infinite;
            border-bottom: 1px solid rgba(153,27,27,.3);
        }

    @@keyframes tkNovoPulse {
        0%, 100% {
            background: #fecaca;
            box-shadow: inset 4px 0 0 #991b1b, 0 0 0 rgba(153,27,27,0);
        }

        50% {
            background: #fca5a5;
            box-shadow: inset 4px 0 0 #7f1d1d, 0 3px 22px rgba(153,27,27,.35);
        }
    }

    .tk-row.novo .cc-code {
        color: #7f1d1d;
    }

    .tk-row.novo .cc-title {
        color: #450a0a;
    }

    .tk-row.novo:hover {
        animation: none;
        background: #f87171;
    }

    .tk-row.sla-danger {
        background: #fffafa;
    }

    .tk-row.aprovacao-aprovado {
        background: #f0fdf6;
    }

    .tk-row.aprovacao-recusado {
        background: #fff5f5;
    }

    /* cÃƒÂ©lulas */
    .tk-row > div {
        padding: 5px 6px;
        border-right: 1px solid #f1f5f9;
        min-width: 0;
        display: flex;
        align-items: center;
        align-self: stretch;
    }

        .tk-row > div:last-child {
            border-right: none;
        }

        .tk-row > div:nth-child(n+4) {
            justify-content: center;
        }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ CELL CONTENT Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .cc-code {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 9.5px;
        font-weight: 700;
        color: var(--b700);
        letter-spacing: .02em;
        white-space: nowrap;
    }

    .cc-title {
        font-size: 10.5px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.22;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .cc-sub {
        font-size: 8.5px;
        color: var(--soft);
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .cc-client {
        font-size: 10px;
        font-weight: 600;
        color: var(--ink3);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
    }

    .cc-user {
        font-size: 9px;
        font-weight: 700;
        color: var(--b800);
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
        background: var(--b100);
        border-radius: 3px;
        padding: 2px 4px;
        line-height: 1.4;
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ BADGES Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .bx {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
        letter-spacing: .02em;
        line-height: 1.4;
    }

    /* prioridade */
    .px-1 {
        background: var(--g100);
        color: var(--g800);
    }

    .px-2 {
        background: var(--b100);
        color: var(--b800);
    }

    .px-3 {
        background: var(--a100);
        color: var(--a800);
    }

    .px-4 {
        background: var(--r100);
        color: var(--r800);
    }

    /* tipo */
    .tx-melhoria {
        background: var(--g100);
        color: var(--g800);
    }

    .tx-erro {
        background: var(--r100);
        color: var(--r800);
    }

    .tx-mnv {
        background: var(--p100);
        color: var(--p800);
    }

    .tx-chamado {
        background: var(--v100);
        color: var(--v800);
    }

    /* status */
    .sx-1 {
        background: var(--b100);
        color: var(--b800);
    }

    .sx-2 {
        background: var(--v100);
        color: var(--v800);
    }

    .sx-3 {
        background: var(--g100);
        color: var(--g800);
    }

    .sx-4 {
        background: var(--a100);
        color: var(--a800);
    }

    .sx-5 {
        background: var(--p100);
        color: var(--p800);
    }

    .sx-6 {
        background: #fef9c3;
        color: #713f12;
        border: 1px solid #fde047;
    }

    /* novo badge */
    .bx-novo {
        font-size: 7.5px;
        font-weight: 800;
        padding: 1px 5px;
        border-radius: 2px;
        background: #991b1b;
        color: #fff;
        letter-spacing: .05em;
        margin-left: 4px;
        vertical-align: middle;
        box-shadow: 0 0 6px rgba(153,27,27,.6);
        animation: tkNovoBadge 1s ease-in-out infinite;
    }

    @@keyframes tkNovoBadge {
        0%, 100% {
            background: #991b1b;
            box-shadow: 0 0 5px rgba(153,27,27,.6);
        }

        50% {
            background: #7f1d1d;
            box-shadow: 0 0 12px rgba(127,29,29,.9);
        }
    }

    /* SLA tag */
    .sla-t {
        font-size: 8.5px;
        font-weight: 700;
        padding: 1px 4px;
        border-radius: 2px;
        white-space: nowrap;
    }

        .sla-t.ok {
            background: var(--g100);
            color: var(--g700);
        }

        .sla-t.warn {
            background: var(--a100);
            color: var(--a700);
        }

        .sla-t.danger {
            background: var(--r100);
            color: var(--r700);
        }

        .sla-t.none {
            background: var(--b50);
            color: var(--soft);
        }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ OPEN BTN Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-open {
        height: 22px;
        padding: 0 8px;
        border-radius: var(--rad);
        border: none;
        font-family: 'IBM Plex Sans',sans-serif;
        font-size: 9px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--tr);
        background: linear-gradient(135deg,var(--b500),var(--b700));
        color: #fff;
        white-space: nowrap;
        letter-spacing: .02em;
    }

        .tk-open:hover {
            background: linear-gradient(135deg,var(--b600),var(--b800));
            transform: translateY(-1px);
        }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ EMPTY Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .tk-empty {
        padding: 28px;
        text-align: center;
        color: var(--soft);
        font-size: 10.5px;
        font-weight: 600;
    }

    /* Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ FILTER MODAL Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ */
    .f-back {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.52);
        backdrop-filter: blur(5px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
    }

    .f-panel {
        width: 100%;
        max-width: 680px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 24px 60px rgba(15,23,42,.24);
        overflow: hidden;
        animation: fIn .18s ease;
    }

    @@keyframes fIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.97);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .f-head {
        background: linear-gradient(135deg,var(--b700),var(--b950));
        padding: 16px 18px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .f-head-t {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .f-head-s {
        font-size: 10px;
        color: var(--b300);
        margin-top: 2px;
    }

    .f-close {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.3);
        background: rgba(255,255,255,.1);
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--tr);
        line-height: 1;
    }

        .f-close:hover {
            background: rgba(255,255,255,.25);
        }

    .f-body {
        padding: 16px 18px;
    }

    .f-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .f-field {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .f-field.full {
            grid-column: 1/-1;
        }

    .f-label {
