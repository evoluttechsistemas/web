    IEnumerable<TicketChamadoCModel> FiltrarPorStatus(int situacao)
    {
        var q = _tickets.AsEnumerable();

        if (Filtros.CodCliente.HasValue)
            q = q.Where(t => t.CodCliente == Filtros.CodCliente.Value);

        if (!string.IsNullOrWhiteSpace(Filtros.UsuarioCliente))
            q = q.Where(t => !string.IsNullOrWhiteSpace(t.UsuarioAbertura) &&
                t.UsuarioAbertura.Trim().Equals(Filtros.UsuarioCliente.Trim(), StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(Filtros.DescricaoTitulo))
        {
            var termo = Filtros.DescricaoTitulo.Trim();
            q = q.Where(t => t.Assunto?.Contains(termo, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        if (Filtros.CodSituacao.HasValue)
            q = q.Where(t => t.CodSituacao == Filtros.CodSituacao.Value);
        else if (!FiltroAplicado && !TemFiltroAvancado() && string.IsNullOrWhiteSpace(_searchTerm))
            q = q.Where(t => t.CodSituacao == situacao);

        if (!FiltroAplicado && !TemFiltroAvancado() && string.IsNullOrWhiteSpace(_searchTerm) && AbaSetorSelecionada.HasValue)
            q = q.Where(t => t.CodSetor == AbaSetorSelecionada.Value);

        if (Filtros.CodTipo.HasValue) q = q.Where(t => t.CodTipo == Filtros.CodTipo.Value);
        if (Filtros.Prioridade.HasValue) q = q.Where(t => t.Prioridade == Filtros.Prioridade.Value);
        if (Filtros.DataInicial.HasValue) q = q.Where(t => t.DataHoraAbertura.Date >= Filtros.DataInicial.Value.Date);
        if (Filtros.DataFinal.HasValue) q = q.Where(t => t.DataHoraAbertura.Date <= Filtros.DataFinal.Value.Date);
        if (Filtros.SomenteNovos)
            q = q.Where(t => !string.IsNullOrWhiteSpace(t.Novo) &&
                t.Novo.Trim().Equals("S", StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var busca = _searchTerm.Trim();
            q = q.Where(t =>
                (t.Assunto?.Contains(busca, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (t.NomeCliente?.Contains(busca, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (t.ApelidoCliente?.Contains(busca, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        string? usuarioFiltro = null;
        bool modoPadrao = !FiltroAplicado && !TemFiltroAvancado() && string.IsNullOrWhiteSpace(_searchTerm);
        if (!string.IsNullOrWhiteSpace(Filtros.UsuarioResponsavel))
            usuarioFiltro = Filtros.UsuarioResponsavel.Trim().ToUpper();
        else if (modoPadrao && !string.IsNullOrWhiteSpace(_usuarioSelecionado))
            usuarioFiltro = _usuarioSelecionado.Trim().ToUpper();

        if (!string.IsNullOrWhiteSpace(usuarioFiltro))
            q = q.Where(t => !string.IsNullOrWhiteSpace(t.Usuario) &&
                (t.Usuario.Trim().Equals(usuarioFiltro, StringComparison.OrdinalIgnoreCase) ||
                 t.Usuario.Trim().Equals("NOVO", StringComparison.OrdinalIgnoreCase)));

        return q
            .OrderByDescending(t => t.Novo?.Trim().Equals("S", StringComparison.OrdinalIgnoreCase) == true)
            .ThenByDescending(t => t.Prioridade)
            .ThenByDescending(t => t.DataHoraUltimaGravacao);
    }

    int CountPorStatus(int situacao) => FiltrarPorStatus(situacao).Count();

    int CountPorStatusSetor(int codSetor)
    {
        var q = _tickets.AsEnumerable().Where(t => t.CodSetor == codSetor);
        q = codSetor == 2 ? q.Where(t => t.CodSituacao == 1 || t.CodSituacao == 2) : q.Where(t => t.CodSituacao == 1);
        if (!string.IsNullOrWhiteSpace(_usuarioSelecionado))
            q = q.Where(t => !string.IsNullOrWhiteSpace(t.Usuario) &&
                (t.Usuario.Trim().Equals(_usuarioSelecionado, StringComparison.OrdinalIgnoreCase) ||
                 t.Usuario.Trim().Equals("NOVO", StringComparison.OrdinalIgnoreCase)));
        return q.Count();
    }

    int CountDesenvolvimentoPorSituacao(int situacao)
    {
        var q = _tickets.AsEnumerable().Where(t => t.CodSetor == 2 && t.CodSituacao == situacao);
        if (!string.IsNullOrWhiteSpace(_usuarioSelecionado))
            q = q.Where(t => !string.IsNullOrWhiteSpace(t.Usuario) &&
                (t.Usuario.Trim().Equals(_usuarioSelecionado, StringComparison.OrdinalIgnoreCase) ||
                 t.Usuario.Trim().Equals("NOVO", StringComparison.OrdinalIgnoreCase)));
        return q.Count();
    }

