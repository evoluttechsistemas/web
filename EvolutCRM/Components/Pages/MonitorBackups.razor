             @onclick="() => FiltrarPorStatus(StatusBackup.EmCurso)">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Em curso</span>
                <span class="mb-stat-ico">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@Contar(StatusBackup.EmCurso)</div>
            <div class="mb-stat-sub">sincronizando agora</div>
        </div>

        <div class="mb-stat @(_filtroStatus == StatusBackup.Ok ? "active" : "")"
             style="--st-c:#16a34a; --st-bg:#dcfce7;"
             @onclick="() => FiltrarPorStatus(StatusBackup.Ok)">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Em dia</span>
