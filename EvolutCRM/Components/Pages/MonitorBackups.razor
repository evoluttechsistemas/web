    private string Iniciais(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var p = nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length >= 2) return $"{p[0][0]}{p[1][0]}".ToUpperInvariant();
        return nome.Length >= 2 ? nome.Substring(0, 2).ToUpperInvariant() : nome.ToUpperInvariant();
    }

    private static readonly string[] _cores =
    {
        "linear-gradient(135deg,#2563eb,#1e3a8a)",
        "linear-gradient(135deg,#7c3aed,#5b21b6)",
        "linear-gradient(135deg,#0891b2,#155e75)",
        "linear-gradient(135deg,#16a34a,#166534)",
        "linear-gradient(135deg,#ea580c,#9a3412)",
        "linear-gradient(135deg,#db2777,#9d174d)",
        "linear-gradient(135deg,#0d9488,#115e59)",
    };
    private string CorAvatar(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return _cores[0];
        int h = 0;
        foreach (var ch in nome) h = (h * 31 + ch) & 0x7fffffff;
        return _cores[h % _cores.Length];
    }

    private string FormatarCnpj(string cnpj)
    {
        if (string.IsNullOrWhiteSpace(cnpj)) return "—";
        var d = new string(cnpj.Where(char.IsDigit).ToArray());
        if (d.Length != 14) return cnpj;
        return $"{d.Substring(0, 2)}.{d.Substring(2, 3)}.{d.Substring(5, 3)}/{d.Substring(8, 4)}-{d.Substring(12, 2)}";
    }

    private string FormatarTamanho(long bytes)
    {
        string[] u = { "B", "KB", "MB", "GB", "TB" };
        double t = bytes; int i = 0;
        while (t >= 1024 && i < u.Length - 1) { t /= 1024; i++; }
        return $"{t:0.##} {u[i]}";
    }

    private string TempoRelativo(DateTime dt)
    {
        var d = DateTime.Now - dt;
        if (d.TotalMinutes < 1) return "agora mesmo";
        if (d.TotalMinutes < 60) return $"há {(int)d.TotalMinutes} min";
        if (d.TotalHours < 24) return $"há {(int)d.TotalHours}h";
        if (d.TotalDays < 30) return $"há {(int)d.TotalDays} dia(s)";
        return $"há {(int)(d.TotalDays / 30)} mês(es)";
    }

