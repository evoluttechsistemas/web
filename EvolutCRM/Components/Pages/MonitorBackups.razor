                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@Contar(StatusBackup.Ok)</div>
            <div class="mb-stat-sub">últimas 24h</div>
        </div>

        <div class="mb-stat @(_filtroStatus == StatusBackup.Atencao ? "active" : "")"
             style="--st-c:#f59e0b; --st-bg:#fef3c7;"
             @onclick="() => FiltrarPorStatus(StatusBackup.Atencao)">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Atenção</span>
                <span class="mb-stat-ico">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@Contar(StatusBackup.Atencao)</div>
            <div class="mb-stat-sub">1 a 2 dias</div>
        </div>

        <div class="mb-stat @(_filtroStatus == StatusBackup.Critico ? "active" : "")"
             style="--st-c:#ea580c; --st-bg:#ffedd5;"
             @onclick="() => FiltrarPorStatus(StatusBackup.Critico)">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Crítico</span>
                <span class="mb-stat-ico">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@Contar(StatusBackup.Critico)</div>
            <div class="mb-stat-sub">2 a 5 dias</div>
        </div>

        <div class="mb-stat @(_filtroStatus == StatusBackup.SemBackup ? "active" : "")"
             style="--st-c:#dc2626; --st-bg:#fee2e2;"
             @onclick="() => FiltrarPorStatus(StatusBackup.SemBackup)">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Sem backup</span>
                <span class="mb-stat-ico">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@Contar(StatusBackup.SemBackup)</div>
            <div class="mb-stat-sub">5+ dias ou nunca</div>
        </div>

        <div class="mb-stat @(_filtroNuncaSincronizou ? "active" : "")"
             style="--st-c:#7c3aed; --st-bg:#ede9fe;"
             @onclick="FiltrarNuncaSincronizou">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Nunca sincronizou</span>
                <span class="mb-stat-ico">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z" /><line x1="8" y1="12" x2="16" y2="12" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@_semBackup.Count</div>
            <div class="mb-stat-sub">mensalistas sem registro</div>
        </div>
    </div>

    @if (_semBackup.Any() && _filtroNuncaSincronizou)
    {
        <div class="mb-table-card" style="margin-bottom:20px;border-color:#fca5a5;">
            <div style="padding:14px 16px;background:#fff7f7;border-bottom:1.5px solid #fca5a5;display:flex;align-items:center;gap:10px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <span style="font-size:12.5px;font-weight:700;color:#b91c1c;">
                    @_semBackup.Count cliente(s) mensalista(s) nunca sincronizaram backup
                </span>
            </div>
            <table class="mb-table">
                <thead>
                    <tr>
                        <th class="no-sort">Cliente</th>
                        <th class="no-sort">CNPJ</th>
                        <th class="no-sort">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _paginaSemBackupItens)
                    {
                        <tr>
                            <td>
                                <div class="mb-cli">
                                    <div class="mb-cli-ava" style="background:@CorAvatar(c.Apelido ?? c.NomeCliente);">@Iniciais(c.Apelido ?? c.NomeCliente)</div>
                                    <div class="mb-cli-info">
                                        <div class="mb-cli-name" title="@(string.IsNullOrWhiteSpace(c.Apelido) ? c.NomeCliente : c.Apelido)">
                                            @(string.IsNullOrWhiteSpace(c.Apelido) ? c.NomeCliente : c.Apelido)
                                        </div>
                                        <div class="mb-cli-cnpj">@FormatarCnpj(c.Cnpj)</div>
                                    </div>
                                </div>
                            </td>
                            <td><span style="font-family:'IBM Plex Mono',monospace;font-size:12px;">@FormatarCnpj(c.Cnpj)</span></td>
                            <td>
                                <span class="mb-badge s-sembackup">
                                    <span class="mb-badge-dot"></span> Nunca sincronizou
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_totalPaginasSemBackup > 1)
            {
                <div class="mb-pager" style="padding:14px 0;">
                    <button class="mb-pg-btn" disabled="@(_paginaSemBackup == 1)" @onclick="() => IrParaPaginaSemBackup(_paginaSemBackup - 1)">‹</button>
                    @foreach (var p in PaginasVisiveisSemBackup())
                    {
                        @if (p == -1)
                        {
                            <span class="mb-pg-dots">…</span>
                        }
                        else
                        {
                            <button class="mb-pg-btn @(p == _paginaSemBackup ? "active" : "")" @onclick="() => IrParaPaginaSemBackup(p)">@p</button>
                        }
                    }
                    <button class="mb-pg-btn" disabled="@(_paginaSemBackup == _totalPaginasSemBackup)" @onclick="() => IrParaPaginaSemBackup(_paginaSemBackup + 1)">›</button>
                    <span class="mb-pg-info">Página @_paginaSemBackup de @_totalPaginasSemBackup</span>
                </div>
            }
        </div>
    }


    @if (!_filtroNuncaSincronizou)
    {
        <!-- TOOLBAR -->
        <div class="mb-toolbar">
            <div class="mb-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" placeholder="Buscar por cliente, CNPJ, arquivo ou computador..."
                value="@_busca" @oninput="OnBuscaInput" />
            </div>
            <div class="mb-chips">
                <div class="mb-chip @(_filtroStatus == null ? "active" : "")" @onclick="() => FiltrarPorStatus(null)">
                    Todos <span class="mb-chip-count">@_todos.Count</span>
                </div>
                <div class="mb-chip @(_filtroStatus == StatusBackup.Critico ? "active" : "")" style="--chip-c:#ea580c;" @onclick="() => FiltrarPorStatus(StatusBackup.Critico)">
                    <span class="mb-chip-dot"></span> Crítico <span class="mb-chip-count">@Contar(StatusBackup.Critico)</span>
                </div>
                <div class="mb-chip @(_filtroStatus == StatusBackup.SemBackup ? "active" : "")" style="--chip-c:#dc2626;" @onclick="() => FiltrarPorStatus(StatusBackup.SemBackup)">
                    <span class="mb-chip-dot"></span> Sem backup <span class="mb-chip-count">@Contar(StatusBackup.SemBackup)</span>
                </div>
            </div>
        </div>

        <!-- TABLE (desktop) -->
        <div class="mb-table-card">
            @if (_carregando && !_todos.Any())
            {
                <div style="padding:16px;">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="mb-skeleton"></div>
                    }
                </div>
            }
            else if (!_filtrados.Any())
            {
                @EmptyState
            }
            else
            {
                <table class="mb-table">
                    <thead>
                        <tr>
                            <th class="@SortClass("nome")" @onclick='() => Ordenar("nome")'>Cliente <span class="mb-sort-ico">@SortArrow("nome")</span></th>
                            <th class="@SortClass("status")" @onclick='() => Ordenar("status")'>Status <span class="mb-sort-ico">@SortArrow("status")</span></th>
                            <th class="@SortClass("data")" @onclick='() => Ordenar("data")'>Última sincronização <span class="mb-sort-ico">@SortArrow("data")</span></th>
                            <th class="no-sort">Arquivo</th>
                            <th class="no-sort">Computador</th>
                            <th class="@SortClass("versao")" @onclick='() => Ordenar("versao")'>Versão <span class="mb-sort-ico">@SortArrow("versao")</span></th>
                            <th class="@SortClass("syncs")" @onclick='() => Ordenar("syncs")'>Syncs <span class="mb-sort-ico">@SortArrow("syncs")</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _pagina)
                        {
                            <tr>
                                <td>
                                    <div class="mb-cli">
                                        <div class="mb-cli-ava" style="background:@CorAvatar(c.Apelido ?? c.NomeCliente);">@Iniciais(c.Apelido ?? c.NomeCliente)</div>
                                        <div class="mb-cli-info">
                                            <div class="mb-cli-name" title="@(string.IsNullOrWhiteSpace(c.Apelido) ? c.NomeCliente : c.Apelido)">
                                                @(string.IsNullOrWhiteSpace(c.Apelido) ? c.NomeCliente : c.Apelido)
                                            </div>
                                            <div class="mb-cli-cnpj">@FormatarCnpj(c.Cnpj)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="mb-badge @StatusClass(c.Status)">
                                        <span class="mb-badge-dot"></span> @StatusLabel(c.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (c.DataHoraUltimaSincronizacao.HasValue)
                                    {
                                        <div class="mb-when">
                                            <span class="mb-when-abs">@c.DataHoraUltimaSincronizacao.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            <span class="mb-when-rel">@TempoRelativo(c.DataHoraUltimaSincronizacao.Value)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="mb-when-rel">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="mb-file" title="@c.Arquivo">@(string.IsNullOrWhiteSpace(c.Arquivo) ? "—" : c.Arquivo)</div>
                                    @if (c.TamanhoBytes > 0)
                                    {
                                        <div class="mb-size">@FormatarTamanho(c.TamanhoBytes)</div>
                                    }
                                </td>
                                <td>
                                    <span class="mb-pc">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                                        @(string.IsNullOrWhiteSpace(c.Computador) ? "—" : c.Computador)
                                    </span>
                                </td>
                                <td><span class="mb-ver">@(string.IsNullOrWhiteSpace(c.VersaoSistema) ? "—" : c.VersaoSistema)</span></td>
                                <td><span class="mb-syncs">@c.QuantidadeSincronizacoes</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- CARDS (mobile) -->
        <div class="mb-cards">
            @if (_carregando && !_todos.Any())
            {
                @for (int i = 0; i < 4; i++)
                {
                    <div class="mb-skeleton" style="height:120px;"></div>
                }
            }
            else if (!_filtrados.Any())
            {
                <div class="mb-table-card">@EmptyState</div>
            }
            else
            {
                @foreach (var c in _pagina)
                {
                    <div class="mb-mcard" style="--mc-c:@CorStatus(c.Status);">
                        <div class="mb-mcard-head">
                            <div class="mb-cli">
                                <div class="mb-cli-info">
                                    <div class="mb-cli-name" title="@c.NomeCliente">@c.NomeCliente</div>
                                    @if (!string.IsNullOrWhiteSpace(c.Apelido))
                                    {
                                        <div class="mb-cli-cnpj" style="color:#7c3aed;">@c.Apelido</div>
                                    }
                                    <div class="mb-cli-cnpj">@FormatarCnpj(c.Cnpj)</div>
                                </div>
                            </div>
                            <span class="mb-badge @StatusClass(c.Status)">
                                <span class="mb-badge-dot"></span> @StatusLabel(c.Status)
                            </span>
                        </div>
                        <div class="mb-mcard-body">
                            <div class="mb-mrow full">
                                <div class="mb-mlbl">Última sincronização</div>
                                <div class="mb-mval">
                                    @if (c.DataHoraUltimaSincronizacao.HasValue)
                                    {
                                        @($"{c.DataHoraUltimaSincronizacao.Value:dd/MM/yyyy HH:mm} · {TempoRelativo(c.DataHoraUltimaSincronizacao.Value)}")
                                    }
                                    else
                                    {
                                        @("Nenhum backup registrado")
                                    }
                                </div>
                            </div>
                            <div class="mb-mrow full">
                                <div class="mb-mlbl">Arquivo</div>
                                <div class="mb-mval">@(string.IsNullOrWhiteSpace(c.Arquivo) ? "—" : c.Arquivo)@(c.TamanhoBytes > 0 ? $" ({FormatarTamanho(c.TamanhoBytes)})" : "")</div>
                            </div>
                            <div class="mb-mrow">
                                <div class="mb-mlbl">Computador</div>
                                <div class="mb-mval">@(string.IsNullOrWhiteSpace(c.Computador) ? "—" : c.Computador)</div>
                            </div>
                            <div class="mb-mrow">
                                <div class="mb-mlbl">Versão</div>
                                <div class="mb-mval">@(string.IsNullOrWhiteSpace(c.VersaoSistema) ? "—" : c.VersaoSistema)</div>
                            </div>
                            <div class="mb-mrow">
                                <div class="mb-mlbl">Sincronizações</div>
                                <div class="mb-mval">@c.QuantidadeSincronizacoes</div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- PAGINAÇÃO -->
        @if (_totalPaginas > 1)
        {
            <div class="mb-pager">
                <button class="mb-pg-btn" disabled="@(_paginaAtual == 1)" @onclick="() => IrParaPagina(_paginaAtual - 1)">‹</button>

                @foreach (var p in PaginasVisiveis())
                {
                    @if (p == -1)
                    {
                        <span class="mb-pg-dots">…</span>
                    }
                    else
                    {
                        <button class="mb-pg-btn @(p == _paginaAtual ? "active" : "")" @onclick="() => IrParaPagina(p)">@p</button>
                    }
                }

                <button class="mb-pg-btn" disabled="@(_paginaAtual == _totalPaginas)" @onclick="() => IrParaPagina(_paginaAtual + 1)">›</button>
                <span class="mb-pg-info">Página @_paginaAtual de @_totalPaginas</span>
            </div>
        }

        <!-- FOOTER -->
        <div class="mb-foot">
            <span>
                @if (_filtrados.Any())
                {
                    var ini = (_paginaAtual - 1) * _porPagina + 1;
                    var fim = Math.Min(_paginaAtual * _porPagina, _filtrados.Count);
                    @($"Exibindo {ini}–{fim} de {_filtrados.Count} cliente(s)")
                }
                else
                {
                    @("Nenhum cliente")
                }
            </span>
            <span>@(_ultimaAtualizacao == DateTime.MinValue ? "" : $"Atualizado às {_ultimaAtualizacao:HH:mm:ss}")</span>
        </div>

    }

</div>

@code {

    private bool _filtroNuncaSincronizou = false;
    private List<ClienteSemBackupModel> _semBackup = new();
    private int _paginaAtual = 1;
    private const int _porPagina = 15;
    private int _totalPaginas => (int)Math.Ceiling(_filtrados.Count / (double)_porPagina);
    private List<MonitorBackupModel> _pagina = new();
    private List<MonitorBackupModel> _todos = new();
    private List<MonitorBackupModel> _filtrados = new();
    private bool _carregando = true;
    private bool _autoRefresh = true;
    private string _busca = "";
    private StatusBackup? _filtroStatus = null;
    private string _sortCampo = "data";
    private bool _sortAsc = true;
    private DateTime _ultimaAtualizacao = DateTime.MinValue;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private bool _disposed;

    private int _paginaSemBackup = 1;
    private const int _porPaginaSemBackup = 15;
    private int _totalPaginasSemBackup => (int)Math.Ceiling(_semBackup.Count / (double)_porPaginaSemBackup);
    private List<ClienteSemBackupModel> _paginaSemBackupItens = new();

    private void IrParaPaginaSemBackup(int p)
    {
        if (p < 1 || p > _totalPaginasSemBackup) return;
        _paginaSemBackup = p;
        _paginaSemBackupItens = _semBackup
            .Skip((_paginaSemBackup - 1) * _porPaginaSemBackup)
            .Take(_porPaginaSemBackup)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        await AtualizarAsync();
        IniciarTimer();
    }

    private void IniciarTimer()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(_cts.Token))
                {
                    if (_disposed) break;
                    if (_autoRefresh)
                        await InvokeAsync(AtualizarAsync);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private string _erroDebug = "";

    private async Task AtualizarAsync()
    {
        _carregando = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            _todos = await MonitorBackupService.ObterStatusBackupsAsync();
            _semBackup = await MonitorBackupService.ObterClientesSemBackupAsync();
            _paginaSemBackup = 1;
            _paginaSemBackupItens = _semBackup.Skip(0).Take(_porPaginaSemBackup).ToList();
            _ultimaAtualizacao = DateTime.Now;
            _erroDebug = "";
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            _erroDebug = ex.Message;
            await JS.InvokeVoidAsync("console.error", "[MonitorBackup] " + ex.ToString());
        }
        finally
        {
            _carregando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AplicarFiltros()
    {
        IEnumerable<MonitorBackupModel> q = _todos;

        if (_filtroStatus.HasValue)
            q = q.Where(x => x.Status == _filtroStatus.Value);

        if (!string.IsNullOrWhiteSpace(_busca))
        {
            var b = _busca.Trim().ToLowerInvariant();
            q = q.Where(x =>
    (x.NomeCliente ?? "").ToLowerInvariant().Contains(b) ||
    (x.Apelido ?? "").ToLowerInvariant().Contains(b) ||
    (x.Cnpj ?? "").ToLowerInvariant().Contains(b) ||
    (x.Arquivo ?? "").ToLowerInvariant().Contains(b) ||
    (x.Computador ?? "").ToLowerInvariant().Contains(b));
        }

        q = _sortCampo switch
        {
            "nome" => _sortAsc ? q.OrderBy(x => x.NomeCliente) : q.OrderByDescending(x => x.NomeCliente),
            "status" => _sortAsc ? q.OrderBy(x => x.Status) : q.OrderByDescending(x => x.Status),
            "versao" => _sortAsc ? q.OrderBy(x => x.VersaoSistema) : q.OrderByDescending(x => x.VersaoSistema),
            "syncs" => _sortAsc ? q.OrderBy(x => x.QuantidadeSincronizacoes) : q.OrderByDescending(x => x.QuantidadeSincronizacoes),
            _ => _sortAsc ? q.OrderBy(x => x.DataHoraUltimaSincronizacao ?? DateTime.MinValue)
                                 : q.OrderByDescending(x => x.DataHoraUltimaSincronizacao ?? DateTime.MinValue),
        };

        _filtrados = q.ToList();

        // Volta pra página 1 sempre que o filtro/busca muda o conjunto
        if (_paginaAtual > _totalPaginas)
            _paginaAtual = 1;

        AplicarPagina();
    }

    private void AplicarPagina()
    {
        _pagina = _filtrados
            .Skip((_paginaAtual - 1) * _porPagina)
            .Take(_porPagina)
            .ToList();
    }

    private void IrParaPagina(int p)
    {
        if (p < 1 || p > _totalPaginas) return;
        _paginaAtual = p;
        AplicarPagina();
    }

    // Mostra: 1 ... 4 5 [6] 7 8 ... 20  (janela ao redor da atual)
    private IEnumerable<int> PaginasVisiveis()
    {
        int total = _totalPaginas;
        int atual = _paginaAtual;
        var paginas = new List<int>();

        if (total <= 7)
        {
            for (int i = 1; i <= total; i++) paginas.Add(i);
            return paginas;
        }

        paginas.Add(1);
        if (atual > 3) paginas.Add(-1); // reticências

        int ini = Math.Max(2, atual - 1);
        int fim = Math.Min(total - 1, atual + 1);
        for (int i = ini; i <= fim; i++) paginas.Add(i);

        if (atual < total - 2) paginas.Add(-1); // reticências
        paginas.Add(total);

        return paginas;
    }


    private void FiltrarPorStatus(StatusBackup? status)
    {
        _filtroNuncaSincronizou = false;
        _filtroStatus = _filtroStatus == status ? null : status;
        _paginaAtual = 1;
        AplicarFiltros();
    }

