    private IEnumerable<int> PaginasVisiveisSemBackup()
    {
        int total = _totalPaginasSemBackup;
        int atual = _paginaSemBackup;
        var paginas = new List<int>();

        if (total <= 7)
        {
            for (int i = 1; i <= total; i++) paginas.Add(i);
            return paginas;
        }

        paginas.Add(1);
        if (atual > 3) paginas.Add(-1);

        int ini = Math.Max(2, atual - 1);
        int fim = Math.Min(total - 1, atual + 1);
        for (int i = ini; i <= fim; i++) paginas.Add(i);

        if (atual < total - 2) paginas.Add(-1);
        paginas.Add(total);

        return paginas;
    }

    private void FiltrarNuncaSincronizou()
    {
        _filtroNuncaSincronizou = !_filtroNuncaSincronizou;
        _filtroStatus = null;
        _paginaSemBackup = 1;
        _paginaSemBackupItens = _semBackup.Skip(0).Take(_porPaginaSemBackup).ToList();
        AplicarFiltros();
    }
