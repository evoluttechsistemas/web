@page "/admin/monitor-backups"
@using EvolutCRM.Services
@inject MonitorBackupService MonitorBackupService
@inject IJSRuntime JS
@implements IDisposable

<style>
    .mb-wrap {
        --mb-ink: #0f172a;
        --mb-ink2: #334155;
        --mb-muted: #64748b;
        --mb-soft: #94a3b8;
        --mb-line: #e2e8f0;
        --mb-bg: #f0f4fd;
        --mb-card: #ffffff;
        --mb-blue: #2563eb;
        --mb-blue-d: #1e3a8a;
        --mb-green: #16a34a;
        --mb-amber: #f59e0b;
        --mb-orange: #ea580c;
        --mb-red: #dc2626;
        --mb-rad: 14px;
        --mb-rad-sm: 10px;
        --mb-tr: .16s ease;
        height: 100%;
        overflow-y: auto;
        background: var(--mb-bg);
        font-family: 'IBM Plex Sans', sans-serif;
        color: var(--mb-ink);
        padding: 20px 22px 40px;
    }

        .mb-wrap::-webkit-scrollbar {
            width: 8px;
        }

        .mb-wrap::-webkit-scrollbar-thumb {
            background: #c7d2e8;
            border-radius: 999px;
        }

    /* ─── HEADER ─── */
    .mb-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .mb-title-block {
        min-width: 0;
    }

    .mb-title {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 22px;
        font-weight: 700;
        color: var(--mb-blue-d);
        line-height: 1.15;
    }

    .mb-title-ico {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: linear-gradient(135deg, var(--mb-blue), var(--mb-blue-d));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(37,99,235,.32);
    }

    .mb-subtitle {
        font-size: 12.5px;
        color: var(--mb-muted);
        margin-top: 6px;
        margin-left: 51px;
    }

    .mb-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .mb-auto {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--mb-muted);
        background: var(--mb-card);
        border: 1px solid var(--mb-line);
        border-radius: 999px;
        padding: 7px 13px;
        user-select: none;
    }

    .mb-auto-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--mb-green);
        box-shadow: 0 0 0 0 rgba(22,163,74,.5);
        animation: mbPulse 2s infinite;
    }

    .mb-auto.off .mb-auto-dot {
        background: var(--mb-soft);
        animation: none;
        box-shadow: none;
    }

    @@keyframes mbPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(22,163,74,.5);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(22,163,74,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(22,163,74,0);
        }
    }

    .mb-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 38px;
        padding: 0 15px;
        border-radius: var(--mb-rad-sm);
        border: 1px solid var(--mb-line);
        background: var(--mb-card);
        color: var(--mb-ink2);
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--mb-tr);
    }

        .mb-btn:hover {
            border-color: var(--mb-blue);
            color: var(--mb-blue);
            background: #f5f9ff;
        }

        .mb-btn.primary {
            background: linear-gradient(135deg, var(--mb-blue), var(--mb-blue-d));
            color: #fff;
            border-color: transparent;
            box-shadow: 0 3px 10px rgba(37,99,235,.28);
        }

            .mb-btn.primary:hover {
                filter: brightness(1.06);
                color: #fff;
            }

        .mb-btn.spinning svg {
            animation: mbSpin .7s linear infinite;
        }

    @@keyframes mbSpin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ─── STAT BAR ─── */
    .mb-stats {
        display: flex;
        align-items: stretch;
        gap: 0;
        margin-bottom: 20px;
        background: var(--mb-card);
        border: 1px solid var(--mb-line);
        border-radius: var(--mb-rad);
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15,23,42,.05);
    }

    .mb-stat {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        padding: 14px 10px;
        cursor: pointer;
        transition: var(--mb-tr);
        border-right: 1px solid var(--mb-line);
        border-radius: 0;
        border: none;
        border-right: 1px solid var(--mb-line);
        position: relative;
        text-align: center;
        overflow: hidden;
    }

        .mb-stat:last-child {
            border-right: none;
        }

        .mb-stat::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            background: var(--st-c, var(--mb-blue));
            opacity: 0;
            transition: var(--mb-tr);
        }

        .mb-stat:hover {
            background: #f8faff;
            transform: none;
            box-shadow: none;
        }

            .mb-stat:hover::before,
            .mb-stat.active::before {
                opacity: 1;
            }

        .mb-stat.active {
            background: #f5f9ff;
            box-shadow: none;
            border-color: transparent;
        }

    .mb-stat-lbl {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--mb-muted);
    }

    .mb-stat-num {
        font-size: 22px;
        font-weight: 700;
        line-height: 1.1;
        color: var(--mb-ink);
        font-family: 'IBM Plex Mono', monospace;
    }

    .mb-stat.active .mb-stat-num {
        color: var(--st-c, var(--mb-blue));
    }

    .mb-stat-sub {
        font-size: 9.5px;
        color: var(--mb-soft);
        font-weight: 500;
    }

    /* remover o ícone — não cabe na barra minimalista */
    .mb-stat-ico {
        display: none;
    }

    .mb-stat-top {
        display: contents;
    }

    /* ─── TOOLBAR ─── */
    .mb-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .mb-search {
        position: relative;
        flex: 1;
        min-width: 220px;
    }

        .mb-search svg {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--mb-soft);
            pointer-events: none;
        }

        .mb-search input {
            width: 100%;
            height: 40px;
            padding: 0 14px 0 38px;
            border-radius: var(--mb-rad-sm);
            border: 1px solid var(--mb-line);
            background: var(--mb-card);
            font-size: 13px;
            font-family: inherit;
            color: var(--mb-ink);
            transition: var(--mb-tr);
            outline: none;
        }

            .mb-search input:focus {
                border-color: var(--mb-blue);
                box-shadow: 0 0 0 3px rgba(37,99,235,.12);
            }

            .mb-search input::placeholder {
                color: var(--mb-soft);
            }

    .mb-chips {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .mb-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 40px;
        padding: 0 14px;
        border-radius: var(--mb-rad-sm);
        border: 1px solid var(--mb-line);
        background: var(--mb-card);
        font-size: 12px;
        font-weight: 600;
        color: var(--mb-ink2);
        cursor: pointer;
        transition: var(--mb-tr);
        white-space: nowrap;
    }

        .mb-chip:hover {
            border-color: var(--chip-c, var(--mb-blue));
        }

        .mb-chip.active {
            background: var(--chip-c, var(--mb-blue));
            border-color: var(--chip-c, var(--mb-blue));
            color: #fff;
        }

    .mb-chip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--chip-c);
    }

    .mb-chip.active .mb-chip-dot {
        background: #fff;
    }

    .mb-chip-count {
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: rgba(15,23,42,.08);
        font-size: 10px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .mb-chip.active .mb-chip-count {
        background: rgba(255,255,255,.25);
        color: #fff;
    }

    /* ─── TABLE (desktop) ─── */
    .mb-table-card {
        background: var(--mb-card);
        border: 1px solid var(--mb-line);
        border-radius: var(--mb-rad);
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15,23,42,.05);
    }

    .mb-table {
        width: 100%;
        border-collapse: collapse;
    }

        .mb-table thead th {
            text-align: left;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--mb-muted);
            padding: 13px 16px;
            background: #f8faff;
            border-bottom: 1.5px solid var(--mb-line);
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
            transition: var(--mb-tr);
        }

            .mb-table thead th:hover {
                color: var(--mb-blue);
                background: #eef4ff;
            }

            .mb-table thead th.no-sort {
                cursor: default;
            }

                .mb-table thead th.no-sort:hover {
                    color: var(--mb-muted);
                    background: #f8faff;
                }

    .mb-sort-ico {
        font-size: 9px;
        margin-left: 4px;
        opacity: .5;
    }

    .mb-table thead th.sorted .mb-sort-ico {
        opacity: 1;
        color: var(--mb-blue);
    }

    .mb-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: var(--mb-tr);
    }

        .mb-table tbody tr:hover {
            background: #f8faff;
        }

        .mb-table tbody tr:last-child {
            border-bottom: none;
        }

    .mb-table td {
        padding: 13px 16px;
        font-size: 12.5px;
        color: var(--mb-ink2);
        vertical-align: middle;
    }

    .mb-cli {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .mb-cli-ava {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        font-family: 'IBM Plex Mono', monospace;
    }

    .mb-cli-info {
        min-width: 0;
    }

    .mb-cli-name {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--mb-ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 240px;
    }

    .mb-cli-cnpj {
        font-size: 10.5px;
        color: var(--mb-soft);
        font-family: 'IBM Plex Mono', monospace;
        margin-top: 2px;
    }

    .mb-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .mb-badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .mb-badge.s-emcurso {
        background: #dbeafe;
        color: #1e40af;
    }

        .mb-badge.s-emcurso .mb-badge-dot {
            background: var(--mb-blue);
            animation: mbPulse 1.4s infinite;
        }

    .mb-badge.s-ok {
        background: #dcfce7;
        color: #15803d;
    }

        .mb-badge.s-ok .mb-badge-dot {
            background: var(--mb-green);
        }

    .mb-badge.s-atencao {
        background: #fef3c7;
        color: #b45309;
    }

        .mb-badge.s-atencao .mb-badge-dot {
            background: var(--mb-amber);
        }

    .mb-badge.s-critico {
        background: #ffedd5;
        color: #c2410c;
    }

        .mb-badge.s-critico .mb-badge-dot {
            background: var(--mb-orange);
        }

    .mb-badge.s-sembackup {
        background: #fee2e2;
        color: #b91c1c;
    }

        .mb-badge.s-sembackup .mb-badge-dot {
            background: var(--mb-red);
        }

    .mb-when {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .mb-when-abs {
        font-size: 12px;
        color: var(--mb-ink2);
        font-weight: 500;
    }

    .mb-when-rel {
        font-size: 10.5px;
        color: var(--mb-soft);
    }

    .mb-file {
        font-size: 11.5px;
        color: var(--mb-ink2);
        font-family: 'IBM Plex Mono', monospace;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mb-size {
        font-size: 10.5px;
        color: var(--mb-soft);
        margin-top: 2px;
    }

    .mb-pc {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: var(--mb-ink2);
    }

        .mb-pc svg {
            color: var(--mb-soft);
            flex-shrink: 0;
        }

    .mb-ver {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 6px;
        background: #f1f5f9;
        font-size: 11px;
        font-weight: 600;
        color: var(--mb-ink2);
        font-family: 'IBM Plex Mono', monospace;
    }

    .mb-syncs {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 24px;
        padding: 0 8px;
        border-radius: 7px;
        background: #eff6ff;
        color: var(--mb-blue);
        font-size: 12px;
        font-weight: 700;
        font-family: 'IBM Plex Mono', monospace;
    }

    /* ─── MOBILE CARDS ─── */
    .mb-cards {
        display: none;
        flex-direction: column;
        gap: 12px;
    }

    .mb-mcard {
        background: var(--mb-card);
        border: 1px solid var(--mb-line);
        border-radius: var(--mb-rad);
        padding: 15px;
        border-left: 4px solid var(--mc-c, var(--mb-blue));
        box-shadow: 0 1px 3px rgba(15,23,42,.05);
    }

    .mb-mcard-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
    }

    .mb-mcard-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 14px;
    }

    .mb-mrow {
        min-width: 0;
    }

        .mb-mrow.full {
            grid-column: 1 / -1;
        }

    .mb-mlbl {
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--mb-soft);
        margin-bottom: 3px;
    }

    .mb-mval {
        font-size: 12px;
        color: var(--mb-ink2);
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ─── EMPTY / LOADING ─── */
    .mb-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--mb-muted);
    }

    .mb-empty-ico {
        width: 64px;
        height: 64px;
        margin: 0 auto 16px;
        border-radius: 18px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mb-blue);
    }

    .mb-empty-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--mb-ink2);
        margin-bottom: 5px;
    }

    .mb-empty-text {
        font-size: 12.5px;
    }

    .mb-skeleton {
        height: 58px;
        border-radius: var(--mb-rad-sm);
        background: linear-gradient(90deg, #eef2f9 25%, #f6f9ff 50%, #eef2f9 75%);
        background-size: 200% 100%;
        animation: mbShimmer 1.3s infinite;
        margin-bottom: 8px;
    }

    @@keyframes mbShimmer {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

    .mb-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 14px;
        font-size: 11.5px;
        color: var(--mb-muted);
    }

    /* ─── RESPONSIVE ─── */
    @@media (max-width: 900px) {
        .mb-wrap {
            padding: 16px 14px 32px;
        }

        .mb-table-card {
            display: none;
        }

        .mb-cards {
            display: flex;
        }

        .mb-title {
            font-size: 19px;
        }

        .mb-subtitle {
            margin-left: 0;
        }

        .mb-stat-num {
            font-size: 26px;
        }

        .mb-stats {
            flex-wrap: wrap;
        }

        .mb-stat {
            flex: 1 1 calc(33% - 1px);
            border-right: 1px solid var(--mb-line);
            border-bottom: 1px solid var(--mb-line);
        }
    }

    @@media (max-width: 520px) {
        .mb-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .mb-header-actions {
            width: 100%;
        }

        .mb-search {
            min-width: 100%;
        }
    }


    /* ─── PAGINAÇÃO ─── */
    .mb-pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .mb-pg-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border-radius: var(--mb-rad-sm);
        border: 1px solid var(--mb-line);
        background: var(--mb-card);
        color: var(--mb-ink2);
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: var(--mb-tr);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .mb-pg-btn:hover:not(:disabled) {
            border-color: var(--mb-blue);
            color: var(--mb-blue);
            background: #f5f9ff;
        }

        .mb-pg-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

        .mb-pg-btn.active {
            background: linear-gradient(135deg, var(--mb-blue), var(--mb-blue-d));
            color: #fff;
            border-color: transparent;
            box-shadow: 0 3px 8px rgba(37,99,235,.28);
        }

    .mb-pg-dots {
        color: var(--mb-soft);
        padding: 0 4px;
        font-weight: 700;
    }

    .mb-pg-info {
        font-size: 11.5px;
        color: var(--mb-muted);
        margin: 0 8px;
    }
</style>

<div class="mb-wrap">

    <!-- HEADER -->
    <div class="mb-header">
        <div class="mb-title-block">
            <div class="mb-title">
                <span class="mb-title-ico">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3" />
                        <path d="M21 5v14c0 1.66-4 3-9 3s-9-1.34-9-3V5" />
                        <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
                    </svg>
                </span>
                Monitor de Backups
            </div>
            <div class="mb-subtitle">Acompanhamento das sincronizações de backup de todos os clientes em tempo real</div>
        </div>

        <div class="mb-header-actions">
            <div class="mb-auto @(_autoRefresh ? "" : "off")" @onclick="ToggleAutoRefresh" title="Atualização automática">
                <span class="mb-auto-dot"></span>
                @(_autoRefresh ? "Auto-refresh ativo" : "Auto-refresh pausado")
            </div>
            <button class="mb-btn primary @(_carregando ? "spinning" : "")" @onclick="AtualizarAsync">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 4v6h-6" />
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                </svg>
                Atualizar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_erroDebug))
    {
        <div style="background:#fee2e2;color:#b91c1c;padding:12px;border-radius:10px;margin-bottom:16px;font-size:12px;">
            <strong>Erro:</strong> @_erroDebug
        </div>
    }

    <!-- STAT CARDS -->
    <div class="mb-stats">
        <div class="mb-stat @(_filtroStatus == null ? "active" : "")"
             style="--st-c:#2563eb; --st-bg:#eff6ff;"
             @onclick="() => FiltrarPorStatus(null)">
            <div class="mb-stat-top">
                <span class="mb-stat-lbl">Total</span>
                <span class="mb-stat-ico">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><path d="M18 17V9" /><path d="M13 17V5" /><path d="M8 17v-3" /></svg>
                </span>
            </div>
            <div class="mb-stat-num">@_todos.Count</div>
            <div class="mb-stat-sub">clientes monitorados</div>
        </div>

        <div class="mb-stat @(_filtroStatus == StatusBackup.EmCurso ? "active" : "")"
