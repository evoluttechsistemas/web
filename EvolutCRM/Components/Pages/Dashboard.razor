@code {

    private decimal MetaMensal = 10m;   // default igual ao WPF
    private decimal MetaAnual = 100m;
    private double[]? CrescimentoMoM;
    private double[]? CrescimentoAcumulado;
    private string[]? CrescimentoMesesLabel;
    private bool ModalTicketsUsuarioAberto = false;
    private string ModalTicketsUsuarioNome = "";
    private DateTime ModalTicketsUsuarioData;
    private List<TicketDetalheUsuarioDia> ModalTicketsUsuarioLista = new();

    private PesquisaSatisfacaoData? PesquisaData;
    private DateTime PesquisaDataInicial = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime PesquisaDataFinal = DateTime.Today;
    private bool CarregandoPesquisa = false;

    private async Task AbrirModalTicketsUsuario(string usuario, DateTime data)
    {
        ModalTicketsUsuarioNome = usuario;
        ModalTicketsUsuarioData = data;

        ModalTicketsUsuarioLista = await DashboardService.GetTicketsDetalheUsuarioDiaAsync(usuario, data);

        ModalTicketsUsuarioAberto = true;
    }

    private void FecharModalTicketsUsuario()
    {
        ModalTicketsUsuarioAberto = false;
        ModalTicketsUsuarioLista.Clear();
    }
    private DateTime TicketsUsuarioDataInicial = DateTime.Today;
    private DateTime TicketsUsuarioDataFinal = DateTime.Today;
    private DashboardData? Data;
    private SuporteDashboardData? SuporteData;

    private bool Carregando = true;
    private string AbaAtual = "comercial";
    private DateTime SuporteDataInicial = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime SuporteDataFinal = DateTime.Today;

    private string? ErroSuporte = null;

    protected override async Task OnInitializedAsync()
    {
        int tentativas = 0;
        while (!UserState.IsReady && tentativas < 100)
        {
            await Task.Delay(50);
            tentativas++;
        }

        if (!UserState.IsReady || UserState.CurrentCompanyId <= 0)
        {
            Console.WriteLine("❌ Dashboard: UserState ainda não carregado.");
            Carregando = false;
            return;
        }

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("aba", out var aba))
            AbaAtual = aba.ToString();

        // Comercial sempre carrega (KPIs rápidos)
        await CarregarDashboard();
        Carregando = false;
        StateHasChanged();

        if (AbaAtual == "suporte")
        {
            await CarregarSuporte();
            StateHasChanged(); // ← garante render após suporte carregar
        }
    }

    private async Task CarregarDashboard()
    {
        Carregando = true;

        try
        {
            Data = await DashboardService.GetDashboardDataAsync();

            var metas = await AdminService.ObterMetasPainelAsync();   // <<< AdminService, não DashboardService
            MetaMensal = metas.mensal;
            MetaAnual = metas.anual;

            await CalcularCrescimentoMensalAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ ERRO ao carregar dashboard: {ex.Message}");
        }
        finally
        {
            Carregando = false;
        }
    }

    private void AbrirCard(int codigo)
    {
        Nav.NavigateTo($"/card/{codigo}");
    }

