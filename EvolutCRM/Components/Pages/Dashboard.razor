    }

    // Replica CarregarGraficoColunas() do painel WPF: base = soma de vendas por mês,
    // crescimento MoM, e barras em "escada" acumulada (Math.Max(0, mom)).
    private async Task CalcularCrescimentoMensalAsync()
    {
        int ano = DateTime.Now.Year;

        // 1 query no lugar de 25
        var totais = await DashboardService.GetTotaisVendaAnosAsync(ano);

        double Get(int a, int m) =>
            totais.TryGetValue((a, m), out var v) ? v : 0;

        var valores = Enumerable.Range(1, 12)
            .Select(m => Get(ano, m))
            .ToArray();

        var mom = new double[12];
        for (int i = 0; i < 12; i++)
        {
            double atual = valores[i];
            double anterior = i == 0 ? Get(ano - 1, 12) : valores[i - 1];
            mom[i] = anterior > 0 ? ((atual - anterior) / anterior) * 100.0 : 0;
        }

        var acum = new double[12];
        double acumulado = 0;
        for (int i = 0; i < 12; i++)
        {
            acumulado += Math.Max(0, mom[i]);
            acum[i] = acumulado;
        }

        CrescimentoMoM = mom;
        CrescimentoAcumulado = acum;
        CrescimentoMesesLabel = Enumerable.Range(1, 12)
            .Select(m => new DateTime(ano, m, 1)
                .ToString("MMM", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")))
            .ToArray();

        // crescimento anual
        double totalAnoAtual = valores.Sum();
        double totalAnoAnterior = Enumerable.Range(1, 12).Sum(m => Get(ano - 1, m));

        CrescimentoAnual = totalAnoAnterior > 0
            ? ((totalAnoAtual / totalAnoAnterior) * 100.0) - 100.0
            : 0;
    }

    // Gráfico de crescimento mensal em "escada acumulada" (portado do painel WPF).
    // Altura da barra = acumulado; rótulo acima = MoM real do mês (pode ser negativo).
    private string CrescimentoChart()
    {
        if (CrescimentoMoM == null || CrescimentoAcumulado == null
            || CrescimentoMesesLabel == null || CrescimentoMoM.Length == 0)
            return "";

        int n = CrescimentoMoM.Length;
        double w = Math.Max(720, n * 78);
        double h = 460, padL = 24, padR = 24, padT = 40, padB = 46;
        double iw = w - padL - padR, ih = h - padT - padB;

        double maxV = CrescimentoAcumulado.Max();
        double minV = Math.Min(CrescimentoAcumulado.Min(), CrescimentoMoM.Min());
        double yMin = Math.Min(minV - 5, -2);
        double yMax = Math.Max(maxV + 5, 10);
        double span = (yMax - yMin) <= 0 ? 1 : (yMax - yMin);

        Func<double, double> Y = v => padT + ih - ((v - yMin) / span) * ih;
        double slot = iw / n;
        double bw = Math.Min(54, slot * 0.62);

        string[] grad = { "#0D47A1", "#1565C0", "#1E88E5", "#42A5F5", "#4FC3F7", "#80DEEA" };

        var sb = new System.Text.StringBuilder();
        sb.Append(LT + "svg class='cresc-svg' viewBox='0 0 " + F(w) + " " + F(h) + "' xmlns='http://www.w3.org/2000/svg'>");

        // gradiente de alta por barra + um gradiente de queda
        sb.Append(LT + "defs>");
        for (int i = 0; i < n; i++)
        {
            int idx = n == 1 ? 0 : (int)Math.Round(i / (double)(n - 1) * (grad.Length - 1));
            string c = grad[idx];
            sb.Append(LT + "linearGradient id='cb" + i + "' x1='0' y1='0' x2='0' y2='1'>");
            sb.Append(LT + "stop offset='0%' stop-color='" + c + "'/>");
            sb.Append(LT + "stop offset='100%' stop-color='" + c + "' stop-opacity='0.62'/>");
            sb.Append(LT + "/linearGradient>");
        }
        sb.Append(LT + "linearGradient id='cbdown' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append(LT + "stop offset='0%' stop-color='#fb6f70'/>");
        sb.Append(LT + "stop offset='100%' stop-color='#c62828' stop-opacity='0.62'/>");
        sb.Append(LT + "/linearGradient>");
        sb.Append(LT + "/defs>");

        // grid horizontal
        for (int g = 0; g <= 4; g++)
        {
            double val = yMin + span / 4 * g;
            double y = Y(val);
            sb.Append(LT + "line class='cg' x1='" + F(padL) + "' y1='" + F(y) + "' x2='" + F(w - padR) + "' y2='" + F(y) + "'/>");
        }

        // linha do zero
        double yZero = Y(0);
        sb.Append(LT + "line class='zero' x1='" + F(padL) + "' y1='" + F(yZero) + "' x2='" + F(w - padR) + "' y2='" + F(yZero) + "'/>");

        for (int i = 0; i < n; i++)
        {
            double cx = padL + slot * i + slot / 2;
            double bx = cx - bw / 2;
            double top = CrescimentoAcumulado[i];
            double yTop = Y(top);
            double barH = Math.Max(2, yZero - yTop);

            bool subiu = CrescimentoMoM[i] >= 0;
            string fill = subiu ? "url(#cb" + i + ")" : "url(#cbdown)";

            sb.Append(LT + "rect class='cresc-bar' x='" + F(bx) + "' y='" + F(yTop) + "' width='" + F(bw)
                + "' height='" + F(barH) + "' rx='7' fill='" + fill + "'>");
            sb.Append(LT + "title>" + CrescimentoMesesLabel[i] + ": " + CrescimentoMoM[i].ToString("0", Inv) + "% no mês"
                + " (acum. " + top.ToString("0", Inv) + "%)" + LT + "/title>");
            sb.Append(LT + "/rect>");

            // rótulo = MoM real do mês (igual ao WPF)
            double yLbl = yTop - 10;
            sb.Append(LT + "text class='vlabel' x='" + F(cx) + "' y='" + F(yLbl)
                + "' text-anchor='middle'>" + CrescimentoMoM[i].ToString("0", Inv) + "%" + LT + "/text>");

            // mês no eixo X
            sb.Append(LT + "text class='mlabel' x='" + F(cx) + "' y='" + F(h - 16)
                + "' text-anchor='middle'>" + CrescimentoMesesLabel[i] + LT + "/text>");
        }

        sb.Append(LT + "/svg>");
        return sb.ToString();
    }

