    // ====================================================================
    // HELPERS APENAS VISUAIS (SVG) - não tocam em dados nem em lógica.
    // As tags são construídas a partir da constante LT ("<") para que o
    // parser do Razor não interprete o conteúdo como markup.
    // ====================================================================
    private const string LT = "<";
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static string F(double v) => v.ToString("0.##", Inv);
    // Crescimento ANUAL (igual ao WPF): vendas do ano atual vs ano anterior.
    private double CrescimentoAnual;

    // Crescimento do MÊS ATUAL = MoM do mês corrente (Jan=índice 0).
    private double CrescimentoMesAtual =>
        (CrescimentoMoM != null && CrescimentoMoM.Length >= DateTime.Now.Month)
            ? CrescimentoMoM[DateTime.Now.Month - 1]
            : 0;

    // Resultado = crescimento − meta (idêntico ao WPF)
    private double ResultadoMensal => CrescimentoMesAtual - (double)MetaMensal;
    private double ResultadoAnual => CrescimentoAnual - (double)MetaAnual;

    // Série numérica a partir da evolução mensal (ordenada por mês)
    private List<double> EvoSerie(Func<EvolucaoMensal, int> sel)
    {
        if (Data?.EvolucaoMensal == null || !Data.EvolucaoMensal.Any())
            return new List<double>();

        return Data.EvolucaoMensal
            .OrderBy(m => DateTime.ParseExact(m.Mes, "MM/yyyy", null))
            .Select(m => (double)sel(m))
            .ToList();
    }

    // Mini gráfico de linha de fundo para os cards de KPI
    private string Sparkline(List<double> serie, string cor)
    {
        if (serie == null || serie.Count < 2) return "";

        double w = 200, h = 34;
        double max = serie.Max();
        double min = serie.Min();
        double range = max - min;
        if (range <= 0) range = 1;

        var pts = new List<string>();
        for (int i = 0; i < serie.Count; i++)
        {
            double x = serie.Count == 1 ? 0 : i / (double)(serie.Count - 1) * w;
            double y = h - ((serie[i] - min) / range) * (h - 6) - 3;
            pts.Add(F(x) + "," + F(y));
        }

        var line = string.Join(" ", pts);
        var area = "0," + F(h) + " " + line + " " + F(w) + "," + F(h);
        var gid = "sg" + Guid.NewGuid().ToString("N").Substring(0, 6);

        var sb = new System.Text.StringBuilder();
        sb.Append(LT + "svg class='spark' viewBox='0 0 " + F(w) + " " + F(h) + "' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>");
        sb.Append(LT + "defs>" + LT + "linearGradient id='" + gid + "' x1='0' y1='0' x2='0' y2='1'>");
        sb.Append(LT + "stop offset='0%' stop-color='" + cor + "' stop-opacity='0.35'/>");
        sb.Append(LT + "stop offset='100%' stop-color='" + cor + "' stop-opacity='0'/>");
        sb.Append(LT + "/linearGradient>" + LT + "/defs>");
        sb.Append(LT + "polygon points='" + area + "' fill='url(#" + gid + ")'/>");
        sb.Append(LT + "polyline points='" + line + "' fill='none' stroke='" + cor + "' stroke-width='1.6' stroke-linejoin='round' stroke-linecap='round'/>");
        sb.Append(LT + "/svg>");
        return sb.ToString();
    }

    private static readonly string[] DonutCores =
        { "#4aa8ff", "#34d399", "#fbbf24", "#fb6f70", "#b794f6", "#22d3ee", "#94a3b8", "#f472b6" };

    // Donut chart de distribuição por status (comercial)
    private string DonutStatus()
    {
        var itens = Data!.LeadsPorStatus.Take(6).ToList();
        var total = itens.Sum(s => s.Quantidade);
        if (total <= 0) return LT + "p style='color:var(--txt-mut);'>Sem dados." + LT + "/p>";

        double cx = 90, cy = 90, r = 70, sw = 22;
        double circ = 2 * Math.PI * r;
        double offset = 0;
        var segs = new System.Text.StringBuilder();

        for (int i = 0; i < itens.Count; i++)
        {
            double frac = (double)itens[i].Quantidade / total;
            double len = frac * circ;
            var cor = DonutCores[i % DonutCores.Length];
            segs.Append(LT + "circle cx='" + F(cx) + "' cy='" + F(cy) + "' r='" + F(r) + "' fill='none' stroke='" + cor + "' stroke-width='" + F(sw) + "' ");
            segs.Append("stroke-dasharray='" + F(len) + " " + F(circ - len) + "' stroke-dashoffset='" + F(-offset) + "' ");
            segs.Append("transform='rotate(-90 " + F(cx) + " " + F(cy) + ")' stroke-linecap='butt'/>");
            offset += len;
        }

        var legend = new System.Text.StringBuilder();
        for (int i = 0; i < itens.Count; i++)
        {
            var cor = DonutCores[i % DonutCores.Length];
            legend.Append(LT + "div class='dl-row'>");
            legend.Append(LT + "span class='dl-sw' style='background:" + cor + ";'>" + LT + "/span>");
            legend.Append(LT + "span class='dl-name'>" + System.Net.WebUtility.HtmlEncode(itens[i].Status) + LT + "/span>");
            legend.Append(LT + "span class='dl-q'>" + itens[i].Quantidade + LT + "/span>");
            legend.Append(LT + "span class='dl-p'>" + itens[i].Percentual + "%" + LT + "/span>");
            legend.Append(LT + "/div>");
        }

        var sb = new System.Text.StringBuilder();
        sb.Append(LT + "div class='donut-wrap'>");
        sb.Append(LT + "svg class='donut-svg' width='180' height='180' viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'>");
        sb.Append(LT + "circle cx='" + F(cx) + "' cy='" + F(cy) + "' r='" + F(r) + "' fill='none' stroke='rgba(255,255,255,0.05)' stroke-width='" + F(sw) + "'/>");
        sb.Append(segs.ToString());
        sb.Append(LT + "text class='donut-center' x='90' y='86' text-anchor='middle'>" + total + LT + "/text>");
        sb.Append(LT + "text class='donut-center-lbl' x='90' y='104' text-anchor='middle'>LEADS" + LT + "/text>");
        sb.Append(LT + "/svg>");
        sb.Append(LT + "div class='donut-legend'>" + legend.ToString() + LT + "/div>");
        sb.Append(LT + "/div>");
        return sb.ToString();
    }

    // Gráfico de área (criados x fechados) - evolução mensal comercial
    private string AreaChart()
    {
        var meses = Data!.EvolucaoMensal
            .OrderBy(m => DateTime.ParseExact(m.Mes, "MM/yyyy", null))
            .ToList();
        if (!meses.Any()) return "";

        double w = Math.Max(680, meses.Count * 64);
        double h = 280, padL = 36, padR = 16, padT = 18, padB = 34;
        double iw = w - padL - padR, ih = h - padT - padB;

        double max = Math.Max(1, meses.Max(m => Math.Max(m.LeadsCriados, m.LeadsFechados)));
        double step = Math.Max(1, Math.Ceiling(max / 4.0));
        double top = step * 4;

        Func<int, double> X = i => meses.Count == 1 ? padL + iw / 2 : padL + i / (double)(meses.Count - 1) * iw;
        Func<double, double> Y = v => padT + ih - (v / top) * ih;

        var grid = new System.Text.StringBuilder();
        for (int g = 0; g <= 4; g++)
        {
            double val = top / 4 * g;
            double y = Y(val);
            grid.Append(LT + "line class='gl' x1='" + F(padL) + "' y1='" + F(y) + "' x2='" + F(w - padR) + "' y2='" + F(y) + "'/>");
            grid.Append(LT + "text class='axl' x='" + F(padL - 8) + "' y='" + F(y + 3) + "' text-anchor='end'>" + F(val) + LT + "/text>");
        }

        Func<Func<EvolucaoMensal, int>, string, string, string> buildSeries = (sel, cor, gid) =>
        {
            var line = new System.Text.StringBuilder();
            var xs = new List<double>();
            var ys = new List<double>();
            for (int i = 0; i < meses.Count; i++)
            {
                double x = X(i), y = Y(sel(meses[i]));
                xs.Add(x); ys.Add(y);
                line.Append((i == 0 ? "M" : "L") + F(x) + " " + F(y) + " ");
            }
            var areaPath = line.ToString() + "L " + F(xs[xs.Count - 1]) + " " + F(padT + ih) + " L " + F(xs[0]) + " " + F(padT + ih) + " Z";

            var dots = new System.Text.StringBuilder();
            for (int i = 0; i < meses.Count; i++)
            {
                dots.Append(LT + "circle class='area-dot' cx='" + F(xs[i]) + "' cy='" + F(ys[i]) + "' r='3.2' fill='" + cor + "'>");
                dots.Append(LT + "title>" + meses[i].Mes + ": " + sel(meses[i]) + LT + "/title>" + LT + "/circle>");
            }

            var s = new System.Text.StringBuilder();
            s.Append(LT + "defs>" + LT + "linearGradient id='" + gid + "' x1='0' y1='0' x2='0' y2='1'>");
            s.Append(LT + "stop offset='0%' stop-color='" + cor + "' stop-opacity='0.28'/>");
            s.Append(LT + "stop offset='100%' stop-color='" + cor + "' stop-opacity='0'/>");
            s.Append(LT + "/linearGradient>" + LT + "/defs>");
            s.Append(LT + "path d='" + areaPath + "' fill='url(#" + gid + ")'/>");
            s.Append(LT + "path d='" + line.ToString().Trim() + "' fill='none' stroke='" + cor + "' stroke-width='2.4' stroke-linejoin='round' stroke-linecap='round'/>");
            s.Append(dots.ToString());
            return s.ToString();
        };

        var labels = new System.Text.StringBuilder();
        for (int i = 0; i < meses.Count; i++)
        {
            labels.Append(LT + "text class='axl' x='" + F(X(i)) + "' y='" + F(h - 10) + "' text-anchor='middle'>" + meses[i].Mes + LT + "/text>");
        }

        var sb = new System.Text.StringBuilder();
        sb.Append(LT + "svg class='area-svg' viewBox='0 0 " + F(w) + " " + F(h) + "' xmlns='http://www.w3.org/2000/svg'>");
        sb.Append(grid.ToString());
        sb.Append(buildSeries(m => m.LeadsCriados, "#4aa8ff", "ac"));
        sb.Append(buildSeries(m => m.LeadsFechados, "#34d399", "af"));
        sb.Append(labels.ToString());
        sb.Append(LT + "/svg>");
        return sb.ToString();
    }

    // Cor por índice para os cards de situação (suporte)
    private string CorSituacao(int idx)
    {
