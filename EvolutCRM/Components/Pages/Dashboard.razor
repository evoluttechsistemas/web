@page "/dashboard"
@using EvolutCRM.Models
@using EvolutCRM.Services
@inject DashboardService DashboardService
@inject NavigationManager Nav
@inject EvolutCRM.Services.UserState UserState
@using Microsoft.AspNetCore.WebUtilities
@inject AdminService AdminService

<style>
    .dx {
        --bg: #0b1220;
        --bg-soft: #0f1a2e;
        --panel: rgba(255, 255, 255, 0.035);
        --panel-2: rgba(255, 255, 255, 0.06);
        --stroke: rgba(255, 255, 255, 0.09);
        --stroke-soft: rgba(255, 255, 255, 0.05);
        --txt: #e8edf6;
        --txt-mut: #8a98b3;
        --txt-dim: #5d6b87;
        --accent: #38e1ff;
        --accent-2: #6c8cff;
        --c-blue: #4aa8ff;
        --c-green: #34d399;
        --c-amber: #fbbf24;
        --c-red: #fb6f70;
        --c-purple: #b794f6;
        --c-cyan: #22d3ee;
        --c-slate: #94a3b8;
        --glow: 0 0 0 1px var(--stroke), 0 18px 40px -18px rgba(0, 0, 0, 0.7);
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .dx {
        --grid-gap: 18px;
        font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        max-width: 1640px;
        margin: 0 auto;
        padding: 26px 26px 60px;
        color: var(--txt);
        background: radial-gradient(1100px 520px at 12% -10%, rgba(56, 225, 255, 0.10), transparent 60%), radial-gradient(900px 500px at 100% 0%, rgba(108, 140, 255, 0.10), transparent 55%), var(--bg);
        min-height: 100vh;
        overflow-x: hidden;
    }

        .dx ::selection {
            background: rgba(56, 225, 255, 0.3);
        }

    /* ---------- TOPBAR ---------- */
    .dx-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .dx-brand {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .dx-logo {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        flex: 0 0 auto;
        background: linear-gradient(140deg, var(--accent), var(--accent-2));
        display: grid;
        place-items: center;
        font-size: 22px;
        box-shadow: 0 10px 26px -8px rgba(56, 225, 255, 0.55);
    }

    .dx-title {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.05;
    }

    .dx-sub {
        font-size: 12.5px;
        color: var(--txt-mut);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 3px;
    }

    .dx-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--c-green);
        font-weight: 700;
        font-size: 11px;
    }

        .dx-live::before {
            content: '';
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--c-green);
            box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
            animation: pulse 1.8s infinite;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(52, 211, 153, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(52, 211, 153, 0);
        }
    }

    /* ---------- TABS (segmented) ---------- */
    .dx-tabs {
        display: inline-flex;
        padding: 5px;
        gap: 4px;
        background: var(--panel);
        border: 1px solid var(--stroke);
        border-radius: 14px;
        backdrop-filter: blur(8px);
    }

    .dx-tab {
        border: none;
        background: transparent;
        color: var(--txt-mut);
        font-weight: 700;
        font-size: 13.5px;
        cursor: pointer;
        padding: 10px 18px;
        border-radius: 10px;
        transition: .22s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.01em;
    }

        .dx-tab:hover {
            color: var(--txt);
        }

        .dx-tab.on {
            color: #06121f;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 8px 20px -8px rgba(56, 225, 255, 0.6);
        }

    /* ---------- SECTION LABEL ---------- */
    .dx-eyebrow {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--txt-dim);
        margin: 30px 0 16px;
    }

        .dx-eyebrow::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, var(--stroke), transparent);
        }

        .dx-eyebrow .tag {
            color: var(--accent);
            -webkit-text-fill-color: var(--accent);
        }

    /* ---------- KPI STRIP ---------- */
    .dx-kpis {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .dx-kpi {
        position: relative;
        overflow: hidden;
        background: var(--panel);
        border: 1px solid var(--stroke);
        border-radius: 16px;
        padding: 16px 16px 14px;
        transition: .25s ease;
    }

        .dx-kpi:hover {
            transform: translateY(-3px);
            border-color: var(--k, var(--accent));
            background: var(--panel-2);
        }

        .dx-kpi .spark {
            position: absolute;
            inset: auto 0 0 0;
            height: 34px;
            width: 100%;
            opacity: .5;
            pointer-events: none;
        }

    .dx-kpi-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 12px;
    }

    .dx-kpi-ic {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        font-size: 16px;
        background: color-mix(in srgb, var(--k, var(--accent)) 16%, transparent);
        border: 1px solid color-mix(in srgb, var(--k, var(--accent)) 35%, transparent);
    }

    .dx-kpi-lbl {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--txt-mut);
        text-align: right;
        line-height: 1.25;
    }

    .dx-kpi-val {
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
        position: relative;
        z-index: 1;
    }

    .dx-kpi-foot {
        margin-top: 9px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--txt-mut);
        display: flex;
        align-items: center;
        gap: 6px;
        position: relative;
        z-index: 1;
        line-height: 1.3;
    }

    .dx-chip {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-weight: 800;
        font-size: 11px;
        padding: 2px 7px;
        border-radius: 999px;
    }

        .dx-chip.up {
            color: var(--c-green);
            background: rgba(52,211,153,.13);
        }

        .dx-chip.down {
            color: var(--c-red);
            background: rgba(251,111,112,.13);
        }

        .dx-chip.flat {
            color: var(--c-slate);
            background: rgba(148,163,184,.13);
        }

    /* ---------- GRID / PANELS ---------- */
    .dx-grid {
        display: grid;
        gap: var(--grid-gap);
        grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .dx-panel {
        background: var(--panel);
        border: 1px solid var(--stroke);
        border-radius: 18px;
        padding: 22px;
        min-width: 0;
        transition: border-color .25s ease;
    }

        .dx-panel:hover {
            border-color: var(--stroke);
        }

    .span-4 {
        grid-column: span 4;
    }

    .span-5 {
        grid-column: span 5;
    }

    .span-6 {
        grid-column: span 6;
    }

    .span-7 {
        grid-column: span 7;
    }

    .span-8 {
        grid-column: span 8;
    }

    .span-12 {
        grid-column: span 12;
    }

    .dx-ph {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

        .dx-ph h3 {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: -0.015em;
            display: flex;
            align-items: center;
            gap: 9px;
        }

            .dx-ph h3 .dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: var(--accent);
                box-shadow: 0 0 10px var(--accent);
            }

        .dx-ph .hint {
            font-size: 11.5px;
            color: var(--txt-dim);
            font-weight: 600;
        }

    /* ---------- DONUT ---------- */
    .donut-wrap {
        display: flex;
        align-items: center;
        gap: 26px;
        flex-wrap: wrap;
    }

    .donut-svg {
        flex: 0 0 auto;
    }

    .donut-center {
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.03em;
        fill: var(--txt);
        font-variant-numeric: tabular-nums;
    }

    .donut-center-lbl {
        font-size: 10px;
        font-weight: 700;
        fill: var(--txt-dim);
        letter-spacing: 0.12em;
    }

    .donut-legend {
        flex: 1;
        min-width: 180px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .dl-row {
        display: grid;
        grid-template-columns: 14px 1fr auto auto;
        align-items: center;
        gap: 10px;
        font-size: 13px;
    }

    .dl-sw {
        width: 11px;
        height: 11px;
        border-radius: 3px;
    }

    .dl-name {
        font-weight: 600;
        color: var(--txt);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dl-q {
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    .dl-p {
        font-weight: 700;
        color: var(--txt-mut);
        font-variant-numeric: tabular-nums;
        min-width: 46px;
        text-align: right;
    }

    /* ---------- TEMP BARS ---------- */
    .tbars {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .tbar {
        display: grid;
        grid-template-columns: 120px 1fr 52px;
        align-items: center;
        gap: 14px;
    }

    .tbar-l {
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tbar-track {
        height: 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.05);
        overflow: hidden;
        position: relative;
    }

    .tbar-fill {
        height: 100%;
        border-radius: 999px;
        min-width: 6px;
        transition: width .9s cubic-bezier(.4,0,.2,1);
        box-shadow: 0 0 14px -2px currentColor;
    }

    .tbar-v {
        font-size: 13px;
        font-weight: 800;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    /* ---------- STACKED AREA / EVOLUTION ---------- */
    .area-host {
        position: relative;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .area-svg {
        display: block;
        width: 100%;
        min-width: 680px;
    }

        .area-svg .gl {
            stroke: var(--stroke-soft);
            stroke-width: 1;
        }

        .area-svg .axl {
            fill: var(--txt-dim);
            font-size: 10px;
            font-weight: 700;
        }

    .area-dot {
        transition: r .2s ease;
        cursor: pointer;
    }

        .area-dot:hover {
            r: 5;
        }

    .legend-inline {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid var(--stroke-soft);
    }

    .li {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--txt-mut);
    }

        .li .sw {
            width: 16px;
            height: 4px;
            border-radius: 4px;
        }

        .li b {
            color: var(--txt);
            font-variant-numeric: tabular-nums;
        }

    /* ---------- RANK LIST (users) ---------- */
    .rank {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rank-row {
        display: grid;
        grid-template-columns: 30px 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 11px 12px;
        border-radius: 12px;
        background: rgba(255,255,255,.025);
        border: 1px solid var(--stroke-soft);
        transition: .2s ease;
    }

        .rank-row:hover {
            background: rgba(255,255,255,.05);
            transform: translateX(3px);
            border-color: var(--stroke);
        }

    .rank-n {
        font-size: 13px;
        font-weight: 800;
        color: var(--txt-dim);
        font-variant-numeric: tabular-nums;
        text-align: center;
    }

    .rank-row.top1 .rank-n {
        color: var(--c-amber);
    }

    .rank-row.top2 .rank-n {
        color: var(--c-slate);
    }

    .rank-row.top3 .rank-n {
        color: #d6905a;
    }

    .rank-main {
        min-width: 0;
    }

    .rank-name {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rank-meta {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 11.5px;
        color: var(--txt-mut);
        font-weight: 600;
    }

        .rank-meta span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

    .rank-prog {
        height: 4px;
        border-radius: 4px;
        background: rgba(255,255,255,.06);
        margin-top: 7px;
        overflow: hidden;
    }

        .rank-prog i {
            display: block;
            height: 100%;
            border-radius: 4px;
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
        }

    .rank-val {
        font-size: 17px;
        font-weight: 800;
        color: var(--c-green);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

        .rank-val small {
            display: block;
            font-size: 10px;
            color: var(--txt-dim);
            font-weight: 700;
            letter-spacing: .08em;
        }

    /* ---------- MONTHLY MATRIX (table-like) ---------- */
    .mtx {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .mtx thead th {
            text-align: right;
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--txt-dim);
            padding: 0 12px 12px;
            border-bottom: 1px solid var(--stroke);
        }

            .mtx thead th:first-child {
                text-align: left;
            }

        .mtx tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid var(--stroke-soft);
            text-align: right;
            font-variant-numeric: tabular-nums;
            font-weight: 700;
        }

            .mtx tbody td:first-child {
                text-align: left;
                font-weight: 800;
            }

        .mtx tbody tr:hover {
            background: rgba(255,255,255,.03);
        }

        .mtx .mono {
            font-variant-numeric: tabular-nums;
        }

    .mtx-bar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        justify-content: flex-end;
    }

    .mtx-pill {
        font-size: 11px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 999px;
        display: inline-block;
        min-width: 54px;
        text-align: center;
    }

    .mtx-spark {
        display: inline-block;
        vertical-align: middle;
    }

    .cell-blue {
        color: var(--c-blue);
    }

    .cell-green {
        color: var(--c-green);
    }

    .cell-amber {
        color: var(--c-amber);
    }

    .cell-red {
        color: var(--c-red);
    }

    /* ---------- SUPPORT: filter ---------- */
    .dx-filter {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        background: var(--panel);
        border: 1px solid var(--stroke);
        border-radius: 14px;
        padding: 12px 14px;
        margin-bottom: 18px;
    }

    .ff {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .ff label {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--txt-dim);
        }

        .ff input {
            background: var(--bg-soft);
            color: var(--txt);
            border: 1px solid var(--stroke);
            border-radius: 9px;
            padding: 9px 11px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            color-scheme: dark;
            width: 150px;
        }

            .ff input:focus {
                outline: none;
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(56,225,255,.15);
            }

    .ff-btn {
        border: none;
        cursor: pointer;
        border-radius: 9px;
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 800;
        color: #06121f;
        font-family: inherit;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        box-shadow: 0 8px 20px -10px rgba(56,225,255,.7);
        transition: .2s ease;
    }

        .ff-btn:hover {
            filter: brightness(1.08);
            transform: translateY(-1px);
        }

    /* ---------- SUPPORT: day cards ---------- */
    .day-stack {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .day-card {
        border: 1px solid var(--stroke);
        border-radius: 14px;
        overflow: hidden;
        background: rgba(255,255,255,.02);
    }

    .day-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 16px;
        background: rgba(255,255,255,.03);
        border-bottom: 1px solid var(--stroke-soft);
    }

        .day-head strong {
            font-size: 13.5px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .day-head .day-total {
            font-size: 11.5px;
            color: var(--txt-mut);
            font-weight: 700;
        }

            .day-head .day-total b {
                color: var(--accent);
            }

    .day-users {
        display: grid;
        gap: 8px;
        grid-template-columns: repeat(auto-fill, minmax(195px, 1fr));
        padding: 14px 16px;
    }

    .du {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        background: var(--bg-soft);
        border: 1px solid var(--stroke-soft);
        border-radius: 10px;
        padding: 9px 12px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .18s ease;
    }

        .du:hover {
            border-color: var(--accent);
            background: rgba(56,225,255,.06);
            transform: translateY(-2px);
        }

        .du span {
            color: var(--txt);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .du strong {
            color: var(--accent);
            font-variant-numeric: tabular-nums;
            font-size: 14px;
            background: rgba(56,225,255,.12);
            border-radius: 7px;
            padding: 2px 9px;
            flex: 0 0 auto;
        }

    /* ---------- SUPPORT: situacao chips grid ---------- */
    .sit-grid {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    }

    .sit {
        position: relative;
        overflow: hidden;
        border-radius: 14px;
        padding: 16px;
        background: rgba(255,255,255,.025);
        border: 1px solid var(--stroke-soft);
        transition: .2s ease;
    }

        .sit:hover {
            transform: translateY(-3px);
            border-color: var(--sc, var(--accent));
        }

        .sit::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--sc, var(--accent));
        }

    .sit-v {
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .sit-l {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--txt-mut);
        margin: 7px 0 9px;
    }

    .sit-bar {
        height: 4px;
        border-radius: 4px;
        background: rgba(255,255,255,.07);
        overflow: hidden;
    }

        .sit-bar i {
            display: block;
            height: 100%;
            background: var(--sc, var(--accent));
            border-radius: 4px;
        }

    .sit-p {
        font-size: 11px;
        font-weight: 800;
        color: var(--sc, var(--accent));
        margin-top: 6px;
        display: inline-block;
    }

    /* ---------- SUPPORT: responsavel rows ---------- */
    .resp {
        display: flex;
        flex-direction: column;
        gap: 9px;
        max-height: 540px;
        overflow-y: auto;
        padding-right: 4px;
    }

        .resp::-webkit-scrollbar {
            width: 7px;
        }

        .resp::-webkit-scrollbar-track {
            background: transparent;
        }

        .resp::-webkit-scrollbar-thumb {
            background: var(--stroke);
            border-radius: 8px;
        }

    .resp-row {
        display: grid;
        grid-template-columns: 30px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 12px;
        background: rgba(255,255,255,.025);
        border: 1px solid var(--stroke-soft);
        transition: .2s ease;
    }

        .resp-row:hover {
            background: rgba(255,255,255,.05);
            border-color: var(--stroke);
        }

    .resp-n {
        font-size: 13px;
        font-weight: 800;
        color: var(--txt-dim);
        text-align: center;
    }

    .resp-name {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .resp-meta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 11px;
        color: var(--txt-mut);
        font-weight: 600;
    }

        .resp-meta span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

    .resp-side {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
    }

    .resp-badge {
        font-size: 11px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 999px;
        white-space: nowrap;
    }

        .resp-badge.has {
            color: var(--c-red);
            background: rgba(251,111,112,.14);
        }

        .resp-badge.zero {
            color: var(--c-green);
            background: rgba(52,211,153,.14);
        }

    .resp-time {
        font-size: 13px;
        font-weight: 800;
        color: var(--accent);
        white-space: nowrap;
    }

        .resp-time small {
            display: block;
            font-size: 9.5px;
            color: var(--txt-dim);
            font-weight: 700;
            letter-spacing: .08em;
            text-align: right;
        }

    /* ---------- loading / empty ---------- */
    .dx-load {
        display: grid;
        place-items: center;
        min-height: 60vh;
        gap: 18px;
    }

    .dx-spin {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        border: 4px solid var(--stroke);
        border-top-color: var(--accent);
        animation: spin 0.9s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .dx-load p {
        color: var(--txt-mut);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: .02em;
    }

    .dx-empty {
        text-align: center;
        padding: 64px 28px;
        border-radius: 18px;
        background: var(--panel);
        border: 1px dashed var(--stroke);
    }

        .dx-empty .ico {
            font-size: 40px;
            margin-bottom: 14px;
        }

        .dx-empty h3 {
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .dx-empty p {
            color: var(--txt-mut);
            font-size: 13.5px;
        }

    /* ---------- MODAL ---------- */
    .mb {
        position: fixed;
        inset: 0;
        z-index: 9999;
        padding: 22px;
        background: rgba(5, 10, 20, 0.72);
        backdrop-filter: blur(4px);
        display: grid;
        place-items: center;
        animation: fade .2s ease;
    }

    @@keyframes fade {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .mw {
        width: min(840px, 100%);
        max-height: 86vh;
        overflow: hidden;
        background: #1a2744;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 20px;
        box-shadow: 0 30px 80px -20px rgba(0,0,0,.8);
        display: flex;
        flex-direction: column;
    }

    .mh {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255,255,255,.15);
        background: #1e2e50;
        border-radius: 20px 20px 0 0;
    }

        .mh h3 {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.01em;
            color: #e8edf6;
        }

        .mh .msub {
            font-size: 12.5px;
            color: #a0b0cc;
            font-weight: 600;
            margin-top: 3px;
        }

        .mh h3 {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        .mh .msub {
            font-size: 12.5px;
            color: var(--txt-mut);
            font-weight: 600;
            margin-top: 3px;
        }

        .mh button {
            border: none;
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: rgba(251,111,112,.14);
            color: var(--c-red);
            font-weight: 800;
            font-size: 15px;
            transition: .18s ease;
        }

            .mh button:hover {
                background: rgba(251,111,112,.24);
            }

    .mbody {
        padding: 16px 24px 22px;
        overflow-y: auto;
        background: #1a2744;
    }

        .mbody::-webkit-scrollbar {
            width: 8px;
        }

        .mbody::-webkit-scrollbar-thumb {
            background: var(--stroke);
            border-radius: 8px;
        }

    .mt {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        margin-bottom: 10px;
        border-radius: 13px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.13);
        cursor: pointer;
        transition: .18s ease;
    }

        .mt:hover {
            border-color: var(--accent);
            background: rgba(56,225,255,.12);
            transform: translateX(4px);
        }

    .mt-l {
        min-width: 0;
    }

        .mt-l strong {
            display: block;
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 4px;
            color: #e8edf6;
        }

        .mt-l span {
            display: block;
            font-size: 12.5px;
            color: #a0b0cc;
            font-weight: 600;
        }

    .mt-r {
        text-align: right;
        flex: 0 0 auto;
    }

        .mt-r .st {
            display: inline-block;
            font-size: 11px;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 999px;
            background: rgba(108,140,255,.28);
            color: #a8c0ff;
            margin-bottom: 5px;
        }

        .mt-r small {
            display: block;
            font-size: 12px;
            color: var(--accent);
            font-weight: 800;
        }

    .m-empty {
        text-align: center;
        color: var(--txt-mut);
        padding: 40px;
        font-weight: 600;
    }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 1280px) {
        .dx-kpis {
            grid-template-columns: repeat(3, minmax(0,1fr));
        }

        .span-4, .span-5, .span-6, .span-7, .span-8 {
            grid-column: span 12;
        }
    }

    @@media (max-width: 760px) {
        .dx {
            padding: 18px 14px 48px;
        }

        .dx-kpis {
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 10px;
        }

        .dx-kpi-val {
            font-size: 27px;
        }

        .dx-title {
            font-size: 19px;
        }

        .dx-panel {
            padding: 16px;
        }

        .donut-wrap {
            gap: 16px;
            justify-content: center;
        }

        .tbar {
            grid-template-columns: 84px 1fr 44px;
            gap: 9px;
        }

        .tbar-l {
            font-size: 12px;
        }

        .mtx {
            font-size: 12px;
        }

            .mtx thead th, .mtx tbody td {
                padding: 8px 7px;
            }

        .mtx-spark {
            display: none;
        }

        .day-users {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 420px) {
        .dx-kpis {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Crescimento mensal (gráfico portado do WPF) ===== */
    .cresc-panel {
        background: linear-gradient(180deg, rgba(13,71,161,.14), rgba(15,26,46,.0)), var(--panel);
    }

    .cresc-loading {
        padding: 60px;
        text-align: center;
        color: var(--txt-mut);
        font-weight: 700;
    }

    .cresc-host {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .cresc-svg {
        display: block;
        width: 100%;
        min-width: 720px;
    }

        .cresc-svg .cg {
            stroke: var(--stroke-soft);
            stroke-width: 1;
        }

        .cresc-svg .zero {
            stroke: rgba(255,255,255,.22);
            stroke-width: 1.4;
            stroke-dasharray: 4 4;
        }

        .cresc-svg .mlabel {
            fill: var(--txt-mut);
            font-size: 12px;
            font-weight: 700;
        }

        .cresc-svg .vlabel {
            fill: #fff;
            font-size: 14px;
            font-weight: 800;
        }

    .cresc-bar {
        transition: opacity .2s ease;
        cursor: default;
    }

        .cresc-bar:hover {
            opacity: .85;
        }

    .cresc-legend {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid var(--stroke-soft);
        font-size: 12.5px;
        font-weight: 700;
        color: var(--txt-mut);
    }

        .cresc-legend span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .cresc-legend .lo {
            width: 14px;
            height: 14px;
            border-radius: 4px;
            display: inline-block;
        }

        .cresc-legend .lo-up {
            background: linear-gradient(180deg,#42a5f5,#1565c0);
        }

        .cresc-legend .lo-down {
            background: linear-gradient(180deg,#fb6f70,#c62828);
        }

        .cresc-legend .cresc-acum {
            margin-left: auto;
            color: var(--txt-dim);
            font-weight: 600;
        }

    @@media (max-width: 760px) {
        .cresc-legend .cresc-acum {
            margin-left: 0;
            width: 100%;
        }
    }

    .cresc-meta {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 12px;
        margin-top: 16px;
    }

    .cresc-meta-item {
        background: rgba(255,255,255,.03);
        border: 1px solid var(--stroke-soft);
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .cresc-meta-item .cml {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: var(--txt-dim);
        }

        .cresc-meta-item .cmv {
            font-size: 22px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            line-height: 1;
        }

    @@media (max-width: 1280px) {
        .cresc-meta {
            grid-template-columns: repeat(3, minmax(0,1fr));
        }
    }

    @@media (max-width: 760px) {
        .cresc-meta {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }
    }


    /* ===== PESQUISA DE SATISFAÇÃO ===== */
    .pesq-kpis {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        margin-bottom: 18px;
    }

    .pesq-nota-stars {
        font-size: 15px;
        font-weight: 800;
    }

    @@media (max-width: 1280px) {
        .pesq-kpis {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 760px) {
        .pesq-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<div class="dx">

    <!-- ============ TOPBAR ============ -->
    <div class="dx-top">
        <div class="dx-brand">
            <div class="dx-logo">📊</div>
            <div>
                <div class="dx-title">Dashboard CRM</div>
                <div class="dx-sub">
                    Pipeline comercial &amp; suporte
                    <span class="dx-live">ao vivo</span>
                </div>
            </div>
        </div>

        <div class="dx-tabs">
            <button class="dx-tab @(AbaAtual == "comercial" ? "on" : "")"
                    @onclick='() => TrocarAba("comercial")'>
                💼 Comercial
            </button>
            <button class="dx-tab @(AbaAtual == "suporte" ? "on" : "")"
                    @onclick='() => TrocarAba("suporte")'>
                🎧 Suporte
            </button>
        </div>
    </div>

    @if (Carregando)
    {
        <div class="dx-load">
            <div class="dx-spin"></div>
            <p>Carregando dados...</p>
        </div>
    }
    else if (AbaAtual == "comercial")
    {
        @if (Data == null || Data.KPIs == null)
        {
            <div class="dx-empty">
                <div class="ico">⚠️</div>
                <h3>Nenhum dado disponível</h3>
                <p>Não foi possível carregar as informações do dashboard comercial.</p>
            </div>
        }
        else
        {
            <!-- ===== CRESCIMENTO MENSAL (portado do painel WPF) ===== -->
            <div class="dx-eyebrow"><span class="tag">★</span> Crescimento mensal</div>

            <div class="dx-grid">
                <div class="dx-panel span-12 cresc-panel">
                    <div class="dx-ph">
                        <h3><span class="dot"></span> Crescimento mensal (%)</h3>
                        <span class="hint">variação mês a mês · escada acumulada</span>
                    </div>

                    @if (CrescimentoMoM == null)
                    {
                        <div class="cresc-loading">Calculando crescimento...</div>
                    }
                    else
                    {
                        @((MarkupString)CrescimentoChart())
                    }

                    <div class="cresc-meta">
                        <div class="cresc-meta-item">
                            <span class="cml">Crescimento (mês)</span>
                            <span class="cmv">@CrescimentoMesAtual.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%</span>
                        </div>
                        <div class="cresc-meta-item">
                            <span class="cml">Meta mensal</span>
                            <span class="cmv">@MetaMensal.ToString("0")%</span>
                        </div>
                        <div class="cresc-meta-item">
                            <span class="cml">Resultado mensal</span>
                            <span class="cmv" style="color:@(ResultadoMensal < 0 ? "var(--c-red)" : "var(--c-green)");">
                                @ResultadoMensal.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%
                            </span>
                        </div>
                        <div class="cresc-meta-item">
                            <span class="cml">Crescimento anual</span>
                            <span class="cmv">@CrescimentoAnual.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%</span>
                        </div>
                        <div class="cresc-meta-item">
                            <span class="cml">Meta anual</span>
                            <span class="cmv">@MetaAnual.ToString("0")%</span>
                        </div>
                        <div class="cresc-meta-item">
                            <span class="cml">Resultado anual</span>
                            <span class="cmv" style="color:@(ResultadoAnual < 0 ? "var(--c-red)" : "var(--c-green)");">
                                @ResultadoAnual.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%
                            </span>
                        </div>
                    </div>

                    <div class="cresc-legend">
                        <span><i class="lo lo-down"></i> queda no mês</span>
                        <span><i class="lo lo-up"></i> alta no mês</span>
                    </div>
                </div>
            </div>

            <!-- ===== KPI STRIP ===== -->
            <div class="dx-eyebrow"><span class="tag">01</span> Métricas principais</div>

            <div class="dx-kpis">
                <div class="dx-kpi" style="--k: var(--c-blue);">
                    <div class="dx-kpi-head">
                        <div class="dx-kpi-ic">📊</div>
                        <div class="dx-kpi-lbl">Total<br />de leads</div>
                    </div>
                    <div class="dx-kpi-val">@Data.KPIs.TotalLeads</div>
                    <div class="dx-kpi-foot">@Data.KPIs.LeadsEsteMe novos este mês</div>
                    @((MarkupString)Sparkline(EvoSerie(m => m.LeadsCriados), "var(--c-blue)"))
                </div>

                <div class="dx-kpi" style="--k: var(--c-green);">
                    <div class="dx-kpi-head">
                        <div class="dx-kpi-ic">✅</div>
                        <div class="dx-kpi-lbl">Leads<br />fechados</div>
                    </div>
                    <div class="dx-kpi-val">@Data.KPIs.LeadsFechados</div>
                    <div class="dx-kpi-foot">
                        <span class="dx-chip up">@Data.KPIs.TaxaConversao%</span> conversão
                    </div>
                    @((MarkupString)Sparkline(EvoSerie(m => m.LeadsFechados), "var(--c-green)"))
                </div>

                <div class="dx-kpi" style="--k: var(--c-amber);">
                    <div class="dx-kpi-head">
                        <div class="dx-kpi-ic">🔄</div>
                        <div class="dx-kpi-lbl">Leads<br />abertos</div>
                    </div>
                    <div class="dx-kpi-val">@Data.KPIs.LeadsAbertos</div>
                    <div class="dx-kpi-foot">Em andamento</div>
                </div>

                <div class="dx-kpi" style="--k: var(--c-red);">
                    <div class="dx-kpi-head">
                        <div class="dx-kpi-ic">❌</div>
                        <div class="dx-kpi-lbl">Leads<br />perdidos</div>
                    </div>
                    <div class="dx-kpi-val">@Data.KPIs.LeadsPerdidos</div>
                    <div class="dx-kpi-foot">Requer atenção</div>
                </div>

                <div class="dx-kpi" style="--k: var(--c-purple);">
                    <div class="dx-kpi-head">
                        <div class="dx-kpi-ic">📅</div>
                        <div class="dx-kpi-lbl">Este<br />mês</div>
                    </div>
                    <div class="dx-kpi-val">@Data.KPIs.LeadsEsteMe</div>
                    <div class="dx-kpi-foot">
                        @{
                            var cm = Data.KPIs.CrescimentoMensal;
                            var cls = cm > 0 ? "up" : (cm < 0 ? "down" : "flat");
                            var arr = cm > 0 ? "↑" : (cm < 0 ? "↓" : "→");
                        }
                        <span class="dx-chip @cls">@arr @Math.Abs(cm)%</span> vs mês anterior
                    </div>
                </div>

                <div class="dx-kpi" style="--k: var(--c-cyan);">
                    <div class="dx-kpi-head">
                        <div class="dx-kpi-ic">🎯</div>
                        <div class="dx-kpi-lbl">Taxa<br />conversão</div>
                    </div>
                    <div class="dx-kpi-val">@Data.KPIs.TaxaConversao<span style="font-size:18px;color:var(--txt-mut);">%</span></div>
                    <div class="dx-kpi-foot">Performance geral</div>
                </div>
            </div>

            <!-- ===== ANALYSES ===== -->
            <div class="dx-eyebrow"><span class="tag">02</span> Análises detalhadas</div>

            <div class="dx-grid">

                @if (Data.LeadsPorStatus?.Any() == true)
                {
                    <div class="dx-panel span-5">
                        <div class="dx-ph">
                            <h3><span class="dot"></span> Distribuição por status</h3>
                            <span class="hint">@Data.LeadsPorStatus.Sum(s => s.Quantidade) leads</span>
                        </div>
                        @((MarkupString)DonutStatus())
                    </div>
                }

                @if (Data.LeadsPorTemperatura?.Any() == true)
                {
                    <div class="dx-panel span-7">
                        <div class="dx-ph">
                            <h3><span class="dot" style="background:var(--c-amber);box-shadow:0 0 10px var(--c-amber);"></span> Temperatura dos leads</h3>
                            <span class="hint">classificação do funil</span>
                        </div>
                        <div class="tbars">
                            @{
                                var maxTemp = Data.LeadsPorTemperatura.Max(t => t.Quantidade);
                            }
                            @foreach (var temp in Data.LeadsPorTemperatura)
                            {
                                var w = maxTemp > 0 ? (double)temp.Quantidade / maxTemp * 100 : 0;
                                <div class="tbar">
                                    <div class="tbar-l">
                                        @ObterIconeTemperatura(temp.Temperatura) @temp.Temperatura
                                    </div>
                                    <div class="tbar-track">
                                        <div class="tbar-fill" style="width:@w.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;background:@temp.Cor;color:@temp.Cor;"></div>
                                    </div>
                                    <div class="tbar-v">@temp.Quantidade</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Data.EvolucaoMensal?.Any() == true)
                {
                    <div class="dx-panel span-8">
                        <div class="dx-ph">
                            <h3><span class="dot" style="background:var(--c-green);box-shadow:0 0 10px var(--c-green);"></span> Evolução mensal</h3>
                            <span class="hint">últimos @Data.EvolucaoMensal.Count meses</span>
                        </div>
                        <div class="area-host">
                            @((MarkupString)AreaChart())
                        </div>
                        <div class="legend-inline">
                            <div class="li"><span class="sw" style="background:var(--c-blue);"></span> Criados <b>@Data.EvolucaoMensal.Sum(m => m.LeadsCriados)</b></div>
                            <div class="li"><span class="sw" style="background:var(--c-green);"></span> Fechados <b>@Data.EvolucaoMensal.Sum(m => m.LeadsFechados)</b></div>
                        </div>
                    </div>
                }

                @if (Data.TopUsuarios?.Any() == true)
                {
                    <div class="dx-panel span-4">
                        <div class="dx-ph">
                            <h3><span class="dot" style="background:var(--c-amber);box-shadow:0 0 10px var(--c-amber);"></span> Top usuários</h3>
                        </div>
                        <div class="rank">
                            @{
                                var rank = 1; var maxFech = Data.TopUsuarios.Take(5).Max(u => u.LeadsAtivos);
                            }
                            @foreach (var user in Data.TopUsuarios.Take(5))
                            {
                                var prog = maxFech > 0 ? (double)user.LeadsAtivos / maxFech * 100 : 0;
                                <div class="rank-row @(rank <= 3 ? "top" + rank : "")">
                                    <div class="rank-n">@rank</div>
                                    <div class="rank-main">
                                        <div class="rank-name">@user.Usuario</div>
                                        <div class="rank-meta">
                                            <span>📊 @user.LeadsAtivos</span>
                                            <span>✅ @user.LeadsFechados</span>
                                        </div>
                                        <div class="rank-prog"><i style="width:@prog.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></i></div>
                                    </div>
