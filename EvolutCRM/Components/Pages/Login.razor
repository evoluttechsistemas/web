@page "/"
@inject EvolutCRM.Services.LoginService LoginService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using EvolutCRM.Components.Layout
@layout LoginLayout
@inject EvolutCRM.Services.AdminService AdminService
@inject EvolutCRM.Services.UserState UserState
@inject EvolutCRM.Services.LogAcessoService LogAcessoService
@inject EvolutCRM.Services.CadastroUsuarioService CadastroUsuarioService
@inject EvolutCRM.Services.EmailService EmailService

<style>
    :root {
        --login-primary: #0d47a1;
        --login-primary-2: #1976d2;
        --login-accent: #0f766e;
        --login-bg: #f4f8fc;
        --login-card: #ffffff;
        --login-text: #172033;
        --login-muted: #64748b;
        --login-border: #d7e6f7;
        --login-field: #f8fbff;
        --login-danger-bg: #fee2e2;
        --login-danger-text: #991b1b;
        --login-shadow: 0 24px 60px rgba(13, 71, 161, .22);
    }

    body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, sans-serif;
    }

    .login-page {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: linear-gradient(135deg, rgba(15, 118, 110, .18), transparent 34%), linear-gradient(160deg, #0b2f6b 0%, #0d47a1 48%, #1976d2 100%);
    }

    .login-card {
        width: min(980px, 100%);
        min-height: 520px;
        display: grid;
        grid-template-columns: minmax(300px, .92fr) minmax(360px, 1.08fr);
        background: var(--login-card);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: var(--login-shadow);
        border: 1px solid rgba(255,255,255,.28);
        animation: loginEnter .45s ease both;
    }

    .login-brand {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 34px;
        color: #fff;
        background: linear-gradient(145deg, rgba(13, 71, 161, .96), rgba(15, 118, 110, .92)), url("images/logo-evoluttech.png");
        background-size: cover;
        background-position: center;
        isolation: isolate;
    }

        .login-brand::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(3, 20, 48, .54);
            z-index: -1;
        }

    .login-brand-logo-box {
        width: 210px;
        max-width: 82%;
        padding: 18px;
        border-radius: 18px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 14px 34px rgba(0,0,0,.24);
    }

    .login-logo {
        width: 100%;
        display: block;
        object-fit: contain;
    }

    .login-brand-copy {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .login-brand-copy strong {
            font-size: 1.28rem;
            line-height: 1.15;
            font-weight: 950;
            letter-spacing: 0;
        }

        .login-brand-copy span {
            max-width: 300px;
            font-size: .88rem;
            line-height: 1.45;
            color: rgba(255,255,255,.86);
            font-weight: 650;
        }

    .login-panel {
        padding: 46px 52px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }

    .login-panel-header {
        margin-bottom: 24px;
    }

    .login-kicker {
        margin: 0 0 7px;
        color: var(--login-accent);
        font-size: .74rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .login-title {
        margin: 0;
        color: var(--login-text);
        font-size: 1.82rem;
        line-height: 1.1;
        font-weight: 950;
        letter-spacing: 0;
    }

    .login-subtitle {
        margin: 8px 0 0;
        color: var(--login-muted);
        font-size: .92rem;
        line-height: 1.45;
        font-weight: 650;
    }

    .login-alert {
        margin-bottom: 16px;
        padding: 11px 12px;
        border-radius: 12px;
        background: var(--login-danger-bg);
        color: var(--login-danger-text);
        border: 1px solid #fecaca;
        font-size: .86rem;
        font-weight: 850;
    }

    .login-form {
        display: grid;
        gap: 14px;
    }

    .login-field {
        display: grid;
        gap: 6px;
    }

        .login-field label {
            color: var(--login-primary);
            font-size: .78rem;
            font-weight: 900;
        }

        .login-field input {
            width: 100%;
            height: 46px;
            box-sizing: border-box;
            border: 1px solid var(--login-border);
            border-radius: 12px;
            padding: 0 13px;
            background: var(--login-field);
            color: var(--login-text);
            font-size: .94rem;
            font-weight: 650;
            outline: none;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }

            .login-field input:focus {
                border-color: var(--login-primary-2);
                background: #fff;
                box-shadow: 0 0 0 4px rgba(25, 118, 210, .14);
            }

    .login-submit {
        height: 48px;
        margin-top: 6px;
        border: none;
        border-radius: 13px;
        background: linear-gradient(135deg, var(--login-accent), var(--login-primary));
        color: #fff;
        font-size: .96rem;
        font-weight: 950;
        cursor: pointer;
        box-shadow: 0 14px 28px rgba(13, 71, 161, .24);
        transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
    }

        .login-submit:hover:not(:disabled) {
            transform: translateY(-1px);
            filter: brightness(1.04);
            box-shadow: 0 18px 34px rgba(13, 71, 161, .30);
        }

        .login-submit:disabled {
            cursor: wait;
            opacity: .74;
        }

    .login-link {
        background: none;
        border: none;
        color: var(--login-primary-2);
        font-size: .82rem;
        font-weight: 850;
        cursor: pointer;
        text-align: center;
    }

    .login-footnote {
        margin-top: 18px;
        color: var(--login-muted);
        font-size: .76rem;
        font-weight: 650;
        text-align: center;
    }

    .lembrar-box {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .82rem;
        font-weight: 750;
        color: var(--login-muted);
        cursor: pointer;
    }

        .lembrar-box input[type=checkbox] {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            accent-color: var(--login-primary);
            cursor: pointer;
        }

    @@keyframes loginEnter {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 820px) {
        .login-page {
            padding: 16px;
            align-items: start;
        }

        .login-card {
            grid-template-columns: 1fr;
            min-height: unset;
        }

        .login-brand {
            min-height: 230px;
            padding: 26px;
        }

        .login-brand-logo-box {
            width: 180px;
        }

        .login-panel {
            padding: 30px 24px;
        }

        .login-title {
            font-size: 1.52rem;
        }
    }

    @@media (max-width: 460px) {
        .login-page {
            padding: 0;
            background: #f8fbff;
        }

        .login-card {
            min-height: 100vh;
            border-radius: 0;
            box-shadow: none;
        }

        .login-brand {
            min-height: 190px;
            border-radius: 0;
        }

        .login-panel {
            padding: 26px 18px;
        }
    }
</style>

<div class="login-page">
    <section class="login-card">
        <aside class="login-brand">
            <div class="login-brand-logo-box">
                <img src="images/logo-evoluttech.png" alt="EvolutTech" class="login-logo" />
            </div>

            <div class="login-brand-copy">
                <strong>EvolutTech HELP</strong>
                <span>Ambiente seguro para atendimento e gestão operacional.</span>
            </div>
        </aside>

        <main class="login-panel">
            <div class="login-panel-header">
                <p class="login-kicker">Acesso ao sistema</p>
                <h1 class="login-title">Entrar no HELP</h1>
                <p class="login-subtitle">Informe seu usuário e senha para continuar.</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="login-alert">@ErrorMessage</div>
            }

            @if (!Etapa2FA)
            {
                <div class="login-form">
                    <div class="login-field">
                        <label for="usuario">Usuário</label>
                        <input id="usuario"
                               autocomplete="username"
                               @bind="usuario"
                               disabled="@Entrando" />
                    </div>

                    <div class="login-field">
                        <label for="senha">Senha</label>
                        <input id="senha"
                               type="password"
                               autocomplete="current-password"
                               @bind="senha"
                               disabled="@Entrando" />
                    </div>

                    <button type="button"
                            class="login-submit"
                            disabled="@Entrando"
                            @onclick="HandleLogin">
                        @(Entrando ? "Entrando..." : "Entrar")
                    </button>
                </div>
            }

            @if (Etapa2FA)
            {
                <div class="login-form">
                    <div class="login-field">
                        <label for="codigo2fa">Código de verificação</label>
                        <input id="codigo2fa"
                               type="text"
                               inputmode="numeric"
                               maxlength="6"
                               placeholder="000000"
                               value="@codigo2FA"
                               @oninput="e => codigo2FA = e.Value?.ToString() ?? string.Empty"
                               disabled="@Entrando" />
                        <span style="font-size:.76rem;color:#64748b;font-weight:650;">
                            Enviamos um código de 6 dígitos para o seu e-mail.
                        </span>
                    </div>

                    <label class="lembrar-box">
                        <input type="checkbox" @bind="lembrarDispositivo" disabled="@Entrando" />
                        Lembrar este dispositivo por 15 dias
                    </label>

                    <button type="button"
                            class="login-submit"
                            disabled="@Entrando"
                            @onclick="HandleVerificar2FA">
                        @(Entrando ? "Verificando..." : "Confirmar código")
                    </button>

                    <button type="button"
                            class="login-link"
                            disabled="@Entrando"
                            @onclick="VoltarLogin">
                        Voltar ao login
                    </button>
                </div>
            }

            <div class="login-footnote">
                EvolutTech
            </div>
        </main>
    </section>
</div>

@code {
    private bool lembrarDispositivo = false;
    private bool Etapa2FA = false;
    private string codigo2FA = "";
    private string emailUsuario = "";
    private string usuario = "";
    private string senha = "";
    private string ErrorMessage = "";
    private bool Entrando = false;

    private int empresaCodigo = 0;
    private string empresaNome = "";

    private async Task HandleLogin()
    {
        if (Entrando) return;
        ErrorMessage = "";

        var usuarioLogin = usuario.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(usuarioLogin))
        {
            ErrorMessage = "Informe o usuário.";
            return;
        }

        if (string.IsNullOrWhiteSpace(senha))
        {
            ErrorMessage = "Informe a senha.";
            return;
        }

        try
        {
            Entrando = true;

            var empresa = await CadastroUsuarioService.BuscarEmpresaDoUsuarioAsync(usuarioLogin);
            if (empresa is null)
            {
                ErrorMessage = "Usuário ou senha incorretos.";
                return;
            }

            empresaCodigo = empresa.Codigo;
            empresaNome = empresa.NomeReduzido;

            var resultado = await CadastroUsuarioService.ValidarLoginAsync(
                usuarioLogin, senha, empresaCodigo.ToString());

            if (!resultado.Sucesso)
            {
                if (DeveReenviarVerificacaoEmail(resultado.Mensagem))
                {
                    var reenvio = await CadastroUsuarioService.ReenviarEmailVerificacaoAsync(
                        usuarioLogin,
                        empresaCodigo.ToString());

                    ErrorMessage = reenvio.Sucesso
                        ? "Seu e-mail ainda não foi verificado. Enviamos um novo link de verificação para o e-mail cadastrado. Verifique também a caixa de spam."
                        : $"Seu e-mail ainda não foi verificado, mas não foi possível reenviar o link agora: {reenvio.Mensagem}";

                    return;
                }

                ErrorMessage = resultado.Mensagem;
                return;
            }

            usuario = usuarioLogin;

            if (resultado.Requer2FA)
            {
                if (await DispositivoLembradoValidoAsync(usuarioLogin, empresaCodigo))
                {
                    await ConcluirLoginAsync();
                    return;
                }

                emailUsuario = resultado.Email;
                await CadastroUsuarioService.GerarEEnviar2FAAsync(
                    usuarioLogin, emailUsuario, empresaCodigo.ToString());

                Etapa2FA = true;
                return;
            }

            await ConcluirLoginAsync();
        }
        finally
        {
            Entrando = false;
        }
    }

    private static bool DeveReenviarVerificacaoEmail(string? mensagem)
    {
        if (string.IsNullOrWhiteSpace(mensagem))
            return false;

        var texto = mensagem.Trim();

        var falaDeEmail =
            texto.Contains("email", StringComparison.OrdinalIgnoreCase) ||
            texto.Contains("e-mail", StringComparison.OrdinalIgnoreCase);

        var falaDeVerificacao =
            texto.Contains("verific", StringComparison.OrdinalIgnoreCase) ||
            texto.Contains("confirm", StringComparison.OrdinalIgnoreCase) ||
            texto.Contains("ativ", StringComparison.OrdinalIgnoreCase);

        return falaDeEmail && falaDeVerificacao;
    }

    private async Task HandleVerificar2FA()
    {
        if (Entrando) return;
        ErrorMessage = "";

        if (empresaCodigo <= 0)
        {
            ErrorMessage = "Não foi possível identificar a empresa do usuário. Faça login novamente.";
            VoltarLogin();
            return;
        }

        try
        {
            Entrando = true;

            var usuarioLogado = usuario.Trim().ToUpperInvariant();
            var valido = await CadastroUsuarioService.Verificar2FAAsync(
                usuarioLogado, codigo2FA, empresaCodigo.ToString());

            if (!valido)
            {
                ErrorMessage = "Código inválido ou expirado.";
                return;
            }

            if (lembrarDispositivo)
            {
                var token = await CadastroUsuarioService.GravarSessaoLembrarAsync(
                    usuarioLogado, empresaCodigo.ToString(), minutos: 21600);

                await JS.InvokeVoidAsync("localStorage.setItem", "crm_2fa_token", token);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "crm_2fa_token");
            }

            await ConcluirLoginAsync();
        }
        finally
        {
            Entrando = false;
        }
    }

    private async Task ConcluirLoginAsync()
    {
        var usuarioLogado = usuario.Trim().ToUpperInvariant();

        if (empresaCodigo <= 0 || string.IsNullOrWhiteSpace(empresaNome))
        {
            var empresa = await CadastroUsuarioService.BuscarEmpresaDoUsuarioAsync(usuarioLogado);
            if (empresa is null)
            {
                ErrorMessage = "Não foi possível carregar os dados da empresa do usuário.";
                return;
            }

            empresaCodigo = empresa.Codigo;
            empresaNome = empresa.NomeReduzido;
        }

        UserState.SetUser(usuarioLogado, empresaCodigo, empresaNome);

        var ip = await JS.InvokeAsync<string>("eval", "window.location.hostname");
        await LogAcessoService.RegistrarAsync(usuarioLogado, empresaCodigo, empresaNome, "LOGIN", ip);
        await LoginService.AtualizarStatusOnlineAsync(usuarioLogado, true);

        await JS.InvokeVoidAsync("localStorage.setItem", "crm_user", usuarioLogado);
        await JS.InvokeVoidAsync("localStorage.setItem", "crm_company", empresaCodigo.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", "crm_company_name", empresaNome);

        await RedirecionarPorPermissaoAsync();
    }

    private void VoltarLogin()
    {
        Etapa2FA = false;
        codigo2FA = "";
        ErrorMessage = "";
        lembrarDispositivo = false;
    }

    private async Task<bool> DispositivoLembradoValidoAsync(string usuarioLogin, int codEmpresa)
    {
        var tokenSalvo = await JS.InvokeAsync<string?>("localStorage.getItem", "crm_2fa_token");
        var usuarioSalvo = await JS.InvokeAsync<string?>("localStorage.getItem", "crm_user");
        var empresaSalva = await JS.InvokeAsync<string?>("localStorage.getItem", "crm_company");

        if (string.IsNullOrWhiteSpace(tokenSalvo) ||
            string.IsNullOrWhiteSpace(usuarioSalvo) ||
            string.IsNullOrWhiteSpace(empresaSalva))
        {
            return false;
        }

        if (!string.Equals(usuarioSalvo.Trim(), usuarioLogin, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!int.TryParse(empresaSalva, out var empresaLocal) || empresaLocal != codEmpresa)
            return false;

        var valido = await CadastroUsuarioService.ValidarSessaoLembrarAsync(usuarioLogin, tokenSalvo);
        if (!valido)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "crm_2fa_token");
            return false;
        }

        return true;
    }

    private async Task LimparSessaoLocalAsync()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "crm_2fa_token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "crm_user");
        await JS.InvokeVoidAsync("localStorage.removeItem", "crm_company");
        await JS.InvokeVoidAsync("localStorage.removeItem", "crm_company_name");
    }

    private async Task RedirecionarPorPermissaoAsync()
    {
        var usuarioLogado = usuario.Trim().ToUpperInvariant();

        if (await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "DASHBOARD_VISUALIZAR"))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        if (await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "COMERCIAL_ACESSAR"))
        {
            Nav.NavigateTo("/menu");
            return;
        }

        if (await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "AGENDAS_VISUALIZAR"))
        {
            Nav.NavigateTo("/agendas");
            return;
        }

        if (await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "TICKETS_VISUALIZAR"))
        {
            Nav.NavigateTo("/tickets");
            return;
        }

        if (await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "ADMIN_ACESSAR"))
        {
            Nav.NavigateTo("/admin");
            return;
        }

        ErrorMessage = "Seu usuário não possui permissão para acessar nenhuma tela do sistema.";
    }
}
