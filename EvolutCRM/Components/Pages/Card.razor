<script>
    window.evolutCard = window.evolutCard || {};

    window.evolutCard.scrollHistoricoBottom = function() {
        const el = document.querySelector(".crm-modern-center .historico-wrap");
        if (!el) return;
        setTimeout(function() {
            el.scrollTop = el.scrollHeight;
        }, 100);
    };

    window.enablePasteImageCard = function(textareaId, dotnetRef) {
        const el = document.getElementById(textareaId);
        if (!el) {
            console.warn('[PasteCard] textarea ainda não existe:', textareaId);
            return false;   // ← sinaliza que falhou, tenta de novo no próximo render
        }
        if (el.dataset.pasteBound === '1') {
            return true;    // ← já registrado, não duplica
        }
        el.dataset.pasteBound = '1';

        console.log('[PasteCard] textarea encontrado, registrando paste');

        el.addEventListener('paste', async function(e) {
            console.log('[PasteCard] paste disparado');
            if (!e.clipboardData) return;
            const items = e.clipboardData.items;
            for (const item of items) {
                if (item.type.startsWith('image/')) {
                    e.preventDefault();
                    const file = item.getAsFile();
                    const reader = new FileReader();
                    reader.onload = async function(event) {
                        try {
                            await dotnetRef.invokeMethodAsync('ReceberImagemColada', event.target.result, file.name || 'print.png');
                            console.log('[PasteCard] imagem enviada ao Blazor');
                        } catch (err) {
                            console.error('[PasteCard] Erro:', err);
                        }
                    };
                    reader.readAsDataURL(file);
                    return;
                }
            }
        });
        return true;
    };
</script>

@code {
    private DotNetObjectReference<Card>? _pasteRef;
    private bool _pasteRegistrado = false;
    [Parameter] public int? id { get; set; }
    private byte[]? _imagemColadaBytes;

    private PeriodicTimer? _timerCard;
private bool _atualizandoCard;
private bool _deveScrollarHistorico = true;

    private bool PodeVisualizarCRM = false;
    private bool PodeEditarCRM = false;

    private bool isSaving;
    private bool enviandoAnotacao;
    private CardModels cardModel = new() { Anotacoes = new() };
    private string NovaAnotacao = "";
    private string? mensagem;
    private bool exibirMensagem;
    private bool sucesso;

    private List<UserItem> ListaUsuarios = new();

    private bool mostrarModalBusca = false;
    private string buscaNome = "";
    private string buscaTelefone = "";
    private List<CardModels> resultadosBusca = new();

    private IBrowserFile? ArquivoAnotacao;
    private string NomeArquivoAnotacao = "";
    private string PreviewArquivoAnotacao = "";

    private bool CriarAgenda;
    private bool NotificarAgenda = true;

    private int CodigoMensagemEditando;
    private string TextoMensagemEditando = "";

    private string ImagemEmVisualizacao = "";
    private double ZoomImagem = 1;

    private List<string> VisualizadoresCard = new();

    // ── ÁUDIO ──────────────────────────────────────────────
    private bool gravandoAudio = false;
    private byte[]? audioGravado;
    private string audioMimeType = "";
    private string audioNomeArquivo = "";
    private string previewAudio = "";

    // Campo auxiliar para o datetime-local
    private string _dataHoraAgendaStr = "";
    private DateTime? DataHoraAgenda
    {
        get => string.IsNullOrWhiteSpace(_dataHoraAgendaStr)
            ? null
            : DateTime.TryParse(_dataHoraAgendaStr, out var dt) ? dt : null;
        set => _dataHoraAgendaStr = value?.ToString("yyyy-MM-ddTHH:mm") ?? "";
    }

    protected override async Task OnParametersSetAsync()
    {
        while (!UserState.IsReady)
            await Task.Delay(50);

        var usuarioLogado = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();

        PodeVisualizarCRM = await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "CRM_CLIENTES_VISUALIZAR");
        PodeEditarCRM = await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "CRM_CLIENTES_EDITAR");

        if (!PodeVisualizarCRM)
        {
            mensagem = "Você não tem permissão para acessar esta tela.";
            sucesso = false;
            exibirMensagem = true;
            return;
        }

        ListaUsuarios = await CardService.GetUsuariosAsync(UserState.CurrentCompanyId);

        if (id.HasValue && id.Value > 0)
        {
            cardModel = await CardService.GetCardAsync(id.Value, UserState.CurrentUser, UserState.CurrentCompanyId)
                        ?? new CardModels { Anotacoes = new List<AnotacaoModel>() };

            cardModel.Anotacoes = await CardService.GetAnotacoesAsync(id.Value)
                                  ?? new List<AnotacaoModel>();
        }
        else
        {
            cardModel = new CardModels { Anotacoes = new List<AnotacaoModel>() };
            cardModel.Usuario = UserState.CurrentUser;
        }

        if (cardModel.Usuario?.Trim().ToUpper() == "IMPORTACAO")
            cardModel.Usuario = UserState.CurrentUser;

        if (string.IsNullOrWhiteSpace(cardModel.Usuario))
            cardModel.Usuario = UserState.CurrentUser;

        cardModel.CodEmp = UserState.CurrentCompanyId;

        _deveScrollarHistorico = true;

        if (_timerCard == null && id.HasValue && id.Value > 0)
        {
            _ = AtualizarCardAutomaticamente();
        }
       
        AtualizarVisualizadoresLocais();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Registra o paste assim que o textarea existir (PodeEditarCRM == true)
        // Não pode ser só no firstRender porque nesse momento o textarea ainda não está no DOM
        if (!_pasteRegistrado && PodeEditarCRM)
        {
            try
            {
                _pasteRef ??= DotNetObjectReference.Create(this);
                var ok = await JS.InvokeAsync<bool>("enablePasteImageCard", "cardAnotacao", _pasteRef);
                if (ok)
                {
                    _pasteRegistrado = true;
                    Console.WriteLine("[PasteCard] registrado com sucesso");
                }
            }
            catch
            {
                // JS ainda não carregou — tenta no próximo render
            }
        }

        if (_deveScrollarHistorico)
        {
            _deveScrollarHistorico = false;
            try { await JS.InvokeVoidAsync("evolutCard.scrollHistoricoBottom"); }
            catch { }
        }
    }

    [JSInvokable]
    public async Task ReceberImagemColada(string dataUrl, string nomeArquivo)
    {
        NomeArquivoAnotacao = nomeArquivo;
        PreviewArquivoAnotacao = dataUrl;

        // Converte para bytes e popula ImagemBytes na próxima anotação
        if (dataUrl.Contains(";base64,"))
        {
            var base64 = dataUrl.Split(",")[1];
            _imagemColadaBytes = Convert.FromBase64String(base64);
        }

        ArquivoAnotacao = null; // sinaliza que tem anexo mas via clipboard
        await InvokeAsync(StateHasChanged);
    }

    private async Task AtualizarCardAutomaticamente()
    {
        if (!id.HasValue || id.Value <= 0)
            return;

        _timerCard ??= new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await _timerCard.WaitForNextTickAsync())
            {
                if (_atualizandoCard)
                    continue;

                _atualizandoCard = true;

                try
                {
                    await AtualizarCardAberto();
                }
                finally
                {
                    _atualizandoCard = false;
                }
            }
        }
        catch
        {
        }
    }

    private async Task AtualizarCardAberto()
    {
        int codigoCard = id ?? cardModel.Codigo;

        if (codigoCard <= 0)
            return;

        var novasAnotacoes = await CardService.GetAnotacoesAsync(codigoCard)
                             ?? new List<AnotacaoModel>();

        var ultimoAtual = cardModel.Anotacoes?
            .OrderByDescending(x => x.DataHora)
            .FirstOrDefault();

        var ultimoNovo = novasAnotacoes
            .OrderByDescending(x => x.DataHora)
            .FirstOrDefault();

        bool mudou =
            (cardModel.Anotacoes?.Count ?? 0) != novasAnotacoes.Count
            || ultimoAtual?.DataHora != ultimoNovo?.DataHora
            || ultimoAtual?.Texto != ultimoNovo?.Texto;

        if (mudou)
        {
            cardModel.Anotacoes = novasAnotacoes;
            _deveScrollarHistorico = true;

            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _timerCard?.Dispose();
        _pasteRef?.Dispose();
    }

    private void AtualizarVisualizadoresLocais()
    {
        VisualizadoresCard = new List<string>();

        if (!string.IsNullOrWhiteSpace(UserState.CurrentUser))
            VisualizadoresCard.Add(UserState.CurrentUser);

        if (!string.IsNullOrWhiteSpace(cardModel.Usuario) &&
            !VisualizadoresCard.Any(x => MesmoUsuario(x, cardModel.Usuario)))
            VisualizadoresCard.Add(cardModel.Usuario);
    }

    private async Task OnUsuarioAlterado(ChangeEventArgs e)
    {
        if (!PodeEditarCRM)
        {
            ExibirMensagem("Você não tem permissão para alterar o responsável.", false);
            return;
        }

        var novoUsuario = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(novoUsuario) || cardModel.Codigo == 0)
            return;

        try
        {
            await CardService.TransferirCardAsync(cardModel.Codigo, novoUsuario, UserState.CurrentCompanyId);
            cardModel.Usuario = novoUsuario;
            AtualizarVisualizadoresLocais();
            ExibirMensagem($"✅ Card transferido para {novoUsuario}!", true);
            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Info,
                $"Card #{cardModel.Codigo} transferido para {novoUsuario} por {UserState.CurrentUser}");
        }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao transferir card: {ex.Message}", false);
            HealthMonitor.LogException(LogCategory.CRM, ex,
                $"TransferirCard #{cardModel.Codigo}");
        }
    }

    private async Task Salvar()
    {
        if (!PodeEditarCRM)
        {
            ExibirMensagem("Você não tem permissão para editar cards.", false);
            return;
        }

        isSaving = true;

        try
        {
            if (!ValidarCardAntesDeSalvar())
                return;

            PrepararCardParaSalvar();

            var idGerado = await CardService.SaveCardAsync(cardModel);
            cardModel.Codigo = idGerado;

            await SalvarHistoricoAtual();

            // ── NOVO: gravar agenda se estiver marcada ──
            if (CriarAgenda && DataHoraAgenda.HasValue)
            {
                var novaAgendaObj = new AgendaModel
                {
                    Descricao = string.IsNullOrWhiteSpace(NovaAnotacao)
                        ? $"Agenda - {cardModel.Descricao}"
                        : NovaAnotacao.Trim(),
                    DataAgendamento = DataHoraAgenda.Value.Date,
                    HoraAgendamento = DataHoraAgenda.Value.TimeOfDay,
                    Usuario = UserState.CurrentUser,
                    CodEmp = UserState.CurrentCompanyId,
                    CodCRMC = cardModel.Codigo,
                    NomeCliente = cardModel.Descricao,
                    Origem = "CRM",
                    Status = "PENDENTE",
                    TipoRepeticao = "UmaVez"
                };

                await AgendaService.SalvarAgendaAsync(novaAgendaObj, false);

                CriarAgenda = false;
                _dataHoraAgendaStr = "";
                NotificarAgenda = true;
            }

            ExibirMensagem("✅ Card salvo com sucesso.", true);
            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Success,
                $"Card #{cardModel.Codigo} salvo por {UserState.CurrentUser}");
        }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao salvar: {ex.Message}", false);
            HealthMonitor.LogException(LogCategory.CRM, ex,
                $"Salvar card #{cardModel.Codigo} usuário {UserState.CurrentUser}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool ValidarCardAntesDeSalvar()
    {
        if (string.IsNullOrWhiteSpace(cardModel.Descricao))
        {
            ExibirMensagem("❌ O campo Descrição é obrigatório.", false);
            return false;
        }

        if (string.IsNullOrWhiteSpace(cardModel.Funil))
        {
            ExibirMensagem("❌ É obrigatório selecionar uma opção de Funil.", false);
            return false;
        }

        // ADICIONAR:
        if (string.IsNullOrWhiteSpace(cardModel.Usuario) || cardModel.Usuario.Trim().ToUpper() == "NOVO")
        {
            ExibirMensagem("❌ É obrigatório definir um Responsável antes de salvar.", false);
            return false;
        }

        return true;
    }

    private void PrepararCardParaSalvar()
    {
        cardModel.Usuario =
            string.IsNullOrWhiteSpace(cardModel.Usuario) || cardModel.Usuario.Trim().ToUpper() == "IMPORTACAO"
                ? UserState.CurrentUser
                : cardModel.Usuario;

        cardModel.CodEmp = cardModel.CodEmp == 0 ? UserState.CurrentCompanyId : cardModel.CodEmp;
    }

    private async Task AdicionarAnotacao()
    {
        if (!PodeEditarCRM)
        {
            ExibirMensagem("Você não tem permissão para inserir mensagens.", false);
            return;
        }

        if (string.IsNullOrWhiteSpace(NovaAnotacao)
    && ArquivoAnotacao == null
    && _imagemColadaBytes == null
    && !CriarAgenda
    && (audioGravado == null || audioGravado.Length == 0))
            return;

        // ADICIONAR:
        if (string.IsNullOrWhiteSpace(cardModel.Usuario) || cardModel.Usuario.Trim().ToUpper() == "NOVO")
        {
            ExibirMensagem("❌ Defina um Responsável antes de enviar mensagem.", false);
            return;
        }


        enviandoAnotacao = true;

        try
        {
            if (!ValidarCardAntesDeSalvar())
                return;

            PrepararCardParaSalvar();

            if (cardModel.Codigo == 0)
                cardModel.Codigo = await CardService.SaveCardAsync(cardModel);

            var nova = new AnotacaoModel
            {
                DataHora = DateTime.Now,
                Texto = NovaAnotacao?.Trim() ?? "",
                Funil = cardModel.Funil,
                IsNova = true
            };

            DefinirUsuarioAnotacao(nova, UserState.CurrentUser);
            SetProp(nova, "MensagemExcluida", "N");
            SetProp(nova, "Alterado", "N");
            SetProp(nova, "StatusWhatsApp", "");

            // EXISTENTE — imagem colada / arquivo
            if (ArquivoAnotacao != null || _imagemColadaBytes != null)
            {
                SetProp(nova, "NomeImagem", NomeArquivoAnotacao);
                if (_imagemColadaBytes != null)
                {
                    nova.ImagemBytes = _imagemColadaBytes;
                }
                else if (!string.IsNullOrEmpty(PreviewArquivoAnotacao) && PreviewArquivoAnotacao.Contains(";base64,"))
                {
                    var base64 = PreviewArquivoAnotacao.Split(",")[1];
                    nova.ImagemBytes = Convert.FromBase64String(base64);
                }
            }

            // ── NOVO — áudio gravado ──────────────────────────────
            // ── ÁUDIO ──────────────────────────────────────────────
            if (audioGravado != null && audioGravado.Length > 0)
            {
                nova.Audio = "data:" + audioMimeType + ";base64," + Convert.ToBase64String(audioGravado);
                nova.AudioMimeType = audioMimeType;
            }

            if (CriarAgenda)
            {
                SetProp(nova, "NovaAgenda", "S");
                SetProp(nova, "DataHoraAgenda", DataHoraAgenda ?? DateTime.Now.AddHours(1));
                SetProp(nova, "AgendaResolvida", "N");
                SetProp(nova, "NotificarAgenda", NotificarAgenda);
            }
            else
            {
                SetProp(nova, "NovaAgenda", "N");
            }

            cardModel.Anotacoes ??= new List<AnotacaoModel>();
            cardModel.Anotacoes.Add(nova);

            await SalvarHistoricoAtual();

            if (CriarAgenda)
{
    var novaAgendaObj = new AgendaModel
    {
        Descricao = string.IsNullOrWhiteSpace(NovaAnotacao)
            ? $"Agenda - {cardModel.Descricao}"
            : NovaAnotacao.Trim(),
        DataAgendamento = DataHoraAgenda?.Date ?? DateTime.Today,
        HoraAgendamento = DataHoraAgenda.HasValue
            ? DataHoraAgenda.Value.TimeOfDay
            : TimeSpan.FromHours(9),
        Usuario = UserState.CurrentUser,
        CodEmp = UserState.CurrentCompanyId,
        CodCRMC = cardModel.Codigo,
        NomeCliente = cardModel.Descricao,
        Origem = "CRM",
        Status = "PENDENTE",
        TipoRepeticao = "UmaVez"
    };

    await AgendaService.SalvarAgendaAsync(novaAgendaObj, false);
}

            await RecarregarAnotacoes();

            _deveScrollarHistorico = true;

            NovaAnotacao = "";
            RemoverArquivoAnotacao();
            RemoverAudio();
            CriarAgenda = false;
            _dataHoraAgendaStr = "";
            NotificarAgenda = true;

            ExibirMensagem("✅ Mensagem enviada no histórico do card.", true);
            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Info,
                $"Anotação adicionada ao card #{cardModel.Codigo} por {UserState.CurrentUser}",
                audioGravado != null ? "tipo=audio" : ArquivoAnotacao != null ? "tipo=arquivo" : "tipo=texto");
        }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao enviar mensagem: {ex.Message}", false);
            HealthMonitor.LogException(LogCategory.CRM, ex,
                $"AdicionarAnotacao card #{cardModel.Codigo} usuário {UserState.CurrentUser}");
        }
        finally
        {
            enviandoAnotacao = false;
        }
    }

    private async Task SalvarHistoricoAtual()
    {
        await CardService.SalvarAnotacoesAsync(cardModel.Codigo, cardModel.Anotacoes ?? new List<AnotacaoModel>(), UserState.CurrentUser);
    }

    private async Task RecarregarAnotacoes()
    {
        if (cardModel.Codigo > 0)
        {
            cardModel.Anotacoes = await CardService.GetAnotacoesAsync(cardModel.Codigo)
                                  ?? cardModel.Anotacoes
                                  ?? new List<AnotacaoModel>();
        }
    }

