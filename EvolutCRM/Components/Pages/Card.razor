    private static bool EhInterna(AnotacaoModel a) =>
        string.Equals((a.StatusWhatsApp ?? "").Trim(), "interno", StringComparison.OrdinalIgnoreCase);

    private string NomeAutor(AnotacaoModel anot, bool mensagemCliente)
    {
        if (!string.IsNullOrWhiteSpace(anot.Usuario))
            return anot.Usuario;

        if (mensagemCliente)
