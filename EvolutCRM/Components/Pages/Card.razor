    // =====================================================================
    private string TempoAbertoTexto
    {
        get
        {
            if (cardModel.Codigo <= 0 || !cardModel.DataCriacao.HasValue)
                return "--";

            var fim = StatusCard is "CONCLUIDO" or "PERDIDO"
                ? (cardModel.DataAlteracao ?? DateTime.Now)
                : DateTime.Now;

            var tempo = fim - cardModel.DataCriacao.Value;

            if (tempo.TotalMinutes < 1)
                return "menos de 1 min";

            return FormatarTempo(tempo);
        }
    }

    private string TempoMedioRespostaTexto
    {
        get
        {
            var mensagens = (cardModel.Anotacoes ?? new List<AnotacaoModel>())
                .Where(h => h.MensagemExcluida != "S" && !EhInterna(h))
                .OrderBy(h => h.DataHora)
                .ToList();

            if (mensagens.Count == 0)
                return "--";

            var temposResposta = new List<TimeSpan>();

            for (int i = 0; i < mensagens.Count; i++)
            {
                if (mensagens[i].EnvioCliente != "S")
                    continue;

                var resposta = mensagens
                    .Skip(i + 1)
                    .FirstOrDefault(m =>
                        m.EnvioCliente != "S" &&
                        !MesmoUsuario(m.Usuario, "CLIENTE") &&
                        !MesmoUsuario(m.Usuario, "WHATSAPP") &&
                        !MesmoUsuario(m.Usuario, "FLUXO"));

                if (resposta != null)
                {
                    var tempo = resposta.DataHora - mensagens[i].DataHora;
                    if (tempo.TotalSeconds > 0)
                        temposResposta.Add(tempo);
                }
            }

            if (!temposResposta.Any())
                return "--";

            return FormatarTempo(TimeSpan.FromTicks((long)temposResposta.Average(t => t.Ticks)));
        }
    }

    private static string FormatarTempo(TimeSpan tempo)
    {
        if (tempo.TotalDays >= 1)
            return $"{(int)tempo.TotalDays}d {tempo.Hours}h {tempo.Minutes}min";

        if (tempo.TotalHours >= 1)
            return $"{(int)tempo.TotalHours}h {tempo.Minutes}min";

        return $"{Math.Max(1, (int)tempo.TotalMinutes)}min";
    }

    // =====================================================================
    // SALVAR CARD (cabeçalho)
    // =====================================================================
    private async Task Salvar()
    {
        if (!PodeEditarCRM)
        {
            ExibirMensagem("Você não tem permissão para editar cards.", false);
            return;
        }

        if (isSaving)
            return;

        isSaving = true;

        try
        {
            if (!ValidarCardAntesDeSalvar())
                return;

            PrepararCardParaSalvar();

            var codigoAntes = cardModel.Codigo;
            cardModel.Codigo = await CardService.SaveCardAsync(cardModel);

            // Agenda marcada no compositor? grava junto (igual ao ticket: agenda vai como mensagem)
            if (CriarAgenda)
            {
                NovaAnotacao = await ObterTextoCampo();
                await AdicionarAnotacao();
            }

            ExibirMensagem("✅ Card salvo com sucesso.", true);
            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Success,
                $"Card #{cardModel.Codigo} salvo por {UserState.CurrentUser}");

            if (codigoAntes == 0 && cardModel.Codigo > 0)
                await AposCriarCardNovo();
        }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao salvar: {ex.Message}", false);
            HealthMonitor.LogException(LogCategory.CRM, ex,
                $"Salvar card #{cardModel.Codigo} usuário {UserState.CurrentUser}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AposCriarCardNovo()
    {
        // Recarrega datas geradas no banco e mantém a URL coerente com o card criado
        var salvo = await CardService.GetCardAsync(cardModel.Codigo, UserState.CurrentUser, UserState.CurrentCompanyId);
        if (salvo != null)
        {
            cardModel.DataCriacao = salvo.DataCriacao;
            cardModel.DataAlteracao = salvo.DataAlteracao;
        }

        _rascunhoCarregado = true;
        _idCarregado = cardModel.Codigo;

        // Fecha a aba "Novo card" e abre a aba do card criado (mesmo comportamento do ticket novo)
        if (string.Equals(Abas.RotaAtiva ?? "", "card", StringComparison.OrdinalIgnoreCase))
            Abas.Fechar("card");

        Nav.NavigateTo($"/card/{cardModel.Codigo}");
    }

    private bool ValidarCardAntesDeSalvar()
    {
        if (string.IsNullOrWhiteSpace(cardModel.Descricao))
        {
            ExibirMensagem("❌ O campo Contato é obrigatório.", false);
            return false;
        }

        FunilInvalido = string.IsNullOrWhiteSpace(cardModel.Funil);
        if (FunilInvalido)
        {
            ExibirMensagem("❌ É obrigatório selecionar uma opção de Funil.", false);
            return false;
        }

        ResponsavelInvalido = string.IsNullOrWhiteSpace(cardModel.Usuario) || cardModel.Usuario.Trim().ToUpper() == "NOVO";
        if (ResponsavelInvalido)
        {
            ExibirMensagem("❌ É obrigatório definir um Responsável antes de salvar.", false);
            return false;
        }

        return true;
    }

    private void PrepararCardParaSalvar()
    {
        cardModel.Usuario =
            string.IsNullOrWhiteSpace(cardModel.Usuario) || cardModel.Usuario.Trim().ToUpper() == "IMPORTACAO"
                ? UserState.CurrentUser
                : cardModel.Usuario;

        cardModel.CodEmp = cardModel.CodEmp == 0 ? UserState.CurrentCompanyId : cardModel.CodEmp;
    }

    private async Task OnUsuarioAlterado()
    {
        ResponsavelInvalido = false;

        if (!PodeEditarCRM || cardModel.Codigo == 0)
        {
            AtualizarVisualizadoresLocais();
            return;
        }

        var novoUsuario = cardModel.Usuario;
        if (string.IsNullOrWhiteSpace(novoUsuario))
            return;

        try
        {
            await CardService.TransferirCardAsync(cardModel.Codigo, novoUsuario, UserState.CurrentCompanyId);
            AtualizarVisualizadoresLocais();
            ExibirMensagem($"✅ Card transferido para {novoUsuario}!", true);
            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Info,
                $"Card #{cardModel.Codigo} transferido para {novoUsuario} por {UserState.CurrentUser}");
        }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao transferir card: {ex.Message}", false);
            HealthMonitor.LogException(LogCategory.CRM, ex, $"TransferirCard #{cardModel.Codigo}");
        }

        await FocarCampoMensagem();
    }

