                <input @bind="buscaTelefone" placeholder="Buscar por telefone..." />
            </div>

            <div class="modal-buttons">
                <button type="button" class="btn-primary" style="width:auto; padding:8px 18px;" @onclick="ProcurarCards">
                    Pesquisar
                </button>
                <button type="button" class="btn-voltar" @onclick="FecharModalBusca">Fechar</button>
            </div>

            @if (buscaRealizada && !resultadosBusca.Any())
            {
                <div style="padding:12px 2px; font-weight:800; color:#475569;">Nenhum resultado encontrado.</div>
            }

            @foreach (var c in resultadosBusca)
            {
                <button type="button" class="card-busca-item" @onclick="() => AbrirCardPesquisado(c.Codigo)">
                    <strong>#@c.Codigo - @c.Descricao</strong>
                    <div style="color:#64748b; font-size:.72rem; margin-top:2px;">@c.Celular</div>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? id { get; set; }

    // ── Identificadores únicos por instância (o sistema de abas pode manter vários cards abertos) ──
    private readonly string _uid = Guid.NewGuid().ToString("N")[..8];
    private string TextareaId => $"cardMsg_{_uid}";
    private string HistoricoId => $"cardHist_{_uid}";
    private string InputAnexoId => $"cardAnexo_{_uid}";
    private string? ChaveRascunho => cardModel.Codigo > 0 ? $"card_rascunho_{cardModel.Codigo}" : null;

    // ── Estado geral ──
    private bool Carregando = true;
    private int? _idCarregado;
    private bool PodeVisualizarCRM = false;
    private bool PodeEditarCRM = false;
    private bool isSaving;
    private bool enviandoAnotacao;
    private bool ResponsavelInvalido;
    private bool FunilInvalido;
    private CardModels cardModel = new() { Anotacoes = new() };
    private List<UserItem> ListaUsuarios = new();
    private List<string> VisualizadoresCard = new();
    private string? Mensagem;
    private bool Sucesso;
    private bool _detalhesExpandidos = false;

    // ── Compositor ──
    private string NovaAnotacao = "";
    private bool MensagemInterna = false;
    private bool CriarAgenda;
    private DateTime? DataHoraAgenda;
    private bool NotificarAgenda = true;
    private AnotacaoModel? MensagemRespondida;

    private byte[]? AnexoBytes;
    private string AnexoNome = "";
    private string AnexoPreview = "";

    private bool gravandoAudio = false;
    private byte[]? audioGravado;
    private string audioMimeType = "";
    private string previewAudio = "";

    private bool GravandoTela = false;
    private byte[]? VideoGravado;
    private string VideoGravadoNome = "";
    private string VideoGravadoMime = "";

    // ── IA ──
    private bool CarregandoIA;
    private string _aiErro = "";
    private string SugestaoIA = "";

    // ── Documentação ──
    private string BuscaDoc = "";
    private bool BuscandoDocs = false;
    private List<DocSearchItem> DocsEncontradas = new();

    // ── Cliente vinculado ──
    private bool AlterandoCliente = false;
    private string ClienteBusca = "";
    private List<ClienteModel> Sugestoes = new();

    // ── Edição de mensagem ──
    private int? CodigoMensagemEditando;
    private string TextoMensagemEditando = "";

    // ── Imagem ampliada ──
    private string ImagemEmVisualizacao = "";
    private double ZoomImagem = 1;

    // ── Áudio (velocidade) ──
    private double VelocidadeAudioGlobal = 1;

    // ── Busca de card ──
    private bool mostrarModalBusca = false;
    private bool buscaRealizada = false;
    private string buscaNome = "";
    private string buscaTelefone = "";
    private List<CardModels> resultadosBusca = new();

    // ── Criar ticket a partir do card ──
    private bool mostrarModalCriarTicket = false;
    private string modalCriarTicketUsuario = "NOVO";
    private string modalCriarTicketErro = "";
    private bool criandoTicket = false;

    // ── Infra ──
    private PeriodicTimer? _timerCard;
    private bool _atualizandoCard;
    private bool _composerIniciado;
    private bool _rascunhoCarregado;
    private bool _jsCarregado;
    private DotNetObjectReference<Card>? _ref;
    private CancellationTokenSource? _ctsMensagem;
    private DateTime _ultimoRenderKpi = DateTime.Now;
    private readonly Dictionary<string, string> _cacheAnexos = new();

    private string StatusCard => string.IsNullOrWhiteSpace(cardModel.Status) ? "ABERTO" : cardModel.Status.Trim().ToUpperInvariant();

    private string TelefoneDoCard =>
        !string.IsNullOrWhiteSpace(cardModel.TelefoneWhatsApp) ? cardModel.TelefoneWhatsApp
        : (cardModel.Celular ?? "");

    // =====================================================================
    // CICLO DE VIDA
    // =====================================================================
    protected override async Task OnParametersSetAsync()
    {
        while (!UserState.IsReady)
            await Task.Delay(50);

        if (_idCarregado.HasValue && _idCarregado == (id ?? 0) && !Carregando)
            return;

        Carregando = true;

        var usuarioLogado = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();
        PodeVisualizarCRM = await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "CRM_CLIENTES_VISUALIZAR");
        PodeEditarCRM = await AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "CRM_CLIENTES_EDITAR");

        if (!PodeVisualizarCRM)
        {
            Carregando = false;
            return;
        }

        ListaUsuarios = await CardService.GetUsuariosAsync(UserState.CurrentCompanyId);

        // Troca de card na mesma instância: limpa o compositor
        LimparCompositor();
        CancelarEdicaoMensagem();
        AlterandoCliente = false;
        Mensagem = "";
        _composerIniciado = false;
        _rascunhoCarregado = false;

        if (id.HasValue && id.Value > 0)
        {
            cardModel = await CardService.GetCardAsync(id.Value, UserState.CurrentUser, UserState.CurrentCompanyId)
                        ?? new CardModels { Anotacoes = new List<AnotacaoModel>() };

            cardModel.Anotacoes = await CardService.GetAnotacoesAsync(id.Value) ?? new List<AnotacaoModel>();
        }
        else
        {
            cardModel = new CardModels
            {
                Anotacoes = new List<AnotacaoModel>(),
                Usuario = UserState.CurrentUser,
                Status = "ABERTO",
                Funil = "RA"
            };
        }

        if (string.IsNullOrWhiteSpace(cardModel.Usuario) || cardModel.Usuario.Trim().ToUpper() == "IMPORTACAO")
            cardModel.Usuario = UserState.CurrentUser;

        if (string.IsNullOrWhiteSpace(cardModel.Status))
            cardModel.Status = "ABERTO";

        cardModel.CodEmp = UserState.CurrentCompanyId;
        _idCarregado = id ?? 0;

        AtualizarVisualizadoresLocais();
        Carregando = false;

        if (_timerCard == null)
            _ = AtualizarCardAutomaticamente();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Carregando || !PodeVisualizarCRM)
            return;

        try
        {
            if (!_jsCarregado)
            {
                await JS.InvokeVoidAsync("eval", CardJs);
                _jsCarregado = true;

                VelocidadeAudioGlobal = await JS.InvokeAsync<double>("evolutCardUI.carregarVelocidade", ChaveVelocidadeAudio);
                await JS.InvokeVoidAsync("evolutCardUI.setVelocidade", VelocidadeAudioGlobal, ChaveVelocidadeAudio);
                StateHasChanged();
            }

            if (PodeEditarCRM && !_composerIniciado)
            {
                _ref ??= DotNetObjectReference.Create(this);
                var ok = await JS.InvokeAsync<bool>("evolutCardUI.iniciar", TextareaId, _ref, ChaveRascunho ?? "");
                if (ok)
                {
                    _composerIniciado = true;
                    await FocarCampoMensagem();
                }
            }

            if (PodeEditarCRM && _composerIniciado && !_rascunhoCarregado)
            {
                _rascunhoCarregado = true;

                if (!string.IsNullOrWhiteSpace(ChaveRascunho))
                {
                    var rascunho = await JS.InvokeAsync<string>("evolutCardUI.carregarRascunho", ChaveRascunho);
                    if (!string.IsNullOrWhiteSpace(rascunho) && string.IsNullOrWhiteSpace(NovaAnotacao))
                        await DefinirTextoCampo(rascunho);
                }
            }
        }
        catch
        {
            // JS ainda não disponível (pré-renderização / circuito reconectando) — tenta no próximo render
        }
    }

    public void Dispose()
    {
        _timerCard?.Dispose();
        _ctsMensagem?.Cancel();
        _ref?.Dispose();
    }

    // =====================================================================
    // ATUALIZAÇÃO AUTOMÁTICA (novas mensagens / status do WhatsApp)
    // =====================================================================
    private async Task AtualizarCardAutomaticamente()
    {
        _timerCard ??= new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await _timerCard.WaitForNextTickAsync())
            {
                if (_atualizandoCard || enviandoAnotacao || cardModel.Codigo <= 0)
                    continue;

                _atualizandoCard = true;
                try { await AtualizarCardAberto(); }
                catch { }
                finally { _atualizandoCard = false; }
            }
        }
        catch
        {
        }
    }

    private async Task AtualizarCardAberto()
    {
        var novasAnotacoes = await CardService.GetAnotacoesAsync(cardModel.Codigo) ?? new List<AnotacaoModel>();

        if (AssinaturaHistorico(cardModel.Anotacoes) != AssinaturaHistorico(novasAnotacoes))
        {
            // Mantém mensagens ainda não gravadas (otimistas)
            var pendentes = cardModel.Anotacoes?.Where(a => a.IsNova).ToList() ?? new();
            novasAnotacoes.AddRange(pendentes);
            cardModel.Anotacoes = novasAnotacoes;
            await InvokeAsync(StateHasChanged);
        }
        else if ((DateTime.Now - _ultimoRenderKpi).TotalSeconds >= 60)
        {
            // Atualiza os KPIs de tempo (Tempo aberto) uma vez por minuto
            _ultimoRenderKpi = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string AssinaturaHistorico(List<AnotacaoModel>? lista)
    {
        if (lista == null || lista.Count == 0)
            return "0";

        return string.Join("|", lista
            .Where(a => !a.IsNova)
            .OrderBy(a => a.Codigo)
            .Select(a => $"{a.Codigo}:{a.StatusWhatsApp}:{a.Alterado}:{a.MensagemExcluida}:{a.AudioTranscrito}:{(a.Texto ?? "").Length}"));
    }

    private async Task RecarregarAnotacoes()
    {
        if (cardModel.Codigo > 0)
        {
            cardModel.Anotacoes = await CardService.GetAnotacoesAsync(cardModel.Codigo)
                                  ?? cardModel.Anotacoes
                                  ?? new List<AnotacaoModel>();
        }
    }

