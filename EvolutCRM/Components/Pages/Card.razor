@if (!UserState.IsReady || Carregando)
{
    <div class="titulo">Carregando Card...</div>
    return;
}

@if (!PodeVisualizarCRM)
{
    <div class="container-ticket">
        <div class="msg erro">Você não tem permissão para acessar esta tela.</div>
    </div>
    return;
}

@{
    var telefoneCard = TelefoneDoCard;
    var cardTemWhatsApp = !string.IsNullOrWhiteSpace(telefoneCard);
    var historicoOrdenado = (cardModel.Anotacoes ?? new List<AnotacaoModel>())
        .OrderByDescending(x => x.DataHora)
        .ThenByDescending(x => x.Codigo)
        .ToList();
}

<div class="container-ticket ticket-modern-container">

    <!-- TOPO — igual ao ticket -->
    <header class="ticket-modern-topbar">
        <div class="ticket-header-left">
            <button type="button" class="ticket-back-btn" @onclick="Voltar" title="Voltar">←</button>
            <div class="ticket-title-wrap">
                <div class="ticket-ticket-line">
                    <div class="ticket-code-box">
                        <span class="ticket-code-number">@(cardModel.Codigo > 0 ? $"#{cardModel.Codigo}" : "NOVO")</span>
                    </div>

                    @if (cardTemWhatsApp)
                    {
                        <span class="ticket-whatsapp-chip">
                            <span class="ticket-whats-icon">🟢</span>
                            WhatsApp
                            <small>@telefoneCard</small>
                        </span>
                    }

                    <span class="card-topo-chip" title="Funil">🎯 @ObterTextoFunil(cardModel.Funil)</span>

                    @if (!string.IsNullOrWhiteSpace(cardModel.FaixaLead))
                    {
                        <span class="card-topo-chip @ClasseTemperatura(cardModel.FaixaLead)" title="Temperatura do lead">
                            @TextoTemperatura(cardModel.FaixaLead)
                        </span>
                    }

                    @if (StatusCard is "CONCLUIDO" or "PERDIDO")
                    {
                        <span class="card-topo-chip @(StatusCard == "CONCLUIDO" ? "concluido" : "perdido")">
                            @(StatusCard == "CONCLUIDO" ? "✅ Concluído" : "✖ Perdido")
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="ticket-header-right">
            <div class="ticket-history-header-actions">
                <button type="button" class="btn-tickets-cliente" style="padding:0 12px;" @onclick="AbrirBuscaCard">
                    🔍 Buscar card
                </button>
            </div>
            <div class="ticket-kpi-card">
                <small>Tempo aberto</small>
                <strong>@TempoAbertoTexto</strong>
            </div>
            <div class="ticket-kpi-card">
                <small>Resp. média</small>
                <strong>@TempoMedioRespostaTexto</strong>
            </div>
            @if (VisualizadoresCard.Any())
            {
                <div class="ticket-viewers">
                    @foreach (var usuario in VisualizadoresCard)
                    {
                        <div class="visualizador-badge"
                             title="@usuario"
                             style="background:@GerarCorUsuario(usuario)">
                            @ObterIniciais(usuario)
                        </div>
                    }
                </div>
            }
        </div>
    </header>

    <div class="ticket-modern-grid" style="flex:1 1 0; min-height:0; height:0;">

        <!-- CENTRO: HISTÓRICO + COMPOSITOR -->
        <main class="ticket-modern-panel ticket-modern-center ticket-history-main"
              style="display:flex; flex-direction:column; overflow:hidden; padding:0;">

            <!-- Histórico (mais recente no topo, igual ao ticket) -->
            <div class="historico-wrap" id="@HistoricoId">
                @if (!historicoOrdenado.Any())
                {
                    <div class="card-hist-vazio">Nenhuma mensagem registrada neste card.</div>
                }

                @foreach (var anot in historicoOrdenado)
                {
                    var mensagemCliente = (anot.EnvioCliente ?? "N").Trim().Equals("S", StringComparison.OrdinalIgnoreCase);
                    var souEu = !mensagemCliente;
                    var ehMinha = !mensagemCliente && MesmoUsuario(anot.Usuario, UserState.CurrentUser);
                    var interno = EhInterna(anot);
                    var excluida = anot.MensagemExcluida == "S";
                    var editandoEstaMensagem = anot.Codigo > 0 && CodigoMensagemEditando == anot.Codigo;
                    var temAudio = !string.IsNullOrWhiteSpace(anot.Audio);
                    var (citacao, corpo) = SepararCitacao(anot.Texto);

                    var podeEditarMensagem = PodeEditarCRM && ehMinha && !excluida && anot.Codigo > 0
                                             && !string.IsNullOrWhiteSpace(anot.Texto) && !temAudio;
                    var podeExcluirMensagem = PodeEditarCRM && ehMinha && !excluida && anot.Codigo > 0;

                    <div class="historico-box @(souEu ? "hist-me" : "hist-other") @(interno ? "hist-interno" : "")"
                         id="@($"{HistoricoId}_msg_{anot.Codigo}")"
                         @key="@($"anot_{anot.Codigo}_{anot.DataHora.Ticks}")">

                        @if (interno)
                        {
                            <div class="hist-interno-label">🔒 Interno</div>
                        }

                        @if (!excluida && !string.IsNullOrWhiteSpace(citacao.Usuario + citacao.Texto))
                        {
                            <div class="historico-quote">
                                <div class="historico-quote-usuario">@citacao.Usuario</div>
                                <div class="historico-quote-texto">@citacao.Texto</div>
                            </div>
                        }

                        <div class="historico-topo">
                            <span>@NomeAutor(anot, mensagemCliente)</span>
                            <span>@anot.DataHora.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        @if (excluida)
                        {
                            <span class="historico-texto" style="font-style:italic; opacity:.75;">
                                🗑️ Mensagem excluída
                            </span>
                        }
                        else
                        {
                            @if (editandoEstaMensagem)
                            {
                                <textarea class="edit-msg-textarea" @bind="TextoMensagemEditando"></textarea>
                                <div class="edit-msg-actions">
                                    <button type="button" class="btn-salvar-edit-msg" @onclick="SalvarEdicaoMensagem">💾 Salvar</button>
                                    <button type="button" class="btn-cancelar-edit-msg" @onclick="CancelarEdicaoMensagem">Cancelar</button>
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(corpo))
                                {
                                    <span class="historico-texto">
                                        @foreach (var parte in SepararUrlsDoTexto(corpo))
                                        {
                                            if (parte.StartsWith("http://") || parte.StartsWith("https://"))
                                            {
                                                <a href="@parte" target="_blank"
                                                   style="color:#2563eb; text-decoration:underline; word-break:break-all;">@parte</a>
                                            }
                                            else
                                            {
                                                @parte
                                            }
                                        }
                                    </span>
                                }
                                @if (anot.Alterado == "S")
                                {
                                    <div class="msg-editada-label">✏️ editada</div>
                                }
                            }

                            @if (PodeEditarCRM && !editandoEstaMensagem)
                            {
                                <div class="msg-actions">
                                    @if (podeEditarMensagem)
                                    {
                                        <button type="button" class="btn-msg-action"
                                                @onclick="() => IniciarEdicaoMensagem(anot)">
                                            ✏️ Editar
                                        </button>
                                    }
                                    @if (podeExcluirMensagem)
                                    {
                                        <button type="button" class="btn-msg-action"
                                                @onclick="() => ExcluirMensagem(anot)">
                                            🗑️ Excluir
                                        </button>
                                    }
                                    <button type="button" class="btn-msg-action" @onclick="() => IniciarResposta(anot)">↩ Responder</button>
                                </div>
                            }
                        }

                        @if (!excluida && !string.IsNullOrWhiteSpace(anot.NomeImagem) && EhVideo(anot.NomeImagem) && anot.ImagemBytes != null)
                        {
                            <div class="video-message-box">
                                <video controls class="video-message-player">
                                    <source src="@DataUriAnexo(anot)" type="@MimePorExtensao(anot.NomeImagem)" />
                                    Seu navegador não suporta vídeo.
                                </video>
                                <div class="video-message-name">🎥 @anot.NomeImagem</div>
                            </div>
                        }

                        @if (!mensagemCliente && !interno && !string.IsNullOrWhiteSpace(anot.StatusWhatsApp))
                        {
                            <div class="msg-status-whats">
                                @switch ((anot.StatusWhatsApp ?? "").Trim().ToLower())
                                {
                                    case "sending":
                                    case "pending":
                                        <span style="color:#fef3c7;">🕓 Enviando...</span>
                                        break;
                                    case "sent":
                                    case "edited":
                                        <span style="color:#ffffff;">✓ Enviado</span>
                                        break;
                                    case "erro_instancia":
                                        <span style="color:#fef3c7;">⚠ Aguardando conexão do WhatsApp...</span>
                                        break;
                                    case "received":
                                    case "delivered":
                                    case "delivery_ack":
                                    case "delivered2user":
                                        <span style="color:#ffffff;">✓✓ Entregue</span>
                                        break;
                                    case "read":
                                    case "read_ack":
                                    case "played":
                                        <span style="color:#90caf9;">✓✓ Lido</span>
                                        break;
                                    case "error":
                                    case "failed":
                                        <span style="color:#ffb4b4;">⚠ Erro</span>
                                        break;
                                    default:
                                        <span style="color:#fef3c7;">🕓 Enviando...</span>
                                        break;
                                }
                            </div>
                        }

                        @if (!excluida && !string.IsNullOrEmpty(anot.CaminhoImagem) && !EhVideo(anot.NomeImagem))
                        {
                            var nomeParaExt = !string.IsNullOrWhiteSpace(anot.NomeImagem)
                                ? anot.NomeImagem
                                : anot.CaminhoImagem.StartsWith("data:") ? "imagem.jpg" : anot.CaminhoImagem.Split('?')[0];
                            var ext = Path.GetExtension(nomeParaExt).ToLowerInvariant();
                            var ehImagem = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";
                            var ehPdf = ext == ".pdf";
                            var urlAnexo = DataUriAnexo(anot);

                            <div style="margin-top:10px;">
                                @if (ehImagem)
                                {
                                    <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:10px;">
                                        <div style="font-weight:800; color:#0d47a1; margin-bottom:8px;">
                                            🖼️ @(string.IsNullOrWhiteSpace(anot.NomeImagem) ? "imagem.jpg" : anot.NomeImagem)
                                        </div>
                                        <img src="@urlAnexo"
                                             class="thumb"
                                             style="width:auto; max-width:220px; max-height:220px; object-fit:cover;
                                                    background:#f8fafc; cursor:zoom-in; display:block; margin:auto;
                                                    border-radius:10px; border:2px solid #90caf9;"
                                             @onclick="() => AbrirImagem(urlAnexo)" />
                                        <a href="@urlAnexo"
                                           target="_blank"
                                           download="@(string.IsNullOrWhiteSpace(anot.NomeImagem) ? "imagem.jpg" : anot.NomeImagem)"
                                           class="btn-voltar"
                                           style="display:block; text-align:center; text-decoration:none;">
                                            Baixar imagem
                                        </a>
                                    </div>
                                }
                                else if (ehPdf)
                                {
                                    <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px;
                                                padding:10px 12px; max-width:280px;">
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <div style="width:42px; height:48px; flex-shrink:0; background:#e8f0fe;
                                                        border-radius:6px; border:1.5px solid #c5d5f5;
                                                        display:flex; flex-direction:column; align-items:center;
                                                        justify-content:center; gap:2px;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                                                          stroke="#1a56db" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" />
                                                    <polyline points="14 2 14 8 20 8"
                                                              stroke="#1a56db" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                </svg>
                                                <span style="font-size:7px; font-weight:900; color:#1a56db; letter-spacing:.04em;">PDF</span>
                                            </div>
                                            <div style="min-width:0; flex:1;">
                                                <div style="font-size:12px; font-weight:700; color:#0f172a;
                                                            white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px;">
                                                    @(string.IsNullOrWhiteSpace(anot.NomeImagem) ? "arquivo.pdf" : anot.NomeImagem)
                                                </div>
                                                <div style="font-size:10px; color:#64748b; margin-top:2px; font-weight:600;">
                                                    PDF
                                                </div>
                                            </div>
                                        </div>
                                        <div style="display:flex; gap:8px; margin-top:10px; border-top:1px solid #f1f5f9; padding-top:8px;">
                                            <a href="@urlAnexo" download="@(string.IsNullOrWhiteSpace(anot.NomeImagem) ? "arquivo.pdf" : anot.NomeImagem)"
                                               style="flex:1; text-align:center; font-size:10px; font-weight:800;
                                                      color:#16a34a; text-decoration:none; padding:5px 0;
                                                      border-radius:6px; background:#f0fdf4; border:1px solid #bbf7d0;">
                                                ⬇ Baixar
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:12px;">
                                        <strong style="color:#0d47a1;">📎 @(string.IsNullOrWhiteSpace(anot.NomeImagem) ? "arquivo" : anot.NomeImagem)</strong>
                                        <div style="font-size:13px; color:#455a64; margin-top:6px;">
                                            Este tipo de arquivo não pode ser visualizado diretamente pelo navegador.
                                        </div>
                                        <a href="@urlAnexo"
                                           download="@(string.IsNullOrWhiteSpace(anot.NomeImagem) ? "arquivo" : anot.NomeImagem)"
                                           class="btn-voltar">Baixar arquivo</a>
                                    </div>
                                }
                            </div>
                        }

                        @if (!excluida && temAudio)
                        {
                            <div class="audio-mini-container">
                                <audio controls class="audio-mini-player"
                                       onloadedmetadata="window.evolutCardUI && window.evolutCardUI.aplicarVelocidade(this)">
                                    <source src="@anot.Audio" type="@(string.IsNullOrWhiteSpace(anot.AudioMimeType) ? "audio/ogg" : anot.AudioMimeType)" />
                                </audio>
                                <button type="button" class="audio-mini-speed" @onclick="AlterarVelocidadeAudioGlobal">
                                    @($"{VelocidadeAudioGlobal:0.#}x")
                                </button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(anot.TranscricaoAudio))
                            {
                                var ehErro = anot.TranscricaoAudio.StartsWith("[ERRO:");
                                <div style="margin-top:5px; padding:6px 10px;
                                            background:@(ehErro ? "rgba(220,38,38,.07)" : "rgba(0,0,0,.05)");
                                            border-radius:8px;
                                            border-left:3px solid @(ehErro ? "#dc2626" : "#25d366");
                                            font-size:10.5px;
                                            color:@(ehErro ? "#7f1d1d" : "#374151");
                                            line-height:1.45; font-style:italic;">
                                    @(ehErro ? "⚠️" : "🗒️")
                                    <strong style="font-style:normal; font-size:9.5px; text-transform:uppercase; letter-spacing:.04em;">
                                        @(ehErro ? "Erro na transcrição" : "Transcrição")
                                    </strong><br />
                                    @(ehErro ? "" : anot.TranscricaoAudio)
                                </div>
                            }
                            else if (mensagemCliente && anot.AudioTranscrito != "S"
                                     && anot.StatusWhatsApp != "transcricao_erro")
                            {
                                <div style="margin-top:4px; font-size:9.5px; color:#94a3b8; font-style:italic;">
                                    ⏳ Transcrevendo áudio...
                                </div>
                            }
                        }

                    </div>
                }
            </div>

            <!-- COMPOSITOR — fixo na parte inferior (igual ao ticket) -->
            <div style="flex:0 0 auto; background:#f0f2f5; border-top:1px solid #d1d5db; padding:10px 12px;">

                @if (!PodeEditarCRM)
                {
                    <div class="msg erro" style="margin:0;">
                        Você pode visualizar este card, mas não tem permissão para responder ou alterar.
                    </div>
                }
                else
                {
                    @if (MensagemRespondida != null)
                    {
                        <div class="msg-quote-preview" style="margin-bottom:6px;">
                            <div>
                                <div style="font-size:9px; font-weight:800; color:#075e54;">
                                    Respondendo @NomeAutor(MensagemRespondida, (MensagemRespondida.EnvioCliente ?? "N") == "S")
                                </div>
                                <div class="msg-quote-preview-text">@TrechoParaCitacao(MensagemRespondida)</div>
                            </div>
                            <button type="button" class="msg-quote-cancel" @onclick="CancelarResposta">✕</button>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(SugestaoIA))
                    {
                        <div style="margin-bottom:6px; padding:8px 10px; background:#f0f7ff;
                                    border:1px solid #bfdbfe; border-radius:8px; font-size:10px; color:#1d4ed8;">
                            ✅ Resposta da IA inserida abaixo. Revise antes de enviar.
                        </div>
                    }

                    @if (AnexoBytes != null)
                    {
                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;
                                    padding:4px 8px; background:#eff6ff; border-radius:6px;
                                    font-size:10px; color:#0d47a1; font-weight:800;">
                            📎 @AnexoNome
                            @if (ArquivoEhImagem(AnexoNome) && !string.IsNullOrEmpty(AnexoPreview))
                            {
                                <img src="@AnexoPreview"
                                     style="max-height:32px; border-radius:4px; border:1px solid #90caf9;" />
                            }
                            <button type="button" class="btn-remover-midia" @onclick="RemoverArquivoAnotacao">✕</button>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(previewAudio))
                    {
                        <div class="audio-mini-container" style="margin-bottom:6px;">
                            <span class="audio-mini-icon">🎧</span>
                            <audio controls class="audio-mini-player" src="@previewAudio"></audio>
                            <button type="button" class="audio-mini-speed" @onclick="RemoverAudio">Remover</button>
                        </div>
                    }

                    @if (VideoGravado != null)
                    {
                        <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;
                                    padding:4px 8px; background:#eff6ff; border-radius:6px;
                                    font-size:10px; color:#0d47a1; font-weight:800;">
                            🎥 @VideoGravadoNome
                            <button type="button" class="btn-remover-midia" @onclick="RemoverVideoGravado">✕</button>
                        </div>
                    }

                    @if (CriarAgenda)
                    {
                        <div style="margin-bottom:6px; padding:8px; border:1px dashed #93c5fd;
                                    border-radius:8px; background:#f8fbff;">
                            <div class="grupo" style="margin-bottom:4px;">
                                <label>Data/Hora da agenda</label>
                                <input type="datetime-local" @bind="DataHoraAgenda" />
                            </div>
                            <label class="agenda-check" style="font-size:.72rem;">
                                <input type="checkbox" @bind="NotificarAgenda" />
                                <span>Notificar quando vencer</span>
                            </label>
                        </div>
                    }

                    <!-- Campo de texto + ferramentas -->
                    <div style="display:flex; align-items:center; gap:8px;
                                background:#fff; border-radius:12px; border:1px solid #d1d5db;
                                padding:8px 10px; box-shadow:0 1px 3px rgba(0,0,0,.06);">

                        <!-- FERRAMENTAS ESQUERDA -->
                        <div style="display:flex; align-items:center; gap:3px; flex-shrink:0;">

                            <!-- Anexo -->
                            <label for="@InputAnexoId"
                                   class="ticket-tool-btn"
                                   title="Anexar arquivo"
                                   style="cursor:pointer; display:grid; place-items:center;">
                                📎
                            </label>

                            <InputFile id="@InputAnexoId"
                                       OnChange="OnArquivoAnotacaoSelecionado"
                                       accept=".pdf,.txt,.csv,.xml,.json,.jpg,.jpeg,.png,.gif,.webp,.bmp,.doc,.docx,.xls,.xlsx,.zip,.rar,.apk,.pfx,.p12"
                                       style="display:none;" />

                            <!-- Agenda -->
                            <label title="Criar agenda"
                                   style="cursor:pointer; display:grid; place-items:center;">
                                <input type="checkbox"
                                       @bind="CriarAgenda"
                                       style="display:none;" />
                                <span class="ticket-tool-btn"
                                      style="background:@(CriarAgenda ? "#ecfdf5" : "#eff6ff");
                                             border-color:@(CriarAgenda ? "#6ee7b7" : "#bfdbfe");
                                             color:@(CriarAgenda ? "#065f46" : "#1e40af");">
                                    📅
                                </span>
                            </label>

                            <!-- Mensagem interna (não vai para o WhatsApp do lead) -->
                            <label title="@(MensagemInterna ? "Mensagem interna ativa" : "Mensagem interna")"
                                   style="cursor:pointer; display:grid; place-items:center;">
                                <input type="checkbox"
                                       checked="@MensagemInterna"
                                       @onchange="async e => { MensagemInterna = (bool)e.Value!; await FocarCampoMensagem(); }"
                                       style="display:none;" />
                                <span class="ticket-tool-btn"
                                      style="background:@(MensagemInterna ? "#fee2e2" : "#eff6ff");
                                             border-color:@(MensagemInterna ? "#fca5a5" : "#bfdbfe");
                                             color:@(MensagemInterna ? "#991b1b" : "#1e40af");">
                                    🔒
                                </span>
                            </label>

                            @if (gravandoAudio || GravandoTela || MensagemInterna)
                            {
                                <div style="margin-top:4px; font-size:10px; font-weight:800; text-align:center;
                                            color:@(gravandoAudio || GravandoTela ? "#dc2626" : "#991b1b")">
                                    @if (gravandoAudio)
                                    {
                                        <text>🔴 Gravando áudio...</text>
                                    }
                                    else if (GravandoTela)
                                    {
                                        <text>🔴 Gravando tela...</text>
                                    }
                                    else
                                    {
                                        <text>🔒 Interno</text>
                                    }
                                </div>
                            }

                            <!-- Separador -->
                            <div style="width:1px; height:20px; background:#e2e8f0; margin:0 3px;"></div>
                        </div>

                        <!-- CAMPO DE MENSAGEM (ENTER envia • SHIFT+ENTER quebra linha) -->
                        <textarea id="@TextareaId"
                                  rows="2"
                                  value="@NovaAnotacao"
                                  @onblur="OnBlurMensagem"
                                  spellcheck="true"
                                  lang="pt-BR"
                                  autocomplete="on"
                                  autocapitalize="sentences"
                                  placeholder="Digite sua mensagem..."
                                  style="flex:1;
                                         min-width:0;
                                         border:none !important;
                                         outline:none;
                                         resize:none;
                                         min-height:24px !important;
                                         max-height:70px !important;
                                         font-size:15px !important;
                                         font-family:'IBM Plex Sans',sans-serif;
                                         line-height:1.5;
                                         background:transparent !important;
                                         color:#0f172a !important;
                                         padding:4px 0;
                                         box-shadow:none !important;"></textarea>

                        <!-- FERRAMENTAS DIREITA -->
                        <div style="display:flex; align-items:center; gap:3px; flex-shrink:0;">

                            <!-- Áudio -->
                            @if (!gravandoAudio)
                            {
                                <button type="button" class="ticket-tool-btn" title="Gravar áudio" @onclick="AlternarGravacao">🎤</button>
                            }
                            else
                            {
                                <button type="button" class="ticket-tool-btn gravando" title="Parar" @onclick="AlternarGravacao">⏹</button>
                            }

                            <!-- Tela -->
                            @if (!GravandoTela)
                            {
                                <button type="button" class="ticket-tool-btn" title="Gravar tela" @onclick="IniciarGravacaoTela">🎥</button>
                            }
                            else
                            {
                                <button type="button" class="ticket-tool-btn gravando" title="Parar gravação" @onclick="PararGravacaoTela">⏹</button>
                            }

                            <div style="width:1px; height:20px; background:#e2e8f0; margin:0 2px;"></div>

                            <!-- IA -->
                            <button class="ticket-tool-btn"
                                    title="Gerar resposta IA"
                                    style="width:auto; padding:0 8px; font-size:10px; font-weight:800;"
                                    @onclick="GerarRespostaIA"
                                    disabled="@CarregandoIA">
                                @if (CarregandoIA)
                                {
                                    <span class="btn-ia-spinner" style="width:12px; height:12px; border-width:2px;"></span>
                                }
                                else
                                {
                                    <text>🤖</text>
                                }
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_aiErro))
                    {
                        <div class="msg erro" style="margin-top:6px;">@_aiErro</div>
                    }

                    @if (!string.IsNullOrEmpty(Mensagem))
                    {
                        <div class="msg @(Sucesso ? "sucesso" : "erro")" style="margin-top:6px;">@Mensagem</div>
                    }

                    <div style="margin-top:4px; display:flex; align-items:center; gap:34px; flex-wrap:wrap;">
                        @foreach (var atalho in new[] {
                            ("ENTER", "#16a34a", "Enviar"),
                            ("SHIFT+ENTER", "#2563eb", "Quebrar linha"),
                        })
                        {
                            <div style="display:flex; align-items:center; gap:4px;">
                                <span style="min-width:22px; height:16px; padding:0 4px; border-radius:3px;
                                             background:@atalho.Item2; color:#fff; font-size:9px;
                                             font-weight:900; display:inline-flex; align-items:center;
                                             justify-content:center; flex-shrink:0;">
                                    @atalho.Item1
                                </span>
                                <span style="font-size:12px; font-weight:700; color:#475569;">
                                    @atalho.Item3
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

        </main>

        <!-- ESQUERDA: INFORMAÇÕES DO CARD (mesma coluna do ticket) -->
        <aside class="ticket-modern-panel ticket-modern-right">

            <div class="ticket-info-profile">
                <div class="ticket-info-avatar-fallback">@ObterIniciais(string.IsNullOrWhiteSpace(cardModel.Descricao) ? "Novo" : cardModel.Descricao)</div>
                <div style="min-width:0;">
                    <div style="font-size:.72rem; color:#64748b; font-weight:800;">Lead</div>
                    <div style="font-weight:950; color:#0d47a1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        @(cardModel.Codigo > 0 ? $"{cardModel.Codigo} - " : "")@(string.IsNullOrWhiteSpace(cardModel.Descricao) ? "Novo atendimento comercial" : cardModel.Descricao)
                    </div>
                </div>
            </div>

            <!-- CLIENTE vinculado -->
            <div class="ticket-info-row">
                <label>Cliente</label>
                @if (!AlterandoCliente)
                {
                    <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                        <span class="ticket-info-value">
                            @(string.IsNullOrWhiteSpace(cardModel.NomeCliente) ? "Sem cliente vinculado" : cardModel.NomeCliente)
                        </span>
                        @if (PodeEditarCRM)
                        {
                            <button type="button" class="btn-editar-cliente" @onclick="IniciarAlteracaoCliente">✎ Alterar</button>
                        }
                    </div>
                }
                else
                {
                    <div style="min-width:0;">
                        <input @bind="ClienteBusca"
                               @bind:event="oninput"
                               @bind:after="BuscarClientes"
                               placeholder="Código ou nome..." />
                        <div class="cliente-autocomplete-wrapper">
                            @if (Sugestoes.Any())
                            {
                                <ul class="autocomplete-list">
                                    @foreach (var cli in Sugestoes)
                                    {
                                        <li @onclick="() => SelecionarCliente(cli)">
                                            <strong>@cli.Codigo</strong> - @cli.Nome
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div style="display:flex; gap:6px; margin-top:4px;">
                            @if (cardModel.CodCliente > 0)
                            {
                                <button type="button" class="btn-editar-cliente" @onclick="RemoverClienteVinculado">Remover vínculo</button>
                            }
                            <button type="button" class="btn-editar-cliente" @onclick="CancelarAlteracaoCliente">Cancelar</button>
                        </div>
                    </div>
                }
            </div>

            <!-- CONTATO (descrição do card) -->
            <div class="ticket-info-row">
                <label>Contato</label>
                <input @bind="cardModel.Descricao"
                       disabled="@(!PodeEditarCRM)"
                       placeholder="Nome do contato / oportunidade..."
                       style="width:100%;" />
            </div>

            <!-- TELEFONE -->
            <div class="ticket-info-row">
                <label>Telefone</label>
                <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                    <input @bind="cardModel.TelefoneWhatsApp"
                           disabled="@(!PodeEditarCRM)"
                           placeholder="(DDD) 99999-9999"
                           style="flex:1; min-width:0;" />
                    <button type="button" class="whats-btn" title="Abrir WhatsApp" @onclick="AbrirWhatsApp">
                        <i class="fa-brands fa-whatsapp" style="color:#fff; font-size:15px;"></i>
                    </button>
                </div>
            </div>

            <!-- RESPONSÁVEL -->
            <div class="ticket-info-row">
                <label>Responsável</label>
                <select @bind="cardModel.Usuario"
                        @bind:after="OnUsuarioAlterado"
                        disabled="@(!PodeEditarCRM)"
                        class="@(ResponsavelInvalido ? "select-erro" : "")">
                    <option value="">Selecione...</option>
                    @if (!string.IsNullOrWhiteSpace(cardModel.Usuario) && !ListaUsuarios.Any(u => MesmoUsuario(u.Username, cardModel.Usuario)))
                    {
                        <option value="@cardModel.Usuario">@cardModel.Usuario</option>
                    }
                    @foreach (var u in ListaUsuarios)
                    {
                        <option value="@u.Username">@u.Username</option>
                    }
                </select>
            </div>

            <!-- SITUAÇÃO (status do card) -->
            <div class="ticket-info-row">
                <label>Situação</label>
                <select @bind="cardModel.Status" disabled="@(!PodeEditarCRM)">
                    <option value="ABERTO">Aberto</option>
                    <option value="CONCLUIDO">Concluído</option>
                    <option value="PERDIDO">Perdido</option>
                </select>
            </div>

            <!-- FUNIL (comercial) -->
            <div class="ticket-info-row">
                <label>Funil</label>
                <select @bind="cardModel.Funil"
                        disabled="@(!PodeEditarCRM)"
                        class="@(FunilInvalido ? "select-erro" : "")">
                    <option value="">Selecione...</option>
                    <option value="RA">Novo Lead</option>
                    <option value="EP">Contato Feito</option>
                    <option value="FU">Qualificado</option>
                    <option value="NO">Nutrição</option>
                    <option value="PF">Pendente Fechamento</option>
                    <option value="IM">Implantação</option>
                </select>
            </div>

            <!-- TEMPERATURA (comercial) -->
            <div class="ticket-info-row">
                <label>Temperatura</label>
                <select @bind="cardModel.FaixaLead" disabled="@(!PodeEditarCRM)">
                    <option value="">Sem temperatura</option>
                    <option value="QUENTE">🔥 Quente</option>
                    <option value="MORNO">🟡 Morno</option>
                    <option value="FRIO">🧊 Frio</option>
                    <option value="MUITO FRIO">❄️ Muito Frio</option>
                </select>
            </div>

            <div class="ticket-panel-title" style="margin-bottom:10px;">
                <span>📚 Documentação</span>
            </div>

            <div class="grupo">
                <input class="ticket-doc-search"
                       @bind="BuscaDoc"
                       @bind:event="oninput"
                       @bind:after="BuscarDocumentacoes"
                       placeholder="Ex.: entrada xml, estoque, pdv..." />

                @if (BuscandoDocs)
                {
                    <small class="hint" style="margin-top:6px; display:block;">Buscando...</small>
                }

                @if (DocsEncontradas.Any())
                {
                    <div class="ticket-doc-results" style="margin-top:8px;">
                        @foreach (var doc in DocsEncontradas)
                        {
                            <div class="ticket-doc-card">
                                <a href="@doc.Url" target="_blank">🔗 @doc.Title</a>
                                <div class="ticket-doc-preview">@doc.Preview</div>
                                <button type="button"
                                        class="btn-inserir-doc"
                                        @onclick="() => InserirUrlDocNaMensagem(doc)">
                                    📎 Inserir na mensagem
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- CAMPOS SECUNDÁRIOS colapsáveis -->
            <div style="margin-top:6px;">
                <button type="button"
                        @onclick="() => _detalhesExpandidos = !_detalhesExpandidos"
                        style="width:100%; border:1px solid #e2e8f0; border-radius:8px;
                               background:#f8fbff; color:#64748b; font-size:10px; font-weight:800;
                               padding:6px 10px; cursor:pointer; display:flex;
                               align-items:center; justify-content:space-between; transition:.15s ease;">
                    <span>⚙ Mais detalhes</span>
                    <span>@(_detalhesExpandidos ? "▲" : "▼")</span>
                </button>

                @if (_detalhesExpandidos)
                {
                    <!-- E-MAIL -->
                    <div class="ticket-info-row" style="margin-top:6px;">
                        <label>E-mail</label>
                        <input @bind="cardModel.Email"
                               disabled="@(!PodeEditarCRM)"
                               placeholder="email@cliente.com.br" />
                    </div>

                    <!-- PREVISÃO DE FECHAMENTO + DATAS -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;
                                padding:6px 0; border-bottom:1px solid #eef2f7;">
                        <div>
                            <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                          text-transform:uppercase; letter-spacing:.03em;">Previsão fech.</label>
                            <input type="date"
                                   disabled="@(!PodeEditarCRM)"
                                   value="@cardModel.PrevisaoFechamento?.ToString("yyyy-MM-dd")"
                                   @onchange="e => cardModel.PrevisaoFechamento = ParseDate(e.Value)"
                                   style="width:100%; height:32px; border:1px solid #bbdefb;
                                          border-radius:8px; font-size:.74rem; padding:5px 8px; background:#fff;" />
                        </div>
                        <div>
                            <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                          text-transform:uppercase; letter-spacing:.03em;">Criado em</label>
                            <div class="card-info-readonly">
                                @(cardModel.DataCriacao?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </div>
                        </div>
                    </div>

                    <div style="padding:6px 0; border-bottom:1px solid #eef2f7;">
                        <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                      text-transform:uppercase; letter-spacing:.03em;">Última alteração</label>
                        <div class="card-info-readonly">
                            @(cardModel.DataAlteracao?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                        </div>
                    </div>

                    <!-- OBSERVAÇÃO DO CLIENTE -->
                    <div style="padding:6px 0;">
                        <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                      text-transform:uppercase; letter-spacing:.03em; display:block; margin-bottom:4px;">
                            Observação do cliente
                        </label>
                        <textarea class="ticket-observacao-cliente"
                                  @bind="cardModel.ObservacaoCliente"
                                  disabled="@(!PodeEditarCRM)"
                                  placeholder="Anotações internas sobre este cliente..."></textarea>
                    </div>
                }
            </div>

            <!-- SALVAR (sticky) -->
            <div class="ticket-save-sticky">
                <button type="button" class="btn-salvar-ticket-fixo"
                        @onclick="Salvar"
                        disabled="@(!PodeEditarCRM || isSaving)">
                    💾 @(isSaving ? "Salvando..." : "Salvar card")
                </button>

                @if (cardModel.Codigo > 0 && PodeEditarCRM)
                {
                    <button type="button" class="btn-criar-ticket-card" @onclick="AbrirModalCriarTicket">
                        🎫 Criar Ticket no Suporte
                    </button>
                }
            </div>

        </aside>

    </div>
</div>

@if (!string.IsNullOrEmpty(ImagemEmVisualizacao))
{
    <div class="img-modal-backdrop" @onclick="FecharImagem">
        <div class="img-modal" @onclick:stopPropagation="true">
            <div style="display:flex; gap:8px; margin-bottom:8px;">
                <button type="button" class="img-modal-close" @onclick="DiminuirZoomImagem">🔍−</button>
                <button type="button" class="img-modal-close" @onclick="AumentarZoomImagem">🔍+</button>
                <button type="button" class="img-modal-close" @onclick="ResetarZoomImagem">100%</button>
                <button type="button" class="img-modal-close" @onclick="FecharImagem">Fechar</button>
