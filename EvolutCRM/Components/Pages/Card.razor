    // =====================================================================
    // ANEXO / IMAGEM COLADA
    // =====================================================================
    private async Task OnArquivoAnotacaoSelecionado(InputFileChangeEventArgs e)
    {
        try
        {
            var arquivo = e.File;
            const long maxBytes = 15 * 1024 * 1024;

            using var stream = arquivo.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            AnexoBytes = ms.ToArray();
            AnexoNome = arquivo.Name;

            var contentType = string.IsNullOrWhiteSpace(arquivo.ContentType)
                ? MimePorExtensao(arquivo.Name)
                : arquivo.ContentType;

            AnexoPreview = ArquivoEhImagem(arquivo.Name)
                ? $"data:{contentType};base64,{Convert.ToBase64String(AnexoBytes)}"
                : "";
        }
        catch (Exception ex)
        {
            RemoverArquivoAnotacao();
            ExibirMensagem($"❌ Erro ao carregar anexo (máx. 15MB): {ex.Message}", false);
        }

        await FocarCampoMensagem();
    }

    [JSInvokable]
    public async Task OnImagemColada(string dataUrl, string contentType)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dataUrl) || !dataUrl.Contains(";base64,"))
                return;

            var bytes = Convert.FromBase64String(dataUrl.Split(',')[1]);

            if (bytes.Length > 10 * 1024 * 1024)
            {
                ExibirMensagem("Imagem muito grande. Máximo: 10MB", false);
                return;
            }

            var ext = (contentType ?? "").ToLowerInvariant() switch
            {
                "image/jpeg" or "image/jpg" => ".jpg",
                "image/gif" => ".gif",
                "image/webp" => ".webp",
                "image/bmp" => ".bmp",
                _ => ".png"
            };

            AnexoBytes = bytes;
            AnexoNome = $"print_{DateTime.Now:yyyyMMddHHmmss}{ext}";
            AnexoPreview = dataUrl;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ExibirMensagem($"Erro ao processar imagem colada: {ex.Message}", false);
        }
    }

    private void RemoverArquivoAnotacao()
    {
        AnexoBytes = null;
        AnexoNome = "";
        AnexoPreview = "";
    }

