            <div class="img-scroll-area @(ZoomImagem > 1 ? "zoomado" : "normal")">
                <img src="@ImagemEmVisualizacao"
                     draggable="false"
                     class="img-modal-img"
                     style="width:@((ZoomImagem * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%;" />
