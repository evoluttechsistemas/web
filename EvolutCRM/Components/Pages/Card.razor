@if (mostrarModalBusca)
{
    <div class="modal-backdrop-custom">
        <div class="modal-custom" style="width:560px; max-width:95vw; max-height:85vh; overflow:auto;">
            <div class="modal-header-custom">
                <h3 style="margin:0; color:#0d47a1;">🔍 Buscar card</h3>
                <button type="button" class="modal-close-x" @onclick="FecharModalBusca">✕</button>
            </div>

            <div class="grupo">
                <label>Nome (descrição)</label>
