    // ENVIO DE MENSAGEM (ENTER no campo — mesmo fluxo do ticket)
    // =====================================================================
    [JSInvokable]
    public async Task<bool> EnviarMensagemViaJS(string texto)
    {
        NovaAnotacao = texto ?? "";
        return await AdicionarAnotacao();
    }

    private bool TemConteudoParaEnviar =>
        !string.IsNullOrWhiteSpace(NovaAnotacao)
        || AnexoBytes != null
        || VideoGravado != null
        || (audioGravado != null && audioGravado.Length > 0)
        || CriarAgenda;

    private async Task<bool> AdicionarAnotacao()
    {
        if (!PodeEditarCRM)
        {
            ExibirMensagem("Você não tem permissão para inserir mensagens.", false);
            return false;
        }

        if (enviandoAnotacao || !TemConteudoParaEnviar)
            return false;

        if (CriarAgenda && !DataHoraAgenda.HasValue)
        {
            ExibirMensagem("❌ Informe a data/hora da agenda.", false);
            return false;
        }

        if (!ValidarCardAntesDeSalvar())
        {
            await InvokeAsync(StateHasChanged);
            return false;
        }

        enviandoAnotacao = true;
        var cardEraNovo = cardModel.Codigo == 0;

        try
        {
            PrepararCardParaSalvar();

            if (cardModel.Codigo == 0)
                cardModel.Codigo = await CardService.SaveCardAsync(cardModel);

            var texto = (NovaAnotacao ?? "").Trim();

            if (MensagemRespondida != null && !string.IsNullOrWhiteSpace(texto))
            {
                var autor = NomeAutor(MensagemRespondida, (MensagemRespondida.EnvioCliente ?? "N") == "S");
                texto = $"> {autor}: {TrechoParaCitacao(MensagemRespondida)}\n\n{texto}";
            }

            var novas = new List<AnotacaoModel>();

            // 1) Texto + anexo (arquivo/imagem colada) na mesma mensagem
            if (!string.IsNullOrWhiteSpace(texto) || AnexoBytes != null)
            {
                var principal = CriarAnotacao(texto);
                if (AnexoBytes != null)
                {
                    principal.ImagemBytes = AnexoBytes;
                    principal.NomeImagem = AnexoNome;
                }
                novas.Add(principal);
            }

            // 2) Áudio vai em mensagem própria (o WhatsApp envia um tipo de mídia por mensagem)
            if (audioGravado != null && audioGravado.Length > 0)
            {
                var msgAudio = CriarAnotacao("");
                msgAudio.Audio = "data:" + audioMimeType + ";base64," + Convert.ToBase64String(audioGravado);
                msgAudio.AudioMimeType = audioMimeType;
                novas.Add(msgAudio);
            }

            // 3) Gravação de tela vai como arquivo de vídeo
            if (VideoGravado != null)
            {
                var msgVideo = CriarAnotacao("");
                msgVideo.ImagemBytes = VideoGravado;
                msgVideo.NomeImagem = VideoGravadoNome;
                novas.Add(msgVideo);
            }

            // 4) Só agenda, sem conteúdo: registra uma nota interna no histórico
            if (novas.Count == 0 && CriarAgenda && DataHoraAgenda.HasValue)
            {
                var nota = CriarAnotacao($"📅 Agenda criada para {DataHoraAgenda.Value:dd/MM/yyyy HH:mm}");
                nota.StatusWhatsApp = "interno";
                novas.Add(nota);
            }

            cardModel.Anotacoes ??= new List<AnotacaoModel>();
            cardModel.Anotacoes.AddRange(novas);
            await InvokeAsync(StateHasChanged);

            await CardService.SalvarAnotacoesAsync(
                cardModel.Codigo,
                novas,
                UserState.CurrentUser,
                UserState.CurrentCompanyId,
                cardModel.CodInstanciaWhatsApp);

            if (CriarAgenda && DataHoraAgenda.HasValue)
            {
                var descricaoAgenda = string.IsNullOrWhiteSpace(NovaAnotacao)
                    ? $"Agenda - {cardModel.Descricao}"
                    : NovaAnotacao.Trim();

                await AgendaService.SalvarAgendaAsync(new AgendaModel
                {
                    Descricao = descricaoAgenda,
                    DataAgendamento = DataHoraAgenda.Value.Date,
                    HoraAgendamento = DataHoraAgenda.Value.TimeOfDay,
                    Usuario = UserState.CurrentUser,
                    CodEmp = UserState.CurrentCompanyId,
                    CodCRMC = cardModel.Codigo,
                    NomeCliente = cardModel.Descricao,
                    Origem = "CRM",
                    Status = "PENDENTE",
                    TipoRepeticao = "UmaVez"
                }, false);
            }

            var tipo = audioGravado != null ? "tipo=audio"
                     : VideoGravado != null ? "tipo=video"
                     : AnexoBytes != null ? "tipo=arquivo"
                     : "tipo=texto";

            await RecarregarAnotacoes();

            var chaveAnterior = ChaveRascunho;
            LimparCompositor();
            await DefinirTextoCampo("");
            if (!string.IsNullOrWhiteSpace(chaveAnterior))
                await JS.InvokeVoidAsync("evolutCardUI.limparRascunho", chaveAnterior);

            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Info,
                $"Anotação adicionada ao card #{cardModel.Codigo} por {UserState.CurrentUser}", tipo);

            if (cardEraNovo)
            {
                ExibirMensagem("✅ Card criado e mensagem registrada.", true);
                await AposCriarCardNovo();
            }

            await InvokeAsync(StateHasChanged);
            await FocarCampoMensagem();
            return true;
        }
        catch (Exception ex)
        {
            cardModel.Anotacoes?.RemoveAll(a => a.IsNova);
            ExibirMensagem($"❌ Erro ao enviar mensagem: {ex.Message}", false);
            HealthMonitor.LogException(LogCategory.CRM, ex,
                $"AdicionarAnotacao card #{cardModel.Codigo} usuário {UserState.CurrentUser}");
            return false;
        }
        finally
        {
            enviandoAnotacao = false;
        }
    }

