            <div class="modal-buttons">
                <button type="button"
                        style="background:linear-gradient(135deg,#0891b2,#0e7490);color:#fff;
                               border:none;padding:9px 18px;border-radius:10px;font-weight:900;
                               cursor:pointer;font-size:.78rem;"
                        @onclick="ConfirmarCriarTicket"
                        disabled="@criandoTicket">
                    @(criandoTicket ? "Criando..." : "✅ Criar Ticket")
                </button>
                <button type="button"
                        style="background:#f8fbff;color:#1e3a8a;border:1.5px solid #dbeafe;
                               padding:9px 18px;border-radius:10px;font-weight:900;
                               cursor:pointer;font-size:.78rem;"
                        @onclick="FecharModalCriarTicket"
                        disabled="@criandoTicket">
                    Cancelar
                </button>
