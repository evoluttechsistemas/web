    private async Task AlternarGravacao()
    {
        if (!gravandoAudio)
        {
            gravandoAudio = true;
            await JS.InvokeVoidAsync("ticketAudio.start");
        }
        else
        {
            gravandoAudio = false;
            var retorno = await JS.InvokeAsync<AudioResult>("ticketAudio.stop");
            audioGravado = Convert.FromBase64String(retorno.base64);
            audioMimeType = retorno.mimeType;
            audioNomeArquivo = "audio_" + DateTime.Now.ToString("yyyyMMddHHmmss") + ".ogg";
            previewAudio = $"data:{audioMimeType};base64,{retorno.base64}";
        }
    }

