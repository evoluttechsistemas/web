    // ── Criar Ticket a partir do Card ──────────────────────────────────────
    private bool mostrarModalCriarTicket = false;
    private string modalCriarTicketUsuario = "NOVO";
    private string modalCriarTicketErro = "";
    private bool criandoTicket = false;

    private void AbrirModalCriarTicket()
    {
        modalCriarTicketUsuario = cardModel.Usuario ?? "NOVO";
        modalCriarTicketErro = "";
        mostrarModalCriarTicket = true;
    }

    private void FecharModalCriarTicket()
    {
        mostrarModalCriarTicket = false;
        modalCriarTicketErro = "";
    }

    private async Task ConfirmarCriarTicket()
    {
        if (criandoTicket) return;
        criandoTicket = true;
        modalCriarTicketErro = "";

        try
        {
            var codTicket = await CardService.CriarTicketAPartirDoCardAsync(
                cardModel.Codigo,
                modalCriarTicketUsuario,
                UserState.CurrentCompanyId);

            mostrarModalCriarTicket = false;
            ExibirMensagem($"✅ Ticket #{codTicket} criado no Suporte com sucesso!", true);
            HealthMonitor.Log(LogCategory.CRM, LogSeverity.Success,
                $"Ticket #{codTicket} criado a partir do card #{cardModel.Codigo}",
                $"responsavel={modalCriarTicketUsuario}");

            await Task.Delay(1500);
            Nav.NavigateTo($"/ticket/{codTicket}");
        }
        catch (Exception ex)
        {
            modalCriarTicketErro = $"❌ Erro ao criar ticket: {ex.Message}";
            HealthMonitor.LogException(LogCategory.CRM, ex,
                $"ConfirmarCriarTicket card #{cardModel.Codigo}");
        }
        finally
        {
            criandoTicket = false;
        }
    }

