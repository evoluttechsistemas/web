    private async Task BuscarClientes()
    {
        _ctsMensagem?.Cancel();
        _ctsMensagem = new CancellationTokenSource();
        var token = _ctsMensagem.Token;

        var termo = (ClienteBusca ?? "").Trim();
        if (termo.Length < 2)
        {
            Sugestoes.Clear();
            return;
        }

        try
        {
            await Task.Delay(250, token);
            var resultado = await CardService.BuscarClientesAsync(termo, UserState.CurrentCompanyId);
            if (!token.IsCancellationRequested)
                Sugestoes = resultado ?? new();
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao buscar clientes: {ex.Message}", false);
        }
    }

