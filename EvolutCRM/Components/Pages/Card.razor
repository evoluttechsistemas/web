        }
    }

    // =====================================================================
    // WHATSAPP
    // =====================================================================
    private async Task AbrirWhatsApp()
    {
        var numero = new string((TelefoneDoCard ?? "").Where(char.IsDigit).ToArray());

        while (numero.StartsWith("0"))
            numero = numero[1..];

        if (string.IsNullOrWhiteSpace(numero))
        {
            ExibirMensagem("❌ Informe um número de telefone antes de abrir o WhatsApp.", false);
            return;
        }

        if (!numero.StartsWith("55"))
            numero = "55" + numero;

        if (numero.Length != 12 && numero.Length != 13)
        {
            ExibirMensagem($"❌ Telefone inválido: {numero}. Use DDD + número (ex.: 17999999999).", false);
            return;
        }

        if (cardModel.Codigo > 0)
        {
            try { await CardService.RegistrarWhatsAsync(cardModel.Codigo, UserState.CurrentUser); }
            catch { }
        }

        await JS.InvokeVoidAsync("open", $"https://wa.me/{numero}", "_blank");
    }

