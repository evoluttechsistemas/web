    private void ExibirMensagem(string texto, bool ok)
    {
        Mensagem = texto;
        Sucesso = ok;
        _ = InvokeAsync(StateHasChanged);

        if (ok)
        {
            var textoExibido = texto;
            _ = Task.Run(async () =>
            {
                await Task.Delay(4000);
                if (Mensagem == textoExibido)
                {
                    Mensagem = "";
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
    }

