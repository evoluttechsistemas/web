    // =====================================================================
    // IA — sugestão de resposta (mesmo endpoint do ticket)
    // =====================================================================
    private async Task GerarRespostaIA()
    {
        CarregandoIA = true;
        _aiErro = "";

        try
        {
            var mensagens = (cardModel.Anotacoes ?? new List<AnotacaoModel>())
                .Where(x => x.MensagemExcluida != "S" && !EhInterna(x)
                            && (!string.IsNullOrWhiteSpace(x.Texto) || !string.IsNullOrWhiteSpace(x.TranscricaoAudio)))
                .OrderBy(x => x.DataHora)
                .ToList();

            var ultimaDoCliente = mensagens.LastOrDefault(x => x.EnvioCliente == "S");
            var textoAtual = await ObterTextoCampo();

            var pergunta = ultimaDoCliente != null
                ? (!string.IsNullOrWhiteSpace(ultimaDoCliente.Texto) ? ultimaDoCliente.Texto : ultimaDoCliente.TranscricaoAudio)
                : textoAtual;

            if (string.IsNullOrWhiteSpace(pergunta))
            {
                _aiErro = "Digite uma mensagem ou tenha uma mensagem do lead no histórico para gerar a resposta.";
                return;
            }

            var contexto = string.Join("\n", mensagens.TakeLast(25).Select(x =>
            {
                var autor = x.EnvioCliente == "S" ? "Cliente" : "Atendente comercial";
                var texto = !string.IsNullOrWhiteSpace(x.Texto)
                    ? x.Texto.Trim()
                    : $"[Áudio transcrito] {x.TranscricaoAudio?.Trim()}";

                if (texto.Length > 800)
                    texto = texto[..800] + "...";

                return $"[{x.DataHora:dd/MM HH:mm}] {autor}: {texto}";
            }));

            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };

            var resp = await http.PostAsJsonAsync("/api/help/suggest", new
            {
                message = pergunta,
                conversationContext = contexto
            });

            if (!resp.IsSuccessStatusCode)
            {
                var txt = await resp.Content.ReadAsStringAsync();
                _aiErro = $"Erro IA ({(int)resp.StatusCode}): {txt}";
                return;
            }

            var data = await resp.Content.ReadFromJsonAsync<AiChatResponse>();
            SugestaoIA = data?.Reply?.Trim() ?? "";

            if (string.IsNullOrWhiteSpace(SugestaoIA))
            {
                _aiErro = "A IA retornou vazio.";
                return;
            }

            await DefinirTextoCampo(SugestaoIA);
        }
        catch (Exception ex)
        {
            _aiErro = "Erro ao gerar resposta IA: " + ex.Message;
            HealthMonitor.LogException(LogCategory.CRM, ex, $"Card.GerarRespostaIA #{cardModel.Codigo}");
        }
        finally
        {
            CarregandoIA = false;
            StateHasChanged();
            await FocarCampoMensagem();
        }
    }

    // =====================================================================
    // DOCUMENTAÇÃO
    // =====================================================================
    private async Task BuscarDocumentacoes()
    {
        if (string.IsNullOrWhiteSpace(BuscaDoc) || BuscaDoc.Trim().Length < 3)
        {
            DocsEncontradas.Clear();
            return;
        }

        try
        {
            BuscandoDocs = true;
            StateHasChanged();

            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var result = await http.GetFromJsonAsync<List<DocSearchItem>>(
                $"/api/docs/search?q={Uri.EscapeDataString(BuscaDoc.Trim())}");

            DocsEncontradas = result ?? new();
        }
        catch
        {
            DocsEncontradas.Clear();
        }
        finally
        {
            BuscandoDocs = false;
            StateHasChanged();
        }
    }

    private async Task InserirUrlDocNaMensagem(DocSearchItem doc)
    {
        var texto = $"Segue a documentação: {doc.Title}\n{doc.Url}";
        var atual = await ObterTextoCampo();

        await DefinirTextoCampo(string.IsNullOrWhiteSpace(atual) ? texto : atual + "\n\n" + texto);

        BuscaDoc = "";
        DocsEncontradas.Clear();
        await FocarCampoMensagem();
    }

    private static IEnumerable<string> SepararUrlsDoTexto(string texto)
    {
        var regex = new System.Text.RegularExpressions.Regex(
            @"(https?://[^\s]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return regex.Split(texto).Where(p => !string.IsNullOrEmpty(p));
    }

