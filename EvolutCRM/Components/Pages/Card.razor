    private string TrechoParaCitacao(AnotacaoModel anot)
    {
        var (_, corpo) = SepararCitacao(anot.Texto);
        var trecho = !string.IsNullOrWhiteSpace(corpo) ? corpo
                   : !string.IsNullOrWhiteSpace(anot.TranscricaoAudio) ? $"🎧 {anot.TranscricaoAudio}"
                   : !string.IsNullOrWhiteSpace(anot.Audio) ? "🎧 Áudio"
                   : !string.IsNullOrWhiteSpace(anot.NomeImagem) ? $"📎 {anot.NomeImagem}"
                   : "Mensagem";

        trecho = trecho.Replace("\r", " ").Replace("\n", " ").Trim();
        return trecho.Length > 120 ? trecho[..120] + "..." : trecho;
    }

    /// <summary>
    /// Mensagens respondidas são gravadas como "> AUTOR: trecho\n\ntexto" (formato de citação do WhatsApp).
    /// Aqui separamos a citação do corpo para exibir igual ao ticket.
    /// </summary>
    private static ((string Usuario, string Texto) Citacao, string Corpo) SepararCitacao(string? texto)
    {
        texto ??= "";
        var normalizado = texto.Replace("\r\n", "\n");

        if (!normalizado.StartsWith("> "))
            return (("", ""), texto);

        var fim = normalizado.IndexOf("\n\n", StringComparison.Ordinal);
        if (fim < 0)
            return (("", ""), texto);

        var linhaCitacao = normalizado[2..fim].Trim();
        var corpo = normalizado[(fim + 2)..];

        var sep = linhaCitacao.IndexOf(": ", StringComparison.Ordinal);
        if (sep > 0 && sep < 60)
            return ((linhaCitacao[..sep], linhaCitacao[(sep + 2)..]), corpo);

        return (("", linhaCitacao), corpo);
    }

