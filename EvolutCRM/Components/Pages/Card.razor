        if (e.Key == "Enter" && !e.ShiftKey)
            await AdicionarAnotacao();
    }

    private async Task OnArquivoAnotacaoSelecionado(InputFileChangeEventArgs e)
    {
        ArquivoAnotacao = e.File;
        NomeArquivoAnotacao = ArquivoAnotacao.Name;
        PreviewArquivoAnotacao = "";

        try
        {
            var maxBytes = 15 * 1024 * 1024;
            using var stream = ArquivoAnotacao.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var contentType = string.IsNullOrWhiteSpace(ArquivoAnotacao.ContentType)
                ? "application/octet-stream"
                : ArquivoAnotacao.ContentType;

            PreviewArquivoAnotacao = $"data:{contentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            ExibirMensagem($"❌ Erro ao carregar anexo: {ex.Message}", false);
        }
    }

    private void RemoverArquivoAnotacao()
    {
        ArquivoAnotacao = null;
        NomeArquivoAnotacao = "";
        PreviewArquivoAnotacao = "";
        _imagemColadaBytes = null;
    }

    private void IniciarEdicaoMensagem(AnotacaoModel anotacao)
    {
        CodigoMensagemEditando = GetInt(anotacao, "Codigo");

        if (CodigoMensagemEditando == 0)
            CodigoMensagemEditando = anotacao.GetHashCode();

        TextoMensagemEditando = anotacao.Texto ?? "";
    }

    private async Task SalvarEdicaoMensagem()
    {
        var anotacao = EncontrarMensagemEditando();
        if (anotacao == null)
            return;

        anotacao.Texto = TextoMensagemEditando?.Trim() ?? "";
        SetProp(anotacao, "Alterado", "S");

        await SalvarHistoricoAtual();
        CancelarEdicaoMensagem();
        ExibirMensagem("✅ Mensagem editada com sucesso.", true);
        HealthMonitor.Log(LogCategory.CRM, LogSeverity.Info,
            $"Mensagem #{CodigoMensagemEditando} editada no card #{cardModel.Codigo} por {UserState.CurrentUser}");
    }

    private void CancelarEdicaoMensagem()
    {
        CodigoMensagemEditando = 0;
        TextoMensagemEditando = "";
    }

    private async Task ExcluirMensagem(AnotacaoModel anotacao)
    {
        SetProp(anotacao, "MensagemExcluida", "S");
        SetProp(anotacao, "Alterado", "S");
        await SalvarHistoricoAtual();
        ExibirMensagem("✅ Mensagem excluída.", true);
        HealthMonitor.Log(LogCategory.CRM, LogSeverity.Info,
            $"Mensagem excluída no card #{cardModel.Codigo} por {UserState.CurrentUser}");
    }

    private AnotacaoModel? EncontrarMensagemEditando()
    {
        if (cardModel.Anotacoes == null)
            return null;

        return cardModel.Anotacoes.FirstOrDefault(x =>
        {
            var codigo = GetInt(x, "Codigo");
            return (codigo > 0 && codigo == CodigoMensagemEditando) ||
                   (codigo == 0 && x.GetHashCode() == CodigoMensagemEditando);
        });
    }

    private bool AnotacaoEhDoUsuarioLogado(AnotacaoModel anotacao)
    {
        var usuarioAnotacao = ObterUsuarioAnotacao(anotacao);

        if (!string.IsNullOrWhiteSpace(usuarioAnotacao))
            return MesmoUsuario(usuarioAnotacao, UserState.CurrentUser);

        return anotacao.IsNova;
    }

    private string ObterUsuarioAnotacao(AnotacaoModel anotacao)
    {
        var prop = anotacao.GetType().GetProperty("Usuario");
        if (prop?.GetValue(anotacao) is string usuario)
            return usuario;
        return "";
    }

    private void DefinirUsuarioAnotacao(AnotacaoModel anotacao, string usuario)
    {
        SetProp(anotacao, "Usuario", usuario);
    }

    private bool MesmoUsuario(string? a, string? b)
    {
        return string.Equals((a ?? "").Trim(), (b ?? "").Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private string GetString(object obj, string propName)
    {
        var prop = obj.GetType().GetProperty(propName);
        var value = prop?.GetValue(obj);
        return value?.ToString() ?? "";
    }

    private int GetInt(object obj, string propName)
    {
        var prop = obj.GetType().GetProperty(propName);
        var value = prop?.GetValue(obj);

        if (value == null)
            return 0;

        if (value is int i)
            return i;

        int.TryParse(value.ToString(), out var result);
        return result;
    }

    private DateTime? GetNullableDate(object obj, string propName)
    {
        var prop = obj.GetType().GetProperty(propName);
        var value = prop?.GetValue(obj);

        if (value == null)
            return null;

        if (value is DateTime dt)
            return dt;

        if (DateTime.TryParse(value.ToString(), out var parsed))
            return parsed;

        return null;
    }

    private void SetProp(object obj, string propName, object? value)
    {
        var prop = obj.GetType().GetProperty(propName);
        if (prop == null || !prop.CanWrite)
            return;

        try
        {
            if (value == null)
            {
                prop.SetValue(obj, null);
                return;
            }

            var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;

            if (targetType == typeof(string))
                prop.SetValue(obj, value.ToString());
            else if (targetType == typeof(bool))
                prop.SetValue(obj, value is bool b ? b : value.ToString() == "S" || value.ToString()?.ToLower() == "true");
            else if (targetType == typeof(DateTime))
                prop.SetValue(obj, value is DateTime dt ? dt : DateTime.Parse(value.ToString()!));
            else if (targetType == typeof(int))
                prop.SetValue(obj, value is int i ? i : int.Parse(value.ToString()!));
            else
                prop.SetValue(obj, value);
        }
        catch
        {
            // Ignora propriedades incompatíveis para não quebrar a tela enquanto o model é ajustado.
        }
    }

    private string RenderStatusWhatsApp(string status)
    {
        var s = (status ?? "").Trim().ToLowerInvariant();

        return s switch
        {
            "" or "sending" or "pending" =>
                "<span style='color:#64748b; font-weight:700;'>🕓 Enviando...</span>",

            "sent" =>
                "<span style='color:#475569; font-weight:800;'>✓ Enviado</span>",

            "received" or "delivered" or "delivery_ack" or "delivered2user" =>
                "<span style='color:#16a34a; font-weight:800;'>✓✓ Entregue</span>",

            "read" or "read_ack" =>
                "<span style='color:#0ea5e9; font-weight:900;'>✓✓ Lido</span>",

            "error" or "failed" =>
                "<span style='color:#dc2626; font-weight:900;'>⚠ Erro no envio</span>",

            _ =>
                $"<span style='color:#64748b; font-weight:700;'>🕓 {status}</span>"
        };
    }

