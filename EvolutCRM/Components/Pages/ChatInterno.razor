<script>
    window.enablePasteImageChatInterno = function(textareaId, dotnetRef) {
        const el = document.getElementById(textareaId);

        if (!el) {
            console.warn('[PasteChat] textarea ainda não existe:', textareaId);
            return false;
        }

        if (el.dataset.pasteImageChatBound === '1') {
            return true;
        }

        el.dataset.pasteImageChatBound = '1';

        console.log('[PasteChat] textarea encontrado, registrando paste');

        el.addEventListener('paste', async function(e) {
            if (!e.clipboardData) return;

            const items = e.clipboardData.items;

            for (const item of items) {
                if (item.type && item.type.startsWith('image/')) {

                    e.preventDefault();

                    const file = item.getAsFile();
                    if (!file) return;

                    const reader = new FileReader();

                    reader.onload = async function(event) {
                        try {
                            const dataUrl = event.target.result;

                            await dotnetRef.invokeMethodAsync(
                                'ReceberImagemColada',
                                dataUrl,
                                file.name || 'print.png'
                            );

                            console.log('[PasteChat] imagem enviada ao Blazor');
                        }
                        catch (err) {
                            console.error('[PasteChat] Erro:', err);
                        }
                    };

                    reader.readAsDataURL(file);
                    return;
                }
            }
        });

        return true;
    };
</script>

@code {
    [Parameter] public bool IsVisible { get; set; } = true;
    private int _ultimoCodigoMensagem = 0;
    // ── State ──────────────────────────────────────
    private HashSet<int> codigosJaNotificados = new();
    private List<ChatInternoUsuarioModel> usuarios = new();
    private List<ChatInternoConversaModel> conversas = new();
    private List<ChatInternoMensagemModel> mensagens = new();
    private List<ChatInternoMensagemModel> resultadosBusca = new();
    private List<string> quemEstaDigitando = new();

    private ChatInternoConversaModel? conversaSelecionada;
    private ChatInternoMensagemModel? mensagemRespondendo;

    private ElementReference messagesContainer;
    private InputFile? fileInput;

    private string mensagem = "";
    private string nomeGrupo = "";
    private string termoBuscaConversa = "";
    private string termoBuscaMsgs = "";
    private string erroGrupo = "";
    private string? lightboxUrl;

    private double zoomImagem = 1.0;



    private void AbrirLightbox(string url)
    {
        lightboxUrl = url;
        zoomImagem = 1.0;
    }

    private void FecharLightbox()
    {
        lightboxUrl = null;
        zoomImagem = 1.0;
    }

    private void AumentarZoom()
    {
        zoomImagem = Math.Min(zoomImagem + 0.25, 5.0);
    }

    private void DiminuirZoom()
    {
        zoomImagem = Math.Max(zoomImagem - 0.25, 0.5);
    }

    private void ResetarZoom()
    {
        zoomImagem = 1.0;
    }

    private void ZoomComMouse(WheelEventArgs e)
    {
        if (e.DeltaY < 0)
            AumentarZoom();
        else
            DiminuirZoom();
    }

    private bool mostrarUsuarios = false;
    private bool mostrarGrupo = false;
    private bool mostrarInfoGrupo = false;
    private bool mostrarBuscaMsgs = false;
    private bool criandoGrupo = false;
    private bool uploadando = false;
    private bool somAtivo = true;
    private bool estaDigitando = false;

    private int totalNaoLidas = 0;
    private int uploadPct = 0;

    private List<string> usuariosGrupo = new();

    // context menu
    private ChatInternoConversaModel? contextoConversa;
    private double contextoX, contextoY;

    // digitando debounce
    private System.Timers.Timer? digitandoTimer;

    private PeriodicTimer? pollingTimer;
    private CancellationTokenSource? cts;

    // ── Computed ───────────────────────────────────
    private bool ConversaEhGrupo =>
        conversaSelecionada?.ChatTipo == "GRUPO";

    private string ConversaInicial =>
        string.IsNullOrWhiteSpace(conversaSelecionada?.Titulo) ? "?" :
        conversaSelecionada!.Titulo.Trim()[0].ToString().ToUpper();

    private List<string> ParticipantesGrupo =>
        (conversaSelecionada?.Participantes ?? "")
            .Split(';', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToUpper())
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private bool OutroEstaOnline
    {
        get
        {
            if (conversaSelecionada == null || ConversaEhGrupo) return false;
            return usuarios.Any(u => u.Online &&
                u.Usuario.Equals(conversaSelecionada.Titulo, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string UltimaVistoConversa
    {
        get
        {
            var u = usuarios.FirstOrDefault(x =>
                x.Usuario.Equals(conversaSelecionada?.Titulo, StringComparison.OrdinalIgnoreCase));
            return UltimaVisto(u?.UltimaAtividade);
        }
    }

    private IEnumerable<ChatInternoConversaModel> ConversasFiltradas =>
        string.IsNullOrWhiteSpace(termoBuscaConversa)
            ? conversas
            : conversas.Where(c => c.Titulo.Contains(termoBuscaConversa, StringComparison.OrdinalIgnoreCase) ||
                                   c.UltimaAnotacao.Contains(termoBuscaConversa, StringComparison.OrdinalIgnoreCase));

    // ── Lifecycle ──────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await CarregarTudo();

        cts = new CancellationTokenSource();
        pollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(4));

        // DEPOIS:
        _ = Task.Run(async () =>
        {
            try
            {
                int ciclo = 0;
                while (await pollingTimer.WaitForNextTickAsync(cts.Token))
                {
                    await InvokeAsync(async () =>
                    {
                        ciclo++;
                        await ChatService.AtualizarPresencaAsync(UserState.CurrentUser ?? "", CodEmp);

                        bool houveMudanca = false;

                        if (ciclo % 3 == 0)
                        {
                            var convAntes = conversas.Count;
                            await CarregarTudo(false);
                            if (conversas.Count != convAntes) houveMudanca = true;
                        }

                        // DEPOIS:
                        if (conversaSelecionada != null)
                        {
                            // resumo leve primeiro — igual ao Ticket
                            var resumo = await ChatService.ResumoMensagensAsync(conversaSelecionada.Codigo, CodEmp);

                            if (resumo.Total != mensagens.Count || resumo.UltimoCodigo != _ultimoCodigoMensagem)
                            {
                                var antes = mensagens.Select(m => m.Codigo).ToHashSet();
                                await CarregarMensagens(false);

                                var novas = mensagens.Where(m => !antes.Contains(m.Codigo)).ToList();

                                if (novas.Any())
                                {
                                    houveMudanca = true;
                                    _ultimoCodigoMensagem = resumo.UltimoCodigo;

                                    // DEPOIS — só marca como lida e scrolla se o usuário estiver vendo a aba
                                    if (IsVisible)
                                    {
                                        await ChatService.MarcarConversaComoLidaAsync(
                                            conversaSelecionada.Codigo, UserState.CurrentUser ?? "", CodEmp);
                                        await CarregarTudo(false);
                                        await ScrollParaFinalAsync();
                                    }
                                    else
                                    {
                                        // Atualiza a lista de conversas para o badge interno da sidebar do chat aparecer
                                        await CarregarTudo(false);
                                    }
                                }
                                else if (resumo.Total != mensagens.Count)
                                {
                                    // houve exclusão ou atualização de reação
                                    houveMudanca = true;
                                    _ultimoCodigoMensagem = resumo.UltimoCodigo;
                                }
                            }

                            var digitandoAntes = quemEstaDigitando.ToList();
                            quemEstaDigitando = await ChatService.ObterQuemEstaDigitandoAsync(
                                conversaSelecionada.Codigo, UserState.CurrentUser ?? "", CodEmp);

                            if (!quemEstaDigitando.SequenceEqual(digitandoAntes))
                                houveMudanca = true;
                        }

                        var novoTotal = await ChatService.ObterQuantidadeMensagensNaoLidasAsync(
                            UserState.CurrentUser ?? "", CodEmp);

                        if (novoTotal != totalNaoLidas)
                        {
                            totalNaoLidas = novoTotal;
                            houveMudanca = true;
                        }

                        if (houveMudanca && !estaDigitando)
                            StateHasChanged();
                    });
                }
            }
            catch { }
        });
    }

    public void Dispose()
    {
        cts?.Cancel();
        pollingTimer?.Dispose();
        cts?.Dispose();
        digitandoTimer?.Dispose();
        _dotNetRef?.Dispose();
    }

    // ── Carregamento ───────────────────────────────
    private async Task CarregarTudo(bool comReset = true)
    {
        var u = UserState.CurrentUser?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(u)) return;
        usuarios = await ChatService.ObterUsuariosAtivosAsync(u, CodEmp);
        conversas = await ChatService.ObterConversasAsync(u, CodEmp);
    }

    private async Task CarregarMensagens(bool scrollFinal = true)
    {
        if (conversaSelecionada == null) return;

        var usuarioAtual = UserState.CurrentUser?.Trim() ?? "";
        var antes = mensagens.ToList();
        mensagens = await ChatService.ObterMensagensAsync(conversaSelecionada.Codigo, usuarioAtual, CodEmp);

        // notificações apenas por mensagens novas (não na primeira carga)
        if (antes.Any())
        {
            var novas = mensagens
    .Where(x => !x.MinhaMensagem && !codigosJaNotificados.Contains(x.Codigo))
    .OrderBy(x => x.Codigo)
    .ToList();

            if (novas.Any())
            {
                foreach (var m in novas) codigosJaNotificados.Add(m.Codigo);

                // SÓ dispara toast/beep/blink se não for a conversa que está aberta agora
                bool conversaAberta = conversaSelecionada?.Codigo == (novas.FirstOrDefault()?.CodConversa ?? -1);
                if (!conversaAberta)
                {
                    var ultima = novas.Last();
                    var texto = ultima.Texto ?? "";
                    if (texto.Length > 80) texto = texto[..80] + "…";

                    await JS.InvokeVoidAsync("crmToast",
                        $"💬 {ultima.Usuario}: {texto}", "warning");

                    if (somAtivo)
                    {
                        await JS.InvokeVoidAsync("crmBeep", 320);
                        await JS.InvokeVoidAsync("crmNotifyPopup",
                            $"💬 Nova mensagem de {ultima.Usuario}", texto, "/images/logo-evoluttech.png");
                        await JS.InvokeVoidAsync("crmBlinkStart", $"💬 {ultima.Usuario}", 8);
                    }
                }
            }
        }
        else
        {
            // primeira carga: só registra os IDs já existentes
            foreach (var m in mensagens.Where(x => !x.MinhaMensagem))
                codigosJaNotificados.Add(m.Codigo);
        }

        await InvokeAsync(StateHasChanged);

        if (scrollFinal && !mostrarBuscaMsgs)
        {
            await Task.Delay(60);
            await ScrollParaFinalAsync();
        }
    }

    // ── Conversas ──────────────────────────────────
    private async Task AbrirConversa(ChatInternoConversaModel conv)
    {
        conversaSelecionada = conv;
        mensagemRespondendo = null;
        mostrarInfoGrupo = false;
        codigosJaNotificados.Clear();
        resultadosBusca.Clear();
        mensagens.Clear();
        _ultimoCodigoMensagem = 0;

        await ChatService.MarcarConversaComoLidaAsync(conv.Codigo, UserState.CurrentUser ?? "", CodEmp);
        await CarregarMensagens();
        await CarregarTudo(false);

        // Garante que o badge some imediatamente ao abrir a conversa
        totalNaoLidas = await ChatService.ObterQuantidadeMensagensNaoLidasAsync(
            UserState.CurrentUser ?? "", CodEmp);
        StateHasChanged();
    }

    private async Task AbrirChatIndividual(string usuarioDestino)
    {
        try
        {
            var u = UserState.CurrentUser?.Trim() ?? "";
            var cod = await ChatService.CriarConversaIndividualAsync(u, usuarioDestino, CodEmp);
            mostrarUsuarios = false;
            mostrarGrupo = false;

            await CarregarTudo(false);
            var conv = conversas.FirstOrDefault(x => x.Codigo == cod)
                       ?? new ChatInternoConversaModel
                       {
                           Codigo = cod,
                           Titulo = usuarioDestino.Trim().ToUpper(),
                           ChatTipo = "INDIVIDUAL",
                           Participantes = $";{u.ToUpper()};{usuarioDestino.ToUpper()};"
                       };

            await AbrirConversa(conv);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("crmToast", "Erro: " + ex.Message, "danger");
        }
    }

    private async Task CriarGrupo()
    {
        erroGrupo = "";
        if (criandoGrupo) return;
        if (string.IsNullOrWhiteSpace(nomeGrupo)) { erroGrupo = "Informe o nome do grupo."; return; }
        if (!usuariosGrupo.Any()) { erroGrupo = "Selecione pelo menos um usuário."; return; }
        try
        {
            criandoGrupo = true;
            var cod = await ChatService.CriarGrupoAsync(UserState.CurrentUser ?? "", nomeGrupo, usuariosGrupo, CodEmp);
            nomeGrupo = ""; usuariosGrupo.Clear(); mostrarGrupo = false;
            await CarregarTudo();
            var conv = conversas.FirstOrDefault(x => x.Codigo == cod);
            if (conv != null) await AbrirConversa(conv);
        }
        catch (Exception ex) { erroGrupo = "Erro: " + ex.Message; }
        finally { criandoGrupo = false; }
    }

