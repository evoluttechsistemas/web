        catch { return new(); }
    }

    private string UltimaVisto(DateTime? dt)
    {
        if (dt == null) return "Offline";
        var diff = DateTime.Now - dt.Value;
        if (diff.TotalMinutes < 2) return "Visto agora";
        if (diff.TotalMinutes < 60) return $"Visto há {(int)diff.TotalMinutes}min";
        if (diff.TotalHours < 24) return $"Visto às {dt.Value:HH:mm}";
        return $"Visto em {dt.Value:dd/MM}";
    }

    private string FormatarHora(DateTime dt)
    {
        if (dt.Date == DateTime.Today) return dt.ToString("HH:mm");
        if (dt.Date == DateTime.Today.AddDays(-1)) return "Ontem";
        return dt.ToString("dd/MM");
    }

    private string FormatarTamanho(long? bytes)
    {
        if (bytes == null) return "";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / (1024 * 1024):F1} MB";
    }

