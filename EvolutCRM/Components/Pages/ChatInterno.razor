                                var reacoes = ParseReacoes(msg.Reacoes);
                                @if (reacoes.Any())
                                {
                                    <div class="ct-reactions">
                                        @foreach (var kv in reacoes)
                                        {
                                            bool euReagi = kv.Value.Contains(UserState.CurrentUser ?? "", StringComparer.OrdinalIgnoreCase);
                                            <button class="@("ct-reaction " + (euReagi ? "mine" : ""))"
                                                    @onclick="() => Reagir(msg, kv.Key)"
