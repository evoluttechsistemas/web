    private async Task IniciarDigitando()
    {
        if (conversaSelecionada == null) return;

        if (!estaDigitando)
        {
            estaDigitando = true;
            await ChatService.SalvarDigitandoAsync(
                UserState.CurrentUser ?? "", conversaSelecionada.Codigo, true, CodEmp);
        }

        digitandoTimer?.Stop();
        digitandoTimer?.Dispose();
        digitandoTimer = new System.Timers.Timer(3000);
        digitandoTimer.Elapsed += async (_, _) => await PararDigitando();
        digitandoTimer.AutoReset = false;
        digitandoTimer.Start();
    }

    private async Task PararDigitando()
    {
        if (!estaDigitando || conversaSelecionada == null) return;
        estaDigitando = false;
        digitandoTimer?.Stop();
        await ChatService.SalvarDigitandoAsync(
            UserState.CurrentUser ?? "", conversaSelecionada.Codigo, false, CodEmp);
    }

