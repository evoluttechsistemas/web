    private async Task EnviarMensagem()
    {
        if (conversaSelecionada == null || string.IsNullOrWhiteSpace(mensagem)) return;

        var texto = mensagem.Trim();
        mensagem = "";

        await ChatService.EnviarMensagemAsync(
            conversaSelecionada.Codigo,
            UserState.CurrentUser ?? "",
            texto, CodEmp,
            respostaCodigo: mensagemRespondendo?.Codigo,
            respostaUsuario: mensagemRespondendo?.Usuario,
            respostaTexto: mensagemRespondendo?.Texto);

        mensagemRespondendo = null;
        await PararDigitando();

        await JS.InvokeVoidAsync("eval",
        "var t=document.getElementById('ct-textarea');if(t)t.value='';");
        await CarregarMensagens();
        await CarregarTudo(false);
    }

