    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
       
        if (_dotNetRef == null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
        }

        if (conversaSelecionada != null)
        {
            try
            {
                await JS.InvokeAsync<bool>(
                    "enablePasteImageChatInterno",
                    "ct-textarea",
                    _dotNetRef
                );
            }
            catch
            {
                // textarea ou JS ainda não disponível;
                // tenta novamente no próximo render
            }
        }
    }

