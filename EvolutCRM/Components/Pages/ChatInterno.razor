    private void SelecionarUsuarioGrupo(string usuario, ChangeEventArgs e)
    {
        usuario = usuario.Trim();
        bool marcado = e.Value is bool b && b;
        if (marcado)
        {
            if (!usuariosGrupo.Any(x => x.Equals(usuario, StringComparison.OrdinalIgnoreCase)))
                usuariosGrupo.Add(usuario);
        }
        else
        {
            usuariosGrupo.RemoveAll(x => x.Equals(usuario, StringComparison.OrdinalIgnoreCase));
        }
    }

