                    <!-- digitando -->
                    @if (quemEstaDigitando.Any())
                    {
                        <div class="ct-typing-row">
                            <div class="ct-typing-bubble">
                                <span class="ct-typing-name">@string.Join(", ", quemEstaDigitando)</span>
                                <div class="ct-typing-dots">
                                    <span></span><span></span><span></span>
