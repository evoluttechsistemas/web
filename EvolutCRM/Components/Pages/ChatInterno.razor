    [JSInvokable]
    public async Task ReceberImagemColada(string dataUrl, string nomeArquivo)
    {
        if (conversaSelecionada == null)
            return;

        if (string.IsNullOrWhiteSpace(dataUrl))
            return;

        if (!dataUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
            return;

        var indiceVirgula = dataUrl.IndexOf(',');

        if (indiceVirgula < 0)
            return;

        var cabecalho = dataUrl[..indiceVirgula];
        var base64 = dataUrl[(indiceVirgula + 1)..];

        // Exemplo:
        // data:image/png;base64
        var mime = cabecalho
            .Replace("data:", "")
            .Split(';')[0];

        var bytes = Convert.FromBase64String(base64);

        var nome = string.IsNullOrWhiteSpace(nomeArquivo)
            ? "print.png"
            : nomeArquivo;

        // Garante extensão caso o clipboard não informe
        if (string.IsNullOrWhiteSpace(Path.GetExtension(nome)))
        {
            var extensao = mime.ToLowerInvariant() switch
            {
                "image/jpeg" => ".jpg",
                "image/png" => ".png",
                "image/gif" => ".gif",
                "image/webp" => ".webp",
                "image/bmp" => ".bmp",
                _ => ".png"
            };

            nome += extensao;
        }

        using var stream = new MemoryStream(bytes);

        await EnviarArquivo(
            stream,
            nome,
            mime
        );

        await InvokeAsync(StateHasChanged);
    }

    private async Task EnviarArquivo(Stream stream, string nome, string contentType)
    {
        if (conversaSelecionada == null) return;

        try
        {
            uploadando = true; uploadPct = 10; StateHasChanged();

            var (url, nomeArq, tipo, tamanho) = await ChatService.SalvarArquivoAsync(stream, nome, contentType);

            uploadPct = 80; StateHasChanged();

            bool ehImagem = contentType.StartsWith("image/");

            await ChatService.EnviarMensagemAsync(
                conversaSelecionada.Codigo,
                UserState.CurrentUser ?? "",
                texto: "",
                CodEmp,
                tipo: ehImagem ? "IMAGE" : "FILE",
                arquivoNome: nomeArq,
                arquivoUrl: url,
                arquivoMime: tipo,
                arquivoTamanho: tamanho);

            uploadPct = 100; StateHasChanged();
            await CarregarMensagens();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("crmToast", "Erro ao enviar arquivo: " + ex.Message, "danger");
        }
        finally
        {
            await Task.Delay(400);
            uploadando = false; uploadPct = 0; StateHasChanged();
        }
    }

