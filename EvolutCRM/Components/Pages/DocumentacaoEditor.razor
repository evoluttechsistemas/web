    private async Task<string> SalvarArquivoImagem(IBrowserFile arquivo, string extensao, string subpasta = "imagens")
    {
        var pastaFisica = Path.Combine(@"C:\FTP\Site\Help\wwwroot\uploads\documentacoes", subpasta);
        var pastaRelativa = $"uploads/documentacoes/{subpasta}";
        Directory.CreateDirectory(pastaFisica);

        var nomeArquivo = $"{Guid.NewGuid():N}{extensao}";
        var caminhoFisico = Path.Combine(pastaFisica, nomeArquivo);

        await using var stream = arquivo.OpenReadStream(MaxImagemBytes);
        await using var fs = File.Create(caminhoFisico);
        await stream.CopyToAsync(fs);

        return $"/{pastaRelativa}/{nomeArquivo}";
    }

    private void GerarSlugSeVazio()
    {
        if (!string.IsNullOrWhiteSpace(tutorial.Slug) || string.IsNullOrWhiteSpace(tutorial.Titulo)) return;

        tutorial.Slug = tutorial.Titulo
            .ToLowerInvariant()
            .Normalize(System.Text.NormalizationForm.FormD);

        tutorial.Slug = new string(tutorial.Slug
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) !=
                        System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray());

        tutorial.Slug = System.Text.RegularExpressions.Regex.Replace(tutorial.Slug, "[^a-z0-9]+", "-").Trim('-');
    }

