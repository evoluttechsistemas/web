    private async Task TriggerThumbnailInput()
    {
        await JS.InvokeVoidAsync("deTriggerFile", "thumb-input");
    }

    private async Task OnThumbnailSelecionada(InputFileChangeEventArgs e)
    {
        var arquivo = e.File;
        if (arquivo == null || arquivo.Size > MaxImagemBytes)
        {
            MostrarMensagem("Imagem muito grande (máx 8 MB).", "error");
            return;
        }

        var ext = Path.GetExtension(arquivo.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp" or ".gif"))
        {
            MostrarMensagem("Use imagem em JPG, PNG, WebP ou GIF.", "error");
            return;
        }

        await using var stream = arquivo.OpenReadStream(MaxImagemBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        tutorial.Thumbnail = ms.ToArray();
        tutorial.ThumbnailMime = arquivo.ContentType;

        // Preview temporário apenas para exibir na tela — NÃO vai para o banco
        var base64 = Convert.ToBase64String(tutorial.Thumbnail);
        _thumbnailPreview = $"data:{tutorial.ThumbnailMime};base64,{base64}";
        tutorial.UrlThumbnail = ""; // limpa para não tentar salvar no campo pequeno
        StateHasChanged();
    }

    private void RemoverThumbnail()
    {
        tutorial.UrlThumbnail = "";
        tutorial.Thumbnail = null;
        tutorial.ThumbnailMime = null;
        _thumbnailPreview = "";
        StateHasChanged();
    }

    private static string ObterInicial(string texto)
        => string.IsNullOrWhiteSpace(texto) ? "D" : texto.Trim()[0].ToString().ToUpperInvariant();
