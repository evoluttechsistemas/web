                        Valor: <strong>@ClienteCobrancaSelecionado?.ValorTotalComJuros.ToString("C")</strong>
                    </p>

                    <div style="background:var(--surface-2); border:1.5px solid var(--border);
                        border-radius:14px; padding:12px 14px; margin-bottom:16px;
                        word-break:break-all; font-size:12px; color:var(--text-2);
                        font-family:'JetBrains Mono',monospace; line-height:1.6;">
                        @LinkPixGerado
                    </div>

                    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;">
                        <button class="btn-save-permissions"
                                style="background:linear-gradient(135deg,#7c3aed,#5b21b6);"
                                @onclick="CopiarLinkPix">
                            📋 Copiar Link
                        </button>

                        <a href="@LinkPixGerado" target="_blank"
                           style="display:inline-flex; align-items:center; gap:6px; padding:0 18px;
                            min-height:44px; border-radius:15px;
                            background:linear-gradient(135deg,#0d47a1,#1565c0);
                            color:white; font-size:12.5px; font-weight:900; text-decoration:none;
                            box-shadow:0 11px 26px rgba(13,71,161,.23);">
                            🔗 Abrir Link
                        </a>

                        @if (!string.IsNullOrWhiteSpace(ClienteCobrancaSelecionado?.Celular))
                        {
                            <button style="display:inline-flex; align-items:center; gap:6px; padding:0 18px;
                                min-height:44px; border-radius:15px;
                                background:linear-gradient(135deg,#059669,#047857);
                                color:white; font-size:12.5px; font-weight:900; border:none; cursor:pointer;
                                box-shadow:0 11px 26px rgba(5,150,105,.23);"
