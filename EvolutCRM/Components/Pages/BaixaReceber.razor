                    <div style="display:flex; justify-content:flex-end;">
                        <button class="admin-tab" style="padding:10px 20px;"
                                @onclick="() => MostrarModalPix = false">
                            Fechar
                        </button>
                    </div>
                </div>
            </div>
        }

    }
</div>

@if (MostrarFormBaixa)
{
    <div class="modal-baixa-backdrop">
        <div class="modal-baixa-content">

            <h3 style="margin:0 0 4px; font-size:16px; font-weight:800; color:var(--text);">
                💰 Confirmar Baixa
            </h3>
            <p style="margin:0 0 20px; font-size:12px; color:var(--muted);">
                @TitulosSelecionados.Count título(s) —
                Cliente: <strong>@ClienteSelecionadoBaixa?.NomeCliente</strong>
            </p>

            <div style="background:var(--surface-2); border:1.5px solid var(--border);
                border-radius:var(--radius-sm); padding:12px; margin-bottom:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                    <span style="font-size:11px; color:var(--muted); font-weight:600;">Valor dos títulos</span>
                    <span style="font-size:13px; font-weight:700; font-family:'JetBrains Mono',monospace;">@ValorTotalBaixa.ToString("C")</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                    <span style="font-size:11px; color:var(--muted); font-weight:600;">Acréscimo</span>
                    <span style="font-size:13px; font-weight:700; color:var(--danger); font-family:'JetBrains Mono',monospace;">@AcrescimoValor.ToString("C")</span>
                </div>
                <div style="display:flex; justify-content:space-between; border-top:1.5px solid var(--border); padding-top:8px; margin-top:4px;">
                    <span style="font-size:12px; color:var(--text); font-weight:700;">Total a receber</span>
                    <span style="font-size:15px; font-weight:800; color:var(--success); font-family:'JetBrains Mono',monospace;">@((ValorTotalBaixa + AcrescimoValor).ToString("C"))</span>
                </div>
            </div>

            <div style="margin-bottom:14px;">
                <label style="display:block; font-size:11px; font-weight:700; color:var(--muted);
                    margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em;">
                    Forma de Pagamento
                </label>
                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px;">
                    @foreach (var forma in new[] { "Dinheiro", "Cheque à Vista", "Cheque a Prazo", "Cartão", "PIX", "Ticket" })
                    {
                        <button style="border:1.5px solid @(FormaPagamento == forma ? "var(--primary-2)" : "var(--border)");
                            background:@(FormaPagamento == forma ? "var(--primary-soft)" : "var(--surface-2)");
                            color:@(FormaPagamento == forma ? "var(--primary)" : "var(--muted)");
                            padding:8px 6px; border-radius:var(--radius-sm);
                            font-size:11px; font-weight:700; cursor:pointer;
                            font-family:'Sora',sans-serif; transition:.15s;"
                                @onclick="() => FormaPagamento = forma">
                            @forma
                        </button>
                    }
                </div>
            </div>

            @if (FormaPagamento.StartsWith("Cheque"))
            {
                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--muted);
                        margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em;">
                        Número do Cheque
                    </label>
                    <input class="admin-input" placeholder="Nº do cheque..." @bind="NumeroCheque" />
                </div>
            }

            <div style="margin-bottom:14px;">
                <label style="display:block; font-size:11px; font-weight:700; color:var(--muted);
                    margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em;">
                    Acréscimo / Juros (R$)
                </label>
                <input class="admin-input" type="number" min="0" step="0.01" placeholder="0,00"
                       value="@AcrescimoValor.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onchange="e => AcrescimoValor = decimal.TryParse(
                                                                               e.Value?.ToString(),
                                                                               System.Globalization.NumberStyles.Any,
                                                                               System.Globalization.CultureInfo.InvariantCulture,
                                                                               out var v) ? v : 0m" />
</div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--muted);
                        margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em;">
                        Data do Pagamento
                    </label>
                    <input class="admin-input" type="date"
                           value="@DataPagamentoBaixa.ToString("yyyy-MM-dd")"
                           @onchange="e => DataPagamentoBaixa = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : DateTime.Today" />
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--muted);
                        margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em;">
                        Data de Compensação
                    </label>
                    <input class="admin-input" type="date"
                           value="@DataCompensacaoBaixa.ToString("yyyy-MM-dd")"
                           @onchange="e => DataCompensacaoBaixa = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : DateTime.Today" />
                </div>
            </div>

            <div style="margin-bottom:20px;">
                <label style="display:block; font-size:11px; font-weight:700; color:var(--muted);
                    margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em;">
                    Conta Bancária (opcional)
                </label>
                <select class="admin-input"
                        @onchange="e => CodContaSelecionada = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : Convert.ToInt32(e.Value)">
                    <option value="">— Sem conta bancária —</option>
                    @foreach (var cb in ContasBancarias)
                    {
                        <option value="@cb.Codigo">@cb.ExibicaoCombo</option>
                    }
                </select>
            </div>

            @if (!string.IsNullOrWhiteSpace(MensagemBaixa))
            {
                <div style="background:var(--danger-soft); border:1.5px solid #fca5a5;
                    border-radius:var(--radius-sm); padding:10px 14px;
                    color:var(--danger); font-size:12px; font-weight:600; margin-bottom:14px;">
                    @MensagemBaixa
                </div>
            }

            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <button class="admin-tab" style="padding:10px 18px;"
                        @onclick="FecharFormBaixa" disabled="@ExecutandoBaixa">
                    Cancelar
                </button>
                <button class="btn-save-permissions"
                        style="background:linear-gradient(135deg,#059669,#047857);"
                        @onclick="ConfirmarBaixa" disabled="@ExecutandoBaixa">
                    @(ExecutandoBaixa ? "Processando..." : "✅ Confirmar Baixa")
                </button>
            </div>
        </div>
    </div>
}


@code {
    // ── PIX MERCADO PAGO ──
    private bool GerandoLinkPix = false;
    private string LinkPixGerado = "";
    private string ErroLinkPix = "";
    private bool MostrarModalPix = false;


    private bool Carregando = true;
    private bool PodeAcessarAdmin = false;
    private string MensagemPermissao = "";

    private string FiltroVersoes = "";
    private string FiltroStatusVersao = "todos";
    private string VersaoAtualEsperada = "";


    private IEnumerable<CobrancaClienteDto> ClientesCobrancaFiltrados =>
        string.IsNullOrWhiteSpace(FiltroCobranca)
            ? ClientesCobranca
            : ClientesCobranca.Where(c =>
                c.CodCliente.ToString().Contains(FiltroCobranca)
                || (c.NomeCliente ?? "").Contains(FiltroCobranca, StringComparison.OrdinalIgnoreCase)
                || (c.Apelido ?? "").Contains(FiltroCobranca, StringComparison.OrdinalIgnoreCase));

    // ── FORMULÁRIO DE BAIXA ──
    private bool MostrarFormBaixa = false;
    private List<ContaBancariaDto> ContasBancarias = new();
    private string FormaPagamento = "Dinheiro";
    private decimal AcrescimoValor = 0;
    private DateTime DataPagamentoBaixa = DateTime.Today;
    private DateTime DataCompensacaoBaixa = DateTime.Today;
    private int? CodContaSelecionada = null;
    private string NumeroCheque = "";
    private bool ExecutandoBaixa = false;
    private string MensagemBaixa = "";

    private List<int> TitulosSelecionados =>
        ContasReceber.Where(c => c.Selecionado && c.DataPagamento == null)
                     .Select(c => c.Codigo)
                     .ToList();

    private decimal ValorTotalBaixa =>
        ContasReceber.Where(c => c.Selecionado && c.DataPagamento == null)
                     .Sum(c => c.Valor ?? 0);
    // ── BAIXA RECEBER ──
    private string FiltroBuscaCliente = "";
    private List<BaixaReceberClienteDto> ResultadoBuscaClientes = new();
    private BaixaReceberClienteDto? ClienteSelecionadoBaixa = null;
    private List<ContaReceberDto> ContasReceber = new();
    private string SituacaoFiltro = "abertos"; // abertos | pagos | todos
    private bool BuscandoCliente = false;
    private bool CarregandoContas = false;

    private decimal TotalSelecionado => ContasReceber
        .Where(c => c.Selecionado)
        .Sum(c => c.Valor ?? 0);

    private decimal TotalSelecionadoComJuros => ContasReceber
        .Where(c => c.Selecionado)
        .Sum(c => c.ValorComJuros);

    // ── SUB-ABA ADMINISTRAR CLIENTES ──
    private string SubAbaAdminClientes = "baixa-receber"; // "baixa-receber" | "cobranca"

    // ── COBRANÇA ──
    private List<CobrancaClienteDto> ClientesCobranca = new();
    private CobrancaClienteDto? ClienteCobrancaSelecionado = null;
    private List<CobrancaTituloDto> TitulosCobranca = new();
    private bool CarregandoCobranca = false;
    private string FiltroCobranca = "";
    private string MensagemCobranca = "";

    protected override async Task OnInitializedAsync()
    {
        Carregando = true;
        MensagemPermissao = "";

        try
        {
            int tentativas = 0;

            while (!UserState.IsReady && tentativas < 100)
            {
                await Task.Delay(50);
                tentativas++;
            }

            if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser))
            {
                PodeAcessarAdmin = false;
                MensagemPermissao = "Usuário ainda não foi carregado. Atualize a página.";
                return;
            }

            var usuarioLogado = UserState.CurrentUser.Trim().ToUpperInvariant();

            PodeAcessarAdmin = await AdminService.UsuarioTemPermissaoAsync(
                usuarioLogado,
                "ADMIN_ACESSAR"
            );

            if (!PodeAcessarAdmin)
            {
                MensagemPermissao = "Você não tem permissão para acessar esta tela.";
                return;
            }

        }
        catch (Exception ex)
        {
            MensagemPermissao = "Erro ao carregar controle de versões: " + ex.Message;
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task BuscarClientesBaixa()
    {
        if (string.IsNullOrWhiteSpace(FiltroBuscaCliente)) return;
        BuscandoCliente = true;
        ResultadoBuscaClientes = await bxClienteService.BuscarClientesParaBaixaAsync(FiltroBuscaCliente);
        BuscandoCliente = false;
    }

    private async Task SelecionarClienteBaixa(BaixaReceberClienteDto cliente)
    {
        ClienteSelecionadoBaixa = cliente;
        ResultadoBuscaClientes = new();
        await CarregarContasReceber();
    }

    private async Task CarregarContasReceber()
    {
        if (ClienteSelecionadoBaixa == null) return;
        CarregandoContas = true;
        ContasReceber = await bxClienteService.ListarContasReceberClienteAsync(
    ClienteSelecionadoBaixa.Codigo, SituacaoFiltro);
        CarregandoContas = false;
    }

    private void SelecionarTodosAbertos(bool valor)
    {
        foreach (var c in ContasReceber.Where(x => x.DataPagamento == null))
            c.Selecionado = valor;
    }

    private async Task AbrirFormBaixa()
    {
        if (!TitulosSelecionados.Any())
        {
            MensagemBaixa = "Selecione ao menos um título em aberto.";
            return;
        }

        MensagemBaixa = "";
        FormaPagamento = "Dinheiro";
        DataPagamentoBaixa = DateTime.Today;
        DataCompensacaoBaixa = DateTime.Today;
        CodContaSelecionada = null;
        NumeroCheque = "";

        // ← Pré-preenche o acréscimo com os juros já calculados
        // (diferença entre ValorComJuros e Valor dos títulos selecionados)
        AcrescimoValor = ContasReceber
            .Where(c => c.Selecionado && c.DataPagamento == null)
            .Sum(c => c.ValorComJuros - (c.Valor ?? 0));

        // Arredonda para 2 casas
        AcrescimoValor = Math.Round(AcrescimoValor, 2);

        if (!ContasBancarias.Any())
            ContasBancarias = await bxClienteService.ListarContasBancariasAsync();

        MostrarFormBaixa = true;
    }

    private void FecharFormBaixa()
    {
        MostrarFormBaixa = false;
        MensagemBaixa = "";
    }

    private async Task ConfirmarBaixa()
    {
        if (!TitulosSelecionados.Any()) return;

        ExecutandoBaixa = true;
        MensagemBaixa = "";

        var input = new BaixaReceberInputDto
        {
            CodigosContaReceber = TitulosSelecionados,
            NomeCliente = ClienteSelecionadoBaixa?.NomeCliente ?? "",
            DataPagamento = DataPagamentoBaixa,
            DataCompensacao = DataCompensacaoBaixa,
            ValorTotal = ValorTotalBaixa,
            Acrescimo = AcrescimoValor,
            FormaPagamento = FormaPagamento,
            CodContaBancaria = CodContaSelecionada,
            NumeroCheque = NumeroCheque
        };

        var usuarioLogado = UserState.CurrentUser?.Trim().ToUpper() ?? "ADMIN";
        var resultado = await bxClienteService.ExecutarBaixaReceberAsync(input, usuarioLogado);

        ExecutandoBaixa = false;

        if (resultado == "ok")
        {
            MostrarFormBaixa = false;
            MensagemBaixa = "✅ Baixa realizada com sucesso!";
            await CarregarContasReceber();

            var detalhe = $"{FormaPagamento} · {TitulosSelecionados.Count} título(s) · " +
                          $"Valor: {ValorTotalBaixa:C} · Juros: {AcrescimoValor:C} · " +
                          $"Cliente: {input.NomeCliente}";

            await LogFinanceiroService.RegistrarAsync(
    usuario: UserState.CurrentUser?.Trim() ?? "",
    codEmp: UserState.CurrentCompanyId,
    nomeEmpresa: UserState.CurrentCompany,
    tipoEvento: LogFinanceiroService.BAIXA_TITULO,
    detalhe: detalhe,
    ip: null);
        }
        else
        {
            MensagemBaixa = $"❌ Erro: {resultado}";
        }
    }

    private async Task CarregarClientesCobranca()
    {
        CarregandoCobranca = true;
        ClientesCobranca = await bxClienteService.ListarClientesCobrancaAsync();
        ClienteCobrancaSelecionado = null;
        TitulosCobranca = new();
        CarregandoCobranca = false;
    }

    private async Task SelecionarClienteCobranca(CobrancaClienteDto cliente)
    {
        ClienteCobrancaSelecionado = cliente;
        TitulosCobranca = await bxClienteService.ListarTitulosCobrancaClienteAsync(cliente.CodCliente);

        // ← recalcula com juros já aplicados pelo DTO
        ClienteCobrancaSelecionado.ValorTotalComJuros = TitulosCobranca.Sum(t => t.ValorComJuros);
    }

    private string GerarMensagemCobranca()
    {
        if (ClienteCobrancaSelecionado == null) return "";

        var nome = !string.IsNullOrWhiteSpace(ClienteCobrancaSelecionado.Apelido)
            ? ClienteCobrancaSelecionado.Apelido
            : ClienteCobrancaSelecionado.NomeCliente;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Olá, {nome} tudo bem?");
        sb.AppendLine("Ainda não identificamos o pagamento dos títulos a seguir:");
        sb.AppendLine();

        foreach (var t in TitulosCobranca)
            sb.AppendLine($"Valor: {t.ValorComJuros:C} | Vencimento: {t.DataVencimento:dd/MM/yyyy} | {t.DiasAtraso} dia(s) em atraso");

        sb.AppendLine();
        sb.AppendLine($"Total: {TitulosCobranca.Sum(t => t.ValorComJuros):C}");
        sb.AppendLine();
        sb.AppendLine("Qualquer dúvida, estou à disposição!");

        return sb.ToString();
    }

    private string GerarLinkWhatsappCobranca()
    {
        if (ClienteCobrancaSelecionado == null) return "#";
        var celular = new string(ClienteCobrancaSelecionado.Celular.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(celular)) return "#";
        if (!celular.StartsWith("55")) celular = "55" + celular;
        var mensagem = Uri.EscapeDataString(GerarMensagemCobranca());
        return $"https://wa.me/{celular}?text={mensagem}";
    }

    private async Task AbrirSubAbaCobranca()
    {
        SubAbaAdminClientes = "cobranca";
        await CarregarClientesCobranca();
    }

    private void AbrirSubAbaBaixaReceber()
    {
        SubAbaAdminClientes = "baixa-receber";
    }

    private string GerarLinkWhatsappLembrete()
    {
        if (ClienteCobrancaSelecionado == null) return "#";
        var celular = new string(ClienteCobrancaSelecionado.Celular.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(celular)) return "#";
        if (!celular.StartsWith("55")) celular = "55" + celular;

        var nome = !string.IsNullOrWhiteSpace(ClienteCobrancaSelecionado.Apelido)
            ? ClienteCobrancaSelecionado.Apelido
            : ClienteCobrancaSelecionado.NomeCliente;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Olá, {nome} tudo bem?");
        sb.AppendLine("Passando apenas para lembrar dos títulos a seguir:");
        sb.AppendLine();

        foreach (var t in TitulosCobranca)
            sb.AppendLine($"Valor: {t.ValorComJuros:C} | Vencimento: {t.DataVencimento:dd/MM/yyyy}");

        sb.AppendLine();
        sb.AppendLine($"Total: {TitulosCobranca.Sum(t => t.ValorComJuros):C}");
        sb.AppendLine();
        sb.AppendLine("Caso já tenha sido pago, favor desconsiderar!");
        sb.AppendLine("Qualquer dúvida, estou à disposição!");

        return $"https://wa.me/{celular}?text={Uri.EscapeDataString(sb.ToString())}";
    }

    private async Task OnBuscaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await BuscarClientesBaixa();
    }

    private string FormatarData(object? data)
    {
        if (data == null)
            return "-";

        if (data is DateTime dt)
            return dt.ToString("dd/MM/yyyy");

        if (data is TimeOnly time)
            return time.ToString("HH:mm");

        return data.ToString() ?? "-";
    }

    private async Task GerarLinkPix()
    {
        if (ClienteCobrancaSelecionado == null) return;

        GerandoLinkPix = true;
        LinkPixGerado = "";
        ErroLinkPix = "";
        MostrarModalPix = false;

        try
        {
            var config = await bxClienteService.ObterConfigMercadoPagoAsync();

            if (config == null || string.IsNullOrWhiteSpace(config.TokenMercadoPago))
            {
                ErroLinkPix = "Configuração do Mercado Pago não encontrada. Verifique o cadastro.";
                return;
            }

            var nome = !string.IsNullOrWhiteSpace(ClienteCobrancaSelecionado.Apelido)
                ? ClienteCobrancaSelecionado.Apelido
                : ClienteCobrancaSelecionado.NomeCliente;

            var listaTitulos = string.Join(", ", TitulosCobranca.Select(t => t.Codigo.ToString()));
            var descricao = $"Mensalidade cliente: {nome} Títulos: {listaTitulos}";

            var resultado = await bxClienteService.GerarLinkPagamentoMercadoPagoAsync(
    valor: ClienteCobrancaSelecionado.ValorTotalComJuros,
                descricao: descricao,
                emailPagador: config.EmailMercadoPago,
                cpfPagador: config.CPFMercadoPago,
                nomePagador: nome,
                token: config.TokenMercadoPago
            );

            if (resultado.StartsWith("ERRO:"))
            {
                ErroLinkPix = resultado.Replace("ERRO:", "Erro ao gerar PIX: ");
                return;
            }

            LinkPixGerado = resultado;
            MostrarModalPix = true;

            var titulos = string.Join(", ", TitulosCobranca.Select(t => t.Codigo.ToString()));
            var detalhe = $"Títulos: {titulos} · Valor: {ClienteCobrancaSelecionado!.ValorTotalComJuros:C} · " +
                          $"Cliente: {ClienteCobrancaSelecionado.NomeCliente}";

            await LogFinanceiroService.RegistrarAsync(
    usuario: UserState.CurrentUser?.Trim() ?? "",
    codEmp: UserState.CurrentCompanyId,
    nomeEmpresa: UserState.CurrentCompany,
    tipoEvento: LogFinanceiroService.PIX_GERADO,
    detalhe: detalhe,
    ip: null);
        }
        finally
        {
            GerandoLinkPix = false;
        }
    }

    private string GerarLinkWhatsappComPix()
    {
        if (ClienteCobrancaSelecionado == null || string.IsNullOrWhiteSpace(LinkPixGerado)) return "#";

        var celular = new string(ClienteCobrancaSelecionado.Celular.Where(char.IsDigit).ToArray());
        if (!celular.StartsWith("55")) celular = "55" + celular;

        var mensagem = GerarMensagemCobranca() + $"\n\n🔗 Link para pagamento PIX:\n{LinkPixGerado}";
        return $"https://wa.me/{celular}?text={Uri.EscapeDataString(mensagem)}";
    }

    private async Task CopiarLinkPix()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", LinkPixGerado);
    }

