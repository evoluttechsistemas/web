</style>


<div class="admin-card">
   

    @* SUB-ABAS *@
    <div class="admin-tabs" style="margin-bottom:20px;">
        <button class="@(SubAbaAdminClientes == "baixa-receber" ? "admin-tab active" : "admin-tab")"
                @onclick="AbrirSubAbaBaixaReceber">
            💰 Baixa de Receber
        </button>
        <button class="@(SubAbaAdminClientes == "cobranca" ? "admin-tab active" : "admin-tab")"
                @onclick="AbrirSubAbaCobranca">
            📞 Cobrança
        </button>
    </div>

    @* ── SUB-ABA: BAIXA DE RECEBER ── *@
    @if (SubAbaAdminClientes == "baixa-receber")
    {
        @* Cole aqui todo o conteúdo interno que já existe na aba,
               começando do <div style="display:flex; gap:8px; margin-bottom:12px;"> da busca
               até o final do modal, sem o <div class="admin-card"> externo *@

        <div style="display:flex; gap:8px; margin-bottom:12px;">
            <input class="admin-input"
                   style="max-width:400px;"
                   placeholder="Buscar cliente por código, nome ou apelido..."
                   @bind="FiltroBuscaCliente"
                   @bind:event="oninput"
                   @onkeydown="OnBuscaKeyDown" />
            <button class="btn-save-permissions"
                    @onclick="BuscarClientesBaixa"
                    disabled="@BuscandoCliente">
                @(BuscandoCliente ? "Buscando..." : "🔍 Buscar")
            </button>
        </div>

        @if (ResultadoBuscaClientes.Any())
        {
            <div style="border:1.5px solid var(--border); border-radius:var(--radius-sm);
                background:var(--surface-2); padding:8px; margin-bottom:16px; max-width:500px;">
                @foreach (var cli in ResultadoBuscaClientes)
                {
                    <button class="user-row" @onclick="() => SelecionarClienteBaixa(cli)">
                        <strong>@(!string.IsNullOrWhiteSpace(cli.Apelido) ? cli.Apelido : cli.NomeCliente)</strong>
                        <small>Código: @cli.Codigo — @cli.NomeCliente</small>
                    </button>
                }
            </div>
        }

        @if (ClienteSelecionadoBaixa != null)
        {
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:16px;">
                <div style="background:var(--primary-soft); border:1.5px solid var(--primary-3);
                    border-radius:var(--radius-sm); padding:10px 16px;">
                    <span style="font-size:10px; color:var(--muted); text-transform:uppercase;
                    font-weight:700; letter-spacing:.05em;">Cliente selecionado</span>
                    <strong style="display:block; color:var(--primary); font-size:14px;">
                        @(!string.IsNullOrWhiteSpace(ClienteSelecionadoBaixa.Apelido)
                            ? ClienteSelecionadoBaixa.Apelido
                            : ClienteSelecionadoBaixa.NomeCliente)
                    </strong>
                    <small style="color:var(--muted);">
                        Cód. @ClienteSelecionadoBaixa.Codigo — @ClienteSelecionadoBaixa.NomeCliente
                    </small>
                </div>

                <div style="display:flex; gap:6px; align-items:center;">
                    <label style="font-size:11px; font-weight:700; color:var(--muted);">Situação:</label>
                    @foreach (var (val, label) in new[] {
                            ("abertos","Abertos"), ("pagos","Pagos"), ("todos","Todos") })
                    {
                        <button class="@(SituacaoFiltro == val ? "admin-tab active" : "admin-tab")"
                                style="padding:6px 14px;"
                                @onclick="async () => { SituacaoFiltro = val; await CarregarContasReceber(); }">
                            @label
                        </button>
                    }
                </div>

                <button class="btn-save-permissions" style="margin-left:auto;"
                        @onclick="CarregarContasReceber"
                        disabled="@CarregandoContas">
                    🔄 Atualizar
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(MensagemBaixa) && !MostrarFormBaixa)
            {
                <div style="margin-bottom:14px; padding:10px 14px; border-radius:var(--radius-sm);
                    background:var(--success-soft); border:1.5px solid #a7f3d0;
                    color:var(--success); font-size:12px; font-weight:600;">
                    @MensagemBaixa
                </div>
            }

            @if (ContasReceber.Any(c => c.Selecionado))
            {
                <div class="commission-hero" style="grid-template-columns:repeat(2,1fr); margin-bottom:16px;">
                    <div class="commission-main-card">
                        <span>Total selecionado (s/ juros)</span>
                        <strong>@TotalSelecionado.ToString("C")</strong>
                        <small>@ContasReceber.Count(c => c.Selecionado) título(s) marcado(s)</small>
                    </div>
                    <div class="commission-main-card">
                        <span>Total selecionado (c/ juros)</span>
                        <strong>@TotalSelecionadoComJuros.ToString("C")</strong>
                        <small>Juros 2% ao mês proporcional por dia · 2 dias de carência</small>
                    </div>
                </div>
            }

            @if (CarregandoContas)
            {
                <div class="loading">Carregando títulos...</div>
            }
            else if (!ContasReceber.Any())
            {
                <div class="empty-state">Nenhum título encontrado para este cliente.</div>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                    <label style="display:flex; align-items:center; gap:6px;
                        font-size:12px; font-weight:600; color:var(--muted); cursor:pointer;">
                        <input type="checkbox"
                               style="width:15px; height:15px; accent-color:var(--primary-2);"
                               @onchange="e => SelecionarTodosAbertos(Convert.ToBoolean(e.Value))" />
                        Selecionar todos em aberto
                    </label>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:36px;"></th>
                                <th>Título</th>
                                <th>Tipo</th>
                                <th>Vencimento</th>
                                <th>Valor</th>
                                <th>C/ Juros</th>
                                <th>Parcela</th>
                                <th>Observação</th>
                                <th>Pagamento</th>
                                <th>Situação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in ContasReceber)
                            {
                                var vencido = ct.DataPagamento == null
                                    && ct.DataVencimento != null
                                    && ct.DataVencimento.Value.Date < DateTime.Today;

                                <tr style="@(vencido ? "background:#fff5f5;" : "")">
                                    <td data-label="Sel.">
                                        <input type="checkbox" class="commission-checkbox" @bind="ct.Selecionado" />
                                    </td>
                                    <td data-label="Título"><span class="badge status-info">@ct.Codigo</span></td>
                                    <td data-label="Tipo">@ct.NomeTipoConta</td>
                                    <td data-label="Vencimento">
                                        <span class="date-strong" style="@(vencido ? "color:var(--danger);" : "")">
                                            @FormatarData(ct.DataVencimento)
                                        </span>
                                        @if (ct.DiasAtraso > 0)
                                        {
                                            <span class="date-sub" style="color:var(--danger);">
                                                @ct.DiasAtraso dia(s) em atraso
                                            </span>
                                        }
                                    </td>
                                    <td data-label="Valor"><span class="date-strong">@ct.Valor?.ToString("C")</span></td>
                                    <td data-label="C/ Juros">
                                        <span class="date-strong"
                                              style="color:@(ct.DiasAtraso > 0 ? "var(--danger)" : "var(--text)");">
                                            @ct.ValorComJuros.ToString("C")
                                        </span>
                                    </td>
                                    <td data-label="Parcela">
                                        @if (!string.IsNullOrWhiteSpace(ct.Parcela))
                                        {
                                            <span class="badge">@ct.Parcela/@ct.TotalParcela</span>
                                        }
                                    </td>
                                    <td data-label="Observação"><div class="obs-cell">@ct.Observacao</div></td>
                                    <td data-label="Pagamento">
                                        @if (ct.DataPagamento != null)
                                        {
                                            <span class="date-strong">@FormatarData(ct.DataPagamento)</span>
                                            <span class="date-sub">@ct.ValorPago?.ToString("C") — @ct.TipoPagamento</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--muted); font-size:11px;">—</span>
                                        }
                                    </td>
                                    <td data-label="Situação">
                                        <span class="badge @(ct.DataPagamento != null ? "status-ok" : (vencido ? "status-danger" : "status-empty"))">
                                            @(ct.DataPagamento != null ? "Pago" : (vencido ? "Vencido" : "Aberto"))
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (TitulosSelecionados.Any())
            {
                <div style="margin-top:16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                    <button class="btn-save-permissions"
                            style="background:linear-gradient(135deg,#059669,#047857);"
                            @onclick="AbrirFormBaixa">
                        💰 Realizar baixa (@TitulosSelecionados.Count título(s))
                    </button>
                </div>
            }
        }

        
    }

    @* ── SUB-ABA: COBRANÇA ── *@
    else if (SubAbaAdminClientes == "cobranca")
    {
        <input class="admin-input"
               style="max-width:400px; margin-bottom:16px;"
               placeholder="Buscar por código, nome ou apelido..."
               @bind="FiltroCobranca"
               @bind:event="oninput" />

        @if (CarregandoCobranca)
        {
            <div class="loading">Carregando clientes...</div>
        }
        else if (!ClientesCobrancaFiltrados.Any())
        {
            <div class="empty-state">Nenhum cliente com títulos vencidos encontrado.</div>
        }
        else
        {
            <div style="display:grid; grid-template-columns:280px 1fr; gap:16px; margin-top:8px;">

                @* LISTA DE CLIENTES *@
                <div class="admin-list">
                    @foreach (var cli in ClientesCobrancaFiltrados)
                    {
                        <button class="user-row @(ClienteCobrancaSelecionado?.CodCliente == cli.CodCliente ? "active" : "")"
                                @onclick="() => SelecionarClienteCobranca(cli)">
                            <strong>@(!string.IsNullOrWhiteSpace(cli.Apelido) ? cli.Apelido : cli.NomeCliente)</strong>
                            <small>@cli.NomeCliente — Total: @cli.ValorTotal.ToString("C")</small>
                        </button>
                    }
                </div>

                @* DETALHE DO CLIENTE SELECIONADO *@
                <div>
                    @if (ClienteCobrancaSelecionado == null)
                    {
                        <div class="empty-state">Selecione um cliente para ver os títulos.</div>
                    }
                    else
                    {
                        <div style="background:var(--primary-soft); border:1.5px solid var(--primary-3);
                            border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:16px;
                            display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                            <div>
                                <span style="font-size:10px; color:var(--muted); text-transform:uppercase;
                                font-weight:700; letter-spacing:.05em;">Cliente</span>
                                <strong style="display:block; color:var(--primary); font-size:14px;">
                                    @(!string.IsNullOrWhiteSpace(ClienteCobrancaSelecionado.Apelido)
                                        ? ClienteCobrancaSelecionado.Apelido
                                        : ClienteCobrancaSelecionado.NomeCliente)
                                </strong>
                                <small style="color:var(--muted);">
                                    Celular: @ClienteCobrancaSelecionado.Celular |
                                    Total em aberto: @TitulosCobranca.Sum(t => t.ValorComJuros).ToString("C")
                                </small>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(ClienteCobrancaSelecionado.Celular))
                            {
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    <button style="display:inline-flex; align-items:center; gap:6px; padding:10px 16px;
                                        border-radius:var(--radius-sm); background:linear-gradient(135deg,#d97706,#b45309);
                                        color:white; font-size:12px; font-weight:700; text-decoration:none; border:none; cursor:pointer;
                                        box-shadow:0 4px 12px rgba(217,119,6,.25);"
                                            @onclick="AbrirLembreteWhatsApp">
                                        🔔 Enviar lembrete via WhatsApp
                                    </button>
                                    <button style="display:inline-flex; align-items:center; gap:6px; padding:10px 16px;
                                        border-radius:var(--radius-sm); background:linear-gradient(135deg,#059669,#047857);
                                        color:white; font-size:12px; font-weight:700; text-decoration:none; border:none; cursor:pointer;
                                        box-shadow:0 4px 12px rgba(5,150,105,.25);"
                                            @onclick="AbrirCobrancaWhatsApp">
                                        📱 Enviar cobrança via WhatsApp
                                    </button>

                                    <button class="btn-save-permissions"
                                            style="background:linear-gradient(135deg,#7c3aed,#5b21b6);
                                        box-shadow:0 4px 12px rgba(124,58,237,.28);"
                                            @onclick="GerarLinkPix"
                                            disabled="@GerandoLinkPix">
                                        @(GerandoLinkPix ? "Gerando..." : "⚡ Gerar Link PIX")
                                    </button>

                                    @if (!string.IsNullOrWhiteSpace(ErroLinkPix))
                                    {
                                        <div style="width:100%; margin-top:8px; padding:8px 12px; border-radius:12px;
                                            background:var(--danger-soft); border:1px solid #fca5a5;
                                            color:var(--danger); font-size:11.5px; font-weight:600;">
                                            @ErroLinkPix
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span style="font-size:11px; color:var(--danger); font-weight:600;">
                                    ⚠️ Sem celular cadastrado
                                </span>
                            }
                        </div>

                        @* PRÉVIA DA MENSAGEM *@
                        <div style="background:var(--surface-2); border:1.5px solid var(--border);
                            border-radius:var(--radius-sm); padding:14px; margin-bottom:16px;">
                            <span style="display:block; font-size:10px; color:var(--muted); font-weight:700;
                                text-transform:uppercase; letter-spacing:.05em; margin-bottom:8px;">
                                Prévia da mensagem
                            </span>
                            <pre style="margin:0; font-family:'Sora',sans-serif; font-size:12px;
                            color:var(--text-2); white-space:pre-wrap; line-height:1.6;">@GerarMensagemCobranca()</pre>
                        </div>

                        @* TABELA DE TÍTULOS *@
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Tipo</th>
                                        <th>Vencimento</th>
                                        <th>Valor</th>
                                        <th>C/ Juros</th>   <!-- ← nova -->
                                        <th>Dias em atraso</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in TitulosCobranca)
                                    {
                                        <tr>
                                            <td data-label="Título">
                                                <span class="badge status-danger">@t.Codigo</span>
                                            </td>
                                            <td data-label="Tipo">
                                                <span class="badge @(t.EhBoleto ? "status-info" : "status-ok")">
                                                    @t.TipoIcone
                                                </span>
                                            </td>
                                            <td data-label="Vencimento">
                                                <span class="date-strong" style="color:var(--danger);">
                                                    @t.DataVencimento.ToString("dd/MM/yyyy")
                                                </span>
                                            </td>
                                            <td data-label="Valor">
