@page "/admin/bx-pagar"
@using EvolutCRM.Models
@using EvolutCRM.Services

@inject AdminService AdminService
@inject BxClienteService bxClienteService
@inject LogFinanceiroService LogFinanceiroService
@inject UserState UserState
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700;800&display=swap');

    :root {
        --bg: #f4f7fb;
        --surface: #ffffff;
        --surface-2: #f8fbff;
        --surface-3: #eef6ff;
        --surface-glass: rgba(255, 255, 255, .78);
        --border: #d9e6f5;
        --border-2: #bfd3ec;
        --primary: #0d47a1;
        --primary-2: #1565c0;
        --primary-3: #42a5f5;
        --primary-soft: #eaf4ff;
        --primary-ultra: #f5f9ff;
        --text: #172033;
        --text-2: #334155;
        --muted: #64748b;
        --muted-2: #94a3b8;
        --success: #16a34a;
        --success-2: #15803d;
        --success-soft: #ecfdf5;
        --warning: #d97706;
        --warning-2: #b45309;
        --warning-soft: #fffbeb;
        --danger: #dc2626;
        --danger-2: #b91c1c;
        --danger-soft: #fff1f2;
        --money: #059669;
        --money-2: #047857;
        --money-soft: #ecfdf5;
        --dark: #0f172a;
        --shadow-xs: 0 1px 3px rgba(15, 23, 42, .04);
        --shadow-sm: 0 3px 10px rgba(15, 23, 42, .06);
        --shadow: 0 14px 36px rgba(13, 71, 161, .11);
        --shadow-lg: 0 24px 70px rgba(13, 71, 161, .18);
        --radius: 22px;
        --radius-lg: 26px;
        --radius-md: 18px;
        --radius-sm: 13px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: var(--bg);
    }

    .admin-card {
        position: relative;
        width: 100%;
        min-height: calc(100vh - 32px);
        padding: 26px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: radial-gradient(circle at 95% 4%, rgba(5, 150, 105, .15), transparent 28%), radial-gradient(circle at 4% 0%, rgba(66, 165, 245, .13), transparent 30%), linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        box-shadow: var(--shadow);
        color: var(--text);
        font-family: 'Sora', Arial, sans-serif;
        overflow: hidden;
        animation: bxFadeUp .28s ease both;
    }

        .admin-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 5px;
            background: linear-gradient(90deg, var(--money), var(--primary-3), var(--primary));
            z-index: 2;
        }

        .admin-card::after {
            content: "";
            position: absolute;
            right: -125px;
            top: -125px;
            width: 310px;
            height: 310px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(13, 71, 161, .08), rgba(13, 71, 161, .02) 60%, transparent 70%);
            pointer-events: none;
        }

    .card-title {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 13px;
        margin: 0 0 5px;
        color: var(--text);
        font-size: 22px;
        font-weight: 900;
        letter-spacing: -.04em;
        line-height: 1.15;
    }

        .card-title::before {
            content: "💼";
            width: 44px;
            height: 44px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at top right, rgba(255,255,255,.35), transparent 35%), linear-gradient(135deg, var(--money), var(--primary));
            color: #ffffff;
            box-shadow: 0 12px 26px rgba(5, 150, 105, .22);
            font-size: 20px;
            flex: 0 0 auto;
        }

    .card-subtitle {
        position: relative;
        z-index: 3;
        margin: 0 0 22px 57px;
        color: var(--muted);
        font-size: 12.5px;
        font-weight: 500;
        line-height: 1.55;
    }

    .admin-tabs {
        position: relative;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(255,255,255,.9), rgba(248,251,255,.92));
        box-shadow: var(--shadow-sm);
    }

    .admin-tab {
        position: relative;
        min-height: 39px;
        border: 1px solid transparent;
        border-radius: 999px;
        padding: 0 17px;
        background: transparent;
        color: var(--muted);
        font-family: 'Sora', Arial, sans-serif;
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
        white-space: nowrap;
        transition: transform .16s ease, box-shadow .16s ease, background .16s ease, color .16s ease, border-color .16s ease;
    }

        .admin-tab:hover {
            color: var(--primary);
            background: var(--primary-soft);
            transform: translateY(-1px);
        }

        .admin-tab.active {
            color: #ffffff;
            border-color: rgba(255,255,255,.25);
            background: radial-gradient(circle at top right, rgba(255,255,255,.25), transparent 34%), linear-gradient(135deg, var(--primary), var(--primary-2));
            box-shadow: 0 10px 24px rgba(13, 71, 161, .24);
        }

    .admin-input {
        width: 100%;
        height: 46px;
        border: 1.5px solid var(--border);
        border-radius: 15px;
        padding: 0 15px;
        background: #ffffff;
        color: var(--text);
        font-family: 'Sora', Arial, sans-serif;
        font-size: 13px;
        font-weight: 700;
        outline: none;
        box-shadow: var(--shadow-xs);
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease, background .18s ease;
    }

        .admin-input::placeholder {
            color: var(--muted-2);
            font-weight: 500;
        }

        .admin-input:hover {
            border-color: var(--border-2);
        }

        .admin-input:focus {
            border-color: var(--primary-3);
            box-shadow: 0 0 0 4px rgba(66, 165, 245, .14), var(--shadow-sm);
            transform: translateY(-1px);
        }

    select.admin-input {
        appearance: none;
        cursor: pointer;
        padding-right: 42px;
        background-image: url("data:image/svg+xml,%3Csvg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 14px center;
        background-size: 17px;
    }

    .btn-save-permissions {
        min-height: 44px;
        border: none;
        border-radius: 15px;
        padding: 0 18px;
        background: radial-gradient(circle at top right, rgba(255,255,255,.28), transparent 35%), linear-gradient(135deg, var(--primary), var(--primary-2));
        color: #ffffff;
        font-family: 'Sora', Arial, sans-serif;
        font-size: 12.5px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 0 11px 26px rgba(13, 71, 161, .23);
        transition: transform .16s ease, box-shadow .16s ease, filter .16s ease, opacity .16s ease;
    }

        .btn-save-permissions:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 16px 34px rgba(13, 71, 161, .30);
            filter: brightness(1.04);
        }

        .btn-save-permissions:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-save-permissions:disabled {
            opacity: .62;
            cursor: not-allowed;
            box-shadow: none;
        }

    .admin-card > div[style*="display:flex; gap:8px"] {
        position: relative;
        z-index: 3;
        align-items: center !important;
        padding: 16px !important;
        margin-bottom: 16px !important;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: radial-gradient(circle at top right, rgba(66,165,245,.09), transparent 30%), #ffffff;
        box-shadow: var(--shadow-sm);
    }

        .admin-card > div[style*="display:flex; gap:8px"] .admin-input {
            max-width: none !important;
            padding-left: 42px;
            background-image: url("data:image/svg+xml,%3Csvg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2.3' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='11' cy='11' r='8'/%3E%3Cpath d='m21 21-4.35-4.35'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: 14px center;
            background-size: 17px;
        }

    .admin-card > div[style*="max-width:500px"] {
        position: relative;
        z-index: 4;
        max-width: 560px !important;
        border: 1px solid var(--border) !important;
        border-radius: 18px !important;
        background: #ffffff !important;
        padding: 10px !important;
        margin-bottom: 16px !important;
        box-shadow: var(--shadow);
        animation: bxFadeUp .2s ease both;
    }

    .user-row {
        position: relative;
        width: 100%;
        min-height: 58px;
        border: 1.5px solid transparent;
        background: rgba(255, 255, 255, .92);
        padding: 12px 12px 12px 48px;
        border-radius: 15px;
        text-align: left;
        cursor: pointer;
        margin-bottom: 7px;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
        overflow: hidden;
    }

        .user-row:last-child {
            margin-bottom: 0;
        }

        .user-row::before {
            content: "👤";
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 13px;
        }

        .user-row:hover {
            border-color: var(--primary-3);
            background: var(--primary-ultra);
            transform: translateX(3px);
            box-shadow: var(--shadow-sm);
        }

        .user-row.active {
            background: linear-gradient(135deg, var(--primary-soft), #ffffff);
            border-color: var(--primary-2);
            box-shadow: 0 8px 22px rgba(13, 71, 161, .13);
        }

        .user-row strong {
            display: block;
            color: var(--text);
            font-size: 13px;
            font-weight: 900;
            line-height: 1.25;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .user-row small {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 650;
            line-height: 1.35;
        }

    .admin-card > div[style*="align-items:center; gap:12px"] {
        position: relative;
        z-index: 3;
        padding: 16px !important;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: radial-gradient(circle at top right, rgba(5,150,105,.12), transparent 30%), linear-gradient(135deg, #ffffff 0%, var(--money-soft) 100%);
        box-shadow: var(--shadow-sm);
    }

    .admin-card > div[style*="background:var(--primary-soft)"] {
        border: 1.5px solid rgba(13, 71, 161, .18) !important;
        border-radius: 17px !important;
        background: radial-gradient(circle at top right, rgba(255,255,255,.72), transparent 35%), linear-gradient(135deg, var(--primary-soft), #ffffff) !important;
        box-shadow: var(--shadow-xs);
    }

        .admin-card > div[style*="background:var(--primary-soft)"] strong {
            color: var(--primary) !important;
            font-weight: 900 !important;
        }

    .commission-hero {
        position: relative;
        z-index: 3;
        display: grid;
        gap: 14px;
    }

    .commission-main-card {
        position: relative;
        min-height: 124px;
        padding: 20px;
        border: 1.5px solid #bbf7d0;
        border-radius: 20px;
        background: radial-gradient(circle at top right, rgba(255,255,255,.78), transparent 34%), linear-gradient(135deg, #ffffff 0%, var(--money-soft) 100%);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .commission-main-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow);
        }

        .commission-main-card::before {
            content: "";
            position: absolute;
            right: -28px;
            top: -28px;
            width: 94px;
            height: 94px;
            border-radius: 999px;
            background: rgba(22, 163, 74, .10);
        }

        .commission-main-card::after {
            content: "R$";
            position: absolute;
            right: 18px;
            top: 18px;
            width: 38px;
            height: 38px;
            border-radius: 14px;
            background: #dcfce7;
            color: var(--money);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            font-weight: 900;
            box-shadow: 0 6px 16px rgba(15,23,42,.08);
        }

        .commission-main-card span {
            display: block;
            margin-bottom: 10px;
            color: var(--muted);
            font-size: 10.5px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .commission-main-card strong {
            display: block;
            margin-right: 42px;
            color: var(--money);
            font-size: 31px;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -.045em;
            font-family: 'JetBrains Mono', monospace;
        }

        .commission-main-card small {
            display: block;
            margin-top: 12px;
            color: var(--muted);
            font-size: 11.5px;
            font-weight: 650;
            line-height: 1.4;
        }

    .loading {
        position: relative;
        z-index: 3;
        min-height: 170px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        border: 1.5px dashed var(--border-2);
        border-radius: 20px;
        background: radial-gradient(circle at top, rgba(66, 165, 245, .09), transparent 35%), #ffffff;
        color: var(--muted);
        font-size: 13px;
        font-weight: 850;
        box-shadow: var(--shadow-sm);
    }

        .loading::before {
            content: "";
            width: 23px;
            height: 23px;
            border-radius: 999px;
            border: 3px solid var(--border);
            border-top-color: var(--primary);
            animation: bxSpin .75s linear infinite;
        }

    .empty-state {
        position: relative;
        z-index: 3;
        padding: 42px 24px;
        border: 1.5px dashed var(--border-2);
        border-radius: 20px;
        background: radial-gradient(circle at top, rgba(66, 165, 245, .09), transparent 35%), #ffffff;
        color: var(--muted);
        text-align: center;
        font-size: 13px;
        font-weight: 850;
        box-shadow: var(--shadow-sm);
    }

        .empty-state::before {
            content: "📄";
            width: 58px;
            height: 58px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            border-radius: 20px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 25px;
            box-shadow: var(--shadow-sm);
        }

    .admin-card > div[style*="Selecionar todos em aberto"],
    .admin-card > div[style*="align-items:center; gap:10px"] {
        position: relative;
        z-index: 3;
    }

    label:has(input[type="checkbox"]) {
        user-select: none;
    }

    .commission-checkbox,
    input[type="checkbox"] {
        width: 18px !important;
        height: 18px !important;
        accent-color: var(--money) !important;
        cursor: pointer;
        filter: drop-shadow(0 2px 4px rgba(15,23,42,.08));
    }

    .table-wrap {
        position: relative;
        z-index: 3;
        width: 100%;
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 21px;
        background: #ffffff;
        box-shadow: var(--shadow-sm);
    }

        .table-wrap::-webkit-scrollbar,
        .admin-list::-webkit-scrollbar {
            height: 9px;
            width: 9px;
        }

        .table-wrap::-webkit-scrollbar-track,
        .admin-list::-webkit-scrollbar-track {
            background: #eef4fb;
            border-radius: 999px;
        }

        .table-wrap::-webkit-scrollbar-thumb,
        .admin-list::-webkit-scrollbar-thumb {
            background: #bfd3ec;
            border-radius: 999px;
        }

            .table-wrap::-webkit-scrollbar-thumb:hover,
            .admin-list::-webkit-scrollbar-thumb:hover {
                background: #9dbbe0;
            }

    table {
        width: 100%;
        min-width: 1180px;
        border-collapse: separate;
        border-spacing: 0;
        font-family: 'Sora', Arial, sans-serif;
    }

    thead {
        position: sticky;
        top: 0;
        z-index: 4;
    }

    th {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        background: linear-gradient(180deg, #f8fbff 0%, #edf5ff 100%);
        color: var(--muted);
        text-align: left;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        white-space: nowrap;
    }

        th:first-child {
            border-top-left-radius: 21px;
            text-align: center;
        }

        th:last-child {
            border-top-right-radius: 21px;
        }

    td {
        padding: 14px 16px;
        border-bottom: 1px solid #edf2f7;
        background: #ffffff;
        color: var(--text-2);
        font-size: 12.5px;
        font-weight: 650;
        vertical-align: middle;
        transition: background .16s ease, color .16s ease, box-shadow .16s ease;
    }

    tbody tr:hover td {
        background: var(--primary-soft);
    }

        tbody tr:hover td:first-child {
            box-shadow: inset 4px 0 0 var(--primary-3);
        }

    tbody tr:last-child td {
        border-bottom: none;
    }

    td[data-label="Sel."] {
        text-align: center;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 5px 12px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10.5px;
        font-weight: 900;
        line-height: 1;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
    }

        .badge.status-info {
            background: var(--primary-soft);
            color: var(--primary);
            border-color: rgba(13, 71, 161, .13);
        }

            .badge.status-info::before {
                content: "#";
                margin-right: 3px;
                opacity: .7;
            }

        .badge.status-ok {
            background: #dcfce7;
            color: #166534;
            border-color: #bbf7d0;
        }

            .badge.status-ok::before {
                content: "✓";
                margin-right: 6px;
                font-family: 'Sora', Arial, sans-serif;
            }

        .badge.status-danger {
            background: #ffe4e6;
            color: var(--danger-2);
            border-color: #fecdd3;
        }

            .badge.status-danger::before {
                content: "●";
                margin-right: 6px;
                font-size: 8px;
                animation: bxPulseDanger 1.35s ease-in-out infinite;
            }

        .badge.status-empty {
            background: #f1f5f9;
            color: var(--muted);
            border-color: #cbd5e1;
        }

    .date-strong {
        display: block;
        color: var(--text);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px;
        font-weight: 850;
        line-height: 1.25;
    }

    .date-sub {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 10.5px;
        font-weight: 700;
        line-height: 1.35;
    }

    .obs-cell {
        max-width: 330px;
        color: var(--muted);
        font-size: 11.5px;
        font-weight: 600;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    tbody tr:hover .obs-cell {
        color: var(--text-2);
    }

    .admin-list {
        max-height: calc(100vh - 210px);
        overflow-y: auto;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: radial-gradient(circle at top left, rgba(220,38,38,.08), transparent 34%), #ffffff;
        box-shadow: var(--shadow-sm);
        scrollbar-width: thin;
        scrollbar-color: var(--border-2) transparent;
    }

    .admin-card > div[style*="grid-template-columns:280px"] {
        position: relative;
        z-index: 3;
        grid-template-columns: 310px minmax(0, 1fr) !important;
    }

    a[href*="wa.me"] {
        transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
    }

        a[href*="wa.me"]:hover {
            transform: translateY(-2px);
            filter: brightness(1.04);
            box-shadow: 0 14px 30px rgba(5,150,105,.28) !important;
        }

    pre {
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid var(--border);
        padding: 14px;
        box-shadow: var(--shadow-xs);
    }

    div[style*="position:fixed"] {
        backdrop-filter: blur(8px);
        background: radial-gradient(circle at center, rgba(13, 71, 161, .16), rgba(0,0,0,.58)) !important;
        animation: bxModalBackdrop .18s ease both;
    }

    div[style*="max-width:520px"] {
        position: relative;
        border: 1px solid rgba(255,255,255,.45);
        border-radius: 26px !important;
        background: radial-gradient(circle at top right, rgba(5,150,105,.12), transparent 32%), linear-gradient(180deg, #ffffff 0%, #f8fbff 100%) !important;
        box-shadow: 0 30px 90px rgba(0,0,0,.28) !important;
        animation: bxModalIn .22s ease both;
    }

        div[style*="max-width:520px"]::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 5px;
            background: linear-gradient(90deg, var(--money), var(--primary-3), var(--primary));
            border-radius: 26px 26px 0 0;
        }

        div[style*="max-width:520px"] h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 19px !important;
            font-weight: 900 !important;
            letter-spacing: -.03em;
        }

        div[style*="max-width:520px"] p {
            line-height: 1.45;
        }

