    {
        "conectado" => "pill-conectado",
        "aguardando_qr" => "pill-aguardando",
        "erro" => "pill-erro",
        _ => "pill-desconectado"
    };

    private string TextoStatus(string status) => status switch
    {
        "conectado" => "● Conectado",
        "aguardando_qr" => "⏳ Aguardando QR",
        "erro" => "⚠ Erro",
        _ => "○ Desconectado"
    };

    public void Dispose()
    {
        _timerPolling?.Dispose();
    }

    private async Task VerificarStatusServico()
    {
        if (ProcessandoServico) return;   // não sobrescreve estado durante start/stop

        try
        {
            var resp = await Http.GetFromJsonAsync<StatusServicoResponse>(
                "/api/whatsapp-instancia/servico/status",
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            ServicoRodando = resp?.Rodando ?? false;
        }
        catch { ServicoRodando = false; }
    }

    private async Task IniciarServico()
    {
        ProcessandoServico = true;
        try
        {
            await Http.PostAsJsonAsync("/api/whatsapp-instancia/servico/iniciar", new { });

            // Aguarda até 10s verificando a cada 1s se o Node já subiu
            for (int i = 0; i < 10; i++)
            {
                await Task.Delay(1000);
                await VerificarStatusServico();
                StateHasChanged();
                if (ServicoRodando) break;
            }

            Mensagem = ServicoRodando
                ? "Serviço iniciado com sucesso!"
                : "Serviço iniciado.";
            Sucesso = ServicoRodando;
        }
        catch (Exception ex) { Mensagem = "Erro: " + ex.Message; Sucesso = false; }
        finally { ProcessandoServico = false; }
    }

    private async Task PararServico()
    {
        ProcessandoServico = true;
        try
        {
            await Http.PostAsJsonAsync("/api/whatsapp-instancia/servico/parar", new { });

            ProcessandoServico = false;   // libera o VerificarStatusServico
            for (int i = 0; i < 10; i++)
            {
                await Task.Delay(1000);
                await VerificarStatusServico();
                StateHasChanged();
                if (!ServicoRodando) break;
            }
            ProcessandoServico = true;    // restaura para o finally zerar

            Mensagem = ServicoRodando
                ? "Serviço enviado para parar — aguarde alguns segundos."
                : "Serviço parado.";
            Sucesso = true; // NSSM pode demorar mas vai parar
        }
        catch (Exception ex) { Mensagem = "Erro: " + ex.Message; Sucesso = false; }
        finally { ProcessandoServico = false; }
    }

    private class StatusServicoResponse
    {
        public bool Rodando { get; set; }
    }

