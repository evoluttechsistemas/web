@page "/curriculo-online"
@page "/curriculo-online/{CodEmp:int}"
@layout EvolutCRM.Components.Layout.TutorialPublicLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using EvolutCRM.Models
@using EvolutCRM.Services
@inject CurriculoOnlineService CurriculoOnlineService

<PageTitle>Currículo Online</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap');

    * {
        box-sizing: border-box;
    }

    .co-root {
        min-height: 100vh;
        background: #f6f7fb;
        font-family: 'Inter', -apple-system, sans-serif;
        color: #0b1220;
        padding: 40px 20px 64px;
    }

    .co-wrap {
        max-width: 760px;
        margin: 0 auto;
    }

    /* ── Header ── */
    .co-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .co-kicker {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e7ecfd;
        color: #2952e3;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        padding: 5px 14px;
        border-radius: 999px;
        margin-bottom: 14px;
    }

    .co-title {
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        font-size: clamp(1.7rem, 4vw, 2.4rem);
        letter-spacing: -.02em;
        color: #0b1220;
        margin: 0 0 8px;
        line-height: 1.15;
    }

    .co-subtitle {
        font-size: 15px;
        color: #5b6478;
        font-weight: 500;
        line-height: 1.6;
        max-width: 460px;
        margin: 0 auto;
    }

    /* ── Progress ── */
    .co-progress-wrap {
        max-width: 460px;
        margin: 22px auto 0;
    }

    .co-progress-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .co-progress-label {
        font-size: 11px;
        font-weight: 700;
        color: #8a91a3;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .co-progress-pct {
        font-size: 12px;
        font-weight: 700;
        color: #2952e3;
    }

    .co-progress-track {
        height: 6px;
        background: #e3e6f0;
        border-radius: 999px;
        overflow: hidden;
    }

    .co-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #2952e3, #5c7cf0);
        border-radius: 999px;
        transition: width .35s ease;
    }

    /* ── Card / sections ── */
    .co-card {
        background: #fff;
        border: 1px solid #e6e8f0;
        border-radius: 16px;
        margin-top: 28px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(11,18,32,.04), 0 8px 24px rgba(11,18,32,.05);
    }

    .co-section {
        padding: 26px 28px;
        border-bottom: 1px solid #f0f1f6;
    }

        .co-section:last-of-type {
            border-bottom: none;
        }

    .co-section-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .co-section-num {
        width: 28px;
        height: 28px;
        border-radius: 9px;
        background: #eef1fc;
        color: #2952e3;
        font-size: 13px;
        font-weight: 700;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .co-section-title {
        font-size: 15px;
        font-weight: 700;
        color: #0b1220;
    }

    .co-section-sub {
        font-size: 12px;
        color: #8a91a3;
        font-weight: 500;
        margin-top: 1px;
    }

    /* ── Fields ── */
    .co-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .co-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .co-field.full {
            grid-column: 1 / -1;
        }

    .co-label {
        font-size: 12.5px;
        font-weight: 600;
        color: #313a4d;
    }

        .co-label .req {
            color: #2952e3;
            margin-left: 2px;
        }

    .co-input, .co-textarea {
        width: 100%;
        border: 1.5px solid #e2e5ee;
        border-radius: 9px;
        background: #fbfbfd;
        color: #0b1220;
        font: inherit;
        font-size: 14px;
        padding: 10px 12px;
        outline: none;
        transition: border-color .15s, background .15s, box-shadow .15s;
    }

        .co-input:focus, .co-textarea:focus {
            border-color: #2952e3;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(41,82,227,.12);
        }

    .co-textarea {
        resize: vertical;
        min-height: 84px;
        line-height: 1.5;
    }

    /* ── Photo ── */
    .co-photo-box {
        border: 1.5px dashed #c7d2f5;
        background: #f5f7fe;
        border-radius: 12px;
        padding: 18px;
        display: grid;
        grid-template-columns: 90px minmax(0, 1fr);
        gap: 16px;
        align-items: center;
    }

    .co-photo-preview {
        width: 90px;
        height: 90px;
        border-radius: 12px;
        background: #dde4f8;
        display: grid;
        place-items: center;
        overflow: hidden;
        flex-shrink: 0;
        color: #2952e3;
        font-size: 24px;
    }

        .co-photo-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .co-photo-info p {
        margin: 0 0 4px;
        font-size: 13px;
        color: #5b6478;
        font-weight: 500;
        line-height: 1.5;
    }

    .co-photo-actions {
        grid-column: 1 / -1;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .co-file-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1.5px solid #c7d2f5;
        background: #fff;
        color: #2952e3;
        font-weight: 700;
        font-size: 13px;
        border-radius: 9px;
        padding: 10px 16px;
        cursor: pointer;
        transition: background .15s;
        overflow: hidden;
    }

        .co-file-btn:hover {
            background: #eef1fc;
        }

        .co-file-btn.secondary {
            border-color: #e2e5ee;
            color: #313a4d;
        }

        .co-file-btn input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    /* ── Submit ── */
    .co-submit-row {
        padding: 22px 28px 28px;
    }

    .co-submit {
        width: 100%;
        border: none;
        border-radius: 11px;
        background: #2952e3;
        color: #fff;
        font-weight: 700;
        font-size: 15px;
        padding: 14px 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background .15s, transform .1s;
    }

        .co-submit:hover {
            background: #1f3fbb;
        }

        .co-submit:active {
            transform: scale(.99);
        }

    .co-trust {
        text-align: center;
        font-size: 12px;
        color: #8a91a3;
        margin-top: 12px;
        font-weight: 500;
    }

    /* ── Messages ── */
    .co-error {
        color: #dc2626;
        font-size: 12.5px;
        font-weight: 600;
        margin-top: 2px;
    }

    .validation-message {
        color: #dc2626;
        font-size: 12.5px;
        font-weight: 600;
        margin-top: 2px;
        display: block;
    }

    .co-alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        font-size: 13px;
        font-weight: 600;
        padding: 11px 14px;
        border-radius: 9px;
        margin: 0 28px;
    }

    /* ── Success ── */
    .co-success {
        background: #fff;
        border: 1px solid #bbf0cf;
        border-radius: 16px;
        padding: 40px 32px;
        text-align: center;
        margin-top: 28px;
        box-shadow: 0 1px 2px rgba(11,18,32,.04), 0 8px 24px rgba(11,18,32,.05);
    }

    .co-success-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #e7f8ee;
        color: #15803d;
        font-size: 26px;
        display: grid;
        place-items: center;
        margin: 0 auto 16px;
    }

    .co-success h2 {
        font-family: 'Sora', sans-serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: #0b1220;
        margin: 0 0 8px;
    }

    .co-success p {
        font-size: 14px;
        color: #5b6478;
        margin: 0;
        line-height: 1.6;
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .co-root {
            padding: 28px 14px 48px;
        }

        .co-section {
            padding: 22px 18px;
        }

        .co-submit-row {
            padding: 18px 18px 22px;
        }

        .co-grid {
            grid-template-columns: 1fr;
        }

        .co-photo-box {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .co-photo-preview {
            margin: 0 auto;
        }

        .co-alert-error {
            margin: 0 18px;
        }
    }
</style>

<div class="co-root">
    <div class="co-wrap">

        <div class="co-header">
            <span class="co-kicker">Banco de talentos</span>
            <h1 class="co-title">Vamos conhecer sua trajetória</h1>
            <p class="co-subtitle">Preencha seus dados abaixo. Leva poucos minutos e seu currículo fica disponível para nossos próximos processos seletivos.</p>
        </div>

        @if (cadastroConcluido)
        {
            <div class="co-success">
                <div class="co-success-icon">✓</div>
                <h2>Currículo enviado com sucesso</h2>
                <p>Recebemos seus dados e eles ficarão disponíveis para análise em nossos processos seletivos. Obrigado pelo interesse!</p>
            </div>
        }
        else
        {
            <div class="co-progress-wrap">
                <div class="co-progress-top">
                    <span class="co-progress-label">Preenchimento</span>
                    <span class="co-progress-pct">@progresso%</span>
                </div>
                <div class="co-progress-track">
                    <div class="co-progress-fill" style="width:@(progresso)%"></div>
                </div>
            </div>

            <EditForm Model="candidato" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <div class="co-card">

                    <div class="co-section">
                        <div class="co-section-head">
                            <span class="co-section-num">1</span>
                            <div>
                                <div class="co-section-title">Dados pessoais</div>
                                <div class="co-section-sub">Como podemos te encontrar e te contatar</div>
                            </div>
                        </div>

                        <div class="co-grid">
                            <div class="co-field full">
                                <label class="co-label">Nome completo<span class="req">*</span></label>
                                <InputText class="co-input" @bind-Value="candidato.NomeCompleto" @onblur="AtualizarProgresso" />
                                <ValidationMessage For="@(() => candidato.NomeCompleto)" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Telefone / WhatsApp<span class="req">*</span></label>
                                <InputText class="co-input" @bind-Value="candidato.Telefone" @onblur="AtualizarProgresso" />
                                <ValidationMessage For="@(() => candidato.Telefone)" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">E-mail<span class="req">*</span></label>
                                <InputText class="co-input" @bind-Value="candidato.Email" @onblur="AtualizarProgresso" />
                                <ValidationMessage For="@(() => candidato.Email)" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Cidade<span class="req">*</span></label>
                                <InputText class="co-input" @bind-Value="candidato.Cidade" @onblur="AtualizarProgresso" />
                                <ValidationMessage For="@(() => candidato.Cidade)" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Estado<span class="req">*</span></label>
                                <InputText class="co-input" @bind-Value="candidato.Estado" maxlength="2" @onblur="AtualizarProgresso" />
                                <ValidationMessage For="@(() => candidato.Estado)" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Área de interesse<span class="req">*</span></label>
                                <InputText class="co-input" @bind-Value="candidato.AreaInteresse" @onblur="AtualizarProgresso" />
                                <ValidationMessage For="@(() => candidato.AreaInteresse)" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Cargo pretendido</label>
                                <InputText class="co-input" @bind-Value="candidato.CargoPretendido" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Escolaridade</label>
                                <InputText class="co-input" @bind-Value="candidato.Escolaridade" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Disponibilidade</label>
                                <InputText class="co-input" @bind-Value="candidato.Disponibilidade" />
                            </div>

                            <div class="co-field">
                                <label class="co-label">Pretensão salarial</label>
                                <InputText class="co-input" @bind-Value="candidato.PretensaoSalarial" />
                            </div>
                        </div>
                    </div>

                    <div class="co-section">
                        <div class="co-section-head">
                            <span class="co-section-num">2</span>
                            <div>
                                <div class="co-section-title">Foto</div>
                                <div class="co-section-sub">Uma foto nítida do rosto, de frente</div>
                            </div>
                        </div>

                        <div class="co-photo-box">
                            <div class="co-photo-preview">
                                @if (!string.IsNullOrWhiteSpace(candidato.FotoDataUrl))
                                {
                                    <img src="@candidato.FotoDataUrl" alt="Foto selecionada" />
                                }
                                else
                                {
                                    <span>📷</span>
                                }
                            </div>
                            <div class="co-photo-info">
                                <p>Foto obrigatória<span class="req">*</span></p>
                                <p>Tire agora pela câmera ou escolha uma imagem já salva no seu dispositivo.</p>
                                <ValidationMessage For="@(() => candidato.FotoBase64)" />
                            </div>

                            <div class="co-photo-actions">
                                @if (isMobile)
                                {
                                    <label class="co-file-btn" for="foto-camera">
                                        📸 Tirar foto
                                        <InputFile id="foto-camera" OnChange="OnFotoSelecionadaAsync"
                                                   accept="image/*" capture="user" style="display:none" />
                                    </label>
                                }
                                <label class="co-file-btn secondary" for="foto-galeria">
                                    🖼️ Escolher da galeria
                                    <InputFile id="foto-galeria" OnChange="OnFotoSelecionadaAsync"
                                               accept="image/*" style="display:none" />
                                </label>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(erroFoto))
                        {
                            <div class="co-error" style="margin-top:10px;">@erroFoto</div>
                        }
                    </div>

                    <div class="co-section">
                        <div class="co-section-head">
                            <span class="co-section-num">3</span>
                            <div>
                                <div class="co-section-title">Experiência e formação</div>
                                <div class="co-section-sub">Conte um pouco sobre sua trajetória</div>
                            </div>
                        </div>

                        <div class="co-grid">
                            <div class="co-field full">
                                <label class="co-label">Experiências profissionais</label>
                                <InputTextArea class="co-textarea" @bind-Value="candidato.Experiencias" rows="5" />
                            </div>

                            <div class="co-field full">
                                <label class="co-label">Cursos</label>
                                <InputTextArea class="co-textarea" @bind-Value="candidato.Cursos" rows="3" />
                            </div>

                            <div class="co-field full">
                                <label class="co-label">Habilidades</label>
                                <InputTextArea class="co-textarea" @bind-Value="candidato.Habilidades" rows="3" />
                            </div>

                            <div class="co-field full">
                                <label class="co-label">Observações</label>
                                <InputTextArea class="co-textarea" @bind-Value="candidato.Observacoes" rows="3" />
                            </div>
                        </div>
                    </div>

                    <div class="co-submit-row">
                        <button type="submit" class="co-submit">Enviar currículo</button>
                        <div class="co-trust">Seus dados serão usados apenas para fins de recrutamento e seleção.</div>
                    </div>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int CodEmp { get; set; }

    private CandidatoTalentoModel candidato = new();
    private bool cadastroConcluido;
    private string erroFoto = string.Empty;
    private int progresso;

    private void AtualizarProgresso()
    {
        var camposObrigatorios = new[]
        {
        candidato.NomeCompleto,
        candidato.Telefone,
        candidato.Email,
        candidato.Cidade,
        candidato.Estado,
        candidato.AreaInteresse,
        candidato.FotoBase64
    };

        var preenchidos = camposObrigatorios.Count(c => !string.IsNullOrWhiteSpace(c));
        progresso = (int)Math.Round(preenchidos / (double)camposObrigatorios.Length * 100);
    }

    private async Task OnFotoSelecionadaAsync(InputFileChangeEventArgs e)
    {
        erroFoto = string.Empty;
        var arquivo = e.File;

        if (arquivo is null)
            return;

        if (!arquivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            erroFoto = "Selecione um arquivo de imagem.";
            return;
        }

        const long tamanhoMaximo = 5 * 1024 * 1024;
        if (arquivo.Size > tamanhoMaximo)
        {
            erroFoto = "A foto deve ter no máximo 5 MB.";
            return;
        }

        await using var stream = arquivo.OpenReadStream(tamanhoMaximo);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        candidato.FotoBase64 = Convert.ToBase64String(memory.ToArray());
        candidato.FotoContentType = arquivo.ContentType;
        AtualizarProgresso();
    }

    private bool isMobile;

    protected override void OnInitialized()
    {
        isMobile = true; // mostra câmera para todos; em desktop não faz mal
    }

    private async Task SalvarAsync()
    {
        if (string.IsNullOrWhiteSpace(candidato.FotoBase64))
        {
            erroFoto = "A foto é obrigatória.";
            return;
        }

        candidato.CodEmp = CodEmp > 0 ? CodEmp : 2;
        await CurriculoOnlineService.SalvarAsync(candidato);
        candidato = new CandidatoTalentoModel();
        progresso = 0;
        cadastroConcluido = true;
    }

    [Inject] IJSRuntime JS { get; set; } = default!;

}