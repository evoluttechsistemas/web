    private void OnSetorTicketChanged(ChangeEventArgs e)
    {
        if (TicketAtual == null)
            return;

        if (!int.TryParse(e.Value?.ToString(), out var setor))
            return;

        TicketAtual.CodSetor = setor;

        // Evita combinação inválida:
        // Situação Desenvolvimento só deve existir quando o setor for Desenvolvimento.
        if (setor != 2 && TicketAtual.CodSituacao == 2)
            TicketAtual.CodSituacao = 1;
    }

    private void OnSituacaoTicketChanged(ChangeEventArgs e)
    {
        if (TicketAtual == null)
            return;

        if (!int.TryParse(e.Value?.ToString(), out var situacao))
            return;

        TicketAtual.CodSituacao = situacao;

        // Se selecionar situação Desenvolvimento, força o setor Desenvolvimento.
        if (situacao == 2)
            TicketAtual.CodSetor = 2;
    }

