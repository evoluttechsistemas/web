                                </button>

                                <button type="button"
                                        class="btn-icon-acesso btn-entrar-acesso"
                                        title="Acessar"
                                        @onclick="() => AcessarRemoto(acesso)">
                                    ▶
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
