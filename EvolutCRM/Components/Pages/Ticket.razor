    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.img-modal {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
}

    .img-modal img { object-fit: contain; border-radius: 10px; background: #111; }

.img-modal-close {
    background: #f1f5f9;
    color: #0d47a1;
    border: 1px solid #bbdefb;
