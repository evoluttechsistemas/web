    private void IniciarTimerAgenda()
    {
        _ctsAgenda = new CancellationTokenSource();
        _timerAgenda = new PeriodicTimer(TimeSpan.FromSeconds(30));

        _ = Task.Run(async () =>
{
    try
    {
        while (await _timerAgenda.WaitForNextTickAsync(_ctsAgenda.Token))
        {
            await VerificarAgendasVencidas();
        }
    }
    catch (OperationCanceledException) { }
    catch (Exception ex)
    {
        try { await JS.InvokeVoidAsync("crmLog", $"[TimerAgenda] Erro: {ex.Message}"); }
        catch { }
    }
});
    }

    private async Task VerificarAgendasVencidas()
    {
        try
        {
            var usuario = (UserState.CurrentUser ?? "").Trim().ToUpper();

            if (string.IsNullOrWhiteSpace(usuario))
                return;

            var agendas = await TicketService.BuscarAgendasVencidasAsync(usuario);

            foreach (var agenda in agendas)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    $"⏰ Agenda vencida\n\nTicket: #{agenda.CodTicketChamadoC}\nPrazo: {agenda.DataHoraAgenda:dd/MM/yyyy HH:mm}\n\n{agenda.Anotacao}"
                );

                await TicketService.AtualizarUltimaNotificacaoAgendaAsync(agenda.Codigo);
            }

            if (!EhNovo && TicketAtual != null)
            {
                Historico = await TicketService.BuscarHistoricoAsync(TicketAtual.Codigo);

                if (!_usuarioEstaDigitando)
                    await InvokeAsync(StateHasChanged);
                else
                    _renderizacaoPendente = true;
            }
        }
        catch (Exception ex)
        {
            try { await JS.InvokeVoidAsync("crmLog", $"[AgendaLocal] Erro: {ex.Message}"); }
            catch { }
        }
    }

