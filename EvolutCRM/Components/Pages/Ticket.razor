    /// <summary>
    /// 🖼️ Redimensiona e comprime imagens para otimizar o banco de dados
    /// - Máximo: 1920x1080 (mantém proporção)
    /// - Qualidade JPEG: 85%
    /// - Reduz tamanho em até 80%
    /// </summary>
    private async Task<byte[]> RedimensionarImagemAsync(Stream inputStream)
    {
        using var image = await Image.LoadAsync(inputStream);

        // 📏 Define tamanho máximo (mantém proporção)
        const int maxWidth = 1920;
        const int maxHeight = 1080;

        if (image.Width > maxWidth || image.Height > maxHeight)
        {
            image.Mutate(x => x.Resize(new ResizeOptions
            {
                Size = new Size(maxWidth, maxHeight),
                Mode = ResizeMode.Max // mantém proporção
            }));
        }

        // 💾 Converte para JPEG com qualidade 85%
        using var outputStream = new MemoryStream();
        await image.SaveAsJpegAsync(outputStream, new JpegEncoder
        {
            Quality = 85
        });

        return outputStream.ToArray();
    }

