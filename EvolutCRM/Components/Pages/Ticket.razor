@if (_mostrarModalF1)
{
    <div class="insight-modal-backdrop">
        <div class="insight-modal-card">

            <div class="insight-modal-header">
                <div class="insight-modal-icon"
                     style="background:linear-gradient(135deg,#d97706,#b45309);">
                    <span>F1</span>
                </div>
                <div>
                    <h4 class="insight-modal-title">
                        @(_etapaModalF1 == 1 ? "Selecione o responsável"
                        : _etapaModalF1 == 2 ? "Selecione o tipo"
                        : "Informe a versão")
                    </h4>
                    <p class="insight-modal-subtitle">
                        @if (_etapaModalF1 == 1)
                        {
                            <text>Pressione o número ou clique para selecionar.</text>
                        }
                        else if (_etapaModalF1 == 2)
                        {
                            <text>Responsável: <strong>@_responsavelSelecionadoF1</strong> · Pressione o número ou clique.</text>
                        }
                        else
                        {
                            <text>Responsável: <strong>@_responsavelSelecionadoF1</strong> · Tipo: <strong>@(TiposTicket.FirstOrDefault(t => t.Codigo == _tipoSelecionadoF1)?.Descricao)</strong></text>
                        }
                    </p>
                </div>
            </div>

            <div class="insight-modal-highlight"
                 style="background:#fffbeb; border-color:#fcd34d; color:#92400e;">
                @if (_etapaModalF1 <= 2)
                {
                    <text><strong>Atalho:</strong> pressione o número da opção · <strong>ESC</strong> cancela</text>
                }
                else
                {
                    <text><strong>Enter</strong> confirma · <strong>ESC</strong> cancela</text>
                }
            </div>

            <div class="insight-modal-actions">

                @if (_etapaModalF1 == 1)
                {
                    @for (int i = 0; i < Usuarios.Count; i++)
                    {
                        var idx = i + 1;
                        var usuario = Usuarios[i];
                        <button type="button"
                                class="btn insight-btn insight-btn-light"
                                style="justify-content:flex-start; gap:12px;"
                                @onclick="async () =>
                                {
                                    _responsavelSelecionadoF1 = usuario;
                                    _etapaModalF1 = 2;
                                    await InvokeAsync(StateHasChanged);
                                }">
                            <span style="width:28px; height:28px; border-radius:8px;
                                background:#0d47a1; color:#fff;
                                display:inline-flex; align-items:center;
                                justify-content:center; font-weight:900;
                                font-size:.8rem; flex-shrink:0;">
                                @idx
                            </span>
                            @usuario
                        </button>
                    }
                }
                else if (_etapaModalF1 == 2)
                {
                    @for (int i = 0; i < TiposTicket.Count; i++)
                    {
                        var idx = i + 1;
                        var tipo = TiposTicket[i];
                        <button type="button"
                                class="btn insight-btn insight-btn-light"
                                style="justify-content:flex-start; gap:12px;"
                                @onclick="async () =>
                                {
                                    _tipoSelecionadoF1 = tipo.Codigo;
                                    _etapaModalF1 = 3;
                                    await InvokeAsync(StateHasChanged);
                                }">
                            <span style="width:28px; height:28px; border-radius:8px;
                                background:#0d47a1; color:#fff;
                                display:inline-flex; align-items:center;
                                justify-content:center; font-weight:900;
                                font-size:.8rem; flex-shrink:0;">
                                @idx
                            </span>
                            @tipo.Descricao
                        </button>
                    }
                }
                else if (_etapaModalF1 == 3)
                {
                    <div class="grupo" style="margin-bottom:8px;">
                        <label style="font-size:.72rem; color:#92400e; font-weight:900;">
                            Versão do sistema
                        </label>
                        <input id="inputVersaoF1"
                               value="@_versaoF1"
                               @oninput="OnVersaoInputF1"
                               @onkeydown="OnKeyDownVersaoF1"
                               placeholder="Ex.: 25.07.21"
                               maxlength="8"
                               style="height:42px; font-size:1rem; font-weight:700;
                        border:2px solid #fcd34d; border-radius:10px;
                        padding:8px 12px; text-align:center;
                        letter-spacing:.1em;" />
                        <small class="hint" style="margin-top:6px; color:#92400e;">
                            Pressione Enter para confirmar
                        </small>
                    </div>

                    <button type="button"
                            class="btn insight-btn"
                            style="background:linear-gradient(135deg,#d97706,#b45309);
                        color:#fff; border:none;"
                            @onclick="ConfirmarVersaoF1">
                        ✅ Confirmar atualização
                    </button>
                }

                <button type="button"
                        class="btn insight-btn insight-btn-light"
                        style="margin-top:4px;"
                        @onclick="CancelarModalF1">
                    ✕ Cancelar
                </button>

            </div>
        </div>
    </div>
}

