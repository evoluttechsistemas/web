    private string GerarCorUsuario(string nome)
    {
        string[] cores =
        {
             "#e53935", // vermelho
        "#1976d2", // azul
        "#43a047", // verde
        "#8e24aa", // roxo
        "#fb8c00", // laranja
        "#00897b", // teal
        "#3949ab", // índigo
        "#d81b60", // rosa
        "#5e35b1", // violeta
        "#546e7a"  // cinza
    };

        int indice = Math.Abs(nome.GetHashCode()) % cores.Length;

        return cores[indice];
    }
