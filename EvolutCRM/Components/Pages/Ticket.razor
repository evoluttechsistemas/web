    private void CapitalizarPrimeiraLetraMensagem()
    {
        if (string.IsNullOrEmpty(NovaAnotacao))
            return;

        var cultura = new System.Globalization.CultureInfo("pt-BR");
        var letras = NovaAnotacao.ToCharArray();

        for (var i = 0; i < letras.Length; i++)
        {
            if (char.IsLetter(letras[i]))
            {
                var maiuscula = char.ToUpper(letras[i], cultura);

                if (letras[i] != maiuscula)
                {
                    letras[i] = maiuscula;
                    NovaAnotacao = new string(letras);
                }

                return;
            }
        }
    }
