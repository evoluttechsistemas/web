@if (Carregando)
{
    <div class="titulo">Carregando Ticket...</div>
}

else if (EhNovo)
{
    <div class="container-ticket ticket-modern-container">

        <header class="ticket-modern-topbar">
            <div class="ticket-header-left">
                <button type="button" class="ticket-back-btn" @onclick="Voltar" title="Voltar">←</button>
                <div class="ticket-title-wrap">
                    <div class="ticket-ticket-line">
                        <div class="ticket-code-box">
                            <span class="ticket-code-number">NOVO</span>
                        </div>
                        <span style="font-size:.76rem; color:#dbeafe; font-weight:800;">
                            Abertura de Ticket
                        </span>
                    </div>
                    <div style="font-size:.68rem; color:rgba(255,255,255,.6); font-weight:600; margin-top:1px;">
                        Novo chamado de suporte
                    </div>
                </div>
            </div>
            <div class="ticket-header-right">
                <div class="ticket-kpi-card">
                    <small>Criado por</small>
                    <strong>@UserState.CurrentUser</strong>
                </div>
            </div>
        </header>

        <div class="ticket-modern-grid" style="flex:1 1 0; min-height:0; height:0;">

            <!-- ESQUERDA: vazia no modo novo (documentação não se aplica) -->
            <aside class="ticket-modern-panel ticket-modern-left">
                <div class="ticket-panel-title" style="margin-bottom:10px;">
                    <span>📚 Documentação</span>
                </div>
                <div class="grupo">
                    <input class="ticket-doc-search"
                           @bind="BuscaDoc"
                           @bind:event="oninput"
                           @bind:after="BuscarDocumentacoes"
                           placeholder="Ex.: entrada xml, estoque, pdv..." />
                    @if (BuscandoDocs)
                    {
                        <small class="hint" style="margin-top:6px; display:block;">Buscando...</small>
                    }
                    @if (DocsEncontradas.Any())
                    {
                        <div class="ticket-doc-results" style="margin-top:8px;">
                            @foreach (var doc in DocsEncontradas)
                            {
                                <div class="ticket-doc-card">
                                    <a href="@doc.Url" target="_blank">🔗 @doc.Title</a>
                                    <div class="ticket-doc-preview">@doc.Preview</div>
                                    <button type="button" class="btn-inserir-doc"
                                            @onclick="async () => await InserirUrlDocNaMensagem(doc)">
                                        📎 Inserir na mensagem
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </aside>

            <!-- CENTRO: formulário de criação -->
            <main class="ticket-modern-panel ticket-modern-center"
                  style="height:100%; display:flex; flex-direction:column; overflow:hidden; padding:0;
                background:#f8fbff !important; background-image:none !important;">

                <!-- Cabeçalho verde igual ao histórico -->
                <div style="flex:0 0 auto; height:38px; display:flex; align-items:center;
                    padding:0 14px; background:linear-gradient(135deg,#0d47a1,#07306f);
                    color:#fff; font-size:11px; font-weight:800; letter-spacing:.02em;
                    border-radius:8px 8px 0 0;">
                    🎫 Dados do Ticket
                </div>

                <!-- Conteúdo rolável -->
                <div style="flex:1 1 0; overflow-y:auto; padding:16px;">

                    <!-- LINHA 1: Responsável / Destino / Cliente -->
                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:12px;">
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Responsável</label>
                            <select @bind="UsuarioSelecionado" class="@(ResponsavelInvalido ? "select-erro" : "")">
                                <option value="">Selecione...</option>
                                @foreach (var u in Usuarios)
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                        </div>

                        <div class="grupo" style="margin-bottom:0;">
                            <label>Destino</label>
                            <select @bind="TipoEnvioCliente">
                                <option value="UNICO">Cliente específico</option>
                                <option value="TODOS_MENSALISTAS">Todos mensalistas</option>
                            </select>
                            @if (TipoEnvioCliente == "TODOS_MENSALISTAS")
                            {
                                <small class="hint" style="color:#b45309;">⚠️ Um ticket por mensalista.</small>
                            }
                        </div>

                        @if (TipoEnvioCliente == "UNICO")
                        {
                            <div class="grupo" style="margin-bottom:0; position:relative;">
                                <label>Cliente</label>
                                <input @bind="ClienteBusca"
                                       @bind:event="oninput"
                                       @bind:after="BuscarClientes"
                                       class="@(ClienteInvalido ? "select-erro" : "")"
                                       placeholder="Código ou nome..." />
                                @if (ClienteInvalido)
                                {
                                    <small style="color:#e53935; font-weight:700;">Selecione um cliente.</small>
                                }
                                @if (Sugestoes?.Any() == true)
                                {
                                    <ul class="autocomplete-list" style="position:absolute; top:100%; left:0; right:0; z-index:999;">
                                        @foreach (var cli in Sugestoes)
                                        {
                                            <li @onclick="async () => await SelecionarCliente(cli)">
                                                <strong>@cli.Codigo</strong> - @cli.Nome
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="grupo" style="margin-bottom:0;">
                                <label>Cliente</label>
                                <input value="Todos os mensalistas ativos" disabled />
                            </div>
                        }
                    </div>

                    <!-- LINHA 2: Assunto / Setor / Situação / Tipo / Prioridade -->
                    <div style="display:grid; grid-template-columns:2fr 1fr 1fr 1fr 1fr; gap:8px; margin-bottom:12px;">
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Assunto</label>
                            <input @bind="Assunto" placeholder="Ex.: Ajustar impressão da NFC-e" />
                        </div>
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Setor</label>
                            <select @bind="CodSetor">
                                @foreach (var setor in SetoresTicket)
                                {
                                    <option value="@setor.Codigo">@setor.Descricao</option>
                                }
                            </select>
                        </div>
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Situação</label>
                            <select @bind="CodSituacao" disabled="@(!PodeAlterarStatusTicket)">
                                @foreach (var situacao in SituacoesTicket)
                                {
                                    <option value="@situacao.Codigo">@situacao.Descricao</option>
                                }
                            </select>
                        </div>
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Tipo</label>
                            <select value="@CodTipo" @onchange="OnTipoChanged">
                                @foreach (var tipo in TiposTicket)
                                {
                                    <option value="@tipo.Codigo">@tipo.Descricao</option>
                                }
                            </select>
                        </div>
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Prioridade</label>
                            <select @bind="Prioridade">
                                <option value="1">Baixa</option>
                                <option value="2">Normal</option>
                                <option value="3">Alta</option>
                                <option value="4">Urgente</option>
                            </select>
                        </div>
                    </div>

                    @if (CodTipo == 4)
                    {
                        <div class="grupo">
                            <label>Usuário do Cliente</label>
                            <select @bind="UsuarioSelecionadoCodigo">
                                <option value="">Selecione um usuário</option>
                                @foreach (var usuario in UsuariosCliente)
                                {
                                    <option value="@usuario.Codigo">@usuario.Usuario</option>
                                }
                            </select>
                            <small class="hint">Este usuário será usado para direcionar o chamado ao cliente.</small>
                        </div>
                    }

                    @if (CodTipo == 5)
                    {
                        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:12px;">
                            <div class="grupo" style="margin-bottom:0;">
                                <label>Contato WhatsApp</label>
                                <select @onchange="SelecionarTelefoneWhatsApp">
                                    <option value="">Selecione um contato</option>
                                    @if (CodCliente > 0)
                                    {
                                        @foreach (var contato in TelefonesWhatsAppCliente)
                                        {
                                            <option value="@contato.Telefone">@contato.Nome - @contato.Telefone</option>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var contato in ContatosWhatsAppGlobais)
                                        {
                                            <option value="@contato.Telefone">@contato.Nome - @contato.Telefone</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="grupo" style="margin-bottom:0;">
                                <label>Nome</label>
                                <input @bind="NomeWhatsApp" placeholder="Ex.: Gabriel" />
                            </div>
                            <div class="grupo" style="margin-bottom:0;">
                                <label>Número telefone</label>
                                <input @bind="TelefoneWhatsApp" placeholder="Ex.: 16999999999" />
                            </div>
                        </div>
                    }

                    <div style="height:1px; background:linear-gradient(90deg,#bfdbfe,transparent); margin:8px 0 12px;"></div>

                    <!-- Observação -->
                    <div class="grupo" style="margin-bottom:12px;">
                        <label>Observação / Detalhamento</label>
                        <textarea id="obsAnotacaoNovo"
                                  @bind="NovaAnotacao"
                                  @bind:event="oninput"
                                  spellcheck="true"
                                  lang="pt-BR"
                                  autocomplete="on"
                                  style="min-height:120px; max-height:220px; resize:vertical;"
                                  placeholder="Descreva aqui o que precisa ser feito..."></textarea>
                        <small class="hint">Erros sublinhados automaticamente. Botão direito para sugestões.</small>
                    </div>

                    <!-- Agenda + Anexo -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">

                        <div class="agenda-box" style="margin-top:0; padding:8px;">
                            <label class="agenda-check">
                                <input type="checkbox" @bind="CriarAgenda" />
                                <span class="agenda-icon" style="width:22px;height:22px;font-size:11px;">📅</span>
                                <span>Criar agenda</span>
                            </label>
                            @if (CriarAgenda)
                            {
                                <div style="margin-top:8px;">
                                    <label>Data/Hora</label>
                                    <input type="datetime-local" @bind="DataHoraAgenda" />
                                    <label class="agenda-check" style="margin-top:6px; font-size:.72rem;">
                                        <input type="checkbox" @bind="NotificarAgenda" />
                                        <span>Notificar quando vencer</span>
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="ticket-anexo-box" style="margin-top:0; padding:8px;">
                            <label>Anexo</label>
                            <InputFile OnChange="OnArquivoAnotacaoSelecionado"
                                       accept=".pdf,.txt,.csv,.xml,.json,.jpg,.jpeg,.png,.gif,.webp,.bmp,.doc,.docx,.xls,.xlsx,.zip,.rar,.apk,.pfx,.p12" />
                            <div class="ticket-composer-tools" style="margin-top:6px;">
                                @if (!GravandoTela)
                                {
                                    <button type="button" class="ticket-tool-btn" title="Gravar tela" @onclick="IniciarGravacaoTela">🎥</button>
                                }
                                else
                                {
                                    <button type="button" class="ticket-tool-btn gravando" title="Parar" @onclick="PararGravacaoTela">⏹</button>
                                }
                                <button class="ticket-tool-btn @(gravandoAudio ? "gravando" : "")" @onclick="AlternarGravacao">
                                    @(gravandoAudio ? "⏹" : "🎤")
                                </button>
                                <span style="font-size:.68rem; color:#64748b; font-weight:800;">
                                    @(gravandoAudio ? "Gravando..." : GravandoTela ? "Gravando tela..." : "Áudio / Tela")
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(previewAudio))
                            {
                                <div class="audio-mini-container" style="margin-top:6px;">
                                    <span class="audio-mini-icon">🎧</span>
                                    <audio controls class="audio-mini-player" src="@previewAudio"></audio>
                                    <button type="button" class="audio-mini-speed" @onclick="RemoverAudio">Remover</button>
                                </div>
                            }

                            @if (VideoGravado != null)
                            {
                                <div style="margin-top:6px; font-size:10px; color:#0d47a1; font-weight:800;">
                                    🎥 @VideoGravadoNome
                                    <button type="button" class="btn-voltar"
                                            style="margin-left:6px; padding:2px 8px; font-size:9px;"
                                            @onclick="RemoverVideoGravado">
                                        ✕
                                    </button>
                                </div>
                            }

                            @if (ArquivoAnotacao != null)
                            {
                                var extN = Path.GetExtension(NomeArquivoAnotacao).ToLowerInvariant();
                                var ehImagemN = extN is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";
                                <div style="margin-top:6px;">
                                    <div style="font-size:10px; color:#0d47a1; font-weight:800;">
                                        📎 @NomeArquivoAnotacao
                                        <button type="button" class="btn-voltar"
                                                style="margin-left:6px; padding:2px 8px; font-size:9px;"
                                                @onclick="RemoverArquivoAnotacao">
                                            ✕
                                        </button>
                                    </div>
                                    @if (ehImagemN && !string.IsNullOrEmpty(PreviewArquivoAnotacao))
                                    {
                                        <img src="@PreviewArquivoAnotacao"
                                             style="margin-top:6px; max-width:100%; max-height:80px; border-radius:6px; border:1px solid #90caf9;" />
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <!-- Rodapé sticky — igual ao compositor do ticket existente -->
                <div style="flex:0 0 auto; background:#f0f2f5; border-top:1px solid #d1d5db; padding:10px 12px;">
                    <button class="btn-primary"
                            style="border-radius:10px; padding:12px 14px; font-size:.84rem; font-weight:950;"
                            @onclick="CriarTicket"
                            disabled="@Salvando">
                        ✈ @(Salvando ? "Salvando..." : TipoEnvioCliente == "TODOS_MENSALISTAS" ? "Enviar para todos mensalistas" : "Salvar Ticket")
                    </button>
                    @if (!string.IsNullOrEmpty(Mensagem))
                    {
                        <div class="msg @(Sucesso ? "sucesso" : "erro")" style="margin-top:6px;">@Mensagem</div>
                    }
                </div>

            </main>

            <!-- DIREITA: perfil do atendente -->
            <aside class="ticket-modern-panel ticket-modern-right">

                <div class="ticket-info-profile">
                    <div class="ticket-info-avatar">
                        @((UserState.CurrentUser ?? "?").Trim().Length >= 2
                            ? UserState.CurrentUser!.Trim()[..2].ToUpper()
                            : "?")
                    </div>
                    <div style="min-width:0;">
                        <div style="font-size:.72rem; color:#64748b; font-weight:800;">Criado por</div>
                        <div style="font-weight:950; color:#0d47a1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @UserState.CurrentUser
                        </div>
                        <div style="font-size:.72rem; color:#16a34a; font-weight:900;">● Atendente</div>
                    </div>
                </div>

                <div class="ticket-info-stats">
                    <div class="ticket-info-stat"><strong>—</strong><span>Tickets hoje</span></div>
                    <div class="ticket-info-stat"><strong>—</strong><span>Em aberto</span></div>
                    <div class="ticket-info-stat"><strong>—</strong><span>Finalizados</span></div>
                </div>


            </aside>

        </div>
    </div>
}
else if (TicketAtual == null)
{
    <div class="titulo">Ticket não encontrado</div>
}
else
{
    var ticketEhWhatsApp = !string.IsNullOrWhiteSpace(TicketAtual.TelefoneWhatsApp);
    var telefoneOrigemWhats = ticketEhWhatsApp ? TicketAtual.TelefoneWhatsApp : NumeroTelefone;

    <div class="container-ticket ticket-modern-container">

        <header class="ticket-modern-topbar">
            <div class="ticket-header-left">
                <button type="button" class="ticket-back-btn" @onclick="Voltar" title="Voltar">←</button>
                <div class="ticket-title-wrap">
                    <div class="ticket-ticket-line">
                        <div class="ticket-code-box">
                            <span class="ticket-code-number">#@TicketAtual.Codigo</span>
                        </div>
                        @if (ticketEhWhatsApp)
                        {
                            <span class="ticket-whatsapp-chip">
                                <span class="ticket-whats-icon">🟢</span>
                                WhatsApp
                                @if (!string.IsNullOrWhiteSpace(telefoneOrigemWhats))
                                {
                                    <small>@telefoneOrigemWhats</small>
                                }
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="ticket-header-right">
                <div class="ticket-history-header-actions">
                    <button type="button" class="btn-acesso-remoto" @onclick="AbrirModalAcessoRemoto">
                        <span class="btn-acesso-remoto-icon">▶</span>
                        <span>Acesso remoto</span>
                    </button>
                    <button type="button" class="btn-tickets-cliente" @onclick="AbrirModalTicketsCliente">
                        📁 Tickets do cliente
                    </button>
                </div>
                <div class="ticket-kpi-card">
                    <small>Tempo aberto</small>
                    <strong>@TempoEmAtendimentoTexto</strong>
                </div>
                <div class="ticket-kpi-card">
                    <small>Resp. média</small>
                    <strong>@TempoMedioRespostaTexto</strong>
                </div>
                @if (VisualizadoresTicket.Any())
                {
                    <div class="ticket-viewers">
                        @foreach (var usuario in VisualizadoresTicket)
                        {
                            <div class="visualizador-badge"
                                 title="@usuario.Usuario"
                                 style="background:@GerarCorUsuario(usuario.Usuario)">
                                @usuario.Usuario.Substring(0, 2).ToUpper()
                            </div>
                        }
                    </div>
                }
            </div>
        </header>

        <div class="ticket-modern-grid" style="flex:1 1 0; min-height:0; height:0;">


            <!-- CENTRO: HISTÓRICO + COMPOSITOR -->
            <main class="ticket-modern-panel ticket-modern-center ticket-history-main"
                  style="display:flex; flex-direction:column; overflow:hidden; padding:0;">

                <!-- Histórico -->
                <div class="historico-wrap">
                    @foreach (var h in Historico)
                    {
                        var souEu = MesmoUsuario(h.Usuario, UserState.CurrentUser);
                        var editandoEstaMensagem = CodigoMensagemEditando == h.Codigo;
                        var temTexto = !string.IsNullOrWhiteSpace(h.Anotacao);
                        var temAudio = !string.IsNullOrWhiteSpace(h.AudioUrl);

                        var podeEditarMensagem =
                            souEu &&
                            h.EnvioCliente != "S" &&
                            h.MensagemExcluida != "S" &&
                            temTexto &&
                            !temAudio;

                        var podeExcluirMensagem =
                            souEu &&
                            h.EnvioCliente != "S" &&
                            h.MensagemExcluida != "S";

                        bool mensagemCliente =
                            (h.EnvioCliente ?? "N")
                            .Trim()
                            .Equals("S", StringComparison.OrdinalIgnoreCase);

                        souEu = !mensagemCliente;

                        <div class="historico-box @(souEu ? "hist-me" : "hist-other") @(h.Interno == "S" ? "hist-interno" : "")"
                             id="msg-@h.Codigo" @key="h.Codigo">

                            @if (h.Interno == "S")
                            {
                                <div class="hist-interno-label">🔒 Interno</div>
                            }

                            @if (h.CodMensagemRespondida.HasValue && !string.IsNullOrWhiteSpace(h.TextoMensagemRespondida))
                            {
                                <div class="historico-quote" @onclick="() => RolarParaMensagem(h.CodMensagemRespondida.Value)">
                                    <div class="historico-quote-usuario">@h.UsuarioMensagemRespondida</div>
                                    <div class="historico-quote-texto">@h.TextoMensagemRespondida</div>
                                </div>
                            }

                            <div class="historico-topo">
                                <span>@h.Usuario</span>
                                <span>@h.DataHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            @if (h.MensagemExcluida == "S")
                            {
                                <span class="historico-texto" style="font-style:italic; opacity:.75;">
                                    🗑️ Mensagem excluída
                                </span>
                            }
                            else
                            {
                                @if (editandoEstaMensagem)
                                {
                                    <textarea class="edit-msg-textarea" @bind="TextoMensagemEditando"></textarea>
                                    <div class="edit-msg-actions">
                                        <button type="button" class="btn-salvar-edit-msg" @onclick="SalvarEdicaoMensagem">💾 Salvar</button>
                                        <button type="button" class="btn-cancelar-edit-msg" @onclick="CancelarEdicaoMensagem">Cancelar</button>
                                        <button type="button" class="btn-msg-action" @onclick="() => IniciarResposta(h)">↩ Responder</button>
                                    </div>
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(h.Anotacao))
                                    {
                                        <span class="historico-texto">
                                            @foreach (var parte in SepararUrlsDoTexto(h.Anotacao))
                                            {
                                                if (parte.StartsWith("http://") || parte.StartsWith("https://"))
                                                {
                                                    <a href="@parte" target="_blank"
                                                       style="color:#2563eb; text-decoration:underline; word-break:break-all;">@parte</a>
                                                }
                                                else
                                                {
                                                    @parte
                                                }
                                            }
                                        </span>
                                    }
                                    @if (h.Alterado == "S")
                                    {
                                        <div class="msg-editada-label">✏️ editada</div>
                                    }
                                }

                                @if ((podeEditarMensagem && !editandoEstaMensagem) || podeExcluirMensagem)
                                {
                                    <div class="msg-actions">
                                        @if (podeEditarMensagem && !editandoEstaMensagem)
                                        {
                                            <button type="button" class="btn-msg-action"
                                                    @onclick="() => IniciarEdicaoMensagem(h.Codigo, h.Anotacao)">
                                                ✏️ Editar
                                            </button>
                                        }
                                        @if (podeExcluirMensagem)
                                        {
                                            <button type="button" class="btn-msg-action"
                                                    @onclick="() => ExcluirMensagem(h.Codigo)">
                                                🗑️ Excluir
                                            </button>
                                        }
                                        <button type="button" class="btn-msg-action" @onclick="() => IniciarResposta(h)">↩ Responder</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="msg-actions">
                                        <button type="button" class="btn-msg-action" @onclick="() => IniciarResposta(h)">↩ Responder</button>
                                    </div>
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(h.VideoUrl))
                            {
                                <div class="video-message-box">
                                    <video controls class="video-message-player">
                                        <source src="@h.VideoUrl" type="@(h.VideoMimeType ?? "video/mp4")" />
                                        Seu navegador não suporta vídeo.
                                    </video>
                                    <div class="video-message-name">🎥 @h.VideoFileName</div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(h.StatusEnvioWhatsApp) && h.EnvioCliente != "S")
                            {
                                <div class="msg-status-whats">
                                    @{
                                        var statusWhats = (h.StatusEnvioWhatsApp ?? "").Trim().ToLower();
                                    }
                                    @switch (statusWhats)
                                    {
                                        case "":
                                        case "sending":
                                        case "pending":
                                            <span style="color:#fef3c7;">🕓 Enviando...</span>
                                            break;
                                        case "sent":
                                            <span style="color:#ffffff;">✓ Enviado</span>
                                            break;
                                        case "received":
                                        case "delivered":
                                        case "delivery_ack":
                                        case "delivered2user":
                                            <span style="color:#ffffff;">✓✓ Entregue</span>
                                            break;
                                        case "read":
                                        case "read_ack":
                                            <span style="color:#90caf9;">✓✓ Lido</span>
                                            break;
                                        case "error":
                                        case "failed":
                                            <span style="color:#ffb4b4;">⚠ Erro</span>
                                            break;
                                        default:
                                            <span style="color:#fef3c7;">🕓 Enviando...</span>
                                            break;
                                    }
                                </div>
                            }

                            @if (h.NovaAgenda == "S")
                            {
                                var agendaVencida = h.AgendaResolvida != "S"
                                    && h.DataHoraAgenda.HasValue
                                    && h.DataHoraAgenda.Value <= DateTime.Now;

                                <div class="agenda-card @(agendaVencida ? "vencida" : "futura")">
                                    <div class="agenda-title">
                                        <span>@(agendaVencida ? "⏰ Agenda vencida" : "📅 Agenda")</span>
                                        <span class="agenda-badge">@(h.AgendaResolvida == "S" ? "Resolvida" : "Pendente")</span>
                                    </div>
                                    <div>Prazo: @(h.DataHoraAgenda?.ToString("dd/MM/yyyy HH:mm") ?? "Sem data")</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(h.CaminhoImagem))
                            {
                                var nomeParaExt = !string.IsNullOrWhiteSpace(h.NomeImagem)
                                    ? h.NomeImagem
                                    : h.CaminhoImagem?.Split('?')[0] ?? "";
                                var ext = Path.GetExtension(nomeParaExt).ToLowerInvariant();
                                var ehImagem = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";
                                var ehPdf = ext == ".pdf";

                                <div style="margin-top:10px;">
                                    @if (ehImagem)
                                    {
                                        <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:10px;">
                                            <div style="font-weight:800; color:#0d47a1; margin-bottom:8px;">
                                                🖼️ @(h.NomeImagem ?? "imagem-whatsapp.jpg")
                                            </div>
                                            <img src="@h.CaminhoImagem"
                                                 class="thumb"
                                                 style="width:auto; max-width:220px; max-height:220px; object-fit:cover;
                                            background:#f8fafc; cursor:zoom-in; display:block; margin:auto;
                                            border-radius:10px; border:2px solid #90caf9;"
                                                 @onclick="() => AbrirImagem(h.CaminhoImagem)" />
                                            <a href="@h.CaminhoImagem"
                                               target="_blank"
                                               download="@(h.NomeImagem ?? "imagem-whatsapp.jpg")"
                                               class="btn-voltar"
                                               style="display:block; text-align:center; text-decoration:none;">
                                                Baixar imagem
                                            </a>
                                        </div>
                                    }
                                    else if (ehPdf)
                                    {
                                        <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px;
                                            padding:10px 12px; max-width:280px;">
                                            <div style="display:flex; align-items:center; gap:10px; cursor:pointer;"
                                                 onclick="window.open('@h.CaminhoImagem', '_blank')">
                                                <div style="width:42px; height:48px; flex-shrink:0; background:#e8f0fe;
                                                    border-radius:6px; border:1.5px solid #c5d5f5;
                                                    display:flex; flex-direction:column; align-items:center;
                                                    justify-content:center; gap:2px;">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                                                              stroke="#1a56db" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="#dbeafe" />
                                                        <polyline points="14 2 14 8 20 8"
                                                                  stroke="#1a56db" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                    </svg>
                                                    <span style="font-size:7px; font-weight:900; color:#1a56db; letter-spacing:.04em;">PDF</span>
                                                </div>
                                                <div style="min-width:0; flex:1;">
                                                    <div style="font-size:12px; font-weight:700; color:#0f172a;
                                                        white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px;">
                                                        @(h.NomeImagem ?? "arquivo.pdf")
                                                    </div>
                                                    <div style="font-size:10px; color:#64748b; margin-top:2px; font-weight:600;">
                                                        PDF · Toque para abrir
                                                    </div>
                                                </div>
                                            </div>
                                            <div style="display:flex; gap:8px; margin-top:10px; border-top:1px solid #f1f5f9; padding-top:8px;">
                                                <a href="@h.CaminhoImagem" target="_blank"
                                                   style="flex:1; text-align:center; font-size:10px; font-weight:800;
                                                    color:#1a56db; text-decoration:none; padding:5px 0;
                                                    border-radius:6px; background:#eff6ff; border:1px solid #bfdbfe;">
                                                    🔍 Abrir
                                                </a>
                                                <a href="@h.CaminhoImagem" download="@(h.NomeImagem ?? "arquivo.pdf")"
                                                   style="flex:1; text-align:center; font-size:10px; font-weight:800;
                                                    color:#16a34a; text-decoration:none; padding:5px 0;
                                                    border-radius:6px; background:#f0fdf4; border:1px solid #bbf7d0;">
                                                    ⬇ Baixar
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        var ehTexto = ext is ".txt" or ".csv" or ".xml" or ".json";
                                        @if (ehTexto)
                                        {
                                            <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; overflow:hidden;">
                                                <div style="padding:8px 12px; font-weight:700; color:#0d47a1; border-bottom:1px solid #e2e8f0;">
                                                    📄 @(h.NomeImagem ?? "arquivo")
                                                </div>
                                                <iframe src="@h.CaminhoImagem"
                                                        style="width:100%; height:320px; border:none; background:white;"></iframe>
                                                <div style="padding:10px;">
                                                    <a href="@h.CaminhoImagem" target="_blank" class="btn-voltar">Abrir em nova aba</a>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:12px;">
                                                <strong style="color:#0d47a1;">📎 @(h.NomeImagem ?? "arquivo")</strong>
                                                <div style="font-size:13px; color:#455a64; margin-top:6px;">
                                                    Este tipo de arquivo não pode ser visualizado diretamente pelo navegador.
                                                </div>
                                                <a href="@h.CaminhoImagem" target="_blank" class="btn-voltar">Abrir / Baixar arquivo</a>
                                            </div>
                                        }
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(h.AudioUrl))
                            {
                                <div class="audio-mini-container">
                                    <audio controls class="audio-mini-player"
                                           onloadedmetadata="window.aplicarVelocidadeAudio(this)">
                                        <source src="@h.AudioUrl" type="@(h.AudioMimeType ?? "audio/mpeg")" />
                                    </audio>
                                    <button type="button" class="audio-mini-speed" @onclick="AlterarVelocidadeAudioGlobal">
                                        @($"{VelocidadeAudioGlobal:0.#}x")
                                    </button>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(h.TranscricaoAudio))
                                {
                                    var ehErro = h.TranscricaoAudio.StartsWith("[ERRO:");
                                    <div style="margin-top:5px; padding:6px 10px;
                                        background:@(ehErro ? "rgba(220,38,38,.07)" : "rgba(0,0,0,.05)");
                                        border-radius:8px;
                                        border-left:3px solid @(ehErro ? "#dc2626" : "#25d366");
                                        font-size:10.5px;
                                        color:@(ehErro ? "#7f1d1d" : "#374151");
                                        line-height:1.45; font-style:italic;">
                                        @(ehErro ? "⚠️" : "🗒️")
                                        <strong style="font-style:normal; font-size:9.5px; text-transform:uppercase; letter-spacing:.04em;">
                                            @(ehErro ? "Erro na transcrição" : "Transcrição")
                                        </strong><br />
                                        @(ehErro ? "" : h.TranscricaoAudio)
                                    </div>
                                }
                                else if (h.AudioTranscrito != "S" && h.EnvioCliente == "S"
                                         && h.StatusEnvioWhatsApp != "transcricao_erro")
                                {
                                    <div style="margin-top:4px; font-size:9.5px; color:#94a3b8; font-style:italic;">
                                        ⏳ Transcrevendo áudio...
                                    </div>
                                }
                            }

                        </div>
                    }
                </div>

                <!-- COMPOSITOR — fixo na parte inferior -->
                <div style="flex:0 0 auto; background:#f0f2f5; border-top:1px solid #d1d5db; padding:10px 12px;">

                    @if (!PodeResponderTickets)
                    {
                        <div class="msg erro" style="margin:0;">
                            Você pode visualizar este ticket, mas não tem permissão para responder ou alterar.
                        </div>
                    }
                    else
                    {
                        @if (MensagemRespondida != null)
                        {
                            <div class="msg-quote-preview" style="margin-bottom:6px;">
                                <div>
                                    <div style="font-size:9px; font-weight:800; color:#075e54;">
                                        Respondendo @MensagemRespondida.Usuario
                                    </div>
                                    <div class="msg-quote-preview-text">@MensagemRespondida.Anotacao</div>
                                </div>
                                <button type="button" class="msg-quote-cancel" @onclick="CancelarResposta">✕</button>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(SugestaoIA))
                        {
                            <div style="margin-bottom:6px; padding:8px 10px; background:#f0f7ff;
                                border:1px solid #bfdbfe; border-radius:8px; font-size:10px; color:#1d4ed8;">
                                ✅ Resposta da IA inserida abaixo. Revise antes de enviar.
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(TicketAtual.AssuntoSugerido)
                             && TicketAtual.AssuntoSugeridoStatus == "pendente")
                        {
                            <div style="margin-bottom:6px; padding:8px 10px; background:#f0f7ff;
                                border:1px solid #bfdbfe; border-radius:8px; font-size:10px;">
                                <div style="font-weight:800; color:#1d4ed8; margin-bottom:3px;">🤖 Sugestão da IA</div>
                                <div style="color:#0f172a;">@TicketAtual.AssuntoSugerido</div>
                                @if (!string.IsNullOrWhiteSpace(TicketAtual.SentimentoEmoji))
                                {
                                    <div style="margin-top:3px;">
                                        Sentimento: @TicketAtual.SentimentoEmoji @TicketAtual.SentimentoCliente
                                    </div>
                                }
                            </div>
                        }

                        @if (ArquivoAnotacao != null)
                        {
                            var extPrev = Path.GetExtension(NomeArquivoAnotacao).ToLowerInvariant();
                            var ehImgPrev = extPrev is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;
                                padding:4px 8px; background:#eff6ff; border-radius:6px;
                                font-size:10px; color:#0d47a1; font-weight:800;">
                                📎 @NomeArquivoAnotacao
                                @if (ehImgPrev && !string.IsNullOrEmpty(PreviewArquivoAnotacao))
                                {
                                    <img src="@PreviewArquivoAnotacao"
                                         style="max-height:32px; border-radius:4px; border:1px solid #90caf9;" />
                                }
                                <button type="button" class="btn-remover-midia" @onclick="RemoverArquivoAnotacao">✕</button>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(previewAudio))
                        {
                            <div class="audio-mini-container" style="margin-bottom:6px;">
                                <span class="audio-mini-icon">🎧</span>
                                <audio controls class="audio-mini-player" src="@previewAudio"></audio>
                                <button type="button" class="audio-mini-speed" @onclick="RemoverAudio">Remover</button>
                            </div>
                        }

                        @if (VideoGravado != null)
                        {
                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;
                                padding:4px 8px; background:#eff6ff; border-radius:6px;
                                font-size:10px; color:#0d47a1; font-weight:800;">
                                🎥 @VideoGravadoNome
                                <button type="button" class="btn-remover-midia" @onclick="RemoverVideoGravado">✕</button>
                            </div>
                        }

                        @if (CriarAgenda)
                        {
                            <div style="margin-bottom:6px; padding:8px; border:1px dashed #93c5fd;
                                border-radius:8px; background:#f8fbff;">
                                <div class="grupo" style="margin-bottom:4px;">
                                    <label>Data/Hora da agenda</label>
                                    <input type="datetime-local" @bind="DataHoraAgenda" />
                                </div>
                                <label class="agenda-check" style="font-size:.72rem;">
                                    <input type="checkbox" @bind="NotificarAgenda" />
                                    <span>Notificar quando vencer</span>
                                </label>
                            </div>
                        }

                        <!-- Campo de texto + ferramentas -->
                        <div style="display:flex; align-items:center; gap:8px;
                            background:#fff; border-radius:12px; border:1px solid #d1d5db;
                            padding:8px 10px; box-shadow:0 1px 3px rgba(0,0,0,.06);">

                            <!-- FERRAMENTAS ESQUERDA -->
                            <div style="display:flex; align-items:center; gap:3px; flex-shrink:0;">

                                <!-- Anexo -->
                                <label for="inputAnexoAnotacao"
                                       class="ticket-tool-btn"
                                       title="Anexar arquivo"
                                       style="cursor:pointer; display:grid; place-items:center;">
                                    📎
                                </label>

                                <InputFile id="inputAnexoAnotacao"
                                           OnChange="OnArquivoAnotacaoSelecionado"
                                           accept=".pdf,.txt,.csv,.xml,.json,.jpg,.jpeg,.png,.gif,.webp,.bmp,.doc,.docx,.xls,.xlsx,.zip,.rar,.apk,.pfx"
                                           style="display:none;" />

                                <!-- Agenda -->
                                <label title="Criar agenda"
                                       style="cursor:pointer; display:grid; place-items:center;">
                                    <input type="checkbox"
                                           @bind="CriarAgenda"
                                           style="display:none;" />

                                    <span class="ticket-tool-btn"
                                          style="background:@(CriarAgenda ? "#ecfdf5" : "#eff6ff");
                                        border-color:@(CriarAgenda ? "#6ee7b7" : "#bfdbfe");
                                        color:@(CriarAgenda ? "#065f46" : "#1e40af");">
                                        📅
                                    </span>
                                </label>

                                <!-- Mensagem interna -->
                                <label title="@(MensagemInterna ? "Mensagem interna ativa" : "Mensagem interna")"
                                       style="cursor:pointer; display:grid; place-items:center;">

                                    <input type="checkbox"
       checked="@MensagemInterna"
       @onchange="async e => { MensagemInterna = (bool)e.Value!; await FocarCampoMensagem(); }"
       style="display:none;" />

                                    <span class="ticket-tool-btn"
                                          style="background:@(MensagemInterna ? "#fee2e2" : "#eff6ff");
                                        border-color:@(MensagemInterna ? "#fca5a5" : "#bfdbfe");
                                        color:@(MensagemInterna ? "#991b1b" : "#1e40af");">
                                        🔒
                                    </span>
                                </label>

                                @if (gravandoAudio || GravandoTela || MensagemInterna)
                                {
                                    <div style="margin-top:4px; font-size:10px; font-weight:800; text-align:center;
                                        color:@(gravandoAudio || GravandoTela ? "#dc2626" : "#991b1b")">
                                        @if (gravandoAudio)
                                        {
                                            <text>🔴 Gravando áudio...</text>
                                        }
                                        else if (GravandoTela)
                                        {
                                            <text>🔴 Gravando tela...</text>
                                        }
                                        else
                                        {
                                            <text>🔒 Interno</text>
                                        }
                                    </div>
                                }

                                <!-- Separador -->
                                <div style="width:1px; height:20px; background:#e2e8f0; margin:0 3px;"></div>

                            </div>


                            <!-- CAMPO DE MENSAGEM -->
                            <textarea id="obsAnotacao_@id"
                                      rows="2"
                                      value="@NovaAnotacao"
                                      @oninput="OnInputMensagem"
                                      @onblur="OnBlurMensagem"
                                      @onfocus="() => _usuarioEstaDigitando = true"
                                      spellcheck="true"
                                      lang="pt-BR"
                                      autocomplete="on"
                                      placeholder="Digite sua mensagem..."
                                      style="flex:1;
                                        min-width:0;
                                        border:none !important;
                                        outline:none;
                                        resize:none;
                                        min-height:24px !important;
                                        max-height:70px !important;
                                        font-size:15px !important;
                                        font-family:'IBM Plex Sans',sans-serif;
                                        line-height:1.5;
                                        background:transparent !important;
                                        color:#0f172a !important;
                                        padding:4px 0;
                                        box-shadow:none !important;">
                        </textarea>


                        <!-- FERRAMENTAS DIREITA -->
                        <div style="display:flex; align-items:center; gap:3px; flex-shrink:0;">

                            <!-- Áudio -->
                            @if (!gravandoAudio)
                            {
                                <button type="button"
                                        class="ticket-tool-btn"
                                        title="Gravar áudio"
                                        @onclick="AlternarGravacao">
                                    🎤
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="ticket-tool-btn gravando"
                                        title="Parar"
                                        @onclick="AlternarGravacao">
                                    ⏹
                                </button>
                            }

                            <!-- Tela -->
                            @if (!GravandoTela)
                            {
                                <button type="button"
                                        class="ticket-tool-btn"
                                        title="Gravar tela"
                                        @onclick="IniciarGravacaoTela">
                                    🎥
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="ticket-tool-btn gravando"
                                        title="Parar gravação"
                                        @onclick="PararGravacaoTela">
                                    ⏹
                                </button>
                            }

                            <div style="width:1px; height:20px; background:#e2e8f0; margin:0 2px;"></div>

                            <!-- IA -->
                            <button class="ticket-tool-btn"
                                    title="Gerar resposta IA"
                                    style="width:auto; padding:0 8px; font-size:10px; font-weight:800;"
                                    @onclick="GerarRespostaIA"
                                    disabled="@CarregandoIA">

                                @if (CarregandoIA)
                                {
                                    <span class="btn-ia-spinner"
                                          style="width:12px; height:12px; border-width:2px;">
                                    </span>
                                }
                                else
                                {
                                    <text>🤖</text>
                                }

                            </button>

                        </div>

                    </div>

                        @if (!string.IsNullOrWhiteSpace(_aiErro))
                        {
                            <div class="msg erro" style="margin-top:6px;">@_aiErro</div>
                        }

                        @if (!string.IsNullOrEmpty(Mensagem))
                        {
                            <div class="msg @(Sucesso ? "sucesso" : "erro")" style="margin-top:6px;">@Mensagem</div>
                        }

                        <div style="margin-top:4px; display:flex; align-items:center; gap:34px; flex-wrap:wrap;">
    @foreach (var atalho in new[] {
        ("F1", "#d97706", "Atualizar"),
        ("F2", "#7c3aed", "Finalizar Dev"),
        ("F3", "#16a34a", "Finalizar Suporte"),
    })
    {
        <div style="display:flex; align-items:center; gap:4px;">
            <span style="width:22px; height:16px; border-radius:3px;
                background:@atalho.Item2; color:#fff; font-size:9px;
                font-weight:900; display:inline-flex; align-items:center;
                justify-content:center; flex-shrink:0;">
                @atalho.Item1
            </span>
                                <span style="font-size:12px; font-weight:700; color:#475569;">
                @atalho.Item3
            </span>
        </div>
    }
</div>
                    }
                </div>

            </main>

            <!-- DIREITA: INFORMAÇÕES DO TICKET -->
            <aside class="ticket-modern-panel ticket-modern-right">

                <div class="ticket-info-profile">
                    @if (!string.IsNullOrWhiteSpace(TicketAtual.FotoClienteUrl))
                    {
                        <img class="ticket-info-avatar-img" src="@TicketAtual.FotoClienteUrl" alt="Foto do cliente" />
                    }
                    else
                    {
                        <div class="ticket-info-avatar-fallback">@ObterIniciaisCliente(NomeCliente)</div>
                    }
                    <div style="min-width:0;">
                        <div style="font-size:.72rem; color:#64748b; font-weight:800;">Cliente</div>
                        <div style="font-weight:950; color:#0d47a1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                            @TicketAtual.CodCliente - @NomeCliente
                        </div>
                    </div>
                </div>

                <!-- CLIENTE — sempre visível -->
                <div class="ticket-info-row">
                    <label>Cliente</label>
                    @if (!AlterandoCliente)
                    {
                        <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                            <span class="ticket-info-value">@NomeCliente</span>
                            <button type="button" class="btn-editar-cliente" @onclick="IniciarAlteracaoCliente">✎ Alterar</button>
                        </div>
                    }
                    else
                    {
                        <div style="min-width:0;">
                            <input @bind="ClienteBusca"
                                   @bind:event="oninput"
                                   @bind:after="BuscarClientes"
                                   placeholder="Código ou nome..." />
                            <div class="cliente-autocomplete-wrapper">
                                @if (Sugestoes?.Any() == true)
                                {
                                    <ul class="autocomplete-list">
                                        @foreach (var cli in Sugestoes)
                                        {
                                            <li @onclick="async () => await SelecionarCliente(cli)">
                                                <strong>@cli.Codigo</strong> - @cli.Nome
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            <button type="button" class="btn-editar-cliente" style="margin-top:4px;"
                                    @onclick="CancelarAlteracaoCliente">
                                Cancelar
                            </button>
                        </div>
                    }
                </div>

            <!-- CONTATO — logo abaixo do telefone -->
            <div class="ticket-info-row">
                <label>Contato</label>
                <input @bind="TicketAtual.UsuarioAbertura"
                       placeholder="Nome do contato..."
                       style="width:100%;" />
            </div>

                <!-- TELEFONE — sempre visível -->
                <div class="ticket-info-row">
                    <label>Telefone</label>
                    <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                        <span class="ticket-info-value">
                            @(string.IsNullOrWhiteSpace(NumeroTelefone) ? "—" : NumeroTelefone)
                        </span>
                        <button type="button" class="whats-btn" title="Abrir WhatsApp" @onclick="AbrirWhatsApp">
                            <i class="fa-brands fa-whatsapp" style="color:#fff; font-size:15px;"></i>
                        </button>
                    </div>
                </div>

                <!-- RESPONSÁVEL — sempre visível -->
                <div class="ticket-info-row">
                    <label>Responsável</label>
                <select @bind="TicketAtual.Usuario"
                        @bind:after="FocarCampoMensagem"
                        class="@(ResponsavelInvalido ? "select-erro" : "")">
                    <option value="">Selecione...</option>
                    @foreach (var u in Usuarios)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
                </div>

                <!-- SITUAÇÃO — sempre visível -->
                <div class="ticket-info-row">
                    <label>Situação</label>
                    <select value="@TicketAtual.CodSituacao"
                            @onchange="OnSituacaoTicketChanged"
                            disabled="@(!PodeAlterarStatusTicket)">
                        @foreach (var situacao in SituacoesTicket)
                        {
                            <option value="@situacao.Codigo">@situacao.Descricao</option>
                        }
                    </select>
                </div>

                <div class="ticket-panel-title" style="margin-bottom:10px;">
                    <span>📚 Documentação</span>
                </div>

                <div class="grupo">
                    <input class="ticket-doc-search"
                           @bind="BuscaDoc"
                           @bind:event="oninput"
                           @bind:after="BuscarDocumentacoes"
                           placeholder="Ex.: entrada xml, estoque, pdv..." />

                    @if (BuscandoDocs)
                    {
                        <small class="hint" style="margin-top:6px; display:block;">Buscando...</small>
                    }

                    @if (DocsEncontradas.Any())
                    {
                        <div class="ticket-doc-results" style="margin-top:8px;">
                            @foreach (var doc in DocsEncontradas)
                            {
                                <div class="ticket-doc-card">
                                    <a href="@doc.Url" target="_blank">🔗 @doc.Title</a>
                                    <div class="ticket-doc-preview">@doc.Preview</div>
                                    <button type="button"
                                            class="btn-inserir-doc"
                                            @onclick="async () => await InserirUrlDocNaMensagem(doc)">
                                        📎 Inserir na mensagem
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- CAMPOS SECUNDÁRIOS colapsáveis -->
                <div style="margin-top:6px;">
                    <button type="button"
                            @onclick="() => _detalhesExpandidos = !_detalhesExpandidos"
                            style="width:100%; border:1px solid #e2e8f0; border-radius:8px;
                        background:#f8fbff; color:#64748b; font-size:10px; font-weight:800;
                        padding:6px 10px; cursor:pointer; display:flex;
                        align-items:center; justify-content:space-between; transition:.15s ease;">
                        <span>⚙ Mais detalhes</span>
                        <span>@(_detalhesExpandidos ? "▲" : "▼")</span>
                    </button>

                    @if (_detalhesExpandidos)
                    {
                        <!-- ASSUNTO -->
                        <div class="ticket-info-row" style="margin-top:6px;">
                            <label>Assunto</label>
                            <input @bind="TicketAtual.Assunto" />
                        </div>

                        <!-- SETOR + TIPO -->
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;
                            padding:6px 0; border-bottom:1px solid #eef2f7;">
                            <div>
                                <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                text-transform:uppercase; letter-spacing:.03em;">Setor</label>
                                <select value="@TicketAtual.CodSetor" @onchange="OnSetorTicketChanged"
                                        style="width:100%; height:32px; border:1px solid #bbdefb;
                                    border-radius:8px; font-size:.74rem; padding:5px 8px; background:#fff;">
                                    @foreach (var setor in SetoresTicket)
                                    {
                                        <option value="@setor.Codigo">@setor.Descricao</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                text-transform:uppercase; letter-spacing:.03em;">Tipo</label>
                                <select @bind="TicketAtual.CodTipo"
                                        style="width:100%; height:32px; border:1px solid #bbdefb;
                                    border-radius:8px; font-size:.74rem; padding:5px 8px; background:#fff;">
                                    @foreach (var tipo in TiposTicket)
                                    {
                                        <option value="@tipo.Codigo">@tipo.Descricao</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- PRIORIDADE + VERSÃO -->
                        <div style="display:grid; grid-template-columns:1fr @(TicketAtual.CodSetor == 2 ? "1fr" : ""); gap:8px;
                            padding:6px 0; border-bottom:1px solid #eef2f7;">
                            <div>
                                <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                text-transform:uppercase; letter-spacing:.03em;">Prioridade</label>
                                <select @bind="TicketAtual.Prioridade"
                                        style="width:100%; height:32px; border:1px solid #bbdefb;
                                    border-radius:8px; font-size:.74rem; padding:5px 8px; background:#fff;">
                                    <option value="1">Baixa</option>
                                    <option value="2">Normal</option>
                                    <option value="3">Alta</option>
                                    <option value="4">Urgente</option>
                                </select>
                            </div>
                            @if (TicketAtual.CodSetor == 2)
                            {
                                <div>
                                    <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                    text-transform:uppercase; letter-spacing:.03em;">Versão</label>
                                    <input value="@TicketAtual.Versao"
                                           @oninput="OnVersaoInput"
                                           placeholder="25.07.21"
                                           maxlength="8"
                                           style="width:100%; height:32px; border:1px solid #bbdefb;
                                    border-radius:8px; font-size:.74rem; padding:5px 8px;
                                    background:#fff; box-sizing:border-box;" />
                                </div>
                            }
                        </div>

                        <!-- OBSERVAÇÃO DO CLIENTE -->
                        <div style="padding:6px 0;">
                            <label style="font-size:.62rem; color:#64748b; font-weight:900;
                                text-transform:uppercase; letter-spacing:.03em; display:block; margin-bottom:4px;">
                                Observação do cliente
                            </label>
                            <textarea class="ticket-observacao-cliente"
                                      @bind="TicketAtual.ObservacaoCliente"
                                      placeholder="Anotações internas sobre este cliente..."></textarea>
                        </div>
                    }
                </div>

                <!-- APROVAÇÃO -->
                @if (TicketAtual.CodSituacao == 6)
                {
                    <div class="approval-box" style="margin-top:8px;">
                        <div class="approval-title">✅ Aprovação pendente</div>
                        <div class="approval-actions">
                            <button type="button" class="approval-btn approval-approve" @onclick="AprovarTicket">Aprovar</button>
                            <button type="button" class="approval-btn approval-refuse" @onclick="RecusarTicket">Recusar</button>
                        </div>
                        <textarea class="approval-textarea"
                                  @bind="MotivoRecusaAprovacao"
                                  placeholder="Motivo da recusa (obrigatório para recusar)..."></textarea>
                        @if (!string.IsNullOrWhiteSpace(MensagemAprovacao))
                        {
                            <div class="approval-message">@MensagemAprovacao</div>
                        }
                    </div>
                }

                <!-- SALVAR (sticky) -->
                <div class="ticket-save-sticky">
                    <button type="button" class="btn-salvar-ticket-fixo"
                            @onclick="SalvarTicket"
                            disabled="@(!PodeResponderTickets)">
                        💾 Salvar ticket
                    </button>

                    @if (TicketAtual.Codigo > 0 && PodeResponderTickets)
                    {
                        <button type="button"
                                style="width:100%; margin-top:8px; border:none; border-radius:12px;
                            padding:11px 14px; background:linear-gradient(135deg,#16a34a,#15803d);
                            color:#fff; font-size:.78rem; font-weight:950; cursor:pointer;
                            box-shadow:0 8px 18px rgba(22,163,74,.22); transition:.15s ease;"
                                @onclick="AbrirModalCriarCard">
                            👤 Criar Card no CRM
                        </button>
                    }
                </div>



            </aside>

        </div>


    </div>
}

