    private async Task CriarTicket()
    {
        try
        {
            if (!PodeResponderTickets)
            {
                Sucesso = false;
                Mensagem = "Você não tem permissão para criar ou responder tickets.";
                return;
            }

            Salvando = true;
            Mensagem = "";
            ResponsavelInvalido = false;
            TotalTicketsCriados = 0;

            var ehEnvioMassa = TipoEnvioCliente == "TODOS_MENSALISTAS";

            if (string.IsNullOrWhiteSpace(UsuarioSelecionado))
            {
                ResponsavelInvalido = true;
                Mensagem = "Selecione um responsável.";
                Sucesso = false;
                return;
            }

            if (!ehEnvioMassa && CodTipo == 4)
            {
                if (UsuarioSelecionadoCodigo == null || UsuarioSelecionadoCodigo <= 0)
                {
                    Mensagem = "Selecione um usuário do cliente.";
                    Sucesso = false;
                    return;
                }
            }

            if (!ehEnvioMassa && CodTipo == 5)
            {
                if (string.IsNullOrWhiteSpace(TelefoneWhatsApp))
                {
                    Mensagem = "Informe o número de telefone do WhatsApp.";
                    Sucesso = false;
                    return;
                }

                if (string.IsNullOrWhiteSpace(NomeWhatsApp))
                {
                    Mensagem = "Informe o nome do contato WhatsApp.";
                    Sucesso = false;
                    return;
                }
            }

            string? telefoneWhatsAppNormalizado = null;

            if (!ehEnvioMassa && CodTipo == 5)
            {
                telefoneWhatsAppNormalizado = new string(
                    TelefoneWhatsApp.Where(char.IsDigit).ToArray()
                );

                if (telefoneWhatsAppNormalizado.Length != 12 &&
                    telefoneWhatsAppNormalizado.Length != 13)
                {
                    Sucesso = false;
                    Mensagem =
                        $"Telefone inválido. Foram encontrados {telefoneWhatsAppNormalizado.Length} dígitos. " +
                        "O número deve conter 12 dígitos (fixo) ou 13 dígitos (celular), incluindo o código do país 55.";

                    return;
                }
            }

            if (!ehEnvioMassa && CodCliente <= 0)
            {
                Mensagem = "Selecione um cliente.";
                Sucesso = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(Assunto))
            {
                Mensagem = "Informe o título / assunto.";
                Sucesso = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(NovaAnotacao))
            {
                Mensagem = "Informe a observação / detalhamento.";
                Sucesso = false;
                return;
            }

            if (ehEnvioMassa)
            {
                var confirmar = await JS.InvokeAsync<bool>(
                    "confirm",
                    "Atenção: será criado um ticket para cada cliente mensalista ativo. Deseja continuar?"
                );

                if (!confirmar)
                {
                    Sucesso = false;
                    Mensagem = "Envio em massa cancelado.";
                    return;
                }

                var resultado = await TicketService.CriarChamadosEmMassaMensalistasAsync(
                    Assunto,
                    NovaAnotacao,
                    CodSetor,
                    CodSituacao,
                    CodTipo,
                    Prioridade,
                    UsuarioSelecionado,
                    ArquivoAnotacao,
                    UserState.CurrentUser
                );

                if (!resultado.Sucesso)
                {
                    Sucesso = false;
                    Mensagem = resultado.Mensagem;
                    return;
                }

                TotalTicketsCriados = resultado.TotalCriados;

                Sucesso = true;
                Mensagem = $"Envio em massa concluído. {TotalTicketsCriados} ticket(s) criado(s).";

                Assunto = "";
                ClienteBusca = "";
                CodCliente = 0;
                CodSetor = 1;
                CodSituacao = 1;
                CodTipo = 1;
                TipoEnvioCliente = "UNICO";
                UsuarioSelecionadoCodigo = null;
                UsuarioClienteSelecionado = "";
                UsuariosCliente.Clear();
                Sugestoes.Clear();
                ArquivoAnotacao = null;
                PreviewArquivoAnotacao = null;
                NovaAnotacao = "";

                StateHasChanged();
                return;
            }

            UsuarioClienteSelecionado = "";

            if (CodTipo == 4 && UsuarioSelecionadoCodigo.HasValue)
            {
                var usuarioCliente = UsuariosCliente
                    .FirstOrDefault(x => x.Codigo == UsuarioSelecionadoCodigo.Value);

                UsuarioClienteSelecionado = usuarioCliente?.Usuario ?? "";
            }

            if (CriarAgenda && DataHoraAgenda == null)
            {
                Sucesso = false;
                Mensagem = "Informe a data/hora da agenda.";
                return;
            }

            if (TipoEnvioCliente == "UNICO" && CodCliente <= 0)
            {
                ClienteInvalido = true;
                Sucesso = false;
                Mensagem = "Selecione um cliente antes de salvar o ticket.";
                return;
            }

            ClienteInvalido = false;

            var novoId = await TicketService.CriarChamadoComAnexoAsync(
                Assunto,
                NovaAnotacao,
                CodCliente,
                CodSetor,
                CodSituacao,
                CodTipo,
                Prioridade,
                UsuarioSelecionado,
                ArquivoAnotacao,
                UserState.CurrentUser,
                UsuarioSelecionadoCodigo,
                UsuarioClienteSelecionado,
                "N",
                CriarAgenda,
                DataHoraAgenda,
                NotificarAgenda,
CodTipo == 5 ? telefoneWhatsAppNormalizado : null,
CodTipo == 5 ? NomeWhatsApp : null
            );

            Sucesso = true;
            Mensagem = $"Ticket criado com sucesso! Código: {novoId}";

            id = novoId;
            TicketAtual = await TicketService.BuscarChamadoAsync(novoId);

            if (TicketAtual != null)
            {
                NomeCliente = await TicketService.BuscarNomeCliente(TicketAtual.CodCliente);
                Historico = await TicketService.BuscarHistoricoAsync(novoId);
                _ultimoCodigoHistorico = Historico.Count > 0 ? Historico.Max(h => h.Codigo) : 0;
                NumeroTelefone = await TicketService.BuscarTelefoneCliente(TicketAtual.CodCliente);

                _codSetorOriginal = TicketAtual.CodSetor;
                _codSituacaoOriginal = TicketAtual.CodSituacao;
                _usuarioOriginal = (TicketAtual.Usuario ?? "").Trim();

                Assunto = "";
                ClienteBusca = "";
                CodCliente = 0;
                CodSetor = 1;
                CodSituacao = 1;
                CodTipo = 1;
                UsuarioSelecionadoCodigo = null;
                UsuarioClienteSelecionado = "";
                UsuariosCliente.Clear();
                Sugestoes.Clear();

                ArquivoAnotacao = null;
                PreviewArquivoAnotacao = null;
                NovaAnotacao = "";

                CriarAgenda = false;
                DataHoraAgenda = null;
                NotificarAgenda = true;

                _pasteJsInicializado = false;

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Sucesso = false;
            Mensagem = ex.Message;
            HealthMonitor.LogException(LogCategory.Tickets, ex,
                "Ticket.CriarTicket");
        }
        finally
        {
            Salvando = false;
        }
    }

    private async Task OnArquivoAnotacaoSelecionado(InputFileChangeEventArgs e)
    {
        ArquivoAnotacao = e.File;
        PreviewArquivoAnotacao = null;

        if (ArquivoAnotacao == null)
            return;

        try
        {
            var maxSize = 20 * 1024 * 1024;
            var ext = Path.GetExtension(ArquivoAnotacao.Name).ToLowerInvariant();

            var podePreview =
                ArquivoAnotacao.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
                || ext == ".pdf"
                || ext == ".txt"
                || ext == ".csv"
                || ext == ".xml"
                || ext == ".json";

            if (podePreview)
            {
                using var stream = ArquivoAnotacao.OpenReadStream(maxSize);
                using var ms = new MemoryStream();

                await stream.CopyToAsync(ms);

                var base64 = Convert.ToBase64String(ms.ToArray());

                var mime = ArquivoAnotacao.ContentType;

                if (string.IsNullOrWhiteSpace(mime))
                {
                    mime = ext switch
                    {
                        ".pdf" => "application/pdf",
                        ".txt" => "text/plain",
                        ".csv" => "text/csv",
                        ".xml" => "application/xml",
                        ".json" => "application/json",
                        _ => "application/octet-stream"
                    };
                }

                PreviewArquivoAnotacao = $"data:{mime};base64,{base64}";
            }
        }
        catch (Exception ex)
        {
            Mensagem = "Erro ao carregar anexo: " + ex.Message;
            Sucesso = false;
            ArquivoAnotacao = null;
            PreviewArquivoAnotacao = null;
        }

        await FocarCampoMensagem();
    }

