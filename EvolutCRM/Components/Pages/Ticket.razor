    private string TempoEmAtendimentoTexto
    {
        get
        {
            if (TicketAtual == null)
                return "--";

            var fim = TicketAtual.CodSituacao == 3
                ? TicketAtual.DataHoraUltimaGravacao
                : DateTime.Now;

            var tempo = fim - TicketAtual.DataHoraAbertura;

            if (tempo.TotalMinutes < 1)
                return "menos de 1 min";

            return FormatarTempo(tempo);
        }
    }

    private async Task SalvarTicket()
    {
        if (TicketAtual == null)
            return;

        if (TicketAtual.CodCliente <= 0)
        {
            ClienteInvalido = true;
            Sucesso = false;
            Mensagem = "Selecione um cliente antes de salvar o ticket.";
            return;
        }

        ClienteInvalido = false;

        var usuarioLogado = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(TicketAtual.Usuario) || EqUser(TicketAtual.Usuario, "NOVO"))
        {
            ResponsavelInvalido = true;
            Sucesso = false;
            Mensagem = "Selecione um responsável antes de salvar o ticket.";
            return;
        }

        if (TicketAtual.CodSituacao != _codSituacaoOriginal && !PodeAlterarStatusTicket)
        {
            Sucesso = false;
            Mensagem = "Você não tem permissão para alterar o status do ticket.";
            return;
        }

        if (TicketAtual.CodSetor == 2 &&
            (TicketAtual.CodSituacao == 3 || TicketAtual.CodSituacao == 4))
        {
            if (string.IsNullOrWhiteSpace(TicketAtual.Versao))
            {
                Sucesso = false;
                Mensagem = "Informe a versão do sistema para finalizar ou atualizar este ticket.";
                return;
            }
        }

        ResponsavelInvalido = false;

        if (TicketAtual.CodSetor != 1 && TicketAtual.CodSetor != 2)
        {
            TicketAtual.CodSetor = 1;
        }

        if (TicketAtual.CodSituacao == 2 && TicketAtual.CodSetor != 2)
        {
            TicketAtual.CodSituacao = 1;
        }

        var result = await TicketService.SalvarCabecalhoTicketAsync(
            TicketAtual,
            UserState.CurrentUser ?? ""
        );

        if (!result.Sucesso)
        {
            Sucesso = false;
            Mensagem = result.Mensagem;
            HealthMonitor.Log(LogCategory.Tickets, LogSeverity.Warning,   // ← ADD
                $"Ticket #{id} falhou ao salvar cabeçalho: {result.Mensagem}"); // ← ADD
            return;
        }

        Sucesso = true;
        Mensagem = "Ticket salvo com sucesso.";

        _codSetorOriginal = TicketAtual.CodSetor;
        _codSituacaoOriginal = TicketAtual.CodSituacao;
        _usuarioOriginal = (TicketAtual.Usuario ?? "").Trim();
    }

    private string CalcularTempoMedioRespostaTexto()
    {
        if (Historico == null || Historico.Count == 0)
            return "--";

        var mensagens = Historico
            .Where(h => h.MensagemExcluida != "S")
            .OrderBy(h => h.DataHora)
            .ToList();

        var temposResposta = new List<TimeSpan>();

        for (int i = 0; i < mensagens.Count; i++)
        {
            var msgCliente = mensagens[i];

            if (msgCliente.EnvioCliente != "S")
                continue;

            var respostaAtendente = mensagens
                .Skip(i + 1)
                .FirstOrDefault(m =>
                    m.EnvioCliente != "S" &&
                    !MesmoUsuario(m.Usuario, "CLIENTE") &&
                    !MesmoUsuario(m.Usuario, "WHATSAPP"));

            if (respostaAtendente != null)
            {
                var tempo = respostaAtendente.DataHora - msgCliente.DataHora;

                if (tempo.TotalSeconds > 0)
                    temposResposta.Add(tempo);
            }
        }

        if (!temposResposta.Any())
            return "--";

        var mediaTicks = (long)temposResposta.Average(t => t.Ticks);

        return FormatarTempo(TimeSpan.FromTicks(mediaTicks));
    }

    private string FormatarTempo(TimeSpan tempo)
    {
        if (tempo.TotalDays >= 1)
            return $"{(int)tempo.TotalDays}d {tempo.Hours}h {tempo.Minutes}min";

        if (tempo.TotalHours >= 1)
            return $"{(int)tempo.TotalHours}h {tempo.Minutes}min";

        return $"{Math.Max(1, (int)tempo.TotalMinutes)}min";
    }

    private string? NormalizarEValidarTelefoneWhatsApp(string? telefone, out string mensagemErro)
    {
        mensagemErro = "";

        var numero = new string((telefone ?? "").Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(numero))
        {
            mensagemErro = "Informe o número de telefone para iniciar a conversa no WhatsApp.";
            return null;
        }

        while (numero.StartsWith("0"))
            numero = numero.Substring(1);

        if (!numero.StartsWith("55"))
            numero = "55" + numero;

        if (numero.Length != 12 && numero.Length != 13)
        {
            mensagemErro =
                $"Telefone inválido: {numero}. O número deve ter 12 dígitos para fixo ou 13 para celular. " +
                "Exemplo celular: 5517999999999.";

            return null;
        }

        return numero;
    }

