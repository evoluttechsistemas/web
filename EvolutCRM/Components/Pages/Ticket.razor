        var tResponder = AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "TICKETS_RESPONDER");
        var tStatus = AdminService.UsuarioTemPermissaoAsync(usuarioLogado, "TICKETS_ALTERAR_STATUS");
        var tUsuarios = TicketService.ListarUsuariosAsync();

        await Task.WhenAll(tVisualizar, tResponder, tStatus, tUsuarios);

        PodeVisualizarTickets = tVisualizar.Result;
        PodeResponderTickets = tResponder.Result;
        PodeAlterarStatusTicket = tStatus.Result;

        Usuarios = tUsuarios.Result
            .Select(u => u.Trim().ToUpper())
            .ToList();

        UsuarioSelecionado = usuarioLogado;

