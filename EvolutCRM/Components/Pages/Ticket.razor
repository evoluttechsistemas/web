.img-modal-img { height: auto; border-radius: 10px; user-select: none; }

.img-scroll-area.normal .img-modal-img { max-width: 100%; max-height: 100%; object-fit: contain; }

.img-scroll-area.zoomado .img-modal-img { max-width: none !important; max-height: none !important; }

/* =========================================================
               MODAL INSIGHT
               ========================================================= */
.insight-modal-backdrop,
.insight-loading-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(7, 12, 22, 0.72);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    padding: 24px;
}

.insight-loading-backdrop { background: rgba(7, 12, 22, 0.78); z-index: 100000; }

.insight-modal-card,
.insight-loading-card {
    width: 100%;
    max-width: 560px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    border-radius: 20px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(41, 98, 255, 0.14);
    overflow: hidden;
    animation: insightModalShow .18s ease-out;
}

.insight-loading-card { max-width: 420px; padding: 28px 24px; text-align: center; }

@@keyframes insightModalShow {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.insight-modal-header {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 24px 24px 16px 24px;
}

.insight-modal-icon {
    width: 56px;
    height: 56px;
    min-width: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #2962ff 0%, #5b8cff 100%);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 18px;
    box-shadow: 0 10px 25px rgba(41, 98, 255, 0.30);
}

.insight-modal-title { margin: 0 0 6px 0; font-size: 23px; font-weight: 800; color: #0f172a; line-height: 1.2; }
.insight-modal-subtitle { margin: 0; color: #475569; font-size: 15px; line-height: 1.55; }

.insight-modal-highlight {
    margin: 0 24px 20px 24px;
    padding: 14px 16px;
    background: #eef4ff;
    border: 1px solid #cfe0ff;
    border-radius: 14px;
    color: #1e3a8a;
    font-size: 14px;
    line-height: 1.5;
}

.insight-modal-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 24px 24px 24px;
}

.insight-btn {
    width: 100%;
    min-height: 46px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 15px;
    transition: all 0.16s ease;
    cursor: pointer;
}

    .insight-btn:disabled { opacity: 0.7; cursor: not-allowed; }

.insight-btn-primary {
    background: linear-gradient(135deg, #2962ff 0%, #4f83ff 100%);
    border: none;
    color: #fff;
    box-shadow: 0 12px 24px rgba(41, 98, 255, 0.25);
}

    .insight-btn-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 14px 28px rgba(41, 98, 255, 0.30); }

.insight-btn-secondary { background: #fff7ed; border: 1px solid #fdba74; color: #9a3412; }

    .insight-btn-secondary:hover:not(:disabled) { background: #ffedd5; }

.insight-btn-light { background: #f8fafc; border: 1px solid #cbd5e1; color: #334155; }

    .insight-btn-light:hover:not(:disabled) { background: #f1f5f9; }

.insight-loading-spinner {
    width: 58px;
    height: 58px;
    margin: 0 auto 18px auto;
    border-radius: 50%;
    border: 5px solid rgba(37, 99, 235, 0.15);
    border-top: 5px solid #2563eb;
    animation: spin 0.9s linear infinite;
}

.insight-loading-title { font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 10px; }
.insight-loading-text { font-size: 14px; color: #475569; line-height: 1.6; }
.insight-loading-subtext { margin-top: 14px; font-size: 13px; color: #1d4ed8; font-weight: 700; }

/* =========================================================
               TELA DE ABERTURA (novo ticket)
               ========================================================= */
.container-ticket {
    max-width: 1200px;
    margin: 30px auto;
    background: #fff;
    padding: 22px;
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    border: 1px solid #bbdefb;
}

.titulo {
    font-size: 26px;
    color: #0d47a1;
    font-weight: 800;
    text-align: center;
    margin-bottom: 18px;
}

.ticket-layout {
    display: grid;
    grid-template-columns: 0.8fr 0.9fr;
    gap: 18px;
    align-items: start;
}

.card {
    background: #ffffff;
    border: 1px solid #e3f2fd;
    border-radius: 12px;
    padding: 16px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
}

.card-title {
    font-size: 16px;
    font-weight: 900;
    color: #0d47a1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
}

.grupo-linha {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    align-items: start;
}

.grid-2cols {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 10px;
    align-items: start;
}

