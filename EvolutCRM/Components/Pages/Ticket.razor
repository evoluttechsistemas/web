    private async Task AtualizarAutomaticamente()
    {
        if (EhNovo) return;

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        try
        {
            while (await _timer.WaitForNextTickAsync())
            {
                if (_atualizando)
                    continue;

                _atualizando = true;

                try { await AtualizarTicket(); }
                finally { _atualizando = false; }
            }
        }
        catch (OperationCanceledException)
        {
            // esperado ao sair
        }
    }

    private async Task AtualizarTicket()
    {
        if (TicketAtual == null || EhNovo)
            return;

        // Batedor: 1 query leve (COUNT + MAX). Roda a cada 3s sem pesar.
        var resumo = await TicketService.ResumoHistoricoAsync(id);

        // Detecção pelo MAX(Codigo): sempre cresce com mensagem nova,
        // imune a divergências de contagem por filtros.
        // O Count cobre edições de mensagem (que não criam linha nova).
        bool historicoMudou = resumo.UltimoCodigo != _ultimoCodigoHistorico
                           || resumo.Total != Historico.Count;

        // Nada novo → sai imediatamente. Nenhuma query pesada, nenhum render.
        if (!historicoMudou)
        {
            // Só atualiza os tiquinhos de entrega (enviado/entregue/lido) — query leve
            var statusMap = await TicketService.BuscarStatusWhatsAppAsync(id);
            bool mudouStatus = false;
            foreach (var msg in Historico)
            {
                if (statusMap.TryGetValue(msg.Codigo, out var novoStatus)
                    && novoStatus != msg.StatusEnvioWhatsApp)
                {
                    msg.StatusEnvioWhatsApp = novoStatus;
                    mudouStatus = true;
                }
            }
            if (mudouStatus)
                await InvokeAsync(StateHasChanged);
            return;
        }

        // Chegou algo novo → busca SÓ as mensagens novas (não a conversa inteira)
        var novas = await TicketService.BuscarHistoricoNovasAsync(id, _ultimoCodigoHistorico);

        var codigosExistentes = Historico.Select(h => h.Codigo).ToHashSet();
        foreach (var nova in novas.Where(h => !codigosExistentes.Contains(h.Codigo)))
            Historico.Insert(0, nova);

        // Atualiza status das já existentes na mesma passada
        var mapaStatus = await TicketService.BuscarStatusWhatsAppAsync(id);
        foreach (var msg in Historico)
        {
            if (mapaStatus.TryGetValue(msg.Codigo, out var st) && st != msg.StatusEnvioWhatsApp)
                msg.StatusEnvioWhatsApp = st;
        }

        _ultimoCodigoHistorico = Historico.Count > 0 ? Historico.Max(h => h.Codigo) : 0;

        // ✅ RENDER IMEDIATO: a mensagem aparece agora, sem esperar a query de IA
        await InvokeAsync(StateHasChanged);

        // A partir daqui nada segura a exibição da mensagem — só atualizações secundárias.

        // Busca dados de IA só agora (quando algo mudou), não a cada ciclo
        var ticketAtualizado = await TicketService.BuscarChamadoAsync(id);
        if (ticketAtualizado != null && TicketAtual != null)
        {
            if (TicketAtual.AssuntoSugerido != ticketAtualizado.AssuntoSugerido ||
                TicketAtual.SentimentoCliente != ticketAtualizado.SentimentoCliente ||
                TicketAtual.SentimentoEmoji != ticketAtualizado.SentimentoEmoji ||
                TicketAtual.AssuntoSugeridoStatus != ticketAtualizado.AssuntoSugeridoStatus)
            {
                TicketAtual.AssuntoSugerido = ticketAtualizado.AssuntoSugerido;
                TicketAtual.SentimentoCliente = ticketAtualizado.SentimentoCliente;
                TicketAtual.SentimentoEmoji = ticketAtualizado.SentimentoEmoji;
                TicketAtual.AssuntoSugeridoStatus = ticketAtualizado.AssuntoSugeridoStatus;
            }
        }

        await TicketService.MarcarComoAbertoAsync(id);

        if (TicketAtual != null)
        {
            var usuariosAutomaticos = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        { "NOVO", "WHATSAPP", "CLIENTE", "BOT", "SISTEMA" };
            var temResponsavel = !string.IsNullOrWhiteSpace(TicketAtual.Usuario)
                && !usuariosAutomaticos.Contains(TicketAtual.Usuario.Trim());
            if (temResponsavel)
                TicketAtual.Novo = "N";
        }

        var qtd = await TicketService.GetQuantidadeTicketsNovosAsync(UserState.CurrentUser);
        TicketNotify.SetNovos(qtd);

        await InvokeAsync(StateHasChanged);
    }

    private async Task CarregarDados()
    {
        Carregando = true;

        if (id <= 0 && IdQuery.HasValue)
            id = IdQuery.Value;

        Usuarios = (await TicketService.ListarUsuariosAsync())
            .Select(u => u.Trim().ToUpper())
            .Distinct()
            .OrderBy(u => u)
            .ToList();

        if (EhNovo)
        {
            TicketAtual = null;
            Historico.Clear();
            NomeCliente = "";
            NumeroTelefone = "";
            UsuarioSelecionado = "";
            Carregando = false;
            return;
        }

        TicketAtual = await TicketService.BuscarChamadoAsync(id);

        if (TicketAtual != null)
        {
            var usuarioLogado = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();

            // Guarda se o ticket era novo antes de alterá-lo
            var eraNovo = TicketAtual.Novo == "S";

            if (eraNovo)
            {
                var usuariosAutomaticos = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        { "NOVO", "WHATSAPP", "CLIENTE", "BOT", "SISTEMA" };

                var temResponsavel = !string.IsNullOrWhiteSpace(TicketAtual.Usuario)
                    && !usuariosAutomaticos.Contains(TicketAtual.Usuario.Trim());

                if (temResponsavel)
                {
                    await TicketService.MarcarComoLidoSuporteAsync(
                        TicketAtual.Codigo,
