                            {
                                <option value="@usuario.Codigo">@usuario.Usuario</option>
                            }
                        </select>
                        <small class="hint">Este usuário será usado para direcionar o chamado ao cliente.</small>
                    </div>
                }

                @if (CodTipo == 5)
                {
                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:8px;">
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Contato WhatsApp</label>
                            <select @onchange="SelecionarTelefoneWhatsApp">
                                <option value="">Selecione um contato</option>
                                @foreach (var contato in TelefonesWhatsAppCliente)
                                {
                                    <option value="@contato.Telefone">@contato.Nome - @contato.Telefone</option>
                                }
                            </select>
                        </div>
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Nome</label>
                            <input @bind="NomeWhatsApp" placeholder="Ex.: Gabriel" />
                        </div>
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Número telefone</label>
                            <input @bind="TelefoneWhatsApp" placeholder="Ex.: 16999999999" />
                        </div>
                    </div>
                }

                <div style="height:1px; background:linear-gradient(90deg,#bfdbfe,transparent); margin:8px 0;"></div>

                <div class="grupo" style="margin-bottom:8px;">
