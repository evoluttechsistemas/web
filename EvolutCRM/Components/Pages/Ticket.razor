    private async Task SalvarAlteracoes()
    {
        try
        {
            if (!PodeResponderTickets)
            {
                Sucesso = false;
                Mensagem = "Você não tem permissão para responder ou alterar este ticket.";
                return;
            }

            if (TicketAtual == null)
                return;

            if (TicketAtual.CodCliente <= 0)
            {
                ClienteInvalido = true;
                Sucesso = false;
                Mensagem = "Selecione um cliente antes de salvar o ticket.";
                return;
            }

            ClienteInvalido = false;

            var usuarioLogado = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();

            // 🔒 VALIDA RESPONSÁVEL (mantém sua regra + cobre vazio)
            if (string.IsNullOrWhiteSpace(TicketAtual.Usuario) || EqUser(TicketAtual.Usuario, "NOVO"))
            {
                ResponsavelInvalido = true;
                Sucesso = false;
                Mensagem = "Selecione um responsável antes de salvar o ticket.";
                return;
            }

            if (TicketAtual.CodSituacao != _codSituacaoOriginal && !PodeAlterarStatusTicket)
            {
                Sucesso = false;
                Mensagem = "Você não tem permissão para alterar o status do ticket.";
                return;
            }

            // 🔒 VALIDA VERSÃO (Setor = 2 e Situação = Finalizado ou Atualizar)
            if (TicketAtual.CodSetor == 2 &&
                (TicketAtual.CodSituacao == 3 || TicketAtual.CodSituacao == 4))
            {
                if (string.IsNullOrWhiteSpace(TicketAtual.Versao))
                {
                    Sucesso = false;
                    Mensagem = "Informe a versão do sistema para finalizar ou atualizar este ticket.";
                    return;
                }
            }

            if (CriarAgenda && DataHoraAgenda == null)
            {
                Sucesso = false;
                Mensagem = "Informe a data/hora da agenda.";
                return;
            }

            ResponsavelInvalido = false;

            var result = await TicketService.SalvarAlteracoesAsync(
    TicketAtual,
    NovaAnotacao,
    UserState.CurrentUser,
    ArquivoAnotacao,
    VideoGravado,
    VideoGravadoMime,
    VideoGravadoNome,
    audioGravado,
    audioMimeType,
    audioNomeArquivo,
    CriarAgenda,
    DataHoraAgenda,
    NotificarAgenda,
    MensagemRespondida,
    MensagemInterna
);

            if (!result.Sucesso)
            {
                Sucesso = false;
                Mensagem = result.Mensagem;
                return;
            }

            // ← salva o cabeçalho junto, sem precisar de botão separado
            await TicketService.SalvarCabecalhoTicketAsync(
                TicketAtual,
                UserState.CurrentUser ?? ""
            );

            if (result.Sucesso)
            {
                RemoverVideoGravado();
                RemoverAudio();
            }


            if (TicketAtual.CodSituacao == 3)
            {
                await TicketService.ResolverAgendasDoTicketAsync(TicketAtual.Codigo);
            }

            // if (!string.IsNullOrWhiteSpace(MensagemCliente))
            // {
            //     var resp = await TicketService.ResponderClienteWhatsAppAsync(
            //         Ticket.Codigo,
            //         MensagemCliente
            //     );

            //     if (!resp.Sucesso)
            //     {
            //         Sucesso = false;
            //         Mensagem = resp.Mensagem;
            //         return;
            //     }
            // }

            Sucesso = true;
            Mensagem = "Ticket atualizado com sucesso.";
            MensagemRespondida = null;
            MensagemInterna = false;
            SugestaoIA = "";  // ← adicionar esta linha

            ArquivoAnotacao = null;
            PreviewArquivoAnotacao = null;

            // Cancela qualquer salvamento de rascunho pendente
            _rascunhoTimer?.Dispose();
            _rascunhoTimer = null;

            NovaAnotacao = "";
            await JS.InvokeVoidAsync("ticketRascunho.limpar", id);
            Historico = await TicketService.BuscarHistoricoAsync(id);
            _ultimoCodigoHistorico = Historico.Count > 0 ? Historico.Max(h => h.Codigo) : 0;

            CriarAgenda = false;
            NotificarAgenda = true;
            DataHoraAgenda = null;

            _codSetorOriginal = TicketAtual.CodSetor;
            _codSituacaoOriginal = TicketAtual.CodSituacao;
            _usuarioOriginal = (TicketAtual.Usuario ?? "").Trim();

            var gerarIaFinal = await ParametroService.BuscarBoolAsync(
    "TICKET_GERAR_IA_FINAL_ATENDIMENTO",
    "TICKET",
    "Define se o sistema pergunta ou gera resumo por IA no final do atendimento. S=SIM N=NAO. PADRAO=N",
    false);

            if (TicketAtual.CodSituacao == 3)
            {
                if (gerarIaFinal == true)
                {
                    MostrarModalGerarInsight = true;
                }
            }

            StateHasChanged(); // uma única chamada, cobre os dois casos
        }
        catch (Exception ex)
        {
            Sucesso = false;
            Mensagem = "Erro ao salvar: " + ex.Message;
            HealthMonitor.LogException(LogCategory.Tickets, ex,
                $"Ticket.SalvarAlteracoes #{id}");
        }
    }

