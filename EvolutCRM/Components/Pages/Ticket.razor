    }

        .ticket-doc-card a:hover { text-decoration: underline; }

    .ticket-doc-card .ticket-doc-preview { font-size: 10px; color: #475569; margin-top: 4px; line-height: 1.4; }

    .ticket-doc-card .btn-inserir-doc {
