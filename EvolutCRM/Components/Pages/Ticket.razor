        border-radius: 999px;
        font-size: 9px;
        font-weight: 800;
        padding: 4px 10px;
        cursor: pointer;
        transition: .13s ease;
    }

        .ticket-doc-card .btn-inserir-doc:hover { background: var(--tk-b50); transform: translateY(-1px); }

/* Modo abertura (novo ticket) */
.container-ticket.ticket-modern-container.modo-novo {
