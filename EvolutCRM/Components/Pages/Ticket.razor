                        <select @bind="UsuarioSelecionado" class="@(ResponsavelInvalido ? "select-erro" : "")">
                            <option value="">Selecione...</option>
                            @foreach (var u in Usuarios)
                            {
                                <option value="@u">@u</option>
                            }
                        </select>
                    </div>

                    <div class="grupo" style="margin-bottom:0;">
                        <label>Destino</label>
                        <select @bind="TipoEnvioCliente">
                            <option value="UNICO">Cliente específico</option>
                            <option value="TODOS_MENSALISTAS">Todos mensalistas</option>
                        </select>
                        @if (TipoEnvioCliente == "TODOS_MENSALISTAS")
                        {
                            <small class="hint" style="color:#b45309;">⚠️ Um ticket por mensalista.</small>
                        }
                    </div>

                    @if (TipoEnvioCliente == "UNICO")
                    {
                        <div class="grupo" style="margin-bottom:0; position:relative;">
                            <label>Cliente</label>
                            <input @bind="ClienteBusca"
                                   @bind:event="oninput"
                                   @bind:after="BuscarClientes"
                                   class="@(ClienteInvalido ? "select-erro" : "")"
                                   placeholder="Código ou nome..." />
                            @if (ClienteInvalido)
                            {
                                <small style="color:#e53935; font-weight:700;">Selecione um cliente.</small>
                            }
                            @if (Sugestoes?.Any() == true)
                            {
                                <ul class="autocomplete-list" style="position:absolute; top:100%; left:0; right:0; z-index:999;">
                                    @foreach (var cli in Sugestoes)
                                    {
                                        <li @onclick="async () => await SelecionarCliente(cli)">
                                            <strong>@cli.Codigo</strong> - @cli.Nome
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="grupo" style="margin-bottom:0;">
                            <label>Cliente</label>
                            <input value="Todos os mensalistas ativos" disabled />
                        </div>
                    }
                </div>

                <div style="display:grid; grid-template-columns:2fr 1fr 1fr 1fr 1fr; gap:8px; margin-bottom:8px;">
                    <div class="grupo" style="margin-bottom:0;">
                        <label>Assunto</label>
                        <input @bind="Assunto" placeholder="Ex.: Ajustar impressão da NFC-e" />
                    </div>
                    <div class="grupo" style="margin-bottom:0;">
                        <label>Setor</label>
                        <select @bind="CodSetor">
                            @foreach (var setor in SetoresTicket)
                            {
                                <option value="@setor.Codigo">@setor.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="grupo" style="margin-bottom:0;">
                        <label>Situação</label>
                        <select @bind="CodSituacao" disabled="@(!PodeAlterarStatusTicket)">
                            @foreach (var situacao in SituacoesTicket)
                            {
                                <option value="@situacao.Codigo">@situacao.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="grupo" style="margin-bottom:0;">
                        <label>Tipo</label>
                        <select value="@CodTipo" @onchange="OnTipoChanged">
                            @foreach (var tipo in TiposTicket)
                            {
                                <option value="@tipo.Codigo">@tipo.Descricao</option>
                            }
                        </select>
                    </div>
                    <div class="grupo" style="margin-bottom:0;">
                        <label>Prioridade</label>
                        <select @bind="Prioridade">
                            <option value="1">Baixa</option>
                            <option value="2">Normal</option>
                            <option value="3">Alta</option>
                            <option value="4">Urgente</option>
                        </select>
                    </div>
                </div>

                @if (CodTipo == 4)
