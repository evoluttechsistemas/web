    private static IEnumerable<string> SepararUrlsDoTexto(string texto)
    {
        var regex = new System.Text.RegularExpressions.Regex(
            @"(https?://[^\s]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );
        return regex.Split(texto).Where(p => !string.IsNullOrEmpty(p));
    }

