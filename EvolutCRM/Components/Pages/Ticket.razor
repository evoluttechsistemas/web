    private async Task PerguntarIA()
    {
        if (string.IsNullOrWhiteSpace(NovaAnotacao))
            return;

        try
        {
            var http = new HttpClient();
            http.BaseAddress = new Uri(Nav.BaseUri);

            var response = await http.PostAsJsonAsync("/api/help/chat",
                new { message = NovaAnotacao });

            var result = await response.Content.ReadFromJsonAsync<AiChatResponse>();

            if (result != null)
            {
                NovaAnotacao += Environment.NewLine + Environment.NewLine +
                                "🤖 IA:" + Environment.NewLine +
                                result.Reply;
            }
        }
        catch (Exception ex)
        {
            NovaAnotacao += Environment.NewLine +
                            "Erro IA: " + ex.Message;
        }
    }

    private async Task GerarRespostaIA()
    {
        CarregandoIA = true;
        Mensagem = "";

        try
        {
            var pergunta = UltimaMensagemCliente ?? NovaAnotacao;

            if (string.IsNullOrWhiteSpace(pergunta))
            {
                Mensagem = "Digite uma mensagem ou tenha uma mensagem do cliente no histórico para gerar a resposta.";
                Sucesso = false;
                return;
            }

            // DEPOIS:
            var mensagensRelevantes = Historico
                .Where(x =>
                    (!string.IsNullOrWhiteSpace(x.Anotacao) || !string.IsNullOrWhiteSpace(x.TranscricaoAudio)) &&
                    x.MensagemExcluida != "S" &&
                    x.StatusEnvioWhatsApp != "ia_processing")
                .OrderBy(x => x.DataHora)
                .TakeLast(25)
                .ToList();

            var conversationContext = string.Join("\n",
                mensagensRelevantes.Select(x =>
                {
                    var autor = x.EnvioCliente == "S" ? "Cliente" : "Atendente";

                    // Prefere o texto da anotação; se for áudio, usa a transcrição
                    var texto = !string.IsNullOrWhiteSpace(x.Anotacao)
                        ? x.Anotacao.Trim()
                        : !string.IsNullOrWhiteSpace(x.TranscricaoAudio)
                            ? $"[Áudio transcrito] {x.TranscricaoAudio.Trim()}"
                            : "";

                    if (string.IsNullOrWhiteSpace(texto))
                        return null;

                    if (texto.Length > 800)
                        texto = texto.Substring(0, 800) + "...";

                    return $"[{x.DataHora:dd/MM HH:mm}] {autor}: {texto}";
                })
                .Where(x => x != null));

            var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };

            var resp = await http.PostAsJsonAsync("/api/help/suggest", new
            {
                message = pergunta,
                conversationContext = conversationContext
            });

            if (!resp.IsSuccessStatusCode)
            {
                var txt = await resp.Content.ReadAsStringAsync();
                Mensagem = $"Erro IA ({(int)resp.StatusCode}): {txt}";
                Sucesso = false;
                HealthMonitor.Log(LogCategory.Tickets, LogSeverity.Warning,
                    $"Ticket #{id} — IA retornou HTTP {(int)resp.StatusCode}",
                    txt.Length > 150 ? txt[..150] : txt);
                return;
            }

            var data = await resp.Content.ReadFromJsonAsync<AiChatResponse>();

            SugestaoIA = data?.Reply?.Trim() ?? "";

            if (string.IsNullOrWhiteSpace(SugestaoIA))
            {
                Mensagem = "A IA retornou vazio. Verifique o endpoint /api/help/suggest.";
                Sucesso = false;
                return;
            }

            // Joga a sugestão direto no campo de mensagem
            NovaAnotacao = SugestaoIA;

            Sucesso = true;
            Mensagem = "Sugestão da IA inserida no campo de mensagem. Revise antes de enviar.";
        }
        // catch do GerarRespostaIA
        catch (Exception ex)
        {
            Sucesso = false;
            Mensagem = "Erro ao gerar resposta IA: " + ex.Message;
            HealthMonitor.LogException(LogCategory.Tickets, ex,
                $"Ticket.GerarRespostaIA #{id}");
        }
        finally
        {
            CarregandoIA = false;
            StateHasChanged();
        }
    }

