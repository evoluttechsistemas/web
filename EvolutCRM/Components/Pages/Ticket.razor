    private async Task OnKeyDownVersaoF2(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmarVersaoF2();
        if (e.Key == "Escape")
        {
            _mostrarModalVersaoF2 = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task CancelarModalF2()
    {
        _mostrarModalConfirmarF2 = false;
        _mostrarModalVersaoF2 = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnInputMensagem(ChangeEventArgs e)
{
    NovaAnotacao = e.Value?.ToString() ?? "";
    _usuarioEstaDigitando = true;
    _ultimaDigitacao = DateTime.Now;
    AoDigitarMensagem();
}

    private async Task OnBlurMensagem()
    {
        _usuarioEstaDigitando = false;

        // Se tinha renderização pendente, executa agora
        if (_renderizacaoPendente)
        {
            _renderizacaoPendente = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task EnviarMensagemViaJS(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return;

        // ── Mostra a mensagem imediatamente na tela (optimistic UI) ──
        var mensagemLocal = new TicketChamadoDModel
        {
            Codigo = -1, // temporário, substituído após salvar
            CodTicketChamadoC = id,
            Anotacao = texto,
            DataHora = DateTime.Now,
            Usuario = UserState.CurrentUser?.Trim().ToUpper() ?? "",
            EnvioCliente = "N",
            MensagemExcluida = "N",
            Alterado = "N",
            Interno = MensagemInterna ? "S" : "N",
            StatusEnvioWhatsApp = "sending"
        };

        Historico.Insert(0, mensagemLocal);
        await InvokeAsync(StateHasChanged); // aparece na tela imediatamente

        // ── Agora salva no banco ──
        NovaAnotacao = texto;
        await SalvarAlteracoes();

        // ── Substitui a mensagem temporária pelo histórico real ──
        Historico = await TicketService.BuscarHistoricoAsync(id);
        _ultimoCodigoHistorico = Historico.Count > 0 ? Historico.Max(h => h.Codigo) : 0;
        await InvokeAsync(StateHasChanged);
    }

}
