    private void OnVersaoInput(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? "";

        // remove tudo que não for número
        valor = new string(valor.Where(char.IsDigit).ToArray());

        if (valor.Length > 6)
            valor = valor[..6];

        // aplica máscara 99.99.99
        if (valor.Length >= 5)
            valor = $"{valor[..2]}.{valor.Substring(2, 2)}.{valor.Substring(4)}";
        else if (valor.Length >= 3)
            valor = $"{valor[..2]}.{valor.Substring(2)}";

        TicketAtual.Versao = valor;
    }

