@code {
    private bool MensagemInterna = false;
    private string BuscaDoc = "";
    private bool BuscandoDocs = false;
    private List<DocSearchItem> DocsEncontradas = new();
    private string? UrlVoltar;
    List<TicketChamadoCModel> TicketsDoCliente = new();
    bool MostrarModalTicketsCliente = false;
    bool CarregandoTicketsCliente = false;
    string NomeWhatsApp = "";
    string TelefoneWhatsApp = "";
    List<WhatsAppContatoDto> TelefonesWhatsAppCliente = new();
    List<TicketVisualizacaoUsuarioModel> VisualizadoresTicket = new();
    private List<TicketSituacaoCadastroModel> SituacoesTicket = new();
    private List<TicketTipoCadastroModel> TiposTicket = new();
    private List<TicketSetorCadastroModel> SetoresTicket = new();


    private PeriodicTimer? _timerVisualizacao;
    private CancellationTokenSource? _ctsVisualizacao;

    int? CodigoMensagemEditando = null;
    string TextoMensagemEditando = "";
    private string MotivoRecusaAprovacao = "";
    private string MensagemAprovacao = "";
    private bool ClienteInvalido = false;

    bool gravandoAudio;
    byte[] audioGravado;
    string audioMimeType;
    string audioNomeArquivo;
    string previewAudio;

    private bool MostrarModalAcessoRemoto = false;
    private bool CarregandoAcessosRemotos = false;
    private bool EditandoAcessoRemoto = false;

    private List<AcessoRemotoModel> AcessosRemotosCliente = new();

    private AcessoRemotoModel AcessoRemotoEditando = new();

    private bool GravandoTela = false;
    private byte[]? VideoGravado;
    private string VideoGravadoNome = "";
    private string VideoGravadoMime = "";
    private bool AlterandoCliente = false;

    private bool ClienteNaoSelecionado()
    {
        return CodCliente <= 0;
    }

    private string ObterIniciaisCliente(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome))
            return "?";

        var partes = nome
            .Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 0)
            return "?";

        if (partes.Length == 1)
            return partes[0].Length >= 2
                ? partes[0][..2].ToUpper()
                : partes[0].ToUpper();

        return $"{partes[0][0]}{partes[^1][0]}".ToUpper();
    }

    private async Task AbrirModalAcessoRemoto()
    {
        if (TicketAtual == null || TicketAtual.CodCliente <= 0)
        {
            Mensagem = "Selecione um cliente para cadastrar ou visualizar os acessos remotos.";
            Sucesso = false;
            return;
        }

        MostrarModalAcessoRemoto = true;
        EditandoAcessoRemoto = false;
        AcessosRemotosCliente = new();

        await CarregarAcessosRemotosCliente();
    }

    private async Task CarregarAcessosRemotosCliente()
    {
        if (TicketAtual == null || TicketAtual.CodCliente <= 0)
            return;

        try
        {
            CarregandoAcessosRemotos = true;

            AcessosRemotosCliente = await TicketService.ListarAcessosRemotosClienteAsync(
                TicketAtual.CodCliente
            );

            await AtualizarStatusOnlineAcessosAsync(AcessosRemotosCliente);
        }
        catch (Exception ex)
        {
            AcessosRemotosCliente = new();
            Mensagem = "Erro ao carregar acessos remotos: " + ex.Message;
            Sucesso = false;
        }
        finally
        {
            CarregandoAcessosRemotos = false;
        }
    }

    private async Task AtualizarStatusOnlineAcessosAsync(List<AcessoRemotoModel> acessos)
    {
        if (acessos == null || !acessos.Any())
            return;


        try
        {
            var status = await KHelpDeskApi.BuscarStatusDispositivosAsync(
                acessos.Select(x => x.CodigoAcesso)
            );

            foreach (var acesso in acessos)
            {
                if (status.TryGetValue(acesso.CodigoAcesso?.Trim() ?? "", out var online))
                    acesso.Online = online;
                else
                    acesso.Online = false;
            }
        }
        catch
        {
            foreach (var acesso in acessos)
                acesso.Online = false;
        }
    }

    private void FecharModalAcessoRemoto()
    {
        MostrarModalAcessoRemoto = false;
        EditandoAcessoRemoto = false;
        AcessoRemotoEditando = new();
    }

    private void AoDigitarMensagem()
    {
        CapitalizarPrimeiraLetraMensagem();
        AgendarSalvarRascunho();
    }

    private void CapitalizarPrimeiraLetraMensagem()
    {
        if (string.IsNullOrEmpty(NovaAnotacao))
            return;

        var cultura = new System.Globalization.CultureInfo("pt-BR");
        var letras = NovaAnotacao.ToCharArray();

        for (var i = 0; i < letras.Length; i++)
        {
            if (char.IsLetter(letras[i]))
            {
                var maiuscula = char.ToUpper(letras[i], cultura);

                if (letras[i] != maiuscula)
                {
                    letras[i] = maiuscula;
                    NovaAnotacao = new string(letras);
                }

                return;
            }
        }
    }
    private void NovoAcessoRemoto()
    {
        if (TicketAtual == null)
            return;

        AcessoRemotoEditando = new AcessoRemotoModel
        {
            CodCliente = TicketAtual.CodCliente
        };

        EditandoAcessoRemoto = true;
    }

    private void EditarAcessoRemoto(AcessoRemotoModel acesso)
    {
        AcessoRemotoEditando = new AcessoRemotoModel
        {
            Codigo = acesso.Codigo,
            CodCliente = acesso.CodCliente,
            NomeComputador = acesso.NomeComputador,
            CodigoAcesso = acesso.CodigoAcesso
        };

        EditandoAcessoRemoto = true;
    }

    private void CancelarEdicaoAcessoRemoto()
    {
        EditandoAcessoRemoto = false;
        AcessoRemotoEditando = new();
    }

    private async Task SalvarAcessoRemoto()
    {
        if (TicketAtual == null)
            return;

        if (string.IsNullOrWhiteSpace(AcessoRemotoEditando.NomeComputador))
        {
            Mensagem = "Informe o nome do computador.";
