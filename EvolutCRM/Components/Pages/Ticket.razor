<script>
    window.enablePasteImage = (textareaId, dotnetRef) => {
        console.log("[PasteImage] Inicializando para:", textareaId);

        const el = document.getElementById(textareaId);

        if (!el) {
            console.error("[PasteImage] Textarea NÃO encontrado");
            return;
        }

        console.log("[PasteImage] Textarea encontrado:", el);

        el.addEventListener("paste", async (e) => {
            console.log("[PasteImage] Evento paste disparado");

            if (!e.clipboardData) {
                console.warn("[PasteImage] clipboardData é null");
                return;
            }

            const items = e.clipboardData.items;
            console.log("[PasteImage] Itens no clipboard:", items);

            for (const item of items) {
                console.log("[PasteImage] Item:", item.type);

                if (item.type.startsWith("image/")) {
                    console.log("[PasteImage] IMAGEM detectada:", item.type);

                    e.preventDefault();

                    const file = item.getAsFile();
                    console.log("[PasteImage] Arquivo:", file);

                    // 🔧 Feedback visual
                    el.style.opacity = "0.5";
                    el.disabled = true;

                    const reader = new FileReader();

                    reader.onload = async () => {
                        console.log("[PasteImage] Base64 gerado, chamando Blazor");

                        try {
                            await dotnetRef.invokeMethodAsync(
                                "OnImagemColada",
                                reader.result,
                                file.type
                            );
                            console.log("✅ Imagem enviada com sucesso");
                        } catch (err) {
                            console.error("❌ Erro ao enviar imagem:", err);
                            alert("Erro ao processar imagem. Tente novamente.");
                        } finally {
                            // Restaura textarea
                            el.style.opacity = "1";
                            el.disabled = false;
                        }
                    };

                    reader.onerror = () => {
                        console.error("❌ Erro ao ler arquivo");
                        alert("Erro ao ler imagem do clipboard.");
                        el.style.opacity = "1";
                        el.disabled = false;
                    };

                    reader.readAsDataURL(file);
                    return;
                }
            }

            console.log("[PasteImage] Nenhuma imagem no clipboard");
        });
    };

    window.openImageViewer = (url) => {
        if (!url) return;

        const w = window.open("", "_blank");
        if (!w) return;

        w.document.write(`
                <html>
                    <head>
                        <title>Imagem</title>
                    </head>
                    <body style="margin:0; background:#111; display:flex; align-items:center; justify-content:center;">
                        <img src="${url}" style="max-width:100%; max-height:100vh; object-fit:contain;" />
                    </body>
                </html>
            `);
    };
</script>

