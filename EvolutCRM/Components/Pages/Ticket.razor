    [JSInvokable]
    public async Task OnImagemColada(string base64, string contentType)
    {
        try
        {
            var bytes = Convert.FromBase64String(base64.Split(',')[1]);

            // 🔒 Limita a 10MB antes do redimensionamento
            if (bytes.Length > 10 * 1024 * 1024)
            {
                Mensagem = "Imagem muito grande. Máximo: 10MB";
                Sucesso = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // 🖼️ Redimensiona e comprime a imagem
            var originalStream = new MemoryStream(bytes);
            var imagemRedimensionada = await RedimensionarImagemAsync(originalStream);

            Console.WriteLine($"✅ Imagem redimensionada: {bytes.Length / 1024}KB → {imagemRedimensionada.Length / 1024}KB");

            // 📦 Cria preview otimizado
            var base64Redimensionado = Convert.ToBase64String(imagemRedimensionada);
            PreviewArquivoAnotacao = $"data:image/jpeg;base64,{base64Redimensionado}";

            var streamRedimensionado = new MemoryStream(imagemRedimensionada);

            ArquivoAnotacao = new BrowserFileFromStream(
                streamRedimensionado,
                "image/jpeg",
                "clipboard.jpg"
            );

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Erro ao colar imagem: {ex.Message}");
            Mensagem = "Erro ao processar imagem colada.";
            Sucesso = false;
            await InvokeAsync(StateHasChanged);
        }
    }

