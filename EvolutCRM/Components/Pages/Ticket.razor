    private async Task BuscarClientes()
    {
        _debounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(ClienteBusca))
        {
            Sugestoes.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                var resultado = await TicketService.BuscarClientesAsync(ClienteBusca);

                await InvokeAsync(() =>
                {
                    Sugestoes = resultado;
                    StateHasChanged();
                });
            }
            catch
            {
                // Evita quebrar digitação caso a busca falhe momentaneamente.
            }
        }, null, 500, Timeout.Infinite);
    }

