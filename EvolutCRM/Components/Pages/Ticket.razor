                                @if (!string.IsNullOrWhiteSpace(telefoneOrigemWhats))
                                {
                                    <small>
                                        @telefoneOrigemWhats
                                    </small>
                                }

                            </span>
                        }

                    </div>



                </div>

            </div>


            <div class="ticket-header-right">


                <div class="ticket-history-header-actions">

                    <button type="button"
                            class="btn-acesso-remoto"
