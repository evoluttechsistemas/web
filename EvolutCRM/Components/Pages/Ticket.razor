    font-size: 10.5px !important;
    background: #f8fbff url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231d4ed8' stroke-width='2.5' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><line x1='21' y1='21' x2='16.5' y2='16.5'/></svg>") no-repeat 10px center !important;
    background-size: 14px 14px !important;
    border: 1.5px solid var(--tk-b200) !important;
}

    .ticket-doc-search:focus {
        background-color: #ffffff !important;
        border-color: var(--tk-b500) !important;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15) !important;
    }

.ticket-doc-results { margin-top: 10px; display: grid; gap: 8px; }

.ticket-doc-card {
