    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            VelocidadeAudioGlobal = await JS.InvokeAsync<double>(
                "carregarVelocidadeAudio",
                ChaveVelocidadeAudio
            );

            await JS.InvokeVoidAsync(
                "setVelocidadeTodosAudios",
                VelocidadeAudioGlobal,
                ChaveVelocidadeAudio
            );

            // Visibility: usa ref tipada e armazenada
            _visibilityRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerVisibilityChange", _visibilityRef);
            _paginaVisivel = await JS.InvokeAsync<bool>("isPageVisible");

            if (!EhNovo)
                await JS.InvokeVoidAsync("registrarAtalhoF3", _visibilityRef);

            StateHasChanged();
        }

        if (_mostrarModalF1 && _etapaModalF1 == 3)
        {
            await JS.InvokeVoidAsync("eval",
                "setTimeout(() => document.querySelector('#inputVersaoF1')?.focus(), 50)");
        }

        if (!_rascunhoCarregado && !EhNovo && TicketAtual != null)
        {
            _rascunhoCarregado = true;

            var rascunho = await JS.InvokeAsync<string>("ticketRascunho.carregar", id);
            if (!string.IsNullOrWhiteSpace(rascunho) && string.IsNullOrWhiteSpace(NovaAnotacao))
            {
                NovaAnotacao = rascunho;
                await InvokeAsync(StateHasChanged);
            }
        }
        // DEPOIS: inicializa para o ticket existente OU para o novo ticket
        if (!_pasteJsInicializado && !Carregando)
        {
            if (TicketAtual != null)
            {
                _pasteRef ??= DotNetObjectReference.Create<object>(this);
                _dotnetRef = _pasteRef;
                await JS.InvokeVoidAsync("enablePasteImage", $"obsAnotacao_{id}", _pasteRef);

                // ← ADICIONAR ESTA LINHA
                await JS.InvokeVoidAsync("obsAnotacaoInit", $"obsAnotacao_{id}", _pasteRef);

                _pasteJsInicializado = true;
                await JS.InvokeVoidAsync("eval", $"document.getElementById('obsAnotacao_{id}')?.focus()");
            }
            else if (EhNovo)
            {
                _pasteRef ??= DotNetObjectReference.Create<object>(this);
                _dotnetRef = _pasteRef;
                await JS.InvokeVoidAsync("enablePasteImage", "obsAnotacaoNovo", _pasteRef);
                _pasteJsInicializado = true;

                // ← ADICIONE ISSO
                await JS.InvokeVoidAsync("eval", "document.getElementById('obsAnotacaoNovo')?.focus()");
            }
        }
