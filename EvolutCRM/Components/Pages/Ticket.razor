    private void IniciarControleVisualizacao()
    {
        if (EhNovo || TicketAtual == null)
            return;

        _ctsVisualizacao?.Cancel();
        _ctsVisualizacao?.Dispose();
        _timerVisualizacao?.Dispose();

        _ctsVisualizacao = new CancellationTokenSource();
        _timerVisualizacao = new PeriodicTimer(TimeSpan.FromSeconds(15));

        _ = Task.Run(async () =>
{
    try
    {
        await RegistrarVisualizacaoAtualAsync();

        while (await _timerVisualizacao.WaitForNextTickAsync(_ctsVisualizacao.Token))
        {
            await RegistrarVisualizacaoAtualAsync();
        }
    }
    catch (OperationCanceledException) { }
    catch (Exception ex)
    {
        try { await JS.InvokeVoidAsync("crmLog", $"[Visualizacao] Erro: {ex.Message}"); }
        catch { }
    }
});
    }

