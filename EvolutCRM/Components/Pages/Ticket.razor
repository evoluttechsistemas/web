@page "/ticket"
@page "/ticket/{id:int}"
@inject EvolutCRM.Services.TicketService TicketService
@inject EvolutCRM.Services.UserState UserState
@inject NavigationManager Nav
@inject TicketNotificationState TicketNotify
@inject IJSRuntime JS
@using EvolutCRM.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats.Jpeg
@inject EvolutCRM.Services.CardService CardService
@inject EvolutCRM.Services.AiAutoLearningService AiAuto
@inject EvolutCRM.Services.AdminService AdminService
@using Microsoft.AspNetCore.WebUtilities
@inject EvolutCRM.Services.KHelpDeskApiService KHelpDeskApi
@inject EvolutCRM.Abas.AbaService Abas
@inject IHttpContextAccessor HttpContextAccessor
@inject EvolutCRM.Services.HealthMonitorService HealthMonitor
@inject ParametroDinamicoService ParametroService
@inject EvolutCRM.Services.TicketClassificacaoService TicketClassificacaoService

<style>
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700;800&display=swap');

.container-ticket, .ticket-modern-container {
    --tk-b50: #eff6ff;
    --tk-b100: #dbeafe;
    --tk-b200: #bfdbfe;
    --tk-b300: #93c5fd;
    --tk-b500: #3b82f6;
    --tk-b600: #2563eb;
    --tk-b700: #1d4ed8;
    --tk-b800: #1e40af;
    --tk-b900: #1e3a8a;
    --tk-b950: #172554;
    --tk-bg: #eef7ff;
    --tk-surface: #ffffff;
    --tk-ink: #0f172a;
    --tk-muted: #64748b;
    --tk-line: #cbd5e1;
    --tk-green: #16a34a;
    --tk-green-soft: #dcfce7;
    --tk-red: #dc2626;
    --tk-red-soft: #ffe4e6;
    --tk-amber: #d97706;
    --tk-amber-soft: #fef3c7;
    --tk-purple: #7c3aed;
    --tk-radius: 10px;
    --tk-shadow: 0 1px 2px rgba(15,23,42,.06), 0 2px 8px rgba(15,23,42,.05);
    --tk-shadow-blue: 0 4px 16px rgba(37,99,235,.18), 0 1px 4px rgba(37,99,235,.10);
}

html, body {
    height: 100%;
    overflow: hidden;
}

body {
    background: var(--tk-bg);
}

/* =========================================================
               CONTAINER PRINCIPAL
               ========================================================= */
    .container-ticket.ticket-modern-container {
        width: 100% !important;
        max-width: none !important;
        height: 100% !important;
        max-height: 100% !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 10px !important;
        overflow: hidden !important;
        background: #eef7ff !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        box-sizing: border-box !important;
        font-family: 'IBM Plex Sans', sans-serif !important;
        color: var(--tk-ink) !important;
        display: flex !important;
        flex-direction: column !important;
    }

    .ticket-info-avatar {
        width: 34px !important;
        height: 34px !important;
        border-radius: 8px !important;
        background: linear-gradient(135deg, var(--tk-b600), var(--tk-b950)) !important;
        color: white;
        display: grid;
        place-items: center;
        font-weight: 950;
        font-size: .72rem !important;
        flex: 0 0 auto;
    }

    .ticket-info-avatar-img {
        width: 34px !important;
        height: 34px !important;
        border-radius: 8px !important;
        object-fit: cover !important;
        border: 1.5px solid var(--tk-b200) !important;
        background: var(--tk-b50) !important;
        box-shadow: 0 1px 3px rgba(13,71,161,.10) !important;
        flex: 0 0 auto;
    }

    .ticket-info-avatar-fallback {
        width: 34px !important;
        height: 34px !important;
        border-radius: 8px !important;
        background: linear-gradient(135deg, var(--tk-b600), var(--tk-b950)) !important;
        color: white;
        display: grid;
        place-items: center;
        font-weight: 950;
        font-size: .72rem !important;
        flex: 0 0 auto;
    }

/* =========================================================
               TOPBAR
               ========================================================= */
.ticket-modern-topbar {
    flex: 0 0 auto !important;
    background: linear-gradient(135deg, #0d47a1, #07306f) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255,255,255,.12) !important;
    border-radius: 14px !important;
        min-height: 44px !important;
        padding: 4px 10px;
    margin-bottom: 8px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    box-shadow: 0 10px 28px rgba(13, 71, 161, .35) !important;
}

    .ticket-modern-topbar * {
        color: inherit;
    }

.ticket-header-left {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    min-width: 0 !important;
}

.ticket-title-wrap {
    display: flex !important;
    flex-direction: column !important;
    min-width: 0 !important;
}

.ticket-back-btn {
    width: 30px !important;
    height: 30px !important;
    border-radius: 999px !important;
    border: 1.5px solid rgba(255,255,255,.28) !important;
    background: rgba(255,255,255,.12) !important;
    color: #ffffff !important;
    font-size: 15px !important;
    font-weight: 950 !important;
    cursor: pointer !important;
    display: grid !important;
    place-items: center !important;
    flex-shrink: 0 !important;
    transition: .18s ease !important;
}

    .ticket-back-btn:hover {
        background: rgba(255,255,255,.20) !important;
        transform: translateY(-1px) !important;
    }

.ticket-ticket-line {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
}

.ticket-code-box {
    padding: 5px 10px !important;
    border-radius: 999px !important;
    background: rgba(255,255,255,.15) !important;
    border: 1px solid rgba(255,255,255,.22) !important;
    backdrop-filter: blur(6px) !important;
    flex-shrink: 0 !important;
}

.ticket-code-number {
    font-family: 'IBM Plex Mono', monospace !important;
    font-size: 12px !important;
    font-weight: 950 !important;
    letter-spacing: .02em !important;
    color: #ffffff !important;
    line-height: 1 !important;
}

.ticket-code-label,
.ticket-sub-status,
.ticket-separator {
    color: #dbeafe !important;
}

.ticket-client-box {
    display: flex !important;
    align-items: center !important;
    padding: 5px 10px !important;
    min-width: 180px !important;
    max-width: 330px !important;
    border-radius: 10px !important;
    background: rgba(255,255,255,.10) !important;
    border: 1px solid rgba(255,255,255,.15) !important;
    overflow: hidden !important;
    flex: 1 1 auto !important;
}

.ticket-client-name {
    font-size: .74rem !important;
    font-weight: 900 !important;
    color: #ffffff !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    line-height: 1.15 !important;
}

.ticket-whatsapp-chip {
    display: flex !important;
    align-items: center !important;
    gap: 5px !important;
    min-height: 24px !important;
    padding: 0 9px !important;
    border-radius: 999px !important;
    background: #22c55e !important;
    color: #ffffff !important;
    font-size: 10px !important;
    font-weight: 800 !important;
    line-height: 1 !important;
    box-shadow: 0 5px 12px rgba(34,197,94,.30) !important;
    white-space: nowrap !important;
}

    .ticket-whatsapp-chip small {
        font-size: .56rem !important;
        opacity: .95 !important;
        color: #ffffff !important;
    }

.ticket-whats-icon {
    width: 14px !important;
    height: 14px !important;
    border-radius: 999px !important;
    background: rgba(255,255,255,.25) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: .55rem !important;
    line-height: 1 !important;
}

.ticket-status-dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 999px !important;
    background: #22c55e !important;
    box-shadow: 0 0 10px #22c55e !important;
    flex-shrink: 0 !important;
}

.ticket-header-right {
    display: flex !important;
    align-items: center !important;
    gap: 5px !important;
    flex-wrap: wrap !important;
    justify-content: flex-end !important;
}

.ticket-history-header-actions {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    flex-wrap: wrap !important;
}

.ticket-kpi-card {
    min-width: 78px !important;
    padding: 5px 7px !important;
    border-radius: 8px !important;
    background: rgba(255,255,255,.18) !important;
    color: #ffffff !important;
    backdrop-filter: blur(6px) !important;
    display: flex !important;
    flex-direction: column !important;
    line-height: 1.05 !important;
}

    .ticket-kpi-card small {
        font-size: 8px !important;
        opacity: .85 !important;
        color: #ffffff !important;
        line-height: 1 !important;
    }

    .ticket-kpi-card strong {
        margin-top: 2px !important;
        font-size: 10px !important;
        font-weight: 950 !important;
        color: #ffffff !important;
        line-height: 1 !important;
    }

.ticket-viewers {
    display: flex !important;
    align-items: center !important;
    gap: 4px !important;
}

.visualizador-badge {
    width: 26px !important;
    height: 26px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: white !important;
    font-size: 10px !important;
    font-weight: 900 !important;
    border: 2px solid white !important;
    box-shadow: 0 2px 8px rgba(0,0,0,.15) !important;
}

.ticket-modern-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px !important;
    border-radius: 999px !important;
    background: #f8fbff;
    border: 1px solid #bfdbfe;
    color: #0d47a1;
    font-size: .65rem !important;
    font-weight: 950;
    white-space: nowrap;
}

.ticket-modern-grid {
    display: grid !important;
    grid-template-columns: minmax(230px, 260px) minmax(0, 1fr) !important;
    gap: 8px !important;
    flex: 1 1 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
    height: 100% !important;   /* ← ISSO AQUI é o que faltava */
}

/* Informações do ticket na esquerda */
.ticket-modern-right {
    grid-column: 1 !important;
    grid-row: 1 !important;
}

/* Histórico da conversa na direita */
.ticket-modern-center {
    grid-column: 2 !important;
    grid-row: 1 !important;
}

.ticket-modern-panel {
    background: var(--tk-surface) !important;
    border: 1.5px solid var(--tk-b200) !important;
    border-radius: 10px !important;
    box-shadow: var(--tk-shadow) !important;
    padding: 10px !important;
    min-width: 0 !important;
    min-height: 0 !important;
    overflow: hidden !important;
}

/* Coluna esquerda */
.ticket-modern-left {
    position: static !important;
    height: 100% !important;
    max-height: 100% !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    min-width: 0 !important;
    min-height: 0 !important;
}

/* Coluna direita */
    .ticket-modern-right {
        position: static !important;
        height: 100% !important;
        max-height: 100% !important;
        overflow-y: auto !important;
        overflow-x: visible !important;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        display: flex !important;
        flex-direction: column !important;
        padding: 8px !important;
        padding-bottom: 0 !important;
        min-width: 0 !important;
        min-height: 0 !important;
    }

    .ticket-modern-left::-webkit-scrollbar,
    .ticket-modern-right::-webkit-scrollbar,
    .historico-wrap::-webkit-scrollbar {
        width: 7px;
    }

    .ticket-modern-left::-webkit-scrollbar-thumb,
    .ticket-modern-right::-webkit-scrollbar-thumb,
    .historico-wrap::-webkit-scrollbar-thumb {
        background: var(--tk-b200);
        border-radius: 999px;
    }

/* Coluna central (chat) */
.ticket-modern-center.ticket-history-main {
    height: 100% !important;
    min-height: 0 !important;
    max-height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    padding: 0 !important;
    background: #e5ddd5 !important;
    background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,.42) 0 1px, transparent 1px),
                      radial-gradient(circle at 80% 60%, rgba(255,255,255,.28) 0 1px, transparent 1px),
                      linear-gradient(180deg, #efeae2, #e5ddd5) !important;
    background-size: 26px 26px, 34px 34px, auto !important;
}

.ticket-history-main::before {
    content: "Histórico da conversa";
    flex: 0 0 38px !important;
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 14px;
    background: linear-gradient(135deg, #075e54, #128c7e);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .02em;
    border-radius: 8px 8px 0 0;
    box-shadow: 0 1px 0 rgba(0,0,0,.10);
}

.ticket-history-main .historico-wrap {
    flex: 1 1 0 !important;
    height: 0 !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding: 16px 16px 10px !important;
    border-top: none !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 7px !important;
}

.ticket-history-main .historico-box {
    flex: 0 0 auto !important;
    width: fit-content !important;
    max-width: min(72%, 640px) !important;
    margin: 0 0 3px !important;
    padding: 7px 9px 5px !important;
    border-radius: 8px !important;
    box-shadow: 0 1px 1px rgba(0,0,0,.10) !important;
    border: none !important;
    position: relative !important;
    color: #111827 !important;
    line-height: 1.35 !important;
}

.ticket-history-main .hist-me {
    align-self: flex-end !important;
    background: #d9fdd3 !important;
    color: #111827 !important;
    border-top-right-radius: 2px !important;
}

.ticket-history-main .hist-other {
    align-self: flex-start !important;
    background: #ffffff !important;
    color: #111827 !important;
    border-top-left-radius: 2px !important;
}

.ticket-history-main .hist-me::after {
    content: "";
    position: absolute;
    right: -6px;
    top: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 8px 0 0 8px;
    border-color: #d9fdd3 transparent transparent transparent;
}

.ticket-history-main .hist-other::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 8px 8px 0 0;
    border-color: #ffffff transparent transparent transparent;
}

/* =========================================================
               PAINEL TÍTULO / CHAT
               ========================================================= */
.ticket-panel-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top:20px;
    margin-bottom: 14px;
    color: #0d47a1;
    font-size: .66rem;
    font-weight: 950;
    text-transform: uppercase;
    letter-spacing: .2px;
    flex-shrink: 0;
}

.historico-topo {
    display: flex !important;
    gap: 8px !important;
    margin-bottom: 3px !important;
    font-size: 9px !important;
    line-height: 1.1 !important;
    color: #667781 !important;
    opacity: 1 !important;
}

    .historico-topo span:first-child {
        max-width: 250px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 800;
        color: #075e54 !important;
    }

    .historico-topo span:last-child {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 8.5px !important;
        font-weight: 600 !important;
        margin-left: auto;
        white-space: nowrap;
    }

.historico-texto {
    display: block !important;
    margin-top: 3px !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    color: #111827 !important;
    white-space: pre-wrap !important;
    word-break: break-word !important;
}

/* =========================================================
               FORM CONTROLS
               ========================================================= */
label {
    font-size: 9.5px !important;
    font-weight: 800 !important;
    color: var(--tk-b800) !important;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 3px !important;
    display: block;
}

input, select, textarea {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border: 1.5px solid var(--tk-b200) !important;
    border-radius: 6px !important;
    font-family: 'IBM Plex Sans', sans-serif !important;
    font-size: 10.5px !important;
    color: var(--tk-ink) !important;
    background: #fff !important;
    outline: none !important;
    transition: .13s ease !important;
}

    input:focus, select:focus, textarea:focus {
        border-color: var(--tk-b500) !important;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15) !important;
    }

.grupo {
    margin-bottom: 8px !important;
    min-width: 0;
}

.select-erro {
    border-color: #e53935 !important;
    box-shadow: 0 0 0 3px rgba(229,57,53,.15) !important;
}

.hint {
    font-size: 9px !important;
    color: var(--tk-muted) !important;
    font-weight: 700 !important;
    display: block;
}

.ticket-modern-left .hint {
    font-size: .66rem !important;
    color: #64748b !important;
    margin-top: 6px !important;
}

/* =========================================================
               MENSAGEM / COMPOSER
               ========================================================= */
.ticket-message-textarea {
    min-height: 118px !important;
    max-height: 210px !important;
    resize: vertical !important;
    border-radius: 13px !important;
    padding: 9px 10px !important;
    font-size: .84rem !important;
    line-height: 1.42 !important;
    background: linear-gradient(180deg, #ffffff, #f8fbff) !important;
}

.ticket-composer-tools {
    display: flex;
    align-items: center;
    gap: 5px !important;
    padding-top: 6px !important;
    color: #0d47a1;
    font-weight: 900;
}

.ticket-tool-btn {
    width: 34px !important;
    height: 34px !important;
    border-radius: 8px !important;
    background: var(--tk-b50) !important;
    border: 1px solid var(--tk-b200) !important;
    color: var(--tk-b800) !important;
        font-size: 14px !important;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: .13s ease !important;
}

    .ticket-tool-btn:hover {
        transform: translateY(-1px);
        background: var(--tk-b100) !important;
    }

    .ticket-tool-btn.gravando {
        background: #fee2e2 !important;
        border-color: #fecaca !important;
        color: #991b1b !important;
        animation: pulseRec 1s infinite;
    }

@@keyframes pulseRec {
    0% { box-shadow: 0 0 0 rgba(220,38,38,0); }
    50% { box-shadow: 0 0 0 5px rgba(220,38,38,.20); }
    100% { box-shadow: 0 0 0 rgba(220,38,38,0); }
}

.ticket-message-help {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    margin-top: 6px !important;
    font-size: .66rem !important;
    color: #64748b !important;
    font-weight: 800 !important;
}

.ticket-anexo-box {
    margin-top: 10px !important;
    border-radius: 8px !important;
    border: 1.5px solid var(--tk-b200) !important;
    background: linear-gradient(180deg, #f8fbff, #ffffff) !important;
    padding: 9px !important;
}

/* =========================================================
               BOTÕES
               ========================================================= */
.btn-primary,
.btn-ia,
.btn-voltar,
.btn-tickets-cliente,
.agenda-resolver {
    min-height: 30px !important;
    border-radius: 999px !important;
    font-size: 10.5px !important;
    font-weight: 800 !important;
    box-shadow: none !important;
    transition: .13s ease !important;
    cursor: pointer;
}

.btn-primary,
.btn-ia {
    background: linear-gradient(135deg, var(--tk-b600), var(--tk-b900)) !important;
    color: #fff !important;
    border: none !important;
    width: 100%;
}

.btn-voltar,
.btn-tickets-cliente {
    background: #fff !important;
    color: var(--tk-b700) !important;
    border: 1.5px solid var(--tk-b200) !important;
}

    .btn-primary:hover,
    .btn-ia:hover,
    .btn-voltar:hover,
    .btn-tickets-cliente:hover {
        transform: translateY(-1px) !important;
        box-shadow: var(--tk-shadow-blue) !important;
    }

.btn-ia {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

    .btn-ia:disabled { opacity: .7; cursor: not-allowed; }

.btn-ia-icon { font-size: 16px; }

.btn-ia-spinner {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.35);
    border-top: 2px solid white;
    animation: spin .8s linear infinite;
}

@@keyframes spin { to { transform: rotate(360deg); } }

/* =========================================================
               ÁREA DE ENVIO (esquerda, sticky)
               ========================================================= */
.ticket-send-actions {
    position: sticky !important;
    bottom: 0 !important;
    z-index: 25 !important;
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 8px !important;
    margin: 10px -16px -16px !important;
    padding: 10px 16px 14px !important;
    background: linear-gradient(180deg, rgba(255,255,255,.82), #ffffff 38%) !important;
    border-top: 1px solid #e2e8f0 !important;
    box-shadow: 0 -8px 20px rgba(15, 23, 42, .08) !important;
    backdrop-filter: blur(8px) !important;
}

    .ticket-send-actions .btn-primary {
        border-radius: 12px !important;
        padding: 12px 14px !important;
        font-size: .84rem !important;
        font-weight: 950 !important;
    }

    .ticket-send-actions .btn-ia {
        width: 100% !important;
        min-height: 40px !important;
        margin-top: 0 !important;
        border-radius: 12px !important;
