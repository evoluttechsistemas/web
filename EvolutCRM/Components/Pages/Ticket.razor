    private void AbrirModalCriarCard()
    {
        modalCriarCardUsuario = TicketAtual?.Usuario ?? "NOVO";
        modalCriarCardErro = "";
        mostrarModalCriarCard = true;
    }

    private void FecharModalCriarCard()
    {
        mostrarModalCriarCard = false;
        modalCriarCardErro = "";
    }

    private async Task ConfirmarCriarCard()
    {
        if (criandoCard) return;
        criandoCard = true;
        modalCriarCardErro = "";

        try
        {
            var codCard = await TicketService.CriarCardAPartirDoTicketAsync(
                TicketAtual!.Codigo,
                modalCriarCardUsuario,
                UserState.CurrentCompanyId);

            mostrarModalCriarCard = false;
            Sucesso = true;
            Mensagem = $"✅ Card #{codCard} criado no CRM com sucesso!";

            await Task.Delay(1500);
            Nav.NavigateTo($"/card/{codCard}");
        }
        catch (Exception ex)
        {
            modalCriarCardErro = $"❌ Erro ao criar card: {ex.Message}";
        }
        finally
        {
            criandoCard = false;
        }
    }

}