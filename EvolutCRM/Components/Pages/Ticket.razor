                    <small class="hint">Erros sublinhados automaticamente. Botão direito para sugestões.</small>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">

                    <div class="agenda-box" style="margin-top:0; padding:8px;">
                        <label class="agenda-check">
                            <input type="checkbox" @bind="CriarAgenda" />
                            <span class="agenda-icon" style="width:22px;height:22px;font-size:11px;">📅</span>
                            <span>Criar agenda</span>
                        </label>
                        @if (CriarAgenda)
                        {
                            <div style="margin-top:8px;">
                                <label>Data/Hora</label>
                                <input type="datetime-local" @bind="DataHoraAgenda" />
                                <label class="agenda-check" style="margin-top:6px; font-size:.72rem;">
                                    <input type="checkbox" @bind="NotificarAgenda" />
                                    <span>Notificar quando vencer</span>
                                </label>
                            </div>
                        }
                    </div>

                    <div class="ticket-anexo-box" style="margin-top:0; padding:8px;">
                        <label>Anexo</label>
                        <InputFile OnChange="OnArquivoAnotacaoSelecionado"
                                   accept=".pdf,.txt,.csv,.xml,.json,.jpg,.jpeg,.png,.gif,.webp,.bmp,.doc,.docx,.xls,.xlsx,.zip,.rar,.apk,.pfx,.p12" />
                        <div class="ticket-composer-tools" style="margin-top:6px;">
                            @if (!GravandoTela)
                            {
                                <button type="button" class="ticket-tool-btn" title="Gravar tela" @onclick="IniciarGravacaoTela">🎥</button>
                            }
                            else
                            {
                                <button type="button" class="ticket-tool-btn gravando" title="Parar" @onclick="PararGravacaoTela">⏹</button>
                            }
                            <button class="ticket-tool-btn @(gravandoAudio ? "gravando" : "")" @onclick="AlternarGravacao">
                                @(gravandoAudio ? "⏹" : "🎤")
                            </button>
                            <span style="font-size:.68rem; color:#64748b; font-weight:800;">
                                @(gravandoAudio ? "Gravando..." : GravandoTela ? "Gravando tela..." : "Áudio / Tela")
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(previewAudio))
                        {
                            <div class="audio-mini-container" style="margin-top:6px;">
                                <span class="audio-mini-icon">🎧</span>
                                <audio controls class="audio-mini-player" src="@previewAudio"></audio>
                                <button type="button" class="audio-mini-speed" @onclick="RemoverAudio">Remover</button>
                            </div>
                        }

                        @if (VideoGravado != null)
                        {
                            <div style="margin-top:6px; font-size:10px; color:#0d47a1; font-weight:800;">
                                🎥 @VideoGravadoNome
                                <button type="button" class="btn-voltar"
                                        style="margin-left:6px; padding:2px 8px; font-size:9px;"
                                        @onclick="RemoverVideoGravado">
                                    ✕
                                </button>
                            </div>
                        }

                        @if (ArquivoAnotacao != null)
                        {
                            var ext = Path.GetExtension(NomeArquivoAnotacao).ToLowerInvariant();
                            var ehImagem = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";
                            var ehPdf = ext == ".pdf";
                            var ehTexto = ext is ".txt" or ".csv" or ".xml" or ".json";

                            <div style="margin-top:6px;">
                                <div style="font-size:10px; color:#0d47a1; font-weight:800;">
                                    📎 @NomeArquivoAnotacao
                                    <button type="button" class="btn-voltar"
                                            style="margin-left:6px; padding:2px 8px; font-size:9px;"
                                            @onclick="RemoverArquivoAnotacao">
                                        ✕
                                    </button>
                                </div>
                                @if (ehImagem && !string.IsNullOrEmpty(PreviewArquivoAnotacao))
                                {
                                    <img src="@PreviewArquivoAnotacao"
                                         style="margin-top:6px; max-width:100%; max-height:80px; border-radius:6px; border:1px solid #90caf9;" />
                                }
                            </div>
                        }
                    </div>

                </div>

                <!-- sticky rodapé -->
                <div class="ticket-send-actions">
                    <button class="btn-primary" @onclick="CriarTicket" disabled="@Salvando">
                        ✈ @(Salvando ? "Salvando..." : TipoEnvioCliente == "TODOS_MENSALISTAS" ? "Enviar para todos mensalistas" : "Salvar Ticket")
                    </button>
                    <button class="btn-voltar" @onclick="Voltar">← Voltar</button>
                    @if (!string.IsNullOrEmpty(Mensagem))
                    {
                        <div class="msg @(Sucesso ? "sucesso" : "erro")">@Mensagem</div>
                    }
            </div>

        </aside>

        <!-- DIREITA: sidebar resumo -->
        <aside class="ticket-modern-panel ticket-modern-right">

            <div class="ticket-info-profile">
                <div class="ticket-info-avatar">
                    @((NomeCliente ?? "?").Trim().Length >= 2
                                        ? NomeCliente!.Trim().Substring(0, 2).ToUpper()
                                        : "?")
                </div>
                <div>
                    <div style="font-size:.72rem; color:#64748b; font-weight:800;">Criado por</div>
                    <div style="font-weight:950; color:#0d47a1;">@UserState.CurrentUser</div>
                    <div style="font-size:.72rem; color:#16a34a; font-weight:900;">● Atendente</div>
                </div>
            </div>

                <div class="ticket-info-stats">
                    <div class="ticket-info-stat"><strong>—</strong><span>Tickets hoje</span></div>
                    <div class="ticket-info-stat"><strong>—</strong><span>Em aberto</span></div>
                    <div class="ticket-info-stat"><strong>—</strong><span>Finalizados</span></div>
                </div>



            </aside>

        </div>
    </div>
}
else if (TicketAtual == null)
{
    <div class="titulo">Ticket não encontrado</div>
}
else
{
    var ticketEhWhatsApp = !string.IsNullOrWhiteSpace(TicketAtual.TelefoneWhatsApp);
