    private async Task AtualizarAutomaticamente()
    {
        if (EhNovo) return;

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        try
        {
            while (await _timer.WaitForNextTickAsync())
            {
                if (_atualizando)
                    continue;

                _atualizando = true;

                try { await AtualizarTicket(); }
                finally { _atualizando = false; }
            }
        }
        catch (OperationCanceledException)
        {
            // esperado ao sair
        }
    }

    private async Task AtualizarTicket()
    {
        if (TicketAtual == null || EhNovo)
            return;

        var rotaAtual = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].ToLowerInvariant();
        bool visivelAgora = rotaAtual == $"ticket/{id}";

        // ── Passo 1: query ultra-leve, só 2 números ──────────────────────────
        var resumo = await TicketService.ResumoHistoricoAsync(id);

        bool historicoMudou = resumo.UltimoCodigo != _ultimoCodigoHistorico
                           || resumo.Total != Historico.Count;

        // ── Passo 2: se não mudou nada, para aqui — zero queries adicionais ──
        if (!historicoMudou)
            return;

        // ── Passo 3: só chega aqui quando há mensagem nova ───────────────────
        var novas = await TicketService.BuscarHistoricoNovasAsync(id, _ultimoCodigoHistorico);

        var codigosExistentes = Historico.Select(h => h.Codigo).ToHashSet();
        foreach (var nova in novas.Where(h => !codigosExistentes.Contains(h.Codigo)))
            Historico.Insert(0, nova);

        _ultimoCodigoHistorico = Historico.Count > 0 ? Historico.Max(h => h.Codigo) : 0;

        // ── Passo 4: status do WhatsApp só quando chegou mensagem nova ────────
        var mapaStatus = await TicketService.BuscarStatusWhatsAppAsync(id);
        foreach (var msg in Historico)
        {
            if (mapaStatus.TryGetValue(msg.Codigo, out var st) && st != msg.StatusEnvioWhatsApp)
                msg.StatusEnvioWhatsApp = st;
        }

        // ── Passo 5: re-renderiza, mas só se usuário não está digitando ───────
        var usuarioDigitando = !string.IsNullOrWhiteSpace(NovaAnotacao);

        if (!usuarioDigitando)
        {
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            // Agenda um re-render para depois que ele terminar de digitar
            // O próximo ciclo do timer vai renderizar quando o campo estiver vazio
            // As mensagens já estão na lista, só não renderizou ainda
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000); // espera 2s
                if (!string.IsNullOrWhiteSpace(NovaAnotacao)) return; // ainda digitando, desiste
                await InvokeAsync(StateHasChanged);
            });
        }

        // ── Passo 6: restante do fluxo (ticket atualizado, badge, etc) ────────
        var ticketAtualizado = await TicketService.BuscarChamadoAsync(id);
        if (ticketAtualizado != null && TicketAtual != null)
        {
            if (TicketAtual.AssuntoSugerido != ticketAtualizado.AssuntoSugerido ||
                TicketAtual.SentimentoCliente != ticketAtualizado.SentimentoCliente ||
                TicketAtual.SentimentoEmoji != ticketAtualizado.SentimentoEmoji ||
                TicketAtual.AssuntoSugeridoStatus != ticketAtualizado.AssuntoSugeridoStatus)
            {
                TicketAtual.AssuntoSugerido = ticketAtualizado.AssuntoSugerido;
                TicketAtual.SentimentoCliente = ticketAtualizado.SentimentoCliente;
                TicketAtual.SentimentoEmoji = ticketAtualizado.SentimentoEmoji;
                TicketAtual.AssuntoSugeridoStatus = ticketAtualizado.AssuntoSugeridoStatus;
            }
        }

        if (visivelAgora)
            await TicketService.MarcarComoAbertoAsync(id);

        if (TicketAtual != null)
        {
            var usuariosAutomaticos = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "NOVO", "WHATSAPP", "CLIENTE", "BOT", "SISTEMA" };
            var temResponsavel = !string.IsNullOrWhiteSpace(TicketAtual.Usuario)
                && !usuariosAutomaticos.Contains(TicketAtual.Usuario.Trim());
            if (temResponsavel && visivelAgora)
                TicketAtual.Novo = "N";
        }

        var qtd = await TicketService.GetQuantidadeTicketsNovosAsync(UserState.CurrentUser);
        TicketNotify.SetNovos(qtd);
    }

    private async Task CarregarDados()
    {
        Carregando = true;

        if (id <= 0 && IdQuery.HasValue)
            id = IdQuery.Value;

        Usuarios = (await TicketService.ListarUsuariosAsync())
            .Select(u => u.Trim().ToUpper())
            .Distinct()
            .OrderBy(u => u)
            .ToList();

        if (EhNovo)
        {
            TicketAtual = null;
            Historico.Clear();
            NomeCliente = "";
            NumeroTelefone = "";
            UsuarioSelecionado = "";
            Carregando = false;
            return;
        }

        TicketAtual = await TicketService.BuscarChamadoAsync(id);

        if (TicketAtual != null)
        {
            var usuarioLogado = (UserState.CurrentUser ?? "").Trim().ToUpperInvariant();
            var eraNovo = TicketAtual.Novo == "S";

            // ── Queries independentes em paralelo ──
            var tNome = TicketService.BuscarNomeCliente(TicketAtual.CodCliente);
            var tHistorico = TicketService.BuscarHistoricoAsync(id);
            var tTelefone = TicketService.BuscarTelefoneCliente(TicketAtual.CodCliente);

            await Task.WhenAll(tNome, tHistorico, tTelefone);

            NomeCliente = tNome.Result;
            Historico = tHistorico.Result;
            NumeroTelefone = tTelefone.Result;
            _ultimoCodigoHistorico = Historico.Count > 0 ? Historico.Max(h => h.Codigo) : 0;

            if (eraNovo)
            {
                var usuariosAutomaticos = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "NOVO", "WHATSAPP", "CLIENTE", "BOT", "SISTEMA" };

                var temResponsavel = !string.IsNullOrWhiteSpace(TicketAtual.Usuario)
                    && !usuariosAutomaticos.Contains(TicketAtual.Usuario.Trim());

                bool visivelAgora = false;
                try { visivelAgora = await JS.InvokeAsync<bool>("isPageVisible"); }
                catch { visivelAgora = false; }

                if (temResponsavel && visivelAgora)
                {
                    // ── Marcar lido + contar novos em paralelo ──
                    await Task.WhenAll(
                        TicketService.MarcarComoLidoSuporteAsync(TicketAtual.Codigo, UserState.CurrentUser ?? ""),
                        TicketService.GetQuantidadeTicketsNovosAsync(UserState.CurrentUser)
                            .ContinueWith(t => TicketNotify.SetNovos(t.Result))
                    );

                    TicketAtual.Novo = "N";
                }

                // Fire-and-forget — não bloqueia o carregamento
                if (!string.IsNullOrWhiteSpace(TicketAtual.TelefoneWhatsApp)
                    && TicketAtual.CodInstanciaWhatsApp.HasValue
                    && TicketAtual.CodInstanciaWhatsApp.Value > 0)
                {
                    _ = TicketService.MarcarLidoNoWhatsAppAsync(
                        TicketAtual.Codigo,
                        TicketAtual.CodInstanciaWhatsApp.Value
                    );
                }
            }

            _codSetorOriginal = TicketAtual.CodSetor;
            _codSituacaoOriginal = TicketAtual.CodSituacao;
            _usuarioOriginal = (TicketAtual.Usuario ?? "").Trim();
        }

        Carregando = false;
    }

    private bool DeveGerarIA()
    {
        // Precisa ter ao menos uma mensagem do cliente com conteúdo
        var mensagensCliente = Historico
            .Where(x =>
                x.EnvioCliente == "S" &&
                !string.IsNullOrWhiteSpace(x.Anotacao) &&
                x.MensagemExcluida != "S")
            .ToList();

        if (!mensagensCliente.Any())
            return false;

        // Filtra mensagens de atendente (não do cliente e não automáticas)
        var usuariosAutomaticos = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "WHATSAPP", "CLIENTE", "IA", "EVOLUTTECH", "BOT", "SISTEMA", "NOVO"
    };

        var mensagensAtendente = Historico
            .Where(x =>
                x.EnvioCliente != "S" &&
                !string.IsNullOrWhiteSpace(x.Anotacao) &&
                x.MensagemExcluida != "S" &&
                !usuariosAutomaticos.Contains((x.Usuario ?? "").Trim().ToUpper()) &&
                x.StatusEnvioWhatsApp is not ("saudacao_auto" or "aguarde_auto" or "ia_processing"))
            .ToList();

        // Se JÁ existe resposta de atendente humano → não gera IA novamente
        if (mensagensAtendente.Any())
            return false;

        // Saudação simples sozinha não merece sugestão
        if (mensagensCliente.Count == 1)
        {
            var texto = mensagensCliente[0].Anotacao.Trim().ToLower();

            var saudacoes = new[]
            {
            "oi", "olá", "ola", "bom dia", "boa tarde", "boa noite", "tudo bem"
        };

            if (saudacoes.Contains(texto))
                return false;
        }

        return true;
    }

