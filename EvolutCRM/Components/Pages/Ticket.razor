                        }

                        <button class="btn-ia" @onclick="GerarRespostaIA" disabled="@CarregandoIA">
                            <span class="btn-ia-icon">🤖</span>

                            @if (CarregandoIA)
                            {
                                <span class="btn-ia-spinner"></span>
                                <span>Gerando resposta...</span>
                            }
                            else
                            {
                                <span>Gerar resposta IA</span>
                            }
                        </button>

                        <div class="grupo">
                            <label>Pesquisar documentação</label>

                            <input class="ticket-doc-search"
                                   @bind="BuscaDoc"
                                   @bind:event="oninput"
                                   @bind:after="BuscarDocumentacoes"
                                   placeholder="Ex.: entrada xml, estoque, pdv, fornecedor..." />

                            @if (BuscandoDocs)
                            {
                                <small class="hint">Buscando documentações...</small>
                            }

                            @if (DocsEncontradas.Any())
                            {
                                <div class="ticket-doc-results">
                                    @foreach (var doc in DocsEncontradas)
                                    {
                                        <div class="ticket-doc-card">
                                            <a href="@doc.Url" target="_blank">🔗 @doc.Title</a>
                                            <div class="ticket-doc-preview">@doc.Preview</div>
                                            <button type="button"
                                                    class="btn-inserir-doc"
                                                    @onclick="() => InserirUrlDocNaMensagem(doc)">
                                                📎 Inserir na mensagem
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="msg erro">
                            Você pode visualizar este ticket, mas não tem permissão para responder ou alterar.
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_aiErro))
                    {
                        <div class="msg erro">@_aiErro</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(SugestaoIA))
                    {
                        <div class="msg sucesso">
                            ✅ Resposta gerada pela IA e inserida no campo de mensagem.
                        </div>
                    }

                    @if (_insight != null)
                    {
                        <div class="msg sucesso" style="white-space:pre-wrap; text-align:left;">
                            <b>Resumo:</b> @_insight.resumo<br />
                            <b>Categoria:</b> @_insight.categoria<br />
                            <b>Intenção:</b> @_insight.intencao<br />
                            <b>Gravidade:</b> @_insight.gravidade<br />
                            <b>Tags:</b> @string.Join("; ", _insight.tags ?? new List<string>())<br />
                            <b>Solução:</b><br />@_insight.solucao
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Mensagem))
                    {
                        <div class="msg @(Sucesso ? "sucesso" : "erro")">
                            @Mensagem
                        </div>
                    }
                </div>
            </aside>

            <!-- CENTRO: HISTÓRICO PRINCIPAL -->
            <main class="ticket-modern-panel ticket-modern-center ticket-history-main">


                <div class="historico-wrap">
                    @foreach (var h in Historico)
                    {
                        var souEu = MesmoUsuario(h.Usuario, UserState.CurrentUser);
                        var editandoEstaMensagem = CodigoMensagemEditando == h.Codigo;
                        var temTexto = !string.IsNullOrWhiteSpace(h.Anotacao);
                        var temImagem = !string.IsNullOrWhiteSpace(h.CaminhoImagem) || !string.IsNullOrWhiteSpace(h.NomeImagem);
                        var temAudio = !string.IsNullOrWhiteSpace(h.AudioUrl);

                        var podeEditarMensagem =
                        souEu &&
                        h.EnvioCliente != "S" &&
                        h.MensagemExcluida != "S" &&
                        temTexto &&
                        !temAudio;

                        var podeExcluirMensagem =
                        souEu &&
                        h.EnvioCliente != "S" &&
                        h.MensagemExcluida != "S";

                        bool mensagemCliente =
                        (h.EnvioCliente ?? "N")
                        .Trim()
                        .Equals("S", StringComparison.OrdinalIgnoreCase);

                        souEu = !mensagemCliente;

                        <div class="historico-box @(souEu ? "hist-me" : "hist-other") @(h.Interno == "S" ? "hist-interno" : "")"
                             id="msg-@h.Codigo" @key="h.Codigo">

                            @if (h.Interno == "S")
                            {
                                <div class="hist-interno-label">🔒 Interno</div>
                            }

                            @if (h.CodMensagemRespondida.HasValue && !string.IsNullOrWhiteSpace(h.TextoMensagemRespondida))
                            {
                                <div class="historico-quote" @onclick="() => RolarParaMensagem(h.CodMensagemRespondida.Value)">
                                    <div class="historico-quote-usuario">@h.UsuarioMensagemRespondida</div>
                                    <div class="historico-quote-texto">@h.TextoMensagemRespondida</div>
                                </div>
                            }
                            <div class="historico-topo">
                                <span>@h.Usuario</span>
                                <span>@h.DataHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            @if (h.MensagemExcluida == "S")
                            {
                                <span class="historico-texto" style="font-style:italic; opacity:.75;">
                                    🗑️ Mensagem excluída
                                </span>
                            }
                            else
                            {
                                @if (editandoEstaMensagem)
                                {
                                    <textarea class="edit-msg-textarea" @bind="TextoMensagemEditando"></textarea>

                                    <div class="edit-msg-actions">
                                        <button type="button" class="btn-salvar-edit-msg" @onclick="SalvarEdicaoMensagem">
                                            💾 Salvar
                                        </button>

                                        <button type="button" class="btn-cancelar-edit-msg" @onclick="CancelarEdicaoMensagem">
                                            Cancelar
                                        </button>
                                        <button type="button"
                                                class="btn-msg-action"
                                                @onclick="() => IniciarResposta(h)">
                                            ↩ Responder
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(h.Anotacao))
                                    {
                                        <span class="historico-texto">
                                            @foreach (var parte in SepararUrlsDoTexto(h.Anotacao))
                                            {
                                                if (parte.StartsWith("http://") || parte.StartsWith("https://"))
                                                {
                                                    <a href="@parte" target="_blank"
                                                       style="color:#2563eb; text-decoration:underline; word-break:break-all;">@parte</a>
                                                }
                                                else
                                                {
                                                    @parte
                                                }
                                            }
                                        </span>
                                    }

                                    @if (h.Alterado == "S")
                                    {
                                        <div class="msg-editada-label">✏️ editada</div>
                                    }
                                }

                                @if ((podeEditarMensagem && !editandoEstaMensagem) || podeExcluirMensagem)
                                {
                                    <div class="msg-actions">
                                        @if (podeEditarMensagem && !editandoEstaMensagem)
                                        {
                                            <button type="button"
                                                    class="btn-msg-action"
                                                    @onclick="() => IniciarEdicaoMensagem(h.Codigo, h.Anotacao)">
                                                ✏️ Editar
                                            </button>
                                        }
                                        @if (podeExcluirMensagem)
                                        {
                                            <button type="button"
                                                    class="btn-msg-action"
                                                    @onclick="() => ExcluirMensagem(h.Codigo)">
                                                🗑️ Excluir
                                            </button>
                                        }
                                        <button type="button"
                                                class="btn-msg-action"
                                                @onclick="() => IniciarResposta(h)">
                                            ↩ Responder
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="msg-actions">
                                        <button type="button"
                                                class="btn-msg-action"
                                                @onclick="() => IniciarResposta(h)">
                                            ↩ Responder
                                        </button>
                                    </div>
                                }
                            }

                            @* VÍDEO — bloco independente, fora do if de imagem *@
                            @if (!string.IsNullOrWhiteSpace(h.VideoUrl))
                            {
                                <div class="video-message-box">
                                    <video controls class="video-message-player">
                                        <source src="@h.VideoUrl" type="@(h.VideoMimeType ?? "video/mp4")" />
                                        Seu navegador não suporta vídeo.
                                    </video>
                                    <div class="video-message-name">
                                        🎥 @h.VideoFileName
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(h.StatusEnvioWhatsApp) && h.EnvioCliente != "S")
                            {
                                <div class="msg-status-whats">
                                    @{
                                        var statusWhats = (h.StatusEnvioWhatsApp ?? "").Trim().ToLower();
                                    }

                                    @switch (statusWhats)
                                    {
                                        case "":
                                        case "sending":
                                        case "pending":
                                            <span style="color:#fef3c7;">🕓 Enviando...</span>
                                            break;
                                        case "sent":
                                            <span style="color:#ffffff;">✓ Enviado</span>
                                            break;
                                        case "received":
                                        case "delivered":
                                        case "delivery_ack":
                                        case "delivered2user":
                                            <span style="color:#ffffff;">✓✓ Entregue</span>
                                            break;
                                        case "read":
                                        case "read_ack":
                                            <span style="color:#90caf9;">✓✓ Lido</span>
                                            break;
                                        case "error":
                                        case "failed":
                                            <span style="color:#ffb4b4;">⚠ Erro</span>
                                            break;
                                        default:
                                            <span style="color:#fef3c7;">🕓 Enviando...</span>
                                            break;
                                    }
                                </div>
                            }

                            @if (h.NovaAgenda == "S")
                            {
                                var agendaVencida = h.AgendaResolvida != "S"
                                && h.DataHoraAgenda.HasValue
                                && h.DataHoraAgenda.Value <= DateTime.Now;

                                <div class="agenda-card @(agendaVencida ? "vencida" : "futura")">
                                    <div class="agenda-title">
                                        <span>@(agendaVencida ? "⏰ Agenda vencida" : "📅 Agenda")</span>
                                        <span class="agenda-badge">
                                            @(h.AgendaResolvida == "S" ? "Resolvida" : "Pendente")
                                        </span>
                                    </div>

                                    <div>Prazo: @(h.DataHoraAgenda?.ToString("dd/MM/yyyy HH:mm") ?? "Sem data")</div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(h.CaminhoImagem))
                            {
                                var nomeArquivo = !string.IsNullOrWhiteSpace(h.NomeImagem) ? h.NomeImagem : h.CaminhoImagem;
                                var ext = Path.GetExtension(nomeArquivo ?? "").ToLowerInvariant();
                                var ehImagem = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";
                                var ehPdf = ext == ".pdf";

                                <div style="margin-top:10px;">
                                    @if (ehImagem)
                                    {
                                        <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:10px;">
                                            <div style="font-weight:800; color:#0d47a1; margin-bottom:8px;">
                                                🖼️ @(h.NomeImagem ?? "imagem-whatsapp.jpg")
                                            </div>

                                            <img src="@h.CaminhoImagem"
                                                 class="thumb"
                                                 style="width:auto; max-width:220px; max-height:220px; object-fit:cover; background:#f8fafc; cursor:zoom-in; display:block; margin:auto; border-radius:10px; border:2px solid #90caf9;"
                                                 @onclick="() => AbrirImagem(h.CaminhoImagem)" />

                                            <a href="@h.CaminhoImagem"
                                               target="_blank"
                                               download="@(h.NomeImagem ?? "imagem-whatsapp.jpg")"
                                               class="btn-voltar"
                                               style="display:block; text-align:center; text-decoration:none;">
                                                Baixar imagem
                                            </a>
                                        </div>
                                    }
                                    else if (ehPdf)
                                    {
                                        <div style="
                                                                            background:#fff;
                                                                            border:1px solid #cbd5e1;
                                                                            border-radius:10px;
                                                                            padding:10px 12px;
                                                                            max-width:280px;">

                                            <div style="display:flex; align-items:center; gap:10px; cursor:pointer;"
                                                 onclick="window.open('@h.CaminhoImagem', '_blank')">

                                                <div style="
                                                                                    width:42px;
                                                                                    height:48px;
                                                                                    flex-shrink:0;
                                                                                    background:#e8f0fe;
                                                                                    border-radius:6px;
                                                                                    border:1.5px solid #c5d5f5;
                                                                                    display:flex;
                                                                                    flex-direction:column;
                                                                                    align-items:center;
                                                                                    justify-content:center;
                                                                                    gap:2px;">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                                                              stroke="#1a56db" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                                              fill="#dbeafe" />
                                                        <polyline points="14 2 14 8 20 8"
                                                                  stroke="#1a56db" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                                    </svg>
                                                    <span style="font-size:7px; font-weight:900; color:#1a56db; letter-spacing:.04em;">PDF</span>
                                                </div>

                                                <div style="min-width:0; flex:1;">
                                                    <div style="
                                                                                        font-size:12px;
                                                                                        font-weight:700;
                                                                                        color:#0f172a;
                                                                                        white-space:nowrap;
                                                                                        overflow:hidden;
                                                                                        text-overflow:ellipsis;
                                                                                        max-width:180px;">
                                                        @(h.NomeImagem ?? "arquivo.pdf")
                                                    </div>
                                                    <div style="font-size:10px; color:#64748b; margin-top:2px; font-weight:600;">
                                                        PDF · Toque para abrir
                                                    </div>
                                                </div>

                                            </div>

                                            <div style="display:flex; gap:8px; margin-top:10px; border-top:1px solid #f1f5f9; padding-top:8px;">
                                                <a href="@h.CaminhoImagem"
                                                   target="_blank"
                                                   style="
                                                                                    flex:1;
                                                                                    text-align:center;
                                                                                    font-size:10px;
                                                                                    font-weight:800;
                                                                                    color:#1a56db;
                                                                                    text-decoration:none;
                                                                                    padding:5px 0;
                                                                                    border-radius:6px;
                                                                                    background:#eff6ff;
                                                                                    border:1px solid #bfdbfe;">
                                                    🔍 Abrir
                                                </a>
                                                <a href="@h.CaminhoImagem"
                                                   download="@(h.NomeImagem ?? "arquivo.pdf")"
                                                   style="
                                                                                    flex:1;
                                                                                    text-align:center;
                                                                                    font-size:10px;
                                                                                    font-weight:800;
                                                                                    color:#16a34a;
                                                                                    text-decoration:none;
                                                                                    padding:5px 0;
                                                                                    border-radius:6px;
                                                                                    background:#f0fdf4;
                                                                                    border:1px solid #bbf7d0;">
                                                    ⬇ Baixar
                                                </a>
                                            </div>

                                        </div>
                                    }

                                    else
                                    {
                                        var ehTexto = ext is ".txt" or ".csv" or ".xml" or ".json";

                                        @if (ehTexto)
                                        {
                                            <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; overflow:hidden;">
                                                <div style="padding:8px 12px; font-weight:700; color:#0d47a1; border-bottom:1px solid #e2e8f0;">
                                                    📄 @(h.NomeImagem ?? "arquivo")
                                                </div>

                                                <iframe src="@h.CaminhoImagem"
                                                        style="width:100%; height:320px; border:none; background:white;">
                                                </iframe>

                                                <div style="padding:10px;">
                                                    <a href="@h.CaminhoImagem" target="_blank" class="btn-voltar">
                                                        Abrir em nova aba
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="background:#fff; border:1px solid #cbd5e1; border-radius:10px; padding:12px;">
                                                <strong style="color:#0d47a1;">📎 @(h.NomeImagem ?? "arquivo")</strong>
                                                <div style="font-size:13px; color:#455a64; margin-top:6px;">
                                                    Este tipo de arquivo não pode ser visualizado diretamente pelo navegador.
                                                </div>

                                                <a href="@h.CaminhoImagem" target="_blank" class="btn-voltar">
                                                    Abrir / Baixar arquivo
                                                </a>
                                            </div>
                                        }
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(h.CaminhoImagem))
                            {
                                @* bloco de imagem/PDF/documento — SEM o áudio aqui dentro *@
                                var nomeArquivo = h.NomeImagem ?? "";
                                var ext = Path.GetExtension(nomeArquivo).ToLowerInvariant();
                                var ehPdf = ext == ".pdf";
                                var ehImagem = ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp";

                                @if (ehPdf)
                                {
                                    @* card PDF *@
                                }
                                else if (ehImagem)
                                {
                                    @* imagem *@
                                }
                                else if (!string.IsNullOrWhiteSpace(nomeArquivo))
                                {
                                    @* outro documento *@
                                }
                            }


                            @* ÁUDIO — bloco independente, apenas aqui, não repetir em nenhum outro lugar *@
                            @if (!string.IsNullOrWhiteSpace(h.AudioUrl))
                            {
                                <div class="audio-mini-container">
                                    <audio controls
                                           class="audio-mini-player"
                                           onloadedmetadata="window.aplicarVelocidadeAudio(this)">
                                        <source src="@h.AudioUrl"
                                                type="@(h.AudioMimeType ?? "audio/mpeg")" />
                                    </audio>
                                    <button type="button"
                                            class="audio-mini-speed"
                                            @onclick="AlterarVelocidadeAudioGlobal">
                                        @($"{VelocidadeAudioGlobal:0.#}x")
                                    </button>
                                </div>

                                @* Transcrição do áudio *@
                                @if (!string.IsNullOrWhiteSpace(h.TranscricaoAudio))
                                {
                                    var ehErro = h.TranscricaoAudio.StartsWith("[ERRO:");
                                    <div style="
                                                                        margin-top: 5px;
                                                                        padding: 6px 10px;
                                                                        background: @(ehErro ? "rgba(220,38,38,.07)" : "rgba(0,0,0,.05)");
                                                                        border-radius: 8px;
                                                                        border-left: 3px solid @(ehErro ? "#dc2626" : "#25d366");
                                                                        font-size: 10.5px;
                                                                        color: @(ehErro ? "#7f1d1d" : "#374151");
                                                                        line-height: 1.45;
                                                                        font-style: italic;">
                                        @(ehErro ? "⚠️" : "🗒️")
                                        <strong style="font-style:normal; font-size:9.5px; text-transform:uppercase; letter-spacing:.04em;">
                                            @(ehErro ? "Erro na transcrição" : "Transcrição")
                                        </strong><br />
                                        @(ehErro ? "" : h.TranscricaoAudio)
                                    </div>
                                }
                                else if (h.AudioTranscrito != "S" && h.EnvioCliente == "S"
                                && h.StatusEnvioWhatsApp != "transcricao_erro")
                                {
                                    <div style="margin-top:4px; font-size:9.5px; color:#94a3b8; font-style:italic;">
                                        ⏳ Transcrevendo áudio...
                                    </div>
                                }
                            }
                        </div>
                    }
            </div>
        </main>

        <!-- DIREITA: INFORMAÇÕES FIXAS DO TICKET -->
        <!-- DIREITA: sidebar resumo -->
        <!-- DIREITA: INFORMAÇÕES FIXAS DO TICKET -->
        <aside class="ticket-modern-panel ticket-modern-right">

            <div class="ticket-info-profile">
                    @if (!string.IsNullOrWhiteSpace(TicketAtual.FotoClienteUrl))
                    {
                        <img class="ticket-info-avatar-img"
                             src="@TicketAtual.FotoClienteUrl"
                             alt="Foto do cliente" />
                    }
                    else
                    {
                        <div class="ticket-info-avatar-fallback">
                            @ObterIniciaisCliente(NomeCliente)
                        </div>
                    }
                <div style="min-width:0;">
                    <div style="font-size:.72rem; color:#64748b; font-weight:800;">Cliente</div>
                    <div style="font-weight:950; color:#0d47a1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        @TicketAtual.CodCliente - @NomeCliente
                    </div>
                </div>
            </div>

                <!-- CLIENTE (alterar) -->
                <div class="ticket-info-row">
                    <label>Cliente</label>
                @if (!AlterandoCliente)
                    {
                        <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                            <span class="ticket-info-value">@NomeCliente</span>
                            <button type="button" class="btn-editar-cliente" @onclick="IniciarAlteracaoCliente">✎ Alterar</button>
                        </div>
                    }
                    else
                    {
                        <div style="min-width:0;">
                            <input @bind="ClienteBusca"
                                   @bind:event="oninput"
                                   @bind:after="BuscarClientes"
                                   placeholder="Código ou nome..." />
                            <div class="cliente-autocomplete-wrapper">
                                @if (Sugestoes?.Any() == true)
                                {
                                    <ul class="autocomplete-list">
                                        @foreach (var cli in Sugestoes)
                                        {
                                            <li @onclick="async () => await SelecionarCliente(cli)">
                                                <strong>@cli.Codigo</strong> - @cli.Nome
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            <button type="button" class="btn-editar-cliente" style="margin-top:4px;"
                                    @onclick="CancelarAlteracaoCliente">
                                Cancelar
                            </button>
                        </div>
                    }
                </div>

                <!-- TELEFONE + WHATSAPP -->
                <div class="ticket-info-row">
                    <label>Telefone</label>
                    <div style="display:flex; align-items:center; gap:6px; min-width:0;">
                        <span class="ticket-info-value">@(string.IsNullOrWhiteSpace(NumeroTelefone) ? "—" : NumeroTelefone)</span>
                        <button type="button" class="whats-btn" title="Abrir WhatsApp" @onclick="AbrirWhatsApp">
                            <i class="fa-brands fa-whatsapp" style="color:#fff; font-size:15px;"></i>
                        </button>
                    </div>
                </div>

                <!-- ASSUNTO -->
                <div class="ticket-info-row">
                    <label>Assunto</label>
                    <input @bind="TicketAtual.Assunto" />
                </div>

                <!-- RESPONSÁVEL -->
                <div class="ticket-info-row">
                    <label>Responsável</label>
                    <select @bind="TicketAtual.Usuario" class="@(ResponsavelInvalido ? "select-erro" : "")">
                        <option value="">Selecione...</option>
                        @foreach (var u in Usuarios)
                        {
                            <option value="@u">@u</option>
                        }
                    </select>
                </div>

                <!-- SETOR -->
                <div class="ticket-info-row">
                    <label>Setor</label>
                    <select value="@TicketAtual.CodSetor" @onchange="OnSetorTicketChanged">
                        @foreach (var setor in SetoresTicket)
                        {
                            <option value="@setor.Codigo">@setor.Descricao</option>
                        }
                    </select>
                </div>

                <!-- SITUAÇÃO -->
                <div class="ticket-info-row">
                    <label>Situação</label>
                    <select value="@TicketAtual.CodSituacao"
                            @onchange="OnSituacaoTicketChanged"
                            disabled="@(!PodeAlterarStatusTicket)">
                        @foreach (var situacao in SituacoesTicket)
                        {
                            <option value="@situacao.Codigo">@situacao.Descricao</option>
                        }
                    </select>
