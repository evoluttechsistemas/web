                        <span class="btn-acesso-remoto-icon">▶</span>
                        <span>Acesso remoto</span>
                    </button>

                    <button type="button"
                            class="btn-tickets-cliente"
                            @onclick="AbrirModalTicketsCliente">
                        📁 Tickets do cliente
                    </button>


                </div>

                <div class="ticket-kpi-card">
                    <small>Tempo aberto</small>
                    <strong>@TempoEmAtendimentoTexto</strong>
                </div>

                <div class="ticket-kpi-card">
                    <small>Resp. média</small>
                    <strong>@TempoMedioRespostaTexto</strong>
                </div>

                @if (VisualizadoresTicket.Any())
                {
                    <div class="ticket-viewers">



                        @foreach (var usuario in VisualizadoresTicket)
