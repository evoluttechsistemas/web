<div class="ct-root">

    <header class="ct-topbar">
        <div class="ct-topbar-inner">
            <a class="ct-brand" href="/curso-tutorial/@codEmpAtual">
                <img src="/images/logo-evoluttech.png" alt="EvolutTech" class="ct-logo" />
                <div class="ct-brand-divider"></div>
                <span class="ct-brand-label">Central de ajuda</span>
            </a>
            <div class="ct-search-wrap">
                <span class="ct-search-ico">🔍</span>
                <input class="ct-search" placeholder="Buscar tutoriais..."
                       value="@buscaGlobal" @oninput="OnBuscaInput" />
            </div>
            <div class="ct-topbar-right">
                <div class="ct-mode-tabs">
                    <button class="ct-mode-tab @(modoVisualizacao == "catalogo" ? "active" : "")"
                            @onclick='() => AlterarModo("catalogo")'>
                        ⊞ <span>Todos</span>
                    </button>
                    <button class="ct-mode-tab @(modoVisualizacao == "curso" ? "active" : "")"
                            @onclick='() => AlterarModo("curso")'>
                        ▶ <span>Curso</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    @if (carregando)
    {
        <div class="ct-loading">
            <div class="ct-spinner"></div>
            <span class="ct-loading-text">Carregando tutoriais...</span>
        </div>
    }
    else if (!todosOsTutoriais.Any())
    {
        <div style="max-width:520px;margin:100px auto;text-align:center;padding:0 24px;">
            <div style="font-size:3.5rem;margin-bottom:16px;">📚</div>
            <div style="font-size:20px;font-weight:800;color:#0a0f1e;margin-bottom:8px;">Nenhum tutorial disponível</div>
            <div style="font-size:14px;color:#64748b;line-height:1.6;">Os tutoriais aparecerão aqui assim que forem publicados.</div>
        </div>
    }
    else if (modoVisualizacao == "catalogo" || !string.IsNullOrWhiteSpace(buscaGlobal))
    {
        @if (string.IsNullOrWhiteSpace(buscaGlobal))
        {
            <div class="ct-hero">
                <div class="ct-hero-content">
                    <div class="ct-hero-badge">📚 Base de conhecimento</div>
                    <h1 class="ct-hero-title">Central de <span>Ajuda</span></h1>
                    <p class="ct-hero-sub">Tutoriais completos para você aproveitar ao máximo o sistema.</p>
                    <div class="ct-hero-stats">
                        <div class="ct-hero-stat"><strong>@todosOsTutoriais.Count</strong><span>Tutoriais</span></div>
                        <div class="ct-hero-stat"><strong>@categorias.Count</strong><span>Categorias</span></div>
                        <div class="ct-hero-stat"><strong>100%</strong><span>Gratuito</span></div>
                    </div>
                </div>
            </div>
        }

        <div class="ct-catalog">
            <div class="ct-cat-toolbar">
                <div class="ct-cat-count">
                    @if (!string.IsNullOrWhiteSpace(buscaGlobal))
                    {
                        <span><strong>@TutoriaisFiltrados.Count()</strong> resultado(s) para "@buscaGlobal"</span>
                    }
                    else
                    {
                        <span><strong>@TutoriaisFiltrados.Count()</strong> tutorial(is)@(!string.IsNullOrWhiteSpace(categoriaAtiva) ? $" em {categoriaAtiva}" : "")</span>
                    }
                </div>
                @if (categorias.Count > 0 && string.IsNullOrWhiteSpace(buscaGlobal))
                {
                    <div class="ct-filters">
                        <button class="ct-filter @(categoriaAtiva == "" ? "active" : "")" @onclick='() => categoriaAtiva = ""'>Todos</button>
                        @foreach (var cat in categorias)
                        {
                            var c = cat;
                            <button class="ct-filter @(categoriaAtiva == c ? "active" : "")" @onclick="() => categoriaAtiva = c">@c</button>
                        }
                    </div>
                }
            </div>

            <div class="ct-grid">
                @if (!TutoriaisFiltrados.Any())
                {
                    <div class="ct-empty">
                        <span class="ct-empty-icon">🔍</span>
                        <div class="ct-empty-title">Nenhum resultado encontrado</div>
                        <div class="ct-empty-sub">Tente buscar por outro termo ou explore as categorias.</div>
                    </div>
                }
                else
                {
                    @foreach (var doc in TutoriaisFiltrados)
                    {
                        var d = doc;
                        <div class="ct-card" @onclick="() => AbrirTutorial(d)">
                            <div class="ct-card-img">
                                @if (d.Thumbnail != null)
                                {
                                    <img src="/api/thumbnail/@d.Codigo" alt="@d.Titulo" />
                                }
                                else
                                {
                                    <span>@ObterInicial(d.Titulo)</span>
                                }
                                <div class="ct-card-img-overlay"></div>
                                @if (!string.IsNullOrWhiteSpace(d.Categoria))
                                {
                                    <div class="ct-card-cat-badge">@d.Categoria</div>
                                }
                            </div>
                            <div class="ct-card-body">
                                <div class="ct-card-title">@d.Titulo</div>
                                @if (!string.IsNullOrWhiteSpace(d.Descricao))
                                {
                                    <div class="ct-card-desc">@d.Descricao</div>
                                }
                                <div class="ct-card-footer">
                                    <span class="ct-card-date">@d.DataHoraAlteracao.ToString("dd/MM/yyyy")</span>
                                    <span class="ct-card-arrow">→</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <div class="ct-course">
            <aside class="ct-sidebar">
                <div class="ct-sidebar-head">
                    <div class="ct-sidebar-eyebrow">Curso</div>
                    <div class="ct-sidebar-course-name">@TituloCurso</div>
                </div>
                <div class="ct-prog-wrap">
                    <div class="ct-prog-top">
                        <span class="ct-prog-label">@(indiceAtual + 1) de @tutoriaisCurso.Count aulas</span>
                        <span class="ct-prog-pct">@Progresso%</span>
                    </div>
                    <div class="ct-prog-track">
                        <div class="ct-prog-fill" style="width:@Progresso%"></div>
                    </div>
                </div>
                <div class="ct-lesson-list">
                    @for (var i = 0; i < tutoriaisCurso.Count; i++)
                    {
                        var item = tutoriaisCurso[i];
                        var idx = i;
                        <button type="button" class="ct-lesson-btn @(idx == indiceAtual ? "active" : "")"
                                @onclick="() => Selecionar(idx)">
                            <span class="ct-lesson-idx">@(idx + 1)</span>
                            <span class="ct-lesson-thumb-mini">
                                @if (item.Thumbnail != null)
                                {
                                    <img src="/api/thumbnail/@item.Codigo" alt="" />
                                }
                                else
                                {

                                    @ObterInicial(item.Titulo)
                                }
                            </span>
                            <span class="ct-lesson-info">
                                <span class="ct-lesson-name">@item.Titulo</span>
                            </span>
                        </button>
                    }
                </div>
            </aside>

            <main>
                @if (Atual != null)
                {
                    <article class="ct-article">
                        <div class="ct-read-progress">
                            <div class="ct-read-fill" id="ct-read-fill"></div>
                        </div>
                        <div class="ct-cover">
                            @if (Atual.Thumbnail != null)
                            {
                                <img src="/api/thumbnail/@Atual.Codigo" alt="@Atual.Titulo" />
                            }
                            else
                            {

                                <span>@ObterInicial(Atual.Titulo)</span>
                            }
                            <div class="ct-cover-overlay"></div>
                            <div class="ct-cover-info">
                                @if (!string.IsNullOrWhiteSpace(Atual.Categoria))
                                {
                                    <div class="ct-cover-kicker">@Atual.Categoria</div>
                                }
                                <div class="ct-cover-title">@Atual.Titulo</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Atual.Descricao))
                        {
                            <div class="ct-article-header">
                                <p class="ct-article-desc">@Atual.Descricao</p>
                                <div class="ct-meta-row">
                                    <span class="ct-meta-tag">📅 @Atual.DataHoraAlteracao.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span class="ct-meta-tag">📖 Aula @(indiceAtual + 1) de @tutoriaisCurso.Count</span>
                                </div>
                            </div>
                        }
                        <div class="ct-article-body">
                            @foreach (var bloco in Atual.Blocos.OrderBy(x => x.Ordem))
                            {
                                @if (!string.IsNullOrWhiteSpace(bloco.Conteudo))
                                {
                                    <div class="ct-rich">
                                        @((MarkupString)PrepararHtmlSeguro(bloco.Conteudo))
                                    </div>
                                }
                            }
                        </div>
                        <div class="ct-article-footer">
                            <button type="button" class="ct-nav-btn" disabled="@(indiceAtual == 0)" @onclick="Anterior">← Anterior</button>
                            <div class="ct-nav-center">
                                <div class="ct-nav-progress">@(indiceAtual + 1) / @tutoriaisCurso.Count</div>
                                <div class="ct-nav-sub">@Progresso% concluído</div>
                            </div>
                            <button type="button" class="ct-nav-btn primary next" disabled="@(indiceAtual >= tutoriaisCurso.Count - 1)" @onclick="Proximo">Próxima aula →</button>
                        </div>
                    </article>
                }
            </main>
        </div>
    }
</div>

<script>
    (function() {
        function updateReadProgress() {
            var fill = document.getElementById('ct-read-fill');
            if (!fill) return;
            var body = document.querySelector('.ct-article-body');
            if (!body) { fill.style.width = '0%'; return; }
            var rect = body.getBoundingClientRect();
            var total = body.offsetHeight;
            var visible = Math.max(0, window.innerHeight - rect.top);
            var pct = Math.min(100, Math.round((visible / total) * 100));
            fill.style.width = pct + '%';
        }
        window.addEventListener('scroll', updateReadProgress, { passive: true });
        updateReadProgress();
    })();
</script>

@code {
    [Parameter] public int? CodEmp { get; set; }
    [Parameter] public string? Slug { get; set; }

    private List<DocumentacaoTutorialModel> todosOsTutoriais = new();
    private List<DocumentacaoTutorialModel> tutoriaisCurso = new();
    private int indiceAtual;
    private bool carregando = true;
    private int codEmpAtual;
    private string modoVisualizacao = "catalogo";
    private string buscaGlobal = "";
    private string categoriaAtiva = "";
    private List<string> categorias = new();

    private DocumentacaoTutorialModel? Atual =>
        tutoriaisCurso.Count > 0
            ? tutoriaisCurso[Math.Clamp(indiceAtual, 0, tutoriaisCurso.Count - 1)]
            : null;

    private string TituloCurso =>
        tutoriaisCurso.FirstOrDefault()?.Categoria is { Length: > 0 } cat ? cat : "Tutoriais";

    private int Progresso =>
        tutoriaisCurso.Count == 0 ? 0
        : (int)Math.Round(((indiceAtual + 1) / (double)tutoriaisCurso.Count) * 100);

    private IEnumerable<DocumentacaoTutorialModel> TutoriaisFiltrados =>
        todosOsTutoriais.Where(x =>
            (string.IsNullOrWhiteSpace(categoriaAtiva) || x.Categoria == categoriaAtiva) &&
            (string.IsNullOrWhiteSpace(buscaGlobal) ||
             x.Titulo.Contains(buscaGlobal, StringComparison.OrdinalIgnoreCase) ||
             x.Descricao.Contains(buscaGlobal, StringComparison.OrdinalIgnoreCase) ||
             x.Categoria.Contains(buscaGlobal, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        codEmpAtual = CodEmp.GetValueOrDefault() > 0
            ? CodEmp.Value
            : UserState.CurrentCompanyId;

        todosOsTutoriais = await DocumentacaoService.ListarAsync(codEmpAtual, somentePublicados: true);

        categorias = todosOsTutoriais
            .Select(x => x.Categoria)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        if (!string.IsNullOrWhiteSpace(Slug))
        {
            var encontrado = todosOsTutoriais.FirstOrDefault(x =>
                x.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase));

            if (encontrado != null)
            {
                var categoria = encontrado.Categoria;
                tutoriaisCurso = !string.IsNullOrWhiteSpace(categoria)
                    ? todosOsTutoriais.Where(x =>
                        x.Categoria.Equals(categoria, StringComparison.OrdinalIgnoreCase)).ToList()
                    : todosOsTutoriais.ToList();

                indiceAtual = tutoriaisCurso.FindIndex(x =>
                    x.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase));

                if (indiceAtual < 0) indiceAtual = 0;
                modoVisualizacao = "curso";
                await CarregarAulaAtual();
            }
        }
        else if (todosOsTutoriais.Any())
        {
            tutoriaisCurso = todosOsTutoriais.ToList();
            modoVisualizacao = "catalogo";
        }

        carregando = false;
    }

    private async Task CarregarAulaAtual()
    {
        if (tutoriaisCurso.Count == 0) return;
        var idx = Math.Clamp(indiceAtual, 0, tutoriaisCurso.Count - 1);
        if (tutoriaisCurso[idx].Blocos.Count == 0)
        {
            tutoriaisCurso[idx] =
                await DocumentacaoService.BuscarAsync(tutoriaisCurso[idx].Codigo, codEmpAtual)
                ?? tutoriaisCurso[idx];
        }
    }

    private async Task Selecionar(int indice)
    {
        indiceAtual = indice;
        await CarregarAulaAtual();
        Nav.NavigateTo($"/curso-tutorial/{codEmpAtual}/{tutoriaisCurso[indiceAtual].Slug}", replace: true);
    }

    private async Task Proximo()
    {
        if (indiceAtual < tutoriaisCurso.Count - 1)
            await Selecionar(indiceAtual + 1);
    }

    private async Task Anterior()
    {
        if (indiceAtual > 0)
            await Selecionar(indiceAtual - 1);
    }

    private async Task AbrirTutorial(DocumentacaoTutorialModel doc)
    {
        var categoria = doc.Categoria;
        tutoriaisCurso = !string.IsNullOrWhiteSpace(categoria)
            ? todosOsTutoriais.Where(x =>
                x.Categoria.Equals(categoria, StringComparison.OrdinalIgnoreCase)).ToList()
            : todosOsTutoriais.ToList();

        indiceAtual = tutoriaisCurso.FindIndex(x => x.Codigo == doc.Codigo);
        if (indiceAtual < 0) indiceAtual = 0;

        buscaGlobal = "";
        modoVisualizacao = "curso";
        await CarregarAulaAtual();
        Nav.NavigateTo($"/curso-tutorial/{codEmpAtual}/{tutoriaisCurso[indiceAtual].Slug}", replace: true);
    }

    private void AlterarModo(string modo)
    {
        modoVisualizacao = modo;
        buscaGlobal = "";
        if (modo == "catalogo")
            Nav.NavigateTo($"/curso-tutorial/{codEmpAtual}", replace: true);
    }

    private void OnBuscaInput(ChangeEventArgs e)
    {
        buscaGlobal = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(buscaGlobal))
            modoVisualizacao = "catalogo";
    }

    private static string PrepararHtmlSeguro(string conteudo)
    {
        if (string.IsNullOrWhiteSpace(conteudo)) return "";
        var html = conteudo;
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<div class=""de-img-controls"">[\s\S]*?</div>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<div class=""de-resize-handle"">[\s\S]*?</div>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<div class=""de-video-controls"">[\s\S]*?</div>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<script[\s\S]*?</script>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"on\w+=""[^""]*""", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return html;
    }

    private static string ObterInicial(string texto)
        => string.IsNullOrWhiteSpace(texto) ? "D" : texto.Trim()[0].ToString().ToUpperInvariant();
}
