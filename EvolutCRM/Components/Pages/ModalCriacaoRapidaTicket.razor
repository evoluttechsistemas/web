    private async Task SalvarNovoContato()
    {
        if (string.IsNullOrWhiteSpace(_nomeNovoContato))
        {
            _erro = "Informe o nome do contato.";
            return;
        }

        if (_codClienteContato <= 0)
        {
            _erro = "Selecione o cliente para vincular.";
            return;
        }

        var termoSoDigitos = new string(_termoCliente.Where(char.IsDigit).ToArray());
        if (termoSoDigitos.Length < 8)
        {
            _erro = "Número inválido.";
            return;
        }

        _salvandoContato = true;

        try
        {
            await TicketSvc.SalvarCelularClienteAsync(_codClienteContato, termoSoDigitos);

            // Seleciona o cliente automaticamente
            var clienteSelecionado = new ClienteModel
            {
                Codigo = _codClienteContato,
                Nome = _termoBuscaClienteContato
            };

            _termoCliente = $"{clienteSelecionado.Nome} — {_nomeNovoContato}";
            _codClienteSelecionado = _codClienteContato;
            _clienteSelecionado = true;
            _telefoneWhatsApp = termoSoDigitos;
            _nomeWhatsApp = _nomeNovoContato;
            _contatoSelecionado = true;
            _mostrarSalvarContato = false;
            _sugestoes = new();
            _contatosCliente = new();
            _erro = "";
        }
        catch (Exception ex)
        {
            _erro = "Erro ao salvar contato: " + ex.Message;
        }
        finally
        {
            _salvandoContato = false;
            StateHasChanged();
        }
    }
