    // ─────────────────────────────────────────────────────────────────────
    // Criar ticket
    // ─────────────────────────────────────────────────────────────────────

    private async Task Criar()
    {
        _erro = "";

        if (string.IsNullOrWhiteSpace(_termoCliente))
        {
            _erro = "Informe o cliente.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_mensagem))
        {
            _erro = "Informe a primeira mensagem.";
            return;
        }

        _salvando = true;

        try
        {
            int codCliente = _codClienteSelecionado;
            if (codCliente == 0)
                codCliente = await TicketSvc.CriarClienteRapidoAsync(_termoCliente.Trim());

            // 1. Cria o ticket com a mensagem e o arquivo (se houver)
            var ticketId = await TicketSvc.CriarChamadoComAnexoAsync(
assunto: _mensagem.Trim().Length > 80
    ? _mensagem.Trim()[..80] + "..."
    : _mensagem.Trim(),
descricao: _mensagem.Trim(),
codCliente: codCliente,
codSetor: 1,
codSituacao: 1,
codTipo: _contatoSelecionado ? 5 : 1,
prioridade: 2,
usuarioResponsavel: UserState.CurrentUser ?? "NOVO",
arquivo: _arquivo,
usuarioAbertura: UserState.CurrentUser ?? "NOVO",
telefoneWhatsApp: _contatoSelecionado ? _telefoneWhatsApp : null,
nomeWhatsApp: _contatoSelecionado ? _nomeWhatsApp : null
);

            // 2. Se tem áudio ou vídeo, salva como mensagem adicional no ticket
            var temMidia = (_audioGravado != null && _audioGravado.Length > 0)
                        || (_videoGravado != null && _videoGravado.Length > 0);

            if (temMidia)
            {
                var ticketParaMidia = await TicketSvc.BuscarChamadoAsync(ticketId);
                if (ticketParaMidia != null)
                {
                    await TicketSvc.SalvarAlteracoesAsync(
                        ticket: ticketParaMidia,
                        anotacao: "",
                        usuarioQueSalvou: UserState.CurrentUser ?? "NOVO",
                        imagem: null,
                        videoBytes: _videoGravado,
                        videoMimeType: string.IsNullOrWhiteSpace(_videoGravadoMime) ? null : _videoGravadoMime,
                        videoFileName: string.IsNullOrWhiteSpace(_videoGravadoNome) ? null : _videoGravadoNome,
                        audioBytes: _audioGravado,
                        audioMimeType: string.IsNullOrWhiteSpace(_audioMimeType) ? null : _audioMimeType,
                        audioFileName: string.IsNullOrWhiteSpace(_audioNome) ? null : _audioNome
                    );
                }
            }

            await AoCriar.InvokeAsync(ticketId);
            Limpar();
        }
        catch (Exception ex)
        {
            _erro = "Erro ao criar ticket: " + ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

