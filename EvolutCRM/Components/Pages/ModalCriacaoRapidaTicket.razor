    // ─────────────────────────────────────────────────────────────────────
    // Arquivo / imagem colada
    // ─────────────────────────────────────────────────────────────────────

    private async Task OnArquivoSelecionado(InputFileChangeEventArgs e)
    {
        _arquivo = e.File;
        _previewArquivo = null;

        if (_arquivo == null) return;

        try
        {
            var ext = System.IO.Path.GetExtension(_arquivo.Name).ToLowerInvariant();
            var ehImg = _arquivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

            if (ehImg)
            {
                using var stream = _arquivo.OpenReadStream(20 * 1024 * 1024);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                _previewArquivo = $"data:{_arquivo.ContentType};base64,{base64}";
            }
        }
        catch (Exception ex)
        {
            _erro = "Erro ao carregar arquivo: " + ex.Message;
            _arquivo = null;
        }

        StateHasChanged();
    }

    /// <summary>Chamado pelo JS quando o usuário cola uma imagem no textarea.</summary>
    [JSInvokable]
    public async Task OnImagemColada(string base64, string contentType)
    {
        try
        {
            var bytes = Convert.FromBase64String(base64.Split(',')[1]);
            if (bytes.Length > 10 * 1024 * 1024)
            {
                _erro = "Imagem muito grande. Máximo: 10 MB.";
                await InvokeAsync(StateHasChanged);
                return;
            }

            var stream = new System.IO.MemoryStream(bytes);
            var redimensionado = await RedimensionarImagemAsync(stream);
            var b64 = Convert.ToBase64String(redimensionado);
            _previewArquivo = $"data:image/jpeg;base64,{b64}";

            _arquivo = new BrowserFileFromStream(
                new System.IO.MemoryStream(redimensionado),
                "image/jpeg",
                "clipboard.jpg"
            );

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _erro = "Erro ao processar imagem colada: " + ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<byte[]> RedimensionarImagemAsync(System.IO.Stream input)
    {
        using var image = await Image.LoadAsync(input);
        const int maxW = 1920, maxH = 1080;

        if (image.Width > maxW || image.Height > maxH)
            image.Mutate(x => x.Resize(new ResizeOptions { Size = new Size(maxW, maxH), Mode = ResizeMode.Max }));

        using var output = new System.IO.MemoryStream();
        await image.SaveAsJpegAsync(output, new JpegEncoder { Quality = 85 });
        return output.ToArray();
    }

