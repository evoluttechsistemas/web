            imagemPath = caminho;
            StateHasChanged();
        }
        catch
        {
            MostrarMensagem("Erro ao fazer upload da imagem.", "error");
        }
    }

    private async Task<string> SalvarImagemAsync(IBrowserFile file, long maxBytes)
    {
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var fileName = $"{Guid.NewGuid()}{ext}";

        // Pasta fora do wwwroot (servida pelo Program.cs em /uploads)
        var pastaBase = Config["Uploads:PastaFisica"] ?? @"C:\FTP\Site\Help\uploads";
        var pastaBlog = Path.Combine(pastaBase, "blog");
        Directory.CreateDirectory(pastaBlog);

        var fullPath = Path.Combine(pastaBlog, fileName);
        await using (var fs = File.Create(fullPath))
        await using (var stream = file.OpenReadStream(maxBytes))
            await stream.CopyToAsync(fs);

        return $"/uploads/blog/{fileName}";
    }

