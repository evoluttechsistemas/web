    private string ResumoSecao(PageSection s)
    {
        string Limpo(string v) => System.Text.RegularExpressions.Regex.Replace(LayoutRenderer.Tokens(v, CtxPreview()), @"[*=\[\]]|\(http[^)]*\)", "").Replace('\n', ' ');
        var txt = s.Tipo switch
        {
            "conteudo" => "Texto do post" + (s.Sumario ? " · com sumário" : ""),
            "escrita" => string.IsNullOrWhiteSpace(s.Html) ? "(vazio — clique no preview para escrever)"
                : System.Text.RegularExpressions.Regex.Replace(System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(s.Html, "<[^>]+>", " ")), @"\s+", " ").Trim(),
            "citacao" => s.Corpo,
            "autor" => s.Autor,
            "divider" => "Estilo: " + (string.IsNullOrEmpty(s.Variante) ? "linha" : s.Variante),
            "espaco" => $"{s.PaddingV}px",
            "imagem" => string.IsNullOrEmpty(s.Imagem) ? "(sem imagem)" : (string.IsNullOrEmpty(s.Legenda) ? "Imagem" : s.Legenda),
            "video" => string.IsNullOrEmpty(s.VideoUrl) ? "(sem link)" : s.VideoUrl,
            _ => !string.IsNullOrWhiteSpace(s.Titulo) ? s.Titulo : s.Corpo
        };
        txt = Limpo(txt ?? "");
        if (s.Itens.Count > 0 && LayoutPresets.Info(s.Tipo).TemItens) txt = $"{s.Itens.Count} itens · {txt}";
        return string.IsNullOrWhiteSpace(txt) ? "—" : txt;
    }

