    /// <summary>Gera o HTML final e grava o layout. Chamado pelo Salvar do drawer e pelo Salvar do post.</summary>
    private async Task PersistirLayoutAsync(int idPost)
    {
        LayoutRenderer.Normalizar(_layout);
        string json;
        if (_layout.Secoes.Count == 0)
        {
            json = "";
        }
        else
        {
            var ctx = new RenderContexto { TituloPost = titulo, Capa = imagemPath, Data = _dataPost, ConteudoHtml = _htmlCorpo, Preview = false };
            _layout.HtmlRenderizado = LayoutRenderer.Documento(_layout, ctx);
            _layout.AtualizadoEm = DateTime.Now;
            json = System.Text.Json.JsonSerializer.Serialize(_layout);
            _layout.HtmlRenderizado = null;
        }
        await BlogRepo.SalvarLayoutAsync(idPost, json);
        _layoutSujo = false;
    }

    // ── histórico (desfazer / refazer) ──────────────────────────────
    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(_layout);

    private void Registrar()
    {
        var snap = Snapshot();
        if (_undo.Count == 0 || _undo[^1] != snap)
        {
            _undo.Add(snap);
            if (_undo.Count > 80) _undo.RemoveAt(0);
        }
        _redo.Clear();
        _layoutSujo = true;
    }

    private void RegistrarFoco()
    {
        var snap = Snapshot();
        if (_undo.Count == 0 || _undo[^1] != snap)
        {
            _undo.Add(snap);
            if (_undo.Count > 80) _undo.RemoveAt(0);
        }
    }

    private void Mudou() => _layoutSujo = true;

    private void Desfazer()
    {
        if (_undo.Count == 0) return;
        var atual = Snapshot();
        var anterior = _undo[^1];
        _undo.RemoveAt(_undo.Count - 1);
        if (anterior == atual && _undo.Count > 0) { anterior = _undo[^1]; _undo.RemoveAt(_undo.Count - 1); }
        _redo.Add(atual);
        Restaurar(anterior);
    }

    private void Refazer()
    {
        if (_redo.Count == 0) return;
        _undo.Add(Snapshot());
        var prox = _redo[^1];
        _redo.RemoveAt(_redo.Count - 1);
        Restaurar(prox);
    }

    private void Restaurar(string json)
    {
        var selId = _secaoEditando?.Id;
        try { _layout = System.Text.Json.JsonSerializer.Deserialize<PostLayout>(json, _jsonLer) ?? new(); } catch { return; }
        LayoutRenderer.Normalizar(_layout);
        _secaoEditando = _layout.Secoes.FirstOrDefault(x => x.Id == selId);
        _layoutSujo = true;
    }

    // ── operações de blocos ─────────────────────────────────────────
    private List<PageSection> Ordenadas() => _layout.Secoes.OrderBy(x => x.Ordem).ToList();

    private void Reindexar(List<PageSection> lista)
    {
        for (var i = 0; i < lista.Count; i++) lista[i].Ordem = i;
        _layout.Secoes = lista;
    }

    private void Selecionar(PageSection s, bool rolar = false)
