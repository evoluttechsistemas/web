@using EvolutCRM.Blog
@page "/blog/novo"
@page "/blog/editar/{Id:int}"
@inject BlogRepository BlogRepo
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject AbaService Abas
@inject IConfiguration Config

<style>
    * {
        box-sizing: border-box;
    }

    .blog-editor-root {
        display: grid;
        grid-template-rows: auto 1fr;
        height: 100vh;
        background: #f8f9fb;
        font-family: 'IBM Plex Sans', -apple-system, sans-serif;
        color: #0f172a;
    }

    /* ── Topbar ── */
    .be-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 0 20px;
        height: 52px;
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        z-index: 200;
    }

    .be-topbar-left {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .be-btn-back {
        width: 30px;
        height: 30px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #fff;
        color: #475569;
        font-size: 16px;
        cursor: pointer;
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

        .be-btn-back:hover {
            background: #f1f5f9;
        }

    .be-post-title-input {
        border: none;
        outline: none;
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        background: transparent;
        min-width: 200px;
        max-width: 420px;
        font-family: 'IBM Plex Sans', sans-serif;
    }

        .be-post-title-input::placeholder {
            color: #94a3b8;
        }

    .be-topbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .be-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 5px;
        background: #fef3c7;
        color: #92400e;
    }

        .be-badge.publicado {
            background: #dcfce7;
            color: #166534;
        }

    .be-btn {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #374151;
        border-radius: 7px;
        padding: 7px 13px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'IBM Plex Sans', sans-serif;
    }

        .be-btn:hover {
            background: #f8fafc;
        }

        .be-btn.primary {
            background: #2563eb;
            border-color: #2563eb;
            color: #fff;
        }

            .be-btn.primary:hover {
                background: #1d4ed8;
            }

        .be-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .be-select {
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #fff;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
        padding: 7px 10px;
        cursor: pointer;
        font-family: 'IBM Plex Sans', sans-serif;
    }

    /* ── Body layout ── */
    .be-body {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 0;
        overflow: hidden;
    }

    /* ── Sidebar ── */
    .be-sidebar {
        border-right: 1px solid #e2e8f0;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        padding: 16px 14px;
        gap: 16px;
    }

    .be-sidebar-section {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .be-sidebar-label {
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #94a3b8;
        padding: 0 2px;
    }

    .be-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .be-field-label {
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
    }

    .be-input, .be-textarea, .be-select-sm {
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 7px 9px;
        font-size: 12px;
        color: #0f172a;
        background: #fff;
        outline: none;
        width: 100%;
        transition: border-color .15s;
        font-family: 'IBM Plex Sans', sans-serif;
    }

        .be-input:focus, .be-textarea:focus, .be-select-sm:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(59,130,246,.12);
        }

    .be-textarea {
        min-height: 76px;
        resize: vertical;
        font-size: 12px;
        line-height: 1.4;
    }

    .be-alert {
        padding: 10px 12px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 4px;
    }

        .be-alert.success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #86efac;
        }

        .be-alert.error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

    /* ── Imagem de capa ── */
    .be-cover-preview {
        width: 100%;
        aspect-ratio: 16/9;
        border-radius: 8px;
        overflow: hidden;
        background: #f1f5f9;
        border: 1.5px dashed #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 600;
        position: relative;
        cursor: pointer;
    }

        .be-cover-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .be-cover-actions {
        display: flex;
        gap: 6px;
        margin-top: 6px;
    }

    .be-cover-btn {
        flex: 1;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #374151;
        border-radius: 6px;
        padding: 6px 8px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: 'IBM Plex Sans', sans-serif;
    }

        .be-cover-btn:hover {
            background: #f8fafc;
        }

        .be-cover-btn.danger {
            color: #b91c1c;
            border-color: #fecaca;
        }

    /* ── Editor area ── */
    .be-editor-wrap {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #f8f9fb;
    }

    /* ── Toolbar ── */
    .be-toolbar {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 6px 16px;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .be-tb-btn {
        border: none;
        background: transparent;
        color: #475569;
        border-radius: 5px;
        width: 30px;
        height: 28px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: background .12s;
        font-family: 'IBM Plex Sans', sans-serif;
    }

        .be-tb-btn:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

    .be-tb-sep {
        width: 1px;
        height: 20px;
        background: #e2e8f0;
        margin: 0 4px;
        flex-shrink: 0;
    }

    .be-tb-select {
        border: 1px solid #e2e8f0;
        border-radius: 5px;
        background: #fff;
        font-size: 12px;
        font-weight: 700;
        color: #374151;
        padding: 4px 6px;
        cursor: pointer;
        height: 28px;
        font-family: 'IBM Plex Sans', sans-serif;
    }

    .be-tb-insert-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #e2e8f0;
        border-radius: 5px;
        background: #fff;
        color: #374151;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 9px;
        height: 28px;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'IBM Plex Sans', sans-serif;
    }

        .be-tb-insert-btn:hover {
            background: #f1f5f9;
        }

    /* ── Content editable ── */
    .be-content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 40px 0 80px;
    }

    .be-content-inner {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 32px;
    }

    .be-editor {
        min-height: 600px;
        outline: none;
        font-size: 15px;
        line-height: 1.7;
        color: #1e293b;
        caret-color: #2563eb;
    }

        .be-editor h1 {
            font-size: 2rem;
            font-weight: 800;
            margin: 1.4em 0 .4em;
            color: #0f172a;
        }

        .be-editor h2 {
            font-size: 1.45rem;
            font-weight: 700;
            margin: 1.2em 0 .35em;
            color: #0f172a;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: .3em;
        }

        .be-editor h3 {
            font-size: 1.15rem;
            font-weight: 700;
            margin: 1em 0 .3em;
            color: #0f172a;
        }

        .be-editor p {
            margin: .5em 0;
        }

        .be-editor ul, .be-editor ol {
            margin: .5em 0;
            padding-left: 1.5em;
        }

        .be-editor li {
            margin: .25em 0;
        }

        .be-editor blockquote {
            border-left: 3px solid #2563eb;
            margin: 1em 0;
            padding: .5em 1em;
            background: #eff6ff;
            border-radius: 0 6px 6px 0;
            color: #1e40af;
            font-style: italic;
        }

        .be-editor pre {
            background: #1e293b;
            color: #e2e8f0;
            border-radius: 8px;
            padding: 14px 16px;
            font-size: 13px;
            overflow-x: auto;
            margin: 1em 0;
        }

        .be-editor code {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            padding: 1px 5px;
            font-size: .88em;
            font-family: 'IBM Plex Mono', monospace;
        }

        .be-editor pre code {
            background: none;
            border: none;
            padding: 0;
            font-size: inherit;
            color: inherit;
        }

        .be-editor hr {
            border: none;
            border-top: 1px solid #e2e8f0;
            margin: 1.5em 0;
        }

        .be-editor mark {
            background: #fef08a;
            color: #713f12;
            border-radius: 2px;
            padding: 1px 2px;
        }

        .be-editor a {
            color: #2563eb;
            text-decoration: underline;
        }

        .be-editor .be-img-wrap {
            display: inline-block;
            position: relative;
            margin: 8px 0;
            max-width: 100%;
            line-height: 0;
        }

            .be-editor .be-img-wrap img {
                border-radius: 6px;
                display: block;
                max-width: 100%;
                cursor: default;
            }

            .be-editor .be-img-wrap.selected img {
                outline: 2px solid #2563eb;
                outline-offset: 2px;
            }

    .be-resize-handle {
        position: absolute;
        right: -5px;
        bottom: -5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #2563eb;
        cursor: se-resize;
        border: 2px solid #fff;
        display: none;
    }

    .be-img-wrap.selected .be-resize-handle {
        display: block;
    }

    .be-img-controls {
        position: absolute;
        top: 6px;
        left: 6px;
        display: none;
        gap: 4px;
        background: rgba(0,0,0,.55);
        border-radius: 5px;
        padding: 3px 5px;
    }

    .be-img-wrap:hover .be-img-controls,
    .be-img-wrap.selected .be-img-controls {
        display: flex;
    }

    .be-img-ctrl-btn {
        background: none;
        border: none;
        color: #fff;
        font-size: 11px;
        cursor: pointer;
        padding: 2px 5px;
        border-radius: 3px;
        font-weight: 700;
    }

        .be-img-ctrl-btn:hover {
            background: rgba(255,255,255,.2);
        }

    .be-video-wrap {
        margin: 12px 0;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
        position: relative;
    }

        .be-video-wrap iframe {
            width: 100%;
            aspect-ratio: 16/9;
            border: none;
            display: block;
        }

        .be-video-wrap video {
            width: 100%;
            display: block;
            border-radius: 10px;
        }

    .be-video-controls {
        position: absolute;
        top: 8px;
        right: 8px;
        display: none;
        gap: 4px;
    }

    .be-video-wrap:hover .be-video-controls {
        display: flex;
    }

    .be-video-ctrl-btn {
        background: rgba(0,0,0,.6);
        border: none;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        border-radius: 5px;
        padding: 4px 8px;
        cursor: pointer;
    }

    .be-callout {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 12px 14px;
        border-radius: 8px;
        margin: 10px 0;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
    }

    .be-callout-icon {
        font-size: 18px;
        flex-shrink: 0;
    }

    .be-callout[data-type="warning"] {
        background: #fffbeb;
        border-color: #fde68a;
    }

    .be-callout[data-type="danger"] {
        background: #fee2e2;
        border-color: #fecaca;
    }

    .be-callout[data-type="success"] {
        background: #f0fdf4;
        border-color: #bbf7d0;
    }

    .be-table-wrap {
        overflow-x: auto;
        margin: 12px 0;
    }

    .be-editor table {
        border-collapse: collapse;
        width: 100%;
        min-width: 400px;
    }

    .be-editor th {
        background: #f1f5f9;
        font-weight: 700;
    }

    .be-editor td, .be-editor th {
        border: 1px solid #e2e8f0;
        padding: 8px 12px;
        font-size: 13px;
        text-align: left;
    }

        .be-editor td:focus {
            outline: 2px solid #2563eb;
            outline-offset: -2px;
        }

    /* Slash menu */
    .be-slash-menu {
        position: absolute;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        box-shadow: 0 8px 32px rgba(15,23,42,.12);
        z-index: 999;
        width: 240px;
        padding: 6px;
        max-height: 320px;
        overflow-y: auto;
    }

    .be-slash-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 13px;
    }

        .be-slash-item:hover, .be-slash-item.active {
            background: #f1f5f9;
        }

    .be-slash-icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: #f1f5f9;
        display: grid;
        place-items: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .be-slash-label {
        font-weight: 700;
        color: #0f172a;
    }

    .be-slash-desc {
        font-size: 11px;
        color: #64748b;
    }

    .be-placeholder::before {
        content: attr(data-placeholder);
        color: #94a3b8;
        pointer-events: none;
        position: absolute;
    }

    /* Modal vídeo */
    .be-modal-bg {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.5);
        z-index: 9998;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .be-modal {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        width: 440px;
        max-width: 95vw;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
    }

        .be-modal h3 {
            margin: 0 0 14px;
            font-size: 16px;
        }

    .be-modal-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 14px;
    }

    @@media(max-width: 900px) {
        .be-body {
            grid-template-columns: 1fr;
        }

        .be-sidebar {
            display: none;
        }
    }

    /* ════════════════════════════════════════════════════════════
       PAGE BUILDER (drawer à esquerda + preview ao vivo à direita)
       ════════════════════════════════════════════════════════════ */
    .be-btn-secondary {
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #374151;
        border-radius: 7px;
        padding: 7px 13px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'IBM Plex Sans', sans-serif;
        display: flex;
        align-items: center;
        gap: 6px;
        position: relative;
    }

        .be-btn-secondary:hover { background: #f8fafc; border-color: #6366f1; color: #6366f1; }
        .be-btn-secondary .pb-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; }
        .be-btn-secondary .pb-dot.sujo { background: #f59e0b; }

    .pb-drawer {
        --pb-ac: #6366f1; --pb-ac2: #4f46e5; --pb-bd: #e5e7eb; --pb-mut: #64748b; --pb-bg: #f8fafc;
        position: fixed; left: 0; top: 0; height: 100vh; width: 384px;
        background: #fff; border-right: 1px solid var(--pb-bd);
        box-shadow: 8px 0 32px rgba(15,23,42,.14);
        z-index: 9000; display: flex; flex-direction: column;
        font-family: 'IBM Plex Sans', sans-serif; color: #0f172a;
        animation: pb-in .22s ease-out;
    }

    @@keyframes pb-in { from { transform: translateX(-24px); opacity: 0; } }

    .pb-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--pb-bd); }
    .pb-head-l { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .pb-logo { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-size: 17px; background: linear-gradient(135deg,#6366f1,#06b6d4); color: #fff; flex-shrink: 0; }
    .pb-head b { font-size: 14px; display: block; line-height: 1.2; }
    .pb-head small { font-size: 11px; color: var(--pb-mut); display: block; white-space: nowrap; }
    .pb-head small.sujo { color: #d97706; font-weight: 700; }
    .pb-head-r { display: flex; align-items: center; gap: 4px; }
    .pb-ic { width: 30px; height: 30px; border: 1px solid var(--pb-bd); border-radius: 8px; background: #fff; cursor: pointer; color: #334155; font-size: 15px; display: grid; place-items: center; }
    .pb-ic:hover:not(:disabled) { border-color: var(--pb-ac); color: var(--pb-ac); background: #eef2ff; }
    .pb-ic:disabled { opacity: .35; cursor: default; }
    .pb-save { height: 30px; padding: 0 12px; white-space: nowrap; border: 0; border-radius: 8px; background: var(--pb-ac); color: #fff; font-weight: 700; font-size: 12px; cursor: pointer; font-family: inherit; }
    .pb-save:hover { background: var(--pb-ac2); }

    .pb-tabs { display: grid; grid-template-columns: 1.35fr 1fr 1fr 1fr; border-bottom: 1px solid var(--pb-bd); background: var(--pb-bg); flex-shrink: 0; }
    .pb-tab { border: 0; background: transparent; padding: 10px 4px 9px; font: 700 11.5px 'IBM Plex Sans',sans-serif; color: var(--pb-mut); cursor: pointer; border-bottom: 2px solid transparent; display: flex; align-items: center; justify-content: center; gap: 5px; white-space: nowrap; }
    .pb-tab:hover { color: #0f172a; }
    .pb-tab.on { color: var(--pb-ac); border-bottom-color: var(--pb-ac); background: #fff; }
    .pb-tab .pb-count { background: #e0e7ff; color: var(--pb-ac); border-radius: 10px; padding: 0 6px; font-size: 10px; }

    .pb-body { flex: 1; min-height: 0; overflow-y: auto; padding: 14px 14px 70px; display: grid; grid-template-columns: minmax(0,1fr); grid-auto-rows: max-content; align-content: start; gap: 12px; scrollbar-width: thin; }
    .pb-lbl { font-size: 10.5px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: .07em; display: flex; justify-content: space-between; align-items: center; }
    .pb-hint { font-size: 11.5px; color: var(--pb-mut); line-height: 1.5; }
    .pb-hint code { background: #f1f5f9; border-radius: 4px; padding: 0 4px; font-size: 11px; color: #4338ca; }

    /* Estrutura */
    .pb-list { display: flex; flex-direction: column; gap: 6px; }
    .pb-row { display: flex; align-items: center; gap: 8px; padding: 8px 8px 8px 6px; border: 1.5px solid var(--pb-bd); border-radius: 10px; background: #fff; cursor: pointer; transition: border-color .12s, box-shadow .12s, transform .12s; position: relative; }
    .pb-row:hover { border-color: #c7d2fe; }
    .pb-row.on { border-color: var(--pb-ac); box-shadow: 0 0 0 3px #eef2ff; }
    .pb-row.drag { opacity: .4; }
    .pb-row.sobre::before { content: ""; position: absolute; left: 6px; right: 6px; top: -5px; height: 3px; border-radius: 3px; background: var(--pb-ac); }
    .pb-row.oculta { opacity: .55; }
    .pb-grip { color: #cbd5e1; cursor: grab; font-size: 14px; padding: 0 2px; }
    .pb-row-ico { width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; font-size: 15px; flex-shrink: 0; border: 1px solid rgba(0,0,0,.06); }
    .pb-row-txt { flex: 1; min-width: 0; }
    .pb-row-txt b { display: block; font-size: 12.5px; }
    .pb-row-txt span { display: block; font-size: 11px; color: var(--pb-mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pb-row-act { display: flex; gap: 2px; opacity: 0; transition: opacity .12s; }
    .pb-row:hover .pb-row-act, .pb-row.on .pb-row-act { opacity: 1; }
    .pb-mini { width: 24px; height: 24px; border: 0; background: transparent; border-radius: 6px; cursor: pointer; font-size: 12px; color: #475569; }
    .pb-mini:hover { background: #f1f5f9; color: var(--pb-ac); }
    .pb-mini.del:hover { background: #fee2e2; color: #dc2626; }
    .pb-add-big { border: 1.5px dashed #c7d2fe; background: #f8faff; color: var(--pb-ac); border-radius: 10px; padding: 11px; font: 700 12.5px 'IBM Plex Sans',sans-serif; cursor: pointer; }
    .pb-add-big:hover { background: #eef2ff; border-color: var(--pb-ac); }

    .pb-tpls { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .pb-tpl { border: 1.5px solid var(--pb-bd); border-radius: 10px; padding: 10px; cursor: pointer; background: #fff; text-align: left; font-family: inherit; transition: all .12s; }
    .pb-tpl:hover { border-color: var(--pb-ac); transform: translateY(-1px); box-shadow: 0 4px 14px rgba(99,102,241,.12); }
    .pb-tpl.on { border-color: var(--pb-ac); background: #eef2ff; }
    .pb-tpl b { display: block; font-size: 12px; margin-top: 4px; color: #0f172a; }
    .pb-tpl span { display: block; font-size: 10.5px; color: var(--pb-mut); line-height: 1.35; margin-top: 2px; }
    .pb-tpl i { font-style: normal; font-size: 18px; }

    /* Biblioteca de blocos */
    .pb-search { width: 100%; border: 1.5px solid var(--pb-bd); border-radius: 9px; padding: 9px 12px; font: 13px 'IBM Plex Sans',sans-serif; outline: none; }
    .pb-search:focus { border-color: var(--pb-ac); box-shadow: 0 0 0 3px #eef2ff; }
    .pb-blocks { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .pb-block { border: 1.5px solid var(--pb-bd); border-radius: 10px; background: #fff; padding: 10px; cursor: pointer; text-align: left; font-family: inherit; display: flex; flex-direction: column; gap: 3px; transition: all .12s; }
    .pb-block:hover { border-color: var(--pb-ac); background: #fafaff; transform: translateY(-1px); }
    .pb-block i { font-style: normal; font-size: 18px; }
    .pb-block b { font-size: 12px; color: #0f172a; }
    .pb-block span { font-size: 10.5px; color: var(--pb-mut); line-height: 1.35; }
    .pb-block.usado { opacity: .5; }

    /* Editor de bloco */
    .pb-edit-head { display: flex; align-items: center; gap: 10px; padding-bottom: 4px; }
    .pb-edit-head .pb-row-ico { width: 36px; height: 36px; font-size: 18px; background: #eef2ff; }
    .pb-edit-head b { font-size: 14px; display: block; }
    .pb-edit-head small { color: var(--pb-mut); font-size: 11px; }
    .pb-edit-nav { margin-left: auto; display: flex; gap: 4px; }
    .pb-quick { display: flex; flex-wrap: wrap; gap: 6px; }
    .pb-quick button { width: 34px; height: 34px; border-radius: 9px; border: 2px solid #fff; box-shadow: 0 0 0 1px var(--pb-bd); cursor: pointer; position: relative; }
    .pb-quick button:hover { box-shadow: 0 0 0 2px var(--pb-ac); transform: scale(1.06); }
    .pb-grp { border: 1px solid var(--pb-bd); border-radius: 11px; background: #fff; overflow: hidden; }
    .pb-grp > summary { list-style: none; cursor: pointer; padding: 10px 12px; font-size: 12.5px; font-weight: 700; display: flex; align-items: center; gap: 8px; user-select: none; }
    .pb-grp > summary::-webkit-details-marker { display: none; }
    .pb-grp > summary::after { content: "›"; margin-left: auto; color: #94a3b8; font-size: 16px; transition: transform .15s; }
    .pb-grp[open] > summary::after { transform: rotate(90deg); }
    .pb-grp[open] > summary { border-bottom: 1px solid #f1f5f9; background: #fcfcfe; }
    .pb-grp-body { padding: 12px; display: flex; flex-direction: column; gap: 11px; }
    .pb-f { display: flex; flex-direction: column; gap: 5px; }
    .pb-f > label { font-size: 11px; font-weight: 700; color: #475569; display: flex; justify-content: space-between; align-items: center; }
    .pb-f > label em { font-style: normal; font-weight: 600; color: var(--pb-ac); font-size: 11px; }
    .pb-f input[type=text], .pb-f textarea, .pb-f select { border: 1.5px solid var(--pb-bd); border-radius: 8px; padding: 7px 10px; font: 13px 'IBM Plex Sans',sans-serif; color: #0f172a; background: #fff; outline: none; width: 100%; }
    .pb-f textarea { resize: vertical; line-height: 1.45; min-height: 70px; }
    .pb-f input[type=text]:focus, .pb-f textarea:focus, .pb-f select:focus { border-color: var(--pb-ac); box-shadow: 0 0 0 3px #eef2ff; }
    .pb-f small { font-size: 10.5px; color: #94a3b8; line-height: 1.4; }
    .pb-f input[type=range] { width: 100%; accent-color: var(--pb-ac); }
    .pb-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .pb-seg { display: flex; background: #f1f5f9; border-radius: 9px; padding: 3px; gap: 2px; flex-wrap: wrap; }
    .pb-seg button { flex: 1; border: 0; background: transparent; border-radius: 7px; padding: 6px 6px; font: 600 11.5px 'IBM Plex Sans',sans-serif; color: #475569; cursor: pointer; white-space: nowrap; min-width: 0; }
    .pb-seg button:hover { color: #0f172a; }
    .pb-seg button.on { background: #fff; color: var(--pb-ac); box-shadow: 0 1px 3px rgba(15,23,42,.12); }
    .pb-sw { display: flex; align-items: center; gap: 6px; }
    .pb-sw input[type=color] { width: 36px; height: 32px; border: 1.5px solid var(--pb-bd); border-radius: 8px; padding: 2px; background: #fff; cursor: pointer; flex-shrink: 0; }
    .pb-sw input[type=text] { flex: 1; font-family: 'IBM Plex Mono', monospace !important; font-size: 12px !important; }
    .pb-tokens { display: flex; gap: 4px; flex-wrap: wrap; }
    .pb-tok { width: 20px; height: 20px; border-radius: 6px; border: 2px solid #fff; box-shadow: 0 0 0 1px #cbd5e1; cursor: pointer; padding: 0; }
    .pb-tok.on { box-shadow: 0 0 0 2px var(--pb-ac); }
    .pb-tok.reset { background: repeating-linear-gradient(45deg,#fff 0 3px,#e2e8f0 3px 6px); }
    .pb-toggle { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12.5px; color: #334155; cursor: pointer; user-select: none; }
    .pb-toggle input { display: none; }
    .pb-toggle i { width: 34px; height: 20px; border-radius: 20px; background: #cbd5e1; position: relative; transition: background .15s; flex-shrink: 0; }
    .pb-toggle i::after { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform .15s; box-shadow: 0 1px 3px rgba(0,0,0,.2); }
    .pb-toggle input:checked + i { background: var(--pb-ac); }
    .pb-toggle input:checked + i::after { transform: translateX(14px); }
    .pb-img { display: flex; gap: 8px; align-items: center; }
    .pb-img-thumb { width: 52px; height: 40px; border-radius: 7px; background: #f1f5f9 center/cover no-repeat; border: 1px solid var(--pb-bd); flex-shrink: 0; display: grid; place-items: center; color: #94a3b8; font-size: 16px; }
    .pb-btn-sm { border: 1.5px solid var(--pb-bd); background: #fff; border-radius: 8px; padding: 6px 10px; font: 700 11.5px 'IBM Plex Sans',sans-serif; color: #334155; cursor: pointer; white-space: nowrap; }
    .pb-btn-sm:hover { border-color: var(--pb-ac); color: var(--pb-ac); }
    .pb-btn-sm.danger:hover { border-color: #ef4444; color: #dc2626; background: #fef2f2; }
    .pb-emojis { display: flex; flex-wrap: wrap; gap: 2px; }
    .pb-emojis button { width: 28px; height: 28px; border: 0; background: transparent; border-radius: 6px; cursor: pointer; font-size: 15px; }
    .pb-emojis button:hover { background: #eef2ff; }
    .pb-item { border: 1px solid var(--pb-bd); border-radius: 9px; background: var(--pb-bg); }
    .pb-item-h { display: flex; align-items: center; gap: 6px; padding: 7px 8px 7px 10px; font-size: 12px; font-weight: 700; }
    .pb-item-h span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pb-item-b { padding: 0 10px 10px; display: flex; flex-direction: column; gap: 8px; }
    .pb-chips { display: flex; flex-wrap: wrap; gap: 4px; }
    .pb-chips button { border: 1px solid #c7d2fe; background: #eef2ff; color: #4338ca; border-radius: 20px; padding: 2px 8px; font: 600 10.5px 'IBM Plex Mono',monospace; cursor: pointer; }

    /* Tema */
    .pb-themes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .pb-theme { border: 1.5px solid var(--pb-bd); border-radius: 11px; padding: 10px; cursor: pointer; text-align: left; transition: all .12s; }
    .pb-theme:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(15,23,42,.1); }
    .pb-theme.on { border-color: var(--pb-ac); box-shadow: 0 0 0 3px #eef2ff; }
    .pb-theme-dots { display: flex; gap: 3px; margin-bottom: 8px; }
    .pb-theme-dots i { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.8); box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
    .pb-theme b { display: block; font-size: 13px; }
    .pb-theme small { font-size: 10px; opacity: .7; }

    .pb-toast { position: absolute; left: 14px; right: 14px; bottom: 14px; background: #1e1b4b; color: #fff; border-radius: 10px; padding: 10px 14px; font-size: 12.5px; font-weight: 600; box-shadow: 0 10px 30px rgba(30,27,75,.35); animation: pb-toast .2s ease-out; z-index: 5; }
    @@keyframes pb-toast { from { transform: translateY(10px); opacity: 0; } }
    .pb-modal-imp { position: absolute; inset: 0; background: rgba(255,255,255,.97); z-index: 6; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .pb-modal-imp textarea { flex: 1; border: 1.5px solid var(--pb-bd); border-radius: 10px; padding: 10px; font: 11.5px 'IBM Plex Mono',monospace; resize: none; outline: none; }

    /* Palco do preview */
    .pb-stage { position: fixed; left: 384px; top: 0; right: 0; bottom: 0; z-index: 8999; background: #e9edf3; background-image: radial-gradient(#d5dbe5 1px, transparent 1px); background-size: 18px 18px; display: flex; flex-direction: column; }
    .pb-stage-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 16px; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); border-bottom: 1px solid #dde3ec; font-family: 'IBM Plex Sans',sans-serif; flex-shrink: 0; }
    .pb-stage-bar .pb-seg { flex-wrap: nowrap; }
    .pb-stage-bar .pb-seg button { padding: 5px 10px; }
    .pb-stage-info { font-size: 11.5px; color: #64748b; display: flex; align-items: center; gap: 10px; }
    .pb-scroll { flex: 1; overflow-y: auto; padding: 22px 22px 60px; }
    .pb-frame { margin: 0 auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 3px rgba(15,23,42,.08), 0 20px 50px rgba(15,23,42,.16); transition: max-width .3s ease; min-height: calc(100% - 10px); max-width: 1280px; }
    .pb-frame.pb-dev-tablet { max-width: 820px; }
    .pb-frame.pb-dev-mobile { max-width: 390px; border-radius: 28px; border: 10px solid #0f172a; }
    .pb-frame > .evl-root { min-height: 100%; }
    .pb-empty { padding: 60px 30px; text-align: center; font-family: 'IBM Plex Sans',sans-serif; color: #334155; }
    .pb-empty h2 { font-size: 24px; margin: 10px 0 6px; color: #0f172a; }
    .pb-empty p { color: #64748b; margin: 0 0 22px; font-size: 14px; }
    .pb-empty .pb-tpls { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); max-width: 760px; margin: 0 auto; }

    /* Interações dentro do preview */
    .pb-frame [data-sid] { cursor: pointer; }
    .pb-frame [data-sid]::after { content: ""; position: absolute; inset: 0; border: 2px solid transparent; pointer-events: none; z-index: 29; transition: border-color .12s; }
    .pb-frame.pb-guias [data-sid]::after { border: 1px dashed rgba(99,102,241,.35); }
    .pb-frame [data-sid]:hover::after { border-color: rgba(99,102,241,.5); }
    .pb-frame [data-sid].pbx-sel::after { border: 2px solid #6366f1; }
    .pbx-tools { position: absolute; top: 8px; right: 8px; z-index: 30; display: none; gap: 1px; align-items: center; background: #1e1b4b; border-radius: 9px; padding: 3px; box-shadow: 0 6px 20px rgba(30,27,75,.35); font: 600 11px/1 'IBM Plex Sans',sans-serif; }
    [data-sid]:hover > .pbx-tools, [data-sid].pbx-sel > .pbx-tools { display: flex; }
    .pbx-tools button { border: 0; background: transparent; color: #e0e7ff; width: 25px; height: 25px; border-radius: 6px; cursor: pointer; font-size: 12px; padding: 0; }
    .pbx-tools button:hover { background: rgba(255,255,255,.16); color: #fff; }
    .pbx-tools .pbx-del:hover { background: #ef4444; }
    .pbx-lbl { color: #fff; padding: 0 8px 0 6px; white-space: nowrap; }
    .pbx-add { position: absolute; left: 50%; bottom: 6px; transform: translateX(-50%); z-index: 31; width: 28px; height: 28px; border-radius: 50%; border: 2px solid #fff; background: #6366f1; color: #fff; display: none; place-items: center; cursor: pointer; font-size: 15px; line-height: 1; box-shadow: 0 4px 14px rgba(99,102,241,.45); padding: 0; }
    [data-sid]:hover > .pbx-add, [data-sid].pbx-sel > .pbx-add { display: grid; }
    .pbx-add:hover { transform: translateX(-50%) scale(1.12); }
    .pbx-add.pbx-add-txt { background: #10b981; box-shadow: 0 4px 14px rgba(16,185,129,.45); transform: translateX(calc(-50% - 36px)); font-size: 13px; }
    .pbx-add.pbx-add-txt:hover { transform: translateX(calc(-50% - 36px)) scale(1.12); }
    .pb-frame [data-edit] { outline: none; border-radius: 4px; cursor: text; transition: box-shadow .12s, background .12s; }
    .pb-frame [data-edit]:hover { box-shadow: 0 0 0 1px rgba(99,102,241,.55); }
    .pb-frame [data-edit]:focus { box-shadow: 0 0 0 2px #6366f1; background: rgba(99,102,241,.07); }
    .pb-frame [data-ph]:empty::before { content: attr(data-ph); opacity: .42; font-style: italic; font-weight: 400; }
    .pb-frame [data-sid]:not(:hover):not(.pbx-sel) [data-ph]:empty:not(:focus) { display: none; }
    .pbx-oculta { opacity: .38; filter: grayscale(.7); }
    .pbx-espaco { display: grid; place-items: center; background: repeating-linear-gradient(45deg, transparent 0 8px, rgba(99,102,241,.07) 8px 16px); border: 1px dashed rgba(99,102,241,.35); border-radius: 6px; font: 600 11px 'IBM Plex Sans',sans-serif; color: #6366f1; }
    .pb-limpo .pbx-tools, .pb-limpo .pbx-add, .pb-limpo .pbx-oculta { display: none !important; }
    .pb-limpo [data-sid]::after { display: none; }
    .pb-limpo [data-edit]:hover { box-shadow: none; }
    .pb-limpo [data-ph]:empty, .pb-limpo .pbx-espaco span { display: none; }
    /* Texto livre (escrita direto no preview) */
    .pb-frame [data-rich] { min-height: 3.2em; padding: 6px 8px; margin: -6px -8px; }
    .pb-frame [data-sid]:not(:hover):not(.pbx-sel) [data-rich][data-ph]:empty:not(:focus) { display: block; }
    .pb-frame [data-rich]:empty::before { display: block; }
    .pb-frame [data-rich]:focus { background: rgba(99,102,241,.035); }
    .pb-frame [data-rich] img { cursor: default; }
    .pb-limpo [data-rich] { min-height: 0; }
    .pbx-toc-vazio small { display: block; opacity: .6; font-size: .85em; }
    .pb-limpo .pbx-toc-vazio { display: none; }
    .pb-rtb { position: fixed; z-index: 10050; display: flex; align-items: center; gap: 1px; background: #1e1b4b; border-radius: 10px; padding: 4px; box-shadow: 0 10px 30px rgba(30,27,75,.38); font: 600 12px/1 'IBM Plex Sans',sans-serif; user-select: none; }
    .pb-rtb[hidden] { display: none; }
    .pb-rtb button { border: 0; background: transparent; color: #e0e7ff; min-width: 28px; height: 28px; border-radius: 7px; cursor: pointer; font: inherit; font-size: 12.5px; padding: 0 6px; }
    .pb-rtb button:hover { background: rgba(255,255,255,.14); color: #fff; }
    .pb-rtb button.on { background: #6366f1; color: #fff; }
    .pb-rtb .sep { width: 1px; height: 18px; background: rgba(255,255,255,.18); margin: 0 3px; }
    .pb-limpo .pbx-espaco { background: none; border: 0; }

    @@media (max-width: 900px) {
        .pb-drawer { width: 100vw; }
        .pb-stage { display: none; }
    }

    .be-layout-preview-inline {
        width: 100%;
        overflow-y: auto;
        padding: 0;
        container: evl / inline-size;
    }
</style>

<div class="blog-editor-root">

    <!-- Topbar -->
    <div class="be-topbar">
        <div class="be-topbar-left">
            <button class="be-btn-back" @onclick="Voltar" title="Voltar">←</button>
            <input class="be-post-title-input"
                   placeholder="Título do post..."
                   @bind="titulo"
                   @bind:event="oninput" />
            <span class="be-badge @status">
                @(status == "publicado" ? "Publicado" : "Rascunho")
            </span>

            <button class="be-btn-secondary" @onclick="AbrirLayout" title="Page Builder: monte o visual do post">
                <span>🎨</span> Layout
                @if (_layout.Secoes.Count > 0)
                {
                    <span class="pb-dot @(_layoutSujo ? "sujo" : "")" title="@(_layoutSujo ? "Layout com alterações não salvas" : "Post com layout personalizado")"></span>
                }
            </button>
        </div>
        <div class="be-topbar-right">
            @if (!string.IsNullOrWhiteSpace(mensagem))
            {
                <span class="be-alert @tipoMensagem" style="margin:0; padding:6px 10px;">@mensagem</span>
            }
            <select class="be-select" @bind="status">
                <option value="rascunho">Rascunho</option>
                <option value="publicado">Publicado</option>
            </select>
            <button class="be-btn primary" disabled="@salvando" @onclick="Salvar">
                @(salvando ? "Salvando..." : "Salvar")
            </button>
        </div>
    </div>

    <div class="be-body">

        <!-- Sidebar -->
        <aside class="be-sidebar">

            <div class="be-sidebar-section">
                <div class="be-sidebar-label">Metadados</div>

                <div class="be-field">
                    <div class="be-field-label">Slug (URL)</div>
                    <input class="be-input" @bind="slug" placeholder="titulo-do-post" />
                </div>

                <div class="be-field">
                    <div class="be-field-label">Imagem de Capa</div>
                    <label for="be-cover-input" class="be-cover-preview" style="cursor:pointer">
                        @if (!string.IsNullOrEmpty(imagemPath))
                        {
                            <img src="@imagemPath" alt="Capa" />
                        }
                        else
                        {
                            <span>🖼 Clique para enviar imagem</span>
                        }
                    </label>
                    @if (!string.IsNullOrEmpty(imagemPath))
                    {
                        <div class="be-cover-actions">
                            <label for="be-cover-input" class="be-cover-btn" style="cursor:pointer">Trocar</label>
                            <button type="button" class="be-cover-btn danger" @onclick="() => imagemPath = null">Remover</button>
                        </div>
                    }
                    <InputFile id="be-cover-input" OnChange="UploadCover"
                               accept="image/png,image/jpeg,image/webp,image/gif"
                               style="display:none" />
                </div>

                <div class="be-field">
                    <div class="be-field-label">Resumo / Descrição</div>
                    <textarea class="be-textarea" @bind="resumo"
                              placeholder="Breve resumo exibido na listagem..."></textarea>
                </div>
            </div>

            <div class="be-sidebar-section">
                <div class="be-sidebar-label">Dicas de uso</div>
                <div style="font-size:11px; color:#64748b; line-height:1.5;">
                    <p style="margin:0 0 6px;">Digite <strong>/</strong> para inserir blocos: títulos, imagens, vídeos, tabelas, destaques.</p>
                    <p style="margin:0 0 6px;">Cole prints diretamente com <strong>Ctrl+V</strong>.</p>
                    <p style="margin:0;">Arraste a alça no canto da imagem para redimensionar.</p>
                </div>
            </div>
        </aside>

        <!-- Editor -->
        <div class="be-editor-wrap">

            <!-- Toolbar -->
            <div class="be-toolbar">
                <select class="be-tb-select" title="Tipo de bloco" @onchange="OnBlockTypeChange">
                    <option value="p">Parágrafo</option>
                    <option value="h1">Título 1</option>
                    <option value="h2">Título 2</option>
                    <option value="h3">Título 3</option>
                    <option value="pre">Código</option>
                </select>

                <div class="be-tb-sep"></div>

                <button class="be-tb-btn" title="Negrito (Ctrl+B)" @onclick='() => ExecCmd("bold")'><strong>B</strong></button>
                <button class="be-tb-btn" title="Itálico (Ctrl+I)" @onclick='() => ExecCmd("italic")'><em>I</em></button>
                <button class="be-tb-btn" title="Link (Ctrl+K)" @onclick="AbrirModalLink">🔗</button>
                <button class="be-tb-btn" title="Sublinhado (Ctrl+U)" @onclick='() => ExecCmd("underline")' style="text-decoration:underline;">U</button>
                <button class="be-tb-btn" title="Riscado" @onclick='() => ExecCmd("strikethrough")' style="text-decoration:line-through;">S</button>
                <button class="be-tb-btn" title="Destacar" @onclick="AplicarDestaque">M</button>

                <div class="be-tb-sep"></div>

                <button class="be-tb-btn" title="Lista com marcadores" @onclick='() => ExecCmd("insertUnorderedList")'>≡</button>
                <button class="be-tb-btn" title="Lista numerada" @onclick='() => ExecCmd("insertOrderedList")'>1.</button>
                <button class="be-tb-btn" title="Citação" @onclick="InserirBlockquote">❝</button>

                <div class="be-tb-sep"></div>

                <button class="be-tb-btn" title="Alinhar à esquerda" @onclick='() => ExecCmd("justifyLeft")'>⬛</button>
                <button class="be-tb-btn" title="Centralizar" @onclick='() => ExecCmd("justifyCenter")'>☰</button>

                <div class="be-tb-sep"></div>

                <button class="be-tb-insert-btn" @onclick="TriggerImageInput">🖼 Imagem</button>
                <button class="be-tb-insert-btn" @onclick="AbrirModalVideo">▶ Vídeo</button>
                <button class="be-tb-insert-btn" @onclick="InserirTabela">⊞ Tabela</button>
                <button class="be-tb-insert-btn" @onclick='() => ExecCmd("insertHorizontalRule")'>— Divisor</button>
                <button class="be-tb-insert-btn" @onclick="InserirCallout">💡 Destaque</button>

                <InputFile id="be-img-input" OnChange="OnImagemSelecionada"
                           accept="image/png,image/jpeg,image/webp,image/gif"
                           style="display:none" />
            </div>

            <!-- Área do editor -->
            <!-- Área do editor -->
<div class="be-content-scroll">
    <div class="be-content-inner">

        @if (_layout.Secoes.Count > 0 && !_modalLayoutAberto)
        {
            @* Layout ativo: mostra o preview no lugar do editor de texto *@
            var pvCtx = CtxPreview();
            var pvLista = _layout.Secoes.OrderBy(x => x.Ordem).ToList();
            <div class="be-layout-preview-inline">
                @((MarkupString)LayoutRenderer.FontesLink(_layout))
                <div class="@LayoutRenderer.ClassesRaiz(_layout)" style="@LayoutRenderer.VarsCss(_layout)">
                    @foreach (var s in pvLista.Where(x => !x.Oculta))
                    {
                        <div @key="s.Id">@((MarkupString)LayoutRenderer.Secao(s, _layout, pvCtx, pvLista))</div>
                    }
                </div>
            </div>
        }
        else
        {
            <div @key="@("be-editor-fixo")"
                 id="be-editor"
                 class="be-editor"
                 contenteditable="true"
                 spellcheck="true"
                 data-placeholder="Comece a escrever ou digite / para inserir blocos...">
                @((MarkupString)_htmlInicial)
            </div>
        }

    </div>
</div>
        </div>
    </div>

    @if (_modalLayoutAberto)
    {
        var pvCtx = CtxPreview();
        var pvLista = _layout.Secoes.OrderBy(x => x.Ordem).ToList();
        var sel = _secaoEditando;

        <!-- ═══════════ PAGE BUILDER: drawer esquerdo ═══════════ -->
        <div class="pb-drawer">
            <div class="pb-head">
                <div class="pb-head-l">
                    <div class="pb-logo">🎨</div>
                    <div>
                        <b>Page Builder</b>
                        <small class="@(_layoutSujo ? "sujo" : "")">@(_layoutSujo ? "● Não salvo" : "✓ Salvo")</small>
                    </div>
                </div>
                <div class="pb-head-r">
                    <button class="pb-ic" title="Desfazer (Ctrl+Z)" disabled="@(_undo.Count == 0)" @onclick="Desfazer">↶</button>
                    <button class="pb-ic" title="Refazer (Ctrl+Y)" disabled="@(_redo.Count == 0)" @onclick="Refazer">↷</button>
                    <button class="pb-save" title="Salvar layout (Ctrl+S)" @onclick="SalvarLayout">💾 Salvar</button>
                    <button class="pb-ic" title="Fechar" @onclick="FecharLayout">✕</button>
                </div>
            </div>

            <div class="pb-tabs">
                <button class="pb-tab @(_abaDrawer == "estrutura" ? "on" : "")" @onclick='() => _abaDrawer = "estrutura"'>☰ Estrutura <span class="pb-count">@_layout.Secoes.Count</span></button>
                <button class="pb-tab @(_abaDrawer == "blocos" ? "on" : "")" @onclick='() => _abaDrawer = "blocos"'>＋ Blocos</button>
                <button class="pb-tab @(_abaDrawer == "editar" ? "on" : "")" @onclick='() => _abaDrawer = "editar"'>✎ Editar</button>
                <button class="pb-tab @(_abaDrawer == "tema" ? "on" : "")" @onclick='() => _abaDrawer = "tema"'>◐ Tema</button>
            </div>

            <div class="pb-body">

                @* ─────────────── ESTRUTURA ─────────────── *@
                @if (_abaDrawer == "estrutura")
                {
                    <div class="pb-lbl">Blocos da página <span style="text-transform:none; letter-spacing:0; font-weight:600;">arraste para reordenar</span></div>

                    @if (!pvLista.Any())
                    {
                        <div class="pb-hint" style="text-align:center; padding:14px 6px;">Nenhum bloco ainda. Escolha um modelo abaixo ou adicione blocos um a um.</div>
                    }

                    <div class="pb-list">
                        @foreach (var s in pvLista)
                        {
                            var info = LayoutPresets.Info(s.Tipo);
                            <div class="@ClasseLinha(s)" draggable="true"
                                 @key="s.Id"
                                 @onclick="() => Selecionar(s, true)"
                                 @ondragstart="() => IniciarArraste(s.Id)"
                                 @ondragenter="() => _sobreId = s.Id"
                                 @ondragover:preventDefault="true"
                                 @ondrop="() => SoltarSobre(s.Id)"
                                 @ondragend="FimArraste">
                                <span class="pb-grip">⠿</span>
                                <span class="pb-row-ico" style="background:@FundoMiniatura(s)">@info.Icone</span>
                                <div class="pb-row-txt">
                                    <b>@info.Nome</b>
                                    <span>@ResumoSecao(s)</span>
                                </div>
                                <div class="pb-row-act" @onclick:stopPropagation="true">
                                    <button class="pb-mini" title="@(s.Oculta ? "Mostrar" : "Ocultar")" @onclick="() => AlternarOculta(s.Id)">@(s.Oculta ? "◉" : "◌")</button>
                                    <button class="pb-mini" title="Duplicar" @onclick="() => Duplicar(s.Id)">⧉</button>
                                    <button class="pb-mini del" title="Remover" @onclick="() => Remover(s.Id)">✕</button>
                                </div>
                            </div>
                        }
                    </div>

                    <button class="pb-add-big" @onclick="AbrirBiblioteca">＋ Adicionar bloco</button>

                    <div class="pb-lbl" style="margin-top:6px;">Modelos prontos</div>
                    <div class="pb-hint">Aplica uma estrutura completa. Dá para desfazer com <code>Ctrl+Z</code>.</div>
                    <div class="pb-tpls">
                        @foreach (var t in LayoutPresets.Templates)
                        {
                            <button class="pb-tpl @(_layout.TemplateBase == t.Chave ? "on" : "")" @onclick="() => AplicarTemplate(t.Chave)">
                                <i>@t.Icone</i><b>@t.Nome</b><span>@t.Descricao</span>
                            </button>
                        }
                    </div>
                }

                @* ─────────────── BIBLIOTECA ─────────────── *@
                @if (_abaDrawer == "blocos")
                {
                    <input class="pb-search" placeholder="🔍  Buscar bloco (ex.: faq, vídeo, números)…" @bind="_buscaBloco" @bind:event="oninput" />
                    <div class="pb-hint">
                        @if (_inserirApos is int pos && pos >= 0 && pos < pvLista.Count)
                        {
                            <text>Será inserido <b>abaixo de “@LayoutPresets.Info(pvLista[pos].Tipo).Nome”</b>.</text>
                        }
                        else if (sel is not null)
                        {
                            <text>Será inserido <b>abaixo do bloco selecionado</b>.</text>
                        }
                        else
                        {
                            <text>Será inserido <b>no fim da página</b>.</text>
                        }
                    </div>
                    @foreach (var cat in LayoutPresets.Categorias)
                    {
                        var blocos = LayoutPresets.Blocos.Where(b => b.Categoria == cat && CombinaBusca(b)).ToList();
                        if (blocos.Count == 0) continue;
                        <div class="pb-lbl">@cat</div>
                        <div class="pb-blocks">
                            @foreach (var b in blocos)
                            {
                                var usado = b.Tipo == "conteudo" && _layout.Secoes.Any(x => x.Tipo == "conteudo");
                                <button class="pb-block @(usado ? "usado" : "")" title="@(usado ? "Já existe um bloco de conteúdo" : b.Descricao)" @onclick="() => AdicionarBloco(b.Tipo)">
                                    <i>@b.Icone</i><b>@b.Nome</b><span>@b.Descricao</span>
                                </button>
                            }
                        </div>
                    }
                }

                @* ─────────────── EDITAR ─────────────── *@
                @if (_abaDrawer == "editar")
                {
                    @if (sel is null)
                    {
                        <div class="pb-hint" style="text-align:center; padding:40px 10px;">
                            <div style="font-size:30px; margin-bottom:8px;">👆</div>
                            Clique em qualquer bloco no preview (ou na aba Estrutura) para editar.<br /><br />
                            Dica: clique <b>direto no texto</b> do preview para editar ali mesmo.
                        </div>
                    }
                    else
                    {
                        var s = sel;
                        var info = LayoutPresets.Info(s.Tipo);
                        var pos = pvLista.FindIndex(x => x.Id == s.Id);
                        <div @onfocusin="RegistrarFoco" style="display:contents">
                            <div class="pb-edit-head">
                                <span class="pb-row-ico" style="background:@FundoMiniatura(s)">@info.Icone</span>
                                <div><b>@info.Nome</b><small>Bloco @(pos + 1) de @pvLista.Count</small></div>
                                <div class="pb-edit-nav">
                                    <button class="pb-ic" title="Bloco anterior" disabled="@(pos <= 0)" @onclick="() => Navegar(-1)">‹</button>
                                    <button class="pb-ic" title="Próximo bloco" disabled="@(pos >= pvLista.Count - 1)" @onclick="() => Navegar(1)">›</button>
                                </div>
                            </div>

                            @if (s.Tipo is not ("espaco" or "divider"))
                            {
                                <div class="pb-lbl">Estilos rápidos</div>
                                <div class="pb-quick">
                                    @foreach (var e in LayoutPresets.EstilosRapidos)
                                    {
                                        <button title="@e.Nome" style="background:@AmostraEstilo(e)" @onclick="() => AplicarEstiloRapido(s, e)"></button>
                                    }
                                </div>
                            }

                            @* Conteúdo *@
                            <details class="pb-grp" open>
                                <summary>✏️ Conteúdo</summary>
                                <div class="pb-grp-body">
                                    @PainelConteudo(s)
                                </div>
                            </details>

                            @if (LayoutPresets.Info(s.Tipo).TemItens)
                            {
                                <details class="pb-grp" open>
                                    <summary>🧩 Itens <span class="pb-count" style="background:#e0e7ff;color:#4f46e5;border-radius:10px;padding:0 6px;font-size:10px;">@s.Itens.Count</span></summary>
                                    <div class="pb-grp-body">
                                        @PainelItens(s)
                                    </div>
                                </details>
                            }

                            @if (s.Tipo != "espaco")
                            {
                                <details class="pb-grp">
                                    <summary>🖌️ Fundo</summary>
                                    <div class="pb-grp-body">
                                        @Seg("", s.FundoTipo, new[] { ("nenhum", "Nenhum"), ("cor", "Cor"), ("gradiente", "Degradê"), ("imagem", "Imagem"), ("capa", "Capa") }, v => s.FundoTipo = v)
                                        @if (s.FundoTipo == "cor")
                                        {
                                            @CampoCor("Cor de fundo", s.CorFundo, v => s.CorFundo = v)
                                        }
                                        @if (s.FundoTipo == "gradiente")
                                        {
                                            <div class="pb-2">
                                                @CampoCor("Cor inicial", s.CorFundo, v => s.CorFundo = v, "#2563eb")
                                                @CampoCor("Cor final", s.CorFundo2, v => s.CorFundo2 = v, "#0ea5e9")
                                            </div>
                                            @Faixa("Ângulo", s.GradienteAngulo, 0, 360, v => s.GradienteAngulo = v, "°", 5)
                                        }
                                        @if (s.FundoTipo is "imagem" or "capa")
                                        {
                                            @if (s.FundoTipo == "imagem")
                                            {
                                                @CampoImagem("Imagem de fundo", s.ImagemFundo, v => s.ImagemFundo = v)
                                            }
                                            else
                                            {
                                                <div class="pb-hint">Usa a <b>imagem de capa</b> do post (barra lateral do editor).@(string.IsNullOrEmpty(imagemPath) ? " Nenhuma capa enviada ainda — enquanto isso, mostra um degradê." : "")</div>
                                            }
                                            @CampoCor("Cor da película", s.CorOverlay, v => s.CorOverlay = v, "#0f172a", false)
                                            @Faixa("Opacidade da película", s.OverlayOpacidade, 0, 100, v => s.OverlayOpacidade = v, "%")
                                            @Chave("Efeito parallax (fundo fixo)", s.FundoFixo, v => s.FundoFixo = v)
                                        }
                                    </div>
                                </details>

                                <details class="pb-grp">
                                    <summary>🔤 Cores e texto</summary>
                                    <div class="pb-grp-body">
                                        @Seg("Alinhamento", s.Alinhamento, new[] { ("esquerda", "⟸ Esquerda"), ("centro", "⟺ Centro"), ("direita", "Direita ⟹") }, v => s.Alinhamento = v)
                                        @CampoCor("Cor do texto", s.CorTexto, v => s.CorTexto = v, "#1e293b")
                                        @CampoCor("Cor dos títulos", s.CorTitulo, v => s.CorTitulo = v, "#0f172a")
                                        @CampoCor("Cor de destaque (botões, ícones)", s.CorDestaque, v => s.CorDestaque = v, "#2563eb")
                                        @Faixa("Tamanho do título", s.EscalaTitulo, 60, 180, v => s.EscalaTitulo = v, "%", 5)
                                    </div>
                                </details>
                            }

                            <details class="pb-grp">
                                <summary>📐 Tamanho e espaçamento</summary>
                                <div class="pb-grp-body">
                                    @if (s.Tipo != "espaco")
                                    {
                                        @Seg("Formato", s.Formato, new[] { ("faixa", "▬ Faixa inteira"), ("cartao", "▢ Cartão") }, v => s.Formato = v)
                                        @Seg("Largura do conteúdo", s.Largura, new[] { ("estreita", "Estreita"), ("contida", "Normal"), ("larga", "Larga"), ("total", "Total") }, v => s.Largura = v)
                                    }
                                    @if (s.Tipo == "hero")
                                    {
                                        @Seg("Altura", s.Altura, new[] { ("auto", "Auto"), ("media", "Média"), ("grande", "Grande"), ("tela", "Tela cheia") }, v => s.Altura = v)
                                    }
                                    @Faixa(s.Tipo == "espaco" ? "Altura do espaço" : "Espaço acima", s.PaddingV, 0, 240, v => s.PaddingV = v, "px", 4)
                                    @if (s.Tipo != "espaco")
                                    {
                                        @Chave("Espaço abaixo igual ao de cima", s.PaddingBase < 0, v => s.PaddingBase = v ? -1 : s.PaddingV)
                                        @if (s.PaddingBase >= 0)
                                        {
                                            @Faixa("Espaço abaixo", s.PaddingBase, 0, 240, v => s.PaddingBase = v, "px", 4)
                                        }
                                        @Faixa("Margem lateral", s.PaddingLateral, 0, 96, v => s.PaddingLateral = v, "px", 4)
                                    }
                                </div>
                            </details>

                            @if (s.Tipo is not ("espaco"))
                            {
                                <details class="pb-grp">
                                    <summary>🔲 Borda e sombra</summary>
                                    <div class="pb-grp-body">
                                        @Seg("Borda", s.BordaEstilo, new[] { ("nenhuma", "Nenhuma"), ("esquerda", "▌Esquerda"), ("topo", "▀ Topo"), ("completa", "▢ Toda") }, v => s.BordaEstilo = v)
                                        @if (s.BordaEstilo != "nenhuma" || s.Tipo is "divider" || (s.Tipo == "caixa" && s.Variante == "custom"))
                                        {
                                            @CampoCor(s.Tipo == "divider" ? "Cor da linha" : "Cor da borda", s.CorBorda, v => s.CorBorda = v, "#2563eb")
                                        }
                                        @if (s.BordaEstilo != "nenhuma")
                                        {
                                            @Faixa("Espessura", s.BordaEspessura, 1, 12, v => s.BordaEspessura = v, "px")
                                        }
                                        @Chave("Arredondamento do tema", s.Raio < 0, v => s.Raio = v ? -1 : _layout.Raio)
                                        @if (s.Raio >= 0)
                                        {
                                            @Faixa("Arredondamento", s.Raio, 0, 48, v => s.Raio = v, "px")
                                        }
                                        @Seg("Sombra", s.Sombra, new[] { ("tema", "Tema"), ("nenhuma", "Sem"), ("suave", "Suave"), ("media", "Média"), ("forte", "Forte") }, v => s.Sombra = v)
                                        @if (s.Formato != "cartao")
                                        {
                                            <small class="pb-hint">Arredondamento e sombra aparecem no formato <b>Cartão</b> e nos elementos internos (cards, imagens, botões).</small>
                                        }
                                    </div>
                                </details>
                            }

                            @if (s.Formato != "cartao" && s.Tipo != "espaco")
                            {
                                <details class="pb-grp">
                                    <summary>〰️ Divisores (formas)</summary>
                                    <div class="pb-grp-body">
                                        @Seg("Topo", s.DecoracaoTopo, FormasDivisor, v => s.DecoracaoTopo = v)
                                        @Seg("Base", s.DecoracaoBase, FormasDivisor, v => s.DecoracaoBase = v)
                                        @CampoCor("Cor da forma", s.CorDecoracao, v => s.CorDecoracao = v, "#f0f6ff")
                                        <small class="pb-hint">Sem cor definida, a forma usa automaticamente a cor do bloco vizinho, criando uma transição suave.</small>
                                    </div>
                                </details>
                            }

                            <details class="pb-grp">
                                <summary>⚙️ Avançado</summary>
                                <div class="pb-grp-body">
                                    <div class="pb-f">
                                        <label>Animação ao aparecer</label>
                                        <select @bind:get="s.Animacao" @bind:set="@(v => { Registrar(); s.Animacao = v; })">
                                            <option value="tema">Padrão do tema</option>
                                            <option value="nenhuma">Nenhuma</option>
                                            <option value="fade">Surgir (fade)</option>
                                            <option value="subir">Subir</option>
                                            <option value="zoom">Zoom</option>
                                            <option value="esquerda">Deslizar da esquerda</option>
                                            <option value="direita">Deslizar da direita</option>
                                        </select>
                                    </div>
                                    @Campo("Âncora (id para links #)", s.Ancora, v => s.Ancora = v, "ex.: precos")
                                    @Chave("Ocultar no celular", s.OcultarMobile, v => s.OcultarMobile = v)
                                    @Chave("Ocultar no computador", s.OcultarDesktop, v => s.OcultarDesktop = v)
                                    @Chave("Ocultar bloco (rascunho)", s.Oculta, v => s.Oculta = v)
                                    <div class="pb-2">
                                        <button class="pb-btn-sm" @onclick="() => Duplicar(s.Id)">⧉ Duplicar</button>
                                        <button class="pb-btn-sm danger" @onclick="() => Remover(s.Id)">✕ Remover</button>
                                    </div>
                                </div>
                            </details>
                        </div>
                    }
                }

                @* ─────────────── TEMA ─────────────── *@
                @if (_abaDrawer == "tema")
                {
                    <div @onfocusin="RegistrarFoco" style="display:contents">
                        <div class="pb-lbl">Temas</div>
                        <div class="pb-themes">
                            @foreach (var t in LayoutPresets.Temas)
                            {
                                <div class="pb-theme @(_layout.Tema == t.Chave ? "on" : "")" style="background:@t.Fundo; color:@t.Titulos;" @onclick="() => AplicarTema(t.Chave)">
                                    <div class="pb-theme-dots"><i style="background:@t.Primaria"></i><i style="background:@t.Secundaria"></i><i style="background:@t.Superficie"></i><i style="background:@t.Texto"></i></div>
                                    <b style="font-family:@LayoutRenderer.Familia(t.FonteTitulos)">@t.Nome</b>
                                    <small>@t.FonteTitulos</small>
                                </div>
                            }
                        </div>

                        <details class="pb-grp" open>
                            <summary>🎨 Cores</summary>
                            <div class="pb-grp-body">
                                <div class="pb-2">
                                    @CampoCor("Primária", _layout.CorPrimaria, v => _layout.CorPrimaria = v, "#2563eb", false)
                                    @CampoCor("Secundária", _layout.CorSecundaria, v => _layout.CorSecundaria = v, "#0ea5e9", false)
                                    @CampoCor("Fundo da página", _layout.CorFundoGeral, v => _layout.CorFundoGeral = v, "#f0f6ff", false)
                                    @CampoCor("Superfície (cards)", _layout.CorSuperficie, v => _layout.CorSuperficie = v, "#ffffff", false)
                                    @CampoCor("Texto", _layout.CorTexto, v => _layout.CorTexto = v, "#1e293b", false)
                                    @CampoCor("Títulos", _layout.CorTitulos, v => _layout.CorTitulos = v, "#0f172a", false)
                                </div>
                                @CampoCor("Links (vazio = primária)", _layout.CorLinks, v => _layout.CorLinks = v, "#2563eb", false)
                            </div>
                        </details>

                        <details class="pb-grp" open>
                            <summary>🔠 Tipografia</summary>
                            <div class="pb-grp-body">
                                <div class="pb-2">
                                    @SeletorFonte("Fonte dos títulos", _layout.FonteTitulos, v => _layout.FonteTitulos = v)
                                    @SeletorFonte("Fonte do texto", _layout.FonteCorpo, v => _layout.FonteCorpo = v)
                                </div>
                                @Faixa("Tamanho do texto", _layout.TamanhoFonte, 14, 22, v => _layout.TamanhoFonte = v, "px")
                                @Faixa("Altura da linha", _layout.AlturaLinha, 130, 220, v => _layout.AlturaLinha = v, "%", 5)
                                @Seg("Peso dos títulos", _layout.PesoTitulos.ToString(), new[] { ("600", "Médio"), ("700", "Negrito"), ("800", "Extra") }, v => _layout.PesoTitulos = int.Parse(v))
                                @Seg("Títulos no texto (H2)", _layout.EstiloTitulosConteudo, new[] { ("simples", "Simples"), ("linha", "Sublinhado"), ("barra", "Barra"), ("marcador", "Marcador") }, v => _layout.EstiloTitulosConteudo = v)
                            </div>
                        </details>

                        <details class="pb-grp" open>
                            <summary>📐 Estrutura</summary>
                            <div class="pb-grp-body">
                                @Faixa("Largura do conteúdo", _layout.LarguraMaxima, 600, 1200, v => _layout.LarguraMaxima = v, "px", 20)
                                @Faixa("Arredondamento", _layout.Raio, 0, 32, v => _layout.Raio = v, "px")
                                @Faixa("Espaço entre blocos", _layout.EspacoSecoes, 0, 48, v => _layout.EspacoSecoes = v, "px", 2)
                                @Seg("Sombras", _layout.Sombra, new[] { ("nenhuma", "Sem"), ("suave", "Suave"), ("media", "Média"), ("forte", "Forte") }, v => _layout.Sombra = v)
                                @Chave("Animações ao rolar a página", _layout.Animacoes, v => _layout.Animacoes = v)
                                @Chave("Barra de progresso de leitura", _layout.BarraProgresso, v => _layout.BarraProgresso = v)
                            </div>
                        </details>

                        <details class="pb-grp">
                            <summary>🧰 Ferramentas</summary>
                            <div class="pb-grp-body">
                                <div class="pb-hint">Reaproveite um layout em outro post: copie aqui e cole no outro.</div>
                                <div class="pb-2">
                                    <button class="pb-btn-sm" @onclick="CopiarLayout">📋 Copiar layout</button>
                                    <button class="pb-btn-sm" @onclick="AbrirImportar">📥 Colar layout</button>
                                    <button class="pb-btn-sm" @onclick="BaixarLayout">⬇ Baixar .json</button>
                                    <button class="pb-btn-sm danger" @onclick="LimparLayout">🗑 Remover layout</button>
                                </div>
                                <small class="pb-hint">Sem blocos, o post volta a usar o visual padrão do site.</small>
                            </div>
                        </details>
                    </div>
                }
            </div>

            <InputFile id="pb-upload" OnChange="UploadImagemPb" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" style="display:none" />

            @if (_importAberto)
            {
                <div class="pb-modal-imp">
                    <div class="pb-lbl">Colar layout (JSON)</div>
                    <textarea @bind="_importTexto" @bind:event="oninput" placeholder="Cole aqui o layout copiado de outro post…"></textarea>
                    <div class="pb-2">
                        <button class="pb-btn-sm" @onclick="() => _importAberto = false">Cancelar</button>
                        <button class="pb-save" @onclick="ImportarLayout">Aplicar layout</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_pbToast))
            {
                <div class="pb-toast">@_pbToast</div>
            }
        </div>

        <!-- ═══════════ PAGE BUILDER: preview ao vivo ═══════════ -->
        <div class="pb-stage">
            <div class="pb-stage-bar">
                @Seg("", _device, new[] { ("desktop", "🖥 Computador"), ("tablet", "▭ Tablet"), ("mobile", "📱 Celular") }, v => _device = v, false)
                <div class="pb-stage-info">
                    <span>@pvLista.Count(x => !x.Oculta) blocos · ⏱ @pvCtx.MinutosLeitura min de leitura</span>
                    <label class="pb-toggle" style="gap:6px;"><input type="checkbox" checked="@_guias" @onchange="() => _guias = !_guias" /><i></i> Guias</label>
                    <label class="pb-toggle" style="gap:6px;"><input type="checkbox" checked="@_modoLimpo" @onchange="() => _modoLimpo = !_modoLimpo" /><i></i> Ver como no site</label>
                </div>
            </div>
            <div class="pb-scroll">
                <div id="pb-preview" class="@ClassesFrame()">
                    @((MarkupString)LayoutRenderer.FontesLink(_layout))
                    @((MarkupString)CssPreview)
                    <div class="@LayoutRenderer.ClassesRaiz(_layout)" style="@LayoutRenderer.VarsCss(_layout)">
                        @if (_layout.BarraProgresso)
                        {
                            @((MarkupString)LayoutRenderer.BarraProgressoHtml)
                        }
                        @if (!pvLista.Any())
                        {
                            <div class="pb-empty">
                                <div style="font-size:44px;">✨</div>
                                <h2>Monte o visual deste post</h2>
                                <p>Comece com um modelo pronto — depois ajuste cada detalhe. O texto do post entra automaticamente.</p>
                                <div class="pb-tpls">
                                    @foreach (var t in LayoutPresets.Templates)
                                    {
                                        <button class="pb-tpl" @onclick="() => AplicarTemplate(t.Chave)"><i>@t.Icone</i><b>@t.Nome</b><span>@t.Descricao</span></button>
                                    }
                                </div>
                            </div>
                        }
                        @foreach (var s in pvLista)
                        {
                            <div @key="s.Id" style="display:contents">@((MarkupString)LayoutRenderer.Secao(s, _layout, pvCtx, pvLista))</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal vídeo -->
@if (modalVideoAberto)
{
    <div class="be-modal-bg" @onclick="FecharModalVideo">
        <div class="be-modal" @onclick:stopPropagation="true">
            <h3>Inserir vídeo</h3>
            <div class="be-field" style="margin-bottom:10px;">
                <div class="be-field-label">URL do vídeo</div>
                <input class="be-input" @bind="videoUrl"
                       placeholder="https://youtube.com/watch?v=... ou https://vimeo.com/..." />
            </div>
            <div style="font-size:11px; color:#64748b;">Suporta YouTube, Vimeo ou link direto de vídeo (mp4, webm).</div>
            <div class="be-modal-actions">
                <button class="be-btn" @onclick="FecharModalVideo">Cancelar</button>
                <button class="be-btn primary" @onclick="ConfirmarVideo">Inserir</button>
            </div>
        </div>
    </div>
}

@if (modalLinkAberto)
{
    <div class="be-modal-bg" @onclick="FecharModalLink">
        <div class="be-modal" @onclick:stopPropagation="true">
            <h3>Inserir link</h3>
            <div class="be-field" style="margin-bottom:10px;">
                <div class="be-field-label">URL</div>
                <input class="be-input" @bind="linkUrl"
                       placeholder="https://..." />
            </div>
            <div class="be-field" style="margin-bottom:10px;">
                <div class="be-field-label">Texto (opcional — usa seleção se vazio)</div>
                <input class="be-input" @bind="linkTexto"
                       placeholder="Texto do link..." />
            </div>
            <div class="be-modal-actions">
                <button class="be-btn" @onclick="FecharModalLink">Cancelar</button>
                <button class="be-btn primary" @onclick="ConfirmarLink">Inserir</button>
            </div>
        </div>
    </div>
}

<script>
    window._beRef = null;

    window.beInit = function(dotnetRef) {
        window._beRef = dotnetRef;
        const editor = document.getElementById('be-editor');
        if (!editor) return;

        // Placeholder
        editor.addEventListener('input', () => {
            editor.classList.toggle('be-placeholder', editor.innerHTML === '' || editor.innerHTML === '<br>');
            dotnetRef.invokeMethodAsync('OnEditorInput', editor.innerHTML);
        });
        editor.classList.toggle('be-placeholder', editor.innerHTML === '' || editor.innerHTML === '<br>');

        // Ctrl+V: paste de imagem
        editor.addEventListener('paste', async (e) => {
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            for (const item of items) {
                if (item.type.startsWith('image/')) {
                    e.preventDefault();
                    const file = item.getAsFile();
                    const reader = new FileReader();
                    reader.onload = async () => {
                        const base64 = reader.result.split(',')[1];
                        const url = await dotnetRef.invokeMethodAsync('SalvarImagemBase64JS', base64, item.type);
                        if (url) window.beInsertImage(url);
                    };
                    reader.readAsDataURL(file);
                    return;
                }
            }
        });

        // Slash menu
        let slashMenu = null;
        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && slashMenu) {
                e.preventDefault();
                const active = slashMenu.querySelector('.be-slash-item.active');
                if (active) active.click();
                return;
            }
            if (e.key === 'ArrowDown' && slashMenu) {
                e.preventDefault();
                const items = slashMenu.querySelectorAll('.be-slash-item');
                let idx = Array.from(items).findIndex(x => x.classList.contains('active'));
                items[idx]?.classList.remove('active');
                items[Math.min(idx + 1, items.length - 1)]?.classList.add('active');
                return;
            }
            if (e.key === 'ArrowUp' && slashMenu) {
                e.preventDefault();
                const items = slashMenu.querySelectorAll('.be-slash-item');
                let idx = Array.from(items).findIndex(x => x.classList.contains('active'));
                items[idx]?.classList.remove('active');
                items[Math.max(idx - 1, 0)]?.classList.add('active');
                return;
            }
            if (e.key === 'Escape' && slashMenu) { removeSlash(); return; }
        });

        editor.addEventListener('input', () => {
            const sel = window.getSelection();
            if (!sel.rangeCount) return;
            const range = sel.getRangeAt(0);
            const node = range.startContainer;
            const text = node.textContent || '';
            const offset = range.startOffset;
            const lastSlash = text.lastIndexOf('/', offset);
            if (lastSlash !== -1 && lastSlash === offset - 1) {
                showSlash(range, node, lastSlash);
            } else if (lastSlash !== -1) {
                const q = text.substring(lastSlash + 1, offset).toLowerCase();
                if (slashMenu) filterSlash(q);
            } else {
                removeSlash();
            }
        });

        const slashCommands = [
            { icon: 'H1', label: 'Título 1', desc: 'Grande', action: () => insertBlock('h1') },
            { icon: 'H2', label: 'Título 2', desc: 'Médio', action: () => insertBlock('h2') },
            { icon: 'H3', label: 'Título 3', desc: 'Pequeno', action: () => insertBlock('h3') },
            { icon: '¶', label: 'Parágrafo', desc: 'Texto normal', action: () => insertBlock('p') },
            { icon: '—', label: 'Divisor', desc: 'Linha horizontal', action: () => { document.execCommand('insertHorizontalRule'); } },
            { icon: '❝', label: 'Citação', desc: 'Bloco azul', action: () => window.beInsertBlockquote() },
            { icon: '≡', label: 'Lista', desc: 'Com marcadores', action: () => document.execCommand('insertUnorderedList') },
            { icon: '1.', label: 'Lista numerada', desc: 'Numerada', action: () => document.execCommand('insertOrderedList') },
            { icon: '💡', label: 'Destaque', desc: 'Caixa azul', action: () => window.beInsertCallout('info') },
            { icon: '⚠', label: 'Aviso', desc: 'Caixa amarela', action: () => window.beInsertCallout('warning') },
            { icon: '🖼', label: 'Imagem', desc: 'Upload ou colar', action: () => document.getElementById('be-img-input').click() },
            { icon: '▶', label: 'Vídeo', desc: 'YouTube / Vimeo', action: () => dotnetRef.invokeMethodAsync('AbrirModalVideoJS') },
            { icon: '⊞', label: 'Tabela', desc: '3 colunas', action: () => window.beInsertTable() },
            { icon: '</>', label: 'Código', desc: 'Bloco de código', action: () => insertBlock('pre') },
        ];

        function showSlash(range, node, slashIdx) {
            removeSlash();
            const rect = range.getBoundingClientRect();
            slashMenu = document.createElement('div');
            slashMenu.className = 'be-slash-menu';
            slashMenu.style.top = (rect.bottom + window.scrollY + 4) + 'px';
            slashMenu.style.left = rect.left + 'px';
            renderSlashItems(slashCommands, node, slashIdx);
            document.body.appendChild(slashMenu);
        }

        function renderSlashItems(cmds, node, slashIdx) {
            if (!slashMenu) return;
            slashMenu.innerHTML = '';
            cmds.forEach((cmd, i) => {
                const item = document.createElement('div');
                item.className = 'be-slash-item' + (i === 0 ? ' active' : '');
                item.innerHTML = `<div class="be-slash-icon">${cmd.icon}</div><div><div class="be-slash-label">${cmd.label}</div><div class="be-slash-desc">${cmd.desc}</div></div>`;
                item.addEventListener('mousedown', (e) => {
                    e.preventDefault();
                    removeTextBeforeSlash(node, slashIdx);
                    cmd.action();
                    removeSlash();
                });
                slashMenu.appendChild(item);
            });
        }

        function filterSlash(q) {
            if (!slashMenu) return;
            const filtered = slashCommands.filter(c =>
                c.label.toLowerCase().includes(q) || c.desc.toLowerCase().includes(q));
            if (filtered.length === 0) { removeSlash(); return; }
            const node = window.getSelection()?.getRangeAt(0)?.startContainer;
            renderSlashItems(filtered, node, -1);
        }

        function removeSlash() {
            slashMenu?.remove();
            slashMenu = null;
        }

        function removeTextBeforeSlash(node, slashIdx) {
            if (!node || slashIdx < 0) return;
            const sel = window.getSelection();
            if (!sel.rangeCount) return;
            const range = sel.getRangeAt(0);
            const deleteRange = document.createRange();
            deleteRange.setStart(node, slashIdx);
            deleteRange.setEnd(node, range.startOffset);
            deleteRange.deleteContents();
        }

        function insertBlock(tag) {
            document.execCommand('formatBlock', false, tag);
        }

        document.addEventListener('click', (e) => {
            if (slashMenu && !slashMenu.contains(e.target)) removeSlash();
        });

        // Image select/resize
        editor.addEventListener('click', (e) => {
            editor.querySelectorAll('.be-img-wrap').forEach(w => w.classList.remove('selected'));
            const wrap = e.target.closest('.be-img-wrap');
            if (wrap) { wrap.classList.add('selected'); e.stopPropagation(); }
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.be-img-wrap'))
                editor.querySelectorAll('.be-img-wrap').forEach(w => w.classList.remove('selected'));
        });

        // Resize drag
        editor.addEventListener('mousedown', (e) => {
            if (!e.target.classList.contains('be-resize-handle')) return;
            e.preventDefault();
            const wrap = e.target.closest('.be-img-wrap');
            const img = wrap?.querySelector('img');
            if (!img) return;
            const startX = e.clientX;
            const startW = img.offsetWidth;
            const onMove = (ev) => {
                img.style.width = Math.max(80, startW + (ev.clientX - startX)) + 'px';
                img.style.height = 'auto';
            };
            const onUp = () => {
                document.removeEventListener('mousemove', onMove);
                document.removeEventListener('mouseup', onUp);
                dotnetRef.invokeMethodAsync('OnEditorInput', editor.innerHTML);
            };
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
        });
    };

    window.beSetContent = function(html) {
        const el = document.getElementById('be-editor');
        if (!el) return;
        el.innerHTML = html || '';
        el.classList.toggle('be-placeholder', !html || html === '<br>');
    };

    window.beGetContent = function() {
        return document.getElementById('be-editor')?.innerHTML || '';
    };

    window.beExecCmd = function(cmd, value) {
        document.getElementById('be-editor')?.focus();
        document.execCommand(cmd, false, value ?? null);
    };

    window.beInsertImage = function(url, altText) {
        const editor = document.getElementById('be-editor');
        editor.focus();
        const wrap = document.createElement('div');
        wrap.className = 'be-img-wrap';
        wrap.contentEditable = 'false';

        const img = document.createElement('img');
        img.src = url;
        img.alt = altText || '';
        img.style.width = '100%';

        const handle = document.createElement('div');
        handle.className = 'be-resize-handle';

        const ctrls = document.createElement('div');
        ctrls.className = 'be-img-controls';

        const btnFloat = document.createElement('button');
        btnFloat.className = 'be-img-ctrl-btn';
        btnFloat.textContent = '↔ Flutuante';
        btnFloat.onclick = () => {
            wrap.style.float = wrap.style.float === 'right' ? '' : 'right';
            wrap.style.margin = wrap.style.float === 'right' ? '0 0 8px 16px' : '8px 0';
        };

        const btnDel = document.createElement('button');
        btnDel.className = 'be-img-ctrl-btn';
        btnDel.textContent = '✕ Remover';
        btnDel.onclick = () => { wrap.remove(); window._beRef?.invokeMethodAsync('OnEditorInput', editor.innerHTML); };

        ctrls.appendChild(btnFloat);
        ctrls.appendChild(btnDel);
        wrap.appendChild(ctrls);
        wrap.appendChild(img);
        wrap.appendChild(handle);

        document.execCommand('insertHTML', false, wrap.outerHTML);
        window._beRef?.invokeMethodAsync('OnEditorInput', editor.innerHTML);
    };

    window.beInsertVideo = function(url) {
        const editor = document.getElementById('be-editor');
        editor.focus();
        let html = '';
        const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/);
        const vi = url.match(/vimeo\.com\/(\d+)/);
        if (yt) {
            html = `<div class="be-video-wrap" contenteditable="false"><div class="be-video-controls"><button class="be-video-ctrl-btn" onclick="this.closest('.be-video-wrap').remove()">✕ Remover</button></div><iframe src="https://www.youtube.com/embed/${yt[1]}" allowfullscreen loading="lazy"></iframe></div><p><br></p>`;
        } else if (vi) {
            html = `<div class="be-video-wrap" contenteditable="false"><div class="be-video-controls"><button class="be-video-ctrl-btn" onclick="this.closest('.be-video-wrap').remove()">✕ Remover</button></div><iframe src="https://player.vimeo.com/video/${vi[1]}" allowfullscreen loading="lazy"></iframe></div><p><br></p>`;
        } else {
            html = `<div class="be-video-wrap" contenteditable="false"><div class="be-video-controls"><button class="be-video-ctrl-btn" onclick="this.closest('.be-video-wrap').remove()">✕ Remover</button></div><video controls src="${url}"></video></div><p><br></p>`;
        }
        document.execCommand('insertHTML', false, html);
        window._beRef?.invokeMethodAsync('OnEditorInput', editor.innerHTML);
    };

    window.beInsertBlockquote = function() {
        document.getElementById('be-editor')?.focus();
        document.execCommand('formatBlock', false, 'blockquote');
    };

    window.beInsertCallout = function(type) {
        const icons = { info: '💡', warning: '⚠️', danger: '🚨', success: '✅' };
        const html = `<div class="be-callout" data-type="${type}" contenteditable="false"><span class="be-callout-icon">${icons[type] || '💡'}</span><div contenteditable="true" style="flex:1;outline:none;">Escreva aqui o destaque...</div></div><p><br></p>`;
        document.getElementById('be-editor')?.focus();
        document.execCommand('insertHTML', false, html);
    };

    window.beInsertTable = function() {
        const html = `<div class="be-table-wrap"><table><thead><tr><th>Coluna 1</th><th>Coluna 2</th><th>Coluna 3</th></tr></thead><tbody><tr><td>Dado</td><td>Dado</td><td>Dado</td></tr><tr><td>Dado</td><td>Dado</td><td>Dado</td></tr></tbody></table></div><p><br></p>`;
        document.getElementById('be-editor')?.focus();
        document.execCommand('insertHTML', false, html);
    };

    window.beTriggerFile = function(id) {
        document.getElementById(id)?.click();
    };

    // ═══════════════ PAGE BUILDER ═══════════════
    window._pbRef = null;
    window._pbAberto = false;
    window._pbSel = null;
    window._pbFoco = null;       // campo em edição no preview { sid, campo, el, off }
    window._pbSuspender = false; // true enquanto um prompt / seletor de arquivo está aberto

    window.pbSetAberto = function (aberto) {
        window._pbAberto = !!aberto;
        if (!aberto) { window._pbFoco = null; const b = document.getElementById('pb-rtb'); if (b) b.hidden = true; }
    };

    window.pbMarcar = function (sid) {
        window._pbSel = sid;
        const pv = document.getElementById('pb-preview');
        if (!pv) return;
        pv.querySelectorAll('.pbx-sel').forEach(x => { if (x.dataset.sid !== sid) x.classList.remove('pbx-sel'); });
        if (sid) pv.querySelector('[data-sid="' + sid + '"]')?.classList.add('pbx-sel');
    };

    window.pbSync = function (sid, rolar) {
        window._pbObservar?.();
        window.pbMarcar(sid);
        if (rolar && sid) {
            const el = document.querySelector('#pb-preview [data-sid="' + sid + '"]');
            el?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    };

    window.pbCopiar = async function (texto) {
        try { await navigator.clipboard.writeText(texto); return true; }
        catch {
            try {
                const ta = document.createElement('textarea');
                ta.value = texto; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                const ok = document.execCommand('copy'); ta.remove(); return ok;
            } catch { return false; }
        }
    };

    window.pbBaixar = function (nome, conteudo) {
        const url = URL.createObjectURL(new Blob([conteudo], { type: 'application/json' }));
        const a = document.createElement('a');
        a.href = url; a.download = nome; document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    // ── utilidades de cursor ────────────────────────────────────────
    function pbOffsetTexto(root) {
        const s = getSelection();
        if (!s || !s.rangeCount) return null;
        const r = s.getRangeAt(0);
        if (!root.contains(r.endContainer)) return null;
        const pre = document.createRange();
        pre.selectNodeContents(root);
        pre.setEnd(r.endContainer, r.endOffset);
        return pre.toString().length;
    }

    // Último ponto editável (dentro do último parágrafo/título/item, não depois dele)
    function pbFimEditavel(root) {
        let alvo = root;
        while (alvo.lastElementChild && /^(P|H2|H3|H4|UL|OL|LI|BLOCKQUOTE|PRE)$/.test(alvo.lastElementChild.tagName)) alvo = alvo.lastElementChild;
        const r = document.createRange();
        if (alvo !== root && alvo.lastChild && alvo.lastChild.nodeName === 'BR') r.setStartBefore(alvo.lastChild);
        else { r.selectNodeContents(alvo); r.collapse(false); }
        r.collapse(true);
        return r;
    }

    function pbColocarCursor(root, off) {
        const s = getSelection();
        let r = document.createRange();
        if (off == null) r = pbFimEditavel(root);
        else {
            const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
            let n, resto = off, ok = false;
            while ((n = w.nextNode())) {
                if (resto <= n.length) { r.setStart(n, resto); r.collapse(true); ok = true; break; }
                resto -= n.length;
            }
            if (!ok) r = pbFimEditavel(root);
        }
        s.removeAllRanges(); s.addRange(r);
    }

    // Foca o bloco de texto livre (novo ou pelo botão "Escrever neste bloco")
    window.pbFocarRico = function (sid) {
        const el = document.querySelector('#pb-preview [data-sid="' + sid + '"] [data-rich]');
        if (!el) return;
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.focus({ preventScroll: true });
        pbColocarCursor(el, null);
    };

    // ── limpeza de HTML colado (a limpeza definitiva é no servidor) ─
    // Usar window.* evita erro de re-declaração quando Blazor re-injeta o script
    if (!window.PB_TAGS_OK) {
        window.PB_TAGS_OK = new Set(['P', 'BR', 'H2', 'H3', 'H4', 'STRONG', 'B', 'EM', 'I', 'U', 'S', 'STRIKE', 'DEL', 'MARK', 'CODE', 'PRE', 'BLOCKQUOTE', 'UL', 'OL', 'LI', 'A', 'HR', 'IMG', 'SUB', 'SUP', 'TABLE', 'THEAD', 'TBODY', 'TR', 'TH', 'TD']);
        window.PB_TAGS_FORA = new Set(['SCRIPT', 'STYLE', 'META', 'LINK', 'TITLE', 'IFRAME', 'OBJECT', 'EMBED', 'NOSCRIPT', 'TEMPLATE', 'SVG', 'BUTTON', 'INPUT', 'SELECT', 'TEXTAREA', 'FORM', 'HEAD']);
    }
    const PB_TAGS_OK = window.PB_TAGS_OK;
    const PB_TAGS_FORA = window.PB_TAGS_FORA;

    function pbLimparHtml(html) {
        const t = document.createElement('template');
        t.innerHTML = String(html || '').replace(/<!--[\s\S]*?-->/g, '');
        (function limpar(no) {
            [...no.childNodes].forEach(c => {
                if (c.nodeType === 8) { c.remove(); return; }
                if (c.nodeType !== 1) return;
                if (PB_TAGS_FORA.has(c.tagName)) { c.remove(); return; }
                limpar(c);
                let tag = c.tagName;
                if (tag === 'H1') tag = 'H2';
                else if (tag === 'H5' || tag === 'H6') tag = 'H4';
                else if (tag === 'B' && /font-weight:\s*(normal|400)/i.test(c.getAttribute('style') || '')) tag = null; // Google Docs
                else if (tag === 'DIV' || tag === 'SECTION' || tag === 'ARTICLE' || tag === 'HEADER' || tag === 'FOOTER')
                    tag = c.querySelector('p,h2,h3,h4,ul,ol,blockquote,pre,div') ? null : 'P';
                else if (!PB_TAGS_OK.has(tag)) tag = null;
                if (tag === null) { while (c.firstChild) c.parentNode.insertBefore(c.firstChild, c); c.remove(); return; }
                if (tag !== c.tagName) {
                    const novo = document.createElement(tag);
                    while (c.firstChild) novo.appendChild(c.firstChild);
                    c.replaceWith(novo);
                    return;
                }
                [...c.attributes].forEach(a => {
                    const manter = (tag === 'A' && a.name === 'href') || (tag === 'IMG' && (a.name === 'src' || a.name === 'alt'));
                    if (!manter) c.removeAttribute(a.name);
                });
            });
        })(t.content);
        return t.innerHTML;
    }

