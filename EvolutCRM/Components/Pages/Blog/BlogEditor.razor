    private async Task Salvar()
    {
        if (salvando) return;
        salvando = true;
        mensagem = "";

        _htmlCorpo = await JS.InvokeAsync<string>("beGetContent");

        if (string.IsNullOrWhiteSpace(titulo))
        {
            MostrarMensagem("Informe o título do post.", "error");
            salvando = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(slug))
            slug = GerarSlugDe(titulo);

        try
        {
            int? novoId = null;
            if (Id.HasValue)
            {
                var dto = new UpdatePostDto { Titulo = titulo, Slug = slug, Conteudo = _htmlCorpo, Imagem = imagemPath, Status = status };
                await BlogRepo.UpdateAsync(Id.Value, dto);
            }
            else
            {
                var dto = new CreatePostDto { Titulo = titulo, Slug = slug, Conteudo = _htmlCorpo, Imagem = imagemPath, Status = status };
                novoId = await BlogRepo.CreateAsync(dto);
            }

            // Page Builder: regrava o layout junto, com o texto atualizado do post
            var idLayout = Id ?? novoId;
            if (idLayout > 0 && (_layout.Secoes.Count > 0 || _layoutSujo))
                await PersistirLayoutAsync(idLayout.Value);

            MostrarMensagem("Post salvo com sucesso.", "success");

            if (!Id.HasValue)
                Nav.NavigateTo("/blog");
        }
        catch (Exception ex)
        {
            MostrarMensagem($"Erro ao salvar: {ex.Message}", "error");
        }
        finally
        {
            salvando = false;
        }
    }

    private static string GerarSlugDe(string texto)
    {
        var s = texto.ToLowerInvariant()
            .Replace(" ", "-")
            .Replace("ã", "a").Replace("â", "a").Replace("á", "a").Replace("à", "a")
            .Replace("ç", "c")
            .Replace("é", "e").Replace("ê", "e").Replace("è", "e")
            .Replace("í", "i").Replace("î", "i")
            .Replace("ó", "o").Replace("ô", "o").Replace("õ", "o")
            .Replace("ú", "u").Replace("û", "u")
            .Replace("ñ", "n");
        return System.Text.RegularExpressions.Regex.Replace(s, "[^a-z0-9-]+", "").Trim('-');
    }

