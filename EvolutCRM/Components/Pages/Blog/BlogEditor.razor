        {
            var post = await BlogRepo.GetByIdAsync(Id.Value);
            if (post is not null)
            {
                titulo = post.Titulo;
                slug = post.Slug;
                _htmlInicial = post.Conteudo ?? "";
                _htmlCorpo = _htmlInicial;
                status = post.Status;
                imagemPath = post.Imagem;

                // Page Builder
                CarregarLayout(post.Layout);
                _dataPost = post.DataCriacao == default ? DateTime.Now : post.DataCriacao;
            }
        }
        else
        {
            titulo = ""; slug = ""; resumo = ""; _htmlInicial = ""; _htmlCorpo = "";
            status = "rascunho"; imagemPath = null;
            CarregarLayout(null);
            _dataPost = DateTime.Now;
        }
    }

