    private bool CombinaBusca(BlocoInfo b)
    {
        if (string.IsNullOrWhiteSpace(_buscaBloco)) return true;
        var q = _buscaBloco.Trim().ToLowerInvariant();
        return b.Nome.ToLowerInvariant().Contains(q) || b.Descricao.ToLowerInvariant().Contains(q) || b.Tipo.Contains(q) || b.Categoria.ToLowerInvariant().Contains(q);
    }

    private void AdicionarBloco(string tipo)
    {
        if (tipo == "conteudo" && _layout.Secoes.Any(x => x.Tipo == "conteudo"))
        {
            var existente = _layout.Secoes.First(x => x.Tipo == "conteudo");
            Selecionar(existente, true);
            Toast("O post já tem o bloco de conteúdo — selecionei ele para você.");
            return;
        }
        Registrar();
        var lista = Ordenadas();
        var novo = LayoutPresets.NovoBloco(tipo);
        int pos;
        if (_inserirApos is int ia && ia >= 0 && ia < lista.Count) pos = ia + 1;
        else if (_secaoEditando is not null && lista.FindIndex(x => x.Id == _secaoEditando.Id) is int si && si >= 0) pos = si + 1;
        else pos = lista.Count;
        lista.Insert(pos, novo);
        Reindexar(lista);
        _buscaBloco = "";
        Selecionar(novo, true);
        if (tipo == "escrita") _focarRico = novo.Id;
    }

