    private RenderFragment SeletorFonte(string rotulo, string valor, Action<string> set) => __builder =>
    {
        <div class="pb-f">
            <label>@rotulo</label>
            <select @bind:get="valor" @bind:set="@((string v) => { Registrar(); set(v); })" style="font-family:@LayoutRenderer.Familia(valor)">
                @foreach (var f in LayoutRenderer.Fontes)
                {
                    <option value="@f">@f</option>
                }
            </select>
        </div>
    };

    private RenderFragment SeletorEmoji(Action<string> set) => __builder =>
    {
        <div class="pb-emojis">
            @foreach (var em in Emojis)
            {
                <button type="button" @onclick="@(() => DefinirCor(set, em))">@em</button>
            }
        </div>
