    private void Duplicar(string id)
    {
        var lista = Ordenadas();
        var i = lista.FindIndex(x => x.Id == id);
        if (i < 0) return;
        Registrar();
        var copia = System.Text.Json.JsonSerializer.Deserialize<PageSection>(System.Text.Json.JsonSerializer.Serialize(lista[i]))!;
        copia.Id = SecaoItem.NovoId();
        foreach (var it in copia.Itens) it.Id = SecaoItem.NovoId();
        if (copia.Tipo == "conteudo") copia.Tipo = "texto";
        lista.Insert(i + 1, copia);
        Reindexar(lista);
        Selecionar(copia, true);
    }

    private void Remover(string id)
    {
        var lista = Ordenadas();
        var i = lista.FindIndex(x => x.Id == id);
        if (i < 0) return;
        Registrar();
        lista.RemoveAt(i);
        Reindexar(lista);
        if (_secaoEditando?.Id == id) _secaoEditando = null;
        Toast("Bloco removido (Ctrl+Z desfaz).");
    }

    private void Mover(string id, int delta)
    {
        var lista = Ordenadas();
        var i = lista.FindIndex(x => x.Id == id);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= lista.Count) return;
        Registrar();
        (lista[i], lista[j]) = (lista[j], lista[i]);
        Reindexar(lista);
        _scrollParaSel = true;
    }

    private void AlternarOculta(string id)
    {
        var s = _layout.Secoes.FirstOrDefault(x => x.Id == id);
        if (s is null) return;
        Registrar();
        s.Oculta = !s.Oculta;
    }

    private void IniciarArraste(string id) => _arrastandoId = id;

    private void FimArraste() { _arrastandoId = null; _sobreId = null; }

    private void SoltarSobre(string alvoId)
    {
        var origem = _arrastandoId;
        FimArraste();
        if (origem is null || origem == alvoId) return;
        var lista = Ordenadas();
        var s = lista.FirstOrDefault(x => x.Id == origem);
        if (s is null) return;
        Registrar();
        var iOrigem = lista.IndexOf(s);
        var iAlvo = lista.FindIndex(x => x.Id == alvoId);
        lista.RemoveAt(iOrigem);
        if (iOrigem < iAlvo) iAlvo--;
        lista.Insert(Math.Max(0, iAlvo), s);
        Reindexar(lista);
    }

