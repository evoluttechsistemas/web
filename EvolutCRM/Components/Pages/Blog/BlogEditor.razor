        if (_htmlInicial != _htmlInjetado)
        {
            _htmlInjetado = _htmlInicial;
            await JS.InvokeVoidAsync("beSetContent", _htmlInicial);
        }

        // Page Builder: mantém o bloco selecionado destacado no preview
        if (_modalLayoutAberto)
        {
            var rolar = _scrollParaSel;
            _scrollParaSel = false;
            try { await JS.InvokeVoidAsync("pbSync", _secaoEditando?.Id, rolar); } catch { }
            if (_focarRico is not null)
            {
                var id = _focarRico;
                _focarRico = null;
                try { await JS.InvokeVoidAsync("pbFocarRico", id); } catch { }
            }
        }
