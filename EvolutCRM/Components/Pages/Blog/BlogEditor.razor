        (s.Itens[i], s.Itens[j]) = (s.Itens[j], s.Itens[i]);
    }

    private void AlternarItem(SecaoItem it) => _itemAberto = _itemAberto == it.Id ? null : it.Id;

    // ── edição direto no preview (chamado pelo JS) ──────────────────
    [JSInvokable]
    public async Task PbAcaoJS(string acao, string? sid)
    {
        var s = _layout.Secoes.FirstOrDefault(x => x.Id == sid);
        switch (acao)
        {
            case "select": if (s is not null) Selecionar(s); break;
            case "up": if (s is not null) { Selecionar(s); Mover(s.Id, -1); } break;
            case "down": if (s is not null) { Selecionar(s); Mover(s.Id, 1); } break;
            case "dup": if (s is not null) Duplicar(s.Id); break;
            case "del": if (s is not null) Remover(s.Id); break;
            case "hide": if (s is not null) AlternarOculta(s.Id); break;
            case "add":
                if (s is not null)
                {
                    _secaoEditando = s;
                    _inserirApos = Ordenadas().FindIndex(x => x.Id == s.Id);
                    _abaDrawer = "blocos";
                }
                break;
            case "undo": Desfazer(); break;
            case "redo": Refazer(); break;
            case "save": await SalvarLayout(); break;
            case "dup-sel": if (_secaoEditando is not null) Duplicar(_secaoEditando.Id); break;
            case "del-sel": if (_secaoEditando is not null) Remover(_secaoEditando.Id); break;
            case "up-sel": if (_secaoEditando is not null) Mover(_secaoEditando.Id, -1); break;
            case "down-sel": if (_secaoEditando is not null) Mover(_secaoEditando.Id, 1); break;
            case "deselect": _secaoEditando = null; break;
            case "add-escrita":
                if (s is not null) { _secaoEditando = s; _inserirApos = Ordenadas().FindIndex(x => x.Id == s.Id); }
                AdicionarBloco("escrita");
                break;
            default:
                if (acao.StartsWith("toast:")) Toast(acao[6..]);
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PbEditarCampoJS(string sid, string campo, string valor)
    {
        var s = _layout.Secoes.FirstOrDefault(x => x.Id == sid);
        if (s is null) return;
        valor = (valor ?? "").Replace("\r", "").Trim();
        if (campo == "Html") valor = LayoutRenderer.SanitizarRico(valor);

        string? atual = null;
        Action<string>? set = null;
        var partes = campo.Split('.');
        if (partes.Length == 3 && partes[0] == "Itens" && int.TryParse(partes[1], out var idx) && idx >= 0 && idx < s.Itens.Count)
        {
            var it = s.Itens[idx];
            (atual, set) = partes[2] switch
            {
                "Titulo" => (it.Titulo, v => it.Titulo = v),
                "Texto" => (it.Texto, v => it.Texto = v),
                "Valor" => (it.Valor, v => it.Valor = v),
                "Icone" => (it.Icone, (Action<string>)(v => it.Icone = v)),
                _ => (null, null)
            };
        }
        else
        {
            (atual, set) = campo switch
            {
                "Titulo" => (s.Titulo, v => s.Titulo = v),
                "Subtitulo" => (s.Subtitulo, v => s.Subtitulo = v),
                "Corpo" => (s.Corpo, v => s.Corpo = v),
                "Coluna2" => (s.Coluna2, v => s.Coluna2 = v),
                "Coluna3" => (s.Coluna3, v => s.Coluna3 = v),
                "Legenda" => (s.Legenda, v => s.Legenda = v),
                "Autor" => (s.Autor, v => s.Autor = v),
                "AutorCargo" => (s.AutorCargo, v => s.AutorCargo = v),
                "BotaoTexto" => (s.BotaoTexto, v => s.BotaoTexto = v),
                "Botao2Texto" => (s.Botao2Texto, v => s.Botao2Texto = v),
                "IconeCaixa" => (s.IconeCaixa, (Action<string>)(v => s.IconeCaixa = v)),
                "Html" => (s.Html, (Action<string>)(v => s.Html = v)),
                _ => (null, null)
            };
        }

        if (set is null || (atual ?? "") == valor) return;
        Registrar();
        set(valor);
        await InvokeAsync(StateHasChanged);
    }

    // ── imagens (upload direto pro site, mesma pasta da capa) ───────
    private async Task EscolherImagem(Action<string> set)
    {
        _uploadSetter = set;
        await JS.InvokeVoidAsync("beTriggerFile", "pb-upload");
    }

    private async Task UploadImagemPb(InputFileChangeEventArgs e)
    {
        var setter = _uploadSetter;
        _uploadSetter = null;
        if (setter is null || e.File is null) return;
        if (e.File.Size > MaxImagemBytes) { Toast("Imagem muito grande (máx. 8 MB)."); return; }
        try
        {
            Toast("Enviando imagem…");
            var caminho = await SalvarImagemAsync(e.File, MaxImagemBytes);
            if (string.IsNullOrEmpty(caminho)) { Toast("Não foi possível enviar a imagem."); return; }
            Registrar();
            setter(caminho);
            Toast("✓ Imagem enviada");
        }
        catch (Exception ex) { Toast("Erro no upload: " + ex.Message); }
    }

    // ── copiar / colar / baixar layout ──────────────────────────────
    private string ExportarJson()
    {
        var copia = System.Text.Json.JsonSerializer.Deserialize<PostLayout>(Snapshot())!;
        copia.HtmlRenderizado = null;
        return System.Text.Json.JsonSerializer.Serialize(copia, _jsonIndentado);
    }

    private async Task CopiarLayout()
    {
        var ok = false;
        try { ok = await JS.InvokeAsync<bool>("pbCopiar", ExportarJson()); } catch { }
        Toast(ok ? "📋 Layout copiado — cole em outro post pela aba Tema › Ferramentas." : "Não consegui acessar a área de transferência. Use “Baixar .json”.");
    }

    private async Task BaixarLayout()
    {
        try { await JS.InvokeVoidAsync("pbBaixar", $"layout-{(string.IsNullOrWhiteSpace(slug) ? "post" : slug)}.json", ExportarJson()); } catch { }
    }

    private void AbrirImportar() { _importTexto = ""; _importAberto = true; }

    private void ImportarLayout()
    {
        try
        {
            var novo = System.Text.Json.JsonSerializer.Deserialize<PostLayout>(_importTexto, _jsonLer);
            if (novo is null) throw new Exception();
            Registrar();
            foreach (var s in novo.Secoes) { s.Id = SecaoItem.NovoId(); foreach (var it in s.Itens ?? new()) it.Id = SecaoItem.NovoId(); }
            novo.HtmlRenderizado = null;
            LayoutRenderer.Normalizar(novo);
            _layout = novo;
            _secaoEditando = null;
            _importAberto = false;
            _abaDrawer = "estrutura";
            Toast("✓ Layout aplicado.");
        }
        catch { Toast("Esse texto não é um layout válido."); }
    }

    private void LimparLayout()
    {
        if (_layout.Secoes.Count == 0) return;
        Registrar();
        _layout.Secoes.Clear();
        _secaoEditando = null;
        Toast("Layout removido — salve para o post voltar ao visual padrão (Ctrl+Z desfaz).");
    }

    private void Toast(string msg)
    {
        _pbToast = msg;
        var seq = ++_toastSeq;
        _ = Task.Delay(3200).ContinueWith(_ =>
        {
            if (seq != _toastSeq) return;
            _pbToast = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private static string Str(object? v) => v?.ToString() ?? "";

    private static string EstiloMiniatura(string? url) =>
        string.IsNullOrWhiteSpace(url) ? "" : "background-image:url('" + url.Replace("'", "%27") + "')";

    private void DefinirCor(Action<string> set, string valor)
    {
        Registrar();
        set(valor);
    }

    private void AcrescentarToken(PageSection s, string token)
    {
        Registrar();
        s.Titulo = string.IsNullOrWhiteSpace(s.Titulo) ? token : s.Titulo + " " + token;
    }


    // ════════════════════════════════════════════════════════════════
    //  PAGE BUILDER — componentes de formulário
    // ════════════════════════════════════════════════════════════════
    private RenderFragment Campo(string rotulo, string? valor, Action<string> set, string ph = "", bool multi = false, string dica = "") => __builder =>
    {
        <div class="pb-f">
            <label>@rotulo</label>
            @if (multi)
            {
                <textarea rows="4" placeholder="@ph" @bind:get="valor" @bind:set="@((string v) => { set(v); Mudou(); })" @bind:event="oninput"></textarea>
            }
            else
            {
                <input type="text" placeholder="@ph" @bind:get="valor" @bind:set="@((string v) => { set(v); Mudou(); })" @bind:event="oninput" />
            }
            @if (!string.IsNullOrEmpty(dica))
            {
                <small>@dica</small>
            }
        </div>
    };

    private RenderFragment CampoCor(string rotulo, string? valor, Action<string> set, string padrao = "#ffffff", bool tokens = true) => __builder =>
    {
        var hex = LayoutRenderer.Hex(valor, _layout, padrao);
        <div class="pb-f">
            <label>@rotulo @if (string.IsNullOrWhiteSpace(valor)) { <em>automática</em> } else if (valor.StartsWith("var:")) { <em>tema</em> }</label>
            <div class="pb-sw">
                <input type="color" value="@hex" @oninput="@(e => { set(Str(e.Value)); Mudou(); })" />
                <input type="text" class="pb-hex" value="@valor" placeholder="automática" @onchange="@(e => { Registrar(); set(Str(e.Value).Trim()); })" style="border:1.5px solid #e5e7eb;border-radius:8px;padding:7px 8px;outline:none;min-width:0;" />
            </div>
            @if (tokens)
            {
                <div class="pb-tokens">
                    <button type="button" class="pb-tok reset @(string.IsNullOrWhiteSpace(valor) ? "on" : "")" title="Automática (herda do tema)" @onclick="@(() => DefinirCor(set, ""))"></button>
                    @foreach (var tk in LayoutRenderer.TokensCor)
                    {
                        <button type="button" class="pb-tok @(valor == tk.Token ? "on" : "")" title="@tk.Nome (do tema)" style="background:@LayoutRenderer.Hex(tk.Token, _layout)" @onclick="@(() => DefinirCor(set, tk.Token))"></button>
                    }
                    <button type="button" class="pb-tok @(valor == "#ffffff" ? "on" : "")" title="Branco" style="background:#ffffff" @onclick="@(() => DefinirCor(set, "#ffffff"))"></button>
                    <button type="button" class="pb-tok @(valor == "#0f172a" ? "on" : "")" title="Quase preto" style="background:#0f172a" @onclick="@(() => DefinirCor(set, "#0f172a"))"></button>
                </div>
            }
        </div>
    };

    private RenderFragment Faixa(string rotulo, int valor, int min, int max, Action<int> set, string unidade = "px", int passo = 1) => __builder =>
    {
        <div class="pb-f">
            <label>@rotulo <em>@valor@unidade</em></label>
            <input type="range" min="@min" max="@max" step="@passo" @bind:get="valor" @bind:set="@((int v) => { set(v); Mudou(); })" @bind:event="oninput" />
        </div>
    };

    private RenderFragment Seg(string rotulo, string? valor, (string, string)[] opcoes, Action<string> set, bool historico = true) => __builder =>
    {
        <div class="pb-f">
            @if (!string.IsNullOrEmpty(rotulo))
            {
                <label>@rotulo</label>
            }
            <div class="pb-seg">
                @foreach (var (v, l) in opcoes)
                {
                    <button type="button" class="@(v == (valor ?? "") ? "on" : "")" @onclick="@(() => { if (historico) Registrar(); set(v); })">@l</button>
                }
            </div>
        </div>
    };

    private RenderFragment Chave(string rotulo, bool valor, Action<bool> set) => __builder =>
    {
        <label class="pb-toggle">
            <span>@rotulo</span>
            <input type="checkbox" checked="@valor" @onchange="@(e => { Registrar(); set(e.Value is bool b && b); })" />
            <i></i>
        </label>
    };

    private RenderFragment CampoImagem(string rotulo, string? valor, Action<string> set) => __builder =>
    {
        <div class="pb-f">
            <label>@rotulo</label>
            <div class="pb-img">
                <div class="pb-img-thumb" style="@EstiloMiniatura(valor)">@(string.IsNullOrWhiteSpace(valor) ? "🖼" : "")</div>
                <div style="display:flex; flex-direction:column; gap:5px; flex:1; min-width:0;">
                    <input type="text" placeholder="Cole uma URL ou envie →" @bind:get="valor" @bind:set="@((string v) => { set(v); Mudou(); })" @bind:event="oninput" style="border:1.5px solid #e5e7eb;border-radius:8px;padding:6px 8px;font-size:12px;outline:none;width:100%;" />
                    <div style="display:flex; gap:5px;">
                        <button type="button" class="pb-btn-sm" @onclick="@(() => EscolherImagem(set))">📤 Enviar</button>
                        @if (!string.IsNullOrEmpty(imagemPath))
                        {
                            <button type="button" class="pb-btn-sm" title="Usar a imagem de capa do post" @onclick="@(() => DefinirCor(set, imagemPath!))">Capa</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(valor))
                        {
                            <button type="button" class="pb-btn-sm danger" @onclick="@(() => DefinirCor(set, ""))">✕</button>
                        }
                    </div>
                </div>
            </div>
        </div>
