    private void Navegar(int delta)
    {
        var lista = Ordenadas();
        var i = lista.FindIndex(x => x.Id == _secaoEditando?.Id) + delta;
        if (i >= 0 && i < lista.Count) Selecionar(lista[i], true);
    }

