        if (e.FundoTipo == "gradiente") return $"linear-gradient(135deg,{c1},{LayoutRenderer.Hex(e.Fundo2, _layout)})";
        return string.IsNullOrEmpty(e.Fundo) ? "repeating-linear-gradient(45deg,#fff 0 4px,#e2e8f0 4px 8px)" : c1;
