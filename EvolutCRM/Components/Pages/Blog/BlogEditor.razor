    private RenderFragment Botoes(PageSection s) => __builder =>
    {
        <div class="pb-lbl" style="margin-top:4px;">Botões</div>
        <div class="pb-2">
            @Campo("Texto do botão", s.BotaoTexto, v => s.BotaoTexto = v, "ex.: Fale conosco")
            @Campo("Link", s.BotaoLink, v => s.BotaoLink = v, "/contato ou https://…")
        </div>
        if (!string.IsNullOrWhiteSpace(s.BotaoTexto))
        {
            @Seg("Estilo do botão", s.BotaoEstilo, new[] { ("solido", "Sólido"), ("contorno", "Contorno"), ("claro", "Suave"), ("link", "Link →") }, v => s.BotaoEstilo = v)
        }
        <div class="pb-2">
            @Campo("2º botão (opcional)", s.Botao2Texto, v => s.Botao2Texto = v, "ex.: Saiba mais")
            @Campo("Link", s.Botao2Link, v => s.Botao2Link = v, "/blogs")
        </div>
    };

    private const string DicaTexto = "**negrito**  *itálico*  ==marca-texto==  [texto](link) · linhas começando com - viram lista";

    private RenderFragment PainelConteudo(PageSection s) => __builder =>
    {
        var t = s.Tipo;
        var comSobretitulo = t is "hero" or "texto" or "colunas" or "cards" or "numeros" or "passos" or "faq" or "checklist" or "banner" or "cta" or "galeria" or "video" or "imagem" or "conteudo" or "escrita";
        var comTitulo = t is not ("citacao" or "divider" or "espaco" or "autor");
        var comBotoes = t is "hero" or "texto" or "colunas" or "checklist" or "cards" or "passos" or "banner" or "cta" or "autor";

        if (t == "conteudo")
        {
            <div class="pb-hint" style="background:#eef2ff; border-radius:9px; padding:10px 12px; color:#3730a3;">📝 Este bloco mostra o <b>texto real do post</b> (o que você escreveu no editor). Aqui você controla só a aparência dele.<br /><br />Quer escrever <b>direto no layout</b>, intercalando com outros blocos? Use o bloco <b>✍️ Texto livre</b>.</div>
            <button type="button" class="pb-btn-sm" style="width:100%;padding:9px;" @onclick='() => AdicionarBloco("escrita")'>✍️ Inserir “Texto livre” abaixo deste bloco</button>
            @Chave("Sumário automático (índice dos títulos H2/H3)", s.Sumario, v => s.Sumario = v)
            @Chave("Letra capitular no 1º parágrafo", s.LetraCapitular, v => s.LetraCapitular = v)
            @Chave("Texto dentro de um cartão", s.EstiloCartao, v => s.EstiloCartao = v)
        }

        if (t == "escrita")
        {
            <div class="pb-hint" style="background:#ecfdf5; border-radius:9px; padding:10px 12px; color:#065f46; line-height:1.55;">
                ✍️ <b>Escreva direto no preview</b>, à direita. Selecione um trecho para formatar pela barrinha que aparece.<br />
                Atalhos: <b>##</b> + espaço = título · <b>###</b> = subtítulo · <b>-</b> = lista · <b>1.</b> = numerada · <b>&gt;</b> = citação · <b>Ctrl+K</b> = link.<br />
                Cole imagens com <b>Ctrl+V</b>. Para continuar depois de outro bloco, use o <b>＋</b> entre os blocos.
            </div>
            <div style="display:flex; gap:6px;">
                <button type="button" class="pb-btn-sm" style="flex:1;padding:9px;" @onclick="() => FocarRico(s.Id)">✍️ Escrever neste bloco</button>
                <button type="button" class="pb-btn-sm" style="flex:1;padding:9px;" @onclick='() => AdicionarBloco("escrita")'>＋ Novo texto abaixo</button>
            </div>
            @Chave("Sumário no início (títulos de todo o artigo)", s.Sumario, v => s.Sumario = v)
            @Chave("Letra capitular no 1º parágrafo", s.LetraCapitular, v => s.LetraCapitular = v)
            @Chave("Texto dentro de um cartão", s.EstiloCartao, v => s.EstiloCartao = v)
        }

        if (comSobretitulo)
        {
            @Campo("Sobretítulo (etiqueta acima do título)", s.Subtitulo, v => s.Subtitulo = v, "ex.: Novidade · Tutorial · {data}")
        }

        if (comTitulo)
        {
            @Campo(t is "conteudo" or "escrita" ? "Título acima do texto (opcional)" : "Título", s.Titulo, v => s.Titulo = v, t == "hero" ? "{titulo} usa o título do post" : "")
            if (t is "hero" or "banner" or "cta" or "texto")
            {
                <div class="pb-chips">
                    <small class="pb-hint">Variáveis:</small>
                    <button type="button" title="Título do post" @onclick='() => AcrescentarToken(s, "{titulo}")'>{titulo}</button>
                    <button type="button" title="Data do post" @onclick='() => AcrescentarToken(s, "{data}")'>{data}</button>
                    <button type="button" title="Tempo de leitura" @onclick='() => AcrescentarToken(s, "{leitura}")'>{leitura}</button>
                </div>
            }
        }

        switch (t)
        {
            case "hero":
                @Campo("Texto de apoio", s.Corpo, v => s.Corpo = v, "Uma frase que resume o post", true, DicaTexto)
                @Chave("Mostrar data e tempo de leitura", s.MostrarMeta, v => s.MostrarMeta = v)
                @CampoImagem("Imagem ao lado (opcional)", s.Imagem, v => s.Imagem = v)
                break;
            case "texto":
            case "banner":
                @Campo("Texto", s.Corpo, v => s.Corpo = v, "Escreva aqui…", true, DicaTexto)
                @CampoImagem("Imagem (opcional)", s.Imagem, v => s.Imagem = v)
                break;
            case "colunas":
                @Seg("Número de colunas", s.Colunas >= 3 ? "3" : "2", new[] { ("2", "2 colunas"), ("3", "3 colunas") }, v => s.Colunas = int.Parse(v))
                @Campo("Coluna 1", s.Corpo, v => s.Corpo = v, "", true, DicaTexto)
                @Campo("Coluna 2", s.Coluna2, v => s.Coluna2 = v, "", true)
                if (s.Colunas >= 3)
                {
                    @Campo("Coluna 3", s.Coluna3, v => s.Coluna3 = v, "", true)
                }
                break;
            case "citacao":
                @Seg("Estilo", s.Variante, new[] { ("classica", "Clássica"), ("destaque", "Cartão"), ("minimal", "Minimal") }, v => s.Variante = v)
                @Campo("Frase", s.Corpo, v => s.Corpo = v, "Uma frase marcante…", true)
                <div class="pb-2">
                    @Campo("Autor", s.Autor, v => s.Autor = v)
                    @Campo("Cargo / empresa", s.AutorCargo, v => s.AutorCargo = v)
                </div>
                @CampoImagem("Foto do autor (opcional)", s.AutorFoto, v => s.AutorFoto = v)
                break;
            case "caixa":
                @Seg("Tipo", s.Variante, new[] { ("info", "💡 Info"), ("dica", "✨ Dica"), ("sucesso", "✅ Ok"), ("aviso", "⚠️ Aviso"), ("perigo", "🚨 Alerta"), ("custom", "🎨 Livre") }, v => s.Variante = v)
                @Campo("Texto", s.Corpo, v => s.Corpo = v, "", true, DicaTexto)
                @Campo("Ícone (vazio = do tipo)", s.IconeCaixa, v => s.IconeCaixa = v)
                @SeletorEmoji(v => s.IconeCaixa = v)
                if (s.Variante == "custom")
                {
                    <div class="pb-2">
                        @CampoCor("Fundo da caixa", s.CorFundo, v => s.CorFundo = v, "#eff6ff")
                        @CampoCor("Barra lateral", s.CorBorda, v => s.CorBorda = v, "#2563eb")
                    </div>
                }
                break;
            case "checklist":
                @Seg("Marcador", s.Variante, new[] { ("check", "✓"), ("numero", "1 2 3"), ("seta", "→"), ("estrela", "★") }, v => s.Variante = v)
                @Seg("Colunas", s.Colunas >= 2 ? "2" : "1", new[] { ("1", "1 coluna"), ("2", "2 colunas") }, v => s.Colunas = int.Parse(v))
                @Campo("Introdução (opcional)", s.Corpo, v => s.Corpo = v, "", true)
                break;
            case "cards":
                @Seg("Estilo dos cards", s.Variante, new[] { ("cartao", "Cartão"), ("contorno", "Contorno"), ("simples", "Simples") }, v => s.Variante = v)
                @Seg("Por linha", Math.Clamp(s.Colunas, 1, 4).ToString(), new[] { ("1", "1"), ("2", "2"), ("3", "3"), ("4", "4") }, v => s.Colunas = int.Parse(v))
                @Campo("Introdução (opcional)", s.Corpo, v => s.Corpo = v, "", true)
                break;
            case "numeros":
                @Seg("Estilo", s.Variante, new[] { ("simples", "Simples"), ("cartao", "Cartões"), ("divisoria", "Divisórias") }, v => s.Variante = v)
                @Seg("Por linha", Math.Clamp(s.Colunas, 1, 4).ToString(), new[] { ("2", "2"), ("3", "3"), ("4", "4") }, v => s.Colunas = int.Parse(v))
                @Campo("Introdução (opcional)", s.Corpo, v => s.Corpo = v, "", true)
                break;
            case "passos":
                @Seg("Direção", s.Variante, new[] { ("vertical", "↓ Vertical"), ("horizontal", "→ Horizontal") }, v => s.Variante = v)
                @Campo("Introdução (opcional)", s.Corpo, v => s.Corpo = v, "", true)
                break;
            case "faq":
                @Campo("Introdução (opcional)", s.Corpo, v => s.Corpo = v, "", true)
                <small class="pb-hint">✓ No site, o FAQ gera dados estruturados do Google (rich results).</small>
                break;
            case "galeria":
                @Seg("Por linha", Math.Clamp(s.Colunas, 2, 4).ToString(), new[] { ("2", "2"), ("3", "3"), ("4", "4") }, v => s.Colunas = int.Parse(v))
                break;
            case "imagem":
                @CampoImagem("Imagem", s.Imagem, v => s.Imagem = v)
                @Campo("Legenda", s.Legenda, v => s.Legenda = v)
                @Seg("Acabamento", s.Variante, new[] { ("", "Simples"), ("sombra", "Sombra"), ("moldura", "Moldura"), ("reta", "Cantos retos") }, v => s.Variante = v)
                break;
            case "video":
                @Campo("Link do vídeo", s.VideoUrl, v => s.VideoUrl = v, "YouTube, Vimeo ou .mp4")
                @Campo("Descrição (opcional)", s.Corpo, v => s.Corpo = v, "", true)
                @Campo("Legenda abaixo", s.Legenda, v => s.Legenda = v)
                break;
            case "cta":
                @Campo("Texto", s.Corpo, v => s.Corpo = v, "", true, DicaTexto)
                break;
            case "autor":
                @Campo("Rótulo", s.Subtitulo, v => s.Subtitulo = v, "Escrito por")
                <div class="pb-2">
                    @Campo("Nome", s.Autor, v => s.Autor = v)
                    @Campo("Cargo", s.AutorCargo, v => s.AutorCargo = v)
                </div>
                @CampoImagem("Foto", s.AutorFoto, v => s.AutorFoto = v)
                @Campo("Mini bio", s.Corpo, v => s.Corpo = v, "", true)
                break;
            case "divider":
                @Seg("Estilo", s.Variante, new[] { ("linha", "━"), ("pontilhado", "┈"), ("tracejado", "╌"), ("duplo", "═"), ("degrade", "◇ Degradê"), ("pontos", "•••"), ("icone", "✦ Ícone") }, v => s.Variante = v)
                if (s.Variante == "icone")
                {
                    @Campo("Ícone", s.IconeCaixa, v => s.IconeCaixa = v)
                    @SeletorEmoji(v => s.IconeCaixa = v)
                }
                break;
            case "espaco":
                <div class="pb-hint">Ajuste a altura em <b>Tamanho e espaçamento</b>.</div>
                break;
        }

        if (comBotoes)
        {
            @Botoes(s)
        }
    };

    private RenderFragment PainelItens(PageSection s) => __builder =>
    {
        var t = s.Tipo;
        for (var i = 0; i < s.Itens.Count; i++)
        {
            var it = s.Itens[i];
            var n = i + 1;
            var aberto = _itemAberto == it.Id;
            <div class="pb-item" @key="it.Id">
                <div class="pb-item-h">
                    <button type="button" class="pb-mini" @onclick="@(() => AlternarItem(it))">@(aberto ? "▾" : "▸")</button>
                    <span @onclick="@(() => AlternarItem(it))" style="cursor:pointer;">@n. @(string.IsNullOrWhiteSpace(it.Titulo) ? (string.IsNullOrWhiteSpace(it.Valor) ? "(sem título)" : it.Valor) : it.Titulo)</span>
                    <button type="button" class="pb-mini" title="Subir" @onclick="@(() => MoverItem(s, it, -1))">↑</button>
                    <button type="button" class="pb-mini" title="Descer" @onclick="@(() => MoverItem(s, it, 1))">↓</button>
                    <button type="button" class="pb-mini del" title="Remover" @onclick="@(() => RemoverItem(s, it))">✕</button>
                </div>
                @if (aberto)
                {
                    <div class="pb-item-b">
                        @switch (t)
                        {
                            case "cards":
                                @Campo("Ícone", it.Icone, v => it.Icone = v)
                                @SeletorEmoji(v => it.Icone = v)
                                @Campo("Título", it.Titulo, v => it.Titulo = v)
                                @Campo("Texto", it.Texto, v => it.Texto = v, "", true)
                                @CampoImagem("Imagem (substitui o ícone)", it.Imagem, v => it.Imagem = v)
                                @Campo("Link “Saiba mais” (opcional)", it.Link, v => it.Link = v, "/pagina ou https://…")
                                break;
                            case "numeros":
                                <div class="pb-2">
                                    @Campo("Número", it.Valor, v => it.Valor = v, "+42%")
                                    @Campo("Rótulo", it.Titulo, v => it.Titulo = v)
                                </div>
                                @Campo("Detalhe (opcional)", it.Texto, v => it.Texto = v)
                                break;
                            case "faq":
                                @Campo("Pergunta", it.Titulo, v => it.Titulo = v)
                                @Campo("Resposta", it.Texto, v => it.Texto = v, "", true, DicaTexto)
                                break;
                            case "galeria":
                                @CampoImagem("Imagem", it.Imagem, v => it.Imagem = v)
                                @Campo("Legenda", it.Titulo, v => it.Titulo = v)
                                break;
                            default:
                                @Campo("Título", it.Titulo, v => it.Titulo = v)
                                @Campo("Texto", it.Texto, v => it.Texto = v, "", true)
                                break;
                        }
                    </div>
                }
            </div>
        }
        <button type="button" class="pb-add-big" style="padding:8px;" @onclick="@(() => AdicionarItem(s))">＋ Adicionar item</button>
    };
}
