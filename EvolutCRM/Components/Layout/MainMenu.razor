                                   HAMBURGER
                                â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    .ham-btn {
        display: none;
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 1002;
        width: 42px;
        height: 42px;
        border-radius: var(--rad2);
        background: linear-gradient(135deg,var(--s600),var(--s900));
        border: 1px solid rgba(255,255,255,.2);
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 18px rgba(37,99,235,.35);
        transition: var(--tr);
    }

        .ham-btn:active {
            transform: scale(.95);
        }

    .ham-ico {
        width: 18px;
        height: 1.5px;
        background: #fff;
        position: relative;
        border-radius: 999px;
        transition: var(--tr);
    }

        .ham-ico::before, .ham-ico::after {
            content: '';
            position: absolute;
            width: 18px;
            height: 1.5px;
            background: #fff;
            left: 0;
            border-radius: 999px;
            transition: var(--tr);
        }

        .ham-ico::before {
            top: -6px;
        }

        .ham-ico::after {
            top: 6px;
        }

    .ham-btn.open .ham-ico {
        background: transparent;
    }

        .ham-btn.open .ham-ico::before {
            top: 0;
            transform: rotate(45deg);
        }

        .ham-btn.open .ham-ico::after {
            top: 0;
            transform: rotate(-45deg);
        }

    .mob-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.55);
        backdrop-filter: blur(2px);
        z-index: 1000;
        opacity: 0;
        pointer-events: none;
        transition: opacity .22s ease;
    }

        .mob-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

    /* â”€â”€â”€ RESPONSIVE â”€â”€â”€ */
