    }

    private async Task AlternarStatusOnlineAsync()
    {
        var novo = !UserState.IsOnline;
        UserState.SetOnline(novo);
        if (!string.IsNullOrWhiteSpace(UserState.CurrentUser))
            await LoginService.AtualizarStatusOnlineAsync(UserState.CurrentUser.Trim(), novo);
        if (mostrarUsuariosOnline) await CarregarUsuariosOnlineAsync();
    }

    private async Task CarregarUsuariosOnlineAsync()
    {
        UsuariosOnline = await LoginService.ObterUsuariosStatusAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleUsuariosOnlineAsync()
    {
        var abrir = !mostrarUsuariosOnline;
        FecharTodosFlyouts();
        mostrarUsuariosOnline = abrir;

        if (mostrarUsuariosOnline)
            await CarregarUsuariosOnlineAsync();
    }

    private async Task SairTodosDispositivosAsync()
    {
        if (string.IsNullOrWhiteSpace(UserState.CurrentUser)) return;

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            "Deseja realmente sair de todos os dispositivos?\n\nVocê precisará verificar o código 2FA no próximo login em qualquer dispositivo.");

        if (!confirmado) return;

        // Invalida token no banco
        await CadastroUsuarioService.GravarSessaoLembrarAsync(
            UserState.CurrentUser.Trim(), CodEmp, minutos: 0);

        // Remove do localStorage do dispositivo atual
        await JS.InvokeVoidAsync("localStorage.removeItem", "crm_2fa_token");

        // Faz logout normal
        await Logout();
    }
}



