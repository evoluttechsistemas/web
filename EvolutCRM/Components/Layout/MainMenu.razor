@inherits ComponentBase
@inject NavigationManager Nav
@implements IDisposable
@inject EvolutCRM.Services.UserState UserState
@using EvolutCRM.Models
@inject TicketNotificationState TicketNotify
@inject AdminService AdminService
@using EvolutCRM.Services
@using System.Diagnostics
@inject LoginService LoginService
@inject ChatInternoNotificationState ChatNotify
@inject EvolutCRM.Services.TicketService TicketService
@inject EvolutCRM.Services.CardService CardService
@inject EvolutCRM.Services.ChatInternoService ChatInternoService
@inject EvolutCRM.Services.LogAcessoService LogAcessoService
@inject EvolutCRM.Services.CadastroUsuarioService CadastroUsuarioService
@inject IJSRuntime JS

<style>
    @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');

    :root {
        /* azul sistema */
        --s900: #172554;
        --s800: #1e3a8a;
        --s700: #1e40af;
        --s600: #1d4ed8;
        --s500: #2563eb;
        --s400: #3b82f6;
        --s300: #93c5fd;
        --s200: #bfdbfe;
        --s100: #dbeafe;
        --s50: #eff6ff;
        /* sidebar */
        --sb-bg: linear-gradient(180deg,#1e3a8a 0%,#172554 100%);
        --sb-w: 200px;
        --sb-w-sm: 58px;
        --sb-w-mob: 268px;
        --sb-hover: rgba(255,255,255,.1);
        --sb-active: rgba(255,255,255,.18);
        --sb-border: rgba(255,255,255,.12);
        --sb-text: #e0ecff;
        --sb-muted: #93c5fd;
        /* notif panel */
        --np-w: 212px;
        /* misc */
        --rad: 6px;
        --rad2: 10px;
        --rad3: 14px;
        --sh: 0 1px 3px rgba(15,23,42,.07),0 3px 10px rgba(15,23,42,.05);
        --sh2: 0 4px 16px rgba(37,99,235,.2),0 1px 4px rgba(37,99,235,.1);
        --tr: .14s ease;
        --ink: #0f172a;
        --ink3: #334155;
        --muted: #64748b;
        --soft: #94a3b8;
        --line: #e2e8f0;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html, body {
        width: 100%;
        min-height: 100%;
        overflow-x: hidden;
    }

    button {
        font-family: inherit;
        -webkit-tap-highlight-color: transparent;
        cursor: pointer;
    }

    .app-shell {
        width: 100%;
        min-height: 100vh;
        background: #f0f4fd;
        font-family: 'IBM Plex Sans',sans-serif;
    }

    /* â”€â”€â”€ LAYOUT GRID â”€â”€â”€ */
    .layout {
        display: grid;
        grid-template-columns: var(--sb-w) minmax(0,1fr) var(--np-w);
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

        .layout.no-notif {
            grid-template-columns: var(--sb-w) minmax(0,1fr);
        }

            .layout.no-notif .notif-panel {
                display: none;
            }

    .content {
        min-width: 0;
        height: 100vh;
        overflow: hidden;
        background: #f0f4fd;
        display: flex;
        flex-direction: column;
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
                                   SIDEBAR
                                â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    .sidebar {
        height: 100vh;
        background: var(--sb-bg);
        border-right: 1px solid var(--sb-border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: width var(--tr);
        position: relative;
        z-index: 10;
    }

    /* â”€â”€ SIDEBAR HEADER â”€â”€ */
    .sb-head {
        flex-shrink: 0;
        padding: 14px 10px 12px;
        border-bottom: 1px solid var(--sb-border);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
    }



    .sb-head-row {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
        min-width: 0;
        padding: 9px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(59,130,246,.22));
        border: 1.5px solid rgba(186,230,253,.85);
        box-shadow: 0 12px 28px rgba(14,165,233,.34), 0 5px 14px rgba(15,23,42,.24);
        overflow: hidden;
    }

        .sb-head-row::before {
            content: '';
            position: absolute;
            inset: 0 0 auto 0;
            height: 2px;
            background: linear-gradient(90deg, rgba(255,255,255,.95), rgba(125,211,252,.85), rgba(255,255,255,.35));
        }

        .sb-head-row > * {
            position: relative;
            z-index: 1;
        }

    .sb-logo {
        order: 1;
        width: 44px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 12px;
        background: rgba(255,255,255,.94);
        border: 1.5px solid rgba(255,255,255,.95);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 4px;
        box-shadow: 0 6px 16px rgba(15,23,42,.20);
    }

    .sb-logo-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .sb-brand {
        order: 2;
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        line-height: 1.2;
        min-width: 0;
        overflow: hidden;
    }

        .sb-brand strong {
            font-size: 12.5px;
            font-weight: 900;
            color: #fff;
            white-space: nowrap;
            text-shadow: 0 1px 2px rgba(15,23,42,.34);
        }

        .sb-brand span {
            font-size: 10px;
            color: #e0f2fe;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .sb-top-status {
        order: 3;
        width: 100%;
        margin-left: 0;
        flex-shrink: 0;
        height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.58);
        background: rgba(255,255,255,.24);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 900;
        line-height: 1;
    }

        .sb-top-status:hover {
            background: rgba(255,255,255,.32);
        }

        .sb-top-status.on {
            color: #ffffff;
            border-color: rgba(187,247,208,.9);
            background: linear-gradient(135deg, #16a34a, #15803d);
            box-shadow: 0 0 14px rgba(34,197,94,.52);
        }

        .sb-top-status.off {
            color: #cbd5e1;
            border-color: rgba(148,163,184,.24);
            background: rgba(148,163,184,.12);
        }

    .sb-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: #94a3b8;
    }

    .sb-top-status.on .sb-status-dot {
        background: #22c55e;
        box-shadow: 0 0 7px rgba(34,197,94,.85);
    }

    /* â”€â”€ SCROLL AREA â”€â”€ */
    .sb-scroll {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px 8px 6px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,.2) transparent;
    }

        .sb-scroll::-webkit-scrollbar {
            width: 3px;
        }

        .sb-scroll::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.2);
            border-radius: 999px;
        }

    /* â”€â”€ SECTION â”€â”€ */
    .sb-section {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 8px 0 0;
    }

    .sb-section-lbl {
        font-size: 8.5px;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: var(--sb-muted);
        padding: 0 6px 4px;
        white-space: nowrap;
        overflow: hidden;
    }

    .sb-sep {
        height: 1px;
        background: var(--sb-border);
        margin: 4px 0;
    }

    /* â”€â”€ NAV ITEM â”€â”€ */
    .nav-item {
        position: relative;
        width: 100%;
        min-height: 36px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 8px;
        border-radius: var(--rad2);
        font-size: 11px;
        font-weight: 600;
        color: var(--sb-text);
        background: transparent;
        border: 1px solid transparent;
        transition: var(--tr);
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
    }

        .nav-item:hover {
            background: var(--sb-hover);
            border-color: var(--sb-border);
        }

        .nav-item.active {
            background: var(--sb-active);
            border-color: rgba(255,255,255,.22);
            box-shadow: 0 2px 10px rgba(0,0,0,.18);
        }

            .nav-item.active .ni-icon {
                background: rgba(255,255,255,.2);
                color: #fff;
            }

    /* â”€â”€ ICON â”€â”€ */
    .ni-icon {
        flex-shrink: 0;
        width: 26px;
        height: 26px;
        border-radius: var(--rad);
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        transition: var(--tr);
    }

    .nav-item:hover .ni-icon {
        background: rgba(255,255,255,.18);
    }

    /* â”€â”€ LABEL â”€â”€ */
    .ni-lbl {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* â”€â”€ BADGE â”€â”€ */
    /* DEPOIS */
    .ni-badge {
        position: absolute;
        right: 7px;
        top: 50%;
        transform: translateY(-50%);
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #ef4444;
        color: #fff;
        font-size: 9px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(239,68,68,.5);
        border: 1.5px solid rgba(255,255,255,.6);
        line-height: 1;
        /* isola o badge do repaint das animações vizinhas */
        will-change: contents;
        isolation: isolate;
        contain: layout style;
    }

    /* â”€â”€ STATUS ITEMS â”€â”€ */
    .nav-item.status-on {
        background: rgba(34,197,94,.14);
        border-color: rgba(34,197,94,.28);
        color: #bbf7d0;
    }

        .nav-item.status-on:hover {
            background: rgba(34,197,94,.22);
        }

        .nav-item.status-on .ni-icon {
            background: rgba(34,197,94,.2);
            border-color: rgba(34,197,94,.4);
            color: #4ade80;
        }

    .nav-item.status-off {
        background: rgba(148,163,184,.1);
        border-color: rgba(148,163,184,.2);
        color: #cbd5e1;
    }

        .nav-item.status-off .ni-icon {
            color: #94a3b8;
        }

    .nav-item.admin-item {
        background: rgba(255,255,255,.1);
        border-color: rgba(255,255,255,.18);
    }

    .nav-item.danger-item:hover {
        background: rgba(239,68,68,.18);
        border-color: rgba(239,68,68,.3);
    }

    /* â”€â”€ USERS TOGGLE ARROW â”€â”€ */
    .ni-arrow {
        font-size: 8.5px;
        color: var(--sb-muted);
        flex-shrink: 0;
        transition: var(--tr);
    }

    /* â”€â”€ USERS LIST â”€â”€ */
    .users-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin: 2px 0;
        padding: 2px 0;
        animation: ulIn .16s ease;
    }

    @@keyframes ulIn {
        from {
            opacity: 0;
            transform: translateY(-3px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .flyout-host {
        position: relative;
    }

    .flyout-backdrop {
        position: fixed;
        inset: 0;
        z-index: 35;
        background: transparent;
    }

    .flyout-menu {
        position: fixed;
        left: var(--sb-w);
        top: 0;
        bottom: 0;
        z-index: 40;
        width: calc(100vw - var(--sb-w));
        max-height: none;
        overflow-y: auto;
        padding: 18px 20px;
        border-radius: 0;
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        border-left: 1px solid #dbeafe;
        box-shadow: 8px 0 34px rgba(15,23,42,.18);
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(225px, 285px));
        align-content: start;
        gap: 9px;
        animation: flyoutIn .12s ease;
    }

        .flyout-menu::-webkit-scrollbar {
            width: 4px;
        }

        .flyout-menu::-webkit-scrollbar-thumb {
            background: #bfdbfe;
            border-radius: 999px;
        }

    .flyout-geral,
    .flyout-gestao,
    .flyout-usuarios {
        top: 0;
    }

    .flyout-title {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 0 4px 12px;
        font-size: 12.5px;
        font-weight: 900;
        color: #1e3a8a;
        text-transform: uppercase;
        letter-spacing: .06em;
        border-bottom: 1px solid #dbeafe;
        margin-bottom: 6px;
    }

        .flyout-title::before {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: #2563eb;
            box-shadow: 0 0 0 4px #dbeafe;
            flex: 0 0 auto;
        }

    .flyout-section-title {
        grid-column: 1 / -1;
        margin: 12px 0 3px;
        padding: 12px 2px 7px;
        border-top: 1px solid #dbeafe;
        color: #475569;
        font-size: 9.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .flyout-item {
        position: relative;
        min-height: 48px;
        padding: 9px 11px;
        gap: 10px;
        color: #0f172a;
        background: #ffffff;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 6px 16px rgba(30,64,175,.06);
        white-space: normal;
        overflow: visible;
    }

        .flyout-item .ni-icon {
            width: 30px;
            height: 30px;
            border-radius: 10px;
            color: #1d4ed8;
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border-color: #bfdbfe;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
        }

        .flyout-item .ni-lbl {
            color: #172554;
            font-size: 11px;
            font-weight: 800;
            line-height: 1.2;
            white-space: normal;
            overflow: visible;
            text-overflow: clip;
        }

        .flyout-item:hover {
            background: #f8fbff;
            border-color: #93c5fd;
            box-shadow: 0 2px 6px rgba(15,23,42,.06), 0 10px 24px rgba(37,99,235,.12);
            transform: translateY(-1px);
        }

            .flyout-item:hover .ni-icon {
                background: linear-gradient(135deg, #2563eb, #1e40af);
                border-color: #2563eb;
                color: #fff;
            }

        .flyout-item.active {
            background: linear-gradient(135deg, #1d4ed8, #1e3a8a);
            border-color: #2563eb;
            box-shadow: 0 2px 8px rgba(30,64,175,.22), 0 10px 26px rgba(30,64,175,.18);
        }

            .flyout-item.active::after {
                content: "";
                position: absolute;
                right: 10px;
                top: 50%;
                width: 7px;
                height: 7px;
                border-radius: 999px;
                background: #bfdbfe;
                transform: translateY(-50%);
                box-shadow: 0 0 0 3px rgba(191,219,254,.22);
            }

            .flyout-item.active .ni-icon {
                background: rgba(255,255,255,.18);
                border-color: rgba(255,255,255,.34);
                color: #fff;
            }

            .flyout-item.active .ni-lbl {
                color: #fff;
            }

        .flyout-item .ni-badge {
            right: 8px;
        }

    .flyout-empty {
        padding: 10px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px dashed #bfdbfe;
        color: #64748b;
        font-size: 10.5px;
        font-weight: 700;
        text-align: center;
    }

    .flyout-user-row {
        background: #f8fbff;
        border-color: #dbeafe;
    }

        .flyout-user-row .u-name {
            color: #0f172a;
        }

        .flyout-user-row .u-status {
            color: #64748b;
        }

    @@keyframes flyoutIn {
        from {
            opacity: 0;
            transform: translateX(-4px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@media (max-width: 900px) {
        .flyout-menu {
            left: 0;
            right: 0;
            top: 72px;
            bottom: 0;
            width: auto;
            max-height: none;
            grid-template-columns: 1fr;
            padding: 12px;
        }
    }

    .user-row {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 5px 8px;
        border-radius: var(--rad);
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.08);
    }

    .u-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--soft);
    }

        .u-dot.on {
            background: #22c55e;
            box-shadow: 0 0 5px rgba(34,197,94,.7);
        }

    .u-name {
        font-size: 10px;
        font-weight: 600;
        color: #e0ecff;
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .u-status {
        font-size: 8.5px;
        color: var(--sb-muted);
        flex-shrink: 0;
    }

    /* â”€â”€ FOOTER â”€â”€ */
    .sb-foot {
        flex-shrink: 0;
        padding: 8px;
        border-top: 1px solid var(--sb-border);
        background: rgba(0,0,0,.12);
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
                                   NOTIFICATIONS PANEL
                                â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    .notif-panel {
        height: 100vh;
        background: #fff;
        border-left: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: -3px 0 12px rgba(15,23,42,.05);
    }

    .notif-head {
        flex-shrink: 0;
        padding: 12px 10px 10px;
        border-bottom: 1.5px solid var(--s100);
        background: linear-gradient(135deg,var(--s700),var(--s900));
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .notif-head-title {
        font-family: 'IBM Plex Mono',monospace;
        font-size: 10px;
        font-weight: 700;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: .06em;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .notif-count {
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: rgba(255,255,255,.22);
        color: #fff;
        border: 1px solid rgba(255,255,255,.3);
        font-size: 9px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .notif-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }

        .notif-scroll::-webkit-scrollbar {
            width: 3px;
        }

        .notif-scroll::-webkit-scrollbar-thumb {
            background: var(--s200);
            border-radius: 999px;
        }

    .notif-empty {
        font-size: 10.5px;
        color: var(--muted);
        font-weight: 600;
        padding: 10px;
        border-radius: var(--rad);
        background: var(--s50);
        border: 1px dashed var(--s200);
        text-align: center;
        margin-top: 4px;
    }

    .notif-card {
        padding: 8px 9px;
        border-radius: var(--rad2);
        margin-bottom: 6px;
        cursor: pointer;
        transition: var(--tr);
        background: linear-gradient(135deg,var(--s50),#f8fbff);
        border: 1px solid var(--s100);
    }

        .notif-card:hover {
            transform: translateY(-1px);
            box-shadow: var(--sh);
        }

        /* tipos */
        /* DEPOIS */
        .notif-card.danger {
            background: linear-gradient(135deg,#dc2626,#7f1d1d);
            border-color: #7f1d1d;
            color: #fff;
            animation: ndPulse 1.1s infinite;
            box-shadow: 0 0 16px rgba(220,38,38,.5);
            /* promove para camada própria — não contamina irmãos */
            will-change: transform, box-shadow;
            isolation: isolate;
        }

            .notif-card.danger .nc-title,
            .notif-card.danger .nc-text,
            .notif-card.danger .nc-time {
                color: #fff;
            }

    @@keyframes ndPulse {
        0%, 100% {
            transform: scale(1);
