@code {
    [Parameter] public EventCallback<NotificacaoItemModel> OnRemoverItem { get; set; }
    private bool _permissoesCarregadas = false;
    private bool mostrarLogs = false;
    private bool PodeVisualizarChangelog;
    private bool mostrarAdmin = false;
    private bool mostrarGeral = false;
    private bool mostrarCadastros = false;
    private bool mostrarGestao = false;
    private PeriodicTimer? _timerAtividade;
    private CancellationTokenSource? _timerAtividadeCts;
    private PeriodicTimer? _timerUsuarios;
    private CancellationTokenSource? _timerUsuariosCts;
    private bool mostrarUsuariosOnline = false;
    private List<UsuarioOnlineModel> UsuariosOnline = new();
    private bool isCollapsed = false;
    private bool isMobileMenuOpen = false;
    private string? currentUri;
    private int QtdComercialNovos = 0;

    private bool PodeAcessarDashboard;
    private bool PodeAcessarComercial;
    private bool PodeVisualizarAgendas;
    private bool PodeVisualizarTickets;
    private bool PodeAcessarAdmin;
    private bool PodeAcessarConexoesWhatsApp;
    private bool PodeAcessarBancoTalentos;
    private bool PodeAcessarCadastros;
    private bool PodeAcessarCadastroClientes;
    private bool PodeAcessarParametrosDinamicos;
    private bool PodeAcessarTicketSetores;
    private bool PodeAcessarTicketSituacoes;
    private bool PodeAcessarTicketTipos;

    private bool PodeAdministrarClientes;
    private bool PodeGerenciarPermissoes;
    private bool PodeVisualizarTarefas;
    private bool PodeVisualizarComissoes;
    private bool PodeAcessoRemoto;
    private PeriodicTimer? _timerBadgeChat;
    private CancellationTokenSource? _timerBadgeChatCts;
    private PeriodicTimer? _timerBadgeTicket;
    private CancellationTokenSource? _timerBadgeTicketCts;

    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public List<NotificacaoPainelModel> Notificacoes { get; set; } = new();
    [Parameter] public EventCallback<NotificacaoPainelModel> OnAbrirNotificacao { get; set; }
    [Parameter] public EventCallback OnLimparNotificacoes { get; set; }

    private string? EmpresaNome;
    private string CodEmp => UserState.CurrentCompanyId.ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            EmpresaNome = await JS.InvokeAsync<string>("localStorage.getItem", "crm_company_name");
            StateHasChanged();
        }
    }

    private async Task AbrirNotificacao(NotificacaoPainelModel n)
    {
        if (OnAbrirNotificacao.HasDelegate)
            await OnAbrirNotificacao.InvokeAsync(n);
        if (!string.IsNullOrWhiteSpace(n.Url))
            Nav.NavigateTo(n.Url);
    }

    private async Task AbrirItem(NotificacaoItemModel item)
    {
        if (OnRemoverItem.HasDelegate)
            await OnRemoverItem.InvokeAsync(item);

        if (!string.IsNullOrWhiteSpace(item.Url))
            Nav.NavigateTo(item.Url);
    }

    private async Task CarregarBadgeComercialAsync()
    {
        if (!UserState.IsReady || UserState.CurrentCompanyId <= 0) return;

        for (int tentativa = 1; tentativa <= 3; tentativa++)
        {
            try
            {
                QtdComercialNovos = await CardService.GetQuantidadeCardsNovosAsync(UserState.CurrentCompanyId);
                await InvokeAsync(StateHasChanged);
                return;
            }
            catch (Microsoft.Data.SqlClient.SqlException ex) when (ex.Number == 1205)
            {
                if (tentativa == 3) return; // silencia na 3ª tentativa — badge não é crítico
                await Task.Delay(200 * tentativa);
            }
            catch
            {
                return; // outros erros: ignora silenciosamente
            }
        }
    }

    private string ObterIniciaisUsuario()
    {
        var usuario = UserState.CurrentUser?.Trim();

        if (string.IsNullOrWhiteSpace(usuario))
            return "HP";

        var partes = usuario
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length >= 2)
            return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();

        return usuario.Length >= 2
            ? usuario.Substring(0, 2).ToUpperInvariant()
            : usuario.ToUpperInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        currentUri = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;
        TicketNotify.OnChange += AtualizarMenu;
        ChatNotify.OnChange += AtualizarMenu;

        await CarregarPermissoesMenuAsync();

        if (!string.IsNullOrWhiteSpace(UserState.CurrentUser))
        {
            UserState.SetOnline(true);
            await LoginService.AtualizarStatusOnlineAsync(UserState.CurrentUser.Trim(), true);
            await LoginService.RegistrarAtividadeOnlineAsync(UserState.CurrentUser.Trim());
        }

        // Timer: usuários online
        _timerUsuariosCts = new CancellationTokenSource();
        _timerUsuarios = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timerUsuarios.WaitForNextTickAsync(_timerUsuariosCts.Token))
                    if (mostrarUsuariosOnline)
                        await CarregarUsuariosOnlineAsync();
            }
            catch (OperationCanceledException) { }
        });

        // Timer: heartbeat de atividade
        _timerAtividadeCts = new CancellationTokenSource();
        _timerAtividade = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timerAtividade.WaitForNextTickAsync(_timerAtividadeCts.Token))
                    if (!string.IsNullOrWhiteSpace(UserState.CurrentUser))
                        await LoginService.RegistrarAtividadeOnlineAsync(UserState.CurrentUser.Trim());
            }
            catch (OperationCanceledException) { }
        });

        // Timer: badge chat — por usuário, isolado, só dispara render se mudou
        _timerBadgeChatCts = new CancellationTokenSource();
        _timerBadgeChat = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timerBadgeChat.WaitForNextTickAsync(_timerBadgeChatCts.Token))
                {
                    if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser))
                        continue;

                    var qtd = await ChatInternoService.ObterQuantidadeMensagensNaoLidasAsync(
                                  UserState.CurrentUser.Trim().ToUpper(), CodEmp);
                    ChatNotify.SetNovas(qtd); // guard interno: só dispara OnChange se mudou
                }
            }
            catch (OperationCanceledException) { }
        });

        // Timer: badge tickets — por usuário, isolado, só dispara render se mudou
        _timerBadgeTicketCts = new CancellationTokenSource();
        _timerBadgeTicket = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timerBadgeTicket.WaitForNextTickAsync(_timerBadgeTicketCts.Token))
                {
                    if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser))
                        continue;

                    var qtd = await TicketService.GetQuantidadeTicketsNovosAsync(
                                  UserState.CurrentUser.Trim().ToUpper());
                    TicketNotify.SetNovos(qtd); // guard interno: só dispara OnChange se mudou
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUri = e.Location;

        // Permissões não mudam durante a sessão — carrega uma vez só.
        // Evita 1 query (13 antes) a cada troca de rota / clique de menu.
        if (!_permissoesCarregadas)
        {
            await CarregarPermissoesMenuAsync();
            _permissoesCarregadas = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LimparNotificacoes()
    {
        if (OnLimparNotificacoes.HasDelegate)
            await OnLimparNotificacoes.InvokeAsync();
    }

    private async Task CarregarBadgeTicketsAsync()
    {
        if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser)) return;
        var qtd = await TicketService.GetQuantidadeTicketsNovosAsync(UserState.CurrentUser.Trim().ToUpper());
        TicketNotify.SetNovos(qtd);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileMenu() => isMobileMenuOpen = false;

    private void NavigateAndCloseMobile(string url)
    {
        FecharTodosFlyouts();
        isMobileMenuOpen = false;
        Nav.NavigateTo(url);
    }

    private void ToggleMenuGeral()
    {
        var abrir = !mostrarGeral;
        FecharTodosFlyouts();
        mostrarGeral = abrir;
    }

    private void ToggleMenuGestao()
    {
        var abrir = !mostrarGestao;
        FecharTodosFlyouts();
        mostrarGestao = abrir;
    }

    private void ToggleMenuCadastros()
    {
        var abrir = !mostrarCadastros;
        FecharTodosFlyouts();
        mostrarCadastros = abrir;
    }

    private void FecharTodosFlyouts()
    {
        mostrarGeral = false;
        mostrarCadastros = false;
        mostrarGestao = false;
        mostrarAdmin = false;
        mostrarLogs = false;
        mostrarUsuariosOnline = false;
    }

    private string GetNavItemClass(string href)
    {
        var isActive = currentUri?.Contains(href, StringComparison.OrdinalIgnoreCase) == true;
        return isActive ? "nav-item active" : "nav-item";
    }

    private string GetSidebarClass()
    {
        var classes = new List<string> { "sidebar" };
        if (isCollapsed) classes.Add("collapsed");
        if (isMobileMenuOpen) classes.Add("mob-open");
        return string.Join(" ", classes);
    }

    private async Task Logout()
    {
        if (!string.IsNullOrWhiteSpace(UserState.CurrentUser))
        {
            await LoginService.AtualizarStatusOnlineAsync(UserState.CurrentUser.Trim(), false);
            await LogAcessoService.RegistrarAsync(
                UserState.CurrentUser.Trim(),
                UserState.CurrentCompanyId,
                UserState.CurrentCompany,
                "LOGOUT");
        }
        UserState.Clear();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void AtualizarMenu() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        TicketNotify.OnChange -= AtualizarMenu;
        ChatNotify.OnChange -= AtualizarMenu;
        _timerUsuariosCts?.Cancel(); _timerUsuarios?.Dispose(); _timerUsuariosCts?.Dispose();
        _timerAtividadeCts?.Cancel(); _timerAtividade?.Dispose(); _timerAtividadeCts?.Dispose();
        _timerBadgeChatCts?.Cancel(); _timerBadgeChat?.Dispose(); _timerBadgeChatCts?.Dispose();
        _timerBadgeTicketCts?.Cancel(); _timerBadgeTicket?.Dispose(); _timerBadgeTicketCts?.Dispose();
    }

    private async Task CarregarPermissoesMenuAsync()
    {
        PodeVisualizarChangelog = false;
        PodeAcessarDashboard = false;
        PodeAcessarComercial = false;
        PodeVisualizarAgendas = false;
        PodeVisualizarTickets = false;
        PodeAcessarAdmin = false;
        PodeAcessarConexoesWhatsApp = false;
        PodeAcessarBancoTalentos = false;
        PodeAcessarCadastros = false;
        PodeAcessarCadastroClientes = false;
        PodeAcessarParametrosDinamicos = false;
        PodeAcessarTicketSetores = false;
        PodeAcessarTicketSituacoes = false;
        PodeAcessarTicketTipos = false;

        PodeAdministrarClientes = false;
        PodeGerenciarPermissoes = false;
        PodeVisualizarTarefas = false;
        PodeVisualizarComissoes = false;
        PodeAcessoRemoto = false;

        int tentativas = 0;
        while (!UserState.IsReady && tentativas < 100) { await Task.Delay(50); tentativas++; }

        var u = UserState.CurrentUser?.Trim().ToUpper() ?? "";
        if (string.IsNullOrWhiteSpace(u)) { await InvokeAsync(StateHasChanged); return; }

        // UMA query só, em vez de 13 chamadas separadas ao banco
        var perms = await AdminService.GetPermissoesUsuarioAsync(u);

        PodeAcessarDashboard = perms.Contains("DASHBOARD_VISUALIZAR");
        PodeAcessarComercial = perms.Contains("COMERCIAL_ACESSAR");
