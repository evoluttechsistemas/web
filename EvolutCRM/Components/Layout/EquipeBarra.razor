            position: fixed;
            top: auto;
            left: 8px;
            right: 8px;
            bottom: 8px;
            width: auto;
        }
    }

    /* ── atalho para o chat ── */
    .eq-av-btn {
        position: relative;
        border: none;
        padding: 0;
        cursor: pointer;
        font-family: inherit;
        transition: transform .12s ease;
    }

        .eq-av-btn:hover {
            transform: translateY(-1px) scale(1.06);
        }

