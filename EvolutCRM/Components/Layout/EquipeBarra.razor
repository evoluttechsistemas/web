@using EvolutCRM.Models
@using EvolutCRM.Services
@implements IDisposable
@inject EquipeStatusState Equipe
@inject UserState UserState
@inject ChatInternoService ChatService
@inject ChatInternoNotificationState ChatNotify

@* Faixa da equipe, ao lado das abas: quem está logado, em que status, quantos estão disponíveis
   e atalho para o Chat Interno (clicar numa pessoa abre a conversa numa janelinha). *@

<div class="eq-bar">
    <div class="eq-meu">
        <MeuStatusSeletor Compacto="true" />
    </div>

    <div class="eq-equipe">
        <span class="eq-avatares">
            @foreach (var m in AvataresVisiveis)
            {
                var membro = m;
                var naoLidas = NaoLidasDe(membro.Usuario);
                <button type="button"
                        class="eq-av eq-av-btn @(membro.Online ? "" : "eq-av-off") @(naoLidas > 0 ? "eq-av-pulsa" : "") @(EhEu(membro) ? "eq-av-eu" : "")"
                        style="background:@CorAvatar(membro.Usuario); box-shadow:0 0 0 2px #e9edf2, 0 0 0 4px @membro.StatusCorFinal;"
                        title="@DicaAvatar(membro, naoLidas)"
                        @onclick="() => ClicarAvatarAsync(membro)">
                    @Iniciais(membro.Usuario)
                    @if (naoLidas > 0)
                    {
                        <span class="eq-badge">@(naoLidas > 9 ? "9+" : naoLidas.ToString())</span>
                    }
                </button>
            }
            @if (AvataresExcedentes > 0)
            {
                <button type="button" class="eq-av eq-mais" title="Ver toda a equipe" @onclick="AlternarPainel">+@AvataresExcedentes</button>
            }
            @if (!Online.Any())
            {
                <span class="eq-vazio">Ninguém online</span>
            }
        </span>

        <button type="button" class="eq-chat @(ChatNotify.Novas > 0 ? "tem" : "")" title="Conversas do Chat Interno" @onclick="AlternarPainel">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
            @if (ChatNotify.Novas > 0)
            {
                <span class="eq-chat-n">@(ChatNotify.Novas > 99 ? "99+" : ChatNotify.Novas.ToString())</span>
            }
        </button>

        <button type="button" class="eq-disp @ClasseDisponiveis" title="Ver status da equipe" @onclick="AlternarPainel">
            @TextoDisponiveis
        </button>
    </div>

    @if (_painelAberto)
    {
        <div class="eq-backdrop" @onclick="FecharPainel"></div>
        <div class="eq-painel">
            <div class="eq-painel-head">
                <span>Equipe</span>
                <span class="eq-painel-n">@Online.Count online · @TextoDisponiveis</span>
            </div>

            @foreach (var m in Online)
            {
                var membro = m;
                var naoLidas = NaoLidasDe(membro.Usuario);
                <div class="eq-linha @(EhEu(membro) ? "" : "eq-linha-click")"
                     title="@(EhEu(membro) ? "" : "Conversar com " + membro.Usuario)"
                     @onclick="() => ClicarAvatarAsync(membro)">
                    <span class="eq-av eq-av-p" style="background:@CorAvatar(membro.Usuario); box-shadow:0 0 0 2px #fff, 0 0 0 4px @membro.StatusCorFinal;">
                        @Iniciais(membro.Usuario)
                    </span>
                    <span class="eq-nome">@NomeExibicao(membro)</span>
                    @if (naoLidas > 0)
                    {
                        <span class="eq-badge-linha">@naoLidas</span>
                    }
                    <span class="eq-st" style="@EstiloEtiqueta(membro)">
                        @membro.StatusTexto
                    </span>
                    <span class="eq-tempo">@membro.TempoTexto</span>
                </div>
            }

            @if (GruposComConversa.Any())
            {
                <div class="eq-off-t">Grupos</div>
                @foreach (var g in GruposComConversa)
                {
                    var grupo = g;
                    <div class="eq-linha eq-linha-click" @onclick="() => AbrirGrupo(grupo)">
                        <span class="eq-av eq-av-p eq-av-grupo">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                        </span>
                        <span class="eq-nome">@grupo.Titulo</span>
                        @if (grupo.MensagensNaoLidas > 0)
                        {
                            <span class="eq-badge-linha">@grupo.MensagensNaoLidas</span>
                        }
                    </div>
                }
            }

            @if (Offline.Any())
            {
                <div class="eq-off-t">Offline</div>
                <div class="eq-off">
                    @foreach (var m in Offline)
                    {
                        var membro = m;
                        var naoLidas = NaoLidasDe(membro.Usuario);
                        <button type="button" class="eq-off-nome" title="Conversar com @membro.Usuario" @onclick="() => ClicarAvatarAsync(membro)">
                            @membro.Usuario
                            @if (naoLidas > 0)
                            {
                                <span class="eq-badge-linha">@naoLidas</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (_chat is not null)
    {
        <MiniChat CodConversa="_chat.Codigo"
                  Titulo="@_chat.Titulo"
                  SubTitulo="@SubTituloChat"
                  CorStatus="@CorStatusChat"
                  EhGrupo="_chat.EhGrupo"
                  OnFechar="FecharChat"
                  OnLido="CarregarConversasAsync" />
    }
</div>

<style>
    .eq-bar {
        position: relative;
        z-index: 30;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 10px;
        background: #e9edf2;
        border-bottom: 1px solid #cfd6de;
        flex-shrink: 0;
        font-family: 'IBM Plex Sans',sans-serif;
    }

    /* o seletor compacto só aparece quando a barra lateral está estreita */
    .eq-meu {
        display: none;
    }

    @@media (max-width: 900px) {
        .eq-meu {
            display: block;
        }
    }

    .eq-equipe {
        display: flex;
        align-items: center;
