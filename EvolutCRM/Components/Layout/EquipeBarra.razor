    }

    @@keyframes eqPulsa {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.12); }
    }

    button.eq-mais {
        border: none;
        cursor: pointer;
        font-family: inherit;
    }

    .eq-chat {
        position: relative;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: #475569;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .eq-chat:hover {
            background: rgba(255,255,255,.75);
            color: #1d4ed8;
        }

        .eq-chat.tem {
            color: #1d4ed8;
        }

    .eq-chat-n {
        position: absolute;
        top: -2px;
        right: -4px;
        min-width: 15px;
        height: 15px;
        padding: 0 3px;
        border-radius: 999px;
        background: #ef4444;
        color: #fff;
        font-size: 8.5px;
        font-weight: 800;
        line-height: 15px;
        text-align: center;
    }

    button.eq-disp {
        border: none;
        cursor: pointer;
        font-family: inherit;
