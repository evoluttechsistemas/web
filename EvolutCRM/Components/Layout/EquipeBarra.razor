        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: .02em;
        flex-shrink: 0;
        user-select: none;
    }

    .eq-mais {
        background: #64748b;
        box-shadow: 0 0 0 2px #e9edf2;
    }

    .eq-vazio {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
    }

    .eq-disp {
        font-size: 10.5px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 999px;
        white-space: nowrap;
    }

        .eq-disp.ok {
            background: #dcfce7;
            color: #166534;
        }

        .eq-disp.alerta {
            background: #fef3c7;
            color: #92400e;
