        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        padding: 4px 6px 8px;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 800;
        color: #1e3a8a;
    }

    .eq-painel-n {
        font-size: 10.5px;
        font-weight: 600;
        color: #64748b;
    }

    .eq-linha {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 6px;
        border-radius: 8px;
    }

        .eq-linha:hover {
            background: #f8fafc;
        }

    .eq-av-p {
        width: 26px;
        height: 26px;
        font-size: 10px;
    }

    .eq-nome {
        flex: 1;
        min-width: 0;
        font-size: 12px;
        font-weight: 700;
        color: #0f172a;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .eq-st {
        font-size: 10.5px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .eq-tempo {
        width: 58px;
        text-align: right;
