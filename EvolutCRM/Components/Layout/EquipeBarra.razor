    button.eq-off-nome {
        border: none;
        cursor: pointer;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        button.eq-off-nome:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
</style>

@code {
    private const int MaxAvatares = 8;
    private bool _painelAberto;

    // Conversas do Chat Interno (para os contadores de não lidas e para abrir o chat)
    private Dictionary<string, ChatInternoConversaModel> _conversaPorUsuario = new(StringComparer.OrdinalIgnoreCase);
    private List<ChatInternoConversaModel> _grupos = new();
    private bool _carregandoConversas;

    private sealed record ChatAberto(int Codigo, string Titulo, bool EhGrupo);
    private ChatAberto? _chat;

    private string Eu => (UserState.CurrentUser ?? "").Trim().ToUpper();
    private string CodEmp => UserState.CurrentCompanyId.ToString();

    // Online primeiro os disponíveis, depois os ocupados; dentro de cada grupo, por nome
    private List<EquipeMembroModel> Online => Equipe.Membros
        .Where(m => m.Online)
        .OrderByDescending(m => m.Disponivel)
        .ThenBy(m => m.Usuario)
        .ToList();

    private List<EquipeMembroModel> Offline => Equipe.Membros.Where(m => !m.Online).ToList();

    // Na faixa: quem está online + quem está offline mas mandou mensagem não lida
    private List<EquipeMembroModel> Avatares => Online
        .Concat(Offline.Where(m => NaoLidasDe(m.Usuario) > 0))
        .ToList();

    private IEnumerable<EquipeMembroModel> AvataresVisiveis =>
        Avatares.OrderByDescending(m => NaoLidasDe(m.Usuario) > 0).Take(MaxAvatares);

    private int AvataresExcedentes => Math.Max(0, Avatares.Count - MaxAvatares);

    private IEnumerable<ChatInternoConversaModel> GruposComConversa =>
        _grupos.OrderByDescending(g => g.MensagensNaoLidas > 0).ThenByDescending(g => g.UltimaMensagem);

    private int QtdDisponiveis => Equipe.Membros.Count(m => m.Disponivel);

    private string TextoDisponiveis => QtdDisponiveis == 1 ? "1 disponível" : $"{QtdDisponiveis} disponíveis";

    private string ClasseDisponiveis => QtdDisponiveis switch
    {
        0 => "critico",
        1 => "alerta",
        _ => "ok"
    };

    private int NaoLidasDe(string usuario) =>
        _conversaPorUsuario.TryGetValue(usuario.Trim(), out var c) ? c.MensagensNaoLidas : 0;

    private EquipeMembroModel? MembroDoChat =>
        _chat is null || _chat.EhGrupo
            ? null
            : Equipe.Membros.FirstOrDefault(m => m.Usuario.Equals(_chat.Titulo, StringComparison.OrdinalIgnoreCase));

    private string? SubTituloChat
    {
        get
        {
            if (_chat is null) return null;
            if (_chat.EhGrupo) return "Grupo";
            var m = MembroDoChat;
            if (m is null) return null;
            return string.IsNullOrEmpty(m.TempoTexto) ? m.StatusTexto : $"{m.StatusTexto} · {m.TempoTexto}";
        }
    }

    private string? CorStatusChat => MembroDoChat?.StatusCorFinal;

    protected override async Task OnInitializedAsync()
    {
        Equipe.OnChange += AoMudar;
        ChatNotify.OnChange += AoMudarChat;
        await Equipe.IniciarAsync();
        await CarregarConversasAsync();
    }

    private void AoMudar() => _ = InvokeAsync(StateHasChanged);

    // O MainLayout atualiza o total de não lidas a cada 5s; quando muda, recarrega os contadores por pessoa
    private void AoMudarChat() => _ = InvokeAsync(CarregarConversasAsync);

    private async Task CarregarConversasAsync()
    {
        if (_carregandoConversas || string.IsNullOrWhiteSpace(Eu) || UserState.CurrentCompanyId <= 0) return;
        _carregandoConversas = true;

        try
        {
            var conversas = await ChatService.ObterConversasAsync(Eu, CodEmp);

            _conversaPorUsuario = conversas
                .Where(c => c.ChatTipo != "GRUPO" && !string.IsNullOrWhiteSpace(c.Titulo))
                .GroupBy(c => c.Titulo.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

            _grupos = conversas.Where(c => c.ChatTipo == "GRUPO").ToList();
        }
        catch
        {
            // falha momentânea: mantém os contadores anteriores
        }
        finally
        {
            _carregandoConversas = false;
        }

        StateHasChanged();
    }

    private async Task ClicarAvatarAsync(EquipeMembroModel membro)
    {
        if (EhEu(membro)) return;

        _painelAberto = false;

        try
        {
            var cod = _conversaPorUsuario.TryGetValue(membro.Usuario.Trim(), out var conv)
                ? conv.Codigo
                : await ChatService.CriarConversaIndividualAsync(Eu, membro.Usuario, CodEmp);

            _chat = new ChatAberto(cod, membro.Usuario.Trim().ToUpper(), false);
        }
        catch
        {
            _chat = null;
        }
    }

    private void AbrirGrupo(ChatInternoConversaModel grupo)
    {
        _painelAberto = false;
        _chat = new ChatAberto(grupo.Codigo, grupo.Titulo, true);
    }

    private async Task FecharChat()
    {
        _chat = null;
        await CarregarConversasAsync();
    }

    private async Task AlternarPainel()
    {
        _painelAberto = !_painelAberto;
        if (_painelAberto)
        {
            await Equipe.RecarregarAsync(incluirCadastro: false);
            await CarregarConversasAsync();
        }
    }

    private void FecharPainel() => _painelAberto = false;

    private bool EhEu(EquipeMembroModel m) =>
        m.Usuario.Equals(UserState.CurrentUser?.Trim() ?? "", StringComparison.OrdinalIgnoreCase);

    private static string Dica(EquipeMembroModel m) =>
        string.IsNullOrEmpty(m.TempoTexto) ? $"{m.Usuario} — {m.StatusTexto}" : $"{m.Usuario} — {m.StatusTexto} {m.TempoTexto}";

    private string DicaAvatar(EquipeMembroModel m, int naoLidas)
    {
        var dica = Dica(m);
        if (EhEu(m)) return dica + " (você)";
        if (naoLidas > 0) return $"{dica}\n{naoLidas} mensagem(ns) nova(s) — clique para abrir";
        return dica + "\nClique para conversar";
    }

    private string NomeExibicao(EquipeMembroModel m) => EhEu(m) ? $"{m.Usuario} (você)" : m.Usuario;

    // Texto na cor do status, com fundo da mesma cor bem clarinho (alfa 10%)
    private static string EstiloEtiqueta(EquipeMembroModel m) => $"color:{m.StatusCorFinal}; background:{m.StatusCorFinal}1a;";

    private static string Iniciais(string nome)
    {
        var partes = (nome ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2) return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
        var n = partes.Length == 1 ? partes[0] : "?";
        return (n.Length >= 2 ? n[..2] : n).ToUpperInvariant();
    }

    private static readonly string[] _cores =
    {
        "#e53935", "#1976d2", "#43a047", "#8e24aa", "#fb8c00",
        "#00897b", "#3949ab", "#d81b60", "#5e35b1", "#6d4c41"
    };

    // Mesmo cálculo de cor do chat interno: a pessoa tem sempre a mesma cor
    private static string CorAvatar(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "#546e7a";
        int hash = 0;
        foreach (var c in nome.Trim().ToUpperInvariant())
            hash = (hash * 31 + c) & 0x7FFFFFFF;
        return _cores[hash % _cores.Length];
    }

    public void Dispose()
    {
        Equipe.OnChange -= AoMudar;
        ChatNotify.OnChange -= AoMudarChat;
    }
}
