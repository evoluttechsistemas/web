            );

            await AdicionarItemAoGrupo(
    chaveGrupo: "GRUPO_CHAT",
    tipoOrigem: "CHAT",
    tituloGrupo: "💬 Chat interno",
    tipo: "warning",
    urlGrupo: "/chat-interno",
