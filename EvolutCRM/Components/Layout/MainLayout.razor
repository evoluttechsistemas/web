            var texto = ultima.Texto ?? "";

            if (texto.Length > 80)
                texto = texto.Substring(0, 80) + "...";

            var usuarioOrigem = string.IsNullOrWhiteSpace(ultima.Usuario)
                ? "Usuário"
                : ultima.Usuario.Trim();

