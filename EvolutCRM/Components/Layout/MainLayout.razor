    private async Task RemoverNotificacaoPorRotaAtualAsync(string rotaAtual)
    {
        if (rotaAtual.StartsWith("ticket/"))
        {
            var partes = rotaAtual.Split('/');
            if (partes.Length >= 2 && int.TryParse(partes[1], out var codigo))
                await RemoverItemDoGrupo("GRUPO_TICKET", codigo);
        }
        else if (rotaAtual == "tickets")
        {
            _notificacoesPainel = _notificacoesPainel
                .Where(x => x.Chave != "GRUPO_TICKET" && x.Chave != "GRUPO_TICKET_SEM_RESP")
                .ToList();
        }
        else if (rotaAtual.StartsWith("card/"))
        {
            var partes = rotaAtual.Split('/');
            if (partes.Length >= 2 && int.TryParse(partes[1], out var codigo))
            {
                await RemoverItemDoGrupo("GRUPO_CRM_NOVO", codigo);
                await RemoverItemDoGrupo("GRUPO_CRM_MSG", codigo);
            }
        }
        else if (rotaAtual.StartsWith("chat-interno"))
        {
            _notificacoesPainel = _notificacoesPainel
                .Where(x => x.Chave != "GRUPO_CHAT")
                .ToList();
        }
        else if (rotaAtual.StartsWith("agendas"))
        {
            _notificacoesPainel = _notificacoesPainel
                .Where(x => x.Chave != "GRUPO_AGENDA")
                .ToList();
        }
        else if (rotaAtual.StartsWith("admin/monitor-backups"))
        {
            _notificacoesPainel = _notificacoesPainel
                .Where(x => x.Chave != "GRUPO_BACKUP")
                .ToList();
        }

        await InvokeAsync(StateHasChanged);
    }

    // ADICIONAR este método auxiliar junto:
    private async Task RemoverItemDoGrupo(string chaveGrupo, int codigo)
    {
        var grupo = _notificacoesPainel.FirstOrDefault(x => x.Chave == chaveGrupo);
        if (grupo == null) return;

        grupo.Itens.RemoveAll(i => i.Codigo == codigo);

        if (!grupo.Itens.Any())
            _notificacoesPainel = _notificacoesPainel
                .Where(x => x.Chave != chaveGrupo)
                .ToList();
        else
            grupo.Mensagem = FormatarMensagemGrupo(grupo.Itens, grupo.TipoOrigem);

        await InvokeAsync(StateHasChanged);
    }

