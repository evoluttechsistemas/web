        if (proxima is not null) Nav.NavigateTo(proxima.Rota);
        else if (Abas.RotaAtiva is null) Nav.NavigateTo("");
    }

    private async Task AtualizarNotificacoesMensagensPresasAsync()
    {
        if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser))
            return;

        try
        {
            var usuario = UserState.CurrentUser.Trim().ToUpperInvariant();
            var mensagens = await TicketService.BuscarMensagensPresasAsync(usuario);

            var idsPresos = mensagens.Select(m => m.Codigo).ToHashSet();

            foreach (var msg in mensagens)
            {
                if (!_mensagensFailedNotificadas.TryGetValue(msg.Codigo, out var ultimaNotif))
                {
                    // ← usa a tupla corretamente
                    _mensagensFailedNotificadas[msg.Codigo] = (DateTime.Now, 1);
                    continue;
                }

                // ← acessa o campo da tupla
                if (DateTime.Now - ultimaNotif.UltimaNotificacao < TimeSpan.FromMinutes(2))
                    continue;

                // ← incrementa contagem e atualiza timestamp
                _mensagensFailedNotificadas[msg.Codigo] = (DateTime.Now, ultimaNotif.Contagem + 1);

            }

            var resolvidas = _mensagensFailedNotificadas.Keys
                .Where(id => !idsPresos.Contains(id))
                .ToList();

            foreach (var id in resolvidas)
            {
                _mensagensFailedNotificadas.Remove(id);
                await RemoverNotificacaoPainel($"MSG_PRESA_{id}");
            }

            var expiradas = _mensagensFailedNotificadas
                .Where(x => DateTime.Now - x.Value.UltimaNotificacao > TimeSpan.FromHours(24))
                .Select(x => x.Key)
                .ToList();

            foreach (var key in expiradas)
                _mensagensFailedNotificadas.Remove(key);
        }
        catch (Exception ex)
        {
            await SafeJs("crmLog", $"[MsgPresaNotify] Erro: {ex.Message}");
        }
    }

    // DEPOIS
private IDictionary<string, object?> GetParametros(AbaItem aba, bool ativa)
{
    // Só injeta IsVisible em componentes que declaram esse parâmetro
    if (aba.ComponenteTipo == typeof(EvolutCRM.Components.Pages.ChatInterno))
    {
        var p = new Dictionary<string, object?>(aba.Parametros)
        {
            ["IsVisible"] = (object?)ativa
        };
        return p;
    }

    return aba.Parametros;
}

