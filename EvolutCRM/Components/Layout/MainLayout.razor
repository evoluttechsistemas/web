    {
        Codigo = ultima.Codigo,
        Descricao = $"{usuarioOrigem}: {texto}",
        Url = "/chat-interno",
        DataHora = ultima.DataHora
    });

            await SafeJs(
                "crmNotifyPopup",
                $"💬 Nova mensagem de {usuarioOrigem}",
                texto,
                "/images/logo-evoluttech.png"
            );

            await SafeJs("crmBlinkStart", $"💬 Chat interno", 8);
            await SafeJs("crmBeep", 320);
        }
        catch (Exception ex)
        {
            await SafeJs("crmLog", $"[ChatInternoNotify] Erro: {ex.Message}");
        }
    }

