    private async Task AtualizarChatInterno()
    {
        if (!UserState.IsReady || string.IsNullOrWhiteSpace(UserState.CurrentUser))
            return;

        try
        {
            var usuario = UserState.CurrentUser.Trim();

            await ChatInternoService.AtualizarPresencaAsync(usuario, CodEmp);

            // DEPOIS:
            var qtdNovas = await ChatInternoService
                .ObterQuantidadeMensagensNaoLidasAsync(usuario, CodEmp);

            ChatNotify.SetNovas(qtdNovas);

            if (qtdNovas <= 0)
                return;

            var ultima = await ChatInternoService
                .ObterUltimaMensagemNaoLidaAsync(usuario, CodEmp);

            // Garante que a mensagem não foi enviada pelo próprio usuário logado
            if (ultima == null)
