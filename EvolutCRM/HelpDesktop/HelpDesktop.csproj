<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>icone-servico-impressao.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="icone-servico-impressao.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
		<PackageReference Include="mercadopago-sdk" Version="3.3.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
	</ItemGroup>

</Project>