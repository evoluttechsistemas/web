@page "/pdv-simulador"
@rendermode InteractiveServer
@using System.Globalization
@using EvolutCotacao.Models
@using EvolutCotacao.Service
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@inject PdvSimuladorService PdvService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<PdvSimulador> Logger
@implements IAsyncDisposable

<PageTitle>PDV Simulador</PageTitle>

<style>
    .pdv-shell, .pdv-shell *, .pdv-modal-fundo * {
        box-sizing: border-box;
        letter-spacing: 0;
    }

    .pdv-shell {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: #1b6591;
        color: white;
        font-family: Arial, sans-serif;
        display: grid;
        grid-template-rows: 62px minmax(0,1fr) 37px;
        outline: none;
    }

    .pdv-header {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 3px 4px 0 12px;
        gap: 12px;
        font-size: 12px;
    }

    .pdv-menu {
        display: flex;
        gap: 20px;
        padding-top: 2px;
        white-space: nowrap;
    }

    .pdv-status {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

        .pdv-status label {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .pdv-status input {
            height: 14px;
            padding: 0 2px;
            border: 0;
            border-radius: 0;
            background: #fff;
            color: #000;
            font: 12px Arial;
            width: 65px;
        }

        .pdv-status .terminal {
            width: 28px;
        }

        .pdv-status .relogio {
            width: 51px;
        }

    .pdv-janela {
        display: flex;
        gap: 4px;
    }

        .pdv-janela button {
            width: 75px;
            height: 18px;
            padding: 0;
            background: #eee;
            border: 1px solid #aaa;
            color: #000;
            font: bold 11px Arial;
            cursor: pointer;
        }

    .pdv-espera {
        position: absolute;
        right: 10.7%;
        top: 30px;
        font-weight: bold;
        font-size: 14px;
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .pdv-espera span {
            border-radius: 50%;
            background: #ef3340;
            padding: 3px 5px;
            font-size: 12px;
        }

    .pdv-conteudo {
        margin: 0 21px 0 11px;
        display: grid;
        grid-template-columns: 30.73% minmax(0,1fr);
        background: #effdfd;
        border-radius: 22px;
        overflow: hidden;
        min-height: 0;
    }

    .pdv-lateral {
        display: grid;
        grid-template-rows: minmax(0,1fr) 217px;
        min-width: 0;
        background: #689db7;
        border-radius: 22px;
        overflow: hidden;
    }

    .pdv-logo {
        position: relative;
        overflow: hidden;
        background: white;
        border-radius: 22px;
    }

        .pdv-logo img {
            position: absolute;
            width: 333.333%;
            height: 170.444%;
            max-width: none;
            left: -2.716%;
            top: -14%;
        }

    .pdv-resumo {
        padding: 9px 15px 13px;
        display: grid;
        grid-template-rows: 44px 54px minmax(0,1fr);
        gap: 7px;
        color: #000;
    }

    .pdv-subtotal-linha {
        display: flex;
        align-items: center;
        gap: 5px;
        min-width: 0;
    }

    .pdv-subtotal {
        display: flex;
        align-items: center;
        border-radius: 24px;
        background: white;
        height: 44px;
        flex: 1;
        min-width: 0;
    }

        .pdv-subtotal label {
            background: #1b6591;
            color: white;
            border-radius: 24px;
            height: 44px;
            display: flex;
            align-items: center;
            padding: 0 11px;
            font-weight: bold;
            font-size: 14px;
        }

        .pdv-subtotal strong {
            flex: 1;
            text-align: center;
            font-size: 24px;
            font-weight: 400;
            overflow: auto;
        }

    .pdv-contagem {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 11px;
        white-space: nowrap;
    }

        .pdv-contagem output {
            width: 38px;
            height: 20px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 2px;
            text-align: center;
            line-height: 18px;
        }

    .pdv-total-box {
        border-radius: 21px;
        background: white;
        overflow: hidden;
        min-width: 0;
    }

        .pdv-total-box header {
            background: #1b6591;
            color: white;
            font-size: 14px;
            font-weight: bold;
            height: 24px;
            padding: 3px 15px;
            line-height: 18px;
        }

        .pdv-total-box strong {
            display: block;
            text-align: center;
            font-size: 40px;
            font-weight: 400;
            line-height: 1.35;
            overflow: auto;
        }

    .pdv-desconto {
        width: 40%;
    }

        .pdv-desconto header {
            height: 20px;
            padding-top: 1px;
        }

        .pdv-desconto strong {
            font-size: 23px;
            font-weight: bold;
        }

    .pdv-direita {
        display: grid;
        grid-template-rows: 62px minmax(0,1fr);
        gap: 7px;
        min-height: 0;
        min-width: 0;
        padding: 9px 6px 24px;
    }

    .pdv-entrada {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0,419px) 80px minmax(0,1fr);
        gap: 4px;
        padding: 5px 12px 11px;
        background: #1b6591;
        border-radius: 22px;
        align-items: start;
    }

    .pdv-busca {
        position: relative;
        min-width: 0;
    }

        .pdv-busca label, .pdv-quantidade label {
            display: block;
            font-size: 14px;
            font-weight: bold;
            height: 22px;
            white-space: nowrap;
        }

        .pdv-busca label {
            padding-left: 16px;
        }

        .pdv-busca input, .pdv-quantidade input {
            display: block;
            height: 24px;
            width: 100%;
            border: 0;
            border-radius: 0;
            padding: 0 5px;
            background: #e5f0fc;
            color: black;
            font: 18px Arial;
            outline-offset: 1px;
        }

    .pdv-quantidade input {
        background: white;
        text-align: center;
        font-size: 22px;
        color: #666;
    }

    .pdv-contingencia {
        justify-self: end;
        font-size: 11px;
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

        .pdv-contingencia input {
            margin: 0;
        }

    .pdv-grid-wrap {
        min-height: 0;
        overflow: auto;
        background: white;
    }

    .pdv-grid {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        color: black;
        font-size: 14px;
    }

        .pdv-grid th {
            background: #1b6591;
            color: white;
            font-weight: 400;
            height: 30px;
            text-align: left;
            padding: 0 14px;
            position: sticky;
            top: 0;
        }

        .pdv-grid td {
            padding: 8px 14px;
            border-bottom: 1px solid #e4edf2;
            overflow-wrap: anywhere;
        }

        .pdv-grid .numero {
            text-align: right;
        }

        .pdv-grid tbody tr:nth-child(even) {
            background: #f2f8fa;
        }

        .pdv-grid .remover {
            border: 0;
            background: transparent;
            color: #9b2020;
            cursor: pointer;
            font-size: 18px;
            padding: 0 4px;
        }

    .pdv-sugestoes {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 50;
        background: white;
        border: 1px solid #89aabb;
        max-height: 260px;
        overflow: auto;
        box-shadow: 0 5px 14px #0003;
    }

        .pdv-sugestoes button {
            display: block;
            width: 100%;
            background: white;
            border: 0;
            border-bottom: 1px solid #ddd;
            color: black;
            padding: 10px;
            text-align: left;
            cursor: pointer;
        }

            .pdv-sugestoes button:hover, .pdv-sugestoes button:focus {
                background: #e5f0fc;
            }

    .pdv-atalhos {
        display: flex;
        flex-wrap: wrap;
        align-content: end;
        gap: 3px 6px;
        padding: 0 3px 3px;
        font-size: 11px;
    }

        .pdv-atalhos button {
            border: 0;
            background: transparent;
            color: white;
            padding: 0;
            font: inherit;
            cursor: pointer;
        }

    .pdv-mensagem-principal {
        position: absolute;
        left: 32%;
        right: 3%;
        bottom: 40px;
        background: #fff;
        color: #153e58;
        border: 1px solid #689db7;
        padding: 8px 12px;
        z-index: 60;
    }

        .pdv-mensagem-principal button {
            float: right;
            border: 0;
            background: transparent;
            cursor: pointer;
            color: inherit;
        }

    .pdv-modal-fundo {
        --pdv-azul: #1b6591;
        --pdv-ciano: #0196aa;
        --pdv-ciano-claro: #effdfd;
        --pdv-verde: #16a34a;
        font-family: Arial, sans-serif;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.56);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
    }

    .pdv-modal {
        width: min(940px, 100%);
        min-height: 620px;
        background: var(--pdv-azul);
        color: white;
        display: grid;
        grid-template-columns: 1fr 104px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
    }

    .pdv-modal-main {
        display: grid;
        grid-template-rows: auto 1fr auto;
        padding: 26px;
    }

    .pdv-modal-lateral {
        background: var(--pdv-ciano);
        display: flex;
        align-items: start;
        justify-content: center;
        padding-top: 18px;
        font-weight: 900;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        letter-spacing: 1px;
    }

    .pdv-modal-titulo {
        text-align: center;
        font-size: 32px;
        font-weight: 900;
        margin: 0 0 16px;
    }

    .pdv-modal-card {
        background: var(--pdv-ciano-claro);
        color: black;
        width: min(590px, 100%);
        margin: 0 auto;
        padding: 22px;
        display: grid;
        gap: 16px;
        align-self: start;
    }

        .pdv-modal-card label {
            display: block;
            font-size: 16px;
            font-weight: 900;
            margin-bottom: 5px;
        }

    .pdv-modal input, .pdv-modal select {
        width: 100%;
        height: 42px;
        padding: 4px 10px;
        border: 1px solid #94a3b8;
        background: white;
        color: black;
        font-size: 18px;
    }

    .pdv-modal .pdv-mensagem {
        padding: 8px;
        color: #9b2020;
        background: white;
    }

    .pdv-modal-card .valor-grande {
        font-size: 38px;
        height: 64px;
        text-align: right;
    }

    .pdv-modal-acoes {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 16px;
        flex-wrap: wrap;
    }

    .pdv-botao {
        border: 1px solid #0f172a;
        min-height: 36px;
        padding: 7px 18px;
        background: white;
        color: black;
        font-weight: 800;
        cursor: pointer;
    }

        .pdv-botao.primario {
            background: var(--pdv-verde);
            border-color: #166534;
            color: white;
        }

        .pdv-botao.perigo {
            background: #fee2e2;
            border-color: #ef4444;
            color: #991b1b;
        }

    .pdv-finalizada {
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        color: #14532d;
        padding: 12px;
        font-weight: 800;
        text-align: center;
    }


    @@media (max-width: 1050px) {
        .pdv-header {
            flex-wrap: wrap;
        }

        .pdv-status {
            gap: 4px;
        }

        .pdv-espera {
            right: 14px;
            top: 39px;
            font-size: 11px;
        }

        .pdv-entrada {
            grid-template-columns: minmax(0,1fr) 80px;
        }

        .pdv-contingencia {
            display: none;
        }

        .pdv-busca label {
            padding-left: 0;
            font-size: 12px;
        }

        .pdv-contagem {
            gap: 4px;
        }

        .pdv-subtotal label {
            padding: 0 6px;
            font-size: 12px;
        }

        .pdv-subtotal strong {
            font-size: 20px;
        }
    }

    @@media (max-width: 650px) {
        .pdv-shell {
            grid-template-rows: 95px minmax(0,1fr) 56px;
        }

        .pdv-header {
            align-content: start;
            gap: 10px;
        }

        .pdv-status {
            flex-wrap: wrap;
        }

        .pdv-espera {
            top: 74px;
        }

        .pdv-conteudo {
            margin: 0 8px;
            grid-template-columns: 1fr;
            grid-template-rows: 135px minmax(0,1fr);
            border-radius: 14px;
        }

        .pdv-lateral {
            grid-template-columns: 30% minmax(0,1fr);
            grid-template-rows: 1fr;
            border-radius: 14px;
        }

        .pdv-logo {
            border-radius: 14px;
        }

        .pdv-resumo {
            grid-template-columns: minmax(0,1fr) minmax(0,1fr);
            grid-template-rows: 44px 54px;
            padding: 8px;
            gap: 7px;
        }

        .pdv-subtotal-linha {
            grid-column: 1 / -1;
        }

        .pdv-desconto {
            width: 100%;
        }

        .pdv-total-box strong {
            font-size: 23px;
        }

        .pdv-direita {
            padding-bottom: 10px;
        }

        .pdv-grid {
            min-width: 680px;
        }

        .pdv-busca label {
            font-size: 11px;
        }

        .pdv-quantidade label {
            font-size: 12px;
        }

        .pdv-mensagem-principal {
            left: 15px;
            right: 15px;
            bottom: 60px;
        }

        .pdv-modal {
            min-height: 0;
            max-height: 95dvh;
            overflow: auto;
            grid-template-columns: 1fr;
        }

        .pdv-modal-lateral {
            display: none;
        }

        .pdv-modal-main {
            padding: 15px;
        }
    }

    .pdv-pagamento, .pdv-pagamento * {
        box-sizing: border-box;
        letter-spacing: 0;
    }

    .pdv-pagamento {
        position: fixed;
        inset: 0;
        z-index: 2000;
        font-family: Arial, sans-serif;
        color: #000;
        background: #689db7;
        display: grid;
        grid-template-columns: minmax(0,1fr) 102px;
        grid-template-rows: 98px minmax(0,1fr);
    }

    .pagamento-cabecalho {
        display: flex;
        align-items: center;
        gap: 25px;
        background: #1b6591;
        color: white;
        min-width: 0;
        padding-right: 62px;
    }

        .pagamento-cabecalho h2 {
            margin: 0;
            font-size: 48px;
            font-weight: bold;
        }

        .pagamento-cabecalho strong {
            margin-left: auto;
            font-size: 48px;
            white-space: nowrap;
        }

    .pagamento-icone {
        width: 98px;
        height: 98px;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .pagamento-icone img {
            position: absolute;
            width: 1359px;
            height: 767px;
            max-width: none;
            left: 0;
            top: 0;
        }

    .pagamento-faixa {
        grid-column: 2;
        grid-row: 1 / -1;
        background: #1b6591;
        position: relative;
    }

    .pagamento-marca {
        position: relative;
        width: 102px;
        height: 112px;
        overflow: hidden;
    }

        .pagamento-marca img {
            position: absolute;
            width: 1359px;
            height: 767px;
            max-width: none;
            left: -1257px;
            top: 0;
        }

    .pagamento-fechar {
        position: absolute;
        bottom: 15px;
        left: 28px;
        border: 0;
        background: transparent;
        color: white;
        font-size: 28px;
        cursor: pointer;
    }

    .pagamento-corpo {
        position: relative;
        overflow: auto;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 60px 20px 30px 100px;
    }

    .pagamento-painel {
        width: 596px;
        min-height: 374px;
        flex-shrink: 0;
        background: #effdfd;
        border: 3px solid #e4ebee;
        margin: 0;
        padding: 20px 16px 44px;
        display: flex;
        justify-content: center;
    }

    .pagamento-campos {
        width: 252px;
        max-width: 100%;
        display: flex;
        flex-direction: column;
    }

        .pagamento-campos label {
            font-size: 17px;
            font-weight: bold;
            padding: 0 8px 3px;
            line-height: 21px;
        }

        .pagamento-campos input {
            width: 100%;
            height: 64px;
            border: 1px solid #e4e4e4;
            border-bottom-color: #999;
            border-radius: 0;
            background: white;
            color: black;
            padding: 0 3px;
            font: 50px Arial;
            margin-bottom: 6px;
        }

            .pagamento-campos input[readonly] {
                color: #6d6d6d;
            }

            .pagamento-campos input.pagamento-texto {
                height: 36px;
                font-size: 18px;
            }

    .pagamento-gravar {
        width: 100%;
        height: 24px;
        margin-top: 3px;
        border: 1px solid black;
        background: #effdfd;
        color: black;
        font: bold 12px Arial;
        cursor: pointer;
    }

    .pagamento-erro {
        color: #a71919;
        padding: 6px 0;
        font-size: 14px;
    }

    .pagamento-cartao-escolhido {
        width: 100%;
        min-height: 36px;
        padding: 5px;
        margin-bottom: 6px;
        background: white;
        border: 1px solid #999;
        color: black;
        text-align: left;
        font: bold 15px Arial;
        cursor: pointer;
    }

    .pagamento-cartoes {
        position: absolute;
        z-index: 2;
        top: 59px;
        left: calc(50% + 40px);
        transform: translateX(-50%);
        width: 552px;
        max-width: calc(100% - 32px);
        height: 398px;
        background: #0096aa;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 15px 24px #0003;
        display: grid;
        grid-template-rows: 30px 80px minmax(0,1fr) 26px;
        outline: none;
    }

    .cartoes-janela {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-left: 28px;
        font-size: 12px;
        color: #888;
        background: #f3f3f3;
    }

        .cartoes-janela button {
            border: 0;
            background: transparent;
            color: #777;
            width: 40px;
            height: 30px;
            font-size: 20px;
            cursor: pointer;
        }

    .cartoes-titulo {
        background: #1b6591;
        color: #eee;
        padding: 15px 28px;
        font-size: 38px;
    }

    .cartoes-grade {
        background: white;
        margin: 6px 12px 0;
        overflow: auto;
        border: 1px solid #b6c5cc;
    }

        .cartoes-grade table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .cartoes-grade th {
            background: white;
            font-size: 11px;
            font-weight: normal;
            text-align: left;
            height: 20px;
            padding: 0 6px;
            border: 1px solid #ddd;
        }

        .cartoes-grade td {
            border: 1px solid #aaa;
            height: 22px;
            padding: 0 5px;
            font-size: 17px;
            font-weight: bold;
            overflow-wrap: anywhere;
            cursor: pointer;
        }

        .cartoes-grade tr.selecionado {
            background: #007bd5;
            color: white;
        }

    .pagamento-cartoes footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 2px 12px;
    }

        .pagamento-cartoes footer button {
            background: transparent;
            color: white;
            border: 0;
            font: 12px Arial;
            cursor: pointer;
        }

    @@media (max-width: 700px) {
        .pdv-pagamento {
            grid-template-columns: minmax(0,1fr) 55px;
            grid-template-rows: 80px minmax(0,1fr);
        }

        .pagamento-cabecalho {
            gap: 8px;
            padding-right: 10px;
        }

            .pagamento-cabecalho h2, .pagamento-cabecalho strong {
                font-size: 24px;
            }

        .pagamento-icone {
            display: none;
        }

        .pagamento-cabecalho h2 {
            margin-left: 12px;
        }

        .pagamento-marca {
            transform: scale(.5);
            transform-origin: top left;
        }

        .pagamento-fechar {
            left: 12px;
        }

        .pagamento-corpo {
            padding: 25px 12px;
        }

        .pagamento-painel {
            width: 100%;
            min-height: 374px;
        }

        .pagamento-cartoes {
            top: 25px;
            left: 50%;
        }

        .cartoes-grade td {
            font-size: 12px;
            height: 30px;
        }
    }

    .pagamento-detalhes {
        display: grid;
        grid-template-columns: 108px minmax(0,264px);
        gap: 6px 8px;
        width: 380px;
        max-width: 100%;
        align-content: start;
        align-items: center;
        margin-top: 48px;
    }

        .pagamento-detalhes label {
            text-align: right;
            font-size: 17px;
            white-space: nowrap;
        }

        .pagamento-detalhes input {
            height: 29px;
            width: 100%;
            min-width: 0;
            border: 1px solid #ddd;
            border-bottom-color: #999;
            padding: 1px 3px;
            background: white;
            color: black;
            font: 18px Arial;
            border-radius: 0;
        }

