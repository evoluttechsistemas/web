<div class="pdv-shell">
    <header class="pdv-header">
        <nav class="pdv-menu" aria-label="Menu do caixa">
            <span>Acesso</span><span>Caixa</span><span>Opções</span><span>Delivery</span><span>TEF</span>
        </nav>
        <div class="pdv-status">
            <label>Operador <input value="ADM" readonly /></label>
            <label>Terminal <input class="terminal" value="1" readonly /></label>
            <label>Venda <input value="@NumeroVenda" readonly /></label>
            <label>Relógio <input class="relogio" value="@DateTime.Now.ToString("HH:mm:ss")" readonly /></label>
            <div class="pdv-janela">
                <button @onclick="SairTelaCheia">Minimizar</button>
                <button @onclick="AlternarTelaCheia">Restaurar</button>
                <button @onclick='() => Nav.NavigateTo("/cotacao")'>Fechar</button>
            </div>
        </div>
        <div class="pdv-espera">Vendas em espera <span>0</span></div>
    </header>
    <main class="pdv-conteudo">
        <aside class="pdv-lateral">
            <div class="pdv-logo"><img src="@LogoSuperMix" alt="SuperMix - Supermercado, Açougue, Padaria e Hortifruti" /></div>
            <div class="pdv-resumo">
                <div class="pdv-subtotal-linha">
                    <div class="pdv-subtotal"><label>Subtotal:</label><strong>@Subtotal.ToString("N2", PtBr)</strong></div>
                    <div class="pdv-contagem"><label>Qtd Itens</label><output>@(Itens.Count == 0 ? "" : Itens.Count.ToString())</output></div>
                </div>
                <div class="pdv-total-box pdv-desconto"><header>Desconto:</header><strong>0,00</strong></div>
                <div class="pdv-total-box"><header>Total Venda:</header><strong>@TotalVenda.ToString("N2", PtBr)</strong></div>
            </div>
        </aside>
        <section class="pdv-direita">
            <div class="pdv-entrada">
                <div class="pdv-busca">
                    <label for="pdv-produto">Código de Barras / Descrição / Código Interno</label>
                    <input id="pdv-produto" value="@ProdutoPesquisa" @oninput="OnProdutoInput" @onkeydown="ProdutoKeyDown" autocomplete="off" autofocus />
                    @if (ProdutosEncontrados.Count > 0)
                    {
                        <div class="pdv-sugestoes">
                            @foreach (var produto in ProdutosEncontrados)
                            {
                                <button type="button" @onclick="() => AdicionarProduto(produto)"><strong>@produto.CodBarras</strong> - @produto.Descricao</button>
                            }
                        </div>
                    }
                </div>
                <div class="pdv-quantidade">
                    <label for="pdv-quantidade">Quantidade (*)</label>
                    <input id="pdv-quantidade" value="@QuantidadeTexto" @oninput="e => QuantidadeTexto = e.Value?.ToString() ?? string.Empty" inputmode="decimal" />
                </div>
                <label class="pdv-contingencia"><input type="checkbox" disabled />Contingência</label>
            </div>
            <div class="pdv-grid-wrap">
                <table class="pdv-grid" aria-label="Itens da venda">
                    <colgroup><col style="width:6%" /><col style="width:8%" /><col style="width:32%" /><col style="width:7%" /><col style="width:14%" /><col style="width:13%" /><col style="width:16%" /><col style="width:4%" /></colgroup>
                    <thead><tr><th>Item</th><th>Cod</th><th>Produto</th><th>UN</th><th>Pr Unit</th><th>Qtd</th><th>Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Itens)
                        {
                            <tr>
                                <td>@item.Item</td>
                                <td>@item.CodigoBarras</td>
                                <td>@item.Descricao</td>
                                <td>UN</td>
                                <td class="numero">@item.PrecoUnitario.ToString("N2", PtBr)</td>
                                <td class="numero">@item.Quantidade.ToString("N3", PtBr)</td>
                                <td class="numero">@item.Total.ToString("N2", PtBr)</td>
                                <td><button class="remover" title="Remover item" aria-label="Remover item" @onclick="() => RemoverItem(item)">×</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    @if (!string.IsNullOrWhiteSpace(Mensagem))
    {
        <div class="pdv-mensagem-principal" role="status"><button @onclick="() => Mensagem = string.Empty" aria-label="Fechar aviso">×</button>@Mensagem</div>
    }
    <footer class="pdv-atalhos">
        <span>[F11 = Funções]</span><span>[CTRL+D = Desconto]</span>
        <button @onclick='() => AbrirPagamento("DIN")'>[F5 = Dinheiro]</button>
        <span>[F6 = Cheque a Vista]</span><span>[F7 = Cheque a Prazo]</span>
        <button @onclick='() => AbrirPagamento("CRC")'>[F8 = Cartão]</button>
        <button @onclick='() => AbrirPagamento("CRD")'>[F9 = Crediário]</button>
        <button @onclick='() => AbrirPagamento("PIX")'>[F10 = PIX]</button>
        <span>[CTRL+I = Cancela Item]</span><span>[CTRL+C = Consulta Vendas]</span><span>[CTRL+V = Cancela Venda]</span>
    </footer>
</div>

@if (ModalPagamentoAberto)
{
    <section class="pdv-pagamento" role="dialog" aria-modal="true" aria-labelledby="pagamento-titulo">
        <header class="pagamento-cabecalho">
            <div class="pagamento-icone"><img src="images/pagamento-referencia.png" alt="" /></div>
            <h2 id="pagamento-titulo">@TituloFormaPagamento</h2><strong>@Moeda(TotalVenda)</strong>
        </header>
        <aside class="pagamento-faixa">
            <div class="pagamento-marca"><img src="images/pagamento-referencia.png" alt="Evolut" /></div>
            <button class="pagamento-fechar" @onclick="FecharPagamento" title="Fechar" aria-label="Fechar pagamento">×</button>
        </aside>
        <main class="pagamento-corpo">
            <form class="pagamento-painel" @onsubmit="FinalizarPagamento" @onsubmit:preventDefault>
                @if (FormaPagamentoAtual is "CRC" or "PIX")
                {
                    <div class="pagamento-detalhes">
                        <label for="pagamento-valor">Valor Pago</label><input id="pagamento-valor" value="@ValorPagoTexto" @oninput="AtualizarValorPago" inputmode="decimal" />
                        @if (FormaPagamentoAtual == "CRC")
                        {
                            <label>Operadora</label>
                            <div class="pagamento-par"><input class="codigo" value="@CartaoSelecionado?.Codigo" readonly /><button type="button" @onclick="AbrirListaCartoes">@(CartaoSelecionado?.Descricao ?? "")</button></div>
                            <label>Vencimento</label>

                            <input class="curto" value="@DateTime.Today.AddDays(CartaoSelecionado?.Dias ?? 0).ToString("dd/MM/yyyy")" readonly />
                            <label for="pagamento-autorizacao">Autorização</label>

                            <div class="pagamento-par"><input id="pagamento-autorizacao" class="curto" @bind="AutorizacaoCartao" @bind:event="oninput" /><strong>@CartaoSelecionado?.Tipo</strong></div>
                            <span></span>

                            <input value="@CartaoSelecionado?.Dias" readonly />
                        }
                        else
                        {
                            <label>PIX</label>
                
                            <div class="pagamento-par"><input class="codigo" value="@PixSelecionado?.Codigo" readonly /><button type="button" @onclick="AbrirListaPix">@(PixSelecionado?.Descricao ?? "")</button></div>
                            <label>Conta</label>

                            <div class="pagamento-par"><input class="codigo" value="@PixSelecionado?.CodConta" readonly /><input value="@PixSelecionado?.Conta" readonly /></div>
                            <label for="pagamento-data">Data Crédito</label>

                            <input id="pagamento-data" class="curto" @bind="DataCreditoPix" @bind:event="oninput" />
                        }
                        @if (!string.IsNullOrWhiteSpace(MensagemPagamento))
                        {
                            <div class="pagamento-erro detalhe-erro" role="alert">@MensagemPagamento</div>
                        }
                        <span></span><button type="submit" class="pagamento-gravar">Gravar Venda</button>
                    </div>
                }
                else
                {
                    <div class="pagamento-campos">
                        <label for="pagamento-total">Total da Venda</label>
                        <input id="pagamento-total" value='@TotalVenda.ToString("N2", PtBr)' readonly />
                        @if (FormaPagamentoAtual == "CRC")
                        {
                            <label>Cartão</label>
                            <button type="button" class="pagamento-cartao-escolhido" @onclick="AbrirListaCartoes">@(CartaoSelecionado?.Descricao ?? "Selecionar cartão")</button>
                        }
                        @if (FormaPagamentoAtual == "CRD")
                        {
                            <label for="pagamento-cliente">Cliente</label>
                            <input id="pagamento-cliente" class="pagamento-texto" @bind="NomeClienteCrediario" @bind:event="oninput" />
                            <label for="pagamento-vencimento">Vencimento</label>
                            <input id="pagamento-vencimento" class="pagamento-texto" @bind="VencimentoCrediario" @bind:event="oninput" />
                        }
                        @if (FormaPagamentoAtual == "PIX")
                        {
                            <label for="pagamento-pix">Chave / Conta PIX</label>
                            <input id="pagamento-pix" class="pagamento-texto" @bind="ContaPix" @bind:event="oninput" />
                        }
                        <label for="pagamento-valor">Valor Pago</label>
                        <input id="pagamento-valor" value="@ValorPagoTexto" @oninput="AtualizarValorPago" inputmode="decimal" autocomplete="off" />
                        @if (FormaPagamentoAtual == "DIN")
                        {
                            <label for="pagamento-troco">Troco</label>
                
                            <input id="pagamento-troco" value="@TrocoTexto" readonly />
                        }
                        @if (!string.IsNullOrWhiteSpace(MensagemPagamento))
                        {
                            <div class="pagamento-erro" role="alert">@MensagemPagamento</div>
                        }
                        <button type="submit" class="pagamento-gravar">Gravar Venda</button>
                    </div>

                }
            </form>
            @if (ListaCartoesAberta)
            {
                <section id="pagamento-cartoes" class="pagamento-cartoes" tabindex="0" role="dialog" aria-modal="true" aria-label="Pesquisa Cartão">
                    <div class="cartoes-janela"><span>Pesquisa Cartão</span><button type="button" @onclick="FecharListaCartoes" aria-label="Fechar lista de cartões">×</button></div>
                    <header class="cartoes-titulo">Cartão</header>
                    <div class="cartoes-grade">
                        <table aria-label="Opções de cartão">
                            <colgroup><col style="width:12%" /><col style="width:48%" /><col style="width:20%" /><col style="width:20%" /></colgroup>
                            <thead><tr><th>Código</th><th>Descrição</th><th>Tipo</th><th>Dias</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < CartoesFixos.Length; i++)
                                {
                                    var indice = i;
                                    var cartao = CartoesFixos[i];
                                    <tr class="@(IndiceCartao == i ? "selecionado" : "")" aria-selected="@(IndiceCartao == i)" @onclick="() => IndiceCartao = indice" @ondblclick="() => EscolherCartao(indice)">
                                        <td>@cartao.Codigo</td>
                                        <td>@cartao.Descricao</td>
                                        <td>@cartao.Tipo</td>
                                        <td>@cartao.Dias</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer><button type="button" @onclick="() => EscolherCartao(IndiceCartao)">Selecionar</button></footer>
                </section>
            }
            @if (ListaPixAberta)
            {
                <section id="pagamento-pix-lista" class="pagamento-cartoes pagamento-pix-lista" tabindex="0" role="dialog" aria-modal="true" aria-label="Pesquisa PIX">
                    <div class="cartoes-janela"><span>Pesquisa PIX</span><button type="button" @onclick="FecharListaPix" aria-label="Fechar lista Pix">×</button></div>
                    <header class="cartoes-titulo">PIX</header>
                    <div class="cartoes-grade">
                        <table aria-label="Opções Pix">
                            <colgroup><col style="width:12%" /><col style="width:38%" /><col style="width:15%" /><col style="width:35%" /></colgroup>
                            <thead><tr><th>Código</th><th>Descrição</th><th>Cod Conta</th><th>Conta</th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < PixFixos.Length; i++)
                                {
                                    var indice = i;
                                    var pix = PixFixos[i];
                                    <tr class="@(IndicePix == i ? "selecionado" : "")" aria-selected="@(IndicePix == i)" @onclick="() => IndicePix = indice" @ondblclick="() => EscolherPix(indice)">
                                        <td>@pix.Codigo</td>
                                        <td>@pix.Descricao</td>
                                        <td>@pix.CodConta</td>
                                        <td>@pix.Conta</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer><button type="button" @onclick="() => EscolherPix(IndicePix)">Selecionar</button></footer>
                </section>
            }
        </main>
    </section>
}

@if (ImpressaoAberta)
{
    <section class="pdv-impressao" role="dialog" aria-modal="true" aria-labelledby="imprimir-titulo">
        <header id="imprimir-titulo">Imprimir Venda?</header>
        <main>
            <div class="impressora-imagem"><img src="@DesenhoImpressora" alt="Impressora com papel e conexao Wi-Fi" /></div>
            <div class="impressao-exportar"><button @onclick="ImprimirComprovanteAsync">PDF (F5)</button><button @onclick="CompartilharComprovanteAsync">WHATS APP (F6)</button></div>
            <label class="impressao-copias">Cópias <input id="impressao-copias" type="number" min="1" max="10" @bind="Copias" @bind:event="oninput" /></label>
            <div class="impressao-acoes"><button @onclick="ImprimirComprovanteAsync">Imprimir (Enter)</button><button @onclick="SairImpressao">Sair (ESC)</button></div>
            @if (!string.IsNullOrEmpty(MensagemImpressao))
            {
                <p role="alert">@MensagemImpressao</p>
            }
        </main>
    </section>
}
@if (UltimaVenda is not null)
{
    <div id="pdv-comprovantes" class="pdv-comprovantes">
        @for (var copia = 0; copia < Math.Clamp(Copias, 1, 10); copia++)
        {
            <article class="pdv-comprovante">
                <h2>SuperMix</h2><p>COMPROVANTE DE SIMULACAO</p><p>Venda @UltimaVenda.Numero - @UltimaVenda.Data.ToString("dd/MM/yyyy HH:mm:ss")</p>
                <table>
                    <thead><tr><th>Produto</th><th>Qtd</th><th>Unit.</th><th>Total</th></tr></thead>
                    <tbody>
                        @foreach (var item in UltimaVenda.Itens)
                        {
                            <tr><td>@item.Descricao</td><td>@item.Quantidade.ToString("N3", PtBr)</td><td>@Moeda(item.PrecoUnitario)</td><td>@Moeda(item.Total)</td></tr>
                        }
                    </tbody>
                </table>
                <p>Total: @Moeda(UltimaVenda.Total)</p><p>Pagamento: @UltimaVenda.Forma</p><p>Valor pago: @Moeda(UltimaVenda.Pago)</p><p>Troco: @Moeda(UltimaVenda.Troco)</p>
            </article>
        }
    </div>
}

@code {
    private const string DesenhoImpressora = "data:image/png;base64,";
    private const string LogoSuperMix = "data:image/png;base64,";
    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");

    private readonly List<PdvSimuladorItem> Itens = new();
    private List<PdvSimuladorProduto> ProdutosEncontrados = new();

    private IJSObjectReference? moduloHotkeys;
    private IJSObjectReference? inscricaoHotkeys;
    private DotNetObjectReference<PdvSimulador>? dotNetRef;
    private readonly CancellationTokenSource vidaPagina = new();
    private CancellationTokenSource? pesquisaPendente;
    private int versaoPesquisa;
    private bool descartado;

    private string ProdutoPesquisa = "";
    private string QuantidadeTexto = "1,000";
    private string Mensagem = "";
    private string NumeroVenda = DateTime.Now.ToString("HHmmss");
    private int ProximoItem = 1;

    private bool ModalPagamentoAberto;
    private bool VendaFinalizada;
    private string FormaPagamentoAtual = "";
    private string ValorPagoTexto = "0,00";
    private string TrocoTexto = "0,00";
    private bool ImpressaoAberta;
    private int Copias = 1;
    private string MensagemImpressao = "";
    private VendaComprovante? UltimaVenda;
    private sealed record VendaComprovante(string Numero, DateTime Data, List<PdvSimuladorItem> Itens, decimal Total, string Forma, decimal Pago, decimal Troco);
    private bool ListaPixAberta;
    private int IndicePix;
    private PixFixo? PixSelecionado;
    private string DataCreditoPix = DateTime.Today.ToString("dd/MM/yyyy");
    private string AutorizacaoCartao = "";
    private sealed record PixFixo(int Codigo, string Descricao, int CodConta, string Conta);
    private static readonly PixFixo[] PixFixos =
    {
        new(32, "PIX BRADESCO", 2, "BRADESCO"),
        new(33, "PIX SANTANDER", 3, "SANTANDER"),
        new(53, "MERCADO PAGO", 11, "MERCADO PAGO"),
        new(63, "PIX TESTE", 1, "CAIXA GERAL"),
        new(77, "PIX", 16, "NUBANK"),
        new(86, "PIX INTER", 15, "INTER"),
        new(409, "APPLESS", 1, "CAIXA GERAL"),
        new(410, "C6BANK", 1, "CAIXA GERAL"),
        new(411, "C6 PESQUEIRO", 1, "CAIXA GERAL"),
        new(412, "PAG BANK", 19, "PAG BANK")
    };
    private bool ListaCartoesAberta;
    private int IndiceCartao;
    private CartaoFixo? CartaoSelecionado;
    private string? focoPendente;
    private sealed record CartaoFixo(int Codigo, string Descricao, string Tipo, int Dias);
    private static readonly CartaoFixo[] CartoesFixos =
    {
        new(14, "MASTER CREDITO", "CRÉDITO", 30),
        new(15, "MASTER DEBITO", "DÉBITO", 1),
        new(16, "VISA CREDITO", "CRÉDITO", 30),
        new(17, "VISA DEBITO", "DÉBITO", 1),
        new(24, "TESTE CARTAO NOVO", "DÉBITO", 30),
        new(82, "ALIMENTAÇÃO", "CRÉDITO", 20),
        new(83, "REFEIÇÃO", "CRÉDITO", 10)
    };

    private string NomeClienteCrediario = "";
    private string VencimentoCrediario = DateTime.Now.AddDays(30).ToString("dd/MM/yyyy");
    private string ContaPix = "PIX SIMULADOR";
    private string MensagemPagamento = "";

    private decimal Subtotal => Itens.Sum(x => x.Total);
    private decimal TotalVenda => Subtotal;

    private string TituloFormaPagamento => FormaPagamentoAtual switch
    {
        "DIN" => "Dinheiro",
        "CRC" => "Cartão",
        "CRD" => "Crediario",
        "PIX" => "PIX",
        _ => "Forma de Pagamento"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focoPendente is not null && moduloHotkeys is not null)
        {
            var id = focoPendente;
            focoPendente = null;
            await ExecutarJsSeguroAsync("focusElement", id);
        }
        if (!firstRender)
            return;

        try
        {
            dotNetRef = DotNetObjectReference.Create(this);
            moduloHotkeys = await JS.InvokeAsync<IJSObjectReference>("import", Nav.ToAbsoluteUri("js/pdv-simulador.js").ToString());
            inscricaoHotkeys = await moduloHotkeys.InvokeAsync<IJSObjectReference>("registerHotkeys", dotNetRef);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) when (ex is JSException or OperationCanceledException)
        {
            Logger.LogError(ex, "Falha ao iniciar JavaScript do PDV.");
            Mensagem = "Nao foi possivel carregar os atalhos do PDV.";
            if (!descartado) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExecutarJsSeguroAsync(string metodo, params object[] argumentos)
    {
        if (descartado || moduloHotkeys is null) return;
        try
        {
            await moduloHotkeys.InvokeVoidAsync(metodo, argumentos);
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) when (ex is JSException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Falha na acao JavaScript {Metodo} do PDV.", metodo);
            if (!descartado)
            {
                if (ImpressaoAberta) MensagemImpressao = "Nao foi possivel executar a acao. Tente novamente.";
                else Mensagem = "Nao foi possivel executar a acao. Tente novamente.";
            }
        }
    }

    private async Task<List<PdvSimuladorProduto>?> ConsultarProdutosAsync(string termo, CancellationToken cancellationToken)
    {
        try
        {
            return await PdvService.BuscarProdutosAsync(termo);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao consultar BaseProdutos no PDV.");
            return null;
        }
    }

    private async Task OnProdutoInput(ChangeEventArgs e)
    {
        ProdutoPesquisa = (e.Value?.ToString() ?? "").ToUpperInvariant();
        var termo = ProdutoPesquisa.Trim();
        var versao = ++versaoPesquisa;
        pesquisaPendente?.Cancel();
        ProdutosEncontrados.Clear();

        if (termo.Length < 2)
        {
            ProdutosEncontrados.Clear();
            return;
        }

        using var cancelamento = CancellationTokenSource.CreateLinkedTokenSource(vidaPagina.Token);
        pesquisaPendente = cancelamento;
        try
        {
            await Task.Delay(300, cancelamento.Token);
            var produtos = await ConsultarProdutosAsync(termo, cancelamento.Token);
            if (descartado || versao != versaoPesquisa) return;
            if (produtos is null) Mensagem = "Nao foi possivel consultar os produtos. Verifique o log do servidor.";
            else ProdutosEncontrados = produtos;
        }
        catch (OperationCanceledException) when (cancelamento.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(pesquisaPendente, cancelamento)) pesquisaPendente = null;
        }
    }

    private async Task ProdutoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LancarProdutoPesquisa();
    }

    private async Task SairTelaCheia()
    {
        if (moduloHotkeys is not null)
            await ExecutarJsSeguroAsync("exitFullscreen");
    }

    private async Task AlternarTelaCheia()
    {
        if (moduloHotkeys is not null)
            await ExecutarJsSeguroAsync("toggleFullscreen");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "F5" or "F8" or "F9" or "F10")
            await AbrirPagamentoPorTecla(e.Key);
    }

    [JSInvokable]
    public async Task AtalhoPagamento(string tecla)
    {
        if (descartado) return;
        if (ImpressaoAberta)
        {
            if (tecla == "Escape") SairImpressao();
            else if (tecla is "Enter" or "F5") await ImprimirComprovanteAsync();
            else if (tecla == "F6") await CompartilharComprovanteAsync();
        }
        else if (ModalPagamentoAberto) TratarTeclaPagamento(tecla);
        else await AbrirPagamentoPorTecla(tecla);
        if (!descartado) await InvokeAsync(StateHasChanged);
    }

    private void TratarTeclaPagamento(string tecla)
    {
        if (tecla == "Escape")
        {
            if (ListaPixAberta) FecharListaPix();
            else if (ListaCartoesAberta) FecharListaCartoes();
            else FecharPagamento();
            return;
        }
        if (ListaPixAberta)
        {
            if (tecla == "ArrowDown") IndicePix = Math.Min(PixFixos.Length - 1, IndicePix + 1);
            else if (tecla == "ArrowUp") IndicePix = Math.Max(0, IndicePix - 1);
            else if (tecla == "Enter") EscolherPix(IndicePix);
        }
        else if (ListaCartoesAberta)
        {
            if (tecla == "ArrowDown") IndiceCartao = Math.Min(CartoesFixos.Length - 1, IndiceCartao + 1);
            else if (tecla == "ArrowUp") IndiceCartao = Math.Max(0, IndiceCartao - 1);
            else if (tecla == "Enter") EscolherCartao(IndiceCartao);
        }
        else if (tecla == "Enter") FinalizarPagamento();
    }

    private void AbrirListaPix()
    {
        ListaPixAberta = true;
        focoPendente = "pagamento-pix-lista";
    }
    private void FecharListaPix()
    {
        ListaPixAberta = false;
        focoPendente = "pagamento-valor";
    }
    private void EscolherPix(int indice)
    {
        PixSelecionado = PixFixos[indice];
        IndicePix = indice;
        ContaPix = PixSelecionado.Conta;
        FecharListaPix();
    }

    private async Task ImprimirComprovanteAsync()
    {
        if (moduloHotkeys is null || UltimaVenda is null) return;
        Copias = Math.Clamp(Copias, 1, 10);
        try
        {
            await ExecutarJsSeguroAsync("printReceipt");
        }
        catch (JSException)
        {
            MensagemImpressao = "Nao foi possivel abrir a impressao.";
        }
    }

    private async Task CompartilharComprovanteAsync()
    {
        if (moduloHotkeys is null || UltimaVenda is null) return;
        var texto = $"SuperMix - COMPROVANTE DE SIMULACAO\nVenda {UltimaVenda.Numero}\n"
            + string.Join("\n", UltimaVenda.Itens.Select(x => $"{x.Descricao}: {x.Quantidade.ToString("N3", PtBr)} x {Moeda(x.PrecoUnitario)} = {Moeda(x.Total)}"))
            + $"\nTotal: {Moeda(UltimaVenda.Total)}\nPagamento: {UltimaVenda.Forma}";
        await ExecutarJsSeguroAsync("shareReceipt", texto);
    }

    private void SairImpressao()
    {
        ImpressaoAberta = false;
        focoPendente = "pdv-produto";
    }

    private void AbrirListaCartoes()
    {
        ListaCartoesAberta = true;
        focoPendente = "pagamento-cartoes";
    }

    private void FecharListaCartoes()
    {
        ListaCartoesAberta = false;
        focoPendente = "pagamento-valor";
    }

    private void EscolherCartao(int indice)
    {
        CartaoSelecionado = CartoesFixos[indice];
        IndiceCartao = indice;
        FecharListaCartoes();
    }

    private async Task AbrirPagamentoPorTecla(string tecla)
    {
        var forma = tecla switch
        {
            "F5" => "DIN",
            "F8" => "CRC",
            "F9" => "CRD",
            "F10" => "PIX",
            _ => ""
        };

        if (!string.IsNullOrWhiteSpace(forma))
            AbrirPagamento(forma);

        await Task.CompletedTask;
    }

    private async Task LancarProdutoPesquisa()
    {
        if (string.IsNullOrWhiteSpace(ProdutoPesquisa))
        {
            Mensagem = "Digite um codigo de barras ou descricao.";
            return;
        }

        var termo = ProdutoPesquisa.Trim();
        var versao = ++versaoPesquisa;
        pesquisaPendente?.Cancel();
        ProdutosEncontrados.Clear();
        List<PdvSimuladorProduto>? produtos;
        try
        {
            produtos = await ConsultarProdutosAsync(termo, vidaPagina.Token);
        }
        catch (OperationCanceledException) when (vidaPagina.IsCancellationRequested) { return; }
        if (descartado || versao != versaoPesquisa) return;
        if (produtos is null)
        {
            Mensagem = "Nao foi possivel consultar os produtos. Verifique o log do servidor.";
            return;
        }

        if (produtos.Count == 0)
        {
            Mensagem = "Produto nao encontrado.";
            ProdutosEncontrados.Clear();
            return;
        }

        if (produtos.Count > 1 && !produtos.Any(x => x.CodBarras.Equals(ProdutoPesquisa.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            ProdutosEncontrados = produtos;
            Mensagem = "Selecione o produto na lista.";
            return;
        }

        var produto = produtos.FirstOrDefault(x => x.CodBarras.Equals(ProdutoPesquisa.Trim(), StringComparison.OrdinalIgnoreCase))
            ?? produtos.First();

        AdicionarProduto(produto);
    }

    private void AdicionarProduto(PdvSimuladorProduto produto)
    {
        ++versaoPesquisa;
        pesquisaPendente?.Cancel();
        var quantidade = LerDecimal(QuantidadeTexto);
        if (quantidade <= 0)
            quantidade = 1m;

        Itens.Add(new PdvSimuladorItem
        {
            Item = ProximoItem++,
            CodigoBarras = produto.CodBarras,
            Descricao = produto.Descricao,
            Quantidade = quantidade,
            PrecoUnitario = 10m
        });

        Mensagem = $"Produto lancado: {produto.Descricao}";
        ProdutoPesquisa = "";
        QuantidadeTexto = "1,000";
        ProdutosEncontrados.Clear();
    }

    private void RemoverItem(PdvSimuladorItem item)
    {
        Itens.Remove(item);
        ReordenarItens();
        Mensagem = "Item removido.";
    }

    private void ReordenarItens()
    {
        var item = 1;
        foreach (var vendaItem in Itens)
            vendaItem.Item = item++;

        ProximoItem = item;
    }

    private void AbrirPagamento(string forma)
    {
        if (ModalPagamentoAberto || ImpressaoAberta)
            return;
        if (TotalVenda <= 0)
        {
            Mensagem = "Inclua pelo menos um produto antes de fechar a venda.";
            return;
        }

        FormaPagamentoAtual = forma;
        ValorPagoTexto = TotalVenda.ToString("N2", PtBr);
        TrocoTexto = "0,00";
        MensagemPagamento = "";
        VendaFinalizada = false;
        ModalPagamentoAberto = true;
        CartaoSelecionado = null;
        PixSelecionado = null;
        IndicePix = 0;
        AutorizacaoCartao = "";
        DataCreditoPix = DateTime.Today.ToString("dd/MM/yyyy");
        ListaPixAberta = forma == "PIX";
        IndiceCartao = 0;
        ListaCartoesAberta = forma == "CRC";
        focoPendente = ListaCartoesAberta ? "pagamento-cartoes" : ListaPixAberta ? "pagamento-pix-lista" : forma == "CRD" ? "pagamento-cliente" : "pagamento-valor";
    }

    private void AtualizarValorPago(ChangeEventArgs e)
    {
        ValorPagoTexto = e.Value?.ToString() ?? "";
        var troco = LerDecimal(ValorPagoTexto) - TotalVenda;
        TrocoTexto = (troco > 0 ? troco : 0).ToString("N2", PtBr);
    }

    private void FinalizarPagamento()
    {
        if (!ModalPagamentoAberto || VendaFinalizada)
            return;
        if (FormaPagamentoAtual == "CRC" && CartaoSelecionado is null)
        {
            MensagemPagamento = "Selecione o cartao.";
            AbrirListaCartoes();
            return;
        }
        if (FormaPagamentoAtual == "PIX" && PixSelecionado is null)
        {
            MensagemPagamento = "Selecione a opcao PIX.";
            AbrirListaPix();
            return;
        }
        if (FormaPagamentoAtual == "PIX" && !DateTime.TryParseExact(DataCreditoPix, "dd/MM/yyyy", PtBr, DateTimeStyles.None, out _))
        {
            MensagemPagamento = "Informe uma data de credito valida.";
            return;
        }
        var valorPago = LerDecimal(ValorPagoTexto);

        if (valorPago <= 0)
        {
            MensagemPagamento = "Valor pago nao pode ser zero.";
            return;
        }

        if (valorPago < TotalVenda)
        {
            MensagemPagamento = "Valor pago nao pode ser menor que o total da venda.";
            return;
        }

        if (FormaPagamentoAtual == "CRD" && string.IsNullOrWhiteSpace(NomeClienteCrediario))
        {
            MensagemPagamento = "Informe o cliente para fechar em crediario.";
            return;
        }

        var complemento = FormaPagamentoAtual switch
        {
            "DIN" => $" Troco: {Moeda(LerDecimal(TrocoTexto))}.",
            "CRC" => $" Cartao: {CartaoSelecionado?.Descricao}. Tipo: {CartaoSelecionado?.Tipo}.",
            "CRD" => $" Cliente: {NomeClienteCrediario}.",
            "PIX" => $" Conta PIX: {ContaPix}.",
            _ => ""
        };

        var formaComprovante = FormaPagamentoAtual switch
        {
            "CRC" => CartaoSelecionado?.Descricao ?? TituloFormaPagamento,
            "PIX" => PixSelecionado?.Descricao ?? TituloFormaPagamento,
            _ => TituloFormaPagamento
        };
        UltimaVenda = new VendaComprovante(NumeroVenda, DateTime.Now,
            Itens.Select(x => new PdvSimuladorItem { Item = x.Item, CodigoBarras = x.CodigoBarras, Descricao = x.Descricao, Quantidade = x.Quantidade, PrecoUnitario = x.PrecoUnitario }).ToList(),
            TotalVenda, formaComprovante, valorPago, FormaPagamentoAtual == "DIN" ? Math.Max(0, valorPago - TotalVenda) : 0m);
        MensagemPagamento = $"Venda simulada finalizada em {TituloFormaPagamento}.{complemento}";
        Mensagem = MensagemPagamento;
        VendaFinalizada = true;
        Itens.Clear();
        ProximoItem = 1;
        NumeroVenda = DateTime.Now.ToString("HHmmss");
        ModalPagamentoAberto = false;
        ListaCartoesAberta = false;
        ListaPixAberta = false;
        ImpressaoAberta = true;
        MensagemImpressao = "";
        Copias = 1;
        focoPendente = "impressao-copias";
    }

    private void FecharPagamento()
    {
        ModalPagamentoAberto = false;
        ListaCartoesAberta = false;
        ListaPixAberta = false;
        focoPendente = "pdv-produto";
        VendaFinalizada = false;
        MensagemPagamento = "";
    }

    private static decimal LerDecimal(string valor)
    {
        if (decimal.TryParse(valor, NumberStyles.Any, PtBr, out var numero))
            return numero;

        if (decimal.TryParse(valor, NumberStyles.Any, CultureInfo.InvariantCulture, out numero))
            return numero;

        return 0m;
    }

    private static string Moeda(decimal valor)
        => valor.ToString("C", PtBr);

    public async ValueTask DisposeAsync()
    {
        descartado = true;
        ++versaoPesquisa;
        vidaPagina.Cancel();
        try
        {
            if (inscricaoHotkeys is not null)
            {
                await inscricaoHotkeys.InvokeVoidAsync("dispose");
                await inscricaoHotkeys.DisposeAsync();
            }

            if (moduloHotkeys is not null)
                await moduloHotkeys.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex) when (ex is JSException or OperationCanceledException)
        {
            Logger.LogDebug(ex, "PDV encerrado durante limpeza do JavaScript.");
        }

        dotNetRef?.Dispose();
        vidaPagina.Dispose();
    }
}
