@page "/"
@implements IAsyncDisposable
@inject IndexingService Indexer

<PageTitle>Visão geral · EvolutTech IA</PageTitle>
<div class="page-heading"><div><div class="eyebrow">CONHECIMENTO DO ERP</div><h1>Uma base para atender melhor.</h1><p>Acompanhe a análise do sistema e organize o que sua equipe sabe.</p></div><button class="primary" @onclick="Start" disabled="@(busy || !Indexer.IsReady || !Indexer.IsAvailable || Indexer.IsRunning)"><span>↻</span> @(Indexer.IsRunning ? "Indexando…" : "Atualizar conhecimento")</button></div>
@if (!Indexer.IsReady) { <div class="notice" role="status">Recuperando os dados das indexações anteriores. As configurações já podem ser acessadas.</div> }
@if (Indexer.InitializationWarning is { } initializationWarning) { <div class="notice warning-notice" role="alert">@initializationWarning</div> }
@if (notice is not null) { <div class="notice" role="status">@notice</div> }
<section class="metrics" aria-label="Resumo do último resultado">
    <article><span class="metric-icon">⌘</span><span>Arquivos C#</span><strong>@Number(Indexer.Result?.Files.Count)</strong><small>Código analisado</small></article>
    <article><span class="metric-icon">◈</span><span>Classes</span><strong>@Number(Indexer.Result?.Classes.Count)</strong><small>Declarações organizadas</small></article>
    <article><span class="metric-icon">ƒ</span><span>Métodos</span><strong>@Number(Indexer.Result?.MethodCount)</strong><small>Referências ao código</small></article>
    <article><span class="metric-icon">▤</span><span>Windows Forms</span><strong>@Number(Indexer.Result?.Forms.Count(f => f.FormEvidence == "semantic-inheritance"))</strong><small>Herança confirmada</small></article>
</section>
<div class="overview-grid">
    <section class="card source-card"><div class="section-heading"><h2>Código conectado ao conhecimento</h2><span class="badge">GITHUB</span></div><div class="repository-visual"><span class="repo-icon">⌘</span><div><strong>Seu ERP, como fonte.</strong><p>Da versão do código às telas utilizadas pelos clientes.</p></div></div><div class="source-steps"><span><b>01</b> Obter versão</span><i>→</i><span><b>02</b> Analisar</span><i>→</i><span><b>03</b> Consultar fontes</span></div><div class="card-bottom"><span>Somente leitura do repositório</span><a href="/fontes">Configurar fonte ↗</a></div></section>
    <section class="card"><div class="section-heading"><h2>Processamento</h2><span class="status-dot"></span></div>
        @if (Indexer.Current is { } current)
        {
            <div class="processing-state"><span class="badge @(current.State == "Failed" ? "warning" : "")">@StateLabel(current.State)</span><p>@current.Message</p><small>@current.StartedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm") · @current.Repository</small></div>
            <div class="index-timing"><span>Tempo: @Elapsed(current)</span>@if(current.UpdatedAt is { } updated) { <span>Último progresso: @updated.ToOffset(TimeSpan.FromHours(-3)).ToString("HH:mm:ss")</span> }</div>
            @if(Indexer.IsRunning && current.Total is > 0)
            { <progress class="index-progress" value="@current.Processed" max="@current.Total" aria-label="Progresso da etapa atual"></progress> }
            else if(Indexer.IsRunning)
            { <progress class="index-progress" aria-label="Etapa em andamento; total ainda não disponível"></progress> }
            @if(Indexer.IsRunning && current.UpdatedAt is { } lastUpdate && DateTimeOffset.UtcNow-lastUpdate>TimeSpan.FromMinutes(2))
            { <p class="field-help">Sem novo contador há mais de dois minutos. Uma etapa pesada pode estar em andamento; isso sozinho não confirma travamento.</p> }
            @if (Indexer.IsRunning) { <button class="text-button" @onclick="Cancel">Cancelar indexação</button> }
            @if (current.Commit is { Length: > 7 } commit) { <div class="commit">Versão <code>@commit[..7]</code></div> }
        }
        else
        { <div class="empty compact"><span>◷</span><h3>Pronto para a primeira análise</h3><p>Confira a fonte do código e inicie uma indexação para preencher este painel.</p></div> }
    </section>
</div>
<section class="card history"><div class="section-heading"><div><h2>Histórico de indexações</h2><p>Rastreabilidade de cada versão analisada.</p></div><span class="subtle">@Indexer.History.Count execução(ões)</span></div>
    @if (Indexer.History.Count == 0) { <div class="empty"><span>↻</span><h3>Seu histórico começa aqui</h3><p>As execuções e seus resultados aparecerão nesta lista.</p></div> }
    else
    { <div class="table-scroll"><table><thead><tr><th>Início</th><th>Repositório / versão</th><th>Situação</th><th>Arquivos</th><th>Diagnósticos</th></tr></thead><tbody>
        @foreach (var run in Indexer.History.Take(25))
        { <tr><td>@run.StartedAt.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm")</td><td><strong>@run.Repository</strong><small>@(run.Commit is { Length: > 7 } c ? c[..7] : string.IsNullOrWhiteSpace(run.Reference) ? "Referência padrão" : run.Reference)</small></td><td><span class="badge @(run.State is "Failed" or "Interrupted" ? "warning" : "")">@StateLabel(run.State)</span><small>@run.Message</small></td><td>@run.Files.ToString("N0")</td><td>@run.Issues.ToString("N0")</td></tr> }
    </tbody></table></div> }
</section>
<section class="next-step"><span class="next-icon">◇</span><div><h3>O contexto também vem da sua equipe.</h3><p>Registre orientações por segmento e módulo, com a autoria de quem conhece o ERP.</p></div><a class="secondary" href="/orientacoes">Cadastrar orientação →</a></section>

@code {
    private string? notice;
    private bool busy;
    private readonly CancellationTokenSource disposal = new();
    private Task? polling;
    protected override Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) polling = PollAsync(); return Task.CompletedTask; }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try { while (await timer.WaitForNextTickAsync(disposal.Token)) await InvokeAsync(StateHasChanged); }
        catch (OperationCanceledException) { }
    }
    private async Task Start()
    {
        busy = true;
        try { notice = (await Indexer.StartAsync()).Message; }
        catch (Exception ex) when (ex is IOException or ArgumentException or InvalidOperationException)
        { notice = "Não foi possível iniciar. Verifique a fonte e o armazenamento do servidor."; }
        finally { busy = false; }
    }
    private void Cancel() { Indexer.Cancel(); notice = "Cancelamento solicitado."; }
    private static string Elapsed(IndexRun run)
    {
        if (run.FinishedAt is null && run.State is not ("Running" or "Queued" or "CancelRequested")) return "não registrado";
        var duration = (run.FinishedAt ?? DateTimeOffset.UtcNow) - run.StartedAt;
        return duration.TotalHours >= 1 ? $"{(int)duration.TotalHours}h {duration.Minutes:00}min" : $"{Math.Max(0,(int)duration.TotalMinutes)}min {Math.Max(0,duration.Seconds):00}s";
    }
    private static string Number(int? value) => value?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) ?? "—";
    private static string StateLabel(string state) => state switch {
        "Queued" => "Na fila", "Running" => "Em andamento", "Completed" => "Concluída", "CompletedWithLimitations" => "Com limitações",
        "Failed" => "Falhou", "Cancelled" => "Cancelada", "CancelRequested" => "Cancelando", "Interrupted" => "Interrompida", _ => state };
    public async ValueTask DisposeAsync() { disposal.Cancel(); if (polling is not null) await polling; disposal.Dispose(); }
}
