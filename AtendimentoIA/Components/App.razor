<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="painel.css" />
    <link rel="stylesheet" href="login.css" />
    <HeadOutlet @rendermode="PageMode" />
</head>
<body>
    <Routes @rendermode="PageMode" />
    <div id="blazor-error-ui">A conexão com o painel foi interrompida. <a href="">Recarregar</a></div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
@code {
    [CascadingParameter] private HttpContext HttpContext {get;set;}=default!;
    private IComponentRenderMode? PageMode=>HttpContext.Request.Path.StartsWithSegments("/login")?null:InteractiveServer;
}
