<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>EvolutTech.IA.Painel</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data/**;src/**;tests/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
    <Content Include="tools/ScreenRenderer.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="src/**;tests/**;App_Data/**" />
    <EmbeddedResource Remove="src/**;tests/**;App_Data/**" />
    <Content Remove="src/**;tests/**;App_Data/**" />
    <None Remove="src/**;tests/**;App_Data/**" />
    <ProjectReference Include="src/EvolutTech.IA.Indexador/EvolutTech.IA.Indexador.csproj" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>

</Project>
