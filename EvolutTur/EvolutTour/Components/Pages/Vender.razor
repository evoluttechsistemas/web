                                <h6>Cartão de Crédito</h6>
                            </div>

                            <div class="payment-method @(vendas.FormaPagamento == "CartaoDebito" ? "selected" : "")"
                                 @onclick='() => SelecionarFormaPagamento("CartaoDebito")'>
                                <i class="fas fa-credit-card"></i>
                                <h6>Cartão de Débito</h6>
                            </div>

                            <div class="payment-method @(vendas.FormaPagamento == "Boleto" ? "selected" : "")"
                                 @onclick='() => SelecionarFormaPagamento("Boleto")'>
                                <i class="fas fa-barcode"></i>
                                <h6>Boleto</h6>
                            </div>

                            <div class="payment-method @(vendas.FormaPagamento == "Pix" ? "selected" : "")"
                                 @onclick='() => SelecionarFormaPagamento("Pix")'>
                                <i class="fas fa-qrcode"></i>
                                <h6>Pix</h6>
                            </div>

                            <div class="payment-method @(vendas.FormaPagamento == "Transferencia" ? "selected" : "")"
                                 @onclick='() => SelecionarFormaPagamento("Transferencia")'>
                                <i class="fas fa-exchange-alt"></i>
                                <h6>Transferência</h6>
                            </div>

                            <div class="payment-method @(vendas.FormaPagamento == "Dinheiro" ? "selected" : "")"
                                 @onclick='() => SelecionarFormaPagamento("Dinheiro")'>
                                <i class="fas fa-money-bill-wave"></i>
                                <h6>Dinheiro</h6>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(vendas.FormaPagamento))
                        {
                            <div class="dynamic-fields mt-3">
                                @switch (vendas.FormaPagamento)
                                {
                                    case "CartaoCredito":
                                    case "CartaoDebito":
                                        <h5>Dados do Cartão</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label">Número do Cartão</label>
                                                    <input class="form-control" @bind="vendas.NumeroCartao" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label">Nome no Cartão</label>
                                                    <input class="form-control" @bind="vendas.NomeCartao" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-label">Validade</label>
                                                    <input class="form-control" placeholder="MM/AA" @bind="vendas.ValidadeCartao" />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-label">CVV</label>
                                                    <input class="form-control" @bind="vendas.CvvCartao" />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label class="form-label">Parcelas</label>
                                                    <select class="form-control" @bind="vendas.Parcelas">
                                                        <option value="1">1x</option>
                                                        <option value="2">2x</option>
                                                        <option value="3">3x</option>
                                                        <option value="4">4x</option>
                                                        <option value="5">5x</option>
                                                        <option value="6">6x</option>
                                                        <option value="7">7x</option>
                                                        <option value="8">8x</option>
                                                        <option value="9">9x</option>
                                                        <option value="10">10x</option>
                                                        <option value="11">11x</option>
                                                        <option value="12">12x</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        break;

                                    case "Boleto":
                                        <h5>Boleto Bancário</h5>
                                        <div class="alert alert-info">
                                            O boleto será gerado após a confirmação da compra e enviado para o e-mail do cliente.
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Vencimento</label>
                                            <input type="date" class="form-control" @bind="vendas.VencimentoBoleto" />
                                        </div>
                                        break;

                                    case "Pix":
                                        <h5>Pagamento via Pix</h5>
                                        <div class="alert alert-info">
                                            O QR Code será gerado após a confirmação da compra.
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Chave Pix</label>
                                            <select class="form-control" @bind="vendas.ChavePix">
                                                <option value="CPF">CPF</option>
                                                <option value="CNPJ">CNPJ</option>
                                                <option value="Email">E-mail</option>
                                                <option value="Celular">Celular</option>
                                                <option value="Aleatoria">Chave Aleatória</option>
                                            </select>
                                        </div>
                                        break;
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <button class="btn btn-secondary" @onclick="() => vendas.ActiveTab = 2"><i class="fas fa-arrow-left"></i> Anterior</button>
                            <button class="btn btn-primary" @onclick="() => vendas.ActiveTab = 4">Próximo <i class="fas fa-arrow-right"></i></button>
                        </div>
                    </div>
                </div>

                <div class="tab-content @(vendas.ActiveTab == 4 ? "active" : "")">
                    <div class="card">
                        <div class="card-title">
                            <i class="fas fa-file-alt"></i> Resumo da Venda
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <h5>Informações da Venda</h5>
                                <div class="info-item">
                                    <strong>Fornecedor:</strong> @vendas.Grupo
                                </div>
                                <div class="info-item">
                                    <strong>Vendedor:</strong> @vendas.Consultor
                                </div>
                                <div class="info-item">
                                    <strong>Data da Venda:</strong> @vendas.DataVenda.ToShortDateString()
                                </div>
                                <div class="info-item">
                                    <strong>Cliente:</strong> @vendas.ResponsavelCompra
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h5>Itens de Venda</h5>
                                <div class="info-item">
                                    <strong>Item Selecionado:</strong> @GetNomeItem(vendas.ItemSelecionado)
                                </div>
                                @if (!string.IsNullOrEmpty(vendas.ItemSelecionado))
                                {
                                    <div class="info-item">
                                        <strong>Valor:</strong> @vendas.ValorItem.ToString("C")
                                    </div>
                                }

                                <h5 class="mt-3">Pagamento</h5>
                                <div class="info-item">
                                    <strong>Forma de Pagamento:</strong> @GetNomePagamento(vendas.FormaPagamento)
                                </div>
                                @if (vendas.FormaPagamento == "CartaoCredito" || vendas.FormaPagamento == "CartaoDebito")
                                {
                                    <div class="info-item">
                                        <strong>Parcelas:</strong> @vendas.Parcelas
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="total-section mt-4">
                            <h4>Total: @CalcularTotal().ToString("C")</h4>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button class="btn btn-secondary"
                                @onclick="() => vendas.ActiveTab = 3"
                                disabled="@isFinalizando">
                            <i class="fas fa-arrow-left"></i> Anterior
                        </button>

                        <button class="btn btn-success"
                                @onclick="FinalizarVenda"
                                disabled="@isFinalizando">
                            <i class="fas fa-check"></i> Finalizar Venda
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>



@code {
    Models.Vender vendas = new Models.Vender();
    private List<Vender> viajantes = new();
    private string fornecedorBusca { get; set; }
    private List<Fornecedor> fornecedores { get; set; } = new();
    private List<Fornecedor> fornecedoresFiltrados { get; set; } = new();
    private string vendedorBusca { get; set; }
    private List<Models.Vendedor> vendedores { get; set; } = new();
    private List<Models.Vendedor> vendedoresFiltrados { get; set; } = new();
    private string clienteBusca { get; set; }
    private List<Cliente> clientes { get; set; } = new();
    private List<Cliente> clientesFiltrados { get; set; } = new();
    public int codFornecedorBusca { get; set; }
    public int codVendedorBusca { get; set; }
    public int codClienteBusca { get; set; }
    [Inject] private IJSRuntime JS { get; set; }
    private bool isFinalizando = false;

    private void AdicionarViajante() => vendas.Viajantes.Add(new Models.VendaViajante());

    protected override async Task OnInitializedAsync()
    {
        // Aqui você puxa do banco
        int CodEmp = await CarregarCodEmpAsync();
        fornecedores = await vendaService.BuscaFornecedor(CodEmp, "");
        vendedores = await vendaService.BuscarVendedor(CodEmp, "");
        clientes = await vendaService.BuscarCliente(CodEmp, "");
    }

    private void FiltrarVendedores(ChangeEventArgs e)
    {
        codVendedorBusca = 0;
        vendedorBusca = e.Value?.ToString();
        vendedoresFiltrados = vendedores
            .Where(v => v.Nome.Contains(vendedorBusca, StringComparison.OrdinalIgnoreCase))
            .Take(10)
            .ToList();
    }

    private void FiltrarClientes(ChangeEventArgs e)
    {
        codClienteBusca = 0;
        clienteBusca = e.Value?.ToString();
        clientesFiltrados = clientes
            .Where(c => c.Nome.Contains(clienteBusca, StringComparison.OrdinalIgnoreCase))
            .Take(10)
            .ToList();
    }

    private void SelecionarCliente(Cliente cliente)
    {
        vendas.ResponsavelCompra = cliente.Nome; // ou cliente.Id, se preferir
        clienteBusca = cliente.Nome;
        codClienteBusca = cliente.Codigo;
        clientesFiltrados.Clear();
    }

    private void SelecionarVendedor(Models.Vendedor vendedor)
    {
        vendas.Consultor = vendedor.Nome; // ou vendedor.Id, depende da regra
        vendedorBusca = vendedor.Nome;
        codVendedorBusca = vendedor.Codigo;

        vendas.PercentualComissaoVendedor = vendedor.Comissao;

        vendedoresFiltrados.Clear();
    }

    private async Task<int> CarregarCodEmpAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            return int.Parse(user.FindFirst("CodEmp")?.Value);
        }

        return 0;
    }

    private void FiltrarFornecedores(ChangeEventArgs e)
    {
        codFornecedorBusca = 0;
        fornecedorBusca = e.Value?.ToString();
        fornecedoresFiltrados = fornecedores
            .Where(f => f.Razao.Contains(fornecedorBusca, StringComparison.OrdinalIgnoreCase))
            .Take(10)
            .ToList();
    }

    private void SelecionarFornecedor(Fornecedor fornecedor)
    {
        vendas.Grupo = fornecedor.Razao; // ou fornecedor.Id, depende da regra
        fornecedorBusca = fornecedor.Razao;
        codFornecedorBusca = fornecedor.Codigo;

        vendas.PercentualComissaoFornecedor = fornecedor.Comissao;

        fornecedoresFiltrados.Clear();
    }

    private void SelecionarItem(string item)
    {
        vendas.ItemSelecionado = item;
    }

    private void SelecionarFormaPagamento(string forma)
    {
        vendas.FormaPagamento = forma;
    }

    private string GetNomeItem(string item)
    {
        return item switch
        {
            "PassagemAerea" => "Passagem Aérea",
            "DiariaHospedagem" => "Diária de Hospedagem",
            "PacoteTuristico" => "Pacote Turístico",
            "SeguroViagem" => "Seguro Viagem",
            "AluguelVeiculo" => "Aluguel de Veículo",
            "Rodoviario" => "Rodoviário",
            "Trem" => "Trem",
            "Cruzeiro" => "Cruzeiro",
            "Passeio" => "Passeio",
            "Ingresso" => "Ingresso",
            "Educacional" => "Educacional",
            "Outro" => "Outro",
            _ => "Nenhum item selecionado"
        };
    }

    private string GetNomePagamento(string pagamento)
    {
        return pagamento switch
        {
            "CartaoCredito" => "Cartão de Crédito",
            "CartaoDebito" => "Cartão de Débito",
            "Boleto" => "Boleto Bancário",
            "Pix" => "Pix",
            "Transferencia" => "Transferência Bancária",
            "Dinheiro" => "Dinheiro",
            _ => "Nenhuma forma selecionada"
        };
    }

    private decimal CalcularTotal()
    {
        return vendas.ValorItem;
    }

    private void IncrementarViajantes()
    {
        vendas.Viajantes.Add(new Models.VendaViajante());
    }

    private void DecrementarViajantes()
    {
        if (vendas.Viajantes.Count > 0)
            vendas.Viajantes.RemoveAt(vendas.Viajantes.Count - 1);
    }

    private async Task FinalizarVenda()
    {
        try
        {
            if (codClienteBusca == 0)
            {
                await JS.InvokeVoidAsync("alert", "É obrigatório informar o cliente!");
                return;
            }

            if (vendas.ValorItem <= 0)
            {
                await JS.InvokeVoidAsync("alert", "É obrigatório informar o valor!");
                return;
            }

            if (codVendedorBusca == 0)
            {
                await JS.InvokeVoidAsync("alert", "É obrigatório informar o vendedor!");
                return;
            }

            if (codFornecedorBusca == 0)
            {
                await JS.InvokeVoidAsync("alert", "É obrigatório informar o fornecedor!");
                return;
            }

            var a = vendas.FormaPagamento;

            if (a == "")
            {
                await JS.InvokeVoidAsync("alert", "É obrigatório informar um pagamento!");
                return;
            }

            int CodEmp = await CarregarCodEmpAsync();
            int codVendaC = await vendaService.AdicionarVendaC(
                CodEmp,
                codFornecedorBusca,
                codVendedorBusca,
                vendas.DataVenda.ToString("yyyy-MM-dd"),
                codClienteBusca,
                vendas.OrcamentoAtendimento,
                vendas.ValorItem,
                vendas.PercentualComissaoFornecedor,
                vendas.PercentualComissaoVendedor
            );

            await vendaService.AdicionarViajantes(codVendaC, vendas.Viajantes);

            await vendaService.AdicionarItens(codVendaC, vendas);

            await vendaService.AdicionarContaReceber(codVendaC, vendas, vendas.ValorItem);

            vendas.Status = "Concluído";
            vendas.Clear();
            Navigation.NavigateTo("/vender", forceLoad: true);

        }
        finally
        {
            isFinalizando = false; // 🔓 Reativa se você quiser liberar novamente
        }
    }
}