@page "/admin-cupons"
@rendermode InteractiveServer
@layout AdminLayout
@inject IJSRuntime JS

<PageTitle>Cupons - Admin</PageTitle>

<style>
    .cupons-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin-top: 24px;
    }

    .cupom-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px;
        padding: 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

        .cupom-card::before {
            content: '🎫';
            position: absolute;
            font-size: 8rem;
            opacity: 0.1;
            right: -20px;
            top: -20px;
        }

    .cupom-codigo {
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: 2px;
        margin-bottom: 12px;
        font-family: 'Courier New', monospace;
        border: 2px dashed rgba(255,255,255,0.5);
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        background: rgba(255,255,255,0.1);
    }

    .cupom-desconto {
        font-size: 2.5rem;
        font-weight: 900;
        text-align: center;
        margin-bottom: 16px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .cupom-descricao {
        font-size: 0.9rem;
        opacity: 0.95;
        margin-bottom: 16px;
        text-align: center;
    }

    .cupom-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px solid rgba(255,255,255,0.2);
        font-size: 0.85rem;
    }

    .cupom-acoes {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn-acao {
        flex: 1;
        padding: 8px;
        border-radius: 6px;
        border: 2px solid white;
        background: rgba(255,255,255,0.2);
        color: white;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.3s;
    }

        .btn-acao:hover {
            background: white;
            color: #764ba2;
        }
</style>

<div class="header-actions" style="display:flex; justify-content:space-between; margin-bottom:24px;">
    <h2>🎫 Gestão de Cupons</h2>
    <button class="btn-novo" style="background:#764ba2; color:white; border:none; padding:12px 24px; border-radius:8px; font-weight:600; cursor:pointer;"
            @onclick="NovoCupom">
        + Novo Cupom
    </button>
</div>

<div class="cupons-grid">

    <div class="cupom-card">
        <div class="cupom-codigo">BEMVINDO10</div>
        <div class="cupom-desconto">10% OFF</div>
        <div class="cupom-descricao">
            Cupom de boas-vindas para novos clientes
        </div>
        <div class="cupom-footer">
            <span>📅 Sem validade</span>
            <span>🎯 Usado 45x</span>
        </div>
        <div class="cupom-acoes">
            <button class="btn-acao" @onclick='() => EditarCupom(1)'>✏️ Editar</button>
            <button class="btn-acao" @onclick='() => DesativarCupom(1)'>⏸️ Pausar</button>
        </div>
    </div>

    <div class="cupom-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
        <div class="cupom-codigo">PIZZA20</div>
        <div class="cupom-desconto">20% OFF</div>
        <div class="cupom-descricao">
            Desconto exclusivo em todas as pizzas
        </div>
        <div class="cupom-footer">
            <span>📅 Até 31/01/2024</span>
            <span>🎯 Usado 128x</span>
        </div>
        <div class="cupom-acoes">
            <button class="btn-acao" @onclick='() => EditarCupom(2)'>✏️ Editar</button>
            <button class="btn-acao" @onclick='() => DesativarCupom(2)'>⏸️ Pausar</button>
        </div>
    </div>

    <div class="cupom-card" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
        <div class="cupom-codigo">FRETEGRATIS</div>
        <div class="cupom-desconto">R$ 0,00</div>
        <div class="cupom-descricao">
            Frete grátis para pedidos acima de R$ 40,00
        </div>
        <div class="cupom-footer">
            <span>📅 Sem validade</span>
            <span>🎯 Usado 89x</span>
        </div>
        <div class="cupom-acoes">
            <button class="btn-acao" @onclick='() => EditarCupom(3)'>✏️ Editar</button>
            <button class="btn-acao" @onclick='() => DesativarCupom(3)'>⏸️ Pausar</button>
        </div>
    </div>

    <div class="cupom-card" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);">
        <div class="cupom-codigo">BLACKFRIDAY</div>
        <div class="cupom-desconto">50% OFF</div>
        <div class="cupom-descricao">
            Mega desconto de Black Friday em todo o cardápio
        </div>
        <div class="cupom-footer">
            <span>📅 Até 26/11/2024</span>
            <span>🎯 Usado 234x</span>
        </div>
        <div class="cupom-acoes">
            <button class="btn-acao" @onclick='() => EditarCupom(4)'>✏️ Editar</button>
            <button class="btn-acao" @onclick='() => DesativarCupom(4)'>⏸️ Pausar</button>
        </div>
    </div>

    <div class="cupom-card" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); opacity:0.6;">
        <div class="cupom-codigo">NATAL2023</div>
        <div class="cupom-desconto">15% OFF</div>
        <div class="cupom-descricao">
            Cupom especial de Natal (EXPIRADO)
        </div>
        <div class="cupom-footer">
            <span>📅 Expirado</span>
            <span>🎯 Usado 567x</span>
        </div>
        <div class="cupom-acoes">
            <button class="btn-acao" @onclick='() => DuplicarCupom(5)'>📋 Duplicar</button>
        </div>
    </div>

</div>

@code {
    private async Task NovoCupom()
    {
        await JS.InvokeVoidAsync("alert", "Modal de novo cupom em desenvolvimento!");
    }

    private async Task EditarCupom(int id)
    {
        await JS.InvokeVoidAsync("alert", $"Editar cupom #{id}");
    }

    private async Task DesativarCupom(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Desativar este cupom?");
        if (confirmado)
        {
            await JS.InvokeVoidAsync("alert", "Cupom desativado!");
        }
    }

    private async Task DuplicarCupom(int id)
    {
        await JS.InvokeVoidAsync("alert", "Cupom duplicado com sucesso!");
    }
}
