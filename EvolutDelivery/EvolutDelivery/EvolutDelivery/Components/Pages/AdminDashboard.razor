@page "/admin-dashboard"
@rendermode InteractiveServer
@layout AdminLayout
@using EvolutDelivery.Services
@inject PedidoService PedidoService
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Dashboard - Admin</PageTitle>

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        border-left: 4px solid var(--primary);
    }

        .stat-card.success {
            border-left-color: #16a34a;
        }

        .stat-card.warning {
            border-left-color: #f59e0b;
        }

        .stat-card.danger {
            border-left-color: #ef4444;
        }

        .stat-card h3 {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-card .number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 8px;
        }

        .stat-card .change {
            font-size: 0.85rem;
            color: #16a34a;
        }

            .stat-card .change.negative {
                color: #ef4444;
            }

    .chart-container {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 24px;
    }

        .chart-container h3 {
            margin-bottom: 20px;
            color: #0f172a;
        }
</style>

<h2 style="margin-bottom:24px;">📈 Dashboard Geral</h2>

<div class="dashboard-grid">

    <div class="stat-card">
        <h3>📦 Pedidos Hoje</h3>
        <div class="number">@totalPedidosHoje</div>
        <div class="change">+12% vs ontem</div>
    </div>

    <div class="stat-card success">
        <h3>💰 Faturamento Hoje</h3>
        <div class="number">R$ @faturamentoHoje.ToString("N2")</div>
        <div class="change">+8% vs ontem</div>
    </div>

    <div class="stat-card warning">
        <h3>⏳ Pedidos Pendentes</h3>
        <div class="number">@pedidosPendentes</div>
        <div class="change">Aguardando confirmação</div>
    </div>

    <div class="stat-card danger">
        <h3>🚚 Em Entrega</h3>
        <div class="number">@pedidosEmEntrega</div>
        <div class="change">Em andamento</div>
    </div>

</div>

<div class="chart-container">
    <h3>📊 Pedidos dos Últimos 7 Dias</h3>
    <p style="color:#64748b;">Gráfico em desenvolvimento...</p>
</div>

<div class="chart-container">
    <h3>🍔 Produtos Mais Vendidos</h3>
    <p style="color:#64748b;">Lista em desenvolvimento...</p>
</div>

@code {
    private int totalPedidosHoje = 0;
    private decimal faturamentoHoje = 0;
    private int pedidosPendentes = 0;
    private int pedidosEmEntrega = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estatisticas = await PedidoService.ObterEstatisticasAsync(1, DateTime.Today);
            
            totalPedidosHoje = estatisticas.Values.Sum();
            pedidosPendentes = estatisticas.GetValueOrDefault("Pendentes", 0);
            pedidosEmEntrega = estatisticas.GetValueOrDefault("EmEntrega", 0);

            // Calcular faturamento (exemplo)
            var pedidos = await PedidoService.ListarPedidosAsync(1, dataInicio: DateTime.Today);
            faturamentoHoje = pedidos.Sum(p => p.ValorTotal);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dashboard: {ex.Message}");
        }
    }
}
