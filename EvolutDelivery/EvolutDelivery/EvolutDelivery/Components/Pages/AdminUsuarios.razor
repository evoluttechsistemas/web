@page "/admin-usuarios"
@rendermode InteractiveServer
@layout AdminLayout
@inject IJSRuntime JS

<PageTitle>Usuários - Admin</PageTitle>

<style>
    .usuarios-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-top: 24px;
    }

        .usuarios-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .usuarios-table th {
            background: #f8fafc;
            padding: 16px;
            text-align: left;
            font-weight: 600;
            color: #64748b;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .usuarios-table td {
            padding: 16px;
            border-top: 1px solid #f1f5f9;
        }

    .badge-role {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .badge-role.admin {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-role.gerente {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-role.atendente {
            background: #d1fae5;
            color: #065f46;
        }

    .badge-status {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .badge-status.ativo {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-status.inativo {
            background: #fee2e2;
            color: #991b1b;
        }
</style>

<div style="display:flex; justify-content:space-between; margin-bottom:24px;">
    <h2>👤 Gestão de Usuários</h2>
    <button style="background:#2563eb; color:white; border:none; padding:12px 24px; border-radius:8px; font-weight:600; cursor:pointer;"
            @onclick="NovoUsuario">
        + Novo Usuário
    </button>
</div>

<div class="usuarios-table">
    <table>
        <thead>
            <tr>
                <th>Usuário</th>
                <th>Email</th>
                <th>Perfil</th>
                <th>Status</th>
                <th>Último Acesso</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Admin Sistema</strong></td>
                <td>admin@evolutdelivery.com</td>
                <td><span class="badge-role admin">👑 Administrador</span></td>
                <td><span class="badge-status ativo">Ativo</span></td>
                <td>Agora</td>
                <td>
                    <button style="background:#2563eb; color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-weight:600;"
                            @onclick='() => EditarUsuario(1)'>
                        ✏️ Editar
                    </button>
                </td>
            </tr>
            <tr>
                <td><strong>Gerente Loja</strong></td>
                <td>gerente@evolutdelivery.com</td>
                <td><span class="badge-role gerente">👨‍💼 Gerente</span></td>
                <td><span class="badge-status ativo">Ativo</span></td>
                <td>Há 2 horas</td>
                <td>
                    <button style="background:#2563eb; color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-weight:600;"
                            @onclick='() => EditarUsuario(2)'>
                        ✏️ Editar
                    </button>
                </td>
            </tr>
            <tr>
                <td><strong>Atendente 1</strong></td>
                <td>atendente1@evolutdelivery.com</td>
                <td><span class="badge-role atendente">👨‍💻 Atendente</span></td>
                <td><span class="badge-status ativo">Ativo</span></td>
                <td>Há 30 minutos</td>
                <td>
                    <button style="background:#2563eb; color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-weight:600;"
                            @onclick='() => EditarUsuario(3)'>
                        ✏️ Editar
                    </button>
                </td>
            </tr>
            <tr>
                <td><strong>Atendente 2</strong></td>
                <td>atendente2@evolutdelivery.com</td>
                <td><span class="badge-role atendente">👨‍💻 Atendente</span></td>
                <td><span class="badge-status inativo">Inativo</span></td>
                <td>Há 3 dias</td>
                <td>
                    <button style="background:#2563eb; color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-weight:600;"
                            @onclick='() => EditarUsuario(4)'>
                        ✏️ Editar
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div style="background:white; padding:24px; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); margin-top:24px;">
    <h3>🔐 Perfis e Permissões</h3>
    <div style="display:grid; gap:16px; margin-top:16px;">
        <div style="padding:16px; background:#f8fafc; border-radius:8px;">
            <div style="font-weight:700; margin-bottom:8px;">👑 Administrador</div>
            <div style="font-size:0.9rem; color:#64748b;">Acesso total ao sistema, incluindo configurações críticas e gerenciamento de usuários.</div>
        </div>
        <div style="padding:16px; background:#f8fafc; border-radius:8px;">
            <div style="font-weight:700; margin-bottom:8px;">👨‍💼 Gerente</div>
            <div style="font-size:0.9rem; color:#64748b;">Gerenciar pedidos, produtos, entregadores e visualizar relatórios.</div>
        </div>
        <div style="padding:16px; background:#f8fafc; border-radius:8px;">
            <div style="font-weight:700; margin-bottom:8px;">👨‍💻 Atendente</div>
            <div style="font-size:0.9rem; color:#64748b;">Visualizar e atualizar status de pedidos apenas.</div>
        </div>
    </div>
</div>

@code {
    private async Task NovoUsuario()
    {
        await JS.InvokeVoidAsync("alert", "Modal de novo usuário em desenvolvimento!");
    }

    private async Task EditarUsuario(int id)
    {
        await JS.InvokeVoidAsync("alert", $"Editar usuário #{id}");
    }
}
