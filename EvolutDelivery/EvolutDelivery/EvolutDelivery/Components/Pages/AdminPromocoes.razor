@page "/admin-promocoes"
@rendermode InteractiveServer
@layout AdminLayout
@inject IJSRuntime JS

<PageTitle>Promoções - Admin</PageTitle>

<style>
    .promocoes-list {
        display: grid;
        gap: 20px;
        margin-top: 24px;
    }

    .promocao-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .promocao-info {
        flex: 1;
    }

    .promocao-nome {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: #0f172a;
    }

    .promocao-descricao {
        color: #64748b;
        margin-bottom: 12px;
    }

    .promocao-detalhes {
        display: flex;
        gap: 20px;
        font-size: 0.9rem;
    }

    .detalhe-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .badge-desconto {
        background: #ef4444;
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 1.2rem;
    }

    .badge-ativo {
        background: #d1fae5;
        color: #065f46;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-inativo {
        background: #fee2e2;
        color: #991b1b;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .promocao-acoes {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
</style>

<div class="header-actions" style="display:flex; justify-content:space-between; margin-bottom:24px;">
    <h2>🏷️ Gestão de Promoções</h2>
    <button class="btn-novo" style="background:#ef4444; color:white; border:none; padding:12px 24px; border-radius:8px; font-weight:600; cursor:pointer;"
            @onclick="NovaPromocao">
        + Nova Promoção
    </button>
</div>

<div class="promocoes-list">

    <div class="promocao-card">
        <div class="promocao-info">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                <div class="promocao-nome">🔥 Super Combo Família</div>
                <span class="badge-ativo">✓ Ativa</span>
            </div>
            <div class="promocao-descricao">
                2 Pizzas Grandes + 2 Refrigerantes 2L + 1 Sobremesa
            </div>
            <div class="promocao-detalhes">
                <div class="detalhe-item">
                    <span>📅</span>
                    <span>01/01/2024 até 31/01/2024</span>
                </div>
                <div class="detalhe-item">
                    <span>🎯</span>
                    <span>Aplicada em 156 pedidos</span>
                </div>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:24px;">
            <div class="badge-desconto">30% OFF</div>
            <div class="promocao-acoes">
                <button class="btn-acao btn-editar" style="background:#2563eb; color:white; border:none; padding:8px 16px; border-radius:6px; cursor:pointer; font-weight:600;"
                        @onclick='() => EditarPromocao(1)'>
                    ✏️ Editar
                </button>
                <button class="btn-acao btn-deletar" style="background:#ef4444; color:white; border:none; padding:8px 16px; border-radius:6px; cursor:pointer; font-weight:600;"
                        @onclick='() => DesativarPromocao(1)'>
                    ⏸️ Pausar
                </button>
            </div>
        </div>
    </div>

    <div class="promocao-card">
        <div class="promocao-info">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                <div class="promocao-nome">🍕 Pizza Terça</div>
                <span class="badge-ativo">✓ Ativa</span>
            </div>
            <div class="promocao-descricao">
                Toda terça-feira: 2ª pizza pela metade do preço
            </div>
            <div class="promocao-detalhes">
                <div class="detalhe-item">
                    <span>📅</span>
                    <span>Promoção permanente (terças)</span>
                </div>
                <div class="detalhe-item">
                    <span>🎯</span>
                    <span>Aplicada em 89 pedidos</span>
                </div>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:24px;">
            <div class="badge-desconto">50% OFF</div>
            <div class="promocao-acoes">
                <button class="btn-acao btn-editar" style="background:#2563eb; color:white; border:none; padding:8px 16px; border-radius:6px; cursor:pointer; font-weight:600;"
                        @onclick='() => EditarPromocao(2)'>
                    ✏️ Editar
                </button>
                <button class="btn-acao btn-deletar" style="background:#ef4444; color:white; border:none; padding:8px 16px; border-radius:6px; cursor:pointer; font-weight:600;"
                        @onclick='() => DesativarPromocao(2)'>
                    ⏸️ Pausar
                </button>
            </div>
        </div>
    </div>

    <div class="promocao-card" style="opacity:0.6;">
        <div class="promocao-info">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                <div class="promocao-nome">🎄 Black Friday</div>
                <span class="badge-inativo">❌ Expirada</span>
            </div>
            <div class="promocao-descricao">
                Descontos em todo o cardápio durante a Black Friday
            </div>
            <div class="promocao-detalhes">
                <div class="detalhe-item">
                    <span>📅</span>
                    <span>Encerrada em 26/11/2023</span>
                </div>
                <div class="detalhe-item">
                    <span>🎯</span>
                    <span>Aplicada em 342 pedidos</span>
                </div>
            </div>
        </div>
        <div style="display:flex; align-items:center; gap:24px;">
            <div class="badge-desconto" style="background:#64748b;">40% OFF</div>
            <div class="promocao-acoes">
                <button class="btn-acao" style="background:#64748b; color:white; border:none; padding:8px 16px; border-radius:6px; cursor:pointer; font-weight:600;"
                        @onclick='() => DuplicarPromocao(3)'>
                    📋 Duplicar
                </button>
            </div>
        </div>
    </div>

</div>

@code {
    private async Task NovaPromocao()
    {
        await JS.InvokeVoidAsync("alert", "Modal de nova promoção em desenvolvimento!");
    }

    private async Task EditarPromocao(int id)
    {
        await JS.InvokeVoidAsync("alert", $"Editar promoção #{id}");
    }

    private async Task DesativarPromocao(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Desativar esta promoção?");
        if (confirmado)
        {
            await JS.InvokeVoidAsync("alert", "Promoção desativada!");
        }
    }

    private async Task DuplicarPromocao(int id)
    {
        await JS.InvokeVoidAsync("alert", "Promoção duplicada com sucesso!");
    }
}
