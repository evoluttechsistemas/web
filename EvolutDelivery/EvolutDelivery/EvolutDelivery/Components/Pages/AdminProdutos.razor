@page "/admin-produtos"
@rendermode InteractiveServer
@layout AdminLayout
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@inject ProdutoService ProdutoService
@inject IJSRuntime JS

<PageTitle>Produtos - Admin</PageTitle>

<style>
    .header-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .btn-novo {
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-novo:hover {
            background: #1e40af;
        }

    .filtros {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }

        .filtros input,
        .filtros select {
            padding: 10px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.9rem;
        }

    .produtos-table {
        width: 100%;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .produtos-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .produtos-table thead {
            background: #f8fafc;
        }

        .produtos-table th {
            padding: 16px;
            text-align: left;
            font-weight: 600;
            color: #64748b;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .produtos-table td {
            padding: 16px;
            border-top: 1px solid #f1f5f9;
        }

        .produtos-table tbody tr:hover {
            background: #f8fafc;
        }

    .produto-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
    }

    .preco {
        font-weight: 600;
        color: #16a34a;
    }

    .badge-status {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .badge-status.ativo {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-status.inativo {
            background: #fee2e2;
            color: #991b1b;
        }

    .acoes {
        display: flex;
        gap: 8px;
    }

    .btn-acao {
        padding: 6px 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .btn-editar {
        background: #2563eb;
        color: white;
    }

    .btn-toggle {
        background: #f59e0b;
        color: white;
    }
</style>

<div class="header-actions">
    <h2>🍔 Gestão de Produtos</h2>
    <button class="btn-novo" @onclick="AbrirModalNovo">
        <span>+</span> Novo Produto
    </button>
</div>

<div class="filtros">
    <input type="text" placeholder="🔍 Buscar produto..." @bind="filtro" @bind:after="Filtrar" />
    <select @bind="filtroCategoria" @bind:after="Filtrar">
        <option value="">Todas as Categorias</option>
        <option value="1">Lanches</option>
        <option value="2">Bebidas</option>
        <option value="3">Sobremesas</option>
    </select>
</div>

@if (!produtos.Any())
{
    <div style="background:white; padding:60px; border-radius:12px; text-align:center; color:#64748b;">
        📦 Nenhum produto cadastrado ainda.
    </div>
}
else
{
    <div class="produtos-table">
        <table>
            <thead>
                <tr>
                    <th>Imagem</th>
                    <th>Produto</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in produtosFiltrados)
                {
                    <tr>
                        <td>
                            <img src="@(produto.ImagemBase64 ?? "/imagens/sem-imagem.png")" 
                                 class="produto-img" alt="@produto.Nome" />
                        </td>
                        <td><strong>@produto.Nome</strong></td>
                        <td>Categoria</td>
                        <td class="preco">R$ @produto.PrecoVenda.ToString("F2")</td>
                        <td>Em estoque</td>
                        <td>
                            <span class="badge-status ativo">Ativo</span>
                        </td>
                        <td>
                            <div class="acoes">
                                <button class="btn-acao btn-editar" @onclick="() => EditarProduto(produto.Codigo)">
                                    ✏️ Editar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Produto> produtos = new();
    private List<Produto> produtosFiltrados = new();
    private string filtro = "";
    private string filtroCategoria = "";

    protected override void OnInitialized()
    {
        try
        {
            produtos = ProdutoService.BuscarProdutos("%", "39.397.657/0001-70");
            produtosFiltrados = produtos;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar produtos: {ex.Message}");
        }
    }

    private void Filtrar()
    {
        produtosFiltrados = produtos
            .Where(p => string.IsNullOrEmpty(filtro) || 
                       p.Nome.Contains(filtro, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task AbrirModalNovo()
    {
        await JS.InvokeVoidAsync("alert", "Modal de novo produto em desenvolvimento!");
    }

    private async Task EditarProduto(int codigo)
    {
        await JS.InvokeVoidAsync("alert", $"Editar produto #{codigo} - Em desenvolvimento!");
    }
}

