@page "/admin-entregadores"
@rendermode InteractiveServer
@layout AdminLayout
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@inject EntregadorService EntregadorService
@inject IJSRuntime JS

<PageTitle>Entregadores - Admin</PageTitle>

<style>
    .header-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .btn-novo {
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .entregadores-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .entregador-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .entregador-card .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .entregador-card h3 {
            margin: 0;
            font-size: 1.1rem;
        }

    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .status-badge.disponivel {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.ocupado {
            background: #fef3c7;
            color: #92400e;
        }

        .status-badge.inativo {
            background: #fee2e2;
            color: #991b1b;
        }

    .info-item {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 0.9rem;
        color: #64748b;
    }

    .stats {
        display: flex;
        gap: 20px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }

    .stat {
        text-align: center;
    }

        .stat .value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0f172a;
        }

        .stat .label {
            font-size: 0.75rem;
            color: #64748b;
        }
</style>

<div class="header-actions">
    <h2>🚚 Entregadores</h2>
    <button class="btn-novo" @onclick="AbrirModalNovo">
        + Novo Entregador
    </button>
</div>

@if (carregando)
{
    <div style="text-align:center; padding:60px;">
        <p style="font-size:1.2rem;">⏳ Carregando entregadores...</p>
    </div>
}
else if (!string.IsNullOrEmpty(mensagemErro))
{
    <div style="background:#fee2e2; color:#991b1b; padding:20px; border-radius:8px; margin-bottom:20px;">
        <strong>⚠️ Erro:</strong> @mensagemErro
    </div>
}
else if (!entregadores.Any())
{
    <div style="text-align:center; padding:60px; color:#64748b;">
        Nenhum entregador cadastrado ainda.
    </div>
}
else
{
    <div class="entregadores-grid">
        @foreach (var entregador in entregadores)
        {
            <div class="entregador-card">
                <div class="header">
                    <h3>@entregador.Nome</h3>
                    <span class="status-badge @(entregador.PodeReceber ? "disponivel" : entregador.Ativo ? "ocupado" : "inativo")">
                        @entregador.StatusFormatado
                    </span>
                </div>

                <div class="info-item">
                    <span>📞</span>
                    <span>@entregador.Telefone</span>
                </div>

                <div class="info-item">
                    <span>@entregador.VeiculoFormatado</span>
                    @if (!string.IsNullOrEmpty(entregador.PlacaVeiculo))
                    {
                        <span>- @entregador.PlacaVeiculo</span>
                    }
                </div>

                <div class="stats">
                    <div class="stat">
                        <div class="value">@entregador.TotalEntregas</div>
                        <div class="label">Entregas</div>
                    </div>
                    <div class="stat">
                        <div class="value">@entregador.AvaliacaoMedia.ToString("F1")</div>
                        <div class="label">⭐ Avaliação</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Entregador> entregadores = new();
    private string? mensagemErro;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            entregadores = await EntregadorService.ListarTodosAsync(1, false);
            carregando = false;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao carregar entregadores: {ex.Message}";
            carregando = false;
            Console.WriteLine($"ERRO DETALHADO: {ex}");
            Console.WriteLine($"STACK TRACE: {ex.StackTrace}");
        }
    }

    private async Task AbrirModalNovo()
    {
        await JS.InvokeVoidAsync("alert", "Modal de cadastro em desenvolvimento!");
    }
}