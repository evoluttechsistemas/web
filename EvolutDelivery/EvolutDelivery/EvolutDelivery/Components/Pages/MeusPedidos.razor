@page "/delivery/{slug}/meus-pedidos"
@page "/delivery/{slug}/meus-pedidos/{Telefone}"
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@using System.Globalization
@inject PedidoService PedidoService
@inject ClienteService ClienteService
@inject EmpresaService EmpresaService
@inject NavigationManager Nav

<PageTitle>Meus Pedidos</PageTitle>

<style>
    .meus-pedidos-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .busca-pedidos {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .busca-pedidos h2 {
            margin-top: 0;
        }

        .busca-pedidos p {
            color: #64748b;
            margin-bottom: 14px;
        }

        .busca-pedidos input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
        }

    .btn-buscar,
    .btn-voltar-loja {
        width: 100%;
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 12px;
    }

        .btn-buscar:hover,
        .btn-voltar-loja:hover {
            background: #1e40af;
        }

    .btn-voltar-loja {
        width: auto;
        padding: 12px 18px;
    }

    .pedido-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .pedido-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

        .pedido-header h3 {
            margin: 0;
        }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: bold;
        color: white;
        white-space: nowrap;
    }

        .status-badge.PENDENTE {
            background: #f59e0b;
        }

        .status-badge.APROVADO,
        .status-badge.CONFIRMADO,
        .status-badge.SEPARACAO,
        .status-badge.PREPARANDO {
            background: #2563eb;
        }

        .status-badge.PENDENTE_FINALIZACAO,
        .status-badge.SAIU_ENTREGA {
            background: #7c3aed;
        }

        .status-badge.FINALIZADO,
        .status-badge.ENTREGUE {
            background: #16a34a;
        }

        .status-badge.REPROVADO,
        .status-badge.CANCELADO {
            background: #ef4444;
        }

    .pedido-info {
        display: grid;
        gap: 12px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 12px;
    }

        .pedido-info .linha {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            font-size: 0.9rem;
        }

            .pedido-info .linha strong {
                color: #64748b;
            }

            .pedido-info .linha span:last-child {
                text-align: right;
            }

    .pedido-itens {
        margin-top: 12px;
    }

        .pedido-itens h4 {
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 8px;
        }

        .pedido-itens .item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 8px;
            background: #f8f9fa;
            border-radius: 6px;
            margin-bottom: 6px;
        }

            .pedido-itens .item strong {
                white-space: nowrap;
            }

    .btn-rastrear {
        background: #7c3aed;
        color: white;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-rastrear:hover {
            background: #6d28d9;
        }

    .alerta {
        background: white;
        padding: 24px;
        border-radius: 12px;
        text-align: center;
        color: #64748b;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
</style>

<div class="meus-pedidos-page">
    @if (!string.IsNullOrWhiteSpace(mensagemErro))
    {
        <div class="alerta">
            <strong>@mensagemErro</strong>
            <br />
            <button class="btn-voltar-loja" @onclick="VoltarParaLoja">Voltar para a loja</button>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(Telefone))
    {
        <div class="busca-pedidos">
            <h2>Consultar Meus Pedidos</h2>
            <p>Digite seu telefone para visualizar seus pedidos nesta loja.</p>

            <input type="tel"
                   placeholder="(00) 00000-0000"
                   @bind="telefoneBusca" />

            <button class="btn-buscar" @onclick="BuscarPedidos">
                Buscar Pedidos
            </button>
        </div>
    }
    else
    {
        <div class="busca-pedidos">
            <h2>Meus Pedidos</h2>
            <p>Loja: <strong>@NomeEmpresa</strong></p>
            <p>Telefone: <strong>@Telefone</strong></p>
        </div>

        @if (carregando)
        {
            <div class="alerta">
                Carregando pedidos...
            </div>
        }
        else if (!pedidos.Any())
        {
            <div class="alerta">
                Nenhum pedido encontrado para este telefone nesta loja.
            </div>
        }
        else
        {
            @foreach (var pedido in pedidos)
            {
                <div class="pedido-card">
                    <div class="pedido-header">
                        <h3>Pedido #@pedido.Codigo</h3>
                        <span class="status-badge @ClasseStatus(pedido.Status)">
                            @DescricaoStatus(pedido.Status)
                        </span>
                    </div>

                    <div class="pedido-info">
                        <div class="linha">
                            <strong>Data:</strong>
                            <span>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="linha">
                            <strong>Valor Total:</strong>
                            <span>@pedido.ValorTotal.ToString("C", new CultureInfo("pt-BR"))</span>
                        </div>

                        <div class="linha">
                            <strong>Pagamento:</strong>
                            <span>@pedido.FormaPagamento</span>
                        </div>

                        @if (pedido.TipoEntrega == "ENTREGA")
                        {
                            <div class="linha">
                                <strong>Endereço:</strong>
                                <span>@pedido.EnderecoCompleto</span>
                            </div>
                        }
                    </div>

                    @if (pedido.Itens.Any())
                    {
                        <div class="pedido-itens">
                            <h4>Itens do Pedido:</h4>
                            @foreach (var item in pedido.Itens)
                            {
                                <div class="item">
                                    <span>@FormatarQuantidade(item.Quantidade) x @item.NomeProduto</span>
                                    <strong>@item.PrecoTotal.ToString("C", new CultureInfo("pt-BR"))</strong>
                                </div>
                            }
                        </div>
                    }

                    @if (StatusNormalizado(pedido.Status) == "SAIU_ENTREGA")
                    {
                        <button class="btn-rastrear"
                                @onclick="() => RastrearPedido(pedido.Codigo)">
                            Rastrear Entrega
                        </button>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter]
    public string slug { get; set; } = string.Empty;

    [Parameter]
    public string? Telefone { get; set; }

    private string telefoneBusca = "";
    private string mensagemErro = "";
    private List<Pedido> pedidos = new();
    private bool carregando = false;
    private EmpresaModel? empresaAtual;

    private int CodEmp => empresaAtual?.Codigo ?? 0;
    private string CnpjEmpresa => empresaAtual?.CNPJ ?? "";
    private string NomeEmpresa => empresaAtual?.Fantasia ?? "";

    protected override async Task OnParametersSetAsync()
    {
        mensagemErro = "";
        pedidos.Clear();

        await CarregarEmpresa();

        if (!string.IsNullOrWhiteSpace(Telefone) && string.IsNullOrWhiteSpace(mensagemErro))
        {
            telefoneBusca = Telefone;
            await CarregarPedidos();
        }
    }

    private async Task CarregarEmpresa()
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            mensagemErro = "Loja não informada.";
            return;
        }

        empresaAtual = await EmpresaService.BuscarPorSlugAsync(slug);

        if (empresaAtual == null || empresaAtual.Codigo <= 0 || string.IsNullOrWhiteSpace(empresaAtual.CNPJ))
        {
            mensagemErro = "Empresa não encontrada.";
        }
    }

    private void BuscarPedidos()
    {
        if (string.IsNullOrWhiteSpace(telefoneBusca))
            return;

        string telefoneUrl = Uri.EscapeDataString(NormalizarTelefone(telefoneBusca));
        Nav.NavigateTo($"/EvolutDelivery/delivery/{slug}/meus-pedidos/{telefoneUrl}");
    }

    private async Task CarregarPedidos()
    {
        carregando = true;

        try
        {
            var cliente = await ClienteService.BuscarPorTelefoneAsync(Telefone, CodEmp, CnpjEmpresa);

            if (cliente == null)
            {
                pedidos.Clear();
                return;
            }

            pedidos = await PedidoService.ListarPedidosPorTelefoneAsync(CodEmp, CnpjEmpresa, Telefone ?? "");
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao carregar pedidos: " + ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }

    private string NormalizarTelefone(string? telefone)
    {
        return new string((telefone ?? "").Where(char.IsDigit).ToArray());
    }

    private string FormatarQuantidade(decimal quantidade)
    {
        return quantidade == Math.Truncate(quantidade)
            ? quantidade.ToString("0", new CultureInfo("pt-BR"))
            : quantidade.ToString("0.###", new CultureInfo("pt-BR"));
    }

    private string ClasseStatus(string? status)
    {
        return StatusNormalizado(status);
    }

    private string DescricaoStatus(string? status)
    {
        switch (StatusNormalizado(status))
        {
            case "PENDENTE":
                return "Aguardando aprovação";
            case "APROVADO":
                return "Pedido aprovado";
            case "SEPARACAO":
                return "Em separação";
            case "PENDENTE_FINALIZACAO":
                return "Aguardando finalização";
            case "FINALIZADO":
                return "Pedido finalizado";
            case "REPROVADO":
                return "Pedido reprovado";
            case "PREPARANDO":
                return "Preparando pedido";
            case "SAIU_ENTREGA":
                return "Saiu para entrega";
            case "ENTREGUE":
                return "Entregue";
            case "CANCELADO":
                return "Cancelado";
            default:
                return string.IsNullOrWhiteSpace(status) ? "Status não informado" : status;
        }
    }

    private string StatusNormalizado(string? status)
    {
        string valor = (status ?? "").Trim().ToUpperInvariant();

        switch (valor)
        {
            case "P":
                return "PENDENTE";
            case "A":
            case "CONFIRMADO":
                return "APROVADO";
            case "S":
                return "SEPARACAO";
            case "F":
                return "PENDENTE_FINALIZACAO";
            case "I":
            case "ENTREGUE":
                return "FINALIZADO";
            case "R":
            case "REP":
            case "CANCELADO":
                return "REPROVADO";
            default:
                return valor;
        }
    }

    private void VoltarParaLoja()
    {
        Nav.NavigateTo($"/EvolutDelivery/delivery/{slug}");
    }

    private void RastrearPedido(int codigo)
    {
        Nav.NavigateTo($"/EvolutDelivery/delivery/{slug}/rastreamento/{codigo}");
    }
}
