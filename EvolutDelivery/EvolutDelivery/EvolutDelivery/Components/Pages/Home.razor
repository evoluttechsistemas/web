                   @bind="telefonePedidos"
                   @bind:event="oninput"
                   @onkeydown="TelefonePedidosKeyDown" />

            @if (!string.IsNullOrWhiteSpace(erroTelefonePedidos))
            {
                <div class="hm-orders-error">@erroTelefonePedidos</div>
            }

            <div class="hm-orders-actions">
                <button class="hm-orders-secondary" @onclick="FecharMeusPedidos">Cancelar</button>
                <button class="hm-orders-primary" @onclick="BuscarMeusPedidos">Buscar</button>
            </div>
        </div>
    </div>
}

<!-- TOAST -->
@if (mostrarToast)
{
    <div class="hm-toast">✓ @mensagemToast</div>
}

@code {
    // Imagem servida por HTTP (endpoint /img/{slug}/{codigo} no Program.cs), com cache do navegador
    private string ImagemUrl(int codigo) => $"img/{Uri.EscapeDataString(slug ?? "")}/{codigo}";
    private string _slugCarregado = "";
    [Parameter] public string slug { get; set; } = string.Empty;

    private string cnpj = "";
    private string nomeEmpresa = "EvolutDelivery";
    private string secaoAtualNome = "Todos os produtos";
    private int secaoSelecionadaCodigo = 0;

    private List<Produto> produtos = new();
    private List<Produto> produtosFiltrados = new();
    private List<ItemCarrinho> carrinho = new();
    private List<SecaoModel> secoes = new();

    private string filtro = "";
    private bool mostrandoPromocoes = false;
    private bool carregando = true;
    private int totalPromocoes = 0;

    private bool mostrarModal = false;

    // ===== LOJA ABERTA / FECHADA (painel admin) =====
    private int codEmpLoja = 0;
    private bool lojaFechada = false;
    private string mensagemLojaFechada = "";

    private async Task AtualizarStatusLojaAsync()
    {
        try
        {
            var status = await lojaStatusService.ObterAsync(codEmpLoja);
            lojaFechada = status.Fechada;
            mensagemLojaFechada = status.Mensagem;
        }
        catch (Exception ex)
        {
            // Se não der para consultar, mantém o último status conhecido
            Logger.LogWarning(ex, "Não foi possível consultar o status da loja {CodEmp}", codEmpLoja);
        }
    }

    // ===== ESTOQUE (ProdutoAFV.EstoqueAtual) =====
    // O cliente não vê a quantidade o tempo todo: só é avisado quando o produto
    // está sem estoque ou quando pede mais do que existe.
    private decimal? estoqueModal;          // estoque vendável do produto aberto (null = sem controle)
    private bool verificandoEstoque = false;

    private decimal QuantidadeNoCarrinho(int codigo) =>
        carrinho.Where(i => i.Codigo == codigo).Sum(i => i.Quantidade);

    // Quanto ainda pode ser adicionado (estoque - o que já está no carrinho)
    private decimal? DisponivelParaAdicionar =>
        estoqueModal == null || produtoSelecionado == null
            ? null
            : Math.Max(0, estoqueModal.Value - QuantidadeNoCarrinho(produtoSelecionado.Codigo));

    private bool ProdutoIndisponivel => estoqueModal != null && estoqueModal <= 0;

    private bool ExcedeEstoque => DisponivelParaAdicionar != null && quantidadeSelecionada > DisponivelParaAdicionar;

    private string MensagemLimiteEstoque
    {
        get
        {
            if (estoqueModal == null || produtoSelecionado == null) return "";

            var total = CarrinhoService.FormatarQuantidade(estoqueModal.Value);
            var noCarrinho = QuantidadeNoCarrinho(produtoSelecionado.Codigo);

            if (noCarrinho <= 0)
                return $"Este produto tem apenas {total} em estoque.";

            var podeAdicionar = DisponivelParaAdicionar ?? 0;
            return podeAdicionar > 0
                ? $"Este produto tem apenas {total} em estoque e você já tem {CarrinhoService.FormatarQuantidade(noCarrinho)} no carrinho. Você pode adicionar mais {CarrinhoService.FormatarQuantidade(podeAdicionar)}."
                : $"Este produto tem apenas {total} em estoque e todos já estão no seu carrinho.";
        }
    }

    private async Task AtualizarEstoqueModalAsync()
    {
        if (produtoSelecionado == null) return;

        try
        {
            var estoque = await produtoService.BuscarEstoqueAsync(produtoSelecionado.Codigo, cnpj);
            produtoSelecionado.EstoqueAtual = estoque;
            estoqueModal = CarrinhoService.EstoqueVendavel(estoque, produtoSelecionado.PermiteDecimal);
        }
        catch (Exception ex)
        {
            // Se a consulta falhar, fica com o estoque carregado junto com a vitrine
            Logger.LogWarning(ex, "Não foi possível atualizar o estoque do produto {Codigo}", produtoSelecionado.Codigo);
        }
    }
    private bool mostrarSeletorSecoes = false;
    private Produto? produtoSelecionado;
    private decimal quantidadeSelecionada = 1;
    private string quantidadeDigitada = "1";
    private int quantidadeInputVersao = 0;
    private string observacaoSelecionada = "";

    private bool mostrarToast = false;
    private string mensagemToast = "";
    private bool mostrarModalPedidos = false;
    private string telefonePedidos = "";
    private string erroTelefonePedidos = "";

    private decimal TotalItensCarrinho => carrinho.Sum(i => i.Quantidade);
    // O carrinho salvo no navegador não tem preço: o total usa o preço atual dos produtos carregados
    private Dictionary<int, decimal> precoPorCodigo = new();
    private decimal TotalCarrinho => carrinho.Sum(i => (precoPorCodigo.TryGetValue(i.Codigo, out var preco) ? preco : 0) * i.Quantidade);

    protected override async Task OnParametersSetAsync()
    {
        if (slug == _slugCarregado) return;
        _slugCarregado = slug;

        carregando = true;

        try
        {
            if (string.IsNullOrWhiteSpace(slug))
            {
                nomeEmpresa = "Empresa não encontrada";
                carregando = false;
                return;
            }

            var empresa = await empresaService.BuscarPorSlugAsync(slug);

            if (empresa == null)
            {
                nomeEmpresa = "Empresa não encontrada";
                carregando = false;
                return;
            }

            cnpj = empresa.CNPJ;
            nomeEmpresa = empresa.Fantasia;
            codEmpLoja = empresa.Codigo;

            await AtualizarStatusLojaAsync();

            secoes = await Task.Run(() => produtoService.BuscarSecoes(cnpj));
            produtos = await Task.Run(() => produtoService.BuscarProdutos("", cnpj));

            precoPorCodigo = produtos
                .GroupBy(p => p.Codigo)
                .ToDictionary(g => g.Key, g => CarrinhoService.PrecoAtual(g.First()));

            totalPromocoes = produtos.Count(p => p.PrecoPromocao > 0 && p.PrecoPromocao < p.PrecoVenda);
            produtosFiltrados = produtos;

            carregando = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao carregar a loja {Slug}", slug);
            nomeEmpresa = "Erro ao carregar";
            carregando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            carrinho = await storage.ObterCarrinhoAsync(slug);
            if (carrinho.Any())
                StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível ler o carrinho do navegador");
        }
    }

