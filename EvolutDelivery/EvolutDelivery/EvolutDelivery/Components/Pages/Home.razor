@page "/"
@page "/delivery/{slug}"
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inject ProdutoService produtoService
@inject NavigationManager NavManager
@inject StorageService storage
@inject EmpresaService empresaService
@inject LojaStatusService lojaStatusService
@inject ILogger<Home> Logger

<PageTitle>@nomeEmpresa — Cardápio</PageTitle>

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --primary: #2563eb;
        --primary-dark: #1e40af;
        --primary-light: #eff6ff;
        --green: #16a34a;
        --green-light: #dcfce7;
        --red: #dc2626;
        --red-light: #fef2f2;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --bg: #f1f5f9;
        --white: #ffffff;
        --radius-sm: 10px;
        --radius: 14px;
        --radius-lg: 22px;
        --shadow-sm: 0 1px 2px rgba(15,23,42,.05), 0 1px 3px rgba(15,23,42,.06);
        --shadow: 0 2px 8px rgba(15,23,42,.08);
        --shadow-md: 0 6px 20px rgba(15,23,42,.12);
        --wrap: 1080px;
    }

    html, body {
        background: var(--bg);
        font-family: 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
        color: var(--text);
        min-height: 100vh;
        -webkit-tap-highlight-color: transparent;
        -webkit-text-size-adjust: 100%;
    }

    button {
        font-family: inherit;
    }

    /* ===== HEADER ===== */
    .hm-header {
        background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
        padding: calc(14px + env(safe-area-inset-top)) 16px 40px;
        position: relative;
        overflow: hidden;
    }

    .hm-header-inner {
        max-width: var(--wrap);
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .hm-header::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 22px;
        background: var(--bg);
        border-radius: 22px 22px 0 0;
    }

    .hm-header-deco {
        position: absolute;
        top: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,.07);
        pointer-events: none;
    }

    .hm-header-deco2 {
        position: absolute;
        bottom: 0;
        left: -40px;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
        pointer-events: none;
    }

    .hm-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 12px;
    }

    .hm-header-top > div:first-child {
        min-width: 0;
    }

    .hm-logo-text {
        font-size: 1.15rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.3px;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .hm-logo-sub {
        font-size: 0.72rem;
        color: rgba(255,255,255,.75);
        font-weight: 500;
        margin-top: 2px;
    }

    .hm-btn-admin {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        color: #fff;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
    }

    .hm-btn-orders {
        flex-shrink: 0;
        background: rgba(255,255,255,.95);
        border: none;
        color: var(--primary-dark);
        border-radius: 20px;
        padding: 9px 14px;
        font-size: 0.8rem;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: var(--shadow-sm);
    }

    .hm-search {
        position: relative;
    }

        /* 16px evita o zoom automatico do iPhone ao focar o campo */
        .hm-search input {
            width: 100%;
            height: 48px;
            padding: 0 46px 0 18px;
            border-radius: 30px;
            border: none;
            font-size: 16px;
            color: var(--text);
            background: var(--white);
            box-shadow: var(--shadow-md);
            outline: none;
            -webkit-appearance: none;
            appearance: none;
        }

            .hm-search input::placeholder {
                color: var(--muted);
            }

    .hm-search-icon {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.05rem;
        pointer-events: none;
    }

    /* ===== CONTEUDO ===== */
    .hm-wrap {
        max-width: var(--wrap);
        margin: 0 auto;
        padding-bottom: calc(110px + env(safe-area-inset-bottom));
    }

    /* Categorias fixas no topo ao rolar */
    .hm-secoes {
        position: sticky;
        top: 0;
        z-index: 60;
        display: flex;
        overflow-x: auto;
        gap: 8px;
        padding: 10px 16px;
        background: rgba(241,245,249,.94);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x proximity;
    }

        .hm-secoes::-webkit-scrollbar {
            display: none;
        }

    .hm-secao-btn {
        flex-shrink: 0;
        height: 38px;
        padding: 0 16px;
        border-radius: 30px;
        border: 1.5px solid var(--border);
        background: var(--white);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        white-space: nowrap;
        scroll-snap-align: start;
        transition: background .15s, color .15s, border-color .15s;
    }

        .hm-secao-btn.ativo {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: 0 2px 8px rgba(37,99,235,.25);
        }

    .hm-section-label {
        padding: 8px 16px 12px;
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .5px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

        .hm-section-label span {
            background: var(--primary-light);
            color: var(--primary);
            border-radius: 20px;
            padding: 2px 9px;
            font-size: 0.72rem;
            text-transform: none;
            letter-spacing: 0;
            font-weight: 700;
        }

    /* ===== LOJA FECHADA ===== */
    .hm-fechada {
        margin: 4px 16px 14px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: var(--radius);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #991b1b;
    }

    .hm-fechada-icone {
        font-size: 1.6rem;
        flex-shrink: 0;
    }

    .hm-fechada-titulo {
        font-size: 0.95rem;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .hm-fechada-texto {
        font-size: 0.82rem;
        line-height: 1.4;
        color: #b91c1c;
        overflow-wrap: anywhere;
    }

    /* ===== BANNER PROMO ===== */
    .hm-promo-banner {
        margin: 4px 16px 14px;
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        border-radius: var(--radius);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(124,58,237,.25);
    }

    .hm-promo-icon {
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    .hm-promo-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 2px;
    }

    .hm-promo-sub {
        font-size: 0.78rem;
        color: rgba(255,255,255,.85);
    }

    .hm-promo-arrow {
        margin-left: auto;
        color: rgba(255,255,255,.8);
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    /* ===== GRADE DE PRODUTOS ===== */
    /* Celular: 2 colunas | Tablet: 3 | Desktop: 4-5 */
    .hm-grid,
    .hm-skeleton-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        padding: 0 12px;
    }

    /* ===== CARD ===== */
    .hm-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        border: 1px solid var(--border);
        transition: transform .18s, box-shadow .18s;
    }

        .hm-card:active {
            transform: scale(.98);
        }

    /* Imagem quadrada e INTEIRA (contain): nao corta embalagens */
    /* O quadro tem altura FIXA (quadrado): a foto se ajusta dentro dele, nunca o contrário */
    .hm-card-img-wrap {
        position: relative;
        width: 100%;
        height: 0;
        padding-top: 100%;
        background: #fff;
        overflow: hidden;
        border-bottom: 1px solid #f1f5f9;
    }

    .hm-card-img {
        position: absolute;
        top: 10px;
        left: 10px;
        width: calc(100% - 20px);
        height: calc(100% - 20px);
        object-fit: contain;
    }

    .hm-promo-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: var(--red);
        color: #fff;
        font-size: 0.64rem;
        font-weight: 800;
        padding: 3px 7px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .hm-card-body {
        flex: 1;
        padding: 10px 11px 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* Nome COMPLETO, sem cortar com reticencias */
    .hm-card-nome {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        line-height: 1.32;
        overflow-wrap: anywhere;
        hyphens: auto;
    }

    .hm-card-precos {
        margin-top: auto;
        display: flex;
        flex-direction: column;
    }

    .hm-card-preco-antigo {
        font-size: 0.74rem;
        color: var(--muted);
        text-decoration: line-through;
    }

    .hm-card-preco {
        font-size: 1.02rem;
        font-weight: 800;
        color: var(--primary-dark);
    }

        .hm-card-preco.promo {
            color: var(--red);
        }

    .hm-card-add {
        margin: 10px 11px 11px;
        height: 40px;
        border: none;
        border-radius: var(--radius-sm);
        background: var(--primary-light);
        color: var(--primary);
        font-size: 0.86rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: background .12s, color .12s;
    }

        .hm-card-add:active {
            background: var(--primary);
            color: #fff;
        }

    /* ===== VAZIO ===== */
    .hm-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 60px 30px;
        text-align: center;
        color: var(--muted);
        gap: 8px;
    }

    .hm-empty-icon {
        font-size: 3rem;
        margin-bottom: 8px;
    }

    .hm-empty-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
    }

    .hm-empty-sub {
        font-size: 0.85rem;
        line-height: 1.6;
    }

    /* ===== BARRA CARRINHO ===== */
    .hm-cart-bar {
        position: fixed;
        bottom: calc(12px + env(safe-area-inset-bottom));
        left: 12px;
        right: 12px;
        max-width: 560px;
        margin: 0 auto;
        background: var(--primary-dark);
        border-radius: var(--radius-lg);
        padding: 12px 12px 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        box-shadow: 0 8px 30px rgba(30,64,175,.35);
        z-index: 90;
        animation: cartSlideUp .25s ease;
    }

    @@keyframes cartSlideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .hm-cart-info {
        color: #fff;
        min-width: 0;
    }

    .hm-cart-qty {
        font-size: 0.74rem;
        color: rgba(255,255,255,.75);
        margin-bottom: 1px;
    }

    .hm-cart-val {
        font-size: 1.08rem;
        font-weight: 800;
        color: #fff;
    }

    .hm-cart-btn {
        flex-shrink: 0;
        height: 44px;
        background: #fff;
        color: var(--primary-dark);
        border: none;
        border-radius: var(--radius);
        padding: 0 18px;
        font-size: 0.9rem;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }

    /* ===== OVERLAY / MODAIS ===== */
    .hm-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.55);
        z-index: 200;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        -webkit-backdrop-filter: blur(2px);
        backdrop-filter: blur(2px);
        animation: fadeIn .18s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes modalUp {
        from {
            transform: translateY(100%);
        }

        to {
            transform: translateY(0);
        }
    }

    /* MODAL PRODUTO (bottom sheet no celular) */
    .hm-modal {
        background: var(--white);
        width: 100%;
        max-width: 520px;
        max-height: 92vh;
        max-height: 92dvh;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        display: flex;
        flex-direction: column;
        animation: modalUp .24s ease;
        overflow: hidden;
    }

    .hm-modal-handle {
        position: absolute;
        top: 8px;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 4px;
        border-radius: 4px;
        background: #cbd5e1;
        z-index: 2;
    }

    /* Imagem inteira, sem corte */
    .hm-modal-img-wrap {
        position: relative;
        flex-shrink: 0;
        width: 100%;
        height: min(40vh, 300px);
        background: #fff;
        overflow: hidden;
        border-bottom: 1px solid #f1f5f9;
    }

    .hm-modal-img {
        position: absolute;
        top: 22px;
        left: 20px;
        width: calc(100% - 40px);
        height: calc(100% - 30px);
        object-fit: contain;
    }

    .hm-modal-close {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(15,23,42,.08);
        border: none;
        color: var(--text);
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
    }

    .hm-modal-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        padding: 18px 20px 0;
    }

    .hm-modal-nome {
        font-size: 1.08rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1.3;
        margin-bottom: 6px;
        overflow-wrap: anywhere;
    }

    .hm-modal-preco {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--primary-dark);
        margin-bottom: 16px;
    }

        .hm-modal-preco.promo {
            color: var(--red);
        }

    .hm-modal-obs-label {
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 6px;
    }

    .hm-modal-obs {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 16px;
        font-family: inherit;
        color: var(--text);
        resize: none;
        outline: none;
        transition: border-color .15s;
        margin-bottom: 4px;
    }

        .hm-modal-obs:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    /* Rodape fixo no fim do modal: quantidade + adicionar sempre visiveis */
    .hm-modal-footer {
        position: sticky;
        bottom: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--white);
        margin: 0 -20px;
        padding: 12px 20px calc(14px + env(safe-area-inset-bottom));
        border-top: 1px solid var(--border);
        margin-top: 12px;
    }

    /* Avisos de estoque no modal */
    .hm-estoque-aviso {
        border-radius: var(--radius-sm);
        padding: 11px 14px;
        font-size: 0.86rem;
        font-weight: 600;
        line-height: 1.4;
        margin-top: 12px;
    }

        .hm-estoque-aviso.indisponivel {
            background: var(--red-light);
            color: var(--red);
            border: 1px solid #fecaca;
        }

        .hm-estoque-aviso.limite {
            background: #fffbeb;
            color: #b45309;
            border: 1px solid #fde68a;
        }

    .hm-btn-add-confirm:disabled {
        background: #cbd5e1;
        cursor: not-allowed;
        transform: none;
    }

    .hm-qty-ctrl {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
        flex-shrink: 0;
    }

    .hm-qty-btn {
        width: 42px;
        height: 48px;
        border: none;
        background: var(--white);
        color: var(--primary);
        font-size: 1.3rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .hm-qty-btn:active {
            background: var(--primary-light);
        }

        .hm-qty-btn:disabled {
            color: var(--border);
            cursor: default;
        }

    .hm-qty-num {
        width: 58px;
        min-width: 58px;
        text-align: center;
        font-size: 16px;
        font-weight: 800;
        color: var(--text);
        border-left: 1.5px solid var(--border);
        border-right: 1.5px solid var(--border);
        border-top: none;
        border-bottom: none;
        height: 48px;
        outline: none;
        border-radius: 0;
        -webkit-appearance: none;
        appearance: none;
    }

    .hm-btn-add-confirm {
        flex: 1;
        min-width: 0;
        height: 48px;
        padding: 0 12px;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: background .12s, transform .1s;
    }

        .hm-btn-add-confirm:active {
            transform: scale(.98);
            background: #15803d;
        }

    /* MODAL MEUS PEDIDOS */
    .hm-orders-modal {
        background: var(--white);
        width: 100%;
        max-width: 430px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
        animation: modalUp .22s ease;
        box-shadow: var(--shadow-md);
    }

    .hm-orders-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 6px;
    }

    .hm-orders-sub {
        font-size: 0.84rem;
        color: var(--muted);
        line-height: 1.4;
        margin-bottom: 16px;
    }

    .hm-orders-input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        outline: none;
        margin-bottom: 10px;
    }

        .hm-orders-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    .hm-orders-error {
        color: var(--red);
        font-size: 0.8rem;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .hm-orders-actions {
        display: flex;
        gap: 10px;
    }

    .hm-orders-secondary,
    .hm-orders-primary {
        height: 48px;
        border-radius: var(--radius-sm);
        border: none;
        font-size: 0.92rem;
        font-weight: 800;
        cursor: pointer;
    }

    .hm-orders-secondary {
        flex: 0 0 112px;
        background: var(--bg);
        color: var(--muted);
        border: 1px solid var(--border);
    }

    .hm-orders-primary {
        flex: 1;
        background: var(--primary);
        color: #fff;
        box-shadow: 0 2px 8px rgba(37,99,235,.25);
    }

    /* MODAL SECOES */
    .hm-secoes-modal {
        background: var(--white);
        width: 100%;
        max-width: 520px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 20px 20px env(safe-area-inset-bottom);
        max-height: 75vh;
        display: flex;
        flex-direction: column;
        animation: modalUp .22s ease;
    }

    .hm-secoes-modal-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
    }

    .hm-secoes-list {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 4px;
        scrollbar-width: none;
    }

        .hm-secoes-list::-webkit-scrollbar {
            display: none;
        }

    .hm-secao-item {
        padding: 14px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .hm-secao-item.ativo {
            background: var(--primary-light);
            color: var(--primary);
        }

            .hm-secao-item.ativo::after {
                content: '✓';
                font-size: 0.9rem;
            }

    /* ===== SKELETON ===== */
    .hm-skeleton-card {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .hm-skeleton-img {
        width: 100%;
        height: 0;
        padding-top: 100%;
        background: linear-gradient(90deg, #f1f5f9 25%, #e8edf3 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite;
    }

    .hm-skeleton-body {
        padding: 11px;
    }

    .hm-skeleton-line {
        height: 12px;
        border-radius: 6px;
        background: linear-gradient(90deg, #f1f5f9 25%, #e8edf3 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite;
        margin-bottom: 8px;
    }

        .hm-skeleton-line.short {
            width: 60%;
        }

    @@keyframes shimmer {
        to {
            background-position: -200% 0;
        }
    }

    /* ===== TOAST ===== */
    .hm-toast {
        position: fixed;
        bottom: calc(92px + env(safe-area-inset-bottom));
        left: 50%;
        transform: translateX(-50%);
        max-width: calc(100vw - 32px);
        background: #1e293b;
        color: #fff;
        padding: 11px 20px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        z-index: 300;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        animation: toastAnim 2.2s ease forwards;
    }

    @@keyframes toastAnim {
        0% {
            opacity: 0;
            transform: translateX(-50%) translateY(12px);
        }

        12% {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        78% {
            opacity: 1;
        }

        100% {
            opacity: 0;
        }
    }

    /* ===== EFEITOS DE HOVER SO EM QUEM TEM MOUSE ===== */
    @@media (hover: hover) {
        .hm-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .hm-card-add:hover {
            background: var(--primary);
            color: #fff;
        }

        .hm-secao-btn:not(.ativo):hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .hm-btn-orders:hover {
            background: #fff;
        }

        .hm-promo-banner:hover {
            box-shadow: 0 6px 20px rgba(124,58,237,.35);
        }

        .hm-cart-btn:hover {
            background: #e0e7ff;
        }

        .hm-secao-item:not(.ativo):hover {
            background: var(--bg);
        }

        .hm-qty-btn:not(:disabled):hover {
            background: var(--primary-light);
        }

        .hm-btn-add-confirm:hover {
            background: #15803d;
        }

        .hm-secoes {
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }

            .hm-secoes::-webkit-scrollbar {
                display: block;
                height: 4px;
            }

            .hm-secoes::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 4px;
            }
    }

    /* ===== CELULAR PEQUENO ===== */
    @@media (max-width: 360px) {
        .hm-grid,
        .hm-skeleton-grid {
            gap: 8px;
            padding: 0 8px;
        }

        .hm-card-body {
            padding: 9px 9px 0;
        }

        .hm-card-add {
            margin: 9px;
        }

        .hm-qty-btn {
            width: 38px;
        }

        .hm-qty-num {
            width: 48px;
            min-width: 48px;
        }

        .hm-btn-add-confirm {
            font-size: 0.88rem;
        }
    }

    /* ===== TABLET ===== */
    @@media (min-width: 600px) {
        .hm-header {
            padding: 20px 24px 48px;
        }

        .hm-secoes,
        .hm-section-label {
            padding-left: 20px;
            padding-right: 20px;
        }

        .hm-promo-banner {
            margin-left: 20px;
            margin-right: 20px;
        }

        .hm-grid,
        .hm-skeleton-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            padding: 0 20px;
        }

        .hm-card-nome {
            font-size: 0.88rem;
        }

        /* Modais centralizados em telas maiores */
        .hm-overlay {
            align-items: center;
            padding: 20px;
        }

        .hm-modal,
        .hm-orders-modal,
        .hm-secoes-modal {
            border-radius: var(--radius-lg);
            max-height: 88vh;
        }

        .hm-modal-handle {
            display: none;
        }

        .hm-modal-footer {
            padding-bottom: 16px;
        }
    }

    /* ===== DESKTOP ===== */
    @@media (min-width: 900px) {
        .hm-grid,
        .hm-skeleton-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
        }
    }

    @@media (min-width: 1080px) {
        .hm-grid,
        .hm-skeleton-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }
</style>

<!-- HEADER -->
<div class="hm-header">
    <div class="hm-header-deco"></div>
    <div class="hm-header-deco2"></div>
    <div class="hm-header-inner">
        <div class="hm-header-top">
            <div>
                <div class="hm-logo-text">@nomeEmpresa</div>
                <div class="hm-logo-sub">Cardápio digital</div>
            </div>
            <button class="hm-btn-orders" @onclick="AbrirMeusPedidos">Meus pedidos</button>
            @* <button class="hm-btn-admin" @onclick="IrParaAdmin">⚙ Admin</button> *@
        </div>
        <div class="hm-search">
            <input type="search"
                   placeholder="Buscar produto..."
                   value="@filtro"
                   @oninput="FiltrarProdutos" />
            <div class="hm-search-icon">🔍</div>
        </div>
    </div>
</div>

<!-- CONTEÚDO -->
<div class="hm-wrap">

    @if (lojaFechada)
    {
        <div class="hm-fechada">
            <div class="hm-fechada-icone">🔒</div>
            <div>
                <div class="hm-fechada-titulo">Loja fechada no momento</div>
                <div class="hm-fechada-texto">@(string.IsNullOrWhiteSpace(mensagemLojaFechada) ? "Não estamos recebendo pedidos agora." : mensagemLojaFechada)</div>
            </div>
        </div>
    }

    <!-- Seções -->
    <div class="hm-secoes">
        <button class="hm-secao-btn @(secaoSelecionadaCodigo == 0 && !mostrandoPromocoes ? "ativo" : "")"
                @onclick='() => SelecionarSecao(0, "Todos")'>
            Todos
        </button>
        @foreach (var s in secoes)
        {
            <button class="hm-secao-btn @(secaoSelecionadaCodigo == s.Codigo && !mostrandoPromocoes ? "ativo" : "")"
                    @onclick='() => SelecionarSecao(s.Codigo, s.Descricao)'>
                @s.Descricao
            </button>
        }
        <button class="hm-secao-btn @(mostrandoPromocoes ? "ativo" : "")"
                style="@(mostrandoPromocoes ? "background:#7c3aed;border-color:#7c3aed;" : "border-color:#a855f7;color:#7c3aed;")"
                @onclick="FiltrarPromocoes">
            🔥 Promoções
        </button>
    </div>

    <!-- Banner promoções -->
    @if (!mostrandoPromocoes && totalPromocoes > 0 && string.IsNullOrEmpty(filtro))
    {
        <div class="hm-promo-banner" @onclick="FiltrarPromocoes">
            <div class="hm-promo-icon">🔥</div>
            <div>
                <div class="hm-promo-title">Promoções do dia</div>
                <div class="hm-promo-sub">@totalPromocoes produto(s) com desconto especial</div>
            </div>
            <div class="hm-promo-arrow">›</div>
        </div>
    }

    <!-- Label seção -->
    <div class="hm-section-label">
        @if (mostrandoPromocoes)
        {
            <span style="background:#f3e8ff;color:#7c3aed;">🔥 Promoções</span>
        }
        else if (!string.IsNullOrEmpty(filtro))
        {
            <span>Resultado: "@filtro"</span>
        }
        else
        {
            <text>@secaoAtualNome</text>
            <span>@produtosFiltrados.Count produto(s)</span>
        }
    </div>

    <!-- Skeleton -->
    @if (carregando)
    {
        <div class="hm-skeleton-grid">
            @for (int i = 0; i < 6; i++)
            {
                <div class="hm-skeleton-card">
                    <div class="hm-skeleton-img"></div>
                    <div class="hm-skeleton-body">
                        <div class="hm-skeleton-line"></div>
                        <div class="hm-skeleton-line short"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!produtosFiltrados.Any())
    {
        <div class="hm-empty">
            <div class="hm-empty-icon">🍽</div>
            <div class="hm-empty-title">Nenhum produto encontrado</div>
            <div class="hm-empty-sub">
                @if (!string.IsNullOrEmpty(filtro))
                {
                    <text>Tente buscar por outro nome.</text>
                }
                else
                {

                    <text>Esta seção ainda não tem produtos cadastrados.</text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="hm-grid">
            @foreach (var p in produtosFiltrados)
            {
                bool temPromo = p.PrecoPromocao > 0 && p.PrecoPromocao < p.PrecoVenda;
                <div class="hm-card" @onclick="() => AbrirModal(p)">
                    <div class="hm-card-img-wrap">
                        <img class="hm-card-img"
                             src="@ImagemUrl(p.Codigo)"
                             onerror="this.onerror=null;this.style.visibility='hidden'"
                             alt="@p.Nome"
                             loading="lazy"
                             decoding="async" />
                        @if (temPromo)
                        {
                            <div class="hm-promo-badge">Oferta</div>
                        }
                    </div>
                    <div class="hm-card-body">
                        <div class="hm-card-nome">@p.Nome</div>
                        <div class="hm-card-precos">
                            @if (temPromo)
                            {
                                <div class="hm-card-preco-antigo">@p.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))</div>
                                <div class="hm-card-preco promo">@p.PrecoPromocao.ToString("C", new CultureInfo("pt-BR"))</div>
                            }
                            else
                            {
                                <div class="hm-card-preco">@p.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))</div>
                            }
                        </div>
                    </div>
                    <button class="hm-card-add" @onclick:stopPropagation @onclick="() => AbrirModal(p)">
                        + Adicionar
                    </button>
                </div>
            }
        </div>
    }
</div>

<!-- BARRA CARRINHO -->
@if (carrinho.Any())
{
    <div class="hm-cart-bar">
        <div class="hm-cart-info">
            <div class="hm-cart-qty">@FormatarQuantidadeCarrinho(TotalItensCarrinho) iten(s) no carrinho</div>
            <div class="hm-cart-val">@TotalCarrinho.ToString("C", new CultureInfo("pt-BR"))</div>
        </div>
        <button class="hm-cart-btn" @onclick="IrParaCarrinho">Ver carrinho →</button>
    </div>
}

<!-- MODAL PRODUTO -->
@if (mostrarModal && produtoSelecionado != null)
{
    bool temPromoModal = produtoSelecionado.PrecoPromocao > 0 && produtoSelecionado.PrecoPromocao < produtoSelecionado.PrecoVenda;
    bool permiteDecimalModal = ProdutoPermiteDecimal(produtoSelecionado);
    decimal precoModal = temPromoModal ? produtoSelecionado.PrecoPromocao : produtoSelecionado.PrecoVenda;
    decimal totalModal = precoModal * quantidadeSelecionada;

    <div class="hm-overlay" @onclick="FecharModal">
        <div class="hm-modal" @onclick:stopPropagation>
            <div class="hm-modal-img-wrap">
                <div class="hm-modal-handle"></div>
                <img class="hm-modal-img"
                     src="@ImagemUrl(produtoSelecionado.Codigo)"
                     onerror="this.onerror=null;this.style.visibility='hidden'"
                     alt="@produtoSelecionado.Nome" />
                <button class="hm-modal-close" @onclick="FecharModal" aria-label="Fechar">✕</button>
            </div>
            <div class="hm-modal-body">
                <div class="hm-modal-nome">@produtoSelecionado.Nome</div>
                @if (temPromoModal)
                {
                    <div style="font-size:.82rem;color:var(--muted);text-decoration:line-through;margin-bottom:2px;">
                        @produtoSelecionado.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))
                    </div>
                }
                <div class="hm-modal-preco @(temPromoModal ? "promo" : "")">
                    @precoModal.ToString("C", new CultureInfo("pt-BR"))
                </div>
                @if (permiteDecimalModal)
                {
                    <div style="font-size:.78rem;color:var(--muted);margin-top:-6px;margin-bottom:12px;">
                        Produto vendido por quantidade fracionada
                    </div>
                }
                <div class="hm-modal-obs-label">Observação</div>
                <textarea class="hm-modal-obs" rows="2"
                          maxlength="200"
                          placeholder="Ex: sem cebola, bem passado..."
                          @bind="observacaoSelecionada"></textarea>

                @if (lojaFechada)
                {
                    <div class="hm-estoque-aviso indisponivel">
                        A loja está fechada no momento e não está recebendo pedidos.
                    </div>
                }
                else if (ProdutoIndisponivel)
                {
                    <div class="hm-estoque-aviso indisponivel">
                        Produto indisponível no estoque no momento.
                    </div>
                }
                else if (ExcedeEstoque)
                {
                    <div class="hm-estoque-aviso limite">@MensagemLimiteEstoque</div>
                }

                @if (lojaFechada)
                {
                    <div class="hm-modal-footer">
                        <button class="hm-btn-add-confirm" disabled>Loja fechada</button>
                    </div>
                }
                else if (ProdutoIndisponivel)
                {
                    <div class="hm-modal-footer">
                        <button class="hm-btn-add-confirm" disabled>Indisponível</button>
                    </div>
                }
                else
                {
                <div class="hm-modal-footer">
                    <div class="hm-qty-ctrl">
                        <button class="hm-qty-btn" @onclick="DiminuirQtd" disabled="@(quantidadeSelecionada <= QuantidadeMinima)">−</button>
                        @if (permiteDecimalModal)
                        {
                            <input class="hm-qty-num"
                                   type="text"
                                   inputmode="decimal"
                                   pattern="[0-9]*[,.]?[0-9]*"
                                   value="@quantidadeDigitada"
                                   @oninput="AlterarQuantidadeDigitada"
                                   @onblur="NormalizarQuantidadeDigitada" />
                        }
                        else
                        {
                            <input class="hm-qty-num"
                                   @key="QuantidadeInputKey"
                                   type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   value="@quantidadeDigitada"
                                   @oninput="AlterarQuantidadeDigitada"
                                   @onblur="NormalizarQuantidadeDigitada" />
                        }
                        <button class="hm-qty-btn" @onclick="AumentarQtd">+</button>
                    </div>
                    <button class="hm-btn-add-confirm" @onclick="ConfirmarAdicionar" disabled="@(ExcedeEstoque || verificandoEstoque)">
                        Adicionar · @totalModal.ToString("C", new CultureInfo("pt-BR"))
                    </button>
                </div>
                }
            </div>
        </div>
    </div>
}

<!-- MODAL SEÇÕES -->
@if (mostrarSeletorSecoes)
{
    <div class="hm-overlay" @onclick="FecharSeletorSecoes">
        <div class="hm-secoes-modal" @onclick:stopPropagation>
            <div class="hm-secoes-modal-title">Categorias</div>
            <div class="hm-secoes-list">
                <div class="hm-secao-item @(secaoSelecionadaCodigo == 0 && !mostrandoPromocoes ? "ativo" : "")"
                     @onclick='() => SelecionarSecaoModal(0, "Todos")'>
                    Todos os produtos
                </div>
                @foreach (var s in secoes)
                {
                    <div class="hm-secao-item @(secaoSelecionadaCodigo == s.Codigo && !mostrandoPromocoes ? "ativo" : "")"
                         @onclick='() => SelecionarSecaoModal(s.Codigo, s.Descricao)'>
                        @s.Descricao
                    </div>
                }
                <div class="hm-secao-item @(mostrandoPromocoes ? "ativo" : "")"
                     style="color:#7c3aed;"
                     @onclick="() => { FiltrarPromocoes(); mostrarSeletorSecoes = false; }">
                    🔥 Promoções
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL MEUS PEDIDOS -->
@if (mostrarModalPedidos)
{
    <div class="hm-overlay" @onclick="FecharMeusPedidos">
        <div class="hm-orders-modal" @onclick:stopPropagation>
            <div class="hm-orders-title">Meus pedidos</div>
            <div class="hm-orders-sub">Informe o telefone usado no pedido para acompanhar o andamento.</div>

            <input class="hm-orders-input"
                   type="tel"
                   inputmode="tel"
                   maxlength="16"
