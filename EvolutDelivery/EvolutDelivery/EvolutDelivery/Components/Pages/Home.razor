    private decimal QuantidadeMinima => ProdutoSelecionadoPermiteDecimal ? 0.001m : 1m;
    private decimal PassoQuantidade => ProdutoSelecionadoPermiteDecimal ? 0.100m : 1m;
    private bool ProdutoSelecionadoPermiteDecimal => produtoSelecionado != null && ProdutoPermiteDecimal(produtoSelecionado);
    private string QuantidadeInputKey => "I-" + quantidadeInputVersao;

    private bool ProdutoPermiteDecimal(Produto produto)
    {
        return string.Equals(produto.PermiteDecimal ?? "N", "S", StringComparison.OrdinalIgnoreCase);
    }

    private void AumentarQtd()
    {
        quantidadeSelecionada += PassoQuantidade;
        NormalizarQuantidadeSelecionada();
    }

    private void DiminuirQtd()
    {
        quantidadeSelecionada -= PassoQuantidade;
        NormalizarQuantidadeSelecionada();
    }

    private void AlterarQuantidadeDigitada(ChangeEventArgs e)
    {
        string textoOriginal = e.Value?.ToString() ?? "";
        string textoLimpo = LimparQuantidadeDigitada(textoOriginal);

        if (textoOriginal != textoLimpo)
        {
            quantidadeInputVersao++;
        }

        quantidadeDigitada = textoLimpo;

        decimal quantidade;
        if (decimal.TryParse(quantidadeDigitada.Replace(".", ","), NumberStyles.Any, new CultureInfo("pt-BR"), out quantidade))
        {
            quantidadeSelecionada = quantidade;
        }

        if (textoOriginal != textoLimpo)
        {
            StateHasChanged();
        }
    }

    private void NormalizarQuantidadeDigitada()
    {
        quantidadeDigitada = LimparQuantidadeDigitada(quantidadeDigitada);

        decimal quantidade;
        if (!decimal.TryParse(quantidadeDigitada.Replace(".", ","), NumberStyles.Any, new CultureInfo("pt-BR"), out quantidade))
        {
            quantidade = QuantidadeMinima;
        }

        quantidadeSelecionada = quantidade;
        NormalizarQuantidadeSelecionada();
    }

    private string LimparQuantidadeDigitada(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return "";
        }

        texto = texto.Trim();

        if (!ProdutoSelecionadoPermiteDecimal)
        {
            var inteiro = new System.Text.StringBuilder();

            foreach (char c in texto)
            {
                if (c == ',' || c == '.')
                {
                    break;
                }

                if (char.IsDigit(c))
                {
                    inteiro.Append(c);
                }
            }

            return inteiro.ToString();
        }

        texto = texto.Replace(".", ",");

        var limpo = new System.Text.StringBuilder();
        bool jaTemVirgula = false;
        int casasDecimais = 0;

        foreach (char c in texto)
        {
            if (char.IsDigit(c))
            {
                if (jaTemVirgula)
                {
                    if (casasDecimais >= 3)
                    {
                        continue;
                    }

                    casasDecimais++;
                }

                limpo.Append(c);
                continue;
            }

            if (c == ',' && !jaTemVirgula)
            {
                jaTemVirgula = true;
                limpo.Append(c);
            }
        }

        return limpo.ToString();
    }

    private void NormalizarQuantidadeSelecionada()
    {
        if (quantidadeSelecionada < QuantidadeMinima)
        {
            quantidadeSelecionada = QuantidadeMinima;
        }

        if (!ProdutoSelecionadoPermiteDecimal)
        {
            quantidadeSelecionada = Math.Max(1, Math.Truncate(quantidadeSelecionada));
        }
        else
        {
            quantidadeSelecionada = Math.Round(quantidadeSelecionada, 3, MidpointRounding.AwayFromZero);
        }

        quantidadeDigitada = FormatarQuantidade(quantidadeSelecionada);
    }

    private string FormatarQuantidade(decimal quantidade)
    {
        return ProdutoSelecionadoPermiteDecimal
            ? quantidade.ToString("0.###", new CultureInfo("pt-BR"))
            : quantidade.ToString("0", new CultureInfo("pt-BR"));
    }

    private string FormatarQuantidadeCarrinho(decimal quantidade)
    {
        return quantidade == Math.Truncate(quantidade)
            ? quantidade.ToString("0", new CultureInfo("pt-BR"))
            : quantidade.ToString("0.###", new CultureInfo("pt-BR"));
    }

    private async Task ConfirmarAdicionar()
    {
        if (produtoSelecionado == null) return;

        NormalizarQuantidadeDigitada();

        // Confere de novo no banco se a loja continua aberta e o estoque (podem ter mudado)
        verificandoEstoque = true;
        await AtualizarStatusLojaAsync();
        await AtualizarEstoqueModalAsync();
        verificandoEstoque = false;

        if (lojaFechada || ProdutoIndisponivel || ExcedeEstoque)
            return; // o aviso aparece no modal e o botão fica desativado

        decimal preco = CarrinhoService.PrecoAtual(produtoSelecionado);

        observacaoSelecionada = (observacaoSelecionada ?? "").Trim();
        if (observacaoSelecionada.Length > 200)
            observacaoSelecionada = observacaoSelecionada[..200];

        var existente = carrinho.FirstOrDefault(i =>
            i.Codigo == produtoSelecionado.Codigo &&
            i.Observacao == observacaoSelecionada);

        if (existente != null)
            existente.Quantidade += quantidadeSelecionada;
        else
            carrinho.Add(new ItemCarrinho
            {
                Codigo = produtoSelecionado.Codigo,
                Nome = produtoSelecionado.Nome,
                Quantidade = quantidadeSelecionada,
                Preco = preco,
                ImagemBase64 = "",
                Observacao = observacaoSelecionada,
                PermiteDecimal = produtoSelecionado.PermiteDecimal ?? "N"
            });

        await storage.SalvarCarrinhoAsync(slug, carrinho);

        var nomeCurto = produtoSelecionado.Nome.Length > 22
            ? produtoSelecionado.Nome[..22] + "…"
            : produtoSelecionado.Nome;

        mostrarModal = false;
        await ExibirToast($"{nomeCurto} adicionado");
    }

