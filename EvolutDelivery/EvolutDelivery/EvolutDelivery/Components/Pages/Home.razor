@page "/"
@page "/delivery/{slug}"
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inject ProdutoService produtoService
@inject NavigationManager NavManager
@inject StorageService storage
@inject EmpresaService empresaService

<PageTitle>@nomeEmpresa — Cardápio</PageTitle>

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --primary: #2563eb;
        --primary-dark: #1e40af;
        --primary-light: #eff6ff;
        --green: #16a34a;
        --green-light: #dcfce7;
        --red: #dc2626;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --bg: #f8fafc;
        --white: #ffffff;
        --radius-sm: 8px;
        --radius: 14px;
        --radius-lg: 20px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,.06);
        --shadow: 0 2px 8px rgba(0,0,0,.08);
        --shadow-md: 0 4px 16px rgba(0,0,0,.10);
    }

    html, body {
        background: var(--bg);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        color: var(--text);
        min-height: 100vh;
    }

    /* HEADER */
    .hm-header {
        background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%);
        padding: 18px 18px 60px;
        position: relative;
        overflow: hidden;
    }

    .hm-header-inner {
        max-width: 700px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .hm-header::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 28px;
        background: var(--bg);
        border-radius: 28px 28px 0 0;
    }

    .hm-header-deco {
        position: absolute;
        top: -40px;
        right: -40px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,.06);
        pointer-events: none;
    }

    .hm-header-deco2 {
        position: absolute;
        bottom: 10px;
        left: -30px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(255,255,255,.04);
        pointer-events: none;
    }

    .hm-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        z-index: 1;
        gap: 12px;
    }

    .hm-logo-text {
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.3px;
    }

    .hm-logo-sub {
        font-size: 0.72rem;
        color: rgba(255,255,255,.7);
        font-weight: 500;
        margin-top: 1px;
    }

    .hm-btn-admin {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        color: #fff;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .hm-btn-admin:hover {
            background: rgba(255,255,255,.25);
        }

    .hm-btn-orders {
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(255,255,255,.35);
        color: var(--primary-dark);
        border-radius: 20px;
        padding: 7px 14px;
        font-size: 0.78rem;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: var(--shadow-sm);
        transition: transform .15s, background .15s;
    }

        .hm-btn-orders:hover {
            background: #fff;
            transform: translateY(-1px);
        }

    .hm-search {
        position: relative;
        z-index: 1;
    }

        .hm-search input {
            width: 100%;
            padding: 13px 48px 13px 18px;
            border-radius: 30px;
            border: none;
            font-size: 0.95rem;
            color: var(--text);
            background: var(--white);
            box-shadow: var(--shadow-md);
            outline: none;
        }

            .hm-search input::placeholder {
                color: var(--muted);
            }

    .hm-search-icon {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.1rem;
        pointer-events: none;
    }

    /* WRAP */
    .hm-wrap {
        max-width: 700px;
        margin: 0 auto;
        padding-bottom: 100px;
    }

    /* SECOES */
    .hm-secoes {
        display: flex;
        overflow-x: auto;
        gap: 8px;
        padding: 16px 16px 12px;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

        .hm-secoes::-webkit-scrollbar {
            height: 4px;
        }

        .hm-secoes::-webkit-scrollbar-track {
            background: transparent;
        }

        .hm-secoes::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

    .hm-secao-btn {
        flex-shrink: 0;
        padding: 8px 18px;
        border-radius: 30px;
        border: 1.5px solid var(--border);
        background: var(--white);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        white-space: nowrap;
        transition: all .15s;
    }

        .hm-secao-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
        }

        .hm-secao-btn.ativo {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: 0 2px 8px rgba(37,99,235,.25);
        }

    /* LABEL */
    .hm-section-label {
        padding: 4px 16px 12px;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .5px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .hm-section-label span {
            background: var(--primary-light);
            color: var(--primary);
            border-radius: 20px;
            padding: 2px 8px;
            font-size: 0.72rem;
            text-transform: none;
            letter-spacing: 0;
            font-weight: 700;
        }

    /* BANNER PROMO */
    .hm-promo-banner {
        margin: 0 16px 16px;
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        border-radius: var(--radius);
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
        box-shadow: 0 4px 12px rgba(124,58,237,.25);
    }

        .hm-promo-banner:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(124,58,237,.35);
        }

    .hm-promo-icon {
        font-size: 2rem;
        flex-shrink: 0;
    }

    .hm-promo-title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 2px;
    }

    .hm-promo-sub {
        font-size: 0.78rem;
        color: rgba(255,255,255,.8);
    }

    .hm-promo-arrow {
        margin-left: auto;
        color: rgba(255,255,255,.7);
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    /* GRID */
    .hm-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
        gap: 12px;
        padding: 0 16px;
    }

    /* CARD PRODUTO */
    .hm-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform .18s, box-shadow .18s;
        border: 1px solid var(--border);
    }

        .hm-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .hm-card:active {
            transform: scale(.98);
        }

    .hm-card-img-wrap {
        position: relative;
        width: 100%;
        padding-top: 70%;
        background: var(--bg);
        overflow: hidden;
    }

    .hm-card-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .25s;
    }

    .hm-card:hover .hm-card-img {
        transform: scale(1.04);
    }

    .hm-promo-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        background: var(--red);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 3px 7px;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .hm-card-body {
        flex: 1;
        padding: 10px 10px 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .hm-card-nome {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hm-card-preco-antigo {
        font-size: 0.75rem;
        color: var(--muted);
        text-decoration: line-through;
    }

    .hm-card-preco {
        font-size: 0.98rem;
        font-weight: 800;
        color: var(--primary-dark);
    }

        .hm-card-preco.promo {
            color: var(--red);
        }

    .hm-card-add {
        margin-top: auto;
        border: none;
        border-top: 1px solid var(--border);
        background: none;
        color: var(--primary);
        font-size: 0.85rem;
        font-weight: 700;
        padding: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: background .12s, color .12s;
        width: 100%;
    }

        .hm-card-add:hover {
            background: var(--primary-light);
        }

    /* VAZIO */
    .hm-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 60px 30px;
        text-align: center;
        color: var(--muted);
        gap: 8px;
    }

    .hm-empty-icon {
        font-size: 3rem;
        margin-bottom: 8px;
    }

    .hm-empty-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
    }

    .hm-empty-sub {
        font-size: 0.85rem;
        line-height: 1.6;
    }

    /* BARRA CARRINHO */
    .hm-cart-bar {
        position: fixed;
        bottom: 16px;
        left: 16px;
        right: 16px;
        max-width: 668px;
        margin: 0 auto;
        background: var(--primary-dark);
        border-radius: var(--radius-lg);
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 8px 30px rgba(30,64,175,.35);
        z-index: 90;
        animation: cartSlideUp .25s ease;
    }

    @@media (min-width: 700px) {
        .hm-cart-bar {
            left: 50%;
            transform: translateX(-50%);
            width: 668px;
        }
    }

    @@keyframes cartSlideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .hm-cart-info {
        color: #fff;
    }

    .hm-cart-qty {
        font-size: 0.75rem;
        color: rgba(255,255,255,.7);
        margin-bottom: 2px;
    }

    .hm-cart-val {
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
    }

    .hm-cart-btn {
        background: #fff;
        color: var(--primary-dark);
        border: none;
        border-radius: var(--radius);
        padding: 10px 20px;
        font-size: 0.9rem;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
        transition: background .12s;
    }

        .hm-cart-btn:hover {
            background: #e0e7ff;
        }

    /* OVERLAY */
    .hm-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.5);
        z-index: 200;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        backdrop-filter: blur(2px);
    }

    /* MODAL PRODUTO */
    .hm-modal {
        background: var(--white);
        width: 100%;
        max-width: 500px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 0 0 env(safe-area-inset-bottom);
        animation: modalUp .22s ease;
        overflow: hidden;
    }

    @@keyframes modalUp {
        from {
            transform: translateY(100%);
        }

        to {
            transform: translateY(0);
        }
    }

    .hm-modal-img-wrap {
        position: relative;
        width: 100%;
        height: 200px;
        background: var(--bg);
        overflow: hidden;
    }

    .hm-modal-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hm-modal-img-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 80px;
        background: linear-gradient(transparent, rgba(0,0,0,.4));
    }

    .hm-modal-close {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0,0,0,.4);
        border: none;
        color: #fff;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hm-modal-body {
        padding: 20px;
    }

    .hm-modal-nome {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 4px;
    }

    .hm-modal-preco {
        font-size: 1rem;
        font-weight: 700;
        color: var(--primary-dark);
        margin-bottom: 16px;
    }

        .hm-modal-preco.promo {
            color: var(--red);
        }

    .hm-modal-obs-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 6px;
    }

    .hm-modal-obs {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        font-family: inherit;
        color: var(--text);
        resize: none;
        outline: none;
        transition: border-color .15s;
        margin-bottom: 18px;
    }

        .hm-modal-obs:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    .hm-modal-footer {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hm-orders-modal {
        background: var(--white);
        width: 100%;
        max-width: 430px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
        animation: modalUp .22s ease;
        box-shadow: var(--shadow-md);
    }

    .hm-orders-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 6px;
    }

    .hm-orders-sub {
        font-size: 0.84rem;
        color: var(--muted);
        line-height: 1.4;
        margin-bottom: 16px;
    }

    .hm-orders-input {
        width: 100%;
        padding: 13px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        outline: none;
        margin-bottom: 10px;
    }

        .hm-orders-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }

    .hm-orders-error {
        color: var(--red);
        font-size: 0.8rem;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .hm-orders-actions {
        display: flex;
        gap: 10px;
    }

    .hm-orders-secondary,
    .hm-orders-primary {
        height: 44px;
        border-radius: var(--radius-sm);
        border: none;
        font-size: 0.92rem;
        font-weight: 800;
        cursor: pointer;
    }

    .hm-orders-secondary {
        flex: 0 0 112px;
        background: var(--bg);
        color: var(--muted);
        border: 1px solid var(--border);
    }

    .hm-orders-primary {
        flex: 1;
        background: var(--primary);
        color: #fff;
        box-shadow: 0 2px 8px rgba(37,99,235,.25);
    }

    .hm-qty-ctrl {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
        flex-shrink: 0;
    }

    .hm-qty-btn {
        width: 38px;
        height: 42px;
        border: none;
        background: var(--white);
        color: var(--primary);
        font-size: 1.2rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .12s;
    }

        .hm-qty-btn:hover {
            background: var(--primary-light);
        }

        .hm-qty-btn:disabled {
            color: var(--border);
            cursor: default;
        }

    .hm-qty-num {
        width: 76px;
        min-width: 76px;
        text-align: center;
        font-size: 1rem;
        font-weight: 800;
        color: var(--text);
        border-left: 1.5px solid var(--border);
        border-right: 1.5px solid var(--border);
        border-top: none;
        border-bottom: none;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        outline: none;
    }

    .hm-btn-add-confirm {
        flex: 1;
        padding: 13px;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background .12s, transform .1s;
    }

        .hm-btn-add-confirm:hover {
            background: #15803d;
        }

        .hm-btn-add-confirm:active {
            transform: scale(.98);
        }

    /* MODAL SECOES */
    .hm-secoes-modal {
        background: var(--white);
        width: 100%;
        max-width: 500px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        padding: 20px 20px env(safe-area-inset-bottom);
        max-height: 75vh;
        display: flex;
        flex-direction: column;
        animation: modalUp .22s ease;
    }

    .hm-secoes-modal-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
    }

    .hm-secoes-list {
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 4px;
        scrollbar-width: none;
    }

        .hm-secoes-list::-webkit-scrollbar {
            display: none;
        }

    .hm-secao-item {
        padding: 13px 14px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: background .12s;
    }

        .hm-secao-item:hover {
            background: var(--bg);
        }

        .hm-secao-item.ativo {
            background: var(--primary-light);
            color: var(--primary);
        }

            .hm-secao-item.ativo::after {
                content: 'check';
                font-size: 0.8rem;
            }

    /* SKELETON */
    .hm-skeleton-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
        gap: 12px;
        padding: 0 16px;
    }

    .hm-skeleton-card {
        background: var(--white);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        overflow: hidden;
    }

    .hm-skeleton-img {
        width: 100%;
        padding-top: 70%;
        background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite;
    }

    .hm-skeleton-body {
        padding: 10px;
    }

    .hm-skeleton-line {
        height: 12px;
        border-radius: 6px;
        background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.4s infinite;
        margin-bottom: 8px;
    }

        .hm-skeleton-line.short {
            width: 60%;
        }

    @@keyframes shimmer {
        to {
            background-position: -200% 0;
        }
    }

    /* TOAST */
    .hm-toast {
        position: fixed;
        bottom: 90px;
        left: 50%;
        transform: translateX(-50%);
        background: #1e293b;
        color: #fff;
        padding: 10px 20px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        z-index: 300;
        white-space: nowrap;
        animation: toastAnim 2.2s ease forwards;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @@keyframes toastAnim {
        0% {
            opacity: 0;
            transform: translateX(-50%) translateY(12px);
        }

        12% {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        78% {
            opacity: 1;
        }

        100% {
            opacity: 0;
        }
    }

    @@media (max-width: 400px) {
        .hm-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .hm-skeleton-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<!-- HEADER -->
<div class="hm-header">
    <div class="hm-header-deco"></div>
    <div class="hm-header-deco2"></div>
    <div class="hm-header-inner">
        <div class="hm-header-top">
            <div>
                <div class="hm-logo-text">@nomeEmpresa</div>
                <div class="hm-logo-sub">Cardápio digital</div>
            </div>
            <button class="hm-btn-orders" @onclick="AbrirMeusPedidos">Meus pedidos</button>
            @* <button class="hm-btn-admin" @onclick="IrParaAdmin">⚙ Admin</button> *@
        </div>
        <div class="hm-search">
            <input type="search"
                   placeholder="Buscar produto..."
                   value="@filtro"
                   @oninput="FiltrarProdutos" />
            <div class="hm-search-icon">🔍</div>
        </div>
    </div>
</div>

<!-- CONTEÚDO -->
<div class="hm-wrap">

    <!-- Seções -->
    <div class="hm-secoes">
        <button class="hm-secao-btn @(secaoSelecionadaCodigo == 0 && !mostrandoPromocoes ? "ativo" : "")"
                @onclick='() => SelecionarSecao(0, "Todos")'>
            Todos
        </button>
        @foreach (var s in secoes)
        {
            <button class="hm-secao-btn @(secaoSelecionadaCodigo == s.Codigo && !mostrandoPromocoes ? "ativo" : "")"
                    @onclick='() => SelecionarSecao(s.Codigo, s.Descricao)'>
                @s.Descricao
            </button>
        }
        <button class="hm-secao-btn @(mostrandoPromocoes ? "ativo" : "")"
                style="@(mostrandoPromocoes ? "background:#7c3aed;border-color:#7c3aed;" : "border-color:#a855f7;color:#7c3aed;")"
                @onclick="FiltrarPromocoes">
            🔥 Promoções
        </button>
    </div>

    <!-- Banner promoções -->
    @if (!mostrandoPromocoes && totalPromocoes > 0 && string.IsNullOrEmpty(filtro))
    {
        <div class="hm-promo-banner" @onclick="FiltrarPromocoes">
            <div class="hm-promo-icon">🔥</div>
            <div>
                <div class="hm-promo-title">Promoções do dia</div>
                <div class="hm-promo-sub">@totalPromocoes produto(s) com desconto especial</div>
            </div>
            <div class="hm-promo-arrow">›</div>
        </div>
    }

    <!-- Label seção -->
    <div class="hm-section-label">
        @if (mostrandoPromocoes)
        {
            <span style="background:#f3e8ff;color:#7c3aed;">🔥 Promoções</span>
        }
        else if (!string.IsNullOrEmpty(filtro))
        {
            <span>Resultado: "@filtro"</span>
        }
        else
        {
            <text>@secaoAtualNome</text>
            <span>@produtosFiltrados.Count produto(s)</span>
        }
    </div>

    <!-- Skeleton -->
    @if (carregando)
    {
        <div class="hm-skeleton-grid">
            @for (int i = 0; i < 6; i++)
            {
                <div class="hm-skeleton-card">
                    <div class="hm-skeleton-img"></div>
                    <div class="hm-skeleton-body">
                        <div class="hm-skeleton-line"></div>
                        <div class="hm-skeleton-line short"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!produtosFiltrados.Any())
    {
        <div class="hm-empty">
            <div class="hm-empty-icon">🍽</div>
            <div class="hm-empty-title">Nenhum produto encontrado</div>
            <div class="hm-empty-sub">
                @if (!string.IsNullOrEmpty(filtro))
                {
                    <text>Tente buscar por outro nome.</text>
                }
                else
                {

                    <text>Esta seção ainda não tem produtos cadastrados.</text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="hm-grid">
            @foreach (var p in produtosFiltrados)
            {
                bool temPromo = p.PrecoPromocao > 0 && p.PrecoPromocao < p.PrecoVenda;
                <div class="hm-card" @onclick="() => AbrirModal(p)">
                    <div class="hm-card-img-wrap">
                        <img class="hm-card-img"
                             src="@(string.IsNullOrEmpty(p.ImagemBase64) ? "/EvolutDelivery/imagens/sem-imagem.png" : p.ImagemBase64)"
                             alt="@p.Nome" />
                        @if (temPromo)
                        {
                            <div class="hm-promo-badge">Oferta</div>
                        }
                    </div>
                    <div class="hm-card-body">
                        <div class="hm-card-nome">@p.Nome</div>
                        @if (temPromo)
                        {
                            <div class="hm-card-preco-antigo">@p.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))</div>
                            <div class="hm-card-preco promo">@p.PrecoPromocao.ToString("C", new CultureInfo("pt-BR"))</div>
                        }
                        else
                        {
                            <div class="hm-card-preco">@p.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))</div>
                        }
                    </div>
                    <button class="hm-card-add" @onclick:stopPropagation @onclick="() => AbrirModal(p)">
                        + Adicionar
                    </button>
                </div>
            }
        </div>
    }
</div>

<!-- BARRA CARRINHO -->
@if (carrinho.Any())
{
    <div class="hm-cart-bar">
        <div class="hm-cart-info">
            <div class="hm-cart-qty">@FormatarQuantidadeCarrinho(TotalItensCarrinho) iten(s) no carrinho</div>
            <div class="hm-cart-val">@TotalCarrinho.ToString("C", new CultureInfo("pt-BR"))</div>
        </div>
        <button class="hm-cart-btn" @onclick="IrParaCarrinho">Ver carrinho →</button>
    </div>
}

<!-- MODAL PRODUTO -->
@if (mostrarModal && produtoSelecionado != null)
{
    bool temPromoModal = produtoSelecionado.PrecoPromocao > 0 && produtoSelecionado.PrecoPromocao < produtoSelecionado.PrecoVenda;
    bool permiteDecimalModal = ProdutoPermiteDecimal(produtoSelecionado);
    decimal precoModal = temPromoModal ? produtoSelecionado.PrecoPromocao : produtoSelecionado.PrecoVenda;
    decimal totalModal = precoModal * quantidadeSelecionada;

    <div class="hm-overlay" @onclick="FecharModal">
        <div class="hm-modal" @onclick:stopPropagation>
            <div class="hm-modal-img-wrap">
                <img class="hm-modal-img"
                     src="@(string.IsNullOrEmpty(produtoSelecionado.ImagemBase64) ? "/EvolutDelivery/imagens/sem-imagem.png" : produtoSelecionado.ImagemBase64)"
                     alt="@produtoSelecionado.Nome" />
                <div class="hm-modal-img-gradient"></div>
                <button class="hm-modal-close" @onclick="FecharModal">✕</button>
            </div>
            <div class="hm-modal-body">
                <div class="hm-modal-nome">@produtoSelecionado.Nome</div>
                @if (temPromoModal)
                {
                    <div style="font-size:.82rem;color:var(--muted);text-decoration:line-through;margin-bottom:2px;">
                        @produtoSelecionado.PrecoVenda.ToString("C", new CultureInfo("pt-BR"))
                    </div>
                }
                <div class="hm-modal-preco @(temPromoModal ? "promo" : "")">
                    @precoModal.ToString("C", new CultureInfo("pt-BR"))
                </div>
                @if (permiteDecimalModal)
                {
                    <div style="font-size:.78rem;color:var(--muted);margin-top:-6px;margin-bottom:12px;">
                        Produto vendido por quantidade fracionada
                    </div>
                }
                <div class="hm-modal-obs-label">Observação</div>
                <textarea class="hm-modal-obs" rows="2"
                          placeholder="Ex: sem cebola, bem passado..."
                          @bind="observacaoSelecionada"></textarea>
                <div class="hm-modal-footer">
                    <div class="hm-qty-ctrl">
                        <button class="hm-qty-btn" @onclick="DiminuirQtd" disabled="@(quantidadeSelecionada <= QuantidadeMinima)">−</button>
                        @if (permiteDecimalModal)
                        {
                            <input class="hm-qty-num"
                                   type="text"
                                   inputmode="decimal"
                                   pattern="[0-9]*[,.]?[0-9]*"
                                   value="@quantidadeDigitada"
                                   @oninput="AlterarQuantidadeDigitada"
                                   @onblur="NormalizarQuantidadeDigitada" />
                        }
                        else
                        {
                            <input class="hm-qty-num"
                                   @key="QuantidadeInputKey"
                                   type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   value="@quantidadeDigitada"
                                   @oninput="AlterarQuantidadeDigitada"
                                   @onblur="NormalizarQuantidadeDigitada" />
                        }
                        <button class="hm-qty-btn" @onclick="AumentarQtd">+</button>
                    </div>
                    <button class="hm-btn-add-confirm" @onclick="ConfirmarAdicionar">
                        Adicionar · @totalModal.ToString("C", new CultureInfo("pt-BR"))
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL SEÇÕES -->
@if (mostrarSeletorSecoes)
{
    <div class="hm-overlay" @onclick="FecharSeletorSecoes">
        <div class="hm-secoes-modal" @onclick:stopPropagation>
            <div class="hm-secoes-modal-title">Categorias</div>
            <div class="hm-secoes-list">
                <div class="hm-secao-item @(secaoSelecionadaCodigo == 0 && !mostrandoPromocoes ? "ativo" : "")"
                     @onclick='() => SelecionarSecaoModal(0, "Todos")'>
                    Todos os produtos
                </div>
                @foreach (var s in secoes)
                {
                    <div class="hm-secao-item @(secaoSelecionadaCodigo == s.Codigo && !mostrandoPromocoes ? "ativo" : "")"
                         @onclick='() => SelecionarSecaoModal(s.Codigo, s.Descricao)'>
                        @s.Descricao
                    </div>
                }
                <div class="hm-secao-item @(mostrandoPromocoes ? "ativo" : "")"
                     style="color:#7c3aed;"
                     @onclick="() => { FiltrarPromocoes(); mostrarSeletorSecoes = false; }">
                    🔥 Promoções
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL MEUS PEDIDOS -->
@if (mostrarModalPedidos)
{
    <div class="hm-overlay" @onclick="FecharMeusPedidos">
        <div class="hm-orders-modal" @onclick:stopPropagation>
            <div class="hm-orders-title">Meus pedidos</div>
            <div class="hm-orders-sub">Informe o telefone usado no pedido para acompanhar o andamento.</div>

            <input class="hm-orders-input"
                   type="tel"
                   inputmode="tel"
                   maxlength="16"
                   placeholder="Ex: (11) 99999-9999"
                   @bind="telefonePedidos"
                   @bind:event="oninput"
                   @onkeydown="TelefonePedidosKeyDown" />

            @if (!string.IsNullOrWhiteSpace(erroTelefonePedidos))
            {
                <div class="hm-orders-error">@erroTelefonePedidos</div>
            }

            <div class="hm-orders-actions">
                <button class="hm-orders-secondary" @onclick="FecharMeusPedidos">Cancelar</button>
                <button class="hm-orders-primary" @onclick="BuscarMeusPedidos">Buscar</button>
            </div>
        </div>
    </div>
}

<!-- TOAST -->
@if (mostrarToast)
{
    <div class="hm-toast">✓ @mensagemToast</div>
}

@code {
    [Parameter] public string slug { get; set; } = string.Empty;

    private string cnpj = "";
    private string nomeEmpresa = "EvolutDelivery";
    private string secaoAtualNome = "Todos os produtos";
    private int secaoSelecionadaCodigo = 0;

    private List<Produto> produtos = new();
    private List<Produto> produtosFiltrados = new();
    private List<ItemCarrinho> carrinho = new();
    private List<SecaoModel> secoes = new();

    private string filtro = "";
    private bool mostrandoPromocoes = false;
    private bool carregando = true;
    private int totalPromocoes = 0;

    private bool mostrarModal = false;
    private bool mostrarSeletorSecoes = false;
    private Produto? produtoSelecionado;
    private decimal quantidadeSelecionada = 1;
    private string quantidadeDigitada = "1";
    private int quantidadeInputVersao = 0;
    private string observacaoSelecionada = "";

    private bool mostrarToast = false;
    private string mensagemToast = "";
    private bool mostrarModalPedidos = false;
    private string telefonePedidos = "";
    private string erroTelefonePedidos = "";

    private decimal TotalItensCarrinho => carrinho.Sum(i => i.Quantidade);
    private decimal TotalCarrinho => carrinho.Sum(i => i.Preco * i.Quantidade);

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;

        try
        {
            if (string.IsNullOrWhiteSpace(slug))
            {
                nomeEmpresa = "Empresa não encontrada";
                carregando = false;
                return;
            }

            var empresa = await empresaService.BuscarPorSlugAsync(slug);

            if (empresa == null)
            {
                nomeEmpresa = "Empresa não encontrada";
                carregando = false;
                return;
            }

            cnpj = empresa.CNPJ;
            nomeEmpresa = empresa.Fantasia;

            secoes = produtoService.BuscarSecoes(cnpj);
            produtos = produtoService.BuscarProdutos("", cnpj);

            totalPromocoes = produtos.Count(p => p.PrecoPromocao > 0 && p.PrecoPromocao < p.PrecoVenda);
            produtosFiltrados = produtos;
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERRO HOME: " + ex.ToString());
            nomeEmpresa = "Erro ao carregar";
        }
        finally
        {
            carregando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var salvo = await storage.GetAsync<List<ItemCarrinho>>("carrinho");
            if (salvo != null)
            {
                carrinho = salvo;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void SelecionarSecao(int codigo, string descricao)
    {
        secaoSelecionadaCodigo = codigo;
        secaoAtualNome = codigo == 0 ? "Todos os produtos" : descricao;
        mostrandoPromocoes = false;
        filtro = "";

        produtosFiltrados = codigo == 0
            ? produtos
            : produtoService.BuscarProdutosPorSecao(codigo, cnpj);
    }

    private void SelecionarSecaoModal(int codigo, string descricao)
    {
        SelecionarSecao(codigo, descricao);
        mostrarSeletorSecoes = false;
    }

    private void FiltrarPromocoes()
    {
        mostrandoPromocoes = true;
        secaoSelecionadaCodigo = 0;
        filtro = "";
        produtosFiltrados = produtos
            .Where(p => p.PrecoPromocao > 0 && p.PrecoPromocao < p.PrecoVenda)
            .ToList();
    }

    private void FiltrarProdutos(ChangeEventArgs e)
    {
        filtro = e.Value?.ToString() ?? "";
        mostrandoPromocoes = false;

        produtosFiltrados = string.IsNullOrWhiteSpace(filtro)
            ? (secaoSelecionadaCodigo == 0
                ? produtos
                : produtoService.BuscarProdutosPorSecao(secaoSelecionadaCodigo, cnpj))
            : produtos.Where(p => p.Nome.Contains(filtro, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void AbrirModal(Produto p)
    {
        produtoSelecionado = p;
        quantidadeSelecionada = 1;
        quantidadeDigitada = "1";
        observacaoSelecionada = "";
        mostrarModal = true;
    }

    private void FecharModal() => mostrarModal = false;
    private void AbrirSeletorSecoes() => mostrarSeletorSecoes = true;
    private void FecharSeletorSecoes() => mostrarSeletorSecoes = false;
    private decimal QuantidadeMinima => ProdutoSelecionadoPermiteDecimal ? 0.001m : 1m;
    private decimal PassoQuantidade => ProdutoSelecionadoPermiteDecimal ? 0.100m : 1m;
    private bool ProdutoSelecionadoPermiteDecimal => produtoSelecionado != null && ProdutoPermiteDecimal(produtoSelecionado);
    private string QuantidadeInputKey => "I-" + quantidadeInputVersao;

    private bool ProdutoPermiteDecimal(Produto produto)
    {
        return string.Equals(produto.PermiteDecimal ?? "N", "S", StringComparison.OrdinalIgnoreCase);
    }

    private void AumentarQtd()
    {
        quantidadeSelecionada += PassoQuantidade;
        NormalizarQuantidadeSelecionada();
    }

    private void DiminuirQtd()
    {
        quantidadeSelecionada -= PassoQuantidade;
        NormalizarQuantidadeSelecionada();
    }

    private void AlterarQuantidadeDigitada(ChangeEventArgs e)
    {
        string textoOriginal = e.Value?.ToString() ?? "";
        string textoLimpo = LimparQuantidadeDigitada(textoOriginal);

        if (textoOriginal != textoLimpo)
        {
            quantidadeInputVersao++;
        }

        quantidadeDigitada = textoLimpo;

        decimal quantidade;
        if (decimal.TryParse(quantidadeDigitada.Replace(".", ","), NumberStyles.Any, new CultureInfo("pt-BR"), out quantidade))
        {
            quantidadeSelecionada = quantidade;
        }

        if (textoOriginal != textoLimpo)
        {
            StateHasChanged();
        }
    }

    private void NormalizarQuantidadeDigitada()
    {
        quantidadeDigitada = LimparQuantidadeDigitada(quantidadeDigitada);

        decimal quantidade;
        if (!decimal.TryParse(quantidadeDigitada.Replace(".", ","), NumberStyles.Any, new CultureInfo("pt-BR"), out quantidade))
        {
            quantidade = QuantidadeMinima;
        }

        quantidadeSelecionada = quantidade;
        NormalizarQuantidadeSelecionada();
    }

    private string LimparQuantidadeDigitada(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return "";
        }

        texto = texto.Trim();

        if (!ProdutoSelecionadoPermiteDecimal)
        {
            var inteiro = new System.Text.StringBuilder();

            foreach (char c in texto)
            {
                if (c == ',' || c == '.')
                {
                    break;
                }

                if (char.IsDigit(c))
                {
                    inteiro.Append(c);
                }
            }

            return inteiro.ToString();
        }

        texto = texto.Replace(".", ",");

        var limpo = new System.Text.StringBuilder();
        bool jaTemVirgula = false;
        int casasDecimais = 0;

        foreach (char c in texto)
        {
            if (char.IsDigit(c))
            {
                if (jaTemVirgula)
                {
                    if (casasDecimais >= 3)
                    {
                        continue;
                    }

                    casasDecimais++;
                }

                limpo.Append(c);
                continue;
            }

            if (c == ',' && !jaTemVirgula)
            {
                jaTemVirgula = true;
                limpo.Append(c);
            }
        }

        return limpo.ToString();
    }

    private void NormalizarQuantidadeSelecionada()
    {
        if (quantidadeSelecionada < QuantidadeMinima)
        {
            quantidadeSelecionada = QuantidadeMinima;
        }

        if (!ProdutoSelecionadoPermiteDecimal)
        {
            quantidadeSelecionada = Math.Max(1, Math.Truncate(quantidadeSelecionada));
        }
        else
        {
            quantidadeSelecionada = Math.Round(quantidadeSelecionada, 3, MidpointRounding.AwayFromZero);
        }

        quantidadeDigitada = FormatarQuantidade(quantidadeSelecionada);
    }

    private string FormatarQuantidade(decimal quantidade)
    {
        return ProdutoSelecionadoPermiteDecimal
            ? quantidade.ToString("0.###", new CultureInfo("pt-BR"))
            : quantidade.ToString("0", new CultureInfo("pt-BR"));
    }

    private string FormatarQuantidadeCarrinho(decimal quantidade)
    {
        return quantidade == Math.Truncate(quantidade)
            ? quantidade.ToString("0", new CultureInfo("pt-BR"))
            : quantidade.ToString("0.###", new CultureInfo("pt-BR"));
    }

    private async Task ConfirmarAdicionar()
    {
        if (produtoSelecionado == null) return;

        NormalizarQuantidadeDigitada();

        decimal preco = produtoSelecionado.PrecoPromocao > 0 && produtoSelecionado.PrecoPromocao < produtoSelecionado.PrecoVenda
            ? produtoSelecionado.PrecoPromocao
            : produtoSelecionado.PrecoVenda;

        var existente = carrinho.FirstOrDefault(i =>
            i.Codigo == produtoSelecionado.Codigo &&
            i.Observacao == observacaoSelecionada);

        if (existente != null)
            existente.Quantidade += quantidadeSelecionada;
        else
            carrinho.Add(new ItemCarrinho
            {
                Codigo = produtoSelecionado.Codigo,
                Nome = produtoSelecionado.Nome,
                Quantidade = quantidadeSelecionada,
                Preco = preco,
                ImagemBase64 = produtoSelecionado.ImagemBase64 ?? "",
                Observacao = observacaoSelecionada,
                PermiteDecimal = produtoSelecionado.PermiteDecimal ?? "N"
            });

        await storage.SaveAsync("carrinho", carrinho);

        var nomeCurto = produtoSelecionado.Nome.Length > 22
            ? produtoSelecionado.Nome[..22] + "…"
            : produtoSelecionado.Nome;

        mostrarModal = false;
        await ExibirToast($"{nomeCurto} adicionado");
    }

    private void IrParaCarrinho() => NavManager.NavigateTo($"/EvolutDelivery/delivery/{slug}/carrinho");
    private void IrParaAdmin() => NavManager.NavigateTo("/EvolutDelivery/login");

    private void AbrirMeusPedidos()
    {
        erroTelefonePedidos = "";
        mostrarModalPedidos = true;
    }

    private void FecharMeusPedidos()
    {
        mostrarModalPedidos = false;
        erroTelefonePedidos = "";
    }

    private void BuscarMeusPedidos()
    {
        string telefoneLimpo = SomenteNumeros(telefonePedidos);

        if (telefoneLimpo.Length < 8)
        {
            erroTelefonePedidos = "Informe um telefone valido.";
            return;
        }

        NavManager.NavigateTo($"/EvolutDelivery/delivery/{slug}/meus-pedidos/{telefoneLimpo}");
    }

    private void TelefonePedidosKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            BuscarMeusPedidos();
        }
    }

    private string SomenteNumeros(string valor)
    {
        return new string((valor ?? "").Where(char.IsDigit).ToArray());
    }

    private async Task ExibirToast(string msg)
    {
        mensagemToast = msg;
        mostrarToast = true;
        StateHasChanged();
        await Task.Delay(2200);
        mostrarToast = false;
        StateHasChanged();
    }
}
