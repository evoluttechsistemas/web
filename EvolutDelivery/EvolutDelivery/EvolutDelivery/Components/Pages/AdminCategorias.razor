@page "/admin-categorias"
@rendermode InteractiveServer
@layout AdminLayout
@inject IJSRuntime JS

<PageTitle>Categorias - Admin</PageTitle>

<style>
    .categorias-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 24px;
    }

    .categoria-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: all 0.3s;
    }

        .categoria-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

    .categoria-icon {
        font-size: 3rem;
        margin-bottom: 16px;
        text-align: center;
    }

    .categoria-nome {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: #0f172a;
    }

    .categoria-produtos {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .categoria-acoes {
        display: flex;
        gap: 8px;
    }

    .btn-acao {
        flex: 1;
        padding: 8px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .btn-editar {
        background: #2563eb;
        color: white;
    }

    .btn-deletar {
        background: #ef4444;
        color: white;
    }
</style>

<div class="header-actions" style="display:flex; justify-content:space-between; margin-bottom:24px;">
    <h2>📂 Gestão de Categorias</h2>
    <button class="btn-novo" style="background:#2563eb; color:white; border:none; padding:12px 24px; border-radius:8px; font-weight:600; cursor:pointer;"
            @onclick="NovaCategoria">
        + Nova Categoria
    </button>
</div>

<div class="categorias-grid">

    <div class="categoria-card">
        <div class="categoria-icon">🍔</div>
        <div class="categoria-nome">Lanches</div>
        <div class="categoria-produtos">45 produtos</div>
        <div class="categoria-acoes">
            <button class="btn-acao btn-editar" @onclick='() => EditarCategoria(1)'>✏️ Editar</button>
            <button class="btn-acao btn-deletar" @onclick='() => DeletarCategoria(1)'>🗑️</button>
        </div>
    </div>

    <div class="categoria-card">
        <div class="categoria-icon">🍕</div>
        <div class="categoria-nome">Pizzas</div>
        <div class="categoria-produtos">28 produtos</div>
        <div class="categoria-acoes">
            <button class="btn-acao btn-editar" @onclick='() => EditarCategoria(2)'>✏️ Editar</button>
            <button class="btn-acao btn-deletar" @onclick='() => DeletarCategoria(2)'>🗑️</button>
        </div>
    </div>

    <div class="categoria-card">
        <div class="categoria-icon">🥤</div>
        <div class="categoria-nome">Bebidas</div>
        <div class="categoria-produtos">32 produtos</div>
        <div class="categoria-acoes">
            <button class="btn-acao btn-editar" @onclick='() => EditarCategoria(3)'>✏️ Editar</button>
            <button class="btn-acao btn-deletar" @onclick='() => DeletarCategoria(3)'>🗑️</button>
        </div>
    </div>

    <div class="categoria-card">
        <div class="categoria-icon">🍰</div>
        <div class="categoria-nome">Sobremesas</div>
        <div class="categoria-produtos">18 produtos</div>
        <div class="categoria-acoes">
            <button class="btn-acao btn-editar" @onclick='() => EditarCategoria(4)'>✏️ Editar</button>
            <button class="btn-acao btn-deletar" @onclick='() => DeletarCategoria(4)'>🗑️</button>
        </div>
    </div>

    <div class="categoria-card">
        <div class="categoria-icon">🍟</div>
        <div class="categoria-nome">Porções</div>
        <div class="categoria-produtos">15 produtos</div>
        <div class="categoria-acoes">
            <button class="btn-acao btn-editar" @onclick='() => EditarCategoria(5)'>✏️ Editar</button>
            <button class="btn-acao btn-deletar" @onclick='() => DeletarCategoria(5)'>🗑️</button>
        </div>
    </div>

    <div class="categoria-card">
        <div class="categoria-icon">🍺</div>
        <div class="categoria-nome">Cervejas</div>
        <div class="categoria-produtos">22 produtos</div>
        <div class="categoria-acoes">
            <button class="btn-acao btn-editar" @onclick='() => EditarCategoria(6)'>✏️ Editar</button>
            <button class="btn-acao btn-deletar" @onclick='() => DeletarCategoria(6)'>🗑️</button>
        </div>
    </div>

</div>

@code {
    private async Task NovaCategoria()
    {
        await JS.InvokeVoidAsync("alert", "Modal de nova categoria em desenvolvimento!");
    }

    private async Task EditarCategoria(int id)
    {
        await JS.InvokeVoidAsync("alert", $"Editar categoria #{id}");
    }

    private async Task DeletarCategoria(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Deletar categoria #{id}?");
        if (confirmado)
        {
            await JS.InvokeVoidAsync("alert", "Categoria deletada!");
        }
    }
}
