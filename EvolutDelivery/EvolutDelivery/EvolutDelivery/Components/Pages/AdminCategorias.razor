@page "/admin-categorias"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using EvolutDelivery.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@inject ILogger<AdminCategorias> Logger
@inject ProdutoService ProdutoService
@inject IJSRuntime JS

<PageTitle>Categorias - Admin</PageTitle>

<style>
    .categorias-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        margin-top: 24px;
    }

    .categoria-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: all 0.3s;
    }

        .categoria-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

    .categoria-icon {
        font-size: 3rem;
        margin-bottom: 16px;
        text-align: center;
    }

    .categoria-nome {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: #0f172a;
    }

    .categoria-produtos {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .categoria-acoes {
        display: flex;
        gap: 8px;
    }

    .btn-acao {
        flex: 1;
        padding: 8px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .btn-editar {
        background: #2563eb;
        color: white;
    }

    .btn-deletar {
        background: #ef4444;
        color: white;
    }
</style>

<div class="header-actions" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; gap:12px; flex-wrap:wrap;">
    <h2>📂 Categorias</h2>
    <span style="color:#64748b; font-size:.9rem;">As categorias vêm das seções cadastradas no ERP</span>
</div>

@if (!string.IsNullOrWhiteSpace(mensagemErro))
{
    <div style="background:#fef2f2; color:#dc2626; padding:16px; border-radius:12px; margin-bottom:16px; font-weight:600;">
        @mensagemErro
    </div>
}

@if (carregando)
{
    <div style="background:white; padding:60px; border-radius:12px; text-align:center; color:#64748b;">
        Carregando categorias...
    </div>
}
else if (!categorias.Any())
{
    <div style="background:white; padding:60px; border-radius:12px; text-align:center; color:#64748b;">
        📂 Nenhuma categoria encontrada.
    </div>
}
else
{
    <div class="categorias-grid">
        @foreach (var c in categorias)
        {
            <div class="categoria-card">
                <div class="categoria-icon">📂</div>
                <div class="categoria-nome">@c.Nome</div>
                <div class="categoria-produtos">@c.TotalProdutos produto(s)</div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private record CategoriaResumo(int Codigo, string Nome, int TotalProdutos);

    private List<CategoriaResumo> categorias = new();
    private string mensagemErro = "";
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthState).User;
            if (!EmpresaLogadaHelper.TryObter(user, out _, out var cnpj))
            {
                mensagemErro = "Sessão inválida. Saia e faça login novamente.";
                return;
            }

            var secoes = await Task.Run(() => ProdutoService.BuscarSecoes(cnpj));
            var produtos = await Task.Run(() => ProdutoService.BuscarProdutos("", cnpj));

            var totalPorSecao = produtos
                .GroupBy(p => p.CodSecao)
                .ToDictionary(g => g.Key, g => g.Select(p => p.Codigo).Distinct().Count());

            categorias = secoes
                .Select(s => new CategoriaResumo(
                    s.Codigo,
                    s.Descricao,
                    totalPorSecao.TryGetValue(s.Codigo, out var total) ? total : 0))
                .ToList();
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao carregar categorias.";
            Logger.LogError(ex, "Erro ao carregar categorias do admin");
        }
        finally
        {
            carregando = false;
        }
    }
}
