@page "/login"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-container">

        <div class="login-left">
            <div class="brand-box">
                <div class="brand-icon">🍔</div>
                <h1>Delivery App</h1>
                <p>
                    Entre na sua conta para gerenciar pedidos, acompanhar entregas
                    e acessar seu sistema com praticidade.
                </p>
            </div>
        </div>

        <div class="login-right">
            <div class="login-card">
                <div class="login-header">
                    <h2>Entrar</h2>
                    <p>Informe seus dados para acessar o sistema</p>
                </div>

                @if (ErroLogin)
                {
                    <div class="alert-error">
                        CNPJ, usuário ou senha inválidos.
                    </div>
                }

                <form method="post" action="/EvolutDelivery/auth/login">
                    <input type="hidden" name="ReturnUrl" value="@DestinoFinal" />

                    <div class="form-group">
                        <label for="cnpj">CNPJ</label>
                        <input id="cnpj"
                               name="CNPJ"
                               class="form-control"
                               @bind="cnpj"
                               @bind:event="oninput"
                               @onchange="async _ => await CarregarEmpresas()"
                               placeholder="Digite o CNPJ"
                               required />
                    </div>

                    <div class="form-group">
                        <label>Empresa</label>
                        <select class="form-control" @bind="empresaSelecionada" name="CodEmp">
                            <option value="0">Selecione</option>

                            @foreach (var emp in empresas)
                            {
                                <option value="@emp.CodEmp">@emp.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="usuario">Usuário</label>
                        <input id="usuario"
                               name="Usuario"
                               class="form-control"
                               placeholder="Digite o usuário"
                               required />
                    </div>

                    <div class="form-group">
                        <label for="senha">Senha</label>
                        <div class="password-wrapper">
                            <input id="senha"
                                   name="Senha"
                                   type="@(ShowPassword ? "text" : "password")"
                                   class="form-control password-input"
                                   placeholder="Digite sua senha"
                                   required />
                            <button type="button" class="toggle-password" @onclick="TogglePassword">
                                @(ShowPassword ? "Ocultar" : "Mostrar")
                            </button>
                        </div>
                    </div>

                    <div class="options-row">
                        <label class="remember-me">
                            <input type="checkbox" name="RememberMe" value="true" />
                            <span>Lembrar-me</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-login">
                        Entrar
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@code {

    public class EmpresaDto
    {
        public int CodEmp { get; set; }
        public string Nome { get; set; } = "";
    }
    @inject HttpClient Http

    private List<EmpresaDto> empresas = new();
    private int empresaSelecionada;
    private string cnpj = "";
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool ShowPassword = false;

    private bool ErroLogin => Error == "1";

    private string DestinoFinal =>
    string.IsNullOrWhiteSpace(ReturnUrl) ? "/EvolutDelivery/admin-dashboard" : ReturnUrl;

    private void TogglePassword()
    {
        ShowPassword = !ShowPassword;
    }

    private async Task CarregarEmpresas()
    {
        cnpj = new string(cnpj.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(cnpj))
            return;

        try
        {
            empresas = await Http.GetFromJsonAsync<List<EmpresaDto>>(
    $"api/empresas-por-cnpj?cnpj={cnpj}"
) ?? new List<EmpresaDto>();

            if (empresas.Count == 1)
                empresaSelecionada = empresas[0].CodEmp;
        }
        catch
        {
            empresas.Clear();
        }
    }
}

<style>
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #eff6ff, #dbeafe, #bfdbfe);
        padding: 30px;
        box-sizing: border-box;
    }

    .login-container {
        width: 100%;
        max-width: 1100px;
        min-height: 650px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
    }

    .login-left {
        background: linear-gradient(160deg, #2563eb, #1e40af);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px;
    }

    .brand-box {
        max-width: 380px;
    }

    .brand-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        background: rgba(255,255,255,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin-bottom: 24px;
        backdrop-filter: blur(4px);
    }

    .brand-box h1 {
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 16px;
        line-height: 1.1;
    }

    .brand-box p {
        font-size: 17px;
        line-height: 1.7;
        opacity: 0.95;
    }

    .login-right {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background: #fff;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
    }

    .login-header {
        margin-bottom: 28px;
    }

        .login-header h2 {
            font-size: 34px;
            color: #1f2937;
            margin-bottom: 8px;
            font-weight: 800;
        }

        .login-header p {
            color: #6b7280;
            font-size: 15px;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-weight: 700;
            margin-bottom: 8px;
            color: #374151;
            font-size: 14px;
        }

    .form-control {
        width: 100%;
        height: 50px;
        border: 1px solid #d1d5db;
        border-radius: 14px;
        padding: 0 15px;
        font-size: 15px;
        outline: none;
        transition: 0.2s ease;
        box-sizing: border-box;
        background: #fff;
    }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        }

    .password-wrapper {
        position: relative;
    }

    .password-input {
        padding-right: 90px;
    }

    .toggle-password {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #2563eb;
        font-weight: 700;
        cursor: pointer;
        font-size: 13px;
    }

        .toggle-password:hover {
            color: #1e40af;
        }

    .options-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 8px 0 22px 0;
        gap: 12px;
        flex-wrap: wrap;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #4b5563;
        font-size: 14px;
        cursor: pointer;
    }

    .forgot-link {
        color: #2563eb;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .forgot-link:hover {
            text-decoration: underline;
        }

    .btn-login {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: white;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.25s ease;
        box-shadow: 0 10px 20px rgba(37, 99, 235, 0.25);
    }

        .btn-login:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 14px 24px rgba(37, 99, 235, 0.3);
        }

        .btn-login:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    .register-area {
        margin-top: 24px;
        text-align: center;
        font-size: 14px;
        color: #6b7280;
    }

        .register-area a {
            color: #2563eb;
            font-weight: 700;
            text-decoration: none;
            margin-left: 6px;
        }

            .register-area a:hover {
                text-decoration: underline;
            }

    .alert-error {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        padding: 14px 16px;
        border-radius: 12px;
        margin-bottom: 18px;
        font-size: 14px;
        font-weight: 600;
    }

    .validation-summary {
        margin-bottom: 12px;
        color: #b91c1c;
        font-size: 14px;
    }

    .field-validation {
        color: #dc2626;
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    /* RESPONSIVO */
    @@media (max-width: 900px) {
        .login-container {
            grid-template-columns: 1fr;
        }

        .login-left {
            min-height: 240px;
            padding: 30px;
        }

        .brand-box h1 {
            font-size: 30px;
        }

        .login-right {
            padding: 30px 22px;
        }
    }

    @@media (max-width: 500px) {
        .login-page {
            padding: 15px;
        }

        .login-header h2 {
            font-size: 28px;
        }

        .brand-box p {
            font-size: 15px;
        }
    }
</style>