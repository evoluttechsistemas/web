@page "/admin-relatorios-vendas"
@rendermode InteractiveServer
@layout AdminLayout

<PageTitle>Relatório de Vendas - Admin</PageTitle>

<style>
    .filtros-relatorio {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        gap: 16px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .filtro-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filtro-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #64748b;
        }

        .filtro-group input,
        .filtro-group select {
            padding: 10px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

    .stats-resumo {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-box {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

        .stat-box .label {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 8px;
        }

        .stat-box .value {
            font-size: 2rem;
            font-weight: 700;
            color: #0f172a;
        }

        .stat-box .change {
            font-size: 0.85rem;
            color: #16a34a;
            margin-top: 4px;
        }

            .stat-box .change.negative {
                color: #ef4444;
            }

    .chart-container {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 24px;
    }

        .chart-container h3 {
            margin-bottom: 20px;
            color: #0f172a;
        }
</style>

<h2>💰 Relatório de Vendas</h2>

<div class="filtros-relatorio">
    <div class="filtro-group">
        <label>Período</label>
        <select>
            <option>Hoje</option>
            <option>Esta semana</option>
            <option>Este mês</option>
            <option>Personalizado</option>
        </select>
    </div>

    <div class="filtro-group">
        <label>Data Início</label>
        <input type="date" value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" />
    </div>

    <div class="filtro-group">
        <label>Data Fim</label>
        <input type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    </div>

    <div class="filtro-group">
        <label>&nbsp;</label>
        <button style="background:#2563eb; color:white; border:none; padding:10px 20px; border-radius:8px; font-weight:600; cursor:pointer;">
            Gerar Relatório
        </button>
    </div>
</div>

<div class="stats-resumo">
    <div class="stat-box">
        <div class="label">💵 Faturamento Total</div>
        <div class="value">R$ 45.890,50</div>
        <div class="change">+15.3% vs mês anterior</div>
    </div>

    <div class="stat-box">
        <div class="label">📦 Total de Pedidos</div>
        <div class="value">1.248</div>
        <div class="change">+8.7% vs mês anterior</div>
    </div>

    <div class="stat-box">
        <div class="label">💳 Ticket Médio</div>
        <div class="value">R$ 36,75</div>
        <div class="change negative">-2.1% vs mês anterior</div>
    </div>

    <div class="stat-box">
        <div class="label">🚚 Taxa de Entrega</div>
        <div class="value">R$ 6.240,00</div>
        <div class="change">+12.4% vs mês anterior</div>
    </div>
</div>

<div class="chart-container">
    <h3>📈 Vendas dos Últimos 30 Dias</h3>
    <div style="height:300px; display:flex; align-items:center; justify-content:center; background:#f8fafc; border-radius:8px; color:#64748b;">
        <div style="text-align:center;">
            <div style="font-size:3rem; margin-bottom:12px;">📊</div>
            <div>Gráfico de vendas será exibido aqui</div>
            <div style="font-size:0.85rem; margin-top:8px;">(Integração com biblioteca de gráficos)</div>
        </div>
    </div>
</div>

<div class="chart-container">
    <h3>🕐 Horários de Pico</h3>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:16px;">
        <div style="text-align:center; padding:20px; background:#f8fafc; border-radius:8px;">
            <div style="font-size:1.5rem; font-weight:700;">18:00-20:00</div>
            <div style="color:#64748b; margin-top:4px;">342 pedidos</div>
        </div>
        <div style="text-align:center; padding:20px; background:#f8fafc; border-radius:8px;">
            <div style="font-size:1.5rem; font-weight:700;">12:00-14:00</div>
            <div style="color:#64748b; margin-top:4px;">289 pedidos</div>
        </div>
        <div style="text-align:center; padding:20px; background:#f8fafc; border-radius:8px;">
            <div style="font-size:1.5rem; font-weight:700;">20:00-22:00</div>
            <div style="color:#64748b; margin-top:4px;">267 pedidos</div>
        </div>
        <div style="text-align:center; padding:20px; background:#f8fafc; border-radius:8px;">
            <div style="font-size:1.5rem; font-weight:700;">Sábados</div>
            <div style="color:#64748b; margin-top:4px;">Dia mais movimentado</div>
        </div>
    </div>
</div>

<div class="chart-container">
    <h3>💳 Formas de Pagamento</h3>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:16px;">
        <div style="padding:16px; background:#eff6ff; border-radius:8px;">
            <div style="font-size:0.85rem; color:#1e40af; margin-bottom:4px;">💵 Dinheiro</div>
            <div style="font-size:1.5rem; font-weight:700; color:#1e40af;">45%</div>
            <div style="font-size:0.85rem; color:#64748b;">562 transações</div>
        </div>
        <div style="padding:16px; background:#f0fdf4; border-radius:8px;">
            <div style="font-size:0.85rem; color:#15803d; margin-bottom:4px;">📱 PIX</div>
            <div style="font-size:1.5rem; font-weight:700; color:#15803d;">35%</div>
            <div style="font-size:0.85rem; color:#64748b;">437 transações</div>
        </div>
        <div style="padding:16px; background:#fef3c7; border-radius:8px;">
            <div style="font-size:0.85rem; color:#92400e; margin-bottom:4px;">💳 Cartão</div>
            <div style="font-size:1.5rem; font-weight:700; color:#92400e;">20%</div>
            <div style="font-size:0.85rem; color:#64748b;">249 transações</div>
        </div>
    </div>
</div>

@code {
    // Dados serão carregados do banco
}
