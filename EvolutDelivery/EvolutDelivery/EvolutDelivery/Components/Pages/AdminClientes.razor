@page "/admin-clientes"
@rendermode InteractiveServer
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using EvolutDelivery.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using EvolutDelivery.Models
@using EvolutDelivery.Services
@inject ILogger<AdminClientes> Logger
@inject ClienteService ClienteService
@inject IJSRuntime JS

<PageTitle>Clientes - Admin</PageTitle>

<style>
    .clientes-table {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-top: 24px;
    }

        .clientes-table table {
            width: 100%;
            border-collapse: collapse;
        }

        .clientes-table th {
            background: #f8fafc;
            padding: 16px;
            text-align: left;
            font-weight: 600;
            color: #64748b;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .clientes-table td {
            padding: 16px;
            border-top: 1px solid #f1f5f9;
        }
</style>

<div style="display:flex; justify-content:space-between; margin-bottom:24px;">
    <h2>👥 Gestão de Clientes</h2>
    <input type="text" placeholder="🔍 Buscar por nome ou telefone..." @bind="filtro" @bind:after="Filtrar"
           style="padding:10px; border:1px solid #e2e8f0; border-radius:8px; width:300px;" />
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:16px; margin-bottom:24px;">
    <div style="background:white; padding:20px; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); text-align:center;">
        <div style="font-size:2rem; font-weight:900; color:#2563eb;">@totalClientes</div>
        <div style="font-size:0.85rem; color:#64748b;">Total de Clientes</div>
    </div>

    <div style="background:white; padding:20px; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); text-align:center;">
        <div style="font-size:2rem; font-weight:900; color:#16a34a;">@clientesComPedido</div>
        <div style="font-size:0.85rem; color:#64748b;">Clientes com Pedidos</div>
    </div>

    <div style="background:white; padding:20px; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); text-align:center;">
        <div style="font-size:2rem; font-weight:900; color:#f59e0b;">@clientesComEmail</div>
        <div style="font-size:0.85rem; color:#64748b;">Clientes com E-mail</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensagemErro))
{
    <div style="background:#fef2f2; color:#dc2626; padding:16px; border-radius:12px; margin-bottom:16px; font-weight:600;">
        @mensagemErro
    </div>
}

@if (carregando)
{
    <div style="background:white; padding:60px; border-radius:12px; text-align:center; color:#64748b;">
        Carregando clientes...
    </div>
}
else if (!clientes.Any())
{
    <div style="background:white; padding:60px; border-radius:12px; text-align:center; color:#64748b;">
        @(string.IsNullOrWhiteSpace(filtro) ? "📦 Nenhum cliente cadastrado ainda." : "🔍 Nenhum cliente encontrado para esta busca.")
    </div>
}
else
{
    <div class="clientes-table">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Total Pedidos</th>
                    <th>Total Gasto</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in clientes)
                {
                    <tr>
                        <td><strong>@cliente.Nome</strong></td>
                        <td>@cliente.Telefone</td>
                        <td>@(string.IsNullOrWhiteSpace(cliente.Email) ? "-" : cliente.Email)</td>
                        <td>@cliente.TotalPedidos</td>
                        <td style="color:#16a34a; font-weight:700;">R$ @cliente.TotalGasto.ToString("F2")</td>
                        <td>
                            <button style="background:#2563eb; color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-weight:600;"
                                    @onclick='() => VerDetalhes(cliente.Codigo)'>
                                👁️ Ver
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (clientes.Count >= LimiteLista)
    {
        <p style="color:#64748b; font-size:.85rem; margin-top:10px;">
            Mostrando os primeiros @LimiteLista clientes. Use a busca para encontrar um cliente específico.
        </p>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private const int LimiteLista = 300;

    private List<Cliente> clientes = new();
    private string filtro = "";
    private string mensagemErro = "";
    private bool carregando = true;

    private int codEmp;
    private string cnpj = "";

    private int totalClientes;
    private int clientesComPedido;
    private int clientesComEmail;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthState).User;
            if (!EmpresaLogadaHelper.TryObter(user, out codEmp, out cnpj))
            {
                mensagemErro = "Sessão inválida. Saia e faça login novamente.";
                return;
            }

            var resumo = await ClienteService.ObterResumoAdminAsync(codEmp, cnpj);
            totalClientes = resumo.TotalClientes;
            clientesComPedido = resumo.ClientesComPedido;
            clientesComEmail = resumo.ClientesComEmail;

            clientes = await ClienteService.ListarClientesAdminAsync(codEmp, cnpj, "", LimiteLista);
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao carregar clientes.";
            Logger.LogError(ex, "Erro ao carregar clientes do admin");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Filtrar()
    {
        if (codEmp <= 0 || string.IsNullOrWhiteSpace(cnpj))
            return;

        carregando = true;
        try
        {
            clientes = await ClienteService.ListarClientesAdminAsync(codEmp, cnpj, filtro, LimiteLista);
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro ao buscar clientes.";
            Logger.LogError(ex, "Erro ao buscar clientes do admin");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task VerDetalhes(int codigo)
    {
        await JS.InvokeVoidAsync("alert", $"Ver detalhes do cliente #{codigo} - Em desenvolvimento!");
    }
}
